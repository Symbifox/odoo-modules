<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 🔴 Le meilleur premier geste n'écrit rien.
         Une pastille qui OUVRE une fiche ne porte aucun risque, se pose
         partout, se remplace sans conséquence, et se teste sans qu'une ligne
         de module soit écrite. C'est aussi celui qui valide le vrai inconnu :
         où coller la puce, et si le téléphone la lit à travers ce sur quoi
         elle est collée. -->
    <record id="gesture_open" model="bf.nfc.gesture">
        <field name="name">Open the record</field>
        <field name="code">open</field>
        <field name="kind">open</field>
        <field name="sequence">1</field>
        <field name="writes" eval="False"/>
        <field name="needs_target" eval="True"/>
        <field name="description">Bringing the phone close opens the record the tag points to. Writes nothing, asks for no confirmation, and reads with the rights of the person tapping: a record they may not see stays closed.</field>
    </record>

    <record id="gesture_url" model="bf.nfc.gesture">
        <field name="name">Open an address</field>
        <field name="code">url</field>
        <field name="kind">url</field>
        <field name="sequence">2</field>
        <field name="writes" eval="False"/>
        <field name="needs_target" eval="False"/>
        <field name="description">Bringing the phone close opens a web address: a procedure, a form, a map, a video. Writes nothing. Only https and http addresses are accepted.</field>
    </record>

    <record id="gesture_note" model="bf.nfc.gesture">
        <field name="name">Log a visit</field>
        <field name="code">note</field>
        <field name="kind">note</field>
        <field name="sequence">3</field>
        <field name="writes" eval="True"/>
        <field name="needs_target" eval="True"/>
        <field name="accepte_differe" eval="True"/>
        <field name="description">Leaves a dated, signed internal note on the record: a patrol, a visit, an inspection. A note, not a message: nobody receives an email.</field>
    </record>

    <!-- Un menu se compose dans le site (onglet « Menu » de la pastille), puis
         se grave depuis « Mes pastilles » dans l'application. -->
    <record id="gesture_menu" model="bf.nfc.gesture">
        <field name="name">Offer a menu</field>
        <field name="code">menu</field>
        <field name="kind">menu</field>
        <field name="sequence">5</field>
        <field name="writes" eval="True"/>
        <field name="needs_target" eval="False"/>
        <field name="description">Bringing the phone close offers a few buttons instead of a single gesture: “I'm taking it”, “I'm bringing it back”, “Report a problem”. Each choice plays its own gesture, with its own safeguards.</field>
    </record>

    <record id="gesture_cron" model="bf.nfc.gesture">
        <field name="name">Run a scheduled action</field>
        <field name="code">cron</field>
        <field name="kind">cron</field>
        <field name="sequence">20</field>
        <field name="writes" eval="True"/>
        <field name="needs_target" eval="True"/>
        <field name="reserve_gestion" eval="True"/>
        <field name="target_model_id" ref="base.model_ir_cron"/>
        <field name="description">Asks a scheduled action to run right away, without waiting for its next run. Reserved for managers.</field>
    </record>

    <record id="gesture_action" model="bf.nfc.gesture">
        <field name="name">Run an action</field>
        <field name="code">action</field>
        <field name="kind">action</field>
        <field name="sequence">21</field>
        <field name="writes" eval="True"/>
        <field name="needs_target" eval="True"/>
        <field name="reserve_gestion" eval="True"/>
        <field name="target_model_id" ref="base.model_ir_actions_server"/>
        <field name="description">Runs a server action or an automation, with the rights of the person tapping. Reserved for managers.</field>
    </record>
</odoo>
