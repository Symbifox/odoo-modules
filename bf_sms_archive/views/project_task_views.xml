<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_view_form_sms" model="ir.ui.view">
        <field name="name">project.task.form.sms.threads</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_sms_threads" type="object"
                        class="oe_stat_button" icon="fa-comments-o"
                        invisible="sms_thread_count == 0"
                        groups="bf_sms_archive.group_sms_user">
                    <field name="sms_thread_count" widget="statinfo"
                           string="Conversations"/>
                </button>
                <!-- Compteur distinct de celui des conversations : il compte les
                     messages posés sur CETTE tâche, pas les fils qui la
                     concernent. Les deux se recoupent rarement. -->
                <button name="action_open_sms_links" type="object"
                        class="oe_stat_button" icon="fa-commenting-o"
                        invisible="sms_link_count == 0"
                        groups="bf_sms_archive.group_sms_user">
                    <field name="sms_link_count" widget="statinfo"
                           string="SMS rattachés"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
