<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_editorial_suggestion_form" model="ir.ui.view">
        <field name="name">bf.editorial.suggestion.form</field>
        <field name="model">bf.editorial.suggestion</field>
        <field name="arch" type="xml">
            <form string="Gen suggestion">
                <header>
                    <button name="action_apply" type="object" string="Apply to the post"
                            class="btn-primary"
                            invisible="not has_proposal or applied or state != 'done'"
                            confirm="Gen will write to the article. The current slots are saved on this suggestion before writing. Continue?"
                            groups="bf_editorial.group_editorial_manager"/>
                    <button name="action_discard" type="object" string="Discard"
                            class="btn-secondary" invisible="applied"
                            groups="bf_editorial.group_editorial_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="queued,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Applied" bg_color="text-bg-success"
                            invisible="not applied"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind" readonly="1"/>
                            <field name="entry_id" readonly="1" invisible="not entry_id"/>
                            <field name="calendar_id" readonly="1"/>
                            <field name="triggered_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="message" readonly="1" invisible="not message"/>
                            <field name="applied_by" readonly="1" invisible="not applied"/>
                            <field name="applied_date" readonly="1" invisible="not applied"/>
                            <field name="has_proposal" invisible="1"/>
                            <field name="applied" invisible="1"/>
                        </group>
                    </group>

                    <field name="in_progress" invisible="1"/>
                    <field name="stalled" invisible="1"/>
                    <div class="alert alert-info" role="alert" invisible="not in_progress">
                        <i class="fa fa-circle-o-notch fa-spin me-2" title="In progress"/> <span> <b>Gen is working.</b> This record will fill in by itself: allow a few minutes, then reload the page. </span>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not stalled">
                        <b>Stalled run.</b> It never reported a status: the bridge was probably restarted, or the time limit passed. Nothing was written to the article. Run it again from the entry.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <field name="message" nolabel="1" readonly="1"/>
                    </div>

                    <notebook>
                        <page string="Reading" name="lecture">
                            <field name="body_html" nolabel="1" readonly="1"
                                   placeholder="Nothing yet."/>
                        </page>
                        <page string="Suggested text (French)" name="fr"
                              invisible="not proposed_fr">
                            <field name="proposed_fr" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Suggested text (English)" name="en"
                              invisible="not proposed_en">
                            <field name="proposed_en" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_editorial_suggestion_list" model="ir.ui.view">
        <field name="name">bf.editorial.suggestion.list</field>
        <field name="model">bf.editorial.suggestion</field>
        <field name="arch" type="xml">
            <list decoration-muted="applied" decoration-danger="state == 'error'"
                  decoration-warning="stalled" decoration-info="in_progress"
                  decoration-primary="pending_decision">
                <field name="in_progress" column_invisible="1"/>
                <field name="pending_decision" column_invisible="1"/>
                <field name="create_date"/>
                <field name="kind"/>
                <field name="entry_id" optional="show"/>
                <field name="calendar_id" optional="hide"/>
                <field name="state"/>
                <field name="stalled" optional="show" string="Stalled"/>
                <field name="has_proposal" optional="show"/>
                <field name="applied" optional="show"/>
                <field name="triggered_by" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_editorial_suggestion" model="ir.actions.act_window">
        <field name="name">Gen suggestions</field>
        <field name="res_model">bf.editorial.suggestion</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
