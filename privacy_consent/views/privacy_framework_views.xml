<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Liste des cadres -->
    <record id="view_privacy_framework_list" model="ir.ui.view">
        <field name="name">privacy.framework.list</field>
        <field name="model">privacy.framework</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="law_short_label"/>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id" optional="show"/>
                <field name="authority_name" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Formulaire du cadre -->
    <record id="view_privacy_framework_form" model="ir.ui.view">
        <field name="name">privacy.framework.form</field>
        <field name="model">privacy.framework</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Loi 25 (Québec)"/></h1>
                    </div>
                    <group>
                        <group string="Identité">
                            <field name="code"/>
                            <field name="law_short_label"/>
                            <field name="country_id"/>
                            <field name="jurisdiction_label"/>
                            <field name="languages"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Autorité de surveillance">
                            <field name="authority_name"/>
                            <field name="authority_url" widget="url"/>
                            <field name="breach_portal_url" widget="url"/>
                            <field name="officer_title_fr"/>
                            <field name="officer_title_en"/>
                            <field name="officer_required"/>
                            <field name="age_of_majority"/>
                        </group>
                    </group>
                    <group>
                        <group string="Déclaration d'incident">
                            <field name="breach_notify_authority"/>
                            <field name="breach_notify_authority_hours"/>
                            <field name="breach_notify_authority_label"/>
                            <field name="breach_notify_individuals"/>
                            <field name="breach_notify_individuals_label"/>
                            <field name="breach_threshold_label"/>
                        </group>
                        <group string="Évaluation et anonymisation">
                            <field name="assessment_name_fr"/>
                            <field name="assessment_name_en"/>
                            <field name="assessment_citation"/>
                            <field name="anonymization_citation"/>
                            <field name="default_retention_years"/>
                        </group>
                    </group>
                    <group string="Conservation et destruction">
                        <field name="destruction_basis_template"/>
                        <field name="erasure_basis_citation"/>
                        <field name="register_immutability_citation"/>
                    </group>
                    <notebook>
                        <page string="Textes (courriels et certificats)">
                            <group>
                                <field name="consent_intro_fr"/>
                                <field name="consent_intro_en"/>
                                <field name="law_citation_fr"/>
                                <field name="law_citation_en"/>
                            </group>
                        </page>
                        <page string="Bases légales">
                            <field name="lawful_basis_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="requires_consent"/>
                                    <field name="citation"/>
                                    <field name="active" widget="boolean_toggle" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Droits des personnes concernées">
                            <field name="right_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="label_fr"/>
                                    <field name="label_en"/>
                                    <field name="citation"/>
                                    <field name="active" widget="boolean_toggle" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes internes…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_privacy_framework" model="ir.actions.act_window">
        <field name="name">Cadres réglementaires</field>
        <field name="res_model">privacy.framework</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun cadre réglementaire
            </p>
            <p>
                Les cadres réglementaires (Loi 25, GDPR, etc.) portent les faits
                statutaires utilisés par les consentements, certificats et registres.
                Installez un module de cadre (ex. <code>privacy_framework_gdpr</code>)
                pour ajouter d'autres juridictions.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_privacy_frameworks"
              name="Cadres réglementaires"
              parent="menu_privacy_config"
              action="action_privacy_framework"
              groups="privacy_consent.group_privacy_manager"
              sequence="5"/>

    <!-- ===== Exposer framework_id sur les fiches (surcharge par enregistrement) ===== -->
    <record id="view_privacy_consent_form_framework" model="ir.ui.view">
        <field name="name">privacy.consent.form.framework</field>
        <field name="model">privacy.consent</field>
        <field name="inherit_id" ref="privacy_consent_form_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="framework_id"/>
            </field>
        </field>
    </record>

    <record id="view_privacy_notice_form_framework" model="ir.ui.view">
        <field name="name">privacy.notice.form.framework</field>
        <field name="model">privacy.notice</field>
        <field name="inherit_id" ref="privacy_notice_form_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="framework_id"/>
            </field>
        </field>
    </record>

    <record id="view_privacy_retention_calendar_form_framework" model="ir.ui.view">
        <field name="name">privacy.retention.calendar.form.framework</field>
        <field name="model">privacy.retention.calendar</field>
        <field name="inherit_id" ref="privacy_retention_calendar_view_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="framework_id"/>
            </field>
        </field>
    </record>

    <record id="view_privacy_anonymization_assessment_form_framework" model="ir.ui.view">
        <field name="name">privacy.anonymization.assessment.form.framework</field>
        <field name="model">privacy.anonymization.assessment</field>
        <field name="inherit_id" ref="privacy_anonymization_assessment_view_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="framework_id"/>
            </field>
        </field>
    </record>

    <!-- Cadre par défaut de la société -->
    <record id="view_company_form_privacy_framework" model="ir.ui.view">
        <field name="name">res.company.form.privacy.framework</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Vie privée">
                    <field name="default_privacy_framework_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
