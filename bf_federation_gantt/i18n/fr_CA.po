#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_remote_url
msgid "On the peer"
msgstr "Chez le pair"

#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_origin
msgid "Origin"
msgstr "Origine"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid ""
"Schedule federated with %s: its lines, lanes, milestones, dependencies and "
"their progress. What stays here: the planned hours of each line."
msgstr ""
"Échéancier fédéré avec %s : ses lignes, ses couloirs, ses jalons, ses "
"dépendances et leur avancement. Ce qui reste ici : les heures prévues de "
"chaque ligne."

#. module: bf_federation_gantt
#: model_terms:ir.ui.view,arch_db:bf_federation_gantt.view_bf_gantt_plan_form_federation
msgid "Schedule received from"
msgstr "Échéancier reçu de"

#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_is_mirror
msgid "Schedule received from a peer"
msgstr "Échéancier reçu d'un pair"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "Schedule sent again to %s: %s line(s)."
msgstr "Échéancier renvoyé à %s : %s ligne(s)."

#. module: bf_federation_gantt
#: model:ir.model.fields.selection,name:bf_federation_gantt.selection__federation_outbox__kind__gantt_share
msgid "Schedule shared"
msgstr "Partage d'un échéancier"

#. module: bf_federation_gantt
#: model:ir.model.fields.selection,name:bf_federation_gantt.selection__federation_outbox__kind__gantt_card
msgid "Schedule updated"
msgstr "Échéancier mis à jour"

#. module: bf_federation_gantt
#: model_terms:ir.ui.view,arch_db:bf_federation_gantt.view_bf_gantt_plan_form_federation
msgid "Send to the peer again"
msgstr "Renvoyer au pair"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "Sending a schedule to a peer again requires the project manager role."
msgstr ""
"Renvoyer un échéancier à un pair demande le rôle de gestionnaire de projet."

#. module: bf_federation_gantt
#: model:ir.model,name:bf_federation_gantt.model_bf_gantt_plan
msgid "Standalone timeline"
msgstr "Standalone timeline"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid ""
"The lines of this schedule are received from %s: they are read-only here."
msgstr "Les lignes de cet échéancier sont reçues de %s : elles se lisent ici."

#. module: bf_federation_gantt
#: model:ir.model.fields,help:bf_federation_gantt.field_bf_gantt_plan__federation_peer_id
msgid ""
"The peer where this object has a mirror. Clearing the field archives the "
"mirror."
msgstr ""
"Le pair chez qui cet objet a un miroir. Vider le champ archive le miroir."

#. module: bf_federation_gantt
#: model_terms:ir.ui.view,arch_db:bf_federation_gantt.view_bf_gantt_plan_form_federation
msgid ""
"The schedule is sent again on its own when a line moves. This button sends "
"it as it is, even if it has not changed."
msgstr ""
"L'échéancier repart de lui-même quand une ligne bouge. Ce bouton"
"                               le renvoie tel qu'il est, même s'il n'a pas "
"changé."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "This schedule is not shared with a peer."
msgstr "Cet échéancier n'est pas partagé avec un pair."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid ""
"This schedule is received from %s: it is read-only here. The sender's next "
"change would replace it, and any work done on it would be lost."
msgstr ""
"Cet échéancier est reçu de %s : il se lit ici. Le prochain changement de "
"l'émetteur le remplacerait, et le travail fait dessus serait perdu."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid ""
"This schedule is received from %s: it was shared with your company, not with"
" your customers. It is not published to the portal."
msgstr ""
"Cet échéancier est reçu de %s : il a été partagé avec votre entreprise, pas "
"avec vos clients. Il ne se publie pas au portail."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "the schedule"
msgstr "l'échéancier"

