#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/account_move.py:0
msgid ""
"%(bill)s: the ingredients it brought into stock could not be sent back "
"(%(error)s). Return the receipt from Inventory, then cancel the bill."
msgstr ""
"%(bill)s : les ingrédients qu'elle a fait entrer en stock n'ont pas pu être "
"renvoyés (%(error)s). Faites le retour de la réception depuis l'Inventaire, "
"puis annulez la facture."

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/wizard/attach_line.py:0
msgid "%(ingredient)s belongs to another company than the bill."
msgstr "%(ingredient)s appartient à une autre société que la facture."

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/account_move.py:0
msgid ""
"%(line)s: already received into stock (%(qty)s %(unit)s of %(product)s), so "
"its product, unit and quantity can no longer change. Cancel the bill to send"
" the ingredients back, or return the receipt from Inventory, then change the"
" line."
msgstr ""
"%(line)s : déjà reçue en stock (%(qty)s %(unit)s de %(product)s), son "
"produit, son unité et sa quantité ne peuvent plus changer. Annulez la "
"facture pour renvoyer les ingrédients, ou faites le retour de la réception "
"depuis l'Inventaire, puis changez la ligne."

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/account_move.py:0
msgid ""
"%(lines)s: already received into stock. Cancel the bill to send the "
"ingredients back, or return the receipt from Inventory, before deleting it."
msgstr ""
"%(lines)s : déjà reçue en stock. Annulez la facture pour renvoyer les "
"ingrédients, ou faites le retour de la réception depuis l'Inventaire, avant "
"de la supprimer."

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/account_move.py:0
msgid ""
"%(product)s: the bill unit (%(unit)s) cannot be converted to the stock unit "
"(%(stock)s). Give the format on the line first."
msgstr ""
"%(product)s : l'unité de la facture (%(unit)s) ne se convertit pas dans "
"l'unité de stock (%(stock)s). Donnez d'abord le format sur la ligne."

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/mrp_bom.py:0
msgid ""
"%(recipe)s: %(qty)s %(unit)s of %(product)s becomes 0 %(stock)s in its stock"
" unit, so it would never leave the stock. Stock %(product)s in a smaller "
"unit (g, ml)."
msgstr ""
"%(recipe)s : %(qty)s %(unit)s de %(product)s devient 0 %(stock)s dans son "
"unité de stock et ne sortirait jamais du stock. Stockez %(product)s dans une"
" unité plus petite (g, ml)."

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/mrp_bom.py:0
msgid ""
"%(recipe)s: one portion takes %(qty)s %(unit)s of %(product)s, which becomes"
" 0 %(stock)s in its stock unit, so it would never leave the stock. Stock "
"%(product)s in a smaller unit (g, ml)."
msgstr ""
"%(recipe)s : une portion prend %(qty)s %(unit)s de %(product)s, soit 0 "
"%(stock)s dans son unité de stock : l'ingrédient ne sortirait jamais du "
"stock. Stockez %(product)s dans une unité plus petite (g, ml)."

#. module: bf_kitchen
