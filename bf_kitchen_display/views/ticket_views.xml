<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_kitchen_ticket_view_list" model="ir.ui.view">
        <field name="name">bf.kitchen.ticket.list</field>
        <field name="model">bf.kitchen.ticket</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'cancelled'" decoration-muted="state == 'served'">
                <field name="sent_at"/>
                <field name="table_name"/>
                <field name="order_ref" optional="hide"/>
                <field name="station_id"/>
                <field name="sent_by" optional="show"/>
                <field name="customer_count" optional="hide"/>
                <field name="state"/>
                <field name="ready_at" optional="show"/>
                <field name="served_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="bf_kitchen_ticket_view_form" model="ir.ui.view">
        <field name="name">bf.kitchen.ticket.form</field>
        <field name="model">bf.kitchen.ticket</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header><field name="state" widget="statusbar" statusbar_visible="new,progress,ready,served"/></header>
                <sheet>
                    <group>
                        <group>
                            <field name="table_name"/>
                            <field name="order_ref"/>
                            <field name="customer_count"/>
                            <field name="sent_by"/>
                            <field name="station_id"/>
                        </group>
                        <group>
                            <field name="sent_at"/>
                            <field name="started_at"/>
                            <field name="ready_at"/>
                            <field name="served_at"/>
                            <field name="cancelled_at" invisible="state != 'cancelled'"/>
                            <field name="cancel_reason" invisible="state != 'cancelled'"/>
                        </group>
                    </group>
                    <field name="general_note" invisible="not general_note"/>
                    <field name="line_ids">
                        <list decoration-danger="qty &lt; 0">
                            <field name="qty"/>
                            <field name="name"/>
                            <field name="note"/>
                            <field name="allergens"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="bf_kitchen_ticket_view_search" model="ir.ui.view">
        <field name="name">bf.kitchen.ticket.search</field>
        <field name="model">bf.kitchen.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="table_name"/>
                <field name="order_ref"/>
                <field name="station_id"/>
                <filter name="open" string="On the screen" domain="[('state', 'in', ('new', 'progress', 'ready'))]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('sent_at', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="by_station" string="Station" context="{'group_by': 'station_id'}"/>
                    <filter name="by_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="bf_kitchen_ticket_action" model="ir.actions.act_window">
        <field name="name">Kitchen tickets</field>
        <field name="res_model">bf.kitchen.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
    <record id="bf_kitchen_display_action" model="ir.actions.client">
        <field name="name">Kitchen screen</field>
        <field name="tag">bf_kitchen_display</field>
    </record>
</odoo>
