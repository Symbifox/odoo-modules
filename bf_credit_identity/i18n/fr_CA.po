#: model:ir.model.fields,field_description:bf_credit_identity.field_bf_credit_setup__write_uid
msgid "Last Updated by"
msgstr "Mis à jour par"

#. module: bf_credit_identity
#: model:ir.model.fields,field_description:bf_credit_identity.field_bf_credit_reminder__write_date
#: model:ir.model.fields,field_description:bf_credit_identity.field_bf_credit_setup__write_date
msgid "Last Updated on"
msgstr "Mis à jour le"

