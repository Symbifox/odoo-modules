<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Per-user model (18.0.4.0.0):
      - Anyone with internal user access can configure their own
        bf.email.account rows and consume their own bf.email rows.
      - One owner ir.rule per model with domain_force = [('user_id', '=', user.id)].
      - The migration in migrations/18.0.4.0.0/post-migrate.py dropped the
        legacy group_email_user / group_email_manager records.

      Admin zone (18.0.5.2.0):
      - A dedicated group_email_admin grants READ-ONLY visibility on every
        user's rows (domain_force = [(1, '=', 1)], perm_read only).
      - ir.rule semantics: rules attached to different groups are OR-combined,
        so an admin (also a base.group_user member) sees own OR all = all, while
        a normal user still sees only their own. Write/create/unlink on foreign
        rows stays denied (admin rule is read-only and the owner rule's domain
        excludes them).
      - Membership is NOT shipped in data — assign group_email_admin to humans
        only, never to service accounts (Client.e, Meeting Processor API).
      - 18.0.6.0.0: bf.email.account is EXCLUDED from the admin zone. The
        account row stores the IMAP app password in cleartext; a read-all
        rule would expose every user's credential over RPC (field-level
        password="True" in the view only masks the widget). Admins see all
        emails and rules, never other users' accounts.
    -->

    <data noupdate="1">
        <record id="module_category_email" model="ir.module.category">
            <field name="name">Gestion des courriels</field>
            <field name="sequence">60</field>
        </record>

        <record id="group_email_admin" model="res.groups">
            <field name="name">Administrateur — tous les courriels</field>
            <field name="category_id" ref="module_category_email"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>

    <record id="bf_email_rule_admin_all" model="ir.rule">
        <field name="name">Courriel : admin voit tout (lecture seule)</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_rule_rule_admin_all" model="ir.rule">
        <field name="name">Règle courriel : admin voit tout (lecture seule)</field>
        <field name="model_id" ref="model_bf_email_rule"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
      Absences : mêmes règles que le reste du module. Chacun gère les siennes ;
      l'administrateur courriel les lit toutes, parce qu'une réponse qui part
      au nom de l'organisation doit être auditable par quelqu'un.
    -->
    <record id="bf_email_absence_rule_owner" model="ir.rule">
        <field name="name">Absence : la mienne</field>
        <field name="model_id" ref="model_bf_email_absence"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="bf_email_absence_rule_admin" model="ir.rule">
        <field name="name">Absence : admin voit tout (lecture seule)</field>
        <field name="model_id" ref="model_bf_email_absence"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_absence_reply_rule_owner" model="ir.rule">
        <field name="name">Message d'absence : le mien</field>
        <field name="model_id" ref="model_bf_email_absence_reply"/>
        <field name="domain_force">[('absence_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="bf_email_absence_reply_rule_admin" model="ir.rule">
        <field name="name">Message d'absence : admin voit tout (lecture seule)</field>
        <field name="model_id" ref="model_bf_email_absence_reply"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_rule_owner" model="ir.rule">
        <field name="name">Courriel : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="bf_email_account_rule_owner" model="ir.rule">
        <field name="name">Compte IMAP : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email_account"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
      Mobile devices (18.0.6.8.0): owner-scoped like everything else, so a
      user can list and revoke their own phones. No create right — device
      rows are only ever minted by the /auth/start controller through sudo,
      never by a client that could pick its own token.
      The admin zone does NOT extend here: bf.email.mobile.device stores live
      bearer tokens, so a read-all rule would hand every user's mailbox to
      whoever holds group_email_admin, exactly the reasoning that kept
      bf.email.account out of it in 18.0.6.0.0. The token fields carry
      groups="group_email_admin" only to keep them off ordinary RPC reads.
    -->
    <record id="bf_email_mobile_device_rule_owner" model="ir.rule">
        <field name="name">Appareil mobile : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email_mobile_device"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
      Company-wide rules (18.0.9.11.0): a bf.email.rule with no user_id applies
      to everybody in its company. Everyone must READ them — otherwise the
      engine, which runs unsudoed for nothing here but whose UI must explain
      what is acting on your mail, would show a mailbox governed by invisible
      rules. Only base.group_system may write one; that gate is doubled by
      _check_company_scope_is_admin, because an owner flipping their own rule
      from « user » to « company » would still satisfy the owner domain at the
      moment the write is checked.
    -->
    <record id="bf_email_rule_rule_company_read" model="ir.rule">
        <field name="name">R&#232;gle courriel : les r&#232;gles d'organisation sont visibles de tous</field>
        <field name="model_id" ref="model_bf_email_rule"/>
        <field name="domain_force">[('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_rule_rule_company_manage" model="ir.rule">
        <field name="name">R&#232;gle courriel : l'administrateur g&#232;re les r&#232;gles d'organisation</field>
        <field name="model_id" ref="model_bf_email_rule"/>
        <field name="domain_force">[('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
      The admin zone reaches the conditions too. Without this, somebody holding
      group_email_admin sees every user's RULES but none of their conditions —
      the owner rule below is keyed on `rule_id.user_id` — so every foreign
      rule renders as « no condition », which reads as broken. Read-only, like
      the rule itself.
    -->
    <record id="bf_email_rule_condition_rule_admin_all" model="ir.rule">
        <field name="name">Condition : admin voit tout (lecture seule)</field>
        <field name="model_id" ref="model_bf_email_rule_condition"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
      Conditions inherit their parent's scope. Three rules, same shape as the
      rule itself: own rules are fully editable, company rules are readable by
      all and writable by settings administrators.
    -->
    <record id="bf_email_rule_condition_rule_owner" model="ir.rule">
        <field name="name">Condition : visible au propri&#233;taire de la r&#232;gle</field>
        <field name="model_id" ref="model_bf_email_rule_condition"/>
        <field name="domain_force">['|', ('rule_id.user_id', '=', user.id), ('absence_reply_id.absence_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="bf_email_rule_condition_rule_company_read" model="ir.rule">
        <field name="name">Condition : les r&#232;gles d'organisation sont lisibles</field>
        <field name="model_id" ref="model_bf_email_rule_condition"/>
        <field name="domain_force">[('rule_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_rule_condition_rule_company_manage" model="ir.rule">
        <field name="name">Condition : l'administrateur g&#232;re celles d'organisation</field>
        <field name="model_id" ref="model_bf_email_rule_condition"/>
        <field name="domain_force">[('rule_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
      Forward journal: read-only for its owner. The ACL already withholds
      create/write/unlink from base.group_user, so nobody edits their own audit
      trail; _log() writes through sudo.
    -->
    <record id="bf_email_forward_log_rule_owner" model="ir.rule">
        <field name="name">Journal de r&#233;acheminement : visible au propri&#233;taire</field>
        <field name="model_id" ref="model_bf_email_auto_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_forward_log_rule_admin" model="ir.rule">
        <field name="name">Journal de r&#233;acheminement : admin voit tout</field>
        <field name="model_id" ref="model_bf_email_auto_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin')), (4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_rule_rule_owner" model="ir.rule">
        <field name="name">Règle courriel : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email_rule"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Chacun déclare ses propres identités d'expédition et n'en voit pas
         d'autres. La règle laisse volontairement écrire : on déclare ses
         adresses soi-même. Ce qui n'est PAS laissé à cette main, c'est la
         case « vérifiée » — celle qui autorise réellement à écrire sous ce
         nom — gardée en Python par _check_verified_is_admin_granted. Une
         règle d'enregistrement ne saurait pas faire la différence entre les
         deux écritures. -->
    <record id="bf_email_identity_rule_owner" model="ir.rule">
        <field name="name">Identité d'expédition : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email_identity"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- L'administrateur courriel voit toutes les identités : c'est lui qui
         les vérifie, il ne peut pas vérifier ce qu'il ne voit pas. -->
    <record id="bf_email_identity_rule_admin" model="ir.rule">
        <field name="name">Identité d'expédition : lecture globale pour l'administrateur courriel</field>
        <field name="model_id" ref="model_bf_email_identity"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
