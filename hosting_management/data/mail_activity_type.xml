<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Type d'activité pour l'expiration d'hébergement -->
        <record id="mail_activity_type_hosting_expiration" model="mail.activity.type">
            <field name="name">Hosting expiration</field>
            <field name="summary">Service expiring soon</field>
            <field name="res_model">hosting.service</field>
            <field name="icon">fa-clock-o</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
        </record>

        <!-- Type d'activité pour les mises à jour logicielles -->
        <record id="mail_activity_type_hosting_update" model="mail.activity.type">
            <field name="name">Software update</field>
            <field name="summary">Update available</field>
            <field name="res_model">hosting.service</field>
            <field name="icon">fa-refresh</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
        </record>

        <!-- Type d'activité pour les tâches de maintenance -->
        <record id="mail_activity_type_hosting_maintenance" model="mail.activity.type">
            <field name="name">Hosting maintenance</field>
            <field name="summary">Maintenance task due</field>
            <field name="res_model">hosting.maintenance.schedule</field>
            <field name="icon">fa-wrench</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
        </record>

        <!-- Type d'activité : drift DMARC détecté -->
        <record id="mail_activity_type_dmarc_drift" model="mail.activity.type">
            <field name="name">DMARC: drift detected</field>
            <field name="summary">_dmarc TXT record differs</field>
            <field name="res_model">hosting.domain</field>
            <field name="icon">fa-shield</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
        </record>

        <!-- Type d'activité : révision de policy DMARC -->
        <record id="mail_activity_type_dmarc_review" model="mail.activity.type">
            <field name="name">DMARC: policy review</field>
            <field name="summary">Review the DMARC policy (hardening)</field>
            <field name="res_model">hosting.domain</field>
            <field name="icon">fa-envelope</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
        </record>

    </data>
</odoo>
