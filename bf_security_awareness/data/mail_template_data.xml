<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ⚠️ Gabarit protégé par `noupdate` : une montée ne le réécrit pas. Quand son
         corps change, la migration de la version le retire pour que le chargement
         le recrée (voir migrations/18.0.2.1.0). -->
    <data noupdate="1">
        <record id="mail_template_training_invite" model="mail.template">
            <field name="name">Security awareness: training invitation</field>
            <field name="model_id" ref="model_bf_training_assignment"/>
            <field name="subject">Cybersecurity training to complete</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <!-- 🔴 Plus de coquille ni de couleur ici : l'envoi passe la mise en page
                 de la société, et le bouton, la date et la signature
                 reprennent ceux de la relance du registre (`bf_training`). -->
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 0;">
                    <p>Hello <t t-out="object.partner_id.name or ''">First name</t>,</p>
                    <p>A short cybersecurity awareness training has been assigned to you: <strong t-out="object.channel_id.name or ''">Recognizing phishing</strong>.</p>
                    <p t-if="object.due_date">Please complete it by
                        <strong t-out="format_date(object.due_date, date_format='d MMMM yyyy', lang_code=object.partner_id.lang)">September 16, 2026</strong>.</p>
                    <p t-if="object.training_url" style="margin: 24px 0;">
                        <a t-att-href="object.training_url"
                           t-attf-style="background-color: {{ object.reminder_button_color }}; padding: 10px 18px; text-decoration: none; color: #fff; border-radius: 5px; font-weight: bold;">
                            Go to the training
                        </a>
                    </p>
                    <p>Thank you,<t t-if="object.reminder_signature_name"><br/><t t-out="object.reminder_signature_name">The company</t></t></p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
