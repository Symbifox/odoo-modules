<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_badge_category_list" model="ir.ui.view">
        <field name="name">bf.gamification.badge.category.list</field>
        <field name="model">bf.gamification.badge.category</field>
        <field name="arch" type="xml">
            <list string="Cat&#233;gories de badges" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_badge_categories" model="ir.actions.act_window">
        <field name="name">Cat&#233;gories de badges</field>
        <field name="res_model">bf.gamification.badge.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
