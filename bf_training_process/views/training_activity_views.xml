<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_activity_form_process" model="ir.ui.view">
        <field name="name">bf.training.activity.form.process</field>
        <field name="model">bf.training.activity</field>
        <field name="inherit_id" ref="bf_training.view_training_activity_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_process_nodes" type="object"
                        class="oe_stat_button" icon="fa-sitemap"
                        invisible="not process_node_count">
                    <field name="process_node_count" widget="statinfo" string="Étapes"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="Étapes enseignées" name="process">
                    <field name="process_node_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <group>
                        <field name="process_lane_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <div class="text-muted">
                        Les gestes que cette formation apprend à tenir. Les couloirs
                        concernés s'en déduisent : ce sont les rôles qui tiennent au
                        moins une de ces étapes.
                    </div>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
