<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Le défaut de paiement naît du passage d'une échéance et non d'une
             écriture. Sans ce rafraîchissement quotidien, une contribution dont
             la date d'exigibilité vient d'expirer resterait « à jour » jusqu'à
             ce que quelqu'un rouvre l'appel, et l'état des impayés afficherait
             zéro là où il y a un défaut. Même patron que les crons du socle et
             de la gouvernance. -->
        <record id="cron_call_line_refresh_overdue" model="ir.cron">
            <field name="name">Copropriété : rafraîchir l'état des contributions en défaut</field>
            <field name="model_id" ref="model_bf_property_fund_call_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- 🔴 Le délai de l'art. 1069 al. 2 joue CONTRE le syndicat : passé
             quinze jours, il perd sa créance contre l'acquéreur. Il vaut mieux
             qu'un tableau le dise le matin même. -->
        <record id="cron_charge_statement_refresh" model="ir.cron">
            <field name="name">Copropriété : délai des états des charges (art. 1069)</field>
            <field name="model_id" ref="model_bf_property_charge_statement"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
