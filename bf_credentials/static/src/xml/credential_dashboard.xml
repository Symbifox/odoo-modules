<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- La carte « Identifiants », remise là où elle était : troisième colonne
         de la rangée qualité / matrices. Elle passe par le point d'extension
         nommé du socle plutôt que par un xpath posé sur la carte voisine.

         Le t-call du socle partage son contexte de rendu, donc `state` et les
         quatre gestionnaires de clic ajoutés par credential_dashboard.js
         répondent ici comme dans le gabarit principal. -->
    <t t-name="bf_credentials.CredentialDashboardColumn"
       t-inherit="project_knowledge_matrix.DashboardQualityColumns"
       t-inherit-mode="extension">
        <xpath expr="." position="inside">
                        <div class="col-lg-4 col-md-6 mb-3">
                            <div class="card h-100 cursor-pointer" t-on-click="openCredentials">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fa fa-key me-2"/>Identifiants</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Identifiants actifs</span>
                                        <strong t-esc="state.data.credential_metrics.total"/>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 cursor-pointer" t-on-click.stop="openExpiringCredentials">
                                        <span>Expirent sous 30j</span>
                                        <span t-attf-class="badge {{state.data.credential_metrics.expiring_soon > 0 ? 'text-bg-warning' : 'text-bg-success'}}" t-esc="state.data.credential_metrics.expiring_soon"/>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 cursor-pointer" t-on-click.stop="openExpiredCredentials">
                                        <span>Expirés</span>
                                        <span t-attf-class="badge {{state.data.credential_metrics.expired > 0 ? 'text-bg-danger' : 'text-bg-success'}}" t-esc="state.data.credential_metrics.expired"/>
                                    </div>
                                    <div class="d-flex justify-content-between cursor-pointer" t-on-click.stop="openRevokedCredentials">
                                        <span>Révoqués</span>
                                        <span class="badge text-bg-secondary" t-esc="state.data.credential_metrics.revoked"/>
                                    </div>
                                    <hr class="my-2"/>
                                    <div class="d-flex justify-content-between mb-2 cursor-pointer" t-on-click.stop="openMfaToDocument">
                                        <span>2e facteur à documenter</span>
                                        <span t-attf-class="badge {{state.data.credential_metrics.mfa_unknown > 0 ? 'text-bg-info' : 'text-bg-success'}}" t-esc="state.data.credential_metrics.mfa_unknown"/>
                                    </div>
                                    <div class="d-flex justify-content-between cursor-pointer" t-on-click.stop="openMfaAtRisk">
                                        <span>2e facteur sans relève</span>
                                        <span t-attf-class="badge {{state.data.credential_metrics.mfa_at_risk > 0 ? 'text-bg-warning' : 'text-bg-success'}}" t-esc="state.data.credential_metrics.mfa_at_risk"/>
                                    </div>
                                </div>
                            </div>
                        </div>
        </xpath>
    </t>

</templates>
