<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Ancrage sur `analytic_distribution` plutôt que sur `employee_id` : le
      formulaire du coeur porte DEUX fois `employee_id`, une fois pour les
      gestionnaires RH et une fois pour les autres. Un xpath ne prend que la
      première, et le champ atterrirait dans la mauvaise moitié. La clé
      analytique, elle, n'apparaît qu'une fois, et c'est justement ce que le
      poste alimente, donc la place est aussi la bonne pour l'oeil.
    -->
    <record id="hr_expense_view_form_job" model="ir.ui.view">
        <field name="name">hr.expense.view.form.job</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <field name="analytic_distribution" position="before">
                <field name="job_id"
                       groups="hr_recruitment.group_hr_recruitment_user"
                       options="{'no_create': True}"
                       readonly="not is_editable"/>
            </field>
        </field>
    </record>

    <!--
      La liste de base, pas `view_expenses_tree` : celle-ci en hérite, comme
      trois autres. Greffé au bon endroit, la colonne existe partout.
    -->
    <record id="hr_expense_view_analysis_tree_job" model="ir.ui.view">
        <field name="name">hr.expense.list.job</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <field name="analytic_distribution" position="before">
                <field name="job_id" optional="hide"
                       groups="hr_recruitment.group_hr_recruitment_user"
                       readonly="not is_editable"/>
            </field>
        </field>
    </record>

    <record id="hr_expense_view_search_job" model="ir.ui.view">
        <field name="name">hr.expense.search.job</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <filter name="my_expenses" position="after">
                <separator/>
                <filter name="recruitment_expenses" string="Débours de recrutement"
                        domain="[('job_id', '!=', False)]"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
            </filter>
            <filter name="product" position="after">
                <filter string="Poste à pourvoir" name="job" domain="[]"
                        context="{'group_by': 'job_id'}"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
            </filter>
        </field>
    </record>

</odoo>
