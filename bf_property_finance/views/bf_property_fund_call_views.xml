<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fund_call_list" model="ir.ui.view">
        <field name="name">bf.property.fund.call.list</field>
        <field name="model">bf.property.fund.call</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'"
                  decoration-danger="overdue_line_count &gt; 0">
                <field name="name"/>
                <field name="syndicat_id"/>
                <field name="budget_id" optional="show"/>
                <field name="call_type"/>
                <field name="period_start" optional="hide"/>
                <field name="period_end" optional="hide"/>
                <field name="due_date"/>
                <field name="budget_share" optional="hide"/>
                <field name="amount_total" sum="Appelé"/>
                <field name="amount_received" sum="Reçu" optional="show"/>
                <field name="amount_balance" sum="Solde"/>
                <field name="overdue_line_count" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fund_call_form" model="ir.ui.view">
        <field name="name">bf.property.fund.call.form</field>
        <field name="model">bf.property.fund.call</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_lines" type="object"
                            string="Calculer la répartition" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_issue" type="object" string="Transmettre"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Clôturer"
                            invisible="state != 'issued'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,issued,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Appel du 1er trimestre 2027"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="call_type != 'special'">
                        Art. 1072.1 C.c.Q. : le conseil d'administration doit consulter
                        l'assemblée des copropriétaires avant de décider de toute contribution
                        spéciale. La consultation du budget annuel ne vaut pas pour celle-ci.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="overdue_line_count == 0">
                        <field name="overdue_line_count" readonly="1" nolabel="1" class="oe_inline"/>
                        fraction(s) en défaut de paiement.
                    </div>

                    <group>
                        <group string="Portée">
                            <field name="budget_id"/>
                            <field name="syndicat_id"/>
                            <field name="call_type"/>
                            <field name="consultation_assembly_id"
                                   invisible="call_type != 'special'"
                                   required="call_type == 'special'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Période et échéance">
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="budget_share"/>
                            <field name="due_date"/>
                        </group>
                        <group string="Montants">
                            <field name="amount_total"/>
                            <field name="amount_received"/>
                            <field name="amount_balance"/>
                            <field name="amount_interest"
                                   invisible="not amount_interest"/>
                            <field name="amount_due"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Répartition" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" decoration-danger="is_overdue">
                                    <field name="unit_id" readonly="1"/>
                                    <field name="quote_part" readonly="1"/>
                                    <field name="owner_ids" widget="many2many_tags" readonly="1"
                                           optional="show"/>
                                    <field name="amount_common" readonly="1" optional="hide"
                                           sum="Charges communes"/>
                                    <field name="amount_restricted_maintenance" readonly="1"
                                           optional="hide" sum="Entretien usage restreint"/>
                                    <field name="amount_restricted_major" readonly="1"
                                           optional="hide" sum="Réparations majeures"/>
                                    <field name="amount_contingency" readonly="1"
                                           optional="show" sum="Fonds de prévoyance"/>
                                    <field name="amount_self_insurance" readonly="1"
                                           optional="hide" sum="Auto-assurance"/>
                                    <field name="amount" readonly="1" sum="Contribution"/>
                                    <field name="amount_received" readonly="1" sum="Reçu"/>
                                    <field name="balance" readonly="1" sum="Solde"/>
                                    <field name="demeure_date" optional="hide"/>
                                    <field name="interest_start_date" readonly="1"
                                           optional="hide"/>
                                    <field name="interest_accrued" readonly="1"
                                           optional="hide" sum="Intérêts courus"/>
                                    <field name="interest_balance" readonly="1"
                                           optional="hide" sum="Intérêts dus"/>
                                    <field name="total_due" readonly="1" sum="Total dû"/>
                                    <field name="is_overdue" readonly="1" optional="show"/>
                                    <field name="days_overdue" readonly="1" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fund_call_search" model="ir.ui.view">
        <field name="name">bf.property.fund.call.search</field>
        <field name="model">bf.property.fund.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="syndicat_id"/>
                <filter name="overdue" string="Avec des impayés"
                        domain="[('overdue_line_count', '&gt;', 0)]"/>
                <filter name="special" string="Contributions spéciales"
                        domain="[('call_type', '=', 'special')]"/>
                <filter name="open" string="En cours"
                        domain="[('state', 'not in', ('closed',))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_syndicat" string="Syndicat"
                            context="{'group_by': 'syndicat_id'}"/>
                    <filter name="group_budget" string="Budget"
                            context="{'group_by': 'budget_id'}"/>
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fund_call_line_list" model="ir.ui.view">
        <field name="name">bf.property.fund.call.line.list</field>
        <field name="model">bf.property.fund.call.line</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" create="0">
                <field name="call_id"/>
                <field name="unit_id"/>
                <field name="owner_ids" widget="many2many_tags" optional="show"/>
                <field name="amount" sum="Contribution"/>
                <field name="amount_received" sum="Reçu"/>
                <field name="balance" sum="Solde"/>
                <field name="interest_balance" sum="Intérêts" optional="hide"/>
                <field name="total_due" sum="Total dû"/>
                <field name="days_overdue" optional="show"/>
                <field name="is_overdue"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fund_call_line_search" model="ir.ui.view">
        <field name="name">bf.property.fund.call.line.search</field>
        <field name="model">bf.property.fund.call.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="unit_id"/>
                <field name="call_id"/>
                <filter name="overdue" string="En défaut"
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="unpaid" string="Solde ouvert"
                        domain="[('balance', '&gt;', 0)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_unit" string="Fraction"
                            context="{'group_by': 'unit_id'}"/>
                    <filter name="group_call" string="Appel"
                            context="{'group_by': 'call_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fund_call" model="ir.actions.act_window">
        <field name="name">Appels de fonds</field>
        <field name="res_model">bf.property.fund.call</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fund_call_line" model="ir.actions.act_window">
        <field name="name">Contributions</field>
        <field name="res_model">bf.property.fund.call.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_unpaid': 1}</field>
    </record>

</odoo>
