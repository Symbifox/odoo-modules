<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Ce que le portail laisse voir, et pourquoi c'est ici plutôt que dans
            une vue.

            ⚠️ Une règle d'accès, pas un `invisible`. Un attribut de vue cache
            un champ à l'écran ; il ne protège ni la lecture par l'ORM, ni la
            route `/web/content` d'une pièce jointe. Le cloisonnement entre le
            copropriétaire et l'occupant tient donc à un `ir.rule`.

            🔴 AUCUNE DATE dans ces domaines. Le domaine d'une `ir.rule` est mis
            en cache par `ormcache` sur (uid, su, modèle, mode, sociétés), SANS
            composante temporelle : une date écrite dans `domain_force` est
            évaluée une fois puis gelée jusqu'à l'invalidation du cache. La
            famille `bf_sign` s'est déjà fait prendre, une pièce jointe restant
            lisible au-delà de sa date de fin. La fenêtre d'affichage d'une
            annonce est donc appliquée par le CONTRÔLEUR, qui recherche sur
            `is_visible_now`, et jamais par la règle.

            La règle, elle, ne répond qu'à une question qui ne dépend pas de
            l'heure : cette personne a-t-elle un lien courant avec ce syndicat,
            et à quel titre. `is_current` du registre de propriété est un
            stocké tenu à jour par le cron quotidien du socle, ce qui convient
            ici justement parce qu'il ne se recalcule pas à la lecture.
        -->

        <record id="rule_announcement_portal_owner" model="ir.rule">
            <field name="name">Annonces : copropriétaire du syndicat</field>
            <field name="model_id" ref="model_bf_property_announcement"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                ('published', '=', True),
                ('audience', 'in', ['all', 'owners']),
                ('syndicat_id.unit_ids.ownership_ids', 'any',
                    [('partner_id', '=', user.partner_id.id), ('is_current', '=', True)])
            ]</field>
        </record>

        <record id="rule_announcement_portal_occupant" model="ir.rule">
            <field name="name">Annonces : occupant d'une fraction louée</field>
            <field name="model_id" ref="model_bf_property_announcement"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                ('published', '=', True),
                ('audience', 'in', ['all', 'occupants']),
                ('syndicat_id.unit_ids', 'any',
                    [('occupant_id', '=', user.partner_id.id), ('is_rented', '=', True)])
            ]</field>
        </record>

        <record id="rule_document_portal_owner" model="ir.rule">
            <field name="name">Documents : copropriétaire du syndicat</field>
            <field name="model_id" ref="model_bf_property_document"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                ('published', '=', True),
                ('audience', 'in', ['all', 'owners']),
                ('syndicat_id.unit_ids.ownership_ids', 'any',
                    [('partner_id', '=', user.partner_id.id), ('is_current', '=', True)])
            ]</field>
        </record>

        <record id="rule_document_portal_occupant" model="ir.rule">
            <field name="name">Documents : occupant d'une fraction louée</field>
            <field name="model_id" ref="model_bf_property_document"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                ('published', '=', True),
                ('audience', 'in', ['all', 'occupants']),
                ('syndicat_id.unit_ids', 'any',
                    [('occupant_id', '=', user.partner_id.id), ('is_rented', '=', True)])
            ]</field>
        </record>

        <!--
            🔴 Sans ces quatre-là, les règles ci-dessus lèvent un 403.

            Le domaine d'une règle qui TRAVERSE (`syndicat_id.unit_ids.ownership_ids`)
            est évalué avec les droits de la personne : lire une annonce suppose
            donc de pouvoir lire le syndicat, la fraction et l'inscription au
            registre qu'on traverse pour y arriver. L'essai HTTP a rendu un 403
            sur la page des annonces alors que la page d'accueil passait, parce
            que celle-là passait par un `sudo` du contrôleur et pas l'autre.

            La lecture accordée ici est donc bornée par ses propres règles : on
            ne voit que les fractions qu'on possède ou qu'on occupe, que les
            immeubles et les syndicats qui les portent, et que sa propre
            inscription au registre. Jamais celle du voisin : l'art. 1070 al. 1
            ne met au registre les renseignements personnels d'un tiers qu'avec
            son consentement exprès, et l'art. 1070.1 réserve la consultation au
            copropriétaire, sous conditions que le portail ne remplit pas.
        -->

        <record id="rule_ownership_portal" model="ir.rule">
            <field name="name">Registre de propriété : la sienne seulement</field>
            <field name="model_id" ref="bf_property_core.model_bf_property_ownership"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="rule_unit_portal" model="ir.rule">
            <field name="name">Fractions : les siennes, possédées ou occupées</field>
            <field name="model_id" ref="bf_property_core.model_bf_property_unit"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">['|',
                ('ownership_ids', 'any',
                    [('partner_id', '=', user.partner_id.id), ('is_current', '=', True)]),
                '&amp;', ('occupant_id', '=', user.partner_id.id), ('is_rented', '=', True)
            ]</field>
        </record>

        <record id="rule_building_portal" model="ir.rule">
            <field name="name">Immeubles : ceux où l'on a une fraction</field>
            <field name="model_id" ref="bf_property_core.model_bf_property_building"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('unit_ids', 'any', ['|',
                ('ownership_ids', 'any',
                    [('partner_id', '=', user.partner_id.id), ('is_current', '=', True)]),
                '&amp;', ('occupant_id', '=', user.partner_id.id), ('is_rented', '=', True)
            ])]</field>
        </record>

        <record id="rule_syndicat_portal" model="ir.rule">
            <field name="name">Syndicats : ceux où l'on a une fraction</field>
            <field name="model_id" ref="bf_property_core.model_bf_property_syndicat"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('unit_ids', 'any', ['|',
                ('ownership_ids', 'any',
                    [('partner_id', '=', user.partner_id.id), ('is_current', '=', True)]),
                '&amp;', ('occupant_id', '=', user.partner_id.id), ('is_rented', '=', True)
            ])]</field>
        </record>

        <!--
            Demandes d'entretien : la sienne, et rien d'autre.

            ⚠️ Un copropriétaire pourrait plaider qu'il a intérêt à voir les
            billets ouverts sur les parties communes. On ne le lui donne pas :
            un billet décrit souvent un problème chez quelqu'un, avec son
            numéro de porte et ses mots à lui. L'art. 1070 al. 1 C.c.Q. ne met
            au registre les renseignements personnels d'un tiers qu'avec son
            consentement exprès ; publier le fil des voisins ferait exactement
            l'inverse. Le syndicat, lui, voit tout depuis le bureau.

            La création est ouverte au portail, mais elle est gardée par
            `create()` côté serveur : un `unit_id` posté n'est pas une preuve.
        -->
        <record id="rule_request_portal" model="ir.rule">
            <field name="name">Demandes d'entretien : la sienne seulement</field>
            <field name="model_id" ref="model_bf_property_request"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('requester_partner_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="rule_request_company" model="ir.rule">
            <field name="name">Demandes d'entretien : multi-société</field>
            <field name="model_id" ref="model_bf_property_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Cloisonnement multi-société, comme partout ailleurs dans la suite. -->
        <record id="rule_announcement_company" model="ir.rule">
            <field name="name">Annonces : multi-société</field>
            <field name="model_id" ref="model_bf_property_announcement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_document_company" model="ir.rule">
            <field name="name">Documents : multi-société</field>
            <field name="model_id" ref="model_bf_property_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
