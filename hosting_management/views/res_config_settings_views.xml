<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_hosting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hosting</field>
        <field name="model">res.config.settings</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Hosting" string="Hosting" name="hosting_management">
                    <block title="Audit log" name="audit_log">
                        <setting string="Retention" help="How long audit log entries are kept. Older entries are deleted monthly.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_audit_log_retention_months" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_audit_log_retention_months" class="oe_inline"/> months
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Health check alerts" name="health_check_alerts">
                        <setting string="Alert email" help="Email address that receives health check alerts">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_health_alert_email" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_health_alert_email" class="oe_inline" placeholder="alerts@company.com"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Response time threshold" help="Services responding slower than this threshold will trigger a warning">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_response_time_threshold_ms" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_response_time_threshold_ms" class="oe_inline"/> ms
                                </div>
                            </div>
                        </setting>
                        <setting string="Expiration warning" help="Create warning activities this many days before the service expires">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_expiration_warning_days" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_expiration_warning_days" class="oe_inline"/> days before expiration
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Domains and SSL" name="domains_ssl">
                        <setting string="Domain warning" help="Create warning activities this many days before the domain expires">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_domain_expiration_warning_days" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_domain_expiration_warning_days" class="oe_inline"/> days before expiration
                                </div>
                            </div>
                        </setting>
                        <setting string="SSL warning" help="Create warning activities this many days before the SSL certificate expires">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_ssl_expiration_warning_days" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_ssl_expiration_warning_days" class="oe_inline"/> days before expiration
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Cloudflare Registrar integration" name="cloudflare_integration">
                        <setting string="Cloudflare credentials" help="The Registrar API requires the global API key (API tokens do not work for these endpoints).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_cloudflare_email" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_cloudflare_email" class="oe_inline" placeholder="email@company.com"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_cloudflare_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_cloudflare_api_key" class="oe_inline" password="True"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_cloudflare_account_id" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_cloudflare_account_id" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Synchronization" help="Manually sync the domains registered with Cloudflare">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_last_cloudflare_sync" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_last_cloudflare_sync" class="oe_inline"/>
                                </div>
                                <div class="mt16">
                                    <button name="action_sync_cloudflare_domains"
                                            type="object"
                                            string="Sync Cloudflare"
                                            class="btn-primary"
                                            icon="fa-cloud-download"
                                            confirm="Sync domains from Cloudflare?"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Action1 integration (client fleet RMM)" name="action1_integration">
                        <setting string="Activation" help="Enables the Action1 sync cron (every 6 hours).">
                            <field name="hosting_action1_enabled" widget="boolean_toggle"/>
                        </setting>
                        <setting string="Action1 credentials" help="Bearer token for the Action1 console API. See https://app.action1.com/integrations/api">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_action1_api_token" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_action1_api_token" class="oe_inline" password="True"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_action1_api_base_url" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_action1_api_base_url" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_action1_console_base" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_action1_console_base" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Conflict resolution" help="When Action1 and Odoo entries differ on an existing endpoint. Override per endpoint with the &quot;Manual entry takes priority&quot; checkbox.">
                            <field name="hosting_action1_conflict_strategy" class="oe_inline"/>
                        </setting>
                        <setting string="Manual sync" help="Run the Action1 sync right away.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_action1_last_sync" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_action1_last_sync" class="oe_inline"/>
                                </div>
                                <div class="mt16">
                                    <button name="action_sync_action1_now"
                                            type="object"
                                            string="Sync Action1 now"
                                            class="btn-primary"
                                            icon="fa-refresh"
                                            confirm="Run the sync of endpoints and groups from Action1?"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="VOIP.ms telephony (DID, stats, balance)" name="voipms_integration">
                        <setting string="Activation" help="Enables the VOIP.ms sync crons (DID, CDR, transactions, balance), read-only, every 6 hours.">
                            <field name="hosting_voipms_enabled" widget="boolean_toggle"/>
                        </setting>
                        <setting string="VOIP.ms API credentials" help="The API and the IP allowlist are configured at voip.ms/m/api.php. The Odoo server's outgoing IP must be listed there. The API password is separate from the login password.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_voipms_api_username" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_voipms_api_username" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_voipms_api_password" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_voipms_api_password" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Settings" help="Low balance alert threshold (daily ntfy alert) and depth of the CDR/transaction history fetched.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_voipms_low_balance_threshold" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_voipms_low_balance_threshold" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_voipms_cdr_backfill_days" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_voipms_cdr_backfill_days" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Balance and sync" help="Last balance read and last sync. Buttons: test the connection and sync right away.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_voipms_last_balance" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_voipms_last_balance" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_voipms_last_balance_date" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_voipms_last_balance_date" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_voipms_last_sync" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_voipms_last_sync" class="oe_inline"/>
                                </div>
                                <div class="mt16">
                                    <button name="action_test_voipms_connection"
                                            type="object"
                                            string="Test the connection"
                                            class="btn-secondary"
                                            icon="fa-plug"/>
                                    <button name="action_sync_voipms_now"
                                            type="object"
                                            string="Sync VOIP.ms now"
                                            class="btn-primary"
                                            icon="fa-refresh"
                                            confirm="Run the sync of DIDs, CDRs, transactions and balance from VOIP.ms?"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Tenant provisioning (API)" name="provision_api">
                        <setting string="API token" help="Shared token sent by the create_nextcloud_tenant.sh and create_odoo_client.sh scripts in the X-Provision-Token header to /api/hosting/provision/report.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_provision_api_token" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_provision_api_token" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Push notifications (ntfy)" name="ntfy_push">
                        <setting string="ntfy server" help="Configure the ntfy server to receive push notifications on service outages">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_ntfy_url" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_ntfy_url" class="oe_inline" placeholder="https://ntfy.example.com"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_ntfy_token" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_ntfy_token" class="oe_inline" password="True"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_ntfy_topic" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_ntfy_topic" class="oe_inline" placeholder="hosting-alerts"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Backup reports by email" name="backup_reports">
                        <setting string="Enable reports">
                            <field name="hosting_backup_report_enabled"/>
                        </setting>
                        <setting string="Sending mode" invisible="not hosting_backup_report_enabled">
                            <field name="hosting_backup_report_mode" widget="radio"/>
                        </setting>
                        <setting string="Recipients" invisible="not hosting_backup_report_enabled">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="hosting_backup_report_recipients"
                                           class="oe_inline"
                                           placeholder="alice@example.com, bob@example.com"/>
                                </div>
                                <div class="text-muted mt8">
                                    Comma-separated addresses. If empty, the email of the report's company is used.
                                </div>
                            </div>
                        </setting>
                        <setting string="Daily sending time"
                                 invisible="not hosting_backup_report_enabled or hosting_backup_report_mode != 'scheduled'">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_backup_report_send_hour" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_backup_report_send_hour" class="oe_inline"/> h
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_backup_report_timezone" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_backup_report_timezone" class="oe_inline"/>
                                </div>
                                <div class="text-muted mt8">
                                    In scheduled mode, a single email is sent per day at this local time, grouping the latest run per host.
                                </div>
                            </div>
                        </setting>
                        <setting string="Limit to problematic runs"
                                 help="If enabled, no email is sent for a fully successful backup. ntfy notifications stay active on failure."
                                 invisible="not hosting_backup_report_enabled">
                            <field name="hosting_backup_report_only_on_issues"/>
                        </setting>
                        <setting string="Test sending"
                                 help="Resends the report of the latest backup run to the configured recipients right away."
                                 invisible="not hosting_backup_report_enabled">
                            <div class="mt16">
                                <button name="action_send_backup_report_test"
                                        type="object"
                                        string="Send a test report"
                                        class="btn-primary"
                                        icon="fa-paper-plane"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Maintenance window" name="maintenance_window">
                        <setting string="Enable the maintenance window" help="When enabled, health alerts are suppressed during the maintenance window. Checks continue but notifications are not sent.">
                            <field name="hosting_maintenance_window_enabled"/>
                        </setting>
                        <setting string="Maintenance calendar" help="Set the daily maintenance window during which alerts are suppressed" invisible="not hosting_maintenance_window_enabled">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="hosting_maintenance_start_hour" string="Start time" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_maintenance_start_hour" widget="float_time" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_maintenance_end_hour" string="End time" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_maintenance_end_hour" widget="float_time" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="hosting_maintenance_timezone" string="Time zone" class="col-lg-3 o_light_label"/>
                                    <field name="hosting_maintenance_timezone" class="oe_inline"/>
                                </div>
                                <div class="text-muted mt8">
                                    Default: 1:30 to 2:30. During this window, health checks continue but alert emails are suppressed.
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Action to open hosting settings directly -->
    <record id="action_hosting_config_settings" model="ir.actions.act_window">
        <field name="name">Hosting settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'hosting_management', 'bin_size': False}</field>
    </record>

</odoo>
