<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_partner_add_to_outreach" model="ir.actions.server">
        <field name="name">Ajouter à une campagne de démarchage</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[Command.link(ref('bf_outreach.group_bf_outreach_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = env["bf.outreach.target.import.wizard"].action_open_from_partners(records)</field>
    </record>

    <record id="action_target_write_letters" model="ir.actions.server">
        <field name="name">Préparer les lettres</field>
        <field name="model_id" ref="model_bf_outreach_target"/>
        <field name="binding_model_id" ref="model_bf_outreach_target"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[Command.link(ref('bf_outreach.group_bf_outreach_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_write_letters()</field>
    </record>

    <record id="action_target_send_email" model="ir.actions.server">
        <field name="name">Envoyer le courriel de campagne</field>
        <field name="model_id" ref="model_bf_outreach_target"/>
        <field name="binding_model_id" ref="model_bf_outreach_target"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[Command.link(ref('bf_outreach.group_bf_outreach_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_send_campaign_email()</field>
    </record>

</odoo>
