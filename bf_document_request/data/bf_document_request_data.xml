<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- noupdate: a sequence's name is not translatable, and its prefix
         numbers every request. An update must neither rename it nor change
         the numbering of a database that already has requests. -->
    <data noupdate="1">
        <record id="seq_bf_document_request" model="ir.sequence">
            <field name="name">Document request</field>
            <field name="code">bf.document.request</field>
            <field name="prefix">REQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- The client's deadline. Without this job, a link would stay open
         forever, which is exactly what a deadline forbids. The token is
         removed, the trace stays. -->
    <record id="cron_bf_document_expire_requests" model="ir.cron">
        <field name="name">Document requests: close overdue requests</field>
        <field name="model_id" ref="model_bf_document_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Reminders for incomplete files. The first sending was never the
         problem: the file still incomplete three days later is. Offset by 30
         minutes from the expiry job so that the two do not compete for the
         same run. -->
    <record id="cron_bf_document_send_reminders" model="ir.cron">
        <field name="name">Document requests: remind incomplete files</field>
        <field name="model_id" ref="model_bf_document_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="nextcall"
               eval="(DateTime.now() + timedelta(minutes=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Share of the daily text message quota reserved for reminders. VoIP.ms
         blocks at around 27 messages in a burst: without this cap, reminders
         could prevent a FIRST sending from going out, which is far worse.
         It only bounds text message reminders: email reminders cost nothing
         at VoIP.ms.
         noupdate: otherwise an update of the module would silently overwrite
         the cap an operator had adjusted. -->
    <data noupdate="1">
        <record id="param_bf_document_reminder_daily_cap"
                model="ir.config_parameter">
            <field name="key">bf_document_request.reminder_daily_cap</field>
            <field name="value">10</field>
        </record>
    </data>

</odoo>
