<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_note_user_pref_view_form" model="ir.ui.view">
        <field name="name">bf.note.user.preferences.form</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Notepad preferences">
                <sheet>
                    <group>
                        <field name="bf_note_default_reminder"/>
                    </group>
                    <group string="Display">
                        <field name="bf_note_layout" widget="radio"/>
                        <field name="bf_note_density" widget="radio"/>
                        <field name="bf_note_color_style" widget="radio"/>
                        <field name="bf_note_group_by_color"/>
                        <field name="bf_note_hide_shared"/>
                    </group>
                    <p class="text-muted">
                        This reminder will be preselected in the quick creation dialog
                        (systray icon or <kbd>Alt+N</kbd>). You can still change it
                        when creating.
                    </p>
                </sheet>
                <footer>
                    <button string="Save" type="object"
                            name="action_open_bf_note_preferences"
                            class="btn-primary" special="save"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 🔴 La case qui nomme un compte
         non humain. Sur la fiche d'usager, et non dans les preferences du
         bloc-notes : ce n'est pas une preference de l'usager, c'est une
         decision d'administration sur un compte, et un compte de service ne va
         pas cocher sa propre case. L'ecran des usagers est deja reserve a
         l'administration. -->
    <record id="bf_note_user_share_view_form" model="ir.ui.view">
        <field name="name">res.users.form.bf.note.share</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Notepad" name="bf_bloc_notes">
                    <field name="bf_note_no_shared_notes"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="bf_note_user_pref_action" model="ir.actions.server">
        <field name="name">My preferences</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env.user.action_open_bf_note_preferences()</field>
    </record>

</odoo>
