<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_resolution_list" model="ir.ui.view">
        <field name="name">bf.property.resolution.list</field>
        <field name="model">bf.property.resolution</field>
        <field name="arch" type="xml">
            <list decoration-success="result == 'adopted'"
                  decoration-danger="result == 'rejected'"
                  decoration-muted="result == 'pending'">
                <field name="assembly_id"/>
                <field name="name"/>
                <field name="majority_type"/>
                <field name="ballot_mode"/>
                <field name="votes_for"/>
                <field name="votes_against"/>
                <field name="votes_abstain"/>
                <field name="result" widget="badge"/>
                <field name="syndicat_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_resolution_form" model="ir.ui.view">
        <field name="name">bf.property.resolution.form</field>
        <field name="model">bf.property.resolution</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_ballot" type="object"
                            string="Ouvrir le scrutin" class="btn-primary"
                            invisible="ballot_issued_count &gt; 0 or vote_ids"/>
                    <button name="action_open_deposit" type="object"
                            string="Déposer un bulletin" class="btn-primary"
                            invisible="ballot_mode != 'secret' or ballot_issued_count == 0"/>
                    <button name="action_open_receipt_check" type="object"
                            string="Vérifier un récépissé"
                            invisible="ballot_mode != 'secret' or ballot_issued_count == 0"/>
                    <button name="action_verify_ballot_box" type="object"
                            string="Recompter l'urne"
                            invisible="ballot_mode != 'secret' or ballot_issued_count == 0"/>
                    <button name="action_reset_ballot" type="object"
                            string="Reprendre le scrutin à zéro"
                            confirm="Les bulletins remis seront détruits et de nouveaux récépissés seront tirés. Les codes déjà distribués ne vaudront plus rien."
                            invisible="ballot_mode != 'secret' or ballot_issued_count == 0 or ballot_cast_count &gt; 0"/>
                    <field name="result" widget="statusbar"
                           statusbar_visible="pending,adopted,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Adoption du budget 2026"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <field name="majority_label" readonly="1" nolabel="1"/>
                        <br/>
                        <field name="result_detail" readonly="1" nolabel="1"/>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="ballot_box_state != 'unbalanced'">
                        <field name="ballot_box_detail" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="ballot_mode != 'secret' or secret_exposure_count == 0">
                        <field name="secret_exposure_count" readonly="1" nolabel="1"
                               class="oe_inline"/>
                        bulletin(s) sont seuls de leur poids dans l'urne. Un
                        scrutin pondéré n'est secret qu'entre bulletins de même
                        poids : ceux-là se rattachent à leur auteur par simple
                        lecture du registre. Le module le dit plutôt que de
                        promettre un secret que l'arithmétique ne tient pas.
                    </div>

                    <group>
                        <group string="Portée">
                            <field name="assembly_id"/>
                            <field name="majority_type"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Mode de scrutin (art. 351 al. 2 C.c.Q.)">
                            <field name="ballot_mode"
                                   readonly="ballot_issued_count &gt; 0 or vote_ids"/>
                            <field name="secret_requested_by_id"
                                   invisible="ballot_mode != 'secret'"/>
                            <field name="secret_request_note"
                                   invisible="ballot_mode != 'secret'"/>
                            <field name="ballot_issued_count"
                                   invisible="ballot_mode != 'secret'"/>
                            <field name="ballot_cast_count"
                                   invisible="ballot_mode != 'secret'"/>
                            <field name="votes_not_cast"
                                   invisible="ballot_mode != 'secret'"/>
                            <field name="ballot_box_state"
                                   invisible="ballot_mode != 'secret'"/>
                        </group>
                        <group string="Décompte">
                            <label for="votes_for"/>
                            <div>
                                <field name="votes_for" class="oe_inline"/> voix /
                                <field name="owners_for" class="oe_inline"/> copropriétaire(s)
                            </div>
                            <label for="votes_against"/>
                            <div>
                                <field name="votes_against" class="oe_inline"/> voix /
                                <field name="owners_against" class="oe_inline"/> copropriétaire(s)
                            </div>
                            <label for="votes_abstain"/>
                            <div>
                                <field name="votes_abstain" class="oe_inline"/> voix /
                                <field name="owners_abstain" class="oe_inline"/> copropriétaire(s)
                            </div>
                        </group>
                        <group string="Correction manuelle" colspan="2">
                            <field name="result_override"/>
                            <field name="override_reason"
                                   required="result_override"
                                   invisible="not result_override"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Texte" name="text">
                            <field name="description"/>
                        </page>
                        <page string="Scrutin" name="ballot">
                            <div class="alert alert-info" role="alert"
                                 invisible="ballot_mode != 'secret'">
                                Au scrutin secret, ce registre dit seulement à
                                qui un bulletin a été remis. La colonne du vote
                                y reste vide, et le demeure : les choix vivent
                                dans l'urne, sans rien qui nomme leur auteur.
                            </div>
                            <field name="vote_ids">
                                <list editable="bottom">
                                    <field name="partner_id" readonly="1"/>
                                    <field name="unit_id" readonly="1"/>
                                    <field name="votes" readonly="1" sum="Voix"/>
                                    <field name="ballot_issued" readonly="1"
                                           optional="hide"/>
                                    <field name="choice"
                                           readonly="parent.ballot_mode == 'secret'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Urne" name="ballot_box"
                              invisible="ballot_mode != 'secret'">
                            <div class="alert alert-secondary" role="alert">
                                <field name="ballot_box_detail" readonly="1" nolabel="1"/>
                            </div>
                            <field name="secret_ballot_ids" readonly="1">
                                <list decoration-muted="not is_cast">
                                    <field name="votes" sum="Voix"/>
                                    <field name="choice"/>
                                    <field name="is_cast"/>
                                    <field name="exposed_by_weight" optional="show"/>
                                    <field name="voter_key" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_resolution" model="ir.actions.act_window">
        <field name="name">Résolutions</field>
        <field name="res_model">bf.property.resolution</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
