<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_calculator_post_form" model="ir.ui.view">
        <field name="name">bf.calculator.post.form</field>
        <field name="model">bf.calculator.post</field>
        <field name="arch" type="xml">
            <form string="Post to a chatter">
                <group>
                    <field name="target_reference" widget="bf_chatter_target"
                           required="1" string="Record"/>
                    <field name="comment" placeholder="Optional: a sentence placed above the calculation"/>
                    <field name="entry_ids" invisible="1"/>
                </group>
                <label for="preview" string="Internal note"/>
                <field name="preview" readonly="1" class="font-monospace"/>
                <footer>
                    <button name="action_post" type="object" string="Post as internal note"
                            class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
