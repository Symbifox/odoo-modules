<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_securetransfer" model="ir.ui.view">
        <field name="name">res.users.form.inherit.bf.securetransfer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Secure transfer" name="bf_securetransfer">
                    <group>
                        <group string="Personal drop page (/to/&lt;slug&gt;)">
                            <field name="st_no_drop_page"/>
                            <field name="st_drop_page_url"
                                   widget="CopyClipboardChar"
                                   invisible="not st_drop_page_url"/>
                            <field name="st_drop_page_brand_id"
                                   invisible="not st_drop_page_brand_id"/>
                        </group>
                        <div class="text-muted" colspan="2">
                            The personal drop page is only created
                            automatically if the "Drop page per
                            employee" option is enabled in the
                            Secure transfer settings.
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
