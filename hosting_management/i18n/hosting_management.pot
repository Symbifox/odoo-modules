msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Welcome!</p>\n"
"<p t-attf-style=\"margin:0 0 12px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:20px;line-height:30px;color:{{ brand_dark }};font-weight:500;\">\n"
