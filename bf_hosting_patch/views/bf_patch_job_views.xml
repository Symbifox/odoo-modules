<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_patch_job_view_list" model="ir.ui.view">
        <field name="name">bf.patch.job.list</field>
        <field name="model">bf.patch.job</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired',)"
                  decoration-danger="state == 'failed'"
                  decoration-success="state == 'done'"
                  decoration-info="state in ('claimed', 'running')">
                <field name="create_date" string="Requested on"/>
                <field name="endpoint_id"/>
                <field name="system_id"/>
                <field name="scope"/>
                <field name="package_names" optional="hide"/>
                <field name="reboot_after"/>
                <field name="requested_by" widget="many2one_avatar_user"/>
                <field name="claimed_at" optional="hide"/>
                <field name="finished_at" optional="show"/>
                <field name="packages_changed" sum="Packages"/>
                <field name="exit_code" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="bf_patch_job_view_form" model="ir.ui.view">
        <field name="name">bf.patch.job.form</field>
        <field name="model">bf.patch.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object"
                            string="Remove from queue" class="btn-secondary"
                            invisible="state not in ('queued', 'claimed')"
                            confirm="Remove this job from the queue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="queued,claimed,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="system_id"
                                   readonly="state != 'queued'"
                                   options="{'no_create': True}"/>
                            <field name="endpoint_id"/>
                            <field name="partner_id" optional="hide"/>
                        </group>
                        <group string="What will be applied">
                            <field name="scope" readonly="state != 'queued'"/>
                            <field name="package_names"
                                   invisible="scope != 'named'"
                                   required="scope == 'named'"
                                   readonly="state != 'queued'"/>
                            <field name="reboot_after"
                                   readonly="state != 'queued'"/>
                            <field name="window_start"
                                   readonly="state != 'queued'"/>
                        </group>
                    </group>
                    <group string="Outcome"
                           invisible="state in ('queued', 'claimed')">
                        <group>
                            <field name="requested_by"/>
                            <field name="claimed_at"/>
                            <field name="finished_at"/>
                        </group>
                        <group>
                            <field name="exit_code"/>
                            <field name="packages_changed"/>
                        </group>
                    </group>
                    <notebook invisible="not output">
                        <page string="Machine output" name="output">
                            <field name="output" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_patch_job_view_search" model="ir.ui.view">
        <field name="name">bf.patch.job.search</field>
        <field name="model">bf.patch.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="system_id"/>
                <field name="endpoint_id"/>
                <field name="requested_by"/>
                <filter name="open" string="In progress"
                        domain="[('state', 'in', ('queued', 'claimed', 'running'))]"/>
                <filter name="failed" string="Failed jobs"
                        domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="security" string="Security"
                        domain="[('scope', '=', 'security')]"/>
                <group expand="0" string="Group by">
                    <filter name="by_machine" string="Machine"
                            context="{'group_by': 'endpoint_id'}"/>
                    <filter name="by_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_patch_job_action" model="ir.actions.act_window">
        <field name="name">Update jobs</field>
        <field name="res_model">bf.patch.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No job in the queue.</p>
            <p>
                A job is pulled, not pushed: Odoo drops it here, and the machine's agent picks it up at its next poll. A machine that is switched off does not miss it; it takes it when it wakes up.
            </p>
            <p>
                Nothing is sent to a machine where the file <code>/etc/symbifox/apply-allowed</code> is missing.
            </p>
        </field>
    </record>

</odoo>
