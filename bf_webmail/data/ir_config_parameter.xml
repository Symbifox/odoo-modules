<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="param_webmail_url" model="ir.config_parameter">
        <field name="key">bf_webmail.webmail_url</field>
        <field name="value">https://nextcloud.example.com/index.php/apps/snappymail/</field>
    </record>
    <record id="param_imap_host" model="ir.config_parameter">
        <field name="key">bf_webmail.imap_host</field>
        <field name="value">imap.example.com</field>
    </record>
    <record id="param_imap_port" model="ir.config_parameter">
        <field name="key">bf_webmail.imap_port</field>
        <field name="value">993</field>
    </record>
    <record id="param_imap_user" model="ir.config_parameter">
        <field name="key">bf_webmail.imap_user</field>
        <field name="value"></field>
    </record>
    <record id="param_imap_password_encrypted" model="ir.config_parameter">
        <field name="key">bf_webmail.imap_password_encrypted</field>
        <field name="value"></field>
    </record>
</odoo>
