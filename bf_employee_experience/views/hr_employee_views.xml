<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_ex" model="ir.ui.view">
        <field name="name">hr.employee.form.employee.experience</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ex_entitlements" type="object"
                        class="oe_stat_button" icon="fa-gift"
                        groups="hr.group_hr_user">
                    <field name="ex_entitlement_count" widget="statinfo" string="Avantages"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
