#. module: bf_property_operations_portal
#: model:ir.model,name:bf_property_operations_portal.model_bf_property_request
msgid "Demande d'entretien"
msgstr "Maintenance request"

#. module: bf_property_operations_portal
#: model:ir.model.fields,field_description:bf_property_operations_portal.field_maintenance_request__bf_request_id
msgid "Demande de l'occupant"
msgstr "Occupant's request"

#. module: bf_property_operations_portal
#: model:ir.model.fields,help:bf_property_operations_portal.field_bf_property_request__maintenance_team_id
msgid ""
"L'équipe qui répond de l'immeuble. Elle se déduit de l'immeuble et reste "
"modifiable : une demande peut sortir de l'ordinaire."
msgstr ""
"The team answering for the immovable. It is inferred from the immovable and "
"stays editable: a request may be out of the ordinary."

#. module: bf_property_operations_portal
#: model:ir.model.fields,help:bf_property_operations_portal.field_maintenance_request__bf_request_id
msgid ""
"La demande d'où vient ce travail, lorsqu'il en vient d'une. Un préventif "
"cédulé n'en a pas."
msgstr ""
"The request this work comes from, where it comes from one. A scheduled "
"preventive work has none."

#. module: bf_property_operations_portal
#: model:ir.model,name:bf_property_operations_portal.model_maintenance_request
msgid "Maintenance Request"
msgstr "Maintenance Request"

#. module: bf_property_operations_portal
#: model:ir.model.fields,field_description:bf_property_operations_portal.field_bf_property_request__work_count
