#. odoo-python
#: code:addons/bf_process/models/document.py:0
msgid ""
"Activity performed\n"
"by a person"
msgstr ""
"Activité tenue\n"
"par une personne"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/document.py:0
msgid ""
"Activity that receives\n"
"a message"
msgstr ""
"Activité qui reçoit\n"
"un message"

