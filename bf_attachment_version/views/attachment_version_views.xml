<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_attachment_version_list" model="ir.ui.view">
        <field name="name">bf.attachment.version.list</field>
        <field name="model">bf.attachment.version</field>
        <field name="arch" type="xml">
            <list string="Kept versions" create="false" edit="false">
                <field name="create_date" string="Replaced on"/>
                <field name="attachment_id"/>
                <field name="numero"/>
                <field name="name"/>
                <field name="res_model" optional="show"/>
                <field name="origine"/>
                <field name="file_size" sum="Total"/>
                <field name="create_uid" string="Replaced by"/>
                <button name="action_telecharger" type="object" icon="fa-download"
                        title="Download this version"/>
                <button name="action_restaurer" type="object" icon="fa-undo"
                        title="Put this content back into the attachment"
                        confirm="The current content will be replaced by this one. It will itself be kept as a new version."/>
            </list>
        </field>
    </record>

    <record id="view_bf_attachment_version_form" model="ir.ui.view">
        <field name="name">bf.attachment.version.form</field>
        <field name="model">bf.attachment.version</field>
        <field name="arch" type="xml">
            <form string="Kept version" create="false" edit="false">
                <header>
                    <button name="action_telecharger" type="object" string="Download"
                            class="btn-primary"/>
                    <button name="action_restaurer" type="object" string="Restore"
                            confirm="The current content will be replaced by this one. It will itself be kept as a new version."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>Version <field name="numero" readonly="1" class="oe_inline"/></h3>
                    </div>
                    <group>
                        <group string="Attachment">
                            <field name="attachment_id" readonly="1"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                        </group>
                        <group string="What was kept">
                            <field name="mimetype" readonly="1"/>
                            <field name="file_size" readonly="1"/>
                            <field name="checksum" readonly="1"/>
                            <field name="content_id" readonly="1"/>
                        </group>
                        <group string="Replacement">
                            <field name="create_date" string="Date" readonly="1"/>
                            <field name="create_uid" string="By" readonly="1"/>
                            <field name="origine" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bf_attachment_version_search" model="ir.ui.view">
        <field name="name">bf.attachment.version.search</field>
        <field name="model">bf.attachment.version</field>
        <field name="arch" type="xml">
            <search string="Kept versions">
                <field name="name"/>
                <field name="attachment_id"/>
                <field name="res_model"/>
                <field name="checksum"/>
                <filter name="filtre_onlyoffice" string="ONLYOFFICE editor"
                        domain="[('origine', '=', 'onlyoffice')]"/>
                <filter name="filtre_collabora" string="Collabora editor"
                        domain="[('origine', '=', 'collabora')]"/>
                <separator/>
                <filter name="filtre_semaine" string="Last seven days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group by">
                    <filter name="groupe_piece" string="Attachment"
                            context="{'group_by': 'attachment_id'}"/>
                    <filter name="groupe_modele" string="Related model"
                            context="{'group_by': 'res_model'}"/>
                    <filter name="groupe_origine" string="Origin"
                            context="{'group_by': 'origine'}"/>
                    <filter name="groupe_date" string="Replacement date"
                            context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_attachment_version" model="ir.actions.act_window">
        <field name="name">Attachment versions</field>
        <field name="res_model">bf.attachment.version</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bf_attachment_version_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No version kept yet.</p>
            <p>A version appears here as soon as an attachment has its content replaced, by an office editor or otherwise. It holds the bytes from before the replacement.</p>
        </field>
    </record>

    <menuitem id="menu_bf_attachment_version"
              name="Attachment versions"
              parent="base.next_id_9"
              action="action_bf_attachment_version"
              sequence="21"/>
</odoo>
