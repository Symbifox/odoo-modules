<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_retail_order_guide_view_list" model="ir.ui.view">
        <field name="name">bf.retail.order.guide.list</field>
        <field name="model">bf.retail.order.guide</field>
        <field name="arch" type="xml">
            <list string="Order guides">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="delivery_date"/>
                <field name="to_order_count" string="To order"/>
                <field name="amount_total" sum="Total"/>
                <field name="below_minimum" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'computed'"
                       decoration-success="state == 'ordered'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="bf_retail_order_guide_view_form" model="ir.ui.view">
        <field name="name">bf.retail.order.guide.form</field>
        <field name="model">bf.retail.order.guide</field>
        <field name="arch" type="xml">
            <form string="Order guide">
                <header>
                    <button name="action_compute" type="object" string="Fill from the shelf"
                            class="btn-primary" invisible="state not in ('draft', 'computed')"
                            help="Refreshes every item of this supplier. A quantity typed by hand is left alone."/>
                    <button name="action_create_rfq" type="object"
                            string="Make the request for quotation" class="btn-primary"
                            invisible="state != 'computed' or to_order_count == 0"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state in ('closed',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,ordered"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state not in ('draft', 'computed')"
                                   options="{'no_create': True}"/>
                            <field name="warehouse_id" readonly="state != 'draft'"
                                   groups="stock.group_stock_multi_warehouses"/>
                            <field name="date" readonly="state not in ('draft', 'computed')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="delivery_date" invisible="state == 'draft'"/>
                            <field name="cover_until" invisible="state == 'draft'"/>
                            <field name="amount_total"/>
                            <field name="minimum" invisible="not minimum"/>
                            <field name="order_id" invisible="not order_id"/>
                            <field name="below_minimum" invisible="1"/>
                            <field name="price_missing_count" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not below_minimum">
                        The order is below this supplier's minimum.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not price_missing_count">
                        Some items have no price in force from this supplier: the No price
                        column says which, the total leaves them out, and no request for
                        quotation goes out on them.
                    </div>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids" readonly="state in ('ordered', 'closed')">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-danger="cost_delta_pct &gt; 0"
                                      decoration-success="cost_delta_pct &lt; 0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="on_hand" readonly="1" optional="show"/>
                                    <field name="forecast" readonly="1" optional="show"/>
                                    <field name="in_progress" readonly="1" optional="hide"/>
                                    <field name="min_qty" readonly="1" optional="hide"/>
                                    <field name="max_qty" readonly="1" optional="hide"/>
                                    <field name="credited_qty" readonly="1" optional="show"/>
                                    <field name="cost_last" readonly="1" optional="hide"/>
                                    <field name="cost_delta_pct" readonly="1" optional="show"/>
                                    <field name="suggested" readonly="1"/>
                                    <field name="qty"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="stock_uom_id" readonly="1" optional="show"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="price_missing" readonly="1"
                                           optional="show"/>
                                    <field name="amount" readonly="1" sum="Total"/>
                                    <field name="edited" readonly="1" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bf_retail_order_guide" model="ir.actions.act_window">
        <field name="name">Order guides</field>
        <field name="res_model">bf.retail.order.guide</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No order guide yet</p>
            <p>One guide per supplier and per order. It stays open while the aisle is walked,
               keeps what was typed, and makes Odoo's request for quotation when it is done.</p>
        </field>
    </record>
</odoo>
