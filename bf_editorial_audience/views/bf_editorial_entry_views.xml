<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_editorial_entry_form_audience" model="ir.ui.view">
        <field name="name">bf.editorial.entry.form.audience</field>
        <field name="model">bf.editorial.entry</field>
        <field name="inherit_id" ref="bf_editorial.view_editorial_entry_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Audience" name="audience"
                      invisible="not post_id">
                    <div class="alert alert-info" role="alert">
                        "Tracked views" is not the raw figure: Odoo itself drops from its tracking any agent that calls itself a bot. The raw figure is the native counter, on the right. What you see here is the split of what Odoo agreed to track, in three buckets that add up. The "agent not recorded" bucket holds everything that could not be read, including every visit from before the capture went live.
                    </div>
                    <group>
                        <group string="Since the first snapshot">
                            <field name="audience_first_day"/>
                            <field name="audience_tracked"/>
                            <field name="audience_human"/>
                            <field name="audience_bot"/>
                            <field name="audience_unknown"/>
                            <field name="audience_bot_share" widget="percentage"/>
                        </group>
                        <group string="Native counter">
                            <field name="raw_visits"/>
                        </group>
                    </group>
                    <field name="audience_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="capture_date"/>
                            <field name="lang_id"/>
                            <field name="tracked_views" sum="Tracked"/>
                            <field name="human_views" sum="Human"/>
                            <field name="bot_views" sum="Bots"/>
                            <field name="unknown_views" sum="Not recorded"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
