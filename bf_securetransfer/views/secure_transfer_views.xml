<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="secure_transfer_view_tree" model="ir.ui.view">
        <field name="name">secure.transfer.list</field>
        <field name="model">secure.transfer</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'"
                  decoration-muted="state in ('deleted', 'cancelled')"
                  decoration-danger="state == 'suspended'"
                  create="false">
                <field name="name"/>
                <field name="subject" optional="show"/>
                <field name="brand_id" optional="show"/>
                <field name="sender_email"/>
                <field name="recipient_emails" optional="hide"/>
                <!-- Sizes are bytes (Float — int4 overflows at 2.1 GB). No
                     core list widget renders human sizes; the sum is still
                     useful for sorting/aggregating. -->
                <field name="total_size" string="Size (bytes)" sum="Total"/>
                <field name="has_password" string="Protected" optional="show"/>
                <field name="download_count" string="Downloads" optional="show"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'expired'"
                       decoration-danger="state == 'suspended'"/>
                <field name="create_date" optional="show"/>
                <field name="draft_kept" string="Kept draft" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="secure_transfer_view_form" model="ir.ui.view">
        <field name="name">secure.transfer.form</field>
        <field name="model">secure.transfer</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <!-- Les trois gestes du brouillon. Ils n'existaient pas :
                         la barre entière était invisible hors de
                         active/expired/suspended, donc un brouillon posé par
                         la page publique ou par RPC était muet à l'écran.
                         ⚠ `draft_editable_by_me` répète à l'écran la porte de
                         `_assert_draft_editable` : propriétaire, ou
                         gestionnaire. Le groupe seul laissait un collègue du
                         rôle Utilisateur voir trois boutons sur le brouillon
                         de quelqu'un d'autre et n'apprendre le refus qu'en
                         cliquant. L'écran n'est PAS la garde : elle est au
                         modèle, parce qu'une méthode publique est une surface
                         RPC. -->
                    <field name="draft_editable_by_me" invisible="1"/>
                    <button name="action_send_now" type="object" string="Send"
                            class="oe_highlight"
                            groups="bf_securetransfer.group_securetransfer_user"
                            invisible="state != 'draft' or not draft_editable_by_me"
                            confirm="The link goes out to the recipients now, each with their own code. Once sent, the files and the recipients can no longer be changed. Continue?"/>
                    <button name="action_add_file" type="object" string="Add a file"
                            groups="bf_securetransfer.group_securetransfer_user"
                            invisible="state != 'draft' or not draft_editable_by_me"/>
                    <button name="action_keep_draft" type="object"
                            string="Keep this draft"
                            groups="bf_securetransfer.group_securetransfer_user"
                            invisible="state != 'draft' or draft_kept or not draft_editable_by_me"
                            help="The hourly cleanup removes any draft older than its grace period, files included. A kept draft waits as long as it has to."/>
                    <button name="action_reveal_link" type="object" string="Reveal link"
                            groups="bf_securetransfer.group_securetransfer_manager"
                            invisible="state != 'active'"/>
                    <button name="action_require_recipient_otp" type="object"
                            string="Require a code from the recipient"
                            groups="bf_securetransfer.group_securetransfer_manager"
                            invisible="force_recipient_otp or state not in ('active', 'expired', 'suspended')"
                            confirm="The link will no longer open without a code sent to one of the recipient addresses. Emails already sent are not recalled. Continue?"/>
                    <button name="action_resend_emails" type="object"
                            string="Re-send the link to everyone"
                            groups="bf_securetransfer.group_securetransfer_manager"
                            invisible="state != 'active'"
                            confirm="The link email goes back out to EVERY recipient of this link, in their language. To reach a single person, use &quot;Send again&quot; on their line in the Visitors tab. The receipt is not re-sent to the sender. Continue?"/>
                    <button name="action_extend_expiry" type="object" string="Extend the expiry"
                            groups="bf_securetransfer.group_securetransfer_manager"
                            invisible="state not in ('active', 'expired')"/>
                    <button name="action_expire_now" type="object" string="Expire now"
                            groups="bf_securetransfer.group_securetransfer_manager"
                            invisible="state != 'active'"
                            confirm="The link will stop working immediately. Continue?"/>
                    <button name="action_suspend" type="object" string="Suspend (abuse)"
                            groups="bf_securetransfer.group_securetransfer_manager"
                            invisible="state not in ('active', 'expired')"
                            confirm="The link will stop responding, but nothing is purged (evidence preservation). Continue?"/>
                    <button name="action_reactivate" type="object" string="Reactivate"
                            groups="bf_securetransfer.group_securetransfer_manager"
                            invisible="state != 'suspended'"
                            confirm="Reactivate this suspended transfer (report dismissed after review)?"/>
                    <button name="action_purge_now" type="object" string="Purge files"
                            groups="bf_securetransfer.group_securetransfer_manager"
                            invisible="state not in ('expired', 'suspended')"
                            confirm="The objects will be permanently deleted from S3 storage. The metadata and the access log are kept. Continue?"/>
                    <button name="action_print_certificate" type="object" string="Access certificate (PDF)"
                            groups="bf_securetransfer.group_securetransfer_user"/>
                    <button name="action_export_log" type="object" string="Export the log (CSV)"
                            groups="bf_securetransfer.group_securetransfer_manager"/>
                    <button name="action_verify_log_chain" type="object" string="Verify integrity"
                            groups="bf_securetransfer.group_securetransfer_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired,deleted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_fanout_batch" type="object"
                                class="oe_stat_button" icon="fa-users"
                                invisible="fanout_count == 0">
                            <field name="fanout_count" widget="statinfo"
                                   string="In this batch"/>
                        </button>
                    </div>
                    <!-- ⚠ Pas de balise en ligne dans ces textes : un
                         `<span>` ou un `<strong>` au milieu d'une phrase fond
                         les deux morceaux en un seul msgid, markup compris, et
                         la traduction casse à la première réindentation
                         (mesuré sur l'export du catalogue). -->
                    <field name="draft_kept" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft' or not draft_kept">
                        <div>
                            A kept draft: the files are on storage, no link exists yet and nothing has been sent. It waits here as long as it has to. Add the missing piece, then send.
                        </div>
                        <!-- ⚠ Un texte nu à côté du champ, jamais dans un
                             `<span>` : la balise entre dans le msgid, et deux
                             `<span>` voisins n'en font qu'un seul, markup et
                             indentation compris. Mesuré sur l'export. -->
                        <div class="text-muted">
                            Kept since
                            <field name="draft_kept_at" nolabel="1"
                                   readonly="1" class="oe_inline"/>
                        </div>
                        <field name="draft_storage_net_unknown" invisible="1"/>
                        <div class="text-muted"
                             invisible="draft_storage_net_unknown">
                            Files deleted from storage on
                            <field name="draft_storage_deadline" nolabel="1"
                                   readonly="1" class="oe_inline"/>
                        </div>
                        <!-- 🔴 Aucune date inventée. La règle de cycle de vie
                             du seau n'a jamais été posée sur ce locataire, ou
                             l'a été sous un autre préfixe : on ne sait donc
                             pas quand le fournisseur efface. Avant 18.0.1.23.0
                             la fiche recalculait la date à chaque lecture, et
                             relever la rétention d'une marque la repoussait
                             sans toucher au seau — l'opérateur lisait une date
                             PLUS TARDIVE que la réalité. -->
                        <div class="text-muted"
                             invisible="not draft_storage_net_unknown">
                            Storage net unknown: no lifecycle rule has been posted on the bucket from this database. Run "Configure the S3 bucket" in the settings to post it and learn this date.
                        </div>
                    </div>
                    <!-- 🔴 La seule fin que « sans fin » a : la règle de cycle
                         de vie du seau efface tout objet du préfixe après son
                         délai, quoi qu'Odoo en pense. Sans ce bandeau, la
                         perte ne se dirait qu'à l'envoi, par un refus de
                         vérification au stockage. -->
                    <field name="draft_storage_warning" invisible="1"/>
                    <div class="alert alert-danger" role="alert"
                         invisible="not draft_storage_warning">
                        <div>
                            This draft is about to lose its files: the storage provider deletes anything left under our prefix after the date above, and that date is near. Send it, or upload the files again on a new transfer.
                        </div>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'draft' or draft_kept">
                        <div>
                            This draft is not kept: the hourly cleanup removes any draft past its grace period, files included. Use "Keep this draft" to hold it.
                        </div>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Sender">
                            <field name="sender_name" readonly="1"/>
                            <field name="sender_email" readonly="1"/>
                            <field name="recipient_emails" readonly="1"/>
                            <!-- Sur un envoi fendu, le champ ci-dessus garde
                                 la liste du LOT et celui-ci nomme la seule
                                 personne que CE lien sert. Lire le premier
                                 pour savoir qui peut ouvrir serait faux. -->
                            <field name="fanout_recipient" readonly="1"
                                   invisible="not fanout_recipient"/>
                        </group>
                        <group string="Transfer">
                            <field name="brand_id" readonly="1"/>
                            <field name="locale" readonly="1"/>
                            <field name="has_password" readonly="1"/>
                            <!-- The EFFECTIVE gate, not the per-transfer flag:
                                 an instance that requires the code for every
                                 transfer leaves force_recipient_otp unticked,
                                 which made a gated transfer read as open. The
                                 flag stays in the view (invisible) because the
                                 header button keys off it. -->
                            <field name="recipient_otp_status" readonly="1"/>
                            <field name="force_recipient_otp" invisible="1"/>
                            <field name="recipient_otp_channel" readonly="1"
                                   invisible="recipient_otp_status == 'off' or audience_mode == 'open'"/>
                            <field name="audience_mode" readonly="1"/>
                            <!-- Chargés pour l'onglet Visiteurs. ⚠ La
                                 visibilité se décide sur le TOTAL, pas sur
                                 les confirmés : un envoi dont personne n'a
                                 encore confirmé n'affichait aucune liste —
                                 justement le cas où l'opérateur a besoin de
                                 voir qui n'est pas venu. -->
                            <field name="audience_count" invisible="1"/>
                            <field name="audience_total_count" invisible="1"/>
                            <field name="absentee_count" invisible="1"/>
                            <field name="downloads_unattributed" invisible="1"/>
                            <field name="fanout_count" invisible="1"/>
                            <!-- Modifiables tant que le lien vit : ce sont les
                                 seuls garde-fous d'une audience ouverte, et
                                 devoir expirer le lien pour resserrer un
                                 plafond serait pire que de le laisser large. -->
                            <field name="audience_max"
                                   invisible="audience_mode != 'open'"
                                   readonly="state not in ('draft', 'active')"/>
                            <field name="audience_max_downloads"
                                   invisible="audience_mode != 'open'"
                                   readonly="state not in ('draft', 'active')"/>
                            <field name="audience_allow_sms" readonly="1"
                                   invisible="audience_mode != 'open'"/>
                            <field name="notify_on_join"
                                   invisible="audience_mode != 'open'"
                                   readonly="state not in ('draft', 'active')"/>
                            <field name="audience_domains"
                                   invisible="audience_mode != 'open'"
                                   readonly="state not in ('draft', 'active')"/>
                            <field name="notify_on_download" readonly="1"/>
                            <field name="burn_after_download" readonly="1"/>
                            <!-- Read-only on purpose: « Prolonger l'échéance »
                                 is the sanctioned path. It stays on the
                                 durations the brand offers (the grid the S3
                                 lifecycle net is posted from) and it lands in
                                 the access trail — a hand-typed date did
                                 neither. -->
                            <field name="expiry_date" readonly="1"/>
                            <!-- Editable while expired too: raising the budget
                                 is the prerequisite to reopening a transfert
                                 that ran out of downloads rather than time. -->
                            <field name="max_downloads"
                                   readonly="state not in ('draft', 'active', 'expired')"/>
                            <field name="download_count" readonly="1"/>
                            <field name="total_size" string="Total size (bytes)" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <group string="Subject and message"
                           invisible="not subject and not message">
                        <field name="subject" readonly="1" invisible="not subject"/>
                        <field name="message" nolabel="1" readonly="1"
                               invisible="not message"/>
                    </group>
                    <notebook>
                        <page string="Files" name="page_files">
                            <field name="file_ids" readonly="1">
                                <list>
                                    <field name="filename"/>
                                    <field name="extension" optional="hide"/>
                                    <field name="size" string="Size (bytes)"/>
                                    <field name="mimetype" optional="hide"/>
                                    <field name="upload_mode" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'verified'"
                                           decoration-info="state in ('pending', 'uploading', 'uploaded')"
                                           decoration-danger="state == 'error'"/>
                                    <field name="scanned" optional="hide"/>
                                    <field name="download_count" string="Downloads"/>
                                    <field name="etag" optional="hide"/>
                                    <!-- Seulement sur un brouillon : aucun
                                         lien n'a encore été émis, donc
                                         personne ne perd un fichier qui lui
                                         avait été promis. Sur un envoi parti,
                                         le chemin reste la purge, qui garde la
                                         trace de ce qui a été servi. -->
                                    <button name="action_remove_from_draft"
                                            type="object" icon="fa-trash-o"
                                            title="Remove from the draft"
                                            groups="bf_securetransfer.group_securetransfer_user"
                                            invisible="parent.state != 'draft' or not parent.draft_editable_by_me"
                                            confirm="The file is deleted from storage and removed from this draft. The access trail keeps the record. Continue?"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visitors" name="page_audience"
                              invisible="audience_mode != 'open' and audience_total_count == 0">
                            <div class="alert alert-info" role="alert">
                                One line per person. With named recipients, every one of them is listed from the moment the transfer is sent, so you can see who downloaded, who is stuck on their code and who never came at all. On an open audience, a line appears when someone declares themselves. "Send again" re-sends the link to that one person; "Block" cuts off their access without touching the link or the others.
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 invisible="absentee_count == 0">
                                <div>
                                    <field name="absentee_count" nolabel="1"
                                           readonly="1" class="oe_inline"/>
                                    recipient(s) have left no trace at all.
                                </div>
                                <div invisible="not downloads_unattributed">This link is shared and opens without a code, so the server cannot tell who downloaded: one of them may be the person who did.</div>
                            </div>
                            <field name="audience_ids" readonly="1">
                                <list create="false" delete="false"
                                      decoration-muted="state == 'blocked'"
                                      decoration-success="state in ('confirmed', 'seen')"
                                      decoration-warning="state == 'invited'">
                                    <field name="display_identity"/>
                                    <field name="identity_kind" optional="hide"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state in ('confirmed', 'seen')"
                                           decoration-info="state == 'pending'"
                                           decoration-warning="state == 'invited'"
                                           decoration-danger="state == 'blocked'"/>
                                    <field name="first_seen"/>
                                    <field name="confirmed_at" optional="show"/>
                                    <field name="download_count"/>
                                    <field name="resend_count" optional="hide"/>
                                    <field name="last_resend_at" optional="hide"/>
                                    <field name="reminder_count" optional="hide"/>
                                    <field name="invited_at" optional="hide"/>
                                    <field name="otp_send_count" optional="hide"/>
                                    <field name="sms_send_count" optional="hide"/>
                                    <field name="ip" optional="hide"/>
                                    <button name="action_resend_link" type="object"
                                            string="Send again" icon="fa-paper-plane"
                                            invisible="state == 'blocked' or identity_kind != 'email' or parent.state != 'active'"
                                            groups="bf_securetransfer.group_securetransfer_manager"/>
                                    <button name="action_block" type="object"
                                            string="Block" icon="fa-ban"
                                            invisible="state == 'blocked'"
                                            groups="bf_securetransfer.group_securetransfer_manager"/>
                                    <button name="action_unblock" type="object"
                                            string="Unblock" icon="fa-undo"
                                            invisible="state != 'blocked'"
                                            groups="bf_securetransfer.group_securetransfer_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Log" name="page_log">
                            <field name="access_log_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="timestamp_utc"/>
                                    <field name="action"/>
                                    <field name="ip"/>
                                    <field name="actor" optional="show"/>
                                    <field name="note" optional="show"/>
                                    <field name="entry_hash" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" name="page_technical"
                              groups="bf_securetransfer.group_securetransfer_manager">
                            <group>
                                <group string="Lifecycle">
                                    <field name="finalized_at" readonly="1"/>
                                    <field name="purged_at" readonly="1"/>
                                    <field name="purge_error_count" readonly="1"/>
                                    <field name="retention_days" readonly="1"/>
                                </group>
                                <group string="Origin">
                                    <field name="ip_created" readonly="1"/>
                                    <field name="ua_created" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                The share tokens are not displayed here:
                                use "Reveal the link" (the reveal is logged).
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="secure_transfer_view_search" model="ir.ui.view">
        <field name="name">secure.transfer.search</field>
        <field name="model">secure.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Transfer"
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('subject', 'ilike', self), ('sender_email', 'ilike', self), ('recipient_emails', 'ilike', self)]"/>
                <field name="sender_email"/>
                <field name="brand_id"/>
                <filter name="f_draft" string="Drafts" domain="[('state', '=', 'draft')]"/>
                <filter name="f_draft_kept" string="Kept drafts"
                        domain="[('state', '=', 'draft'), ('draft_kept', '=', True)]"/>
                <filter name="f_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="f_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="f_deleted" string="Purged" domain="[('state', '=', 'deleted')]"/>
                <filter name="f_suspended" string="Suspended" domain="[('state', '=', 'suspended')]"/>
                <separator/>
                <filter name="f_expiring" string="Expiring soon"
                        domain="[('state', '=', 'active'), ('expiry_date', '&lt;=', (context_today() + relativedelta(days=2)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="f_protected" string="Password protected"
                        domain="[('has_password', '=', True)]"/>
                <filter name="f_open_audience" string="Open audience"
                        domain="[('audience_mode', '=', 'open')]"/>
                <separator/>
                <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="g_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
                <filter name="g_audience" string="Delivery mode"
                        context="{'group_by': 'audience_mode'}"/>
                <filter name="g_created" string="Creation date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <!-- Analytics: graph + pivot -->
    <record id="secure_transfer_view_graph" model="ir.ui.view">
        <field name="name">secure.transfer.graph</field>
        <field name="model">secure.transfer</field>
        <field name="arch" type="xml">
            <graph string="Transfers" type="bar" sample="1">
                <field name="brand_id"/>
                <field name="state"/>
                <field name="total_size" type="measure" string="Volume (bytes)"/>
            </graph>
        </field>
    </record>

    <record id="secure_transfer_view_pivot" model="ir.ui.view">
        <field name="name">secure.transfer.pivot</field>
        <field name="model">secure.transfer</field>
        <field name="arch" type="xml">
            <pivot string="Transfers" sample="1">
                <field name="brand_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_size" type="measure" string="Volume (bytes)"/>
                <field name="download_count" type="measure" string="Downloads"/>
                <field name="file_count" type="measure" string="Files"/>
            </pivot>
        </field>
    </record>

    <!-- Dashboard action (graph + pivot over ALL states) -->
    <record id="action_secure_transfer_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">secure.transfer</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="secure_transfer_view_search"/>
        <field name="context">{'search_default_g_brand': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No data yet</p>
            <p>Stored volume and downloads by brand and by state, as
                transfers arrive.</p>
        </field>
    </record>

    <!-- Action -->
    <record id="action_secure_transfer" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">secure.transfer</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="secure_transfer_view_search"/>
        <!-- ⚠ Les brouillons s'ajoutent au filtre par défaut, ils ne le
             remplacent pas : deux filtres voisins du même groupe s'unissent
             (OU), donc la liste s'ouvre sur « actifs OU brouillons ». Sans
             cela, un brouillon gardé existait sans s'afficher, et la personne
             devait savoir enlever un filtre pour retrouver l'envoi qu'elle
             venait de préparer. -->
        <field name="context">{'search_default_f_active': 1, 'search_default_f_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No transfers yet</p>
            <p>Transfers are created by visitors on the public send page.
                They will appear here with their access log.</p>
        </field>
    </record>

</odoo>
