<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_federation_document_form" model="ir.ui.view">
        <field name="name">federation.document.form</field>
        <field name="model">federation.document</field>
        <field name="arch" type="xml">
            <form string="Federated deliverable">
                <header>
                    <button name="action_acknowledge" type="object" string="I have read this deliverable"
                            class="btn-primary"
                            invisible="acknowledged or federation_origin != 'remote'"/>
                    <field name="acknowledged" widget="boolean_toggle" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Deliverable title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="version"/>
                            <field name="issued_on"/>
                            <field name="peer_partner_id"/>
                        </group>
                        <group>
                            <field name="federation_possible" invisible="1"/>
                            <field name="federation_allowed_peer_ids" invisible="1"/>
                            <field name="federation_peer_id"/>
                            <field name="federation_origin" readonly="1"/>
                            <field name="acknowledged_by" readonly="1" invisible="not acknowledged"/>
                            <field name="acknowledged_on" readonly="1" invisible="not acknowledged"/>
                            <field name="source_ref" invisible="federation_origin == 'remote'"/>
                        </group>
                    </group>
                    <group string="What it is">
                        <field name="summary" nolabel="1" placeholder="A few lines. No markup crosses over."/>
                    </group>
                    <group string="Files">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                        <field name="file_note" readonly="1" invisible="not file_note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_federation_document_list" model="ir.ui.view">
        <field name="name">federation.document.list</field>
        <field name="model">federation.document</field>
        <field name="arch" type="xml">
            <list string="Federated deliverables">
                <field name="issued_on"/>
                <field name="name"/>
                <field name="version"/>
                <field name="reference" optional="hide"/>
                <field name="federation_peer_id"/>
                <field name="federation_origin"/>
                <field name="acknowledged" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_federation_document_search" model="ir.ui.view">
        <field name="name">federation.document.search</field>
        <field name="model">federation.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="federation_peer_id"/>
                <filter name="remis" string="Delivered from here" domain="[('federation_origin', '=', 'local')]"/>
                <filter name="recus" string="Received from a peer" domain="[('federation_origin', '=', 'remote')]"/>
                <separator/>
                <filter name="a_lire" string="Without receipt" domain="[('acknowledged', '=', False)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_peer" string="Peer" context="{'group_by': 'federation_peer_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_federation_document" model="ir.actions.act_window">
        <field name="name">Federated deliverables</field>
        <field name="res_model">federation.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_federation_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Deliver a document to a peer</p>
            <p>A title, a version, a date, a file. The read receipt comes back, and nothing else.</p>
        </field>
    </record>
</odoo>
