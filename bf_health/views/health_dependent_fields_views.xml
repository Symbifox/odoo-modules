<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Le champ « Pour » sur les fiches santé.
         Vide, la fiche est à soi ; sinon, elle est tenue pour un enfant de moins
         de 14 ans. Le champ ne paraît au formulaire qu'aux parents qui tiennent
         des fiches. Le journal de prise le tient de son médicament. -->

    <record id="health_medication_view_bf_pour_form" model="ir.ui.view">
        <field name="name">health.medication.form.pour</field>
        <field name="model">health.medication</field>
        <field name="inherit_id" ref="health_medication_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-info" role="status" invisible="not bf_partage_par">
                    Fiche partagée avec vous par
                    <field name="bf_partage_par" class="fw-bold" readonly="1" options="{'no_open': True}"/>,
                    en lecture seule.
                </div>
                <group>
                    <field name="bf_tient_des_fiches" invisible="1"/>
                    <field name="dependent_id" placeholder="Moi"
                           invisible="not bf_tient_des_fiches and not dependent_id"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="health_medication_view_bf_pour_list" model="ir.ui.view">
        <field name="name">health.medication.list.pour</field>
        <field name="model">health.medication</field>
        <field name="inherit_id" ref="health_medication_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="dependent_id" optional="show"/>
                <field name="bf_partage_par" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="health_medication_view_bf_pour_search" model="ir.ui.view">
        <field name="name">health.medication.search.pour</field>
        <field name="model">health.medication</field>
        <field name="inherit_id" ref="health_medication_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="bf_moi" string="Moi" domain="[('dependent_id', '=', False)]"/>
                <filter name="bf_a_charge" string="Personnes à charge" domain="[('dependent_id', '!=', False)]"/>
                <filter name="bf_groupe_pour" string="Pour" context="{'group_by': 'dependent_id'}"/>
                <filter name="bf_partagees" string="Partagées avec moi" domain="[('create_uid', '!=', uid)]"/>
            </xpath>
        </field>
    </record>

    <record id="health_medication_view_bf_pour_kanban" model="ir.ui.view">
        <field name="name">health.medication.kanban.pour</field>
        <field name="model">health.medication</field>
        <field name="inherit_id" ref="health_medication_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']" position="inside">
                <div t-if="record.dependent_id.raw_value" class="small text-primary mt-1">
                    Pour : <field name="dependent_id"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="health_medication_log_view_bf_pour_form" model="ir.ui.view">
