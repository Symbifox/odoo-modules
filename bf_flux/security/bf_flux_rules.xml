<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_flux_source_societe" model="ir.rule">
        <field name="name">Flux : sources de ses sociétés</field>
        <field name="model_id" ref="model_bf_flux_source"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_flux_liste_societe" model="ir.rule">
        <field name="name">Flux : listes de ses sociétés</field>
        <field name="model_id" ref="model_bf_flux_liste"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <!-- Chacun règle ses propres préférences ; la gestion voit tout. -->
    <record id="rule_flux_preference_soi" model="ir.rule">
        <field name="name">Flux : ses propres préférences</field>
        <field name="model_id" ref="model_bf_flux_preference"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_flux_preference_gestion" model="ir.rule">
        <field name="name">Flux : toutes les préférences (gestion)</field>
        <field name="model_id" ref="model_bf_flux_preference"/>
        <field name="groups" eval="[(4, ref('bf_flux.group_flux_gestion'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <!-- Ce qu'on a lu est à soi. -->
    <record id="rule_flux_lecture_soi" model="ir.rule">
        <field name="name">Flux : ses propres lectures</field>
        <field name="model_id" ref="model_bf_flux_lecture"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
