#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Aucune séance en cours à « %s »."
msgstr "No session in progress at “%s”."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Cette pastille doit viser une séance ou le lieu d'une séance."
msgstr "This tag must point to a session or a session's venue."

#. module: bf_nfc_event
#: model:ir.model,name:bf_nfc_event.model_bf_nfc_gesture
msgid "Geste déclenché par une pastille NFC"
msgstr "Gesture triggered by an NFC tag"

#. module: bf_nfc_event
#: model:ir.model.fields,field_description:bf_nfc_event.field_bf_nfc_gesture__kind
msgid "Nature"
msgstr "Kind"

#. module: bf_nfc_event
#: model:bf.nfc.gesture,name:bf_nfc_event.gesture_event_presence
#: model:ir.model.fields.selection,name:bf_nfc_event.selection__bf_nfc_gesture__kind__event_presence
msgid "Noter ma présence à la séance"
msgstr "Record my attendance at the session"

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Plusieurs séances ont lieu ici en ce moment."
msgstr "Several sessions are taking place here right now."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Présence notée par pastille à %s, envoyée en différé."
msgstr "Attendance recorded by tag at %s, sent later."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Présence notée, et inscription créée : vous n'étiez pas inscrit."
msgstr ""
"Attendance recorded, and registration created: you were not registered."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Présence notée. Bonne séance."
msgstr "Attendance recorded. Enjoy the session."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Quelle séance ?"
msgstr "Which session?"

#. module: bf_nfc_event
#: model:bf.nfc.gesture,description:bf_nfc_event.gesture_event_presence
msgid ""
"Sur la porte de la salle (la fiche du lieu) ou sur une séance : approcher le"
" téléphone note la présence de la personne à la séance en cours, et crée son"
" inscription si elle n'en avait pas."
msgstr ""
"On the room door (the venue record) or on a session: bringing the phone "
"close records the person's attendance at the session in progress, and "
"creates their registration if they had none."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Votre présence était déjà notée."
msgstr "Your attendance was already recorded."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid ""
"« %(seance)s » a lieu le %(quand)s : la présence se note pendant la séance."
msgstr ""
"“%(seance)s” takes place on %(quand)s: attendance is recorded during the "
"session."
