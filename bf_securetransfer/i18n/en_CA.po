"                    <div t-attf-style=\"background:#{dark}; padding:18px 24px; border-radius:10px 10px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tbody><tr>\n"
"                            <td align=\"left\" style=\"vertical-align:middle;\">\n"
"                                <img t-if=\"logo_src\" t-att-src=\"logo_src\" t-att-alt=\"visuals['name']\" style=\"height:36px; display:block; border:0;\"/>\n"
"                                <span t-else=\"\" style=\"color:#ffffff; font-size:18px; font-weight:700;\" t-out=\"visuals['name']\"/>\n"
"                            </td>\n"
"                            <td align=\"right\" style=\"vertical-align:middle; color:#ffffff; font-family:Lexend,system-ui,Arial,sans-serif; font-size:20px; font-weight:700;\">Fichiers partagés</td>\n"
"                        </tr></tbody></table>\n"
"                    </div>\n"
"                    <div t-attf-style=\"height:4px; background:#{primary};\"/>\n"
"                    <div style=\"background:#ffffff; border:1px solid #e3e7eb; border-top:0; padding:24px; border-radius:0 0 10px 10px;\">\n"
"                        <p>Bonjour,</p>\n"
"                        <div style=\"background:#f4f6f8; border:1px solid #e3e7eb; border-radius:8px; padding:12px 16px; margin:0 0 16px;\">\n"
"                            De la part de :\n"
"                            <strong t-out=\"object.sender_name or object.sender_email\"/>\n"
"                            <t t-if=\"object.sender_name\"> &lt;<t t-out=\"object.sender_email\"/>&gt;</t>\n"
"                        </div>\n"
"                        <p t-if=\"object.message\" style=\"white-space:pre-line; border-left:3px solid #e3e7eb; padding-left:12px; color:#555;\" t-out=\"object.message\"/>\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse; margin:12px 0;\">\n"
"                            <tbody>\n"
"                                <tr t-foreach=\"object.file_ids.filtered(lambda f: f.state == 'verified')\" t-as=\"f\">\n"
"                                    <td style=\"padding:6px 0; border-bottom:1px solid #eef1f4;\" t-out=\"f.filename\"/>\n"
"                                    <td align=\"right\" style=\"padding:6px 0; border-bottom:1px solid #eef1f4; color:#777; white-space:nowrap;\" t-out=\"f.size &gt;= 1073741824 and '%.2f Go' % (f.size / 1073741824.0) or f.size &gt;= 1048576 and '%.1f Mo' % (f.size / 1048576.0) or f.size &gt;= 1024 and '%.0f Ko' % (f.size / 1024.0) or '%d o' % f.size\"/>\n"
"                                </tr>\n"
"                            </tbody>\n"
"                        </table>\n"
"                        <p style=\"margin:24px 0;\">\n"
"                            <a t-att-href=\"share\" t-attf-style=\"background:#{primary}; color:#ffffff; text-decoration:none; padding:12px 26px; border-radius:8px; font-weight:600; display:inline-block;\">\n"
"                                Télécharger les fichiers</a>\n"
"                        </p>\n"
"                        <p t-if=\"object.has_password\" style=\"background:#fff8e6; border:1px solid #f2e3b3; border-radius:8px; padding:10px 14px;\">\n"
"                            Ce transfert est <strong>protégé par un mot de passe</strong>.\n"
"                            L'expéditeur vous le communiquera séparément (il ne figure jamais dans ce courriel).\n"
"                        </p>\n"
"                        <p>Ce lien expirera le <strong t-out=\"format_date(object.expiry_date, lang_code=object.locale)\"/>,\n"
"                            après quoi les fichiers seront supprimés définitivement.</p>\n"
"                        <p style=\"color:#777; font-size:12px;\">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br/>\n"
"                            <a t-att-href=\"share\" t-out=\"share\"/></p>\n"
"                        <p style=\"color:#777; font-size:12px;\">Vous ne connaissez pas cet expéditeur ? N'ouvrez pas les fichiers et supprimez ce courriel.</p>\n"
"                    </div>\n"
"                    <div style=\"text-align:center; color:#9aa4ad; font-size:12px; padding:14px;\">\n"
"                        <t t-if=\"visuals['powered_by']\">Propulsé par <t t-out=\"visuals['powered_by_name']\"/></t>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""

