<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Document Type Tree View -->
    <record id="view_document_type_tree" model="ir.ui.view">
        <field name="name">project.document.type.tree</field>
        <field name="model">project.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="is_internal" widget="boolean_toggle"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Document Type Form View -->
    <record id="view_document_type_form" model="ir.ui.view">
        <field name="name">project.document.type.form</field>
        <field name="model">project.document.type</field>
        <field name="arch" type="xml">
            <form string="Type de document">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Interne" bg_color="text-bg-info" invisible="not is_internal"/>
                    <div class="oe_title">
                        <label for="name" string="Nom du type"/>
                        <h1>
                            <field name="name" placeholder="ex: Manuel d'utilisation"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="is_internal"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="icon" placeholder="fa-file"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description de ce type de document..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Document Type Search View -->
    <record id="view_document_type_search" model="ir.ui.view">
        <field name="name">project.document.type.search</field>
        <field name="model">project.document.type</field>
        <field name="arch" type="xml">
            <search string="Rechercher les types">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="filter_internal" string="Documents internes" domain="[('is_internal', '=', True)]"/>
                <filter name="filter_external" string="Documents clients" domain="[('is_internal', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Document Type Action -->
    <record id="document_type_action" model="ir.actions.act_window">
        <field name="name">Types de documents</field>
        <field name="res_model">project.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_document_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un type de document
            </p>
            <p>
                Les types de documents permettent de catégoriser vos documents (ex: Manuel, Politique, Contrat).
            </p>
        </field>
    </record>

</odoo>
