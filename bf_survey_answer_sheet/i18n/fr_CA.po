#. module: bf_survey_answer_sheet
#. odoo-python
#: code:addons/bf_survey_answer_sheet/models/survey_user_input.py:0
msgid "\"%(declared)s\" is the name of the folder template itself: a sheet is not filed there."
msgstr "« %(declared)s » est le nom du gabarit de dossier lui-même : une feuille ne s'y classe pas."

#. module: bf_survey_answer_sheet
#. odoo-python
#: code:addons/bf_survey_answer_sheet/models/survey_user_input.py:0
msgid "\"%(declared)s\" matches several folders under %(root)s: %(folders)s. Filed nowhere until one of them is named on the response."
msgstr "« %(declared)s » correspond à plusieurs dossiers sous %(root)s : %(folders)s. Rien n'est classé tant que l'un d'eux n'est pas nommé sur la réponse."

#. module: bf_survey_answer_sheet
#. odoo-python
#: code:addons/bf_survey_answer_sheet/models/survey_user_input.py:0
msgid "\"%s\" does not file answer sheets."
msgstr "« %s » ne classe pas de feuilles de réponses."

#. module: bf_survey_answer_sheet
#. odoo-python
#: code:addons/bf_survey_answer_sheet/models/nextcloud_document_config.py:0
msgid "%(path)s and the %(count)s names beside it are all taken by other answer sheets."
msgstr "%(path)s et les %(count)s noms à côté sont tous pris par d'autres feuilles de réponses."

#. module: bf_survey_answer_sheet
#. odoo-python
#: code:addons/bf_survey_answer_sheet/models/nextcloud_document_config.py:0
msgid "%(path)s holds more entries than a listing can carry (%(max)s): the folder of a company could be missed."
msgstr "%(path)s porte plus d'entrées qu'un relevé n'en transporte (%(max)s) : le dossier d'une entreprise pourrait être manqué."

#. module: bf_survey_answer_sheet
#. odoo-python
#: code:addons/bf_survey_answer_sheet/models/nextcloud_document_config.py:0
msgid "%s changed on Nextcloud since this response wrote it: nothing was overwritten."
msgstr "%s a changé sur Nextcloud depuis que cette réponse l'a écrit : rien n'a été écrasé."

#. module: bf_survey_answer_sheet
#. odoo-python
#: code:addons/bf_survey_answer_sheet/models/nextcloud_document_config.py:0
msgid "%s is not the file this deposit expected."
msgstr "%s n'est pas le fichier que ce dépôt attendait."

