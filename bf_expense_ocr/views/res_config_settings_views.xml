<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.lecture-recus</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[field[@name='expense_tip_account_id']]" position="after">
                <setting company_dependent="1" string="Read receipts on upload"
                         help="Off, the receipt is read only on request. On, every attached photo goes to the provider configured in the LLM gateway.">
                    <field name="expense_ocr_auto"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
