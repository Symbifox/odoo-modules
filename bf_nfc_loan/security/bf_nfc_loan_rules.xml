<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ⚠️ Tout interne voit qui a quel équipement : c'est la question à laquelle
         le module répond. Seules les sociétés sont cloisonnées. -->
    <record id="regle_equipement_societe" model="ir.rule">
        <field name="name">Équipements : cloison des sociétés</field>
        <field name="model_id" ref="model_bf_nfc_equipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
