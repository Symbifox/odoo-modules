<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.cx.appointment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_cx.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='bf_cx_loop_block']" position="inside">
                <setting string="Feedback after an appointment"
                         help="When an appointment is over, ask the appointment's contact for 3-emoji feedback (once per appointment, over-solicitation guard applied).">
                    <field name="bf_cx_appointment_feedback"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
