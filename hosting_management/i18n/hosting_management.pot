"                                      </td>\n"
"                                    </tr>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                            <!-- Dur&#233;e estim&#233;e -->\n"
"                            <tr>\n"
"                              <td style=\"padding:12px 20px 0 20px;\">\n"
"                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                  <tbody>\n"
"                                    <tr>\n"
"                                      <td width=\"140\" style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.5px;vertical-align:top;padding-top:2px;\">\n"
"                                        Estimated duration\n"
"                                      </td>\n"
"                                      <td t-attf-style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};\">\n"
"                                        <t t-out=\"ctx.get('maintenance_duration', 'To be determined')\"/>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                            <!-- Services affect&#233;s -->\n"
"                            <tr>\n"
"                              <td style=\"padding:12px 20px 0 20px;\">\n"
"                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                  <tbody>\n"
"                                    <tr>\n"
"                                      <td width=\"140\" style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.5px;vertical-align:top;padding-top:2px;\">\n"
"                                        Affected services\n"
"                                      </td>\n"
"                                      <td t-attf-style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};\">\n"
"                                        <t t-out=\"ctx.get('affected_services', 'All services')\"/>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                            <!-- Impact attendu -->\n"
"                            <tr>\n"
"                              <td style=\"padding:12px 20px 20px 20px;\">\n"
"                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                  <tbody>\n"
"                                    <tr>\n"
"                                      <td width=\"140\" style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.5px;vertical-align:top;padding-top:2px;\">\n"
"                                        Expected impact\n"
"                                      </td>\n"
"                                      <td t-attf-style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};\">\n"
"                                        <t t-out=\"ctx.get('expected_impact', 'Possible temporary interruption')\"/>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Message additionnel via ctx -->\n"
"                        <t t-if=\"ctx.get('message_body')\">\n"
"                          <t t-out=\"ctx.get('message_body')\"/>\n"
"                        </t>\n"
"\n"
"                        <p style=\"margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;\">\n"
