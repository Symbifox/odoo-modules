<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_claude" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.claude</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Gen" string="Gen"
                     name="bf_claude_chat"
                     groups="base.group_system">
                    <block title="General">
                        <setting string="Gen Assistant"
                                 help="Enable the Gen chatbot for all users.">
                            <field name="claude_enabled"/>
                        </setting>
                        <setting string="Live streaming"
                                 help="Stream answers token by token with tool and thinking activity (console-like). When off, replies are buffered.">
                            <field name="claude_streaming"/>
                        </setting>
                        <setting string="Proactive brief"
                                 help="When you open the panel on a record you have not discussed yet, Claude opens with a situation report and next actions instead of waiting for a question.">
                            <field name="claude_auto_brief"/>
                        </setting>
                        <setting string="Model"
                                 help="Choose the Claude model to use for responses.">
                            <field name="claude_model"/>
                        </setting>
                        <setting string="Max Turns"
                                 help="Maximum tool-use cycles per message (e.g. 45).">
                            <field name="claude_max_turns"/>
                        </setting>
                        <setting string="Response Timeout"
                                 help="Maximum seconds to wait for a response.">
                            <field name="claude_timeout"/>
                        </setting>
                    </block>
                    <block title="Personality">
                        <setting id="bf_claude_chat_personality" string="Gen's personality"
                                 help="How Gen speaks here: the name it goes by, tu or vous, default language, length, how it presents itself. Tone only: what Gen may do is set on the bridge, not in this box.">
                            <div class="content-group mt16">
                                <field name="claude_personality" widget="text" class="w-100" nolabel="1"
                                       placeholder="Tu t'appelles Gen. Tu tutoies. Tu réponds en français, court et concret : la réponse d'abord, sans superlatifs. Quand un outil échoue ou qu'une chose n'est pas branchée, tu le dis franchement."/>
                            </div>
                        </setting>
                    </block>
                    <block title="Authentication">
                        <setting string="API Key (optional)"
                                 help="Leave empty to use the server's Max plan. Set an Anthropic API key to bill this tenant independently.">
                            <field name="claude_api_key" password="True"/>
                        </setting>
                    </block>
                    <block title="Advanced">
                        <setting string="Tenant"
                                 help="Tenant slug sent to the bridge (e.g. 'bf' or 'pme'). Controls which MCP tools and system prompt are used.">
                            <field name="claude_tenant"/>
                        </setting>
                        <setting string="Bridge Socket"
                                 help="Unix socket path for the bridge service.">
                            <field name="claude_bridge_socket"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
