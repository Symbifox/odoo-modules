<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_nfc_reading_list" model="ir.ui.view">
        <field name="name">bf.nfc.reading.list</field>
        <field name="model">bf.nfc.reading</field>
        <field name="arch" type="xml">
            <list string="Relevés" create="false" decoration-danger="state == 'anomalie'"
                  decoration-muted="state == 'corrige'">
                <field name="tapped_at"/>
                <field name="name" optional="show"/>
                <field name="checklist_id"/>
                <field name="tag_name"/>
                <field name="place" optional="show"/>
                <field name="verifier"/>
                <field name="state" widget="badge" decoration-success="state == 'conforme'"
                       decoration-danger="state == 'anomalie'" decoration-info="state == 'corrige'"/>
                <field name="anomaly_count" optional="show"/>
                <field name="correction_date" optional="show"/>
                <field name="offline" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bf_nfc_reading_form" model="ir.ui.view">
        <field name="name">bf.nfc.reading.form</field>
        <field name="model">bf.nfc.reading</field>
        <field name="arch" type="xml">
            <form string="Relevé" create="false">
                <header>
                    <button name="action_consigner_correction" type="object" string="Consigner la correction"
                            class="btn-primary" invisible="state != 'anomalie'"
                            groups="bf_nfc.group_nfc_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="conforme,anomalie,corrige"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2 class="text-muted"><field name="checklist_id" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Où et quand">
                            <field name="tag_name"/>
                            <field name="place"/>
                            <field name="tapped_at"/>
                            <field name="offline"/>
                            <field name="tag_id"/>
                        </group>
                        <group string="Qui">
                            <field name="verifier"/>
                            <div colspan="2" class="text-muted" invisible="door != 'signed'">
                                Nom déclaré par la personne qui a tapé une pastille signée :
                                l'identité n'est pas prouvée par un compte.
                            </div>
                            <field name="user_id" invisible="signed_name"/>
                            <field name="signed_name" invisible="not signed_name"/>
                            <field name="door"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list decoration-danger="anomaly">
                            <field name="name"/>
                            <field name="kind" column_invisible="1"/>
                            <field name="answered" column_invisible="1"/>
                            <field name="value_bool" invisible="kind != 'conforme' or not answered" widget="boolean"/>
                            <field name="value_float" invisible="kind != 'nombre' or not answered"/>
                            <field name="unit" invisible="kind != 'nombre'"/>
                            <field name="value_text" invisible="kind not in ('texte', 'choix')"/>
                            <field name="range_text" optional="hide"/>
                            <field name="anomaly"/>
                        </list>
                    </field>
                    <group string="Correction" invisible="state == 'conforme'">
                        <field name="correction" readonly="state != 'anomalie'"
                               placeholder="Ce qui a été fait : pièce remplacée, entreprise appelée, date de l'intervention."/>
                        <field name="correction_date" readonly="state != 'anomalie'"/>
                        <field name="corrected_by_id" invisible="not corrected_by_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bf_nfc_reading_search" model="ir.ui.view">
        <field name="name">bf.nfc.reading.search</field>
        <field name="model">bf.nfc.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="tag_name"/>
                <field name="place"/>
                <field name="checklist_id"/>
                <field name="verifier"/>
                <field name="tag_id"/>
                <filter name="anomalies_ouvertes" string="Anomalies à corriger" domain="[('state', '=', 'anomalie')]"/>
                <filter name="corrigees" string="Anomalies corrigées" domain="[('state', '=', 'corrige')]"/>
                <separator/>
                <filter name="tapped_at" string="Date du relevé" date="tapped_at"/>
                <group expand="0" string="Regrouper par">
                    <filter name="par_grille" string="Grille" context="{'group_by': 'checklist_id'}"/>
                    <filter name="par_element" string="Élément vérifié" context="{'group_by': 'tag_name'}"/>
                    <filter name="par_endroit" string="Endroit" context="{'group_by': 'place'}"/>
                    <filter name="par_mois" string="Mois" context="{'group_by': 'tapped_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_nfc_reading" model="ir.actions.act_window">
        <field name="name">Relevés</field>
        <field name="res_model">bf.nfc.reading</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun relevé</p>
            <p>Un relevé naît d'un tapotement sur une pastille « Faire un relevé ». Le registre
            s'imprime depuis cette liste : sélectionnez les relevés, puis Imprimer.</p>
        </field>
    </record>

    <menuitem id="menu_nfc_readings" name="Relevés" parent="bf_nfc.menu_nfc_root"
              action="action_bf_nfc_reading" sequence="45"/>
</odoo>
