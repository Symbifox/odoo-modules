<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          Repointe les liens provisionnés quand leur source bouge : une page
          de rendez-vous renommée change de slug, une page de dépôt apparaît
          le jour où quelqu'un arrive. Ne touche jamais un lien saisi à la
          main. Inactif par défaut — provisionner des liens dans les
          signatures de tout le monde est une décision, pas un défaut.
        -->
        <record id="ir_cron_signature_link_provision" model="ir.cron">
            <field name="name">Signatures : provisionner et repointer les liens rapides</field>
            <field name="model_id" ref="model_bf_signature_link"/>
            <field name="state">code</field>
            <field name="code">model._cron_provision()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
