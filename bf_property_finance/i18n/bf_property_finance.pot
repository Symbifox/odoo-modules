"ancienne à la plus récente, et proportionnellement entre celles échues le "
"même jour. Art. 1570 : à l'intérieur d'une contribution, les intérêts avant "
"le capital."
msgstr ""

#. module: bf_property_finance
#: model:ir.model.fields,help:bf_property_finance.field_bf_property_organisation__late_interest_basis
