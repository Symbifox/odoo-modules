<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action -->
    <record id="sms_device_action" model="ir.actions.act_window">
        <field name="name">Android devices</field>
        <field name="res_model">sms.archive.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No device registered
            </p>
            <p>
                Register an Android device to allow the
                <em>bf-sms-relay</em> app to push SMS, MMS and calls live.
                An API token is generated automatically; set it in the app
                with the URL <code>/bf_sms_archive/api/ingest</code>.
            </p>
        </field>
    </record>

    <!-- List view -->
    <record id="sms_device_view_list" model="ir.ui.view">
        <field name="name">sms.archive.device.list</field>
        <field name="model">sms.archive.device</field>
        <field name="arch" type="xml">
            <list string="Devices">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="last_sync_at"/>
                <field name="last_sync_count"/>
                <field name="total_received"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="sms_device_view_form" model="ir.ui.view">
        <field name="name">sms.archive.device.form</field>
        <field name="model">sms.archive.device</field>
        <field name="arch" type="xml">
            <form string="Android device">
                <header>
                    <button name="action_regenerate_token"
                            type="object"
                            string="Regenerate the API token"
                            confirm="Regenerating the token will immediately invalidate the app's configuration on this device. Continue?"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="Inactive"
                            bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Pixel 8"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="owner_id" options="{'no_create': True}"/>
                            <field name="api_token" widget="CopyClipboardChar"/>
                            <field name="active"/>
                        </group>
                        <group string="Synchronization">
                            <field name="last_sync_at"/>
                            <field name="last_sync_count"/>
                            <field name="total_received"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Model, Android version, specifics..."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Endpoint:</strong>
                        <code>POST &lt;base_url&gt;/bf_sms_archive/api/ingest</code><br/>
                        <strong>Auth:</strong>
                        <code>Authorization: Bearer &lt;api_token&gt;</code><br/>
                        The <em>bf-sms-relay</em> app expects these two values in
                        its preferences.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu -->
    <menuitem
        id="sms_archive_menu_configuration"
        name="Configuration"
        parent="sms_archive_menu_root"
        sequence="80"/>

    <menuitem
        id="sms_archive_menu_devices"
        name="Android devices"
        parent="sms_archive_menu_configuration"
        action="sms_device_action"
        sequence="10"
        groups="bf_sms_archive.group_sms_manager"/>

</odoo>
