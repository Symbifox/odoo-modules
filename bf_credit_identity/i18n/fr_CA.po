#. module: bf_credit_identity
#: model_terms:ir.ui.view,arch_db:bf_credit_identity.credit_guide_content
msgid ""
"Phishing: do not open unexpected links or attachments; confirm an urgent "
"request through another channel, with contact details you already have; "
"report text-message phishing to 7726 (Get Cyber Safe, AMF)."
msgstr ""
"Hameçonnage : n'ouvrez pas un lien ou une pièce jointe inattendus ; "
"confirmez une demande urgente par une autre voie, avec des coordonnées que "
"vous avez déjà ; signalez un texto d'hameçonnage au 7726 (Pensez "
"cybersécurité, AMF)."

#. module: bf_credit_identity
#: model:ir.model.fields.selection,name:bf_credit_identity.selection__bf_credit_reminder__due_state__planned
