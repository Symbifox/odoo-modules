#: model_terms:ir.actions.act_window,help:bf_property_parcel_tracking.action_property_parcel_expected
msgid ""
"Les colis que vos résidents attendent, avec ce que le transporteur\n"
"               en dit. Le bouton « Arrivé » consigne celui qui est déjà au comptoir."
msgstr ""
"The parcels your residents are waiting for, with what the carrier\n        "
"says about them. The \"Arrived\" button records the one already on the "
"counter."

#. module: bf_property_parcel_tracking
#: model_terms:ir.ui.view,arch_db:bf_property_parcel_tracking.portal_property_deliveries_tracking
msgid "Les colis que vous attendez"
msgstr "The parcels you are waiting for"

#. module: bf_property_parcel_tracking
