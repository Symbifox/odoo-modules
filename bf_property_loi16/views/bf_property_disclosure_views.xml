<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_disclosure_list" model="ir.ui.view">
        <field name="name">bf.property.disclosure.list</field>
        <field name="model">bf.property.disclosure</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-warning="state == 'provided'"
                  decoration-success="state == 'complete'">
                <field name="name"/>
                <field name="syndicat_id" optional="hide"/>
                <field name="unit_id"/>
                <field name="requester_partner_id"/>
                <field name="request_date"/>
                <field name="days_open"/>
                <field name="provided_date" optional="show"/>
                <field name="owner_transmission_date" optional="show"/>
                <field name="cost_amount" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_disclosure_form" model="ir.ui.view">
        <field name="name">bf.property.disclosure.form</field>
        <field name="model">bf.property.disclosure</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_provide" type="object"
                            string="Fournir au promettant acheteur" class="btn-primary"
                            invisible="provided_date or cancelled"/>
                    <button name="action_transmit_to_owner" type="object"
                            string="Transmettre au propriétaire" class="btn-primary"
                            invisible="not provided_date or owner_transmission_date or cancelled"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="cancelled"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,provided,complete"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'provided'">
                        Art. 1068.2 al. 2 C.c.Q. : le syndicat doit transmettre au
                        propriétaire de la fraction, ou à ses ayants cause, les documents
                        ou renseignements qu'il a fournis au promettant acheteur.
                        L'obligation naît de la remise et porte sur son contenu exact.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="provided_date or cancelled">
                        Le syndicat fournit « avec diligence », aux frais du promettant
                        acheteur. Le texte ne pose aucun nombre de jours, et le module
                        n'en invente pas : le compteur informe, il ne déclare aucun
                        retard.
                    </div>

                    <group>
                        <group string="Demande">
                            <field name="syndicat_id"/>
                            <field name="unit_id"/>
                            <field name="requester_partner_id"/>
                            <field name="owner_partner_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cancelled" invisible="1"/>
                        </group>
                        <group string="Suivi">
                            <field name="request_date"/>
                            <field name="days_open"/>
                            <field name="provided_date"/>
                            <field name="owner_transmission_date"/>
                            <field name="cost_amount"/>
                            <field name="cost_paid"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Documents fournis" name="lines">
                            <field name="line_ids" readonly="provided_date != False">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="redacted"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vie privée" name="privacy">
                            <group>
                                <field name="privacy_reviewed"/>
                            </group>
                            <field name="privacy_note"
                                   placeholder="Ce qui a été retranché ou caviardé, et pourquoi."/>
                            <div class="text-muted mt-2">
                                Art. 1068.2 : le syndicat fournit « sous réserve des
                                dispositions relatives à la protection de la vie privée ».
                                L'article autorise la communication au sens de l'art. 37
                                C.c.Q., mais cette autorisation ne couvre pas les
                                renseignements personnels des autres copropriétaires. Le
                                registre de l'art. 1070 en contient, et l'état des impayés
                                en est.
                            </div>
                        </page>
                        <page string="Refus" name="refusal"
                              invisible="not refusal_reason and provided_date">
                            <field name="refusal_reason" nolabel="1"
                                   placeholder="Un refus total se motive. La réserve de vie privée justifie de retrancher des renseignements, rarement de tout refuser."/>
                        </page>
                    </notebook>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_disclosure_search" model="ir.ui.view">
        <field name="name">bf.property.disclosure.search</field>
        <field name="model">bf.property.disclosure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="requester_partner_id"/>
                <filter name="open" string="À fournir"
                        domain="[('state', '=', 'requested')]"/>
                <filter name="to_transmit" string="À transmettre au propriétaire"
                        domain="[('state', '=', 'provided')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_syndicat" string="Syndicat"
                            context="{'group_by': 'syndicat_id'}"/>
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_disclosure" model="ir.actions.act_window">
        <field name="name">Documents au promettant acheteur</field>
        <field name="res_model">bf.property.disclosure</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrer une demande</p>
            <p>
                Art. 1068.2 C.c.Q. Troisième des régimes de documents à l'acquéreur.
                Demandé par le promettant acheteur, à ses frais, fourni « avec
                diligence » et sous réserve de la protection de la vie privée. Ce qui a
                été fourni doit ensuite être transmis au propriétaire de la fraction.
            </p>
            <p>
                L'attestation de l'art. 1068.1 se demande par le copropriétaire vendeur ;
                l'état des charges de l'art. 1069 al. 2, par le proposant acquéreur, avec
                préavis au propriétaire AVANT la remise.
            </p>
        </field>
    </record>

</odoo>
