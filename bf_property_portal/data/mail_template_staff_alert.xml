<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- L'alerte du bureau quand un résident dépose au portail : le courriel EN
         PLUS de la boîte Odoo, selon la préférence de chacun. Rendue dans la mise
         en page de marque, comme les autres courriels de la société. Le sujet et le corps viennent du dépôt. -->
    <record id="mail_template_staff_alert" model="mail.template">
        <field name="name">Immeubles : alerte du bureau (dépôt au portail)</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="subject">{{ ctx.get('bf_subject') }}</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.email_formatted }}</field>
        <field name="lang">{{ object.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<t t-set="company" t-value="object.company_id or user.company_id"/>
<t t-set="brand_primary" t-value="(company and 'report_brand_primary' in company._fields and company.report_brand_primary) or '#714B67'"/>
<div style="margin:0;padding:0;">
    <p style="margin:0 0 16px 0;font-size:15px;"><t t-out="ctx.get('bf_body') or ''"/></p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0;">
        <tbody>
            <tr>
                <td t-attf-style="border-radius:10px;background-color:{{ brand_primary }};text-align:center;">
                    <a t-att-href="ctx.get('bf_link')" style="display:inline-block;padding:12px 24px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none !important;">Ouvrir dans Odoo</a>
                </td>
            </tr>
        </tbody>
    </table>
    <p style="margin:0;font-size:13px;color:#6B7280;">Vous recevez ce courriel parce que vos préférences demandent les dépôts du portail par courriel. Elles se règlent dans Mes préférences.</p>
</div>
        </field>
    </record>
</odoo>
