msgstr "Usager portail"

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/account.py:0
msgid "Portal user archived."
msgstr "Usager portail archivé."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/account.py:0
msgid "Portal user brought back in line with the account."
msgstr "Usager portail remis en accord avec le compte."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/account.py:0
