<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_child_list" model="ir.ui.view">
        <field name="name">bf.household.child.list</field>
        <field name="model">bf.household.child</field>
        <field name="arch" type="xml">
            <list string="Children">
                <field name="name"/>
                <field name="birthday_label"/>
                <field name="age_band"/>
                <field name="primary_parent_id"/>
                <field name="second_parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_child_form" model="ir.ui.view">
        <field name="name">bf.household.child.form</field>
        <field name="model">bf.household.child</field>
        <field name="arch" type="xml">
            <form string="Child">
                <field name="is_parent" invisible="1"/>
                <field name="is_primary_parent" invisible="1"/>
                <header>
                    <button name="action_swap_parents" type="object" string="Swap parents"
                            invisible="not is_primary_parent or not second_parent_id"
                            confirm="The second parent will hold the child's records, and you become the second parent. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="id and not is_parent" placeholder="First name"/></h1>
                    </div>
                    <group>
                        <group string="Birth">
                            <field name="birth_year" options="{'enable_formatting': false}" readonly="id and not is_parent"/>
                            <field name="birth_month" readonly="id and not is_parent"/>
                            <field name="birth_day" readonly="id and not is_parent"/>
                            <field name="age_band"/>
                        </group>
                        <group string="Parents">
                            <field name="primary_parent_id" readonly="1"/>
                            <field name="second_parent_id" readonly="id and not is_parent"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="user_id" readonly="id and not is_parent"
                                   options="{'no_create': True, 'no_open': True}"
                                   invisible="age_band == 'child'"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The whole household sees the first name and the birthday. The child's health and papers stay with the parents.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_child" model="ir.actions.act_window">
        <field name="name">Children</field>
        <field name="res_model">bf.household.child</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a child of the household.</p>
            <p>You become their parent, and you can name a second parent. The household sees the first name and the birthday.</p>
        </field>
    </record>
</odoo>
