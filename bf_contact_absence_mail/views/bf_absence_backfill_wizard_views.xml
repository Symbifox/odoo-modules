<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_absence_backfill_wizard_form" model="ir.ui.view">
        <field name="name">bf.absence.backfill.wizard.form</field>
        <field name="model">bf.absence.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Read mail already received">
                <div class="alert alert-info" role="status">
                    The mail already received holds out-of-office replies nobody has read yet. This pass picks them up once and proposes the periods; it never records an absence on its own.
                </div>
                <group>
                    <field name="days"/>
                    <field name="limit"/>
                    <field name="pending" readonly="1"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Read"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bf_absence_backfill_wizard" model="ir.actions.act_window">
        <field name="name">Read mail already received</field>
        <field name="res_model">bf.absence.backfill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
