<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The "Progression" app root (bf_stepbystep_clients) becomes a two-tab
         app. Adding children means the web client lands on the first child, so
         we re-declare the existing dashboard at sequence 1 to keep it default,
         and add the Gantt beside it. -->
    <menuitem id="bf_progression_dashboard_menu"
              name="Tableau de bord"
              parent="bf_stepbystep_clients.bf_stepbystep_clients_menu_root"
              action="bf_stepbystep_clients.bf_stepbystep_clients_action"
              sequence="1"/>

    <menuitem id="bf_progression_gantt_menu_progression"
              name="Échéancier (Gantt)"
              parent="bf_stepbystep_clients.bf_stepbystep_clients_menu_root"
              action="bf_progression_gantt_action"
              sequence="10"/>

    <!-- Also reachable from the standard Project app. -->
    <menuitem id="bf_progression_gantt_menu_project"
              name="Échéancier (Gantt)"
              parent="project.menu_main_pm"
              action="bf_progression_gantt_action"
              sequence="50"/>
</odoo>
