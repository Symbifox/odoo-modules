#: model_terms:ir.ui.view,arch_db:bf_retail.bf_retail_cost_view_form
msgid "Against the previous cost"
msgstr "Contre le coût précédent"

#. module: bf_retail
#: model:ir.model.fields,field_description:bf_retail.field_bf_retail_price_change__follow_down
msgid "Also propose decreases"
msgstr "Proposer aussi les baisses"

#. module: bf_retail
#: model:ir.model.fields.selection,name:bf_retail.selection__bf_retail_price_change__state__applied
#: model_terms:ir.ui.view,arch_db:bf_retail.bf_retail_price_change_view_search
