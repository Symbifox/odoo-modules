<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Import Wizard Form -->
    <record id="sms_import_wizard_view_form" model="ir.ui.view">
        <field name="name">sms.archive.import.wizard.form</field>
        <field name="model">sms.archive.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import" string="Importer"
                            type="object" class="btn-primary"/>
                    <button name="action_disk_import_now"
                            string="Importer depuis /mnt/sms-inbox"
                            type="object" class="btn-secondary"
                            help="Traite immédiatement les XML déposés dans sms-inbox sur le serveur (aucune limite de taille)."/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="file_data" filename="file_name"
                                   string="Fichier de sauvegarde SMS (XML ou ZIP)"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Fichiers volumineux (+1 Go)</strong> : déposez-les via
                        <code>scp</code> dans le bind mount <code>sms-inbox/</code>
                        du compose (monté sur <code>/mnt/sms-inbox</code> côté
                        container), puis cliquez sur « Importer depuis /mnt/sms-inbox ».
                        L'import disque contourne la limite HTTP/mémoire du formulaire.
                    </div>
                    <group invisible="not result_message">
                        <field name="result_message" string="Résultat" readonly="1"
                               widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Import Wizard Action -->
    <record id="sms_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Importer des SMS</field>
        <field name="res_model">sms.archive.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
