<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_attachment_version_list" model="ir.ui.view">
        <field name="name">bf.attachment.version.list</field>
        <field name="model">bf.attachment.version</field>
        <field name="arch" type="xml">
            <list string="Versions conservées" create="false" edit="false">
                <field name="create_date" string="Remplacée le"/>
                <field name="attachment_id"/>
                <field name="numero"/>
                <field name="name"/>
                <field name="res_model" optional="show"/>
                <field name="origine"/>
                <field name="file_size" sum="Total"/>
                <field name="create_uid" string="Remplacée par"/>
                <button name="action_telecharger" type="object" icon="fa-download"
                        title="Télécharger cette version"/>
                <button name="action_restaurer" type="object" icon="fa-undo"
                        title="Remettre ce contenu dans la pièce jointe"
                        confirm="Le contenu actuel sera remplacé par celui-ci. Il sera lui-même conservé comme une nouvelle version."/>
            </list>
        </field>
    </record>

    <record id="view_bf_attachment_version_form" model="ir.ui.view">
        <field name="name">bf.attachment.version.form</field>
        <field name="model">bf.attachment.version</field>
        <field name="arch" type="xml">
            <form string="Version conservée" create="false" edit="false">
                <header>
                    <button name="action_telecharger" type="object" string="Télécharger"
                            class="btn-primary"/>
                    <button name="action_restaurer" type="object" string="Restaurer"
                            confirm="Le contenu actuel sera remplacé par celui-ci. Il sera lui-même conservé comme une nouvelle version."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>Version <field name="numero" readonly="1" class="oe_inline"/></h3>
                    </div>
                    <group>
                        <group string="Pièce jointe">
                            <field name="attachment_id" readonly="1"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                        </group>
                        <group string="Ce qui a été conservé">
                            <field name="mimetype" readonly="1"/>
                            <field name="file_size" readonly="1"/>
                            <field name="checksum" readonly="1"/>
                            <field name="content_id" readonly="1"/>
                        </group>
                        <group string="Remplacement">
                            <field name="create_date" string="Date" readonly="1"/>
                            <field name="create_uid" string="Par" readonly="1"/>
                            <field name="origine" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bf_attachment_version_search" model="ir.ui.view">
        <field name="name">bf.attachment.version.search</field>
        <field name="model">bf.attachment.version</field>
        <field name="arch" type="xml">
            <search string="Versions conservées">
                <field name="name"/>
                <field name="attachment_id"/>
                <field name="res_model"/>
                <field name="checksum"/>
                <filter name="filtre_onlyoffice" string="Éditeur ONLYOFFICE"
                        domain="[('origine', '=', 'onlyoffice')]"/>
                <filter name="filtre_collabora" string="Éditeur Collabora"
                        domain="[('origine', '=', 'collabora')]"/>
                <separator/>
                <filter name="filtre_semaine" string="Sept derniers jours"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="groupe_piece" string="Pièce jointe"
                            context="{'group_by': 'attachment_id'}"/>
                    <filter name="groupe_modele" string="Modèle lié"
                            context="{'group_by': 'res_model'}"/>
                    <filter name="groupe_origine" string="Origine"
                            context="{'group_by': 'origine'}"/>
                    <filter name="groupe_date" string="Date de remplacement"
                            context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_attachment_version" model="ir.actions.act_window">
        <field name="name">Versions de pièces jointes</field>
        <field name="res_model">bf.attachment.version</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bf_attachment_version_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune version conservée pour l'instant.</p>
            <p>Une version apparaît ici dès qu'une pièce jointe voit son contenu
               remplacé, par un éditeur bureautique ou autrement. Elle porte les
               octets d'avant le remplacement.</p>
        </field>
    </record>

    <menuitem id="menu_bf_attachment_version"
              name="Versions de pièces jointes"
              parent="base.next_id_9"
              action="action_bf_attachment_version"
              sequence="21"/>
</odoo>
