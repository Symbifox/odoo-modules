<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pulse_campaign_list" model="ir.ui.view">
        <field name="name">bf.ex.pulse.campaign.list</field>
        <field name="model">bf.ex.pulse.campaign</field>
        <field name="arch" type="xml">
            <list string="Pulse waves">
                <field name="name"/>
                <field name="date_open"/>
                <field name="date_close"/>
                <field name="invitation_count"/>
                <field name="response_count"/>
                <!-- ⚠️ `response_rate` vaut déjà 0 à 100 : jamais `widget="percentage"`,
                     qui multiplie par cent. -->
                <field name="response_rate" digits="[16,0]"/>
                <field name="pending_flush_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_pulse_campaign_form" model="ir.ui.view">
        <field name="name">bf.ex.pulse.campaign.form</field>
        <field name="model">bf.ex.pulse.campaign</field>
        <field name="arch" type="xml">
            <form string="Pulse wave">
                <header>
                    <button name="action_open" type="object" string="Open the wave"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_invitations" type="object"
                            string="Send the links" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_close" type="object" string="Close the wave"
                            invisible="state != 'open'"
                            confirm="Closing the wave flushes to the register everything still in the staging area, even if the threshold is not reached. Scores below the threshold will stay silent."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="September pulse"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="segment_mode" readonly="state != 'draft'"/>
                            <field name="date_open" readonly="1"/>
                            <field name="date_close" readonly="1"/>
                        </group>
                        <group string="Thresholds">
                            <field name="score_threshold"/>
                            <field name="text_threshold"/>
                            <field name="window_days"/>
                        </group>
                    </group>
                    <group string="Participation">
                        <group>
                            <field name="invitation_count"/>
                            <field name="response_count"/>
                        </group>
                        <group>
                            <field name="response_rate" digits="[16,0]"/>
                            <field name="pending_flush_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Questions asked" name="questions">
                            <field name="question_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="metric_id"/>
                                    <field name="question_kind"/>
                                    <field name="is_enps"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invitation register" name="invitations"
                              invisible="state == 'draft'">
                            <div class="alert alert-info" role="status">
                                This register knows who has responded, so no one is chased
                                for nothing. It knows neither when nor what: the responses
                                live in another table, with no link to a person.
                            </div>
                            <field name="invitation_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="segment_key"/>
                                    <field name="used" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pulse_campaign" model="ir.actions.act_window">
        <field name="name">Pulse waves</field>
        <field name="res_model">bf.ex.pulse.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Launch a first wave</p>
            <p>
                Three to five questions, once a month or once a quarter.
                A segment's score stays silent until it has enough
                respondents, which is the only way to promise anonymity
                without lying.
            </p>
        </field>
    </record>

</odoo>
