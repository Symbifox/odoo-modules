<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bookmark_proposal_view_form" model="ir.ui.view">
        <field name="name">bf.bookmark.proposal.form</field>
        <field name="model">bf.bookmark.proposal</field>
        <field name="arch" type="xml">
            <form string="Proposer un signet">
                <header>
                    <button name="action_accept" type="object" string="Accepter" class="btn-primary"
                            invisible="state != 'pending' or not id"/>
                    <button name="action_refuse" type="object" string="Refuser"
                            invisible="state != 'pending' or not id"/>
                    <field name="state" widget="statusbar" invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <!-- Figés une fois la proposition faite : le responsable décide sur ce qu'il a lu. -->
                        <field name="name" readonly="id"/>
                        <field name="url" widget="url" readonly="id"/>
                        <field name="target_folder_id" options="{'no_create': True}" readonly="id"/>
                        <field name="note" placeholder="Pour qui, à quoi il sert…" readonly="id"/>
                        <field name="proposer_id" invisible="not id"/>
                        <field name="responsible_id" invisible="not id"/>
                        <field name="result_bookmark_id" invisible="not result_bookmark_id"/>
                        <field name="bookmark_id" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bookmark_proposal_view_list" model="ir.ui.view">
        <field name="name">bf.bookmark.proposal.list</field>
        <field name="model">bf.bookmark.proposal</field>
        <field name="arch" type="xml">
            <list string="Propositions" create="false">
                <field name="create_date" string="Le"/>
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="target_folder_id"/>
                <field name="proposer_id"/>
                <field name="responsible_id"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'"
                       decoration-success="state == 'accepted'" decoration-muted="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="action_bookmark_proposal" model="ir.actions.act_window">
        <field name="name">Propositions</field>
        <field name="res_model">bf.bookmark.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune proposition</p>
            <p>Depuis vos signets perso, « Proposer à l'équipe » envoie un signet au
               responsable d'une section, qui l'accepte ou le refuse.</p>
        </field>
    </record>

    <record id="bookmark_proposal_view_search" model="ir.ui.view">
        <field name="name">bf.bookmark.proposal.search</field>
        <field name="model">bf.bookmark.proposal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="pending" string="En attente" domain="[('state', '=', 'pending')]"/>
                <filter name="to_decide" string="À moi de décider" domain="[('responsible_id', '=', uid), ('state', '=', 'pending')]"/>
            </search>
        </field>
    </record>

    <!-- Liens morts : un filtre sur la liste des signets, et le détail sur la fiche. -->
    <record id="bookmark_view_search_links" model="ir.ui.view">
        <field name="name">bf.bookmark.search.links</field>
        <field name="model">bf.bookmark</field>
        <field name="inherit_id" ref="bookmark_view_search"/>
        <field name="arch" type="xml">
            <filter name="filter_archived" position="before">
                <filter name="filter_dead" string="Liens morts" domain="[('link_state', '=', 'dead')]"/>
                <separator/>
            </filter>
        </field>
    </record>

    <record id="bookmark_view_form_links" model="ir.ui.view">
        <field name="name">bf.bookmark.form.links</field>
        <field name="model">bf.bookmark</field>
        <field name="inherit_id" ref="bookmark_view_form"/>
        <field name="arch" type="xml">
            <field name="folder_id" position="after">
                <field name="link_state" invisible="scope == 'personal'"
                       decoration-danger="link_state == 'dead'" widget="badge"/>
                <field name="link_note" invisible="scope == 'personal' or not link_note"/>
            </field>
        </field>
    </record>

    <record id="bookmark_view_list_links" model="ir.ui.view">
        <field name="name">bf.bookmark.list.links</field>
        <field name="model">bf.bookmark</field>
        <field name="inherit_id" ref="bookmark_view_list"/>
        <field name="arch" type="xml">
            <field name="scope" position="after">
                <field name="link_state" optional="show" widget="badge"
                       decoration-danger="link_state == 'dead'" decoration-success="link_state == 'ok'"/>
            </field>
        </field>
    </record>
</odoo>
