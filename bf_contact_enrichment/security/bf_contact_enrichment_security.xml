<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Who may trigger bridge/LLM enrichment (card OCR, signature, web, batch).
         Members are internal users; the LLM cost/abuse surface is gated here.
         Set-once (noupdate): the admin is seeded on install; admins manage
         members afterwards without an upgrade overwriting their choices. -->
    <data noupdate="1">
        <record id="group_bf_contact_enrich" model="res.groups">
            <field name="name">Contact Enrichment</field>
            <field name="comment">Allows running AI contact enrichment
                (business card, email signatures, web domain) and
                batch processing.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>

</odoo>
