msgstr "Passerelle LLM de Blue Fox"

#. module: bf_llm
#: model:ir.model.fields,help:bf_llm.field_bf_llm_provider__supports_tools
msgid "Capability flag — drives chat(tools=…) degradation."
msgstr "Drapeau de capacité : il commande le repli de chat(tools=…)."

#. module: bf_llm
#: model:ir.model.fields,help:bf_llm.field_bf_llm_provider__supports_vision
msgid ""
"Capability flag — drives the extract() degradation path (Tesseract text pre-"
"pass when disabled)."
msgstr ""
"Drapeau de capacité : il commande le repli d'extract() (prélecture du texte "
"par Tesseract quand il est décoché)."

