<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- A student who turns 14 consents for themself from that day. -->
    <record id="ir_cron_school_sync_minors" model="ir.cron">
        <field name="name">School: students who reach the age of consent</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_school_sync_minors()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
