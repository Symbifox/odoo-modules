<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_hour_bank_send_reports" model="ir.cron">
            <field name="name">Banque d'heures : Envoi automatique des rapports</field>
            <field name="model_id" ref="model_hour_bank_client"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">20</field>
        </record>

        <record id="cron_hour_bank_check_thresholds" model="ir.cron">
            <field name="name">Banque d'heures : Vérifier les paliers de notification</field>
            <field name="model_id" ref="model_hour_bank_client"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_thresholds()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:30:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">25</field>
        </record>

    </data>
</odoo>
