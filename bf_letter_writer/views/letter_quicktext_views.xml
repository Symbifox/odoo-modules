<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="letter_quicktext_view_list" model="ir.ui.view">
        <field name="name">letter.quicktext.list</field>
        <field name="model">letter.quicktext</field>
        <field name="arch" type="xml">
            <list string="Blocs de texte">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="shortcut"/>
                <field name="category"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="letter_quicktext_view_form" model="ir.ui.view">
        <field name="name">letter.quicktext.form</field>
        <field name="model">letter.quicktext</field>
        <field name="arch" type="xml">
            <form string="Bloc de texte">
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du bloc..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="shortcut" placeholder="::raccourci"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Contenu"/>
                    <field name="body_html" widget="html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_letter_quicktext" model="ir.actions.act_window">
        <field name="name">Blocs de texte</field>
        <field name="res_model">letter.quicktext</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier bloc de texte réutilisable
            </p>
        </field>
    </record>

</odoo>
