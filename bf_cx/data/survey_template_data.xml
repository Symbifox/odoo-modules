<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default NPS survey: 0-10 scale + verbatim + testimonial opt-in.
             Token access: answers are generated per contact by the waves. -->
        <record id="survey_nps_default" model="survey.survey">
            <field name="title">Sondage NPS : votre avis compte</field>
            <field name="access_mode">token</field>
            <field name="users_login_required" eval="False"/>
            <field name="questions_layout">one_page</field>
        </record>

        <record id="question_nps_score" model="survey.question">
            <field name="survey_id" ref="survey_nps_default"/>
            <field name="sequence">10</field>
            <field name="title">Quelle est la probabilité que vous nous recommandiez à un collègue ou à un partenaire d'affaires ?</field>
            <field name="question_type">scale</field>
            <field name="scale_min">0</field>
            <field name="scale_max">10</field>
            <field name="scale_min_label">Très improbable</field>
            <field name="scale_max_label">Très probable</field>
            <field name="constr_mandatory" eval="True"/>
            <field name="constr_error_msg">Cette question est obligatoire.</field>
        </record>

        <record id="question_nps_reason" model="survey.question">
            <field name="survey_id" ref="survey_nps_default"/>
            <field name="sequence">20</field>
            <field name="title">Qu'est-ce qui explique principalement votre note ?</field>
            <field name="question_type">text_box</field>
        </record>

        <record id="question_nps_testimonial" model="survey.question">
            <field name="survey_id" ref="survey_nps_default"/>
            <field name="sequence">30</field>
            <field name="title">Pourrions-nous citer vos commentaires comme témoignage ?</field>
            <field name="question_type">simple_choice</field>
        </record>

        <!-- forcecreate="0": created on install only. On an upgrade the 18.0.1.12.0
             migration creates it, and only where it also wires it to a program,
             so a respondent never sees an answer that does nothing. -->
        <record id="answer_nps_testimonial_direct" model="survey.question.answer" forcecreate="0">
            <field name="question_id" ref="question_nps_testimonial"/>
            <field name="sequence">5</field>
            <field name="value">Oui, vous pouvez me citer avec mon nom, ma fonction et mon organisation, sans me recontacter</field>
        </record>

        <record id="answer_nps_testimonial_yes" model="survey.question.answer">
            <field name="question_id" ref="question_nps_testimonial"/>
            <field name="sequence">10</field>
            <field name="value">Oui, contactez-moi pour confirmer</field>
        </record>

        <record id="answer_nps_testimonial_no" model="survey.question.answer">
            <field name="question_id" ref="question_nps_testimonial"/>
            <field name="sequence">20</field>
            <field name="value">Non merci</field>
        </record>

        <!-- Ready-to-use relational NPS program wired to the survey above. -->
        <record id="program_nps_default" model="bf.cx.program">
            <field name="name">NPS relationnel</field>
            <field name="program_type">nps</field>
            <field name="survey_id" ref="survey_nps_default"/>
            <field name="score_question_id" ref="question_nps_score"/>
            <field name="comment_question_id" ref="question_nps_reason"/>
            <field name="testimonial_question_id" ref="question_nps_testimonial"/>
            <field name="testimonial_answer_id" ref="answer_nps_testimonial_yes"/>
            <field name="testimonial_direct_answer_id" ref="answer_nps_testimonial_direct"/>
            <field name="invite_template_id" ref="mail_template_cx_invite"/>
            <field name="reminder_days">5</field>
        </record>
    </data>
</odoo>
