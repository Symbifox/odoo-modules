<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rows are written only by server code (the browser facade, in sudo).
         Through RPC, a person reads their own connection and nothing else;
         an administrator reads and revokes everyone's. The app password and
         the poll token are system-only fields and never leave the server. -->
    <record id="rule_bf_nc_user_credential_own" model="ir.rule">
        <field name="name">Connexion Nextcloud : la sienne</field>
        <field name="model_id" ref="model_bf_nc_user_credential"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bf_nextcloud_browser.group_nc_browser_user'))]"/>
    </record>

    <record id="rule_bf_nc_user_credential_admin" model="ir.rule">
        <field name="name">Connexion Nextcloud : toutes (administration)</field>
        <field name="model_id" ref="model_bf_nc_user_credential"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

</odoo>
