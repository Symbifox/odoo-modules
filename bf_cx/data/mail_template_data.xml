<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Branded shell shared by every CX email (same pattern as the
             other Blue Fox modules): light outer #F8FAFC, 600px white card,
             brand_dark header with the company logo, brand_primary accent
             bar, Lexend, module footer with the unsubscribe link, bottom
             split accent. English translations are applied per-language by
             hooks.apply_cx_i18n (post_init + migrations). -->

        <record id="mail_template_cx_invite" model="mail.template">
            <field name="name">Expérience client : invitation au sondage</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">Votre avis compte (2 minutes)</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#29ABE1'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#2D3031'"/>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F8FAFC;">
    <tbody><tr><td align="center" style="padding:24px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;">
            <tbody>
                <tr>
                    <td t-attf-style="background-color:{{ brand_dark }}; padding:16px 24px; border-radius:12px 12px 0 0;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tbody><tr>
                            <td align="left">
                                <img t-att-src="'/web/image/res.company/%d/logo' % company.id" alt="Logo" style="height:40px; width:auto; display:block; border:0;"/>
                            </td>
                            <td align="right" style="color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;">
                                Votre avis
                            </td>
                        </tr></tbody></table>
                    </td>
                </tr>
                <tr><td t-attf-style="height:4px; line-height:4px; background-color:{{ brand_primary }};">&amp;nbsp;</td></tr>
                <tr>
                    <td style="padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif; color:#2D3031;">
                        <p style="font-size:15px; margin:0 0 12px 0;">
                            Bonjour <t t-out="object.partner_id.name or ''"/>,
                        </p>
                        <p style="font-size:15px; margin:0 0 12px 0;">
                            Merci de nous faire confiance. Auriez-vous deux
                            minutes pour nous dire comment ça se passe de
                            votre côté&#160;? Vos réponses nous aident
                            concrètement à nous améliorer.
                        </p>
                        <div style="text-align:center; margin:28px 0;">
                            <a t-att-href="object.get_start_url()"
                               t-attf-style="background-color:{{ brand_primary }}; color:#FFFFFF; text-decoration:none; padding:12px 28px; border-radius:6px; font-size:15px; display:inline-block;">
                                Répondre au sondage
                            </a>
                        </div>
                        <t t-if="object.deadline">
                            <p style="font-size:13px; color:#6B7280; margin:0 0 12px 0;">
                                Le sondage est ouvert jusqu'au
                                <t t-out="format_date(object.deadline)"/>.
                            </p>
                        </t>
                        <p style="font-size:15px; margin:0;">
                            Merci beaucoup&#160;!
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 24px 20px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;">
                        <p style="font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:0;">
                            <t t-if="company.name"><t t-out="company.name"/><br/></t>
                            Vous préférez ne plus recevoir de demandes d'avis&#160;?
                            <a t-att-href="object.partner_id.bf_cx_unsubscribe_url" style="color:#6B7280;">Me désabonner</a>.
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px; margin:12px auto 0;">
            <tbody><tr>
                <td t-attf-style="height:3px; line-height:3px; background-color:{{ brand_primary }}; width:50%;">&amp;nbsp;</td>
                <td t-attf-style="height:3px; line-height:3px; background-color:{{ brand_dark }}; width:50%;">&amp;nbsp;</td>
            </tr></tbody>
        </table>
    </td></tr></tbody>
</table>
            </field>
        </record>

        <record id="mail_template_cx_reminder" model="mail.template">
            <field name="name">Expérience client : rappel de sondage</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">Petit rappel : votre avis compte</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#29ABE1'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#2D3031'"/>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F8FAFC;">
    <tbody><tr><td align="center" style="padding:24px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;">
            <tbody>
                <tr>
                    <td t-attf-style="background-color:{{ brand_dark }}; padding:16px 24px; border-radius:12px 12px 0 0;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tbody><tr>
                            <td align="left">
                                <img t-att-src="'/web/image/res.company/%d/logo' % company.id" alt="Logo" style="height:40px; width:auto; display:block; border:0;"/>
                            </td>
                            <td align="right" style="color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;">
                                Petit rappel
                            </td>
                        </tr></tbody></table>
                    </td>
                </tr>
                <tr><td t-attf-style="height:4px; line-height:4px; background-color:{{ brand_primary }};">&amp;nbsp;</td></tr>
                <tr>
                    <td style="padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif; color:#2D3031;">
                        <p style="font-size:15px; margin:0 0 12px 0;">
                            Bonjour <t t-out="object.partner_id.name or ''"/>,
                        </p>
                        <p style="font-size:15px; margin:0 0 12px 0;">
                            Un petit rappel, sans aucune pression&#160;: votre
                            avis nous aiderait vraiment, et il ne faut que
                            deux minutes. C'est le seul rappel que vous
                            recevrez.
                        </p>
                        <div style="text-align:center; margin:28px 0;">
                            <a t-att-href="object.get_start_url()"
                               t-attf-style="background-color:{{ brand_primary }}; color:#FFFFFF; text-decoration:none; padding:12px 28px; border-radius:6px; font-size:15px; display:inline-block;">
                                Répondre au sondage
                            </a>
                        </div>
                        <p style="font-size:15px; margin:0;">
                            Merci beaucoup&#160;!
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 24px 20px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;">
                        <p style="font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:0;">
                            <t t-if="company.name"><t t-out="company.name"/><br/></t>
                            Vous préférez ne plus recevoir de demandes d'avis&#160;?
                            <a t-att-href="object.partner_id.bf_cx_unsubscribe_url" style="color:#6B7280;">Me désabonner</a>.
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px; margin:12px auto 0;">
            <tbody><tr>
                <td t-attf-style="height:3px; line-height:3px; background-color:{{ brand_primary }}; width:50%;">&amp;nbsp;</td>
                <td t-attf-style="height:3px; line-height:3px; background-color:{{ brand_dark }}; width:50%;">&amp;nbsp;</td>
            </tr></tbody>
        </table>
    </td></tr></tbody>
</table>
            </field>
        </record>

        <record id="mail_template_complaint_ack" model="mail.template">
            <field name="name">Expérience client : accusé de réception de plainte</field>
            <field name="model_id" ref="model_bf_cx_complaint"/>
            <field name="subject">Votre plainte est bien reçue ({{ object.confirmation_code }})</field>
            <field name="partner_to">{{ object.partner_id.id or '' }}</field>
            <field name="email_to">{{ '' if object.partner_id else (object.contact_email or '') }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<t t-set="company" t-value="object.company_id or user.company_id"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#29ABE1'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#2D3031'"/>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F8FAFC;">
    <tbody><tr><td align="center" style="padding:24px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;">
            <tbody>
                <tr>
                    <td t-attf-style="background-color:{{ brand_dark }}; padding:16px 24px; border-radius:12px 12px 0 0;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tbody><tr>
                            <td align="left">
                                <img t-att-src="'/web/image/res.company/%d/logo' % company.id" alt="Logo" style="height:40px; width:auto; display:block; border:0;"/>
                            </td>
                            <td align="right" style="color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;">
                                Bien reçu
                            </td>
                        </tr></tbody></table>
                    </td>
                </tr>
                <tr><td t-attf-style="height:4px; line-height:4px; background-color:{{ brand_primary }};">&amp;nbsp;</td></tr>
                <tr>
                    <td style="padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif; color:#2D3031;">
                        <p style="font-size:15px; margin:0 0 12px 0;">
                            Bonjour <t t-out="object.partner_id.name or object.contact_name or ''"/>,
                        </p>
                        <p style="font-size:15px; margin:0 0 12px 0;">
                            Nous avons bien reçu votre plainte concernant
                            «&#160;<t t-out="object.name"/>&#160;» et nous la
                            prenons au sérieux. Elle est entre bonnes mains
                            dès maintenant.
                        </p>
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;">
                            <tbody><tr>
                                <td align="center" t-attf-style="background-color:#F8FAFC; border:1px solid #e5e7eb; border-left:4px solid {{ brand_primary }}; border-radius:6px; padding:14px;">
                                    <span style="font-size:13px; color:#6B7280;">Votre code de confirmation</span><br/>
                                    <span t-attf-style="font-size:22px; font-weight:800; letter-spacing:3px; color:{{ brand_dark }};"><t t-out="object.confirmation_code"/></span>
                                </td>
                            </tr></tbody>
                        </table>
                        <p style="font-size:15px; margin:0 0 12px 0;">
                            Nous vous revenons avec notre analyse et la suite
                            à donner dans les meilleurs délais. Merci de nous
                            l'avoir signalée&#160;: c'est ce qui nous permet
                            de nous améliorer.
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 24px 20px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;">
                        <p style="font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:0;">
                            <t t-if="company.name"><t t-out="company.name"/><br/></t>
                            <t t-if="object.partner_id">
                                Vous préférez ne plus recevoir de demandes d'avis&#160;?
                                <a t-att-href="object.partner_id.bf_cx_unsubscribe_url" style="color:#6B7280;">Me désabonner</a>.
                            </t>
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px; margin:12px auto 0;">
            <tbody><tr>
                <td t-attf-style="height:3px; line-height:3px; background-color:{{ brand_primary }}; width:50%;">&amp;nbsp;</td>
                <td t-attf-style="height:3px; line-height:3px; background-color:{{ brand_dark }}; width:50%;">&amp;nbsp;</td>
            </tr></tbody>
        </table>
    </td></tr></tbody>
</table>
            </field>
        </record>
    </data>
</odoo>
