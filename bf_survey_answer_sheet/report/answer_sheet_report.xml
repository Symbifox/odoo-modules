<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Its own paper format, and not the company's: the sheet draws its own
         header, so the margins are the ones it needs. A document layout whose
         header carries an address and tax numbers can run deeper than the top
         margin a report inherits, and the body is then printed over it, on
         every page. -->
    <record id="paperformat_answer_sheet" model="report.paperformat">
        <field name="name">Survey answer sheet</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">26</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">10</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_answer_sheet" model="ir.actions.report">
        <field name="name">Answer sheet</field>
        <field name="model">survey.user_input</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_survey_answer_sheet.report_answer_sheet</field>
        <field name="report_file">bf_survey_answer_sheet.report_answer_sheet</field>
        <field name="paperformat_id" ref="paperformat_answer_sheet"/>
        <!-- The printed copy is named like the filed one, minus the extension
             the engine adds itself. -->
        <field name="print_report_name">object._bf_sheet_basename()</field>
        <field name="binding_model_id" ref="survey.model_survey_user_input"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
