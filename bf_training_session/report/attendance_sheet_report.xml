<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_attendance_sheet" model="ir.actions.report">
        <field name="name">Feuille de présence</field>
        <field name="model">event.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_training_session.report_attendance_sheet</field>
        <field name="report_file">bf_training_session.report_attendance_sheet</field>
        <field name="binding_model_id" ref="event.model_event_event"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Feuille de presence - %s' % (object.name or '')</field>
    </record>

    <template id="report_attendance_sheet_document">
        <!-- ⚠️ La variable de boucle DOIT s'appeler `doc` : `web.external_layout`
             fait `t-if="not o" t-set="o" t-value="doc"` et reprend `o.company_id`
             pour l'en-tête. La renommer sortirait la feuille sous la société de
             qui imprime plutôt que celle de la séance. -->
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="mt16 mb8">Feuille de présence</h2>
                <h4 class="text-muted mb16"><span t-field="doc.name"/></h4>

                <!-- 🔴 Un TABLEAU, pas `row` / `col-6`. wkhtmltopdf ne lit pas la grille
                     flex de Bootstrap 5 : les quatre renseignements s'empilaient en une
                     seule colonne étroite au lieu de deux côte à côte. -->
                <table style="width: 100%; margin-bottom: 18px;">
                    <tr>
                        <td style="width: 50%; vertical-align: top; padding: 4px 0;">
                            <strong>Formation</strong><br/>
                            <span t-field="doc.training_activity_id.name"/>
                        </td>
                        <td style="width: 50%; vertical-align: top; padding: 4px 0;">
                            <strong>Heures créditées</strong><br/>
                            <t t-out="('%g' % doc.training_hours).replace('.', ',')"/>
                            <t t-if="doc.training_hours &lt;= 1">heure</t><t t-else="">heures</t>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top; padding: 4px 0;">
                            <strong>Date</strong><br/>
                            <!-- Dans le fuseau de la SÉANCE, sans les secondes. -->
                            <span t-field="doc.date_begin"
                                  t-options="{'widget': 'datetime', 'format': 'd MMMM yyyy, HH:mm', 'tz_name': doc.date_tz}"/>
                        </td>
                        <td style="vertical-align: top; padding: 4px 0;">
                            <strong>Lieu</strong><br/>
                            <!-- 🔴 `address_inline`, pas `address_id.display_name` : le nom
                                 du partenaire seul affichait « YourCompany » comme lieu. -->
                            <span t-if="doc.address_inline" t-field="doc.address_inline"/>
                            <span t-else="" class="text-muted">À préciser</span>
                        </td>
                    </tr>
                </table>

                <!-- 🔴 Largeur imposée au tableau ET à chaque colonne, et une hauteur de
                     ligne : les cases de signature faisaient environ 80 pixels, trop
                     étroites pour signer à la main, sur un document dont c'est l'objet. -->
                <table class="table table-sm o_main_table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 40%;">Personne</th>
                            <th class="text-center" style="width: 15%;">Présence</th>
                            <th class="text-center" style="width: 45%;">Signature</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.registration_ids.filtered(lambda r: r.state != 'cancel')"
                            t-as="ligne">
                            <td style="height: 52px; vertical-align: middle;">
                                <span t-field="ligne.name"/>
                            </td>
                            <!-- 🔴 On lit l'ÉTAT, jamais `date_closed` : une inscription
                                 annulée GARDE sa date de présence, son calcul étant gardé
                                 par `if not date_closed`. -->
                            <td class="text-center" style="vertical-align: middle;">
                                <span t-if="ligne.state == 'done'">Présent</span>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td class="text-center" style="vertical-align: middle;">
                                <img t-if="ligne.training_signature"
                                     t-att-src="image_data_uri(ligne.training_signature)"
                                     style="max-height: 44px;"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p class="text-muted mt16" style="font-size: 9pt;">
                    La signature atteste la présence de la personne à la séance
                    nommée ci-dessus. Une présence non signée est consignée au
                    registre et marquée incomplète : elle n'est jamais comptée
                    pour zéro.
                </p>
            </div>
        </t>
    </template>

    <template id="report_attendance_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="bf_training_session.report_attendance_sheet_document"/>
            </t>
        </t>
    </template>
</odoo>
