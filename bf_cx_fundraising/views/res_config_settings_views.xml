<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.cx.fundraising</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_cx.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='bf_cx_loop_block']" position="inside">
                <setting string="Donor experience survey"
                         help="When a donation is validated, send this program's survey to the donor (once per donation, with the over-solicitation safeguard; recommended minimum program cadence: 90 days).">
                    <field name="bf_cx_donor_program_id"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
