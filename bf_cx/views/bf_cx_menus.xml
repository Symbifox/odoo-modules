<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root application menu. -->
    <menuitem id="menu_cx_root"
              name="Customer experience"
              web_icon="bf_cx,static/description/icon.png"
              groups="bf_cx.group_bf_cx_user"
              sequence="47"/>

    <record id="action_cx_dashboard" model="ir.actions.client">
        <field name="name">CX dashboard</field>
        <field name="tag">bf_cx.dashboard</field>
    </record>

    <menuitem id="menu_cx_dashboard"
              name="Dashboard"
              parent="menu_cx_root"
              action="action_cx_dashboard"
