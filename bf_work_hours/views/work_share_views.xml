<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_work_share_list" model="ir.ui.view">
        <field name="name">bf.work.share.list</field>
        <field name="model">bf.work.share</field>
        <field name="arch" type="xml">
            <list create="1" delete="0" editable="bottom">
                <field name="viewer_id" readonly="id"/>
                <field name="create_date" string="Since" readonly="1"/>
                <field name="active" column_invisible="1"/>
                <button name="action_revoke" type="object" string="Revoke" icon="fa-ban"
                        invisible="not id or not active"
                        confirm="This colleague will no longer see any of your days. Continue?"/>
            </list>
        </field>
    </record>

    <record id="view_bf_work_share_form" model="ir.ui.view">
        <field name="name">bf.work.share.form</field>
        <field name="model">bf.work.share</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button name="action_revoke" type="object" string="Revoke" invisible="not id or not active"
                            confirm="This colleague will no longer see any of your days. Continue?"/>
                </header>
                <sheet>
                    <group>
                        <field name="viewer_id" readonly="id"/>
                        <field name="create_date" string="Since" readonly="1" invisible="not id"/>
                        <field name="revoked_at" invisible="active"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_work_share_mine" model="ir.actions.act_window">
        <field name="name">My shares</field>
        <field name="res_model">bf.work.share</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('owner_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">You share your days with nobody</p>
            <p>Add a colleague to let them see your days: your hours, what they rest on, the hours you entered in timesheets, and your indicators if you turned them on (first and last trace of the day, meetings, time outside working hours). Never your raw traces. Revoke at any time.</p>
        </field>
    </record>
</odoo>
