<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_retail_price_file_view_list" model="ir.ui.view">
        <field name="name">bf.retail.price.file.list</field>
        <field name="model">bf.retail.price.file</field>
        <field name="arch" type="xml">
            <list string="Price files">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="line_count"/>
                <field name="matched_count"/>
                <field name="unmatched_count"/>
                <field name="doubt_count"/>
                <field name="rejected_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'applied'"/>
            </list>
        </field>
    </record>

    <record id="bf_retail_price_file_view_form" model="ir.ui.view">
        <field name="name">bf.retail.price.file.form</field>
        <field name="model">bf.retail.price.file</field>
        <field name="arch" type="xml">
            <form string="Price file">
                <header>
                    <button name="action_read" type="object" string="Read the file"
                            class="btn-primary" invisible="state == 'applied'"/>
                    <button name="action_apply" type="object" string="Apply the prices"
                            class="btn-primary" invisible="state != 'read'"
                            confirm="Each price opens a new vendor line dated from the file, and closes the one before it. Carry on?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="file" filename="filename"
                                   readonly="state != 'draft'"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="write_costs" readonly="state != 'draft'"/>
                            <field name="line_count"/>
                            <field name="matched_count"/>
                            <field name="unmatched_count"/>
                            <field name="doubt_count"/>
                            <field name="rejected_count"/>
                            <field name="digest" invisible="not digest" readonly="1"/>
                            <field name="columns_note" invisible="not columns_note"
                                   readonly="1"/>
                            <field name="price_header" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="state == 'draft' or not rejected_count">
                        Some rows are left out, and the Left out column says why, row by
                        row. The prices that can be read are applied all the same.
                    </div>
                    <field name="line_ids" invisible="state == 'draft'">
                        <list string="Lines" create="0" delete="0"
                              decoration-muted="not product_id"
                              decoration-warning="rejected"
                              decoration-danger="delta_pct &gt; 0">
                            <field name="row_no" optional="show"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="uom_label" optional="show"/>
                            <field name="product_id"/>
                            <field name="matched_on" optional="show"/>
                            <field name="current_price"/>
                            <field name="price"/>
                            <field name="delta_pct"/>
                            <field name="rejected"/>
                            <field name="check_unit" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bf_retail_price_file" model="ir.actions.act_window">
        <field name="name">Price files</field>
        <field name="res_model">bf.retail.price.file</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
