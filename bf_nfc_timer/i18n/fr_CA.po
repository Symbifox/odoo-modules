#. module: bf_nfc_timer
#. odoo-python
#: code:addons/bf_nfc_timer/models/bf_nfc_gesture.py:0
msgid "No timer running on “%s”."
msgstr "Aucun chrono en cours sur « %s »."

#. module: bf_nfc_timer
#: model:bf.nfc.gesture,description:bf_nfc_timer.gesture_timer_toggle
msgid ""
"One tag for both halves of the gesture: the first tap starts the task's "
"timer, the next one stops it and logs the timesheet with the configured "
"rounding."
msgstr ""
"Une seule pastille pour les deux moitiés du geste : le premier tapotement "
"démarre le chrono de la tâche, le suivant l'arrête et saisit la feuille de "
"temps avec l'arrondi configuré."

#. module: bf_nfc_timer
#: model:ir.model.fields.selection,name:bf_nfc_timer.selection__bf_nfc_gesture__kind__timer_toggle
msgid "Start or stop the timer"
msgstr "Démarrer ou arrêter le chrono"

#. module: bf_nfc_timer
#: model:ir.model.fields.selection,name:bf_nfc_timer.selection__bf_nfc_gesture__kind__timer_start
msgid "Start the timer"
msgstr "Démarrer le chrono"

#. module: bf_nfc_timer
#: model:ir.model.fields.selection,name:bf_nfc_timer.selection__bf_nfc_gesture__kind__timer_stop
msgid "Stop the timer and log"
msgstr "Arrêter le chrono et saisir"

#. module: bf_nfc_timer
#. odoo-python
#: code:addons/bf_nfc_timer/models/bf_nfc_gesture.py:0
msgid "The timer is already running on “%s”."
msgstr "Le chrono tourne déjà sur « %s »."

#. module: bf_nfc_timer
#. odoo-python
#: code:addons/bf_nfc_timer/models/bf_nfc_gesture.py:0
msgid "This tag does not point to a task."
msgstr "Cette pastille ne désigne pas une tâche."

#. module: bf_nfc_timer
#. odoo-python
#: code:addons/bf_nfc_timer/models/bf_nfc_gesture.py:0
msgid "This tag's task no longer exists."
msgstr "La tâche de cette pastille n'existe plus."

#. module: bf_nfc_timer
#. odoo-python
#: code:addons/bf_nfc_timer/models/bf_nfc_gesture.py:0
msgid "Timer started."
msgstr "Chrono démarré."

#. module: bf_nfc_timer
#: model:bf.nfc.gesture,name:bf_nfc_timer.gesture_timer_start
msgid "Timer: start"
msgstr "Chrono : démarrer"

#. module: bf_nfc_timer
#: model:bf.nfc.gesture,name:bf_nfc_timer.gesture_timer_toggle
msgid "Timer: start or stop"
