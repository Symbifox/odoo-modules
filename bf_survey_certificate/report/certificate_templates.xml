<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Route the three "bf_brand*" layouts to our documents; every other
         layout keeps Odoo's. The xpath anchors on the t-call attribute
         (never on text: text moves with translation and style, attributes
         do not). The certificate is the participant's document: it renders
         in their language, not in the printer's. -->
    <template id="certification_report_view" inherit_id="survey.certification_report_view">
        <xpath expr="//t[@t-call='survey.certification_report_view_general']" position="replace">
            <t t-if="user_input.survey_id.certification_report_layout == 'bf_brand'">
                <t t-call="bf_survey_certificate.certification_report_bf_brand"
                   t-lang="user_input.sudo()._bf_certificate_lang()"/>
            </t>
            <t t-elif="user_input.survey_id.certification_report_layout == 'bf_brand_sleek'">
                <t t-call="bf_survey_certificate.certification_report_bf_brand_sleek"
                   t-lang="user_input.sudo()._bf_certificate_lang()"/>
            </t>
            <t t-elif="user_input.survey_id.certification_report_layout == 'bf_brand_classic'">
                <t t-call="bf_survey_certificate.certification_report_bf_brand_classic"
                   t-lang="user_input.sudo()._bf_certificate_lang()"/>
            </t>
            <t t-else="">
                <t t-call="survey.certification_report_view_general"/>
            </t>
        </xpath>
    </template>

    <!-- The three branded certificates. One A4 landscape page each (1122x792
         css px at 96 dpi, margins 0: the paper is 793.7px high and 792 is
         the closest even value that still fits on one page; 790 left a
         visible white strip along the bottom edge). Written for
         wkhtmltopdf 0.12.6:
         literal colours (var() is silently ignored), tables and absolute
         blocks (no grid), images inlined as data URIs (a remote fetch blocks
         the render), padding-right equal to the letter-spacing on every
         letterspaced run (Qt clips the overflow), border-collapse:separate
         everywhere (collapse draws phantom hairlines), and every td/tr
         carries its padding, background and border inline (the tenant report
         bundle has a bare td rule). The inline font-family carries
         !important on purpose: bf_lexend forces Lexend on every report body,
         and a white-label company set to another font must win over that.
         The body reset sits INSIDE div.article because the PDF pipeline
         (_prepare_html) keeps only the article divs of the rendered page;
         without it the bundle's .container padding slides the fixed page
         sideways and the right edge is cut at the paper's edge. -->

    <!-- "Company brand - panel": dark side panel carrying the logo on a
         white card, the QR and the number; primary-colour circles; airy
         right zone with the name in semibold. -->
    <template id="certification_report_bf_brand">
        <t t-set="vals" t-value="user_input.sudo()._bf_certificate_values()"/>
        <div class="article" t-att-data-oe-model="user_input._name" t-att-data-oe-id="user_input.id"
             style="page-break-after:always;">
            <style>
                body { margin: 0 !important; padding: 0 !important; }
            </style>
            <t t-if="user_input.scoring_success">
                <t t-set="name_size" t-value="len(vals['learner']) > 38 and '30px' or (len(vals['learner']) > 24 and '40px' or '52px')"/>
                <t t-set="course_size" t-value="len(vals['course']) > 90 and '15px' or (len(vals['course']) > 60 and '18px' or '23px')"/>
                <div t-attf-style="width:1122px;height:792px;background:#ffffff;position:relative;overflow:hidden;font-family:'#{vals['font']}','Lexend',Arial,sans-serif !important;color:#{vals['dark']};">
                    <div t-attf-style="position:absolute;left:0;top:0;width:300px;height:792px;background:#{vals['dark']};overflow:hidden;">
                        <div t-attf-style="position:absolute;left:-90px;top:-90px;width:280px;height:280px;border-radius:50%;background:#{vals['primary']};opacity:.3;"/>
                        <div t-attf-style="position:absolute;left:170px;top:630px;width:230px;height:230px;border-radius:50%;background:#{vals['primary']};opacity:.16;"/>
                        <div style="position:absolute;left:34px;top:46px;width:232px;">
                            <div style="display:inline-block;background:#ffffff;border-radius:10px;padding:12px 16px;">
                                <img t-if="vals['logo']" t-att-src="image_data_uri(vals['logo'])"
                                     style="max-height:42px;max-width:190px;display:block;"/>
                                <span t-else="" t-attf-style="font-size:16px;font-weight:600;color:#{vals['dark']};"
                                      t-out="vals['company_name']"/>
                            </div>
                            <div style="font-size:10px;letter-spacing:3px;color:#ffffff;opacity:.55;margin-top:18px;padding-right:3px;">ONLINE TRAINING</div>
                        </div>
                        <div style="position:absolute;left:34px;bottom:42px;width:232px;">
                            <t t-if="vals['code_display']">
                                <div t-if="vals['qr_src']" style="display:inline-block;background:#ffffff;border-radius:10px;padding:10px;">
                                    <img t-att-src="vals['qr_src']" style="width:92px;height:92px;display:block;"/>
                                </div>
                                <div style="font-size:13px;font-weight:600;color:#ffffff;margin-top:12px;">
                                    <span>Certificate no.</span><br/><span t-out="vals['code_display']"/>
                                </div>
                                <div style="font-size:10px;color:#ffffff;opacity:.6;margin-top:6px;">
                                    <span>Verify authenticity:</span><br/>
                                    <span style="font-weight:600;word-wrap:break-word;" t-out="vals['url_label']"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div style="position:absolute;left:300px;top:0;width:822px;height:792px;">
                        <div style="padding:64px 64px 0 64px;">
                            <div t-attf-style="font-size:15px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:#{vals['primary']};padding-right:4px;">Certificate of Achievement</div>
                            <div t-attf-style="width:52px;height:6px;background:#{vals['primary']};margin:18px 0 36px 0;"/>
                            <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.55;">awarded to</div>
                            <div t-attf-style="font-size:#{name_size};font-weight:600;color:#{vals['dark']};line-height:1.1;margin:8px 0 24px 0;" t-out="vals['learner']"/>
                            <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.55;">for successfully completing</div>
                            <div t-attf-style="font-size:#{course_size};font-weight:600;color:#{vals['dark']};margin-top:8px;" t-out="vals['course']"/>
                            <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.55;margin-top:24px;">
                                <span>Issued on</span> <span t-out="vals['date']"/>
                            </div>
                        </div>
                        <div style="position:absolute;left:64px;bottom:60px;width:300px;">
                            <t t-if="vals['signatory_name']">
                                <div t-if="vals['signature']">
                                    <img t-att-src="image_data_uri(vals['signature'])"
                                         style="max-height:48px;max-width:220px;"/>
                                </div>
                                <div style="width:200px;border-top:1px solid #d9dbdd;padding-top:6px;">
                                    <div style="font-size:13px;font-weight:600;" t-out="vals['signatory_name']"/>
                                    <div t-attf-style="font-size:12px;color:#{vals['dark']};opacity:.55;" t-out="vals['signatory_title']"/>
                                </div>
                            </t>
                        </div>
                        <div t-attf-style="position:absolute;right:64px;bottom:60px;text-align:right;font-size:10px;color:#{vals['dark']};opacity:.5;">
                            <span>Issued by</span> <span t-out="vals['company_name']"/><br/>
                            <span t-out="vals['domain_label']"/>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <t t-call="bf_survey_certificate.certification_report_bf_brand_failed"/>
            </t>
        </div>
    </template>

    <!-- "Company brand - minimal": left-aligned composition, accent rule on
         the page's edge, very large name, discreet footer with no band. -->
    <template id="certification_report_bf_brand_sleek">
        <t t-set="vals" t-value="user_input.sudo()._bf_certificate_values()"/>
        <div class="article" t-att-data-oe-model="user_input._name" t-att-data-oe-id="user_input.id"
             style="page-break-after:always;">
            <style>
                body { margin: 0 !important; padding: 0 !important; }
            </style>
            <t t-if="user_input.scoring_success">
                <t t-set="name_size" t-value="len(vals['learner']) > 45 and '34px' or (len(vals['learner']) > 30 and '46px' or '60px')"/>
                <t t-set="course_size" t-value="len(vals['course']) > 90 and '15px' or (len(vals['course']) > 60 and '19px' or '24px')"/>
                <div t-attf-style="width:1122px;height:792px;background:#ffffff;position:relative;overflow:hidden;font-family:'#{vals['font']}','Lexend',Arial,sans-serif !important;color:#{vals['dark']};">
                    <div t-attf-style="position:absolute;left:0;top:0;width:6px;height:792px;background:#{vals['primary']};"/>
                    <div style="padding:56px 84px 0 90px;">
                        <table style="width:100%;border-collapse:separate;border-spacing:0;border:none;">
                            <tr style="border:none;background:transparent;">
                                <td style="vertical-align:middle;padding:0;background:transparent;border:none;">
                                    <img t-if="vals['logo']" t-att-src="image_data_uri(vals['logo'])"
                                         style="max-height:58px;max-width:300px;"/>
                                    <span t-else="" t-attf-style="font-size:25px;font-weight:600;color:#{vals['dark']};"
                                          t-out="vals['company_name']"/>
                                </td>
                                <td t-attf-style="text-align:right;vertical-align:middle;padding:0 3px 0 0;background:transparent;border:none;font-size:10px;letter-spacing:3px;color:#{vals['dark']};opacity:.5;">ONLINE TRAINING</td>
                            </tr>
                        </table>
                        <div style="margin-top:84px;">
                            <div t-attf-style="font-size:14px;font-weight:600;letter-spacing:5px;text-transform:uppercase;color:#{vals['primary']};padding-right:5px;">Certificate of Achievement</div>
                            <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.55;margin-top:30px;">awarded to</div>
                            <div t-attf-style="font-size:#{name_size};font-weight:400;color:#{vals['dark']};line-height:1.08;margin:10px 0 26px 0;" t-out="vals['learner']"/>
                            <div t-attf-style="width:64px;height:3px;background:#{vals['primary']};margin:0 0 26px 0;"/>
                            <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.55;">for successfully completing</div>
                            <div t-attf-style="font-size:#{course_size};font-weight:600;color:#{vals['primary']};margin-top:8px;" t-out="vals['course']"/>
                            <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.55;margin-top:20px;">
                                <span>Issued on</span> <span t-out="vals['date']"/>
                            </div>
                        </div>
                    </div>
                    <div style="position:absolute;left:90px;bottom:150px;width:948px;height:1px;background:#e4e6e8;"/>
                    <table style="width:1122px;border-collapse:separate;border-spacing:0;border:none;position:absolute;left:0;bottom:52px;">
                        <tr style="border:none;background:transparent;">
                            <td style="width:50%;padding:0 0 0 90px;vertical-align:bottom;background:transparent;border:none;">
                                <t t-if="vals['signatory_name']">
                                    <div t-if="vals['signature']">
                                        <img t-att-src="image_data_uri(vals['signature'])"
                                             style="max-height:48px;max-width:220px;"/>
                                    </div>
                                    <div style="width:200px;border-top:1px solid #d9dbdd;padding-top:6px;">
                                        <div style="font-size:13px;font-weight:600;" t-out="vals['signatory_name']"/>
                                        <div t-attf-style="font-size:12px;color:#{vals['dark']};opacity:.55;" t-out="vals['signatory_title']"/>
                                    </div>
                                </t>
                            </td>
                            <td style="width:50%;padding:0 84px 0 0;vertical-align:bottom;text-align:right;background:transparent;border:none;">
                                <t t-if="vals['code_display']">
                                    <table style="border-collapse:separate;border-spacing:0;border:none;margin-left:auto;">
                                        <tr style="border:none;background:transparent;">
                                            <td style="text-align:right;vertical-align:bottom;padding:0 14px 0 0;background:transparent;border:none;">
                                                <div style="font-size:12px;font-weight:600;">
                                                    <span>Certificate no.</span> <span t-out="vals['code_display']"/>
                                                </div>
                                                <div t-attf-style="font-size:11px;color:#{vals['dark']};opacity:.55;max-width:320px;">
                                                    <span>Verify authenticity:</span><br/>
                                                    <span style="font-weight:600;" t-out="vals['url_label']"/>
                                                </div>
                                            </td>
                                            <td style="vertical-align:bottom;padding:0;background:transparent;border:none;">
                                                <img t-if="vals['qr_src']" t-att-src="vals['qr_src']"
                                                     style="width:88px;height:88px;"/>
                                            </td>
                                        </tr>
                                    </table>
                                </t>
                            </td>
                        </tr>
                    </table>
                    <table style="width:1122px;border-collapse:separate;border-spacing:0;border:none;position:absolute;left:0;bottom:16px;">
                        <tr style="border:none;background:transparent;">
                            <td t-attf-style="padding:0 0 0 90px;background:transparent;border:none;color:#{vals['dark']};font-size:10px;opacity:.45;">
                                <span>Issued by</span> <span t-out="vals['company_name']"/>
                            </td>
                            <td t-attf-style="padding:0 84px 0 0;background:transparent;border:none;color:#{vals['dark']};font-size:10px;text-align:right;opacity:.45;"
                                t-out="vals['domain_label']"/>
                        </tr>
                    </table>
                </div>
            </t>
            <t t-else="">
                <t t-call="bf_survey_certificate.certification_report_bf_brand_failed"/>
            </t>
        </div>
    </template>

    <!-- "Company brand - classic": double frame in the brand colours,
         centred composition, ribbons around the title, pre-faded logo
         watermark (Qt ignores CSS opacity on images, so the fading is baked
         into the pixels by _bf_certificate_values), framed QR. -->
    <template id="certification_report_bf_brand_classic">
        <t t-set="vals" t-value="user_input.sudo()._bf_certificate_values()"/>
        <div class="article" t-att-data-oe-model="user_input._name" t-att-data-oe-id="user_input.id"
             style="page-break-after:always;">
            <style>
                body { margin: 0 !important; padding: 0 !important; }
            </style>
            <t t-if="user_input.scoring_success">
                <t t-set="name_size" t-value="len(vals['learner']) > 45 and '26px' or (len(vals['learner']) > 30 and '34px' or '42px')"/>
                <t t-set="course_size" t-value="len(vals['course']) > 90 and '14px' or (len(vals['course']) > 60 and '17px' or '21px')"/>
                <div t-attf-style="width:1122px;height:792px;background:#ffffff;position:relative;overflow:hidden;font-family:'#{vals['font']}','Lexend',Arial,sans-serif !important;color:#{vals['dark']};">
                    <div t-attf-style="position:absolute;left:18px;top:18px;width:1082px;height:752px;border:2px solid #{vals['primary']};"/>
                    <div style="position:absolute;left:26px;top:26px;width:1068px;height:738px;border:1px solid #d9dbdd;"/>
                    <div t-if="vals.get('logo_faded')" style="position:absolute;left:0;top:250px;width:1122px;text-align:center;">
                        <img t-att-src="image_data_uri(vals['logo_faded'])" style="max-width:420px;max-height:300px;"/>
                    </div>
                    <div style="position:relative;padding-top:60px;text-align:center;">
                        <div>
                            <img t-if="vals['logo']" t-att-src="image_data_uri(vals['logo'])"
                                 style="max-height:54px;max-width:280px;"/>
                            <span t-else="" t-attf-style="font-size:24px;font-weight:600;color:#{vals['dark']};"
                                  t-out="vals['company_name']"/>
                        </div>
                        <div t-attf-style="font-size:10px;letter-spacing:3px;color:#{vals['dark']};opacity:.5;margin-top:12px;padding-right:3px;">ONLINE TRAINING</div>
                        <table style="border-collapse:separate;border-spacing:0;border:none;margin:38px auto 0 auto;">
                            <tr style="border:none;background:transparent;">
                                <td style="padding:0;background:transparent;border:none;vertical-align:middle;">
                                    <div style="width:110px;height:1px;background:#c9ccce;"/>
                                </td>
                                <td t-attf-style="padding:0 29px 0 24px;background:transparent;border:none;vertical-align:middle;font-size:27px;font-weight:600;letter-spacing:5px;text-transform:uppercase;color:#{vals['dark']};white-space:nowrap;">Certificate of Achievement</td>
                                <td style="padding:0;background:transparent;border:none;vertical-align:middle;">
                                    <div style="width:110px;height:1px;background:#c9ccce;"/>
                                </td>
                            </tr>
                        </table>
                        <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.6;margin-top:32px;">awarded to</div>
                        <div t-attf-style="font-size:#{name_size};font-weight:600;color:#{vals['dark']};margin:8px 0 18px 0;" t-out="vals['learner']"/>
                        <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.6;">for successfully completing</div>
                        <!-- No inline-block here, on purpose. The mock-up
                             underlined the course with border-bottom on an
                             inline-block, but Qt measures some fonts (Lexend)
                             about twice as wide as it draws them when it
                             computes an inline-block's shrink-to-fit width:
                             a 38-character course then wraps around 400px
                             drawn, whatever the container says - and without
                             a container the underline of a long course runs
                             across both frames. Block divs wrap with the
                             real metrics, so the course is a centred block
                             in a fixed 880px fence, with a separate
                             fixed-width rule under it. -->
                        <div style="width:880px;margin:0 auto;text-align:center;">
                            <div t-attf-style="font-size:#{course_size};font-weight:600;color:#{vals['dark']};margin-top:8px;"
                                 t-out="vals['course']"/>
                            <div t-attf-style="width:200px;height:2px;background:#{vals['primary']};margin:7px auto 0 auto;"/>
                        </div>
                        <div t-attf-style="font-size:13px;color:#{vals['dark']};opacity:.6;margin-top:20px;">
                            <span>Issued on</span> <span t-out="vals['date']"/>
                        </div>
                    </div>
                    <table style="width:1122px;border-collapse:separate;border-spacing:0;border:none;position:absolute;left:0;bottom:70px;">
                        <tr style="border:none;background:transparent;">
                            <td style="width:50%;padding:0 0 0 96px;vertical-align:bottom;background:transparent;border:none;">
                                <t t-if="vals['signatory_name']">
                                    <div t-if="vals['signature']">
                                        <img t-att-src="image_data_uri(vals['signature'])"
                                             style="max-height:50px;max-width:220px;"/>
                                    </div>
                                    <div style="width:220px;border-top:1px solid #c9ccce;padding-top:6px;">
                                        <div style="font-size:13px;font-weight:600;" t-out="vals['signatory_name']"/>
                                        <div t-attf-style="font-size:12px;color:#{vals['dark']};opacity:.6;" t-out="vals['signatory_title']"/>
                                    </div>
                                </t>
                            </td>
                            <td style="width:50%;padding:0 96px 0 0;vertical-align:bottom;text-align:right;background:transparent;border:none;">
                                <t t-if="vals['code_display']">
                                    <table style="border-collapse:separate;border-spacing:0;border:none;margin-left:auto;">
                                        <tr style="border:none;background:transparent;">
                                            <td style="text-align:right;vertical-align:bottom;padding:0 16px 0 0;background:transparent;border:none;">
                                                <div style="font-size:12px;font-weight:600;">
                                                    <span>Certificate no.</span> <span t-out="vals['code_display']"/>
                                                </div>
                                                <div t-attf-style="font-size:11px;color:#{vals['dark']};opacity:.6;max-width:330px;">
                                                    <span>Verify authenticity:</span><br/>
                                                    <span style="font-weight:600;" t-out="vals['url_label']"/>
                                                </div>
                                            </td>
                                            <td t-attf-style="vertical-align:bottom;padding:8px;background:transparent;border:1px solid #{vals['primary']};">
                                                <img t-if="vals['qr_src']" t-att-src="vals['qr_src']"
                                                     style="width:90px;height:90px;display:block;"/>
                                            </td>
                                        </tr>
                                    </table>
                                </t>
                            </td>
                        </tr>
                    </table>
                    <div t-attf-style="position:absolute;left:0;bottom:38px;width:1122px;text-align:center;font-size:10px;color:#{vals['dark']};opacity:.5;">
                        <span>Issued by</span> <span t-out="vals['company_name']"/> <span t-if="vals['domain_label']">·</span> <span t-out="vals['domain_label']"/>
                    </div>
                </div>
            </t>
            <t t-else="">
                <t t-call="bf_survey_certificate.certification_report_bf_brand_failed"/>
            </t>
        </div>
    </template>

    <!-- The failed-certification page, shared by the three layouts. -->
    <template id="certification_report_bf_brand_failed">
        <div t-attf-style="width:1122px;height:792px;background:#ffffff;position:relative;overflow:hidden;font-family:'#{vals['font']}','Lexend',Arial,sans-serif !important;color:#{vals['dark']};">
            <div t-attf-style="height:8px;background:#{vals['primary']};"/>
            <div style="text-align:center;margin-top:320px;">
                <div t-attf-style="font-size:22px;font-weight:600;color:#{vals['dark']};">Certification not passed</div>
                <div t-attf-style="font-size:14px;color:#{vals['dark']};opacity:.62;margin-top:10px;" t-out="vals['course']"/>
            </div>
        </div>
    </template>

</odoo>
