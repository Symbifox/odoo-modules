<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate : on peut ajuster une mesure livrée sans qu'une mise à jour l'écrase. -->
    <data noupdate="1">
        <record id="measure_active_services" model="bf.bi.measure">
            <field name="name">Active services</field>
            <field name="code">active_services</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">Services in production use.</field>
            <field name="model_id" search="[('model', '=', 'hosting.service')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[('state', '=', 'active')]</field>
            <field name="partner_field_id" search="[('model', '=', 'hosting.service'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_services_down" model="bf.bi.measure">
            <field name="name">Services down</field>
            <field name="code">services_down</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">Active services whose last health check failed.</field>
            <field name="model_id" search="[('model', '=', 'hosting.service')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[('state', '=', 'active'), ('is_service_up', '=', False)]</field>
            <field name="partner_field_id" search="[('model', '=', 'hosting.service'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_backup_runs" model="bf.bi.measure">
            <field name="name">Backup runs</field>
            <field name="code">backup_runs</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">SaaS backup runs.</field>
            <field name="model_id" search="[('model', '=', 'hosting.saas.backup.run')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[]</field>
            <field name="date_field_id" search="[('model', '=', 'hosting.saas.backup.run'), ('name', '=', 'run_date')]"/>
            <field name="partner_field_id" search="[('model', '=', 'hosting.saas.backup.run'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_failed_backups" model="bf.bi.measure">
            <field name="name">Failed backups</field>
            <field name="code">failed_backups</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">Backup runs that failed or ended with errors.</field>
            <field name="model_id" search="[('model', '=', 'hosting.saas.backup.run')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[('result', 'in', ('failed', 'with_errors'))]</field>
            <field name="date_field_id" search="[('model', '=', 'hosting.saas.backup.run'), ('name', '=', 'run_date')]"/>
            <field name="partner_field_id" search="[('model', '=', 'hosting.saas.backup.run'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_backup_success_rate" model="bf.bi.measure">
            <field name="name">Backup success rate</field>
            <field name="code">backup_success_rate</field>
            <field name="kind">formula</field>
            <field name="unit">percent</field>
            <field name="comparison">difference</field>
            <field name="company_id" eval="False"/>
            <field name="description">Share of backup runs without failure or error.</field>
            <field name="expression">(backup_runs - failed_backups) / backup_runs</field>
        </record>
        <record id="measure_average_storage_used" model="bf.bi.measure">
            <field name="name">Average storage used (%)</field>
            <field name="code">average_storage_used</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">Average share of storage quota used by active services.</field>
            <field name="model_id" search="[('model', '=', 'hosting.service')]"/>
            <field name="aggregator">avg</field>
            <field name="domain">[('state', '=', 'active'), ('storage_used_percent', '>', 0)]</field>
            <field name="field_id" search="[('model', '=', 'hosting.service'), ('name', '=', 'storage_used_percent')]"/>
            <field name="partner_field_id" search="[('model', '=', 'hosting.service'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_domains_expiring" model="bf.bi.measure">
            <field name="name">Domains expiring within 90 days</field>
            <field name="code">domains_expiring</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">Active domains whose registration ends within 90 days.</field>
            <field name="model_id" search="[('model', '=', 'hosting.domain')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[('state', 'in', ('active', 'expiring_soon')), ('date_expiration', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]</field>
            <field name="partner_field_id" search="[('model', '=', 'hosting.domain'), ('name', '=', 'partner_id')]"/>
        </record>
    </data>
</odoo>
