<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.gamification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Fox Quest" string="Fox Quest"
                     name="bf_gamification"
                     groups="bf_gamification.group_gamification_manager">
                    <block title="G&#233;n&#233;ral">
                        <setting id="gamification_enabled"
                                 string="Activer Fox Quest"
                                 help="Active ou d&#233;sactive tout le syst&#232;me de gamification">
                            <field name="gamification_enabled"/>
                        </setting>
                        <setting id="gamification_leaderboard"
                                 string="Classement"
                                 help="Afficher le classement des joueurs">
                            <field name="gamification_show_leaderboard"/>
                        </setting>
                    </block>
                    <block title="Notifications">
                        <setting id="gamification_popup"
                                 string="Popups d'achievement"
                                 help="Afficher les popups lors de l'obtention de badges et mont&#233;es de niveau">
                            <field name="gamification_popup_enabled"/>
                        </setting>
                        <setting id="gamification_sound"
                                 string="Sons"
                                 help="Activer les effets sonores">
                            <field name="gamification_sound_enabled"/>
                        </setting>
                        <setting id="gamification_confetti"
                                 string="Confettis"
                                 help="Activer les effets de confettis">
                            <field name="gamification_confetti_enabled"/>
                        </setting>
                    </block>
                    <block title="D&#233;fis du jour">
                        <setting id="gamification_challenges"
                                 string="Proposer des d&#233;fis du jour"
                                 help="Chaque jour ouvrable, trois petits d&#233;fis tir&#233;s de ce que la personne peut faire, et une carte &#224; tampons. Seuls ses propres gestes comptent, et elle seule voit ses d&#233;fis. Les d&#233;fis se g&#232;rent dans Configuration.">
                            <field name="gamification_challenges_enabled"/>
                        </setting>
                    </block>
                    <block title="Constance">
                        <setting id="gamification_streak"
                                 string="R&#233;initialisation du streak"
                                 help="Jours ouvrables sans activit&#233; qui cassent la constance (2 = un jour manqu&#233; est tol&#233;r&#233;). Fins de semaine, f&#233;ri&#233;s et absences d&#233;clar&#233;es ne comptent pas.">
                            <field name="gamification_streak_reset_days"/>
                        </setting>
                        <setting id="gamification_leave"
                                 string="Jours de cong&#233; de constance"
                                 help="Chaque employ&#233; qui choisit d'y participer re&#231;oit une demande de cong&#233; quand il atteint le palier ; un gestionnaire l'approuve ou la refuse. Aucun jour n'est accord&#233; sans approbation.">
                            <field name="gamification_leave_enabled"/>
                            <div class="mt-2" invisible="not gamification_leave_enabled">
                                <div class="row">
                                    <label for="gamification_leave_streak_days" class="col-lg-7 o_light_label"/>
                                    <field name="gamification_leave_streak_days" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="gamification_leave_days_per_step" class="col-lg-7 o_light_label"/>
                                    <field name="gamification_leave_days_per_step" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="gamification_leave_max_per_year" class="col-lg-7 o_light_label"/>
                                    <field name="gamification_leave_max_per_year" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Maintenance">
                        <setting id="gamification_reset"
                                 string="R&#233;initialiser la progression"
                                 help="Supprimer toutes les donn&#233;es XP, badges, streaks et r&#233;clamations pour tous les utilisateurs. Les demandes de cong&#233; de constance sont gard&#233;es. Cette action est irr&#233;versible.">
                            <button name="action_reset_all_progress"
                                    type="object"
                                    string="R&#233;initialiser toute la progression"
                                    class="btn-secondary"
                                    confirm="Confirmer la remise &#224; z&#233;ro ? Cette action supprimera TOUTE la progression de TOUS les utilisateurs. Cette action est irr&#233;versible."/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
