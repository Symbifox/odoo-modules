<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A teacher sees and returns the work of the groups they teach. The office sees all. -->
    <record id="rule_submission_teacher" model="ir.rule">
        <field name="name">Hand-ins: the groups I teach</field>
        <field name="model_id" ref="model_bf_school_homework_submission"/>
        <field name="groups" eval="[(6, 0, [ref('bf_school_core.group_school_user')])]"/>
        <field name="domain_force">[('group_id.teacher_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_submission_manager" model="ir.rule">
        <field name="name">Hand-ins: the office sees all</field>
        <field name="model_id" ref="model_bf_school_homework_submission"/>
        <field name="groups" eval="[(6, 0, [ref('bf_school_core.group_school_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="action_submission_return" model="ir.actions.server">
        <field name="name">Return</field>
        <field name="model_id" ref="model_bf_school_homework_submission"/>
        <field name="binding_model_id" ref="model_bf_school_homework_submission"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_return()</field>
    </record>
</odoo>
