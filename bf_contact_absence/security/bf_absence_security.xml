<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Pas de groupe neuf : noter qu'un client est en vacances est un
             geste ordinaire de la relation client, pas une permission à
             distribuer. Seule la SUPPRESSION est réservée, parce qu'effacer
             une absence éteint un avertissement que quelqu'un d'autre a posé. -->

        <record id="rule_bf_partner_absence_company" model="ir.rule">
            <field name="name">Absences : la société de l'utilisateur</field>
            <field name="model_id" ref="model_bf_partner_absence"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
