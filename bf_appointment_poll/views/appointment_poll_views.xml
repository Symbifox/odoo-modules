<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointment_poll_view_form" model="ir.ui.view">
        <field name="name">appointment.poll.form</field>
        <field name="model">appointment.poll</field>
        <field name="arch" type="xml">
            <form string="Sondage de disponibilités">
                <header>
                    <button name="action_propose_slots" type="object"
                            string="Proposer des créneaux libres" class="btn-primary"
                            invisible="state not in ('draft', 'open') or slot_source != 'organizer'"/>
                    <button name="action_hold_shortlist" type="object"
                            string="Retenir dans mon agenda"
                            invisible="slot_source != 'open' or hold_mode == 'none' or state != 'open'"/>
                    <button name="action_open" type="object"
                            string="Ouvrir le vote" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_send_invitations" type="object"
                            string="Envoyer les invitations"
                            invisible="state != 'open'"/>
                    <button name="action_close" type="object"
                            string="Clore le vote"
                            invisible="state != 'open'"/>
                    <button name="action_schedule_and_open" type="object"
                            string="Fixer la rencontre" class="btn-primary"
                            invisible="state != 'closed' or booking_id"/>
                    <button name="action_back_to_draft" type="object"
                            string="Remettre en brouillon"
                            invisible="state in ('draft', 'scheduled')"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('cancelled', 'scheduled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed,scheduled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_booking" type="object"
                                class="oe_stat_button" icon="fa-calendar-check-o"
                                invisible="not booking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Rendez-vous</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Objet de la rencontre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="type_id"/>
                            <field name="slot_source"/>
                            <field name="seeder_participant_id"
                                   invisible="slot_source != 'seeder'"
                                   readonly="seeded_by_id != False"
                                   options="{'no_create': True}"/>
                            <field name="seeded_by_id" invisible="not seeded_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="close_date"/>
                            <field name="max_slots"/>
                            <field name="max_picks_per_participant"
                                   invisible="slot_source == 'organizer'"/>
                            <field name="hold_mode"/>
                            <field name="show_votes"/>
                            <field name="send_invitations"/>
                        </group>
                    </group>
                    <group string="Inscription libre">
                        <group>
                            <field name="self_signup"/>
                            <field name="self_signup_max"
                                   invisible="not self_signup"/>
                        </group>
                        <group>
                            <field name="signup_url" widget="CopyClipboardURL"
                                   readonly="1" invisible="not self_signup"/>
                            <field name="self_signup_domains"
                                   placeholder="@client.com, jean@autre.ca"
                                   invisible="not self_signup"/>
                        </group>
                    </group>
                    <group string="Où en est-on">
                        <group>
                            <field name="participant_count"/>
                            <field name="responded_count"/>
                        </group>
                        <group>
                            <field name="pending_required_count"/>
                            <field name="viable_slot_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Créneaux proposés" name="slots">
                            <field name="slot_ids">
                                <list editable="bottom" decoration-muted="not is_viable"
                                      decoration-success="is_complete and is_viable">
                                    <field name="start"/>
                                    <field name="stop"/>
                                    <field name="proposed_by_id" optional="show"/>
                                    <field name="is_shortlisted" widget="boolean_toggle"/>
                                    <field name="yes_count"/>
                                    <field name="ifneedbe_count"/>
                                    <field name="no_count"/>
                                    <field name="vote_summary" optional="show"/>
                                    <field name="poll_state" column_invisible="1"/>
                                    <!-- Le raccourci : on fixe depuis la ligne
                                         quand on sait déjà lequel on veut. -->
                                    <button name="action_schedule_here" type="object"
                                            icon="fa-calendar-check-o"
                                            string="Fixer la rencontre ici"
                                            invisible="not is_viable or poll_state in ('draft', 'scheduled', 'cancelled')"/>
                                    <field name="is_viable"/>
                                    <field name="is_complete"/>
                                </list>
                            </field>
                        </page>
                        <page string="Participants" name="participants">
                            <field name="participant_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="tz" optional="show"
                                           placeholder="par défaut"/>
                                    <field name="required"/>
                                    <field name="vote_url" widget="CopyClipboardURL"
                                           readonly="1" optional="show"/>
                                    <field name="self_signup" optional="show"/>
                                    <field name="proposed_count" optional="hide"/>
                                    <field name="invitation_sent_on" optional="hide"/>
                                    <field name="responded_at"/>
                                    <field name="reminder_count" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Message aux participants" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 🔴 Cet écran existe parce que « Fixer la rencontre » ne demandait rien
         et retenait le premier créneau non rejeté dans l'ordre CHRONOLOGIQUE.
         Il montre le classement avant de demander. -->
    <record id="appointment_poll_schedule_wizard_form" model="ir.ui.view">
        <field name="name">appointment.poll.schedule.wizard.form</field>
        <field name="model">appointment.poll.schedule.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="poll_id" invisible="1"/>
                <group>
                    <field name="slot_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="slot_detail" readonly="1"
                           invisible="not slot_detail"/>
                </group>
                <separator string="Ce que le sondage a dit"/>
                <field name="apercu" readonly="1" nolabel="1"
                       widget="text" class="text-muted"/>
                <footer>
                    <button name="action_confirm" type="object" string="Fixer la rencontre"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="appointment_poll_view_list" model="ir.ui.view">
        <field name="name">appointment.poll.list</field>
        <field name="model">appointment.poll</field>
        <field name="arch" type="xml">
            <list string="Sondages">
                <field name="name"/>
                <field name="user_id"/>
                <field name="type_id"/>
                <field name="participant_count"/>
                <field name="responded_count"/>
                <field name="viable_slot_count"/>
                <field name="close_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="appointment_poll_action" model="ir.actions.act_window">
        <field name="name">Sondages de disponibilités</field>
        <field name="res_model">appointment.poll</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un sondage</p>
            <p>Proposez plusieurs créneaux déjà libres dans votre calendrier,
               laissez chacun répondre, puis fixez la rencontre.</p>
        </field>
    </record>
</odoo>
