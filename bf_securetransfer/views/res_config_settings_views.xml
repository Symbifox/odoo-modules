<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.securetransfer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Secure transfer" string="Secure transfer" name="bf_securetransfer">
                    <block title="S3 storage" name="bf_securetransfer_s3_block">
                        <setting string="S3 endpoint"
                                 help="IDrive E2 endpoint and bucket (or any S3-compatible storage). Shared bucket possible across tenants (isolated by the key prefix) or dedicated; object lock disabled.">
                            <div class="content-group">
                                <div>
                                    <label for="st_s3_endpoint_url" string="Endpoint"/>
                                    <field name="st_s3_endpoint_url"
                                           placeholder="https://….idrivee2-XX.com"/>
                                </div>
                                <div class="mt-2">
                                    <label for="st_s3_region" string="Region"/>
                                    <field name="st_s3_region" placeholder="ca-east-1"/>
                                </div>
                                <div class="mt-2">
                                    <label for="st_s3_bucket" string="Bucket"/>
                                    <field name="st_s3_bucket" placeholder="securetransfer-…"/>
                                </div>
                                <div class="mt-2">
                                    <label for="st_s3_key_prefix" string="Key prefix (tenant)"/>
                                    <field name="st_s3_key_prefix" placeholder="transfers-acme"/>
                                </div>
                                <div class="mt-2">
                                    <field name="st_s3_path_style"/>
                                    <label for="st_s3_path_style" string="Path-style addressing"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="S3 access keys"
                                 help="The keys are never stored in the database.">
                            <div class="content-group mb-2">
                                <label for="st_s3_creds_status" string="Status"/>
                                <field name="st_s3_creds_status" readonly="1" nolabel="1"/>
                            </div>
                            <div class="alert alert-info" role="alert">
                                The access keys are set in <code>odoo.conf</code>
                                (<code>bf_securetransfer_s3_access_key</code> /
                                <code>bf_securetransfer_s3_secret_key</code>) or in the environment
                                variables (<code>BF_SECURETRANSFER_S3_ACCESS_KEY</code> /
                                <code>BF_SECURETRANSFER_S3_SECRET_KEY</code>, which take priority),
                                <strong>never in the database</strong>: a dump or a staging
                                refresh would carry off the production keys.
                            </div>
                        </setting>
                        <setting string="CORS origins"
                                 help="Origins allowed to upload directly to the bucket (one per line or comma-separated; never &quot;*&quot;). Applied by &quot;Configure the S3 bucket&quot;.">
                            <field name="st_cors_origins" widget="text"
                                   placeholder="https://secret.example.com"/>
                            <div class="mt-2">
                                <button name="action_st_setup_bucket" type="object"
                                        string="Configure the S3 bucket"
                                        class="btn btn-secondary"
                                        help="Applies the CORS policy, attempts the lifecycle rules and runs the compatibility probes (residency, presign, multipart…). Idempotent."/>
                            </div>
                        </setting>
                    </block>
                    <block title="Public page" name="bf_securetransfer_public_block">
                        <setting string="Public upload"
                                 help="Master switch for the public send page. When unchecked, the /secrets page responds as unavailable; existing download links keep working.">
                            <field name="st_public_upload_enabled"/>
                        </setting>
                        <setting string="Drop page per employee"
                                 help="When an internal user is created (excluding service accounts, bots, API), automatically creates and maintains their personal /to/&lt;slug&gt; drop page. Renaming, email change and archiving tracked. Unchecked = pages created by hand only.">
                            <field name="st_autoprovision_user_pages"/>
                        </setting>
                        <setting string="Public base URL"
                                 help="URL served to visitors when the brand has no domain of its own. Never rely on web.base.url (frozen on some tenants).">
                            <field name="st_public_base_url"
                                   placeholder="https://secret.example.com"/>
                        </setting>
                        <setting string="Abuse desk"
                                 help="Address alerted when abuse is reported. The transfer is then suspended automatically and the recipients receive a neutral notice. Left empty, the company email receives the notice, never an outside address.">
                            <field name="st_abuse_email"
                                   placeholder="abuse@your-domain.com"/>
                        </setting>
                        <setting string="Sender OTP"
                                 help="Requires the sender to confirm a code sent to their email before sending (anti-spoofing / anti-piggyback).">
                            <field name="st_require_sender_otp"/>
                        </setting>
                        <setting string="Recipient OTP"
                                 help="Requires the recipient to enter a code sent to their email before downloading (strengthens Law 25 compliance).">
                            <field name="st_require_recipient_otp"/>
                        </setting>
                    </block>
                    <block title="Recipient code by SMS (VoIP.ms)"
                           name="bf_securetransfer_sms_block">
                        <setting string="Enable SMS"
                                 help="Allows sending the recipient's code by SMS instead of email (chosen when sending a secure message).">
                            <field name="st_sms_enabled"/>
                        </setting>
                        <setting string="Sender number (DID)"
                                 help="VoIP.ms DID enabled for SMS, from which the codes are sent (10-digit North American number)."
                                 invisible="not st_sms_enabled">
                            <field name="st_sms_did" placeholder="5145551234"/>
                        </setting>
                        <setting string="VoIP.ms credentials"
                                 help="The VoIP.ms API user and password are declared in odoo.conf (bf_securetransfer_voipms_user / _password), never in the database."
                                 invisible="not st_sms_enabled">
                            <field name="st_sms_creds_status"/>
                        </setting>
                    </block>
                    <block title="Allowlists (tenant default, anti-piggyback)"
                           name="bf_securetransfer_allowlist_block">
                        <setting string="Authorized senders"
                                 help="Global policy: who can send from this instance. Full address or domain (@client.com). Empty = open. A brand can set its own list.">
                            <field name="st_default_sender_allowlist"
                                   placeholder="@mycompany.com, john@partner.com"/>
                        </setting>
                        <setting string="Authorized recipients"
                                 help="Global policy: who can be sent to. Filled (e.g. @monentreprise.com) = the instance can only send to these addresses/domains.">
                            <field name="st_default_recipient_allowlist"
                                   placeholder="@mycompany.com"/>
                        </setting>
                    </block>
                    <block title="Default limits" name="bf_securetransfer_limits_block">
                        <setting string="Maximum size per transfer"
                                 help="Cap on the declared volume of a transfer, depending on the brand's tier. A brand can set its own cap.">
                            <div class="content-group">
                                <div>
                                    <field name="st_default_free_max_transfer_mb" class="o_light_label"/>
                                    <span class="ms-1">MB (free tier)</span>
                                </div>
                                <div class="mt-2">
                                    <field name="st_default_paid_max_transfer_mb" class="o_light_label"/>
                                    <span class="ms-1">MB (paid tier)</span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Maximum number of files"
                                 help="Number of files allowed in a single transfer.">
                            <div class="content-group">
                                <field name="st_default_max_files" class="o_light_label"/>
                                <span class="ms-1">files</span>
                            </div>
                        </setting>
                        <setting string="Maximum retention"
                                 help="Maximum lifetime of a transfer before automatic purge, depending on the tier.">
                            <div class="content-group">
                                <div>
                                    <field name="st_default_free_max_retention_days" class="o_light_label"/>
                                    <span class="ms-1">days (free tier)</span>
                                </div>
                                <div class="mt-2">
                                    <field name="st_default_paid_max_retention_days" class="o_light_label"/>
                                    <span class="ms-1">days (paid tier)</span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Attachments from the backend"
                                 help="Total size accepted by the &quot;New secure send&quot; wizard. These bytes travel through Odoo (the public page uploads straight to storage instead): hard-capped at 100 MB, whatever value is entered.">
                            <div class="content-group">
                                <field name="st_backend_max_upload_mb" class="o_light_label"/>
                                <span class="ms-1">MB per send</span>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_securetransfer_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'bf_securetransfer'}</field>
    </record>

</odoo>
