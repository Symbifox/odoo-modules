<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="channel_pastille" model="helpdesk.ticket.channel">
        <field name="name">Tag</field>
    </record>

    <record id="gesture_ticket" model="bf.nfc.gesture">
        <field name="name">Report a problem</field>
        <field name="code">ticket</field>
        <field name="kind">ticket</field>
        <field name="sequence">35</field>
        <field name="writes" eval="True"/>
        <field name="needs_target" eval="True"/>
        <field name="accepte_differe" eval="True"/>
        <field name="description">Bringing the phone close asks for one sentence, and the ticket is created filled in: the record's customer, the place, who reported it and when. In a menu, {"texte_fixe": "Out of paper"} creates the ticket without asking anything.</field>
    </record>
</odoo>
