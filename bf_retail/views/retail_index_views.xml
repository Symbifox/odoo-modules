<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_retail_index_view_list" model="ir.ui.view">
        <field name="name">bf.retail.index.list</field>
        <field name="model">bf.retail.index</field>
        <field name="arch" type="xml">
            <list string="Cost against price">
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="product_count"/>
                <field name="cost_index"/>
                <field name="price_index"/>
                <field name="spread" decoration-danger="spread &lt; 0"
                       decoration-success="spread &gt; 0"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="bf_retail_index_view_form" model="ir.ui.view">
        <field name="name">bf.retail.index.form</field>
        <field name="model">bf.retail.index</field>
        <field name="arch" type="xml">
            <form string="Cost against price">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="computed" invisible="1"/>
                        </group>
                        <group>
                            <field name="product_count"/>
                            <field name="cost_index"/>
                            <field name="price_index"/>
                            <field name="spread"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="not computed">
                        100 means nothing moved. A spread below zero says the shelf price
                        followed the cost by less than the cost moved: the store is paying the
                        difference. Only the products with a cost at both ends of the period
                        are counted, and a price moved by hand outside a batch is read as
                        having always been today's price.
                    </div>
                    <field name="line_ids">
                        <list string="Categories" create="0" delete="0">
                            <field name="categ_id"/>
                            <field name="product_count"/>
                            <field name="cost_start" widget="monetary"
                                   options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            <field name="cost_end" widget="monetary"
                                   options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            <field name="cost_index"/>
                            <field name="price_start"/>
                            <field name="price_end"/>
                            <field name="price_index"/>
                            <field name="margin_start" optional="show"/>
                            <field name="margin_end" optional="show"/>
                            <field name="spread" decoration-danger="spread &lt; 0"
                                   decoration-success="spread &gt; 0"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_retail_index" model="ir.actions.act_window">
        <field name="name">Cost against price</field>
        <field name="res_model">bf.retail.index</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
