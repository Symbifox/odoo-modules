<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Configurer la recherche universelle</field>
        <field name="description">Choisissez les modèles indexés et les priorités d'affichage dans la barre Cmd+K.</field>
        <field name="button_text">Ouvrir Paramètres</field>
        <field name="done_text">Recherche calibrée</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>
    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Recherche universelle</field>
        <field name="route_name">bf_universal_search_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_universal_search</field>
        <field name="step_ids" eval="[Command.link(ref('bf_universal_search.bf_onb_step_settings'))]"/>
    </record>
</odoo>
