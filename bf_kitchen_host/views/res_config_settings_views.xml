<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bf_kitchen_host</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_restaurant.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="restaurant_section" position="inside">
                <setting id="bf_host" string="Host stand" invisible="not pos_module_pos_restaurant or is_kiosk_mode"
                         help="Hosts seat the guests on the floor plan: sections in turn, waiting list, kitchen pace">
                    <field name="pos_bf_host"/>
                    <div class="content-group mt16" invisible="not pos_bf_host">
                        <div class="row">
                            <label for="pos_bf_host_employee_ids" class="col-lg-4 o_light_label"/>
                            <field name="pos_bf_host_employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </div>
                        <div class="row">
                            <label for="pos_bf_host_double_seat_minutes" class="col-lg-4 o_light_label"/>
                            <field name="pos_bf_host_double_seat_minutes"/>
                        </div>
                        <div class="row">
                            <label for="pos_bf_host_pace_covers" class="col-lg-4 o_light_label"/>
                            <field name="pos_bf_host_pace_covers"/>
                        </div>
                        <div class="row">
                            <label for="pos_bf_host_ticket_alert_minutes" class="col-lg-4 o_light_label"/>
                            <field name="pos_bf_host_ticket_alert_minutes"/>
                        </div>
                        <div class="row">
                            <label for="pos_bf_host_turn_minutes" class="col-lg-4 o_light_label"/>
                            <field name="pos_bf_host_turn_minutes"/>
                        </div>
                        <div>
                            <button name="%(bf_kitchen_host.bf_host_section_action)d" type="action" icon="oi-arrow-right"
                                    string="Sections" class="btn-link"
                                    context="{'default_config_id': pos_config_id, 'search_default_config_id': pos_config_id}"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
