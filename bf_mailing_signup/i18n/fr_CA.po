msgstr "Une liste a une étape par rang et par langue."

#. module: bf_mailing_signup
#: model:ir.model.fields,field_description:bf_mailing_signup.field_bf_mailing_signup_step__body_html
msgid "Body"
msgstr "Corps"

#. module: bf_mailing_signup
#: model:ir.model.fields,help:bf_mailing_signup.field_bf_mailing_signup_step__body_html
msgid ""
"Complete HTML of the email. It must contain {{desabonnement}}, replaced at "
"sending by the recipient's own unsubscribe link."
msgstr ""
"HTML complet du courriel. Il doit contenir {{desabonnement}}, remplacé à "
"l'envoi par le lien de désabonnement propre au destinataire."

#. module: bf_mailing_signup
#: model:ir.model.fields,field_description:bf_mailing_signup.field_mailing_subscription__bf_confirmed_at
msgid "Confirmed by email link"
msgstr "Confirmé par lien courriel"

#. module: bf_mailing_signup
#: model:ir.model.fields,field_description:bf_mailing_signup.field_bf_mailing_signup_step__delay_days
msgid "Days after confirmation"
msgstr "Jours après la confirmation"

