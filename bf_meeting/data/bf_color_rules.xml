<?xml version="1.0" encoding="utf-8"?>
<!-- Règle de couleur par défaut : l'agenda garde son critère d'aujourd'hui, et une
     couleur posée sur la valeur (un projet, un pilier) s'affiche. Modifiable, jamais réécrite. -->
<odoo noupdate="1">
    <record id="bf_color_rule_agenda_project" model="bf.color.rule">
        <field name="name">Ordres du jour selon le projet</field>
        <field name="sequence">100</field>
        <field name="company_id" eval="False"/>
        <field name="model_id" ref="bf_meeting.model_meeting_agenda"/>
        <field name="field_id" ref="bf_meeting.field_meeting_agenda__project_id"/>
    </record>
    <record id="bf_color_rule_record_project" model="bf.color.rule">
        <field name="name">Comptes rendus selon le projet</field>
        <field name="sequence">100</field>
        <field name="company_id" eval="False"/>
        <field name="model_id" ref="bf_meeting.model_meeting_record"/>
        <field name="field_id" ref="bf_meeting.field_meeting_record__project_id"/>
    </record>
</odoo>
