<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sign_expire" model="ir.cron">
            <field name="name">Signature : expirer les demandes échues</field>
            <field name="model_id" ref="model_bf_sign_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_requests()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_sign_reminders" model="ir.cron">
            <field name="name">Signature : relancer les signataires en attente</field>
            <field name="model_id" ref="model_bf_sign_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
