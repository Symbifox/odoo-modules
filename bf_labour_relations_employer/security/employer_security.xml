<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
          🔴 La liste d'ancienneté AFFICHÉE est publique dans l'unité, et c'est
          voulu : c'est un affichage, tout le monde doit pouvoir y lire son
          rang et celui des autres, sinon il n'y a pas de contestation
          possible. L'appartenance, elle, reste nominative et bornée au socle.
          Les deux règles disent donc des choses différentes du même fait, et
          c'est normal.
        -->

        <record id="rule_obligation_company" model="ir.rule">
            <field name="name">Obligation : société</field>
            <field name="model_id" ref="model_bf_labour_obligation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_seniority_list_company" model="ir.rule">
            <field name="name">Liste affichée : société</field>
            <field name="model_id" ref="model_bf_labour_seniority_list"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
          Une liste encore en brouillon n'est PAS un affichage : la donner à
          lire à tout le monde reviendrait à afficher avant d'avoir affiché.
        -->
        <record id="rule_seniority_list_posted_only" model="ir.rule">
            <field name="name">Liste affichée : le personnel ne voit que l'affiché</field>
            <field name="model_id" ref="model_bf_labour_seniority_list"/>
            <field name="domain_force">[('state', 'in', ['posted', 'superseded'])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_seniority_list_hr" model="ir.rule">
            <field name="name">Liste affichée : l'administration voit les brouillons</field>
            <field name="model_id" ref="model_bf_labour_seniority_list"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_seniority_line_company" model="ir.rule">
            <field name="name">Rang affiché : société</field>
            <field name="model_id" ref="model_bf_labour_seniority_list_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_seniority_line_posted_only" model="ir.rule">
            <field name="name">Rang affiché : le personnel ne voit que l'affiché</field>
            <field name="model_id" ref="model_bf_labour_seniority_list_line"/>
            <field name="domain_force">[('list_id.state', 'in', ['posted', 'superseded'])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_seniority_line_hr" model="ir.rule">
            <field name="name">Rang affiché : l'administration voit tout</field>
            <field name="model_id" ref="model_bf_labour_seniority_list_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_posting_company" model="ir.rule">
            <field name="name">Affichage de poste : société</field>
            <field name="model_id" ref="model_bf_labour_posting"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_posting_open_only" model="ir.rule">
            <field name="name">Affichage de poste : le personnel ne voit pas les brouillons</field>
            <field name="model_id" ref="model_bf_labour_posting"/>
            <field name="domain_force">[('state', '!=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_posting_hr" model="ir.rule">
            <field name="name">Affichage de poste : l'administration voit tout</field>
            <field name="model_id" ref="model_bf_labour_posting"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_bid_company" model="ir.rule">
            <field name="name">Candidature : société</field>
            <field name="model_id" ref="model_bf_labour_posting_bid"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
          ⚠️ Une candidature n'est pas publique. Savoir qui a postulé sur quoi
          se retourne contre les gens, et la convention n'en fait pas un
          affichage. Je vois la mienne, l'administration voit toutes.
        -->
        <record id="rule_bid_own" model="ir.rule">
            <field name="name">Candidature : je ne vois que la mienne</field>
            <field name="model_id" ref="model_bf_labour_posting_bid"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_bid_hr" model="ir.rule">
            <field name="name">Candidature : l'administration voit tout</field>
            <field name="model_id" ref="model_bf_labour_posting_bid"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_committee_company" model="ir.rule">
            <field name="name">Comité : société</field>
            <field name="model_id" ref="model_bf_labour_committee"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_committee_meeting_company" model="ir.rule">
            <field name="name">Rencontre du comité : société</field>
            <field name="model_id" ref="model_bf_labour_committee_meeting"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
