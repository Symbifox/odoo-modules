<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu — Top-level application -->
    <menuitem id="menu_meeting_root"
              name="Rencontres"
              web_icon="bf_meeting,static/description/icon.png"
              sequence="35"/>

    <!-- Comptes rendus -->
    <menuitem id="menu_meeting_records"
              name="Comptes rendus"
              parent="menu_meeting_root"
              sequence="10"/>
    <menuitem id="menu_meeting_records_all"
              name="Tous les comptes rendus"
              parent="menu_meeting_records"
              action="meeting_record_action"
              groups="group_meeting_user"
              sequence="10"/>
    <menuitem id="menu_meeting_records_draft"
              name="Brouillons"
              parent="menu_meeting_records"
              action="meeting_record_action_draft"
              groups="group_meeting_user"
              sequence="20"/>

    <!-- Ordres du jour -->
    <menuitem id="menu_meeting_agendas"
              name="Ordres du jour"
              parent="menu_meeting_root"
              sequence="20"/>
    <menuitem id="menu_meeting_agendas_today"
              name="Aujourd'hui"
              parent="menu_meeting_agendas"
              action="meeting_agenda_action_today"
              groups="group_meeting_user"
              sequence="5"/>
    <menuitem id="menu_meeting_agendas_all"
              name="Tous les ordres du jour"
              parent="menu_meeting_agendas"
              action="meeting_agenda_action"
              groups="group_meeting_user"
              sequence="10"/>
    <menuitem id="menu_meeting_agendas_upcoming"
              name="À venir"
              parent="menu_meeting_agendas"
              action="meeting_agenda_action_upcoming"
              groups="group_meeting_user"
              sequence="20"/>

    <!-- Par projet -->
    <menuitem id="menu_meeting_by_project"
              name="Par projet"
              parent="menu_meeting_root"
              action="meeting_record_action_by_project"
              groups="group_meeting_user"
              sequence="30"/>

    <!-- Posé ici et non dans meeting_exchange_views.xml : ce fichier-là est
         chargé AVANT menu_views.xml, donc `menu_meeting_records` n'existe pas
         encore quand il est lu. Le défaut ne se voit qu'à l'INSTALLATION
         neuve : sur une base déjà montée, le menu parent est en base et la
         mise à jour passe. -->
    <menuitem id="menu_meeting_exchange_import"
              name="Importer un compte rendu"
              parent="menu_meeting_records"
              action="meeting_exchange_import_action"
              groups="group_meeting_manager"
              sequence="90"/>

</odoo>
