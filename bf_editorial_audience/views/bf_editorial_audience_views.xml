<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_editorial_audience_list" model="ir.ui.view">
        <field name="name">bf.editorial.audience.list</field>
        <field name="model">bf.editorial.audience</field>
        <field name="arch" type="xml">
            <list string="Audience snapshots" create="0">
                <field name="capture_date"/>
                <field name="entry_id"/>
                <field name="lang_id"/>
                <field name="tracked_views" sum="Tracked"/>
                <field name="human_views" sum="Human"/>
                <field name="bot_views" sum="Bots"/>
                <field name="unknown_views" sum="Agent not recorded"/>
                <field name="bot_share" widget="percentage" optional="show"/>
                <field name="human_visitors" sum="Human visitors" optional="hide"/>
                <field name="tracked_visitors" sum="Tracked visitors" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_editorial_audience_pivot" model="ir.ui.view">
        <field name="name">bf.editorial.audience.pivot</field>
        <field name="model">bf.editorial.audience</field>
        <field name="arch" type="xml">
            <pivot string="Audience">
                <field name="entry_id" type="row"/>
                <field name="capture_date" interval="month" type="col"/>
                <field name="human_views" type="measure"/>
                <field name="tracked_views" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_editorial_audience_graph" model="ir.ui.view">
        <field name="name">bf.editorial.audience.graph</field>
        <field name="model">bf.editorial.audience</field>
        <field name="arch" type="xml">
            <graph string="Audience" type="line">
                <field name="capture_date" interval="day"/>
                <field name="human_views" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_editorial_audience_search" model="ir.ui.view">
        <field name="name">bf.editorial.audience.search</field>
        <field name="model">bf.editorial.audience</field>
        <field name="arch" type="xml">
            <search>
                <field name="entry_id"/>
                <field name="lang_id"/>
                <filter name="lus" string="Human views"
                        domain="[('human_views', '>', 0)]"/>
                <filter name="robots" string="Mostly bots"
                        domain="[('bot_share', '>=', 50)]"/>
                <separator/>
                <filter name="jour" string="Day" date="capture_date"/>
                <group expand="0" string="Group by">
                    <filter name="g_entry" string="Entry"
                            context="{'group_by': 'entry_id'}"/>
                    <filter name="g_lang" string="Language"
                            context="{'group_by': 'lang_id'}"/>
                    <filter name="g_date" string="Day"
                            context="{'group_by': 'capture_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_editorial_audience" model="ir.actions.act_window">
        <field name="name">Audience</field>
        <field name="res_model">bf.editorial.audience</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No snapshot yet</p>
            <p>
                The snapshot freezes each day before the visitor purge wipes its traces. It starts saying something useful the day after it goes live: earlier visits have no recorded agent and count as such. Mind the wording: "tracked views" is already filtered by Odoo, which refuses to track any agent that calls itself a bot. The raw figure is the post's native counter.
            </p>
        </field>
    </record>

    <!-- Le palmarès brut, gardé et annoté pour ce qu'il est. -->
    <record id="action_editorial_palmares_brut" model="ir.actions.act_window">
        <field name="name">Ranking (raw, bots included)</field>
        <field name="res_model">bf.editorial.entry</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('post_id', '!=', False)]</field>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The historical ranking</p>
            <p>
                Sorted on Odoo's native counter, which counts everything that comes through, bots included. It is kept as is because what it contained is unknown, and it is not corrected retroactively. For a ranking with bots removed, see Audience.
            </p>
        </field>
    </record>

</odoo>
