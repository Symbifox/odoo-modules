    <!-- Journal d'humeur. Règles GLOBALES (sans groupe) : elles
         s'appliquent à tout le monde, administrateurs compris. Une règle de
         groupe se contourne en s'ajoutant un groupe ; une règle globale, non.
         Seul le superutilisateur (crons, coquille, base) y échappe. -->
    <record id="health_mood_entry_rule_global" model="ir.rule">
        <field name="name">Humeur : à la personne seule, administrateurs compris</field>
        <field name="model_id" ref="model_health_mood_entry"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="health_mood_activity_rule_global" model="ir.rule">
        <field name="name">Activités d'humeur : à la personne seule, administrateurs compris</field>
        <field name="model_id" ref="model_health_mood_activity"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="health_mood_settings_rule_global" model="ir.rule">
        <field name="name">Journal d'humeur : à la personne seule, administrateurs compris</field>
        <field name="model_id" ref="model_health_mood_settings"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <!-- Les assistants de saisie ne sont PAS isolés d'office par
         Odoo 18 (mesuré au banc : B relisait l'assistant de A). L'assistant
         porte l'humeur et les signes vitaux avant l'enregistrement. -->
    <record id="health_daily_log_wizard_rule_global" model="ir.rule">
        <field name="name">Saisie rapide : à la personne seule</field>
        <field name="model_id" ref="model_health_daily_log_wizard"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="health_daily_log_wizard_med_line_rule_global" model="ir.rule">
        <field name="name">Saisie rapide, médicaments : à la personne seule</field>
