<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_view_list" model="ir.ui.view">
        <field name="name">bf.budget.list</field>
        <field name="model">bf.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets" decoration-muted="state in ('cancelled', 'revised')">
                <field name="name"/>
                <field name="budget_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="amount_planned" sum="Planned"/>
                <field name="amount_committed" sum="Committed"/>
                <field name="amount_variance" sum="Variance" decoration-danger="amount_variance &lt; 0"/>
                <field name="alert_line_count" string="Alerts" decoration-danger="alert_line_count &gt; 0"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state in ('cancelled', 'revised', 'closed')"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="bf_budget_view_form" model="ir.ui.view">
        <field name="name">bf.budget.form</field>
        <field name="model">bf.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_open" string="Open budget" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_revision" string="Revise" type="object"
                            invisible="state not in ('open', 'closed')"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'open'"/>
                    <button name="action_reset_draft" string="Reset to draft" type="object"
                            invisible="state not in ('open', 'cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled', 'revised')"/>
                    <button name="action_generate_lines_from_positions"
                            string="One line per budget item" type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not coverage_warning or state != 'draft'">
                        Some operating accounts are covered by no budget item of this budget, or by two budget items. A budget can look on track simply because a budget item is missing. See the "Coverage" tab.
                    </div>
                    <field name="alert_recipient_ok" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="alert_recipient_ok or state != 'open'">
                        This budget has no responsible who can receive its alerts (an active internal user of its company, with access to budgets): when a line crosses the alert threshold, the alert is only noted in the chatter, and nobody is assigned.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not revision_of_id">
                        This budget is a revision. The original can still be viewed:
                        <field name="revision_of_id" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Operations 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="budget_type"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="alert_threshold_pct"/>
                            <field name="alert_threshold_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-danger="is_alert">
                                    <field name="sequence" widget="handle"/>
                                    <field name="budget_type" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="source"/>
                                    <field name="position_id"/>
                                    <field name="analytic_account_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                    <field name="amount_planned" sum="Planned"/>
                                    <field name="amount_actual" sum="Actual"/>
                                    <field name="amount_committed" sum="Committed"/>
                                    <field name="amount_theoretical" sum="Theoretical"/>
                                    <field name="theoretical_basis" optional="show"/>
                                    <field name="amount_drift" sum="Variance from theoretical"/>
                                    <field name="is_alert" optional="hide"/>
                                    <field name="overrun_accepted" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Coverage" name="coverage">
                            <group>
                                <field name="coverage_warning" invisible="1"/>
                                <field name="uncovered_account_ids" widget="many2many_tags"
                                       readonly="1"
                                       help="Operating accounts of the right type that no budget item of this budget covers."/>
                                <field name="duplicated_account_ids" widget="many2many_tags"
                                       readonly="1"
                                       help="Accounts covered by more than one budget item: their entries are counted several times."/>
                            </group>
                        </page>
                        <page string="Totals" name="totals">
                            <group>
                                <group string="The plan">
                                    <field name="amount_planned"/>
                                    <field name="amount_theoretical"/>
                                </group>
                                <group string="Actuals">
                                    <field name="amount_actual"/>
                                    <field name="amount_committed"/>
                                    <field name="amount_variance"/>
                                    <field name="alert_line_count"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_budget_view_search" model="ir.ui.view">
        <field name="name">bf.budget.search</field>
        <field name="model">bf.budget</field>
        <field name="arch" type="xml">
            <search string="Budgets">
                <field name="name"/>
                <field name="user_id"/>
                <filter name="draft" string="Drafts" domain="[('state', '=', 'draft')]"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <separator/>
                <filter name="my_budgets" string="My budgets" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="expense" string="Expenses" domain="[('budget_type', '=', 'expense')]"/>
                <filter name="revenue" string="Revenue" domain="[('budget_type', '=', 'revenue')]"/>
                <separator/>
                <filter name="current" string="In progress"
                        domain="[('date_start', '&lt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group by">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Budget type" context="{'group_by': 'budget_type'}"/>
                    <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_budget_action" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">bf.budget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first budget</p>
            <p>
                A budget compares a plan with actuals, budget item by budget item. Actuals are never copied: they are read from accounting on every display.
            </p>
        </field>
    </record>
</odoo>
