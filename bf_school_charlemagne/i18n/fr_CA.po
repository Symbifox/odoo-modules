#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%(name)s was not read: %(why)s Look the transmission up in Charlemagne."
msgstr "%(name)s n'a pas été lu : %(why)s Consultez la transmission dans Charlemagne."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%(student)s has no result for the third term in %(course)s yet."
msgstr "%(student)s n'a pas encore de résultat à la troisième étape pour %(course)s."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%(student)s, %(course)s: the Ministry holds this result under %(held)s, which cannot be modified: the new result is sent for that record."
msgstr "%(student)s, %(course)s : le Ministère détient ce résultat sous %(held)s, éléments qui ne se modifient pas : le nouveau résultat est envoyé pour cette fiche."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%(student)s: %(course)s has no exam sitting entered."
msgstr "%(student)s : aucune session d'épreuve n'est saisie pour %(course)s."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%(student)s: the exam is no longer held, its results are taken off now and the registration is cancelled in the next transmission."
msgstr "%(student)s : l'épreuve n'est plus retenue, ses résultats sont retirés maintenant et l'inscription est annulée à la prochaine transmission."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%s has no permanent code."
msgstr "%s n'a pas de code permanent."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/profile.py:0
msgid "%s is not enrolled in a group this year."
msgstr "%s n'a aucune inscription dans un groupe cette année."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%s transaction(s) do not pass the checks: fix what the messages say in the students' Charlemagne cards, then collect and build again. Nothing is sent partially."
msgstr "%s transaction(s) ne passent pas les contrôles : corrigez ce que disent les messages dans les fiches Charlemagne des élèves, puis recueillez et produisez de nouveau. Rien n'est envoyé en partie."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/profile.py:0
msgid "%s: an attendance declaration needs the date attendance started."
msgstr "%s : une déclaration de fréquentation demande la date de début de fréquentation."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%s: the component weights do not total 100 %%, its results are not collected."
msgstr "%s : les pondérations des compétences ou volets ne totalisent pas 100 %%, ses résultats ne sont pas recueillis."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%s: the component weights do not total 100 %%, the school's result is not sent with its exams."
msgstr "%s : les pondérations des compétences ou volets ne totalisent pas 100 %%, le résultat de l'école n'est pas envoyé avec les résultats d'épreuve."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%s: the course code or the group number is missing, its exams are not collected."
msgstr "%s : le code de cours ou le numéro de groupe manque ; ses épreuves ne sont pas recueillies."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%s: the declaration was cancelled; it is not made again here."
msgstr "%s : la déclaration a été annulée ; elle n'est pas refaite ici."

#. module: bf_school_charlemagne
#. odoo-python
#: code:addons/bf_school_charlemagne/models/batch.py:0
msgid "%s: the group has no Ministry number, its results are not collected."
