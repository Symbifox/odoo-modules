<?xml version="1.0" encoding="utf-8"?>
<!-- Default color rule: the agenda keeps today's criterion, and a color set
     on the value (a doctor, a project) now shows. Editable, never overwritten. -->
<odoo noupdate="1">
    <record id="bf_color_rule_event_nc_calendar" model="bf.color.rule">
        <field name="name">Events by Nextcloud calendar</field>
        <field name="sequence">100</field>
        <field name="company_id" eval="False"/>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="field_id" ref="calendar_nextcloud_sync.field_calendar_event__x_nc_calendar_id"/>
    </record>
</odoo>
