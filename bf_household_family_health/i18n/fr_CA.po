msgstr "Vide : l'enfant du foyer est créé avec cette fiche."

#. module: bf_household_family_health
#. odoo-python
#: code:addons/bf_household_family_health/models/health_dependent.py:0
msgid "First name, birth month and birth year are needed."
msgstr "Le prénom, le mois et l'année de naissance sont nécessaires."

#. module: bf_household_family_health
#: model:ir.model.fields,field_description:bf_household_family_health.field_bf_household_child__health_dependent_ids
msgid "Healthy Fox"
msgstr "Healthy Fox"

#. module: bf_household_family_health
#. odoo-python
#: code:addons/bf_household_family_health/models/household_child.py:0
msgid ""
"Healthy Fox follows this birth date to know when the child turns 14: only "
"Blue Fox corrects it."
msgstr ""
"Healthy Fox suit cette date de naissance pour savoir quand l'enfant aura 14 "
"ans : seule Blue Fox la corrige."

#. module: bf_household_family_health
#. odoo-python
#: code:addons/bf_household_family_health/models/emergency_card.py:0
