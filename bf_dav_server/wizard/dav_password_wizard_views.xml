<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_dav_password_wizard_form" model="ir.ui.view">
        <field name="name">bf.dav.password.wizard.form</field>
        <field name="model">bf.dav.password.wizard</field>
        <field name="arch" type="xml">
            <form string="New app password">
                <field name="state" invisible="1"/>
                <group invisible="state != 'new'">
                    <field name="name" placeholder="Thunderbird office, Android phone..."/>
                    <field name="user_id" readonly="1" groups="base.group_system"/>
                </group>
                <div invisible="state != 'done'">
                    <p><strong>Write this password down now: it will not be shown again.</strong></p>
                    <group>
                        <field name="key" widget="CopyClipboardChar" readonly="1"/>
                        <field name="login" readonly="1"/>
                        <field name="server_url" readonly="1" widget="CopyClipboardChar"
                               string="Server (Thunderbird, Apple)"/>
                        <field name="caldav_url" readonly="1" widget="CopyClipboardChar"/>
                        <field name="carddav_url" readonly="1" widget="CopyClipboardChar"/>
                    </group>
                    <p class="text-muted">
                        In Thunderbird or on a Mac, the server address and your login are enough: the
                        app finds your calendars and address books. On Android, add a DAVx5 account
                        with "Login with URL and user name".
                    </p>
                </div>
                <footer>
                    <button name="action_generate" string="Create" type="object" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
