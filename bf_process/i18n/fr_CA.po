"Activité qui émet\n"
"un message"

#. module: bf_process
#: model:ir.model.fields.selection,name:bf_process.selection__bf_process_ecart__source__manuel
msgid "Added by hand"
msgstr "Ajouté à la main"

#. module: bf_process
