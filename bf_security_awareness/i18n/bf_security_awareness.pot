#. module: bf_security_awareness
#: model:mail.template,body_html:bf_security_awareness.mail_template_training_invite
msgid ""
"<div style=\"margin: 0; padding: 0;\">\n"
"                    <p>Hello <t t-out=\"object.partner_id.name or ''\">First name</t>,</p>\n"
"                    <p>A short cybersecurity awareness training has been assigned to you: <strong t-out=\"object.channel_id.name or ''\">Recognizing phishing</strong>.</p>\n"
"                    <p t-if=\"object.due_date\">Please complete it by\n"
"                        <strong t-out=\"format_date(object.due_date, date_format='d MMMM yyyy', lang_code=object.partner_id.lang)\">September 16, 2026</strong>.</p>\n"
"                    <p t-if=\"object.training_url\" style=\"margin: 24px 0;\">\n"
"                        <a t-att-href=\"object.training_url\" t-attf-style=\"background-color: {{ object.reminder_button_color }}; padding: 10px 18px; text-decoration: none; color: #fff; border-radius: 5px; font-weight: bold;\">\n"
"                            Go to the training\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Thank you,<t t-if=\"object.reminder_signature_name\"><br/><t t-out=\"object.reminder_signature_name\">The company</t></t></p>\n"
"                </div>"
msgstr ""

