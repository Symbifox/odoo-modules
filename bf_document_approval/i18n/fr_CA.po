#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__avis
msgid "Decision"
msgstr "Avis"

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__date_avis
msgid "Decision date"
msgstr "Date de l'avis"

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_version__approbation_attendue_count
msgid "Decisions awaited"
msgstr "Avis attendus"

#. module: bf_document_approval
#. modules: bf_appointment_poll, bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__display_name
msgid "Display Name"
msgstr "Nom d'affichage"

#. module: bf_document_approval
#: model_terms:ir.ui.view,arch_db:bf_document_approval.view_document_version_form_approbation
msgid "Distribute to informed stakeholders"
msgstr "Diffuser aux parties prenantes informées"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "Distributions for version %s"
msgstr "Distributions — version %s"

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__document_id
msgid "Document"
msgstr "Document"

#. module: bf_document_approval
#: model:ir.model,name:bf_document_approval.model_project_document_approver
msgid "Document version approver"
msgstr "Approbateur d'une version de document"

#. module: bf_document_approval
#. modules: bf_appointment_poll, bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__id
msgid "ID"
msgstr "ID"

#. module: bf_document_approval
#. modules: bf_appointment_poll, bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__write_uid
msgid "Last Updated by"
msgstr "Dernière mise à jour par"

#. module: bf_document_approval
#. modules: bf_appointment_poll, bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__write_date
msgid "Last Updated on"
msgstr "Dernière mise à jour le"

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__est_mon_avis
msgid "My decision"
msgstr "C'est mon avis"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"No one new to inform: either the matrix names no informed stakeholder, or "
"they have all already received this version."
msgstr ""
"Personne de neuf à informer : soit la matrice ne désigne aucune partie "
"prenante informée, soit elles ont toutes déjà reçu cette version."

#. module: bf_document_approval
#: model:ir.model.fields,help:bf_document_approval.field_project_document_version__approbation_complete
msgid "No required decision is missing, and none is a rejection."
msgstr "Aucun avis requis ne manque, et aucun n'est un refus."

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__sequence
msgid "Order"
msgstr "Ordre"

#. module: bf_document_approval
#: model:ir.model.fields.selection,name:bf_document_approval.selection__project_document_approver__avis__attente
msgid "Pending"
msgstr "En attente"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "Publish this version"
msgstr "Publier cette version"

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__commentaire
msgid "Reason"
msgstr "Motif"

#. module: bf_document_approval
#: model_terms:ir.ui.view,arch_db:bf_document_approval.view_document_version_form_approbation
msgid "Reject"
msgstr "Refuser"

#. module: bf_document_approval
#: model:ir.model.fields.selection,name:bf_document_approval.selection__project_document_approver__avis__refuse
msgid "Rejected"
msgstr "Refusé"

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__requis
msgid "Required"
msgstr "Requis"

#. module: bf_document_approval
#: model:ir.model.fields,help:bf_document_approval.field_project_document_approver__commentaire
msgid ""
"Required for a rejection: a rejection without a reason cannot be acted on."
msgstr "Obligatoire pour un refus : un refus sans motif ne se traite pas."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"The approvers of version %(version)s are set by %(qui)s, who is accountable "
"for the document, or by a document manager."
msgstr ""
"Le tour de table de la version %(version)s se compose par %(qui)s, qui "
"répond du document, ou par un gestionnaire des documents."

#. module: bf_document_approval
#: model:ir.model.fields,help:bf_document_approval.field_project_document_approver__user_id
msgid "The person who must decide, not the one who writes."
msgstr "La personne qui doit se prononcer, pas celle qui rédige."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"The reason belongs to the person who decides: no one else writes it for "
"them."
msgstr ""
"Le motif appartient à la personne qui se prononce : personne d'autre ne "
"l'écrit à sa place."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"These fields of an approval line cannot be written directly: %(champs)s."
msgstr ""
"Ces champs d'une ligne d'approbation ne s'écrivent pas directement : "
"%(champs)s."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "This decision belongs to %(qui)s: no one else can give it for them."
msgstr ""
"Cet avis appartient à %(qui)s : personne d'autre ne peut le donner à sa "
"place."

#. module: bf_document_approval
#: model:ir.model.constraint,message:bf_document_approval.constraint_project_document_approver_un_avis_par_personne
msgid "This person is already an approver of this version."
msgstr "Cette personne se prononce déjà sur cette version."

#. module: bf_document_approval
#: model_terms:ir.ui.view,arch_db:bf_document_approval.view_document_version_form_approbation
msgid "This version has been rejected."
msgstr "Cette version a été refusée."

#. module: bf_document_approval
#: model:ir.model.fields,help:bf_document_approval.field_project_document_version__approbateurs_modifiables
msgid ""
"True for the document's owner (failing that, its author) and document "
"managers."
msgstr ""
"Vrai pour le responsable du document (à défaut, son auteur) et les "
"gestionnaires des documents."

#. module: bf_document_approval
#: model:ir.model.fields,help:bf_document_approval.field_project_document_approver__est_mon_avis
msgid ""
"True for the named person only: only they see the Approve and Reject "
"buttons."
msgstr ""
"Vrai pour la personne nommée seulement : elle seule voit les boutons "
"Approuver et Refuser."

#. module: bf_document_approval
#: model:ir.model.fields,help:bf_document_approval.field_project_document_approver__requis
msgid "Unchecked, the decision is requested but does not block publication."
msgstr "Décoché, l'avis est sollicité mais ne bloque pas la publication."

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_approver__version_id
msgid "Version"
msgstr "Version"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"Version %(version)s distributed to %(n)s informed stakeholder(s): %(qui)s."
msgstr ""
"Version %(version)s diffusée à %(n)s partie(s) prenante(s) informée(s) : "
"%(qui)s."

#. module: bf_document_approval
#: model:ir.model.fields,field_description:bf_document_approval.field_project_document_version__approbation_refusee
msgid "Version rejected"
msgstr "Refusée"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "approved"
msgstr "approuvé"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "its owner"
msgstr "son responsable"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "no reason given"
msgstr "sans motif"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "rejected"
msgstr "refusé"

#. module: bf_document_approval
#: model_terms:ir.ui.view,arch_db:bf_document_approval.view_document_version_form_approbation
msgid ""
"required decision(s) missing: this version can be neither approved nor "
"published."
msgstr ""
"avis requis manquent : cette version ne peut être ni\n"
"                            approuvée ni publiée."
