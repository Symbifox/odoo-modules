#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit_window.py:0
msgid ""
"\"%(adresse)s\" is occupied by a tenant: the law holds showings between 9 "
"a.m. and 9 p.m. (art. 1931 of the Civil Code). Window %(plage)s goes beyond "
"that."
msgstr ""
"« %(adresse)s » est occupée par un locataire : la loi borne les visites à 9 "
"h et 21 h (art. 1931 du Code civil). La plage %(plage)s déborde."

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit.py:0
msgid ""
"\"%s\" has already arrived: what has been recorded is not rewritten. A "
"manager can correct a typing mistake, and the correction stays on the "
"record."
msgstr ""
"« %s » est déjà arrivée : ce qui a été constaté ne se réécrit pas. Un "
"gestionnaire peut corriger une erreur de saisie, et la correction reste au "
"dossier."

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit.py:0
msgid "\"%s\" has arrived: it cannot be marked as a no-show."
msgstr "« %s » est arrivée : elle ne peut pas être absente."

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit_listing.py:0
msgid ""
"\"%s\" has no authorised broker. With nobody to open the door, no slot "
"exists."
msgstr ""
"« %s » n'a aucun courtier autorisé. Sans personne pour ouvrir la porte, "
"aucun créneau n'existe."

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit.py:0
msgid "\"%s\" is no longer waiting."
msgstr "« %s » n'est plus en attente."

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit.py:0
msgid "\"%s\" is not waiting for a decision."
msgstr "« %s » n'est pas en attente d'une décision."

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit_listing.py:0
msgid ""
"\"%s\" is occupied by a tenant: you have to say WHO, otherwise the 24 hours'"
" notice the law requires goes nowhere."
msgstr ""
"« %s » est occupée par un locataire : il faut dire QUI, sinon l'avis de 24 "
"heures que la loi exige ne part nulle part."

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit_listing.py:0
msgid ""
"\"%s\" offers no window. The seller has to say when they agree to have it "
"shown."
msgstr ""
"« %s » n'offre aucune plage. Le vendeur doit dire quand il accepte de faire "
"visiter."

#. module: bf_appointment_visit
#: model:ir.model.fields,help:bf_appointment_visit.field_bf_visit_listing__occupancy
msgid ""
"\"Occupied by a tenant\" imposes the 24 hours' notice and the 9 a.m. to 9 "
"p.m. hours of article 1931 of the Civil Code."
msgstr ""
"« Occupée par un locataire » impose le préavis de 24 heures et les heures de"
" 9 h à 21 h de l'article 1931 du Code civil."

#. module: bf_appointment_visit
#: model:ir.model.fields,field_description:bf_appointment_visit.field_bf_visit_listing__resource_id
msgid "\"Property\" resource"
msgstr "Ressource « propriété »"

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit_window.py:0
msgid "%s %s to %s"
msgstr "%s %s à %s"

#. module: bf_appointment_visit
#. odoo-python
#: code:addons/bf_appointment_visit/models/bf_visit_listing.py:0
msgid "- %s, on %s"
msgstr "- %s, le %s"

#. module: bf_appointment_visit
#: model_terms:ir.ui.view,arch_db:bf_appointment_visit.view_bf_visit_listing_form
msgid "123, rue Principale, Sherbrooke"
