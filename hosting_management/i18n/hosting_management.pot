"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('services_count', '-')\"/>\n"
"                                </p>\n"
"                              </td>\n"
"                              <td width=\"4%\">&amp;nbsp;</td>\n"
"                              <!-- Disponibilit&#233; -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#ECFDF5;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#047857;text-transform:uppercase;letter-spacing:0.5px;\">\n"
