<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_attach_form" model="ir.ui.view">
        <field name="name">bf.membership.attach.form</field>
        <field name="model">bf.membership.attach</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    La demande passe au contact existant. Une facture impayée émise au contact du
                    formulaire est annulée ; le contact du formulaire n'a plus d'adhésion et peut être
                    supprimé (ou archivé, si une facture le porte encore). Ne fusionnez pas les deux
                    contacts : la facture passerait au nom de l'autre contact.
                </p>
                <group>
                    <field name="membership_id"/>
                    <field name="form_partner_id"/>
                    <field name="partner_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Rattacher" class="btn-primary"/>
                    <button special="cancel" string="Fermer"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
