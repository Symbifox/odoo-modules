<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <!-- Systray envelope button -->
    <t t-name="bf_webmail.Systray">
        <button class="btn d-flex align-items-center position-relative bf-webmail-systray"
                t-on-click="onOpenWebmail"
                title="Courriel">
            <i class="fa fa-envelope-o"/>
            <span t-if="hasUnread"
                  class="bf-webmail-badge badge rounded-pill">
                <t t-esc="unreadLabel"/>
            </span>
        </button>
    </t>

    <!-- Webmail dialog with iframe -->
    <t t-name="bf_webmail.WebmailDialog">
        <Dialog title="'Courriel'" size="'xl'">
            <div class="bf-webmail-body">
                <iframe t-att-src="props.url"
                        class="bf-webmail-frame"
                        allow="clipboard-read; clipboard-write"/>
            </div>
        </Dialog>
    </t>

</templates>
