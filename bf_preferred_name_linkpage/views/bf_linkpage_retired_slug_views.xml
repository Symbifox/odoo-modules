<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lever une réservation (une faute de frappe corrigée, par exemple) : les
         administrateurs seulement. L'adresse n'est jamais montrée, elle n'est
         gardée qu'en empreinte. -->
    <record id="view_bf_linkpage_retired_slug_list" model="ir.ui.view">
        <field name="name">bf.linkpage.retired.slug.list</field>
        <field name="model">bf.linkpage.retired.slug</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date" string="Retired on"/>
                <field name="partner_id"/>
                <field name="page_id"/>
            </list>
        </field>
    </record>

    <record id="action_bf_linkpage_retired_slug" model="ir.actions.act_window">
        <field name="name">Retired link page addresses</field>
        <field name="res_model">bf.linkpage.retired.slug</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Addresses that a link page left. No other person's page can take
            them, so that printed links and QR codes never lead to someone
            else. Delete a line to free its address.</p>
        </field>
    </record>

    <menuitem id="menu_bf_linkpage_retired_slug"
              name="Retired link page addresses"
              parent="base.menu_custom"
              action="action_bf_linkpage_retired_slug"
              groups="base.group_system"
              sequence="90"/>

</odoo>
