<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Les trois données de l'art. 5 al. 2 du règlement, qui décident de
         l'intervalle de révision du carnet. Deux se saisissent, une se
         calcule. -->
    <record id="view_building_form_loi16" model="ir.ui.view">
        <field name="name">bf.property.building.form.loi16</field>
        <field name="model">bf.property.building</field>
        <field name="inherit_id" ref="bf_property_core.view_property_building_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[last()]" position="after">
                <group string="Carnet d'entretien : conditions de taille">
                    <group>
                        <field name="private_unit_count"/>
                        <field name="floors_above_ground"/>
                    </group>
                    <group>
                        <field name="common_areas_in_building"/>
                    </group>
                    <div class="alert alert-info" role="alert" colspan="2">
                        Art. 5 al. 2 du Règlement établissant diverses règles en matière
                        de copropriété divise : la révision du carnet passe de 5 à 10 ans
                        si l'immeuble remplit l'UNE de ces trois conditions. Le décompte
                        des parties privatives exclut les accessoires, rangements et
                        stationnements compris.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
