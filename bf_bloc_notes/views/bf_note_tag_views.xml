<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_note_tag_view_list" model="ir.ui.view">
        <field name="name">bf.note.tag.list</field>
        <field name="model">bf.note.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="bf_note_tag_action" model="ir.actions.act_window">
        <field name="name">Étiquettes</field>
        <field name="res_model">bf.note.tag</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
