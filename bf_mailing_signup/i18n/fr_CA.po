#. module: bf_mailing_signup
#: model:ir.model.fields,help:bf_mailing_signup.field_bf_mailing_signup_step__rank
msgid "1 for the first email, 2 for the second, and so on."
msgstr "1 pour le premier courriel, 2 pour le deuxième, et ainsi de suite."

#. module: bf_mailing_signup
#: model:ir.model.constraint,message:bf_mailing_signup.constraint_bf_mailing_signup_step_rang_unique
