<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_subscription_link_wizard_form" model="ir.ui.view">
        <field name="name">bf.budget.subscription.link.wizard.form</field>
        <field name="model">bf.budget.subscription.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link subscriptions to budget items">
                <p class="text-muted">
                    The budget item is inferred from the expense account that carries most of each subscription's bills. Ambiguous cases are not settled at random: they are listed and left to be done by hand.
                </p>
                <group>
                    <field name="only_unassigned"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <field name="preview" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_apply" string="Link" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bf_budget_subscription_link_wizard_action" model="ir.actions.act_window">
        <field name="name">Link subscriptions</field>
        <field name="res_model">bf.budget.subscription.link.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bf_budget_subscription_link"
              name="Link subscriptions"
              parent="bf_budget.menu_bf_budget_config"
              action="bf_budget_subscription_link_wizard_action"
              sequence="30"/>
</odoo>
