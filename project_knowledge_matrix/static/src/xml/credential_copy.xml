<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="project_knowledge_matrix.CopyablePasswordField">
        <div class="d-flex align-items-center gap-2 w-100">
            <t t-if="props.readonly">
                <span class="o_field_char text-muted">
                    <t t-esc="displayValue"/>
                </span>
            </t>
            <t t-else="">
                <input
                    class="o_input flex-grow-1"
                    type="password"
                    t-att-value="props.record.data[props.name] || ''"
                    t-att-placeholder="props.placeholder || 'Enter password...'"
                    t-on-change="onInputChange"
                />
            </t>
            <button
                t-if="hasValue"
                type="button"
                class="btn btn-secondary btn-sm"
                t-on-click="copyToClipboard"
                title="Copy to clipboard"
            >
                <i class="fa fa-clipboard"/>
            </button>
        </div>
    </t>

</templates>
