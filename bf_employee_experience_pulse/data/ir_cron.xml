<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
          Livré ALLUMÉ : il ne détruit rien, il déplace des lignes du sas vers
          le registre et recalcule des moyennes. Éteint, le sas se remplit et
          aucun score ne bouge, ce qui se lit comme une panne silencieuse.
        -->
        <record id="cron_pulse_flush" model="ir.cron">
            <field name="name">Pulse : verser le sas et recalculer les scores</field>
            <field name="model_id" ref="model_bf_ex_pulse_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_flush_and_score()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
