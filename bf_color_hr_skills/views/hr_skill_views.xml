<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Skill types: a free color; the skills keep copying the closest index. -->
    <record id="hr_skill_type_list_bf_color" model="ir.ui.view">
        <field name="name">hr.skill.type.list.bf_color</field>
        <field name="model">hr.skill.type</field>
        <field name="inherit_id" ref="hr_skills.hr_skill_type_view_tree"/>
        <field name="arch" type="xml">
            <field name="color" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="color" position="after">
                <field name="color_hex" widget="bf_color" optional="show"/>
            </field>
        </field>
    </record>

    <record id="hr_skill_type_form_bf_color" model="ir.ui.view">
        <field name="name">hr.skill.type.form.bf_color</field>
        <field name="model">hr.skill.type</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_skill_type_view_form"/>
        <field name="arch" type="xml">
            <field name="color" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="color" position="after">
                <field name="color_hex" widget="bf_color"/>
                <field name="color_resolved" widget="bf_color_resolved" invisible="not id"/>
            </field>
        </field>
    </record>
</odoo>
