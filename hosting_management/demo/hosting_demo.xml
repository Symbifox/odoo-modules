            <field name="docker_image">onlyoffice/documentserver:latest</field>
            <field name="notes">&lt;p&gt;Online document editing suite compatible with MS Office.&lt;/p&gt;</field>
        </record>

        <!-- Docuseal -->
        <record id="software_docuseal" model="hosting.software">
            <field name="name">Docuseal</field>
            <field name="code">DS</field>
            <field name="software_type">self_hosted</field>
            <field name="latest_version">1.8.2</field>
            <field name="latest_version_date">2024-12-15</field>
