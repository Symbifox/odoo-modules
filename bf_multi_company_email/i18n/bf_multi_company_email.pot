"    <!-- Filet : repli en couleur unie, plus 1 px de line-height/font-size.\n"
"         Pourquoi : commentaire du record, au-dessus de ce gabarit. -->\n"
"    <div t-attf-style=\"height: 1px; line-height: 1px; font-size: 1px; background-color: {{ sig['accent'] }}; background-image: linear-gradient(to right, {{ sig['accent'] }}, {{ sig['text_color'] }}); border: 0;\"><br/></div>\n"
"  </td>\n"
"</tr>\n"
"\n"
"\n"
"<tr t-if=\"sig['links']\" style=\"border-radius:0px;border-style:none;padding:0px;margin:0px;box-sizing:border-box;border-left-color:#808080;border-bottom-color:#808080;border-right-color:#808080;border-top-color:#808080;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;\">\n"
"  <td colspan=\"3\" t-attf-style=\"border-radius:0px;border-style:none;padding:10px 0 0 0;margin:0px;box-sizing:border-box;border-left-color:#808080;border-bottom-color:#808080;border-right-color:#808080;border-top-color:#808080;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;padding-top: 10px; color: {{ sig['text_color'] }};\">\n"
"    <!-- Boutons : un lien = une cellule &#224; fond, libell&#233; blanc de 9 pt gras.\n"
"         Pourquoi, et ce que l'assainissement emporte : commentaire du record. -->\n"
"    <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" t-attf-style=\"border-collapse: collapse; font-family: {{ sig['font'] }};\">\n"
"      <tbody><tr>\n"
"        <t t-foreach=\"sig['links']\" t-as=\"link\">\n"
"        <td style=\"padding: 0 8px 0 0;\">\n"
"          <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse: collapse;\">\n"
"            <tbody><tr>\n"
"              <td t-att-bgcolor=\"sig['text_color']\" align=\"center\" t-attf-style=\"background-color: {{ sig['text_color'] }}; padding: 8px 12px; mso-line-height-rule: exactly; line-height: 1;\">\n"
"                <a t-att-href=\"link['url']\" t-attf-style=\"font-family: {{ sig['font'] }}; font-size: 9pt; font-weight: 700; line-height: 1; color: #FFFFFF; text-decoration: none;\"><font style=\"color: #FFFFFF;\"><t t-out=\"link['label']\"/></font></a>\n"
"              </td>\n"
"            </tr></tbody>\n"
"          </table>\n"
"        </td>\n"
"        </t>\n"
"      </tr></tbody>\n"
"    </table>\n"
"  </td>\n"
"</tr>\n"
"\n"
"\n"
"<tr t-if=\"sig['tagline']\" style=\"border-radius:0px;border-style:none;padding:0px;margin:0px;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;\">\n"
