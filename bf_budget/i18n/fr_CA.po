msgstr ""
"Comptes couverts par plus d'un poste de ce budget : leurs écritures sont "
"comptées autant de fois."

#. module: bf_budget
#: model_terms:ir.ui.view,arch_db:bf_budget.bf_budget_view_form
msgid ""
"Accounts covered by more than one budget item: their entries are counted "
"several times."
msgstr ""
"Comptes couverts par plus d'un poste : leurs écritures sont comptées "
"plusieurs fois."

