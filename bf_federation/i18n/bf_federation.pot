#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/federation_peer.py:0
msgid ""
"<p>%(nous)s invites you to federate your Symbifox with theirs: objects "
"shared on one side appear on the other, without anyone needing an account on"
" the other side.</p><p>In your Symbifox, <i>Federation › Accept an "
"invitation</i>:</p><ul><li>Address: <code>%(url)s</code></li><li>Code: "
"<code>%(code)s</code></li></ul><p>The code works once and expires on "
"%(fin)s.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/project_task.py:0
msgid ""
"<p>%(pair)s addressed this task to %(qui)s (%(courriel)s), who is not in "
"this peer's matched people, and the fallback person is no longer an active "
"internal account: the task is assigned to no one.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/project_task.py:0
msgid ""
"<p>%(pair)s addressed this task to %(qui)s (%(courriel)s), who is not in "
"this peer's matched people: it is left with %(repli)s. Add the matching row "
"on the peer's record so the next one lands in the right place.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/project_task.py:0
msgid ""
"<p>%(pair)s addressed this task to %(qui)s (%(courriel)s). This email is "
"matched, but the row gives no usable account here (portal account, several "
"accounts, or a designated account that became invalid): it is left with "
"%(repli)s. Designate an account on the matching row.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/project_task.py:0
msgid ""
"<p>%(pair)s addressed this task to %(qui)s; it is assigned to "
"%(compte)s.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/project_task.py:0
msgid ""
"<p><i>Task shared by %s. The state, the deadline day, the messages and the "
"attachments travel back to them; a message or a note starting with 🔒 stays "
"here.</i></p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/federation_link.py:0
msgid ""
"<p>On %(pair)s's side, %(objet)s is now addressed to %(qui)s. The mirror is "
"not reassigned: that is yours to decide.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/federation_link.py:0
msgid ""
"<p>On %s's side, %s is back in the sharing; the mirror is reactivated.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/federation_link.py:0
msgid ""
"<p>On %s's side, %s is no longer part of the sharing (%s); the mirror is "
"archived.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/project_task.py:0
msgid "<p>On %s's side, the deadline was moved to %s.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/federation_link.py:0
msgid ""
"<p>On %s's side, the mirror of %s is gone (%s): nothing more will reach it "
"until the sharing is done again.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/project_task.py:0
msgid "<p>On %s's side, the task moved to \"%s\"%s.</p>"
msgstr ""

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/federation_peer.py:0
msgid ""
"<p>Tasks that %s shares with us through federation. The state, the deadline "
"day, the messages and the attachments travel back to them; a message or a "
"note starting with 🔒 stays here.</p>"
msgstr ""

