<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_plate_cost" model="mail.activity.type">
        <field name="name">Plate cost</field>
        <field name="summary">Plate cost over target</field>
        <field name="res_model">product.template</field>
        <field name="icon">fa-cutlery</field>
        <field name="delay_count">2</field>
    </record>

    <record id="ir_cron_kitchen_cost_refresh" model="ir.cron">
        <field name="name">Kitchen: refresh plate costs from the vendor bills</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">model._cron_bf_kitchen_refresh_all()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=7, minute=10, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
