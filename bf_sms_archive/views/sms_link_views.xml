<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sms_link_view_list" model="ir.ui.view">
        <field name="name">sms.archive.link.list</field>
        <field name="model">sms.archive.link</field>
        <field name="arch" type="xml">
            <list string="Links" create="false"
                  default_order="create_date desc">
                <field name="res_name" string="Record"/>
                <field name="res_model_label" string="Record type"/>
                <field name="thread_id" string="Conversation"/>
                <field name="message_id" string="Message" optional="show"/>
                <field name="call_id" string="Call" optional="hide"/>
                <field name="create_date" string="Linked on"/>
                <field name="is_auto" string="Auto follow-up" widget="boolean_toggle"
                       readonly="1"/>
                <field name="user_id" string="Linked by" optional="hide"/>
                <field name="owner_id" string="Owner" optional="hide"/>
                <button name="action_open_target" type="object"
                        icon="fa-external-link" title="Open the record"/>
                <button name="action_undo" type="object" icon="fa-chain-broken"
                        title="Undo"
                        confirm="Remove this link? The chatter note goes with it if no message points to it anymore."/>
            </list>
        </field>
    </record>

    <record id="sms_link_view_search" model="ir.ui.view">
        <field name="name">sms.archive.link.search</field>
        <field name="model">sms.archive.link</field>
        <field name="arch" type="xml">
            <search string="Links">
                <field name="res_name" string="Record"/>
                <field name="thread_id" string="Conversation"/>
                <field name="res_model" string="Model"/>
                <filter name="manual" string="Posted by hand"
                        domain="[('is_auto', '=', False)]"/>
                <filter name="auto" string="Automatic follow-up"
                        domain="[('is_auto', '=', True)]"/>
                <separator/>
                <filter name="messages" string="SMS"
                        domain="[('message_id', '!=', False)]"/>
                <filter name="calls" string="Calls"
                        domain="[('call_id', '!=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_model" string="Record type"
                            context="{'group_by': 'res_model'}"/>
                    <filter name="group_thread" string="Conversation"
                            context="{'group_by': 'thread_id'}"/>
                    <filter name="group_owner" string="Owner"
                            context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sms_links" model="ir.actions.act_window">
        <field name="name">Links</field>
        <field name="res_model">sms.archive.link</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="sms_link_view_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No links</p>
            <p>
                A link is created by posting an SMS or a call to the
                chatter of a record, from Messaging or from the list
                of messages. The same message can target several records.
            </p>
        </field>
    </record>

</odoo>
