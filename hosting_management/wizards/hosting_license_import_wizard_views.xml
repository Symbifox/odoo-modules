<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hosting_license_import_wizard_view_form" model="ir.ui.view">
        <field name="name">hosting.license.import.wizard.form</field>
        <field name="model">hosting.license.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer un pool de licences">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Le fichier doit avoir 5 colonnes dans cet ordre :
                        <strong>Date d'achat | Clé de produit | Activé le | Client | Notes</strong>.
                        Une ligne d'en-tête est attendue. Chaque ligne devient un siège.
                    </div>
                    <group>
                        <group string="Fichier">
                            <field name="attachment" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group string="Métadonnées du pool">
                            <field name="name" placeholder="Ex. Windows 11 Pro – batch 2025-09"/>
                            <field name="software_id"/>
                            <field name="product_name" placeholder="Si hors catalogue"/>
                            <field name="vendor"/>
                            <field name="license_type"/>
                            <field name="owner_partner_id"
                                   options="{'no_create': True}"/>
                            <field name="purchase_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object"
                            string="Importer" class="btn-primary"/>
                    <button special="cancel" string="Annuler" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hosting_license_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Importer un pool de licences</field>
        <field name="res_model">hosting.license.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
