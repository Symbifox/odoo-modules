#. module: bf_school_work
#: model:mail.template,body_html:bf_school_work.mail_template_work_returned
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The work <strong t-out=\"object.homework_id.name or ''\"/> of <strong t-out=\"object.student_id.name or ''\"/> was returned by the teacher.</p>\n"
"    <p t-if=\"object.points_total\" style=\"margin:0 0 12px 0;\">Mark: <strong t-out=\"'%g / %g' % (object.grade, object.points_total)\"/></p>\n"
"    <p style=\"margin:0 0 12px 0;\">The comment and the corrected copy, if any, are on the portal.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/work/{{ object.homework_id.id }}/{{ object.student_id.id }}\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            See the returned work\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;color:#6c757d;font-size:13px;\">You receive this email because you chose it on the portal (Work to hand in). Untick it there to stop.</p>\n"
"</div>\n"
"            "
msgstr "<div>\n    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n    <p style=\"margin:0 0 12px 0;\">Le travail <strong t-out=\"object.homework_id.name or ''\"/> de <strong t-out=\"object.student_id.name or ''\"/> a été retourné.</p>\n    <p t-if=\"object.points_total\" style=\"margin:0 0 12px 0;\">Note : <strong t-out=\"'%g / %g' % (object.grade, object.points_total)\"/></p>\n    <p style=\"margin:0 0 12px 0;\">Le commentaire et la copie corrigée, s'il y en a, sont au portail.</p>\n    <p style=\"margin:24px 0;\">\n        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/work/{{ object.homework_id.id }}/{{ object.student_id.id }}\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n            Voir le travail retourné\n        </a>\n    </p>\n    <p style=\"margin:0;color:#6c757d;font-size:13px;\">Vous recevez ce courriel parce que vous l'avez choisi au portail (Travaux à remettre). Décochez-le pour ne plus le recevoir.</p>\n</div>\n            "

#. module: bf_school_work
#: model:mail.template,body_html:bf_school_work.mail_template_work_digest
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 16px 0;\">Here is what changed in the school work since the last summary.</p>\n"
"    <t t-foreach=\"ctx.get('school_digest') or []\" t-as=\"pair\">\n"
"        <t t-set=\"student\" t-value=\"pair[0]\"/>\n"
"        <t t-set=\"parts\" t-value=\"pair[1]\"/>\n"
"        <h3 style=\"margin:16px 0 8px 0;font-size:16px;\" t-out=\"student.name or ''\"/>\n"
"        <t t-if=\"parts['returned']\">\n"
"            <p style=\"margin:0 0 4px 0;font-weight:600;\">Work returned</p>\n"
"            <ul style=\"margin:0 0 12px 0;\">\n"
"                <li t-foreach=\"parts['returned']\" t-as=\"submission\">\n"
"                    <t t-out=\"submission.homework_id.name or ''\"/>\n"
"                    <t t-if=\"submission.points_total\">: <t t-out=\"'%g / %g' % (submission.grade, submission.points_total)\"/></t>\n"
"                </li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"parts['due']\">\n"
"            <p style=\"margin:0 0 4px 0;font-weight:600;\">To hand in soon</p>\n"
"            <ul style=\"margin:0 0 12px 0;\">\n"
"                <li t-foreach=\"parts['due']\" t-as=\"homework\">\n"
"                    <t t-out=\"homework.name or ''\"/>, <t t-out=\"format_date(homework.date_due) or ''\"/>\n"
"                </li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"parts['late']\">\n"
"            <p style=\"margin:0 0 4px 0;font-weight:600;\">Not handed in, due date passed</p>\n"
"            <ul style=\"margin:0 0 12px 0;\">\n"
"                <li t-foreach=\"parts['late']\" t-as=\"homework\">\n"
"                    <t t-out=\"homework.name or ''\"/>, <t t-out=\"format_date(homework.date_due) or ''\"/>\n"
"                </li>\n"
"            </ul>\n"
"        </t>\n"
"        <t t-if=\"parts['contents']\">\n"
"            <p style=\"margin:0 0 4px 0;font-weight:600;\">New course contents</p>\n"
"            <ul style=\"margin:0 0 12px 0;\">\n"
"                <li t-foreach=\"parts['contents']\" t-as=\"content\">\n"
"                    <t t-out=\"content.name or ''\"/> (<t t-out=\"content.channel_id.name or ''\"/>)\n"
"                </li>\n"
"            </ul>\n"
"        </t>\n"
"    </t>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/work\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            See the work on the portal\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;color:#6c757d;font-size:13px;\">You receive this summary because you chose it on the portal (Work to hand in). Untick it there to stop.</p>\n"
"</div>\n"
"            "
msgstr "<div>\n    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n    <p style=\"margin:0 0 16px 0;\">Voici ce qui a changé dans les travaux scolaires depuis le dernier résumé.</p>\n    <t t-foreach=\"ctx.get('school_digest') or []\" t-as=\"pair\">\n        <t t-set=\"student\" t-value=\"pair[0]\"/>\n        <t t-set=\"parts\" t-value=\"pair[1]\"/>\n        <h3 style=\"margin:16px 0 8px 0;font-size:16px;\" t-out=\"student.name or ''\"/>\n        <t t-if=\"parts['returned']\">\n            <p style=\"margin:0 0 4px 0;font-weight:600;\">Travaux retournés</p>\n            <ul style=\"margin:0 0 12px 0;\">\n                <li t-foreach=\"parts['returned']\" t-as=\"submission\">\n                    <t t-out=\"submission.homework_id.name or ''\"/>\n                    <t t-if=\"submission.points_total\">: <t t-out=\"'%g / %g' % (submission.grade, submission.points_total)\"/></t>\n                </li>\n            </ul>\n        </t>\n        <t t-if=\"parts['due']\">\n            <p style=\"margin:0 0 4px 0;font-weight:600;\">À remettre bientôt</p>\n            <ul style=\"margin:0 0 12px 0;\">\n                <li t-foreach=\"parts['due']\" t-as=\"homework\">\n                    <t t-out=\"homework.name or ''\"/>, <t t-out=\"format_date(homework.date_due) or ''\"/>\n                </li>\n            </ul>\n        </t>\n        <t t-if=\"parts['late']\">\n            <p style=\"margin:0 0 4px 0;font-weight:600;\">Non remis, date de remise passée</p>\n            <ul style=\"margin:0 0 12px 0;\">\n                <li t-foreach=\"parts['late']\" t-as=\"homework\">\n                    <t t-out=\"homework.name or ''\"/>, <t t-out=\"format_date(homework.date_due) or ''\"/>\n                </li>\n            </ul>\n        </t>\n        <t t-if=\"parts['contents']\">\n            <p style=\"margin:0 0 4px 0;font-weight:600;\">Nouveaux contenus de cours</p>\n            <ul style=\"margin:0 0 12px 0;\">\n                <li t-foreach=\"parts['contents']\" t-as=\"content\">\n                    <t t-out=\"content.name or ''\"/> (<t t-out=\"content.channel_id.name or ''\"/>)\n                </li>\n            </ul>\n        </t>\n    </t>\n    <p style=\"margin:24px 0;\">\n        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/work\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n            Voir les travaux au portail\n        </a>\n    </p>\n    <p style=\"margin:0;color:#6c757d;font-size:13px;\">Vous recevez ce résumé parce que vous l'avez choisi au portail (Travaux à remettre). Décochez-le pour ne plus le recevoir.</p>\n</div>\n            "

