<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_classification_scheme_list" model="ir.ui.view">
        <field name="name">project.document.classification.scheme.list</field>
        <field name="model">project.document.classification.scheme</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
                <field name="classification_count"/>
            </list>
        </field>
    </record>

    <record id="view_classification_scheme_form" model="ir.ui.view">
        <field name="name">project.document.classification.scheme.form</field>
        <field name="model">project.document.classification.scheme</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Processes"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this plan is for, and who maintains it"/>
                    <field name="classification_ids" context="{'default_scheme_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="parent_id" domain="[('scheme_id', '=', parent.id)]"/>
                            <field name="document_count"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_classification_scheme" model="ir.actions.act_window">
        <field name="name">Classification plans</field>
        <field name="res_model">project.document.classification.scheme</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_classification_list" model="ir.ui.view">
        <field name="name">project.document.classification.list</field>
        <field name="model">project.document.classification</field>
        <field name="arch" type="xml">
            <list>
                <field name="scheme_id"/>
                <field name="complete_name"/>
                <field name="document_count"/>
            </list>
        </field>
    </record>

    <record id="view_classification_form" model="ir.ui.view">
        <field name="name">project.document.classification.form</field>
        <field name="model">project.document.classification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="scheme_id"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="document_ids" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="type_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_classification_search" model="ir.ui.view">
        <field name="name">project.document.classification.search</field>
        <field name="model">project.document.classification</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name"/>
                <field name="scheme_id"/>
                <filter name="groupby_scheme" string="Plan" context="{'group_by': 'scheme_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_classification" model="ir.actions.act_window">
        <field name="name">Classifications</field>
        <field name="res_model">project.document.classification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_groupby_scheme': 1}</field>
    </record>
</odoo>
