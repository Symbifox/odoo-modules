<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_floorplan_lien_view_list" model="ir.ui.view">
        <field name="name">bf.floorplan.lien.list</field>
        <field name="model">bf.floorplan.lien</field>
        <field name="arch" type="xml">
            <list string="Liens" editable="bottom">
                <field name="plan_id"/>
                <field name="src_id"/>
                <field name="dst_id"/>
                <field name="genre"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="bf_floorplan_lien_view_form" model="ir.ui.view">
        <field name="name">bf.floorplan.lien.form</field>
        <field name="model">bf.floorplan.lien</field>
        <field name="arch" type="xml">
            <form string="Lien">
                <sheet>
                    <group>
                        <field name="plan_id"/>
                        <field name="src_id" domain="[('plan_id', '=', plan_id)]"/>
                        <field name="dst_id" domain="[('plan_id', '=', plan_id)]"/>
                        <field name="genre"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_floorplan_lien" model="ir.actions.act_window">
        <field name="name">Liens</field>
        <field name="res_model">bf.floorplan.lien</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
