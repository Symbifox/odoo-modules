                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="height:4px;line-height:4px;background-color:#F59E0B"> </td>
                        </tr>
                        <tr>
                            <td style="padding:24px">
                                <h1 t-attf-style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:24px;line-height:32px;color:{{ brand_dark }};margin:0 0 8px 0;font-weight:500">
                                    Rappel d'accusé de réception
                                </h1>
                                <p style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:17px;line-height:26px;color:#374151;margin:0 0 16px 0;font-weight:300">
                                    Bonjour,<br/><br/>
                                    Nous vous avons transmis une documentation pour laquelle nous n'avons pas encore reçu d'accusé de réception.
                                </p>
                                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border:1px solid #FDE68A;border-radius:10px;background-color:#FFFBEB;margin-bottom:16px">
                                    <tbody>
                                        <tr>
                                            <td style="padding:16px">
                                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#92400E;width:140px;padding-bottom:8px" width="140">Document</td>
                                                            <td style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#78350F;padding-bottom:8px"><strong><t t-out="object.document_name"/></strong></td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#92400E">Version</td>
                                                            <td style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#78350F"><strong><t t-out="object.version_number"/></strong></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;line-height:22px;color:#374151;margin:0 0 16px 0">
                                    Veuillez confirmer que vous avez bien reçu et pris connaissance de cette documentation en répondant à ce courriel.
                                </p>
                                <p style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:13px;line-height:20px;color:#6B7280;margin:16px 0 0 0">
                                    Pour toute question, contactez-nous à
                                    <a href="mailto:service@example.com" t-attf-style="color:{{ brand_primary }};text-decoration:none">service@example.com</a>.
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td style="height:1px;line-height:1px;background-color:#E5E7EB"> </td>
                        </tr>
                        <tr>
                            <td style="padding:16px 24px 24px 24px;background-color:#F9FAFB;border-radius:0 0 12px 12px">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tbody>
                                        <tr>
                                            <td style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#6B7280">
                                                <strong t-attf-style="color:{{ brand_dark }}"><t t-out="(company and company.name) or \'Blue Fox\'"/></strong><br/>
                                                Solutions éthiques et souveraines pour vos données.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="margin:12px auto 0">
                    <tbody>
                        <tr>
                            <td t-attf-style="height:3px;line-height:3px;background-color:{{ brand_primary }};width:50%;border-radius:2px 0 0 2px"> </td>
                            <td t-attf-style="height:3px;line-height:3px;background-color:{{ brand_dark }};width:50%;border-radius:0 2px 2px 0"> </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

