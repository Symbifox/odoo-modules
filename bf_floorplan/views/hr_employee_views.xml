<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_floorplan" model="ir.ui.view">
        <field name="name">hr.employee.form.floorplan</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_voir_sur_le_plan" type="object"
                        class="oe_stat_button" icon="fa-map-marker"
                        invisible="floorplan_element_count == 0">
                    <field name="floorplan_element_count" widget="statinfo" string="Sur le plan"/>
                </button>
            </div>
        </field>
    </record>
    <record id="view_employee_public_form_floorplan" model="ir.ui.view">
        <field name="name">hr.employee.public.form.floorplan</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_voir_sur_le_plan" type="object"
                        class="oe_stat_button" icon="fa-map-marker"
                        invisible="floorplan_element_count == 0">
                    <field name="floorplan_element_count" widget="statinfo" string="Sur le plan"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
