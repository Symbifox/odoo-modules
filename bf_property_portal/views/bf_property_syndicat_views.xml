<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_property_syndicat_form_portal" model="ir.ui.view">
            <field name="name">bf.property.syndicat.form.portal</field>
            <field name="model">bf.property.syndicat</field>
            <field name="inherit_id" ref="bf_property_core.view_property_syndicat_form"/>
            <field name="arch" type="xml">
                <!-- Le formulaire du socle porte déjà un carnet : on ajoute une
                     page dedans plutôt qu'un second carnet sous le premier. -->
                <xpath expr="//notebook" position="inside">
                    <page string="Portail" name="portal">
                            <div class="alert alert-info" role="note">
                                Ce que le portail affiche pour joindre le syndicat.
                                Aucun annuaire des copropriétaires n'est publié :
                                l'article 1070 du Code civil ne met au registre les
                                renseignements personnels autres que le nom et
                                l'adresse qu'avec le consentement exprès de la
                                personne visée.
                            </div>
                            <group>
                                <group>
                                    <field name="portal_contact_name"/>
                                    <field name="portal_contact_email" widget="email"/>
                                    <field name="portal_contact_phone" widget="phone"/>
                                </group>
                                <group>
                                    <field name="announcement_count"/>
                                    <field name="portal_document_count"/>
                                </group>
                            </group>
                        <field name="portal_contact_note"
                               placeholder="Heures de disponibilité, urgences, modalités de consultation du registre prévues au règlement de l'immeuble."/>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
