        <!-- ============================================================ -->
        <!-- eLearning course: real cybersecurity content                 -->
        <!-- ============================================================ -->
        <record id="demo_channel" model="slide.channel">
            <field name="name">Sensibilisation à la cybersécurité — Les fondamentaux</field>
            <field name="description">Reconnaître l'hameçonnage, protéger ses accès et savoir réagir. Parcours court de sensibilisation pour tout le personnel.</field>
            <field name="channel_type">training</field>
            <field name="enroll">invite</field>
            <field name="visibility">connected</field>
            <field name="is_published" eval="True"/>
        </record>

        <record id="demo_slide_intro" model="slide.slide">
            <field name="name">1. Pourquoi la cybersécurité vous concerne</field>
            <field name="channel_id" ref="demo_channel"/>
            <field name="slide_category">article</field>
            <field name="sequence">1</field>
            <field name="is_published" eval="True"/>
            <field name="html_content" type="html">
                <h2>La sécurité, c'est l'affaire de tous</h2>
                <p>La grande majorité des incidents de sécurité commencent par un geste
                   humain : un clic sur un mauvais lien, un mot de passe réutilisé, une
                   pièce jointe ouverte trop vite. La bonne nouvelle : ces gestes
                   s'apprennent et se corrigent.</p>
                <p>Ce parcours prend une dizaine de minutes. À la fin, vous saurez :</p>
                <ul>
                    <li>repérer un courriel d'hameçonnage avant de cliquer;</li>
                    <li>créer et protéger des mots de passe robustes;</li>
                    <li>réagir et signaler correctement un message suspect.</li>
                </ul>
            </field>
        </record>

        <record id="demo_slide_phishing" model="slide.slide">
            <field name="name">2. Reconnaître l'hameçonnage</field>
            <field name="channel_id" ref="demo_channel"/>
            <field name="slide_category">article</field>
            <field name="sequence">2</field>
            <field name="is_published" eval="True"/>
            <field name="html_content" type="html">
                <h2>Les 6 signaux d'alerte</h2>
                <ol>
                    <li><strong>L'urgence.</strong> « Votre compte sera fermé dans 24 h. »
                        La pression vise à vous faire agir sans réfléchir.</li>
                    <li><strong>L'expéditeur.</strong> Le nom affiché semble légitime, mais
                        l'adresse réelle ne correspond pas au domaine officiel.</li>
                    <li><strong>Le lien.</strong> Survolez-le (sans cliquer) : l'adresse
                        affichée diffère de la destination réelle.</li>
                    <li><strong>La demande d'identifiants.</strong> Un service légitime ne
                        vous demande jamais votre mot de passe par courriel.</li>
                    <li><strong>Les pièces jointes inattendues.</strong> Facture, bon de
                        livraison ou « document partagé » que vous n'attendiez pas.</li>
                    <li><strong>Le ton et la forme.</strong> Fautes, salutations génériques
                        (« Cher client »), mise en page approximative.</li>
                </ol>
                <p><strong>Règle d'or : en cas de doute, on ne clique pas — on vérifie par
                   un autre canal et on signale.</strong></p>
            </field>
        </record>

        <record id="demo_slide_passwords" model="slide.slide">
            <field name="name">3. Mots de passe et double authentification</field>
            <field name="channel_id" ref="demo_channel"/>
            <field name="slide_category">article</field>
            <field name="sequence">3</field>
            <field name="is_published" eval="True"/>
            <field name="html_content" type="html">
                <h2>Des accès vraiment protégés</h2>
                <ul>
                    <li><strong>Une phrase de passe</strong> longue (4 mots ou plus) vaut
                        mieux qu'un mot court compliqué : « cheval-orange-tunnel-42 ».</li>
                    <li><strong>Jamais de réutilisation.</strong> Un mot de passe par
                        service. Un gestionnaire de mots de passe s'en souvient pour vous.</li>
                    <li><strong>La double authentification (MFA)</strong> ajoute une seconde
                        preuve. Même si votre mot de passe fuit, le compte reste protégé.</li>
                    <li><strong>Attention à la fatigue MFA.</strong> Si vous recevez une
                        demande d'approbation que vous n'avez pas déclenchée, refusez et
                        signalez : quelqu'un tente peut-être d'entrer.</li>
                </ul>
            </field>
        </record>

        <record id="demo_slide_reporting" model="slide.slide">
            <field name="name">4. Signaler et réagir</field>
            <field name="channel_id" ref="demo_channel"/>
            <field name="slide_category">article</field>
            <field name="sequence">4</field>
            <field name="is_published" eval="True"/>
            <field name="html_content" type="html">
                <h2>Le bon réflexe : signaler</h2>
                <p>Signaler un courriel suspect n'est jamais une perte de temps. C'est ce
                   qui permet à l'équipe TI de protéger tout le monde.</p>
                <ul>
                    <li><strong>Vous avez un doute ?</strong> Transférez le message à votre
                        équipe TI plutôt que de cliquer.</li>
                    <li><strong>Vous avez cliqué ?</strong> Pas de panique, mais agissez
                        vite : changez votre mot de passe et prévenez les TI.</li>
                    <li><strong>Vous avez saisi vos identifiants ?</strong> Changez-les
                        immédiatement partout où ils étaient réutilisés, et signalez.</li>
                </ul>
                <p>Personne n'est blâmé pour avoir signalé. On est blâmé pour avoir caché.</p>
            </field>
        </record>

        <record id="demo_slide_quiz" model="slide.slide">
