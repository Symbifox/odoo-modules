<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_editorial" model="ir.ui.view">
        <field name="name">res.config.settings.form.editorial</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Atelier éditorial" name="bf_editorial"
                     logo="/bf_editorial/static/description/icon.png">
                    <block title="Politique multilingue"
                           help="Ce que le module considère comme « publié » quand un article existe en plusieurs langues.">
                        <setting id="require_all_langs"
                                 help="Un article dont la traduction n'est pas sortie reste incomplet et ne compte pas dans la cadence. Chaque calendrier peut surcharger ce réglage.">
                            <field name="bf_editorial_require_all_langs"/>
                        </setting>
                    </block>
                    <block title="Sources" help="Fraîcheur des références citées.">
                        <setting id="source_recheck"
                                 help="Au-delà de ce délai, une source est considérée périmée.">
                            <field name="bf_editorial_source_recheck_months"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
