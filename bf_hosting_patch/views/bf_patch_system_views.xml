<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_patch_system_view_list" model="ir.ui.view">
        <field name="name">bf.patch.system.list</field>
        <field name="model">bf.patch.system</field>
        <field name="arch" type="xml">
            <list decoration-danger="patch_state in ('security', 'stale', 'blind')"
                  decoration-warning="patch_state in ('reboot', 'updates')"
                  decoration-muted="patch_state == 'unmanaged'">
                <field name="endpoint_id"/>
                <field name="name"/>
                <field name="os_family" widget="badge"/>
                <field name="patch_state" widget="badge"
                       decoration-danger="patch_state in ('security', 'stale', 'blind')"
                       decoration-warning="patch_state in ('reboot', 'updates')"
                       decoration-success="patch_state == 'ok'"/>
                <field name="pending_known" optional="show"/>
                <field name="pending_count"/>
                <field name="pending_security_count" optional="show"/>
                <field name="pending_delta" optional="hide"/>
                <field name="reboot_required" optional="show"/>
                <!-- Le compteur ne s'affiche jamais sans la date qui l'a produit. -->
                <field name="agent_last_report"/>
                <field name="auto_update_mode" optional="hide"/>
                <field name="os_support_state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="bf_patch_system_view_form" model="ir.ui.view">
        <field name="name">bf.patch.system.form</field>
        <field name="model">bf.patch.system</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_revoke_agent" type="object"
                                class="oe_stat_button" icon="fa-ban"
                                confirm="Le prochain relevé de cet agent sera refusé. Continuer ?"
                                invisible="not patch_managed"
                                string="Révoquer l'agent"/>
                        <button name="action_view_jobs" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="not patch_managed">
                            <field name="job_pending_count" widget="statinfo"
                                   string="Ordres en file"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="not apply_allowed">
                        Application à distance AUTORISÉE sur cette machine.
                        Le consentement est le fichier
                        <code>/etc/symbifox/apply-allowed</code> : il se retire
                        sur la machine, pas ici.
                    </div>
                    <div class="alert alert-warning" role="status"
                         invisible="patch_state != 'stale'">
                        Aucun relevé récent. Un système qui ne parle plus est le
                        cas le plus dangereux, pas le plus tranquille.
                    </div>
                    <div class="alert alert-danger" role="status"
                         invisible="patch_state != 'blind'">
                        Le dernier relevé n'a pas pu compter les paquets. Le zéro
                        affiché est un artefact, pas une mesure.
                    </div>
                    <div class="alert alert-danger" role="status"
                         invisible="not disk_tight">
                        Disque serré : une mise à jour peut échouer à mi-chemin.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="poste-linux"/></h1>
                    </div>
                    <group>
                        <group string="Application à distance">
                            <field name="apply_allowed"/>
                            <field name="agent_last_poll"/>
                        </group>
                        <group string="Machine et système">
                            <field name="endpoint_id"/>
                            <field name="os_family"/>
                            <field name="os_release"/>
                            <field name="hostname"/>
                            <field name="machine_id" readonly="1"/>
                        </group>
                        <group string="Agent">
                            <field name="patch_managed" readonly="1"/>
                            <field name="agent_last_report"/>
                            <field name="agent_version"/>
                            <field name="patch_state"/>
                        </group>
                        <group string="Mises à jour">
                            <field name="package_manager"/>
                            <field name="pending_known"/>
                            <field name="pending_count"/>
                            <field name="pending_security_count"/>
                            <field name="pending_delta"/>
                            <field name="auto_update_mode"/>
                            <field name="auto_update_detail"/>
                        </group>
                        <group string="Noyau et redémarrage">
                            <field name="kernel_running"/>
                            <field name="kernel_installed"/>
                            <field name="boot_time"/>
                            <field name="reboot_required"/>
                            <field name="reboot_pending_since"
                                   invisible="not reboot_required"/>
                            <field name="reboot_pending_days"
                                   invisible="not reboot_required"/>
                            <field name="reboot_packages"
                                   invisible="not reboot_required"/>
                        </group>
                        <group string="Disque">
                            <field name="disk_root_pct"/>
                            <field name="disk_boot_pct"/>
                            <field name="disk_tight" readonly="1"/>
                        </group>
                        <group string="Support">
                            <field name="os_support_end"/>
                            <field name="os_support_state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Relevés" name="reports">
                            <field name="report_ids" readonly="1">
                                <list>
                                    <field name="report_date"/>
                                    <field name="pending_known"/>
                                    <field name="pending_count"/>
                                    <field name="pending_delta"/>
                                    <field name="reboot_required"/>
                                    <field name="kernel_running"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_patch_system_view_search" model="ir.ui.view">
        <field name="name">bf.patch.system.search</field>
        <field name="model">bf.patch.system</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="endpoint_id"/>
                <field name="os_release"/>
                <filter name="stale" string="Muets"
                        domain="[('patch_state', '=', 'stale')]"/>
                <filter name="blind" string="Compte inconnu"
                        domain="[('patch_state', '=', 'blind')]"/>
                <filter name="security" string="Sécurité en attente"
                        domain="[('patch_state', '=', 'security')]"/>
                <filter name="reboot" string="Redémarrage requis"
                        domain="[('reboot_required', '=', True)]"/>
                <filter name="disk" string="Disque serré"
                        domain="[('disk_tight', '=', True)]"/>
                <filter name="eol" string="Support qui finit"
                        domain="[('os_support_state', 'in', ('ending_soon', 'ended'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="by_state" string="État"
                            context="{'group_by': 'patch_state'}"/>
                    <filter name="by_endpoint" string="Machine"
                            context="{'group_by': 'endpoint_id'}"/>
                    <filter name="by_family" string="Famille"
                            context="{'group_by': 'os_family'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_patch_system_action" model="ir.actions.act_window">
        <field name="name">Systèmes suivis</field>
        <field name="res_model">bf.patch.system</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bf_patch_system_view_search"/>
        <field name="context">{'search_default_by_endpoint': 1}</field>
    </record>

    <record id="bf_patch_system_action_attention" model="ir.actions.act_window">
        <field name="name">Systèmes à regarder</field>
        <field name="res_model">bf.patch.system</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('patch_state', 'in', ('stale', 'blind', 'security', 'reboot'))]</field>
    </record>

</odoo>
