<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="survey_user_input_view_form" model="ir.ui.view">
        <field name="name">survey.user_input.form.bf.answer.sheet</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[@col='2']" position="after">
                <group string="Answer sheet" name="bf_sheet"
                       invisible="not survey_id or not bf_sheet_state">
                    <field name="bf_sheet_state"/>
                    <field name="bf_sheet_attachment_id"
                           invisible="not bf_sheet_attachment_id"/>
                    <field name="bf_sheet_tries" invisible="bf_sheet_state == 'done'"/>
                    <field name="bf_sheet_message"/>
                    <!-- The button makes a service account write on Nextcloud:
                         the people who own the survey, not everyone who may
                         read a response. -->
                    <button name="action_bf_sheet_file_now" type="object"
                            string="File it now" class="btn-secondary"
                            groups="survey.group_survey_manager"
                            invisible="bf_sheet_state == 'done'"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="survey_user_input_view_tree" model="ir.ui.view">
        <field name="name">survey.user_input.list.bf.answer.sheet</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree"/>
        <field name="arch" type="xml">
            <!-- The respondent column says everything the contact column
                 says, and still says something when no contact is linked. -->
            <field name="partner_id" position="before">
                <field name="bf_respondent" optional="show"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="state" position="after">
                <field name="bf_sheet_state" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
