<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_contact_persona_form" model="ir.ui.view">
        <field name="name">contact.persona.form</field>
        <field name="model">contact.persona</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh_facts"
                            type="object" string="Measure now"
                            help="Re-reads the emails exchanged with this contact and recomputes the relationship."/>
                    <button name="action_launch_persona_skill"
                            type="object" string="Launch Claude /persona refresh"
                            context="{'default_mode': 'refresh'}"
                            help="Opens the Claude panel with /persona refresh pre-filled."/>
                    <button name="action_link_knowledge_items"
                            type="object" string="Link the matrix items"
                            help="Looks for the matrix items where this contact appears (decision maker, consulted, informed) and adds them to the shared knowledge."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Degraded relationship" bg_color="text-bg-danger" invisible="relationship_health != 'degraded'"/>
                    <widget name="web_ribbon" title="To watch" bg_color="text-bg-warning" invisible="relationship_health != 'watch'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-warning py-2" role="status"
                         invisible="not health_reason_display or relationship_health not in ('watch', 'degraded')">
                        <field name="health_reason_display" nolabel="1"/>
                    </div>
                    <div class="alert alert-info py-2" role="status" invisible="not suggested_rule_count">
                        <field name="suggested_rule_count" invisible="1"/>
                        Copy rules have been suggested from the emails sent:
                        confirm or reject them in the "Copies" tab.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="addressing_style"/>
                            <field name="preferred_salutation"/>
                            <field name="closing_formula"/>
                            <field name="preferred_language"/>
                        </group>
                        <group string="Relationship, measured on the emails">
                            <field name="relationship_health" readonly="1"/>
                            <field name="last_inbound_date"/>
                            <field name="last_outbound_date"/>
                            <field name="inbound_count_90d"/>
                            <field name="outbound_count_90d"/>
                            <field name="unanswered_count" decoration-warning="unanswered_count &gt;= 2"/>
                            <field name="unanswered_since" invisible="not unanswered_count"/>
                            <field name="our_words_median" decoration-warning="our_words_median &gt;= 120"/>
                            <field name="facts_refreshed_at" string="Measured on"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="custom_appellations" placeholder="E.g.: write to info@ for the documentation; attachments rather than links; informal address (former colleague)."/>
                    </group>
                    <notebook>
                        <page string="Copies" name="cc">
                            <field name="cc_rule_ids" context="{'default_state': 'active'}">
                                <list editable="bottom" decoration-muted="state == 'suggested'">
                                    <field name="rule_type"/>
                                    <field name="cc_partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="mandatory" widget="boolean_toggle" invisible="rule_type == 'never'"/>
                                    <field name="state" readonly="1" widget="badge"
                                           decoration-info="state == 'suggested'"
                                           decoration-success="state == 'active'"/>
                                    <field name="evidence" optional="show"/>
                                    <field name="category_id" optional="hide"/>
                                    <field name="notes" optional="hide"/>
                                    <button name="action_confirm" type="object" string="Confirm"
                                            icon="fa-check" invisible="state != 'suggested'"/>
                                    <button name="action_reject" type="object" string="Reject"
                                            icon="fa-times" invisible="state != 'suggested'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tone" name="tone">
                            <group>
                                <group string="Their tone towards us">
                                    <field name="tone_summary"/>
                                    <field name="tone_notes" nolabel="1" colspan="2"/>
                                </group>
                                <group string="Our tone towards them">
                                    <field name="our_tone_summary"/>
                                    <field name="our_tone_notes" nolabel="1" colspan="2"/>
                                </group>
                            </group>
                            <group>
                                <field name="tone_last_assessed"/>
                            </group>
                        </page>
                        <page string="Payer" name="payer" groups="bf_persona.group_persona_manager">
                            <group>
                                <group>
                                    <field name="payer_quality"/>
                                    <field name="avg_payment_delay_days" widget="float" digits="[16,1]"/>
                                </group>
                            </group>
                            <separator string="Notes"/>
                            <field name="payer_notes"/>
                        </page>
                        <page string="Personal details" name="personal" groups="bf_persona.group_persona_manager">
                            <field name="personal_details"/>
                        </page>
                        <page string="Shared knowledge" name="knowledge">
                            <field name="shared_knowledge_item_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="KPIs" name="kpis">
                            <field name="kpi_ids">
                                <list editable="bottom">
                                    <field name="date_measured"/>
                                    <field name="name"/>
                                    <field name="value_text"/>
                                    <field name="value_float"/>
                                    <field name="unit"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                        <page string="What Gen receives" name="claude">
                            <field name="claude_context_summary" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_contact_persona_list" model="ir.ui.view">
        <field name="name">contact.persona.list</field>
        <field name="model">contact.persona</field>
        <field name="arch" type="xml">
            <list decoration-warning="relationship_health == 'watch'"
                  decoration-danger="relationship_health == 'degraded'">
                <field name="partner_id"/>
                <field name="addressing_style"/>
                <field name="relationship_health"/>
                <field name="health_reason_display" optional="show"/>
                <field name="last_interaction_date" optional="show"/>
                <field name="unanswered_count" optional="show"/>
                <field name="our_words_median" optional="hide"/>
                <field name="tone_summary" optional="hide"/>
                <field name="our_tone_summary" optional="hide"/>
                <field name="payer_quality" optional="show" groups="bf_persona.group_persona_manager"/>
                <field name="avg_payment_delay_days" optional="hide" groups="bf_persona.group_persona_manager"/>
                <field name="tone_last_assessed" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_contact_persona_search" model="ir.ui.view">
        <field name="name">contact.persona.search</field>
        <field name="model">contact.persona</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="preferred_salutation"/>
                <separator/>
                <filter string="Informal (tu)" name="filter_tu"
                        domain="[('addressing_style','=','tu')]"/>
                <filter string="Formal (vous)" name="filter_vous"
                        domain="[('addressing_style','=','vous')]"/>
                <separator/>
                <filter string="Degraded relationship" name="filter_health_degraded"
                        domain="[('relationship_health','=','degraded')]"/>
                <filter string="To watch" name="filter_health_watch"
                        domain="[('relationship_health','=','watch')]"/>
                <filter string="Healthy" name="filter_health_healthy"
                        domain="[('relationship_health','=','healthy')]"/>
                <separator/>
                <filter string="Unanswered emails" name="filter_unanswered"
                        domain="[('unanswered_count','&gt;=',2)]"/>
                <filter string="Our overly long emails" name="filter_long"
                        domain="[('our_words_median','&gt;=',120)]"/>
                <filter string="Suggested copy rules" name="filter_suggested_rules"
                        domain="[('cc_rule_ids.state','=','suggested')]"/>
                <separator/>
                <filter string="Tense tone" name="filter_tense"
                        domain="[('tone_summary','=','tense')]"/>
                <filter string="Slow or poor payer" name="filter_slow_payer"
                        domain="[('payer_quality','in',('slow','poor'))]"
                        groups="bf_persona.group_persona_manager"/>
                <filter string="Form of address to fill in (auto)" name="filter_addressing_auto"
                        domain="[('addressing_style','=','auto')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Relationship health"
                            name="group_health" context="{'group_by': 'relationship_health'}"/>
                    <filter string="Style"
                            name="group_style" context="{'group_by': 'addressing_style'}"/>
                    <filter string="Their tone"
                            name="group_tone" context="{'group_by': 'tone_summary'}"/>
                    <filter string="Payer"
                            name="group_payer" context="{'group_by': 'payer_quality'}"
                            groups="bf_persona.group_persona_manager"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_contact_persona" model="ir.actions.act_window">
        <field name="name">Personas</field>
        <field name="res_model">contact.persona</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contact_persona_search"/>
    </record>

</odoo>
