"      <t t-out=\"sig['name']\"/> <span t-if=\"sig['pronouns']\" t-attf-style=\"font-weight: 400; font-size: 9pt; color: {{ sig['muted'] }};\">(<t t-out=\"sig['pronouns']\"/>)</span>\n"
"    </div>\n"
"    <div t-if=\"sig['title']\" t-attf-style=\"font-size: 12px; color: {{ sig['muted'] }}; margin-top: 2px; text-transform: uppercase; letter-spacing: 0.5px;\">\n"
"      <t t-out=\"sig['title']\"/>\n"
"    </div>\n"
"    <div t-if=\"sig['email']\" style=\"margin-top: 8px; font-size: 13px;\">\n"
"      <a t-attf-href=\"mailto:{{ sig['email'] }}\" style=\"border-top-width:0px;border-right-width:0px;border-bottom-width:0px;border-left-width:0px;border-top-color:#008f8c;border-right-color:#008f8c;border-bottom-color:#008f8c;border-left-color:#008f8c;color:#008f8c;border-radius: 0px;border-style:none; padding: 0px; margin: 0px; box-sizing: border-box; border-color: #008f8c; border-width: 0px; text-decoration: none;\"><font t-attf-style=\"color: {{ sig['accent'] }};\">\n"
"        <t t-out=\"sig['email']\"/>&nbsp;</font></a>\n"
"    </div>\n"
"    <div t-if=\"sig['phone'] or sig['tollfree']\" style=\"font-size: 13px; margin-top: 2px;\">\n"
"      <a t-if=\"sig['phone']\" t-att-href=\"sig['phone_href']\" style=\"border-top-width:0px;border-right-width:0px;border-bottom-width:0px;border-left-width:0px;border-top-color:#008f8c;border-right-color:#008f8c;border-bottom-color:#008f8c;border-left-color:#008f8c;color:#008f8c;border-radius: 0px;border-style:none; padding: 0px; margin: 0px; box-sizing: border-box; border-color: #008f8c; border-width: 0px; text-decoration: none;\"><font t-attf-style=\"color: {{ sig['accent'] }};\">\n"
"        <t t-out=\"sig['phone']\"/>\n"
"      </font></a>\n"
"      <span t-if=\"sig['phone'] and sig['tollfree']\" style=\"color: #ccc; font-size: 10px;\">&nbsp;|&nbsp;</span>\n"
