#. module: bf_school_forms
#: model:mail.template,body_html:bf_school_forms.mail_template_school_form
msgid ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.form_id.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 4px 0;font-size:13px;color:#6B7280;\">\n"
"        <t t-out=\"object.form_id.school_id.name or ''\"/> · <t t-out=\"object.student_id.name or ''\"/>\n"
"    </p>\n"
"    <p t-if=\"ctx.get('school_reminder')\" style=\"margin:0 0 8px 0;font-weight:600;\">Reminder: we have not received your answer yet.</p>\n"
"    <h2 style=\"margin:0 0 16px 0;\" t-out=\"object.form_id.name or ''\"/>\n"
"    <div style=\"margin:0 0 16px 0;\" t-out=\"object.form_id.body_html\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}{{ object._url() }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Answer\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        This link is personal: it records your answer in your name. Do not forward it.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.form_id.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 4px 0;font-size:13px;color:#6B7280;\">\n"
"        <t t-out=\"object.form_id.school_id.name or ''\"/> · <t t-out=\"object.student_id.name or ''\"/>\n"
"    </p>\n"
"    <p t-if=\"ctx.get('school_reminder')\" style=\"margin:0 0 8px 0;font-weight:600;\">Rappel : nous n'avons pas encore reçu votre réponse.</p>\n"
"    <h2 style=\"margin:0 0 16px 0;\" t-out=\"object.form_id.name or ''\"/>\n"
"    <div style=\"margin:0 0 16px 0;\" t-out=\"object.form_id.body_html\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}{{ object._url() }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Répondre\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        Ce lien est personnel : il enregistre votre réponse à votre nom. Ne le transférez pas.\n"
"    </p>\n"
"</div>\n"
"            "

