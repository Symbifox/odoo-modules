#. module: bf_appointment_meeting
#. odoo-python
#: code:addons/bf_appointment_meeting/models/resource_booking.py:0
msgid "Préparer l'ordre du jour"
msgstr "Prepare the agenda"

#. module: bf_appointment_meeting
#. odoo-python
#: code:addons/bf_appointment_meeting/models/resource_booking.py:0
msgid "Proposez un sujet ou laissez une note avant la rencontre. Le lien reste actif jusqu'à ce que l'ordre du jour soit arrêté."
msgstr "Suggest a topic or leave a note before the meeting. The link stays live until the agenda is settled."

#. module: bf_appointment_meeting
#. odoo-python
#: code:addons/bf_appointment_meeting/models/resource_booking.py:0
msgid "Ordre du jour créé."
msgstr "Agenda created."

#. module: bf_appointment_meeting
#. odoo-python
#: code:addons/bf_appointment_meeting/models/resource_booking.py:0
msgid "projet : %s"
msgstr "project: %s"

#. module: bf_appointment_meeting
#. odoo-python
#: code:addons/bf_appointment_meeting/models/resource_booking.py:0
msgid "Aucun ordre du jour créé."
msgstr "No agenda was created."

#. module: bf_appointment_meeting
#. odoo-python
#: code:addons/bf_appointment_meeting/models/resource_booking.py:0
msgid "Le type « %(type)s » demande un ordre du jour, mais ne désigne aucun projet et la société n'a pas de projet de repli. Configurez l'un ou l'autre, puis créez l'ordre du jour depuis l'événement d'agenda."
msgstr "Type “%(type)s” asks for an agenda, but names no project and the company has no fallback project. Set one or the other, then create the agenda from the calendar event."
