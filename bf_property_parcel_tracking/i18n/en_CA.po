#. module: bf_property_parcel_tracking
#. odoo-python
#: code:addons/bf_property_parcel_tracking/models/bf_property_parcel.py:0
msgid "%(carrier)s a refusé : %(why)s"
msgstr "%(carrier)s refused: %(why)s"

#. module: bf_property_parcel_tracking
#. odoo-python
#: code:addons/bf_property_parcel_tracking/hooks.py:0
msgid ""
"%(voisin)s est en %(pose)s, et le suivi des colis exige %(exige)s : sans "
"elle, un texto « votre colis est arrivé » partirait dès qu'un résident "
"ANNONCE un colis encore en route. Montez %(voisin)s dans la même fenêtre, "
"puis reprenez cette installation."
msgstr ""
"%(voisin)s is at %(pose)s, and parcel tracking requires %(exige)s: without "
"it, a \"your parcel has arrived\" text message would go out the moment a "
"resident ANNOUNCES a parcel still in transit. Upgrade %(voisin)s in the "
"same window, then run this installation again."

#. module: bf_property_parcel_tracking
#: model_terms:ir.ui.view,arch_db:bf_property_parcel_tracking.portal_property_deliveries_tracking
msgid ""
"<small class=\"text-muted d-block mt-1\">\n"
"                    Le numéro sert à demander au transporteur où en est ce colis, et à\n"
"                    rien d'autre. Il disparaît avec la fiche du colis.\n"
"                </small>"
msgstr ""
"<small class=\"text-muted d-block mt-1\">\n                    The number "
"is used to ask the carrier where this parcel is, and for\n                 "
"nothing else. It disappears with the parcel record.\n                "
"</small>"

