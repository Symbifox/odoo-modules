<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend calendar.event form to add meeting record + agenda links -->
    <!--
      🔴 Tout ce qui, ici, lit un ordre du jour ou un compte rendu est réservé au
      groupe Rencontres (18.0.3.65.2). Le client web lit tous les champs d'une
      vue, invisibles compris : sans cette garde, un compte interne qui n'a pas
      les Rencontres recevait un refus d'accès sur `meeting.agenda` en ouvrant
      N'IMPORTE QUELLE rencontre enregistrée.
    -->
    <record id="calendar_event_view_form_inherit_meeting" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.meeting</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_meeting_agenda" type="object"
                        class="oe_stat_button" icon="fa-list-alt"
                        groups="bf_meeting.group_meeting_user"
                        invisible="meeting_agenda_count == 0">
                    <field name="meeting_agenda_count" widget="statinfo" string="Ordre du jour"/>
                </button>
                <button name="action_create_meeting_agenda" type="object"
                        class="oe_stat_button" icon="fa-plus-circle"
                        groups="bf_meeting.group_meeting_user"
                        invisible="meeting_agenda_count > 0 or bf_skip_agenda">
                    <span class="o_stat_text">Créer OdJ</span>
                </button>
                <button name="action_view_meeting_record" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        groups="bf_meeting.group_meeting_user"
                        invisible="meeting_record_count == 0">
                    <field name="meeting_record_count" widget="statinfo" string="Compte rendu"/>
                </button>
                <button name="action_create_meeting_record" type="object"
                        class="oe_stat_button" icon="fa-plus-circle"
                        groups="bf_meeting.group_meeting_user"
                        invisible="meeting_record_count > 0">
                    <span class="o_stat_text">Créer compte rendu</span>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert"
                     groups="bf_meeting.group_meeting_user"
                     invisible="not bf_needs_agenda">
                    <i class="fa fa-exclamation-triangle"/>
                    Cette rencontre n'a pas d'ordre du jour. Créer un OdJ ou cocher
                    « Sans ordre du jour formel » si non requis.
                </div>
            </xpath>
            <!--
              🔴 Ces six champs étaient posés `position="after"` sur le champ
              `name`. Or `name` ne vit pas dans un groupe : le cœur le met dans
              le `<h1>` du bloc `oe_title`. Un champ placé là ne reçoit AUCUNE
              étiquette — un `<h1>` n'est pas un `<group>`, et c'est le groupe
              qui rend le `string` d'un champ — et il hérite en prime de la
              typographie du titre.

              Ce que ça donnait à l'écran : deux `Many2one` réduits à leur
              texte d'invite en corps de titre, deux cases à cocher nues, et
              deux fois le même avatar sans rien pour dire lequel est le
              responsable de l'OdJ et lequel celui du compte rendu. Six
              contrôles anonymes.

              ⚠️ L'ancre est `//notebook` et non `//sheet/group` : huit vues
              héritent de ce formulaire, et l'une d'elles peut ajouter un
              second groupe sous le `<sheet>`. `//sheet/group` correspondrait
              alors à deux nœuds et la vue mourrait pour tout le monde. Le
              `<notebook>` est unique et le reste (vérifié sur l'arch résolue).

              Le groupe porte un titre parce que la question posée n'était pas
              « où sont ces champs » mais « on ne comprend pas ce qu'ils sont ».
            -->
            <xpath expr="//notebook" position="before">
                <group string="Préparation de la rencontre" name="bf_meeting_prep"
                       groups="bf_meeting.group_meeting_user">
                    <group name="bf_meeting_prep_agenda">
                        <!-- Ne propose que les OdJ « à planifier » :
                             sans filtre, la liste offrait tous les OdJ,
                             terminés, annulés et déjà liés compris. -->
                        <field name="meeting_agenda_id"
                               options="{'no_create': True}"
                               domain="[('bf_to_schedule', '=', True)]"
                               placeholder="Lier un ordre du jour existant..."/>
                        <field name="bf_agenda_responsible_id"
                               widget="many2one_avatar_user"/>
                        <field name="bf_skip_agenda"/>
                    </group>
                    <group name="bf_meeting_prep_minutes">
                        <field name="meeting_record_id"
                               options="{'no_create': True}"
                               placeholder="Lier un compte rendu existant..."/>
                        <field name="bf_minutes_responsible_id"
                               widget="many2one_avatar_user"/>
                        <field name="bf_skip_dashboard"/>
                    </group>
                </group>
                <!-- Lu par l'encart d'avertissement posé avant le `<sheet>`. -->
                <field name="bf_needs_agenda" invisible="1" groups="bf_meeting.group_meeting_user"/>
            </xpath>
        </field>
    </record>

    <!--
      La création rapide, ce qu'ouvre un clic sur la grille du calendrier.
      Choisir un OdJ y remplit la rencontre (`_onchange_meeting_agenda_id_fill_event`)
      avant qu'on choisisse quoi que ce soit d'autre : d'où sa place, en tête.
      ⚠️ « Plus d'options » ne transmet au formulaire complet qu'une liste
      FIXE de champs (`calendar_quick_create.js`) : sans
      `calendar_quick_create_agenda.js`, le lien se perdait au passage.
    -->
    <record id="calendar_event_view_form_quick_create_inherit_meeting" model="ir.ui.view">
        <field name="name">calendar.event.form.quick_create.inherit.meeting</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <!-- ⚠️ Ancré sur `start_date`, pas sur `duration` : le cœur d'Odoo 18
                 de certaines installations n'a pas encore
                 `duration` dans cette vue, et la montée y échouait. -->
            <xpath expr="//field[@name='start_date']" position="before">
                <field name="meeting_agenda_id"
                       groups="bf_meeting.group_meeting_user"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('bf_to_schedule', '=', True)]"
                       placeholder="Partir d'un ordre du jour..."/>
            </xpath>
            <!-- Le lieu qu'un OdJ en présentiel apporte. Sans lui dans la vue,
                 la valeur posée par l'onchange ne repartait pas à
                 l'enregistrement direct (le cœur n'a pas ce champ ici). -->
            <xpath expr="//field[@name='partner_ids']" position="after">
                <field name="location"
                       groups="bf_meeting.group_meeting_user"
                       invisible="not location"/>
            </xpath>
            <!-- « Sans préparation » dès la création : sans elles,
                 il fallait créer, rouvrir la bulle, puis cliquer « Aucune
                 préparation ». Les mêmes champs que la section « Préparation de la
                 rencontre » du formulaire complet. -->
            <xpath expr="//field[@name='location']" position="after">
                <field name="bf_skip_agenda" widget="boolean_toggle"
                       groups="bf_meeting.group_meeting_user"/>
                <field name="bf_skip_dashboard" widget="boolean_toggle"
                       groups="bf_meeting.group_meeting_user"/>
            </xpath>
        </field>
    </record>

    <!-- Search filter: events without agenda -->
    <record id="calendar_event_view_search_inherit_meeting" model="ir.ui.view">
        <field name="name">calendar.event.search.inherit.meeting</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_needs_agenda" string="Besoin d'un OdJ"
                        domain="[('bf_needs_agenda', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!--
      Les deux états que lisent les pastilles de la grille du calendrier.

      ⚠️ `invisible="1"` ne veut pas dire « inutile » : la vue calendrier
      construit sa requête à partir des champs déclarés ici (`activeFields`),
      et c'est par là que les deux valeurs arrivent jusqu'au gabarit OWL
      (`static/src/xml/calendar_event_badges.xml`). Retirer ces deux lignes
      éteint les pastilles sans provoquer la moindre erreur.
    -->
    <record id="calendar_event_view_calendar_inherit_meeting" model="ir.ui.view">
        <field name="name">calendar.event.calendar.inherit.meeting</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_ids']" position="after">
                <field name="bf_agenda_state" invisible="1"/>
                <field name="bf_minutes_state" invisible="1"/>
                <!-- Lu par le bouton « Aucune préparation » de la bulle, qui
                     bascule cette case sans passer par le formulaire. -->
                <field name="bf_skip_agenda" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Les dispenses portées par l'étiquette elle-même. -->
    <record id="calendar_event_type_view_tree_inherit_meeting" model="ir.ui.view">
        <field name="name">calendar.event.type.list.inherit.meeting</field>
        <field name="model">calendar.event.type</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_type_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="bf_skip_agenda"/>
                <field name="bf_skip_dashboard"/>
            </xpath>
        </field>
    </record>

    <!-- Filtres pour retrouver ce qu'il reste à faire, depuis le calendrier. -->
    <record id="calendar_event_view_search_inherit_meeting_states" model="ir.ui.view">
        <field name="name">calendar.event.search.inherit.meeting.states</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_agenda_not_sent" string="OdJ non envoyé"
                        domain="[('bf_agenda_state', 'in', ['none', 'draft', 'reviewed'])]"/>
                <filter name="filter_minutes_not_sent" string="Compte rendu non envoyé"
                        domain="[('bf_minutes_state', 'in', ['none', 'draft', 'reviewed'])]"/>
            </xpath>
        </field>
    </record>
</odoo>
