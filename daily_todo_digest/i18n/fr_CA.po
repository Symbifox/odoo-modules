msgstr "Orage avec grêle forte"

#. module: daily_todo_digest
#. odoo-python
#: code:addons/daily_todo_digest/models/daily_digest.py:0
msgid "Thunderstorm with light hail"
msgstr "Orage avec grêle légère"

