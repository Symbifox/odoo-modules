<?xml version="1.0" encoding="utf-8"?>
<!-- Règle de couleur par défaut : l'agenda garde son critère d'aujourd'hui, et une
     couleur posée sur la valeur (un projet, un pilier) s'affiche. Modifiable, jamais réécrite. -->
<odoo noupdate="1">
    <record id="bf_color_rule_visit_listing" model="bf.color.rule">
        <field name="name">Visites selon l'inscription</field>
        <field name="sequence">100</field>
        <field name="company_id" eval="False"/>
        <field name="model_id" ref="bf_appointment_visit.model_bf_visit"/>
        <field name="field_id" ref="bf_appointment_visit.field_bf_visit__listing_id"/>
    </record>
</odoo>
