#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/account.py:0
msgid "%(student)s already has a user (%(login)s)."
msgstr "%(student)s a déjà un usager (%(login)s)."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/account.py:0
msgid "%s is not marked as a student."
msgstr "La fiche de %s n'est pas une fiche d'élève."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/account.py:0
msgid "%s is the guardian of a student."
msgstr "%s est responsable d'un élève."

#. module: bf_school_student_portal
#: model_terms:ir.ui.view,arch_db:bf_school_student_portal.portal_my_school_student
msgid ": your work, your homework and your courses are here."
msgstr " : tes travaux, tes devoirs et tes cours sont ici."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/res_users.py:0
msgid ""
"A student signs in through the school's directory: the school office gives a"
" new password."
msgstr "Un élève se connecte par l'annuaire de l'école : c'est l'administration qui donne un nouveau mot de passe."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/res_users.py:0
msgid "A student's account is managed by the school."
msgstr "Le compte d'un élève est géré par l'école."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/account.py:0
msgid "A student's portal user is kept by the system."
msgstr "L'usager portail d'un élève est tenu par le système."

#. module: bf_school_student_portal
#: model_terms:ir.ui.view,arch_db:bf_school_student_portal.portal_my_school_student
msgid "Hello"
msgstr "Bonjour"

#. module: bf_school_student_portal
#: model:ir.model.fields,field_description:bf_school_student_portal.field_bf_school_account__portal_user_id
