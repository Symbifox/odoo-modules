<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- noupdate : sinon chaque `-u` remettrait ce cron à `active=False`,
             annulant en silence le jour où on l'aura activé. -->
    <record id="cron_poll_maintenance" model="ir.cron">
        <field name="name">Sondages de disponibilités : relances et clôtures</field>
        <field name="model_id" ref="model_appointment_poll"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_maintenance()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
        <!-- Inactif à l'installation : on n'allume un cron qui écrit à des
             tiers qu'une fois les gabarits relus. -->
    </record>
    </data>
</odoo>
