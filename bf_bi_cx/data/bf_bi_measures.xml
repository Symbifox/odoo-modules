<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate : on peut ajuster une mesure livrée sans qu'une mise à jour l'écrase. -->
    <data noupdate="1">
        <record id="measure_nps_responses" model="bf.bi.measure">
            <field name="name">NPS responses</field>
            <field name="code">nps_responses</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">Answers to the NPS question.</field>
            <field name="model_id" search="[('model', '=', 'bf.cx.feedback')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[('kind', '=', 'nps')]</field>
            <field name="date_field_id" search="[('model', '=', 'bf.cx.feedback'), ('name', '=', 'date')]"/>
            <field name="partner_field_id" search="[('model', '=', 'bf.cx.feedback'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_promoters" model="bf.bi.measure">
            <field name="name">Promoters</field>
            <field name="code">promoters</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">NPS answers of 9 or 10.</field>
            <field name="model_id" search="[('model', '=', 'bf.cx.feedback')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[('kind', '=', 'nps'), ('nps_bucket', '=', 'promoter')]</field>
            <field name="date_field_id" search="[('model', '=', 'bf.cx.feedback'), ('name', '=', 'date')]"/>
            <field name="partner_field_id" search="[('model', '=', 'bf.cx.feedback'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_detractors" model="bf.bi.measure">
            <field name="name">Detractors</field>
            <field name="code">detractors</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">NPS answers of 0 to 6.</field>
            <field name="model_id" search="[('model', '=', 'bf.cx.feedback')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[('kind', '=', 'nps'), ('nps_bucket', '=', 'detractor')]</field>
            <field name="date_field_id" search="[('model', '=', 'bf.cx.feedback'), ('name', '=', 'date')]"/>
            <field name="partner_field_id" search="[('model', '=', 'bf.cx.feedback'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_nps" model="bf.bi.measure">
            <field name="name">NPS</field>
            <field name="code">nps</field>
            <field name="kind">formula</field>
            <field name="unit">number</field>
            <field name="comparison">difference</field>
            <field name="company_id" eval="False"/>
            <field name="description">Net Promoter Score: share of promoters minus share of detractors, from -100 to 100.</field>
            <field name="expression">(promoters - detractors) / nps_responses * 100</field>
        </record>
        <record id="measure_open_complaints" model="bf.bi.measure">
            <field name="name">Open complaints</field>
            <field name="code">open_complaints</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">Complaints received and not yet resolved.</field>
            <field name="model_id" search="[('model', '=', 'bf.cx.complaint')]"/>
            <field name="aggregator">count</field>
            <field name="domain">[('state', 'in', ('received', 'ack', 'analysis'))]</field>
            <field name="date_field_id" search="[('model', '=', 'bf.cx.complaint'), ('name', '=', 'date_received')]"/>
            <field name="partner_field_id" search="[('model', '=', 'bf.cx.complaint'), ('name', '=', 'partner_id')]"/>
        </record>
        <record id="measure_resolution_days" model="bf.bi.measure">
            <field name="name">Average resolution time (days)</field>
            <field name="code">resolution_days</field>
            <field name="kind">aggregate</field>
            <field name="unit">number</field>
            <field name="comparison">percentage</field>
            <field name="company_id" eval="False"/>
            <field name="description">Average number of days to resolve a complaint.</field>
            <field name="model_id" search="[('model', '=', 'bf.cx.complaint')]"/>
            <field name="aggregator">avg</field>
            <field name="domain">[('state', 'in', ('resolved', 'closed'))]</field>
            <field name="field_id" search="[('model', '=', 'bf.cx.complaint'), ('name', '=', 'resolution_delay_days')]"/>
            <field name="date_field_id" search="[('model', '=', 'bf.cx.complaint'), ('name', '=', 'date_resolved')]"/>
            <field name="partner_field_id" search="[('model', '=', 'bf.cx.complaint'), ('name', '=', 'partner_id')]"/>
        </record>
    </data>
</odoo>
