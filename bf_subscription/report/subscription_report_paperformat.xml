<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_subscription" model="report.paperformat">
        <field name="name">Rapport des abonnements (US Letter)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_subscription" model="ir.actions.report">
        <field name="name">Rapport des abonnements</field>
        <field name="model">subscription.digest</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_subscription.report_subscription</field>
        <field name="report_file">bf_subscription.report_subscription</field>
        <field name="print_report_name">'Rapport_abonnements_%s' % (time.strftime('%Y-%m-%d'))</field>
        <field name="paperformat_id" ref="paperformat_subscription"/>
    </record>

</odoo>
