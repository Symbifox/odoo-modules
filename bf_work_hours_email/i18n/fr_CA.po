#. module: bf_work_hours_email
#. odoo-python
#: code:addons/bf_work_hours_email/models/work_collector.py:0
msgid "Email"
msgstr "Courriel"

#. module: bf_work_hours_email
#. odoo-python
#: code:addons/bf_work_hours_email/models/work_collector.py:0
msgid ""
"When you sent an email from your mail client (read back from your Sent "
"folder). Not to whom, not what it says. Emails sent from Odoo are already "
"seen as browser activity."
msgstr ""
"Le moment où vous avez envoyé un courriel depuis votre logiciel de courriel "
"(relu dans vos éléments envoyés). Ni à qui, ni ce qu'il dit. Les courriels "
"envoyés depuis Odoo sont déjà vus comme activité au navigateur."

#. module: bf_work_hours_email
#: model:ir.model,name:bf_work_hours_email.model_bf_work_collector
msgid "Working time: sources of traces"
msgstr "Temps de travail : sources des traces"

#. module: bf_work_hours_email
#: model:ir.module.module,shortdesc:base.module_bf_work_hours_email
msgid "BF Working Hours - Email"
msgstr "BF Temps de travail - Courriel"

#. module: bf_work_hours_email
#: model:ir.module.module,summary:base.module_bf_work_hours_email
msgid ""
"Emails a person sends from their mail client count as traces of their "
"working time"
msgstr ""
"Les courriels qu'une personne envoie de son logiciel de courriel comptent "
"comme traces de son temps de travail"
