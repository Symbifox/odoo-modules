<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Configuration Form View -->
    <record id="view_daily_digest_config_form" model="ir.ui.view">
        <field name="name">daily.digest.config.form</field>
        <field name="model">daily.digest.config</field>
        <field name="arch" type="xml">
            <form string="Digest configuration">
                <header>
                    <button name="action_send_now"
                            type="object"
                            string="Send now"
                            class="btn-primary"
                            icon="fa-paper-plane"/>
                    <button name="action_send_test"
                            type="object"
                            string="Test (me only)"
                            class="btn-secondary"
                            icon="fa-user"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="send_hour" widget="integer"/>
                            <field name="frequency"/>
                            <field name="company_id"/>
                            <field name="last_sent" readonly="1"/>
                        </group>
                        <group string="Recipients">
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Widgets" name="widgets">
                            <group>
                                <group string="Activities">
                                    <field name="include_overdue_activities"/>
                                    <field name="include_today_activities"/>
                                </group>
                                <group string="Tasks">
                                    <field name="include_overdue_tasks"/>
                                    <field name="include_today_tasks"/>
                                    <field name="include_upcoming_tasks"/>
                                    <field name="upcoming_days"
                                           invisible="not include_upcoming_tasks"/>
                                    <field name="include_week_preview"/>
                                </group>
                            </group>
                            <group>
                                <group string="Calendar">
                                    <field name="include_calendar_events"/>
                                </group>
                                <group string="Meetings">
                                    <field name="include_meetings"/>
                                </group>
                            </group>
                            <group>
                                <group string="News">
                                    <field name="include_flux_subjects"/>
                                </group>
                            </group>
                            <group>
                                <group string="Weather">
                                    <field name="include_weather"/>
                                    <field name="weather_city" invisible="not include_weather"/>
                                    <field name="weather_latitude" invisible="not include_weather"/>
                                    <field name="weather_longitude" invisible="not include_weather"/>
                                </group>
                                <group string="Quote">
                                    <field name="include_quote"/>
                                </group>
                            </group>
                        </page>
                        <page string="Less noise" name="noise">
                            <group>
                                <group string="Waiting tasks">
                                    <field name="include_waiting_tasks"/>
                                </group>
                                <group string="Folded reminders">
                                    <field name="activity_fold_model_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <p>
                                    A digest that lists everything is read by
                                    nobody. Two levers here take the noise out
                                    without hiding anything: a folded line
                                    always says how many, and links to the list.
                                </p>
                                <ul>
                                    <li><strong>Waiting tasks:</strong> a task
                                        waiting on a client or a colleague is
                                        not a gesture of your day. Left
                                        unticked, those tasks are counted in one
                                        line instead of filling the list.</li>
                                    <li><strong>Folded reminders:</strong> the
                                        recurring activities a scheduler creates
                                        — backup checks, log reviews, update
                                        checks — repeat the same wording many
                                        times a day. Name their model here and
                                        they become one line per model.</li>
                                </ul>
                            </div>
                        </page>
                        <page string="Help" name="help">
                            <div class="alert alert-info" role="alert">
                                <h4>How does the daily digest work?</h4>
                                <ul>
                                    <li><strong>Sending time:</strong> the scheduled job checks every hour. The digest goes out at the configured hour <strong>in each recipient's time zone</strong> (Timezone field of their user record). Each recipient may set their own hour, frequency and sections in their preferences; what they leave empty follows this template.</li>
                                    <li><strong>Recipients:</strong> named people and every member of the recipient groups. A person receives <strong>one</strong> digest: when several templates cover them, the one with the lowest sequence wins.</li>
                                    <li><strong>Activities:</strong> activities (mail.activity) assigned to the recipients are included.</li>
                                    <li><strong>Tasks:</strong> project tasks assigned to the recipients are included (subtasks included). The "today" window is computed in each recipient's time zone.</li>
                                    <li><strong>Calendar events:</strong> the events of the recipient's day that they attend and have not declined, whoever organized them, with their times in the recipient's time zone (and in their secondary calendar time zone, when they set one).</li>
                                    <li><strong>Upcoming tasks:</strong> preview of the tasks of the next days (1 to 7 days, configurable).</li>
                                    <li><strong>Weather:</strong> uses the free Open-Meteo API. The default city and coordinates above apply, but each recipient can set their own city in their preferences (Weather city (digest)).</li>
                                    <li><strong>Quotes:</strong> a random quote is picked from the collection.</li>
                                    <li><strong>Watched subjects:</strong> what the RSS lists that watch a name retained since your last digest (bf_flux). Nothing is shown when that module is not installed.</li>
                                </ul>
                                <p class="mt-3">
                                    <strong>Common coordinates:</strong><br/>
                                    Montréal: 45.5017, -73.5673<br/>
                                    Québec: 46.8139, -71.2080<br/>
                                    Toronto: 43.6532, -79.3832<br/>
                                    Ottawa: 45.4215, -75.6972
                                </p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Configuration List View -->
    <record id="view_daily_digest_config_list" model="ir.ui.view">
        <field name="name">daily.digest.config.list</field>
        <field name="model">daily.digest.config</field>
        <field name="arch" type="xml">
            <list string="Daily digests">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="send_hour"/>
                <field name="frequency"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="last_sent"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Configuration Action -->
    <record id="action_daily_digest_config" model="ir.actions.act_window">
        <field name="name">Daily digests</field>
        <field name="res_model">daily.digest.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first daily digest
            </p>
            <p>
                Receive every morning a summary of your overdue and today's activities and tasks,
                with the weather and an inspiring quote.
            </p>
        </field>
    </record>

    <!-- Quotes List View -->
    <record id="view_daily_digest_quote_list" model="ir.ui.view">
        <field name="name">daily.digest.quote.list</field>
        <field name="model">daily.digest.quote</field>
        <field name="arch" type="xml">
            <list string="Inspiring quotes" editable="bottom">
                <field name="quote"/>
                <field name="author"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Quotes Action -->
    <record id="action_daily_digest_quote" model="ir.actions.act_window">
        <field name="name">Inspiring quotes</field>
        <field name="res_model">daily.digest.quote</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add inspiring quotes
            </p>
            <p>
                These quotes will appear in rotation in the daily digest emails.
            </p>
        </field>
    </record>

    <!-- Menu Items - Under Settings > Technical -->
    <menuitem id="menu_daily_digest_root"
              name="Daily digest"
              parent="base.menu_custom"
              sequence="50"/>

    <menuitem id="menu_daily_digest_config"
              name="Configuration"
              parent="menu_daily_digest_root"
              action="action_daily_digest_config"
              sequence="10"/>

    <menuitem id="menu_daily_digest_quotes"
              name="Quotes"
              parent="menu_daily_digest_root"
              action="action_daily_digest_quote"
              sequence="20"/>

</odoo>
