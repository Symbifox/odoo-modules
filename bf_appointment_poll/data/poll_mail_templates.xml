    </td></tr>
    <tr><td t-attf-style="height:4px; line-height:4px; background-color:{{ (object.poll_id.type_id.company_id and object.poll_id.type_id.company_id.appointment_brand_primary) or brand_primary }};">&#160;</td></tr>
    <tr><td style="padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif;">
        <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">Bonjour <t t-out="object.name or ''"/>,</p>
        <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;">Un rappel sans pression : vos disponibilit&#233;s manquent encore pour fixer la rencontre &#171;&#160;<strong><t t-out="object.poll_id.name or ''"/></strong>&#160;&#187;.</p>
        <t t-if="object.required"><p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;">Votre pr&#233;sence &#233;tant requise, la rencontre attend votre r&#233;ponse pour se fixer.</p></t>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:16px 0 4px 0; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;"><tbody>
         <tr><td style="padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px; width:38%;">Objet</td><td style="padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;"><t t-out="object.poll_id.name or ''"/></td></tr>
         <tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Dur&#233;e pr&#233;vue</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;"><t t-out="object.poll_id.duration_display()"/></td></tr>
         <tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Cr&#233;neaux propos&#233;s</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;"><t t-out="len(object.poll_id.slot_ids)"/></td></tr>
         <t t-if="object.poll_id.close_date"><tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">R&#233;pondre avant le</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;"><t t-out="object.poll_id.close_display()"/></td></tr></t>
         <t t-if="object.required"><tr><td style="padding:12px 16px; color:#6B7280; font-size:14px;">Votre pr&#233;sence</td><td style="padding:12px 16px; font-size:14px; font-weight:600; color:#374151;">Requise</td></tr></t>
        </tbody></table>
