<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_phishing_campaign" model="ir.actions.report">
        <field name="name">Named report (confidential)</field>
        <field name="model">bf.phishing.campaign</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_security_awareness.report_phishing_campaign</field>
        <field name="report_file">bf_security_awareness.report_phishing_campaign</field>
        <field name="binding_model_id" ref="model_bf_phishing_campaign"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_phishing_campaign">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Phishing campaign report</h2>
                        <h3 class="text-muted"><span t-field="o.name"/></h3>
                        <p class="mt-2" style="font-weight:bold;">
                            Confidential: this report contains individual results. Do not hand over outside the organization; use the aggregate report instead.
                        </p>

                        <table class="table table-sm mt-3" style="width:100%;">
                            <tr>
                                <td><strong>Lure template</strong></td>
                                <td><span t-field="o.template_id"/></td>
                                <td><strong>Status</strong></td>
                                <td><span t-field="o.state"/></td>
                            </tr>
                            <tr>
                                <td><strong>Send date</strong></td>
                                <td><span t-field="o.scheduled_date"/></td>
                                <td><strong>Recipients</strong></td>
                                <td><span t-field="o.recipient_count"/></td>
                            </tr>
                        </table>

                        <h4 class="mt-4">Results</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Emails sent</th>
                                    <th>Emails opened</th>
                                    <th>Clicks</th>
                                    <th>Credentials submitted</th>
                                    <th>Reports</th>
                                    <th>Failure rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-esc="o.sent_count"/>
                                    <td t-esc="o.opened_count"/>
                                    <td t-esc="o.clicked_count"/>
                                    <td t-esc="o.submitted_count"/>
                                    <td t-esc="o.reported_count"/>
                                    <td><span t-esc="round(o.fail_rate, 1)"/> %</td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Breakdown by person</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Person</th>
                                    <th>Status</th>
                                    <th>Has reported</th>
                                    <th>Clicked on</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.result_ids" t-as="r">
                                    <td><span t-field="r.partner_id"/></td>
                                    <td><span t-field="r.state"/></td>
                                    <td>
                                        <span t-if="r.reported">Yes</span>
                                        <span t-else="">—</span>
                                    </td>
                                    <td><span t-field="r.clicked_datetime"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <p class="text-muted mt-4" style="font-size:10px;">
                            Internal, authorized security simulation. No password is kept: only field lengths and actions (open, click, submission, report) are recorded.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
