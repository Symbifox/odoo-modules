<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_absence_calendar_source_list" model="ir.ui.view">
        <field name="name">bf.absence.calendar.source.list</field>
        <field name="model">bf.absence.calendar.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="calendar_slug"/>
                <field name="config_key"/>
                <field name="nature"/>
                <field name="last_run"/>
                <field name="last_message"/>
                <button name="action_read" type="object" icon="fa-refresh"
                        title="Lire maintenant"/>
            </list>
        </field>
    </record>

    <record id="view_bf_absence_calendar_source_form" model="ir.ui.view">
        <field name="name">bf.absence.calendar.source.form</field>
        <field name="model">bf.absence.calendar.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_read" type="object" string="Lire maintenant"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        Le calendrier est lu, jamais écrit, et il n'entre pas dans l'agenda
                        d'Odoo. Ce qui y est trouvé est proposé, et une personne décide.
                    </div>
                    <group>
                        <group string="Où lire">
                            <field name="name"/>
                            <field name="config_key"/>
                            <field name="calendar_slug" placeholder="migrated-vacances-cts"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Quoi lire">
                            <field name="days_back"/>
                            <field name="days_ahead"/>
                            <field name="nature"/>
                        </group>
                    </group>
                    <group string="Dernière lecture">
                        <field name="last_run" readonly="1"/>
                        <field name="last_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_absence_calendar_source" model="ir.actions.act_window">
        <field name="name">Calendriers d'absences</field>
        <field name="res_model">bf.absence.calendar.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Lire un calendrier tenu à la main</p>
            <p>Le calendrier où vous notez les vacances de vos clients devient une source
               de propositions, sans rien y écrire.</p>
        </field>
    </record>

</odoo>
