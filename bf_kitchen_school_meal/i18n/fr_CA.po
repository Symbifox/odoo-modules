#. module: bf_kitchen_school_meal
#. odoo-python
#: code:addons/bf_kitchen_school_meal/models/school_meal.py:0
msgid "A meal points to a dish of the kitchen."
msgstr "Un repas renvoie à un plat de la cuisine."

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,field_description:bf_kitchen_school_meal.field_bf_school_meal_item__bf_kitchen_allergen_ids
msgid "Allergens of the dish"
msgstr "Allergènes du plat"

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,help:bf_kitchen_school_meal.field_bf_school_meal_item__bf_kitchen_allergen_ids
msgid ""
"Carried up from the recipe's ingredients; they count with the meal's own "
"allergens."
msgstr ""
"Remontés des ingrédients de la recette ; ils comptent avec les allergènes "
"propres au repas."

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,field_description:bf_kitchen_school_meal.field_bf_school_meal_item__bf_kitchen_food_cost_pct
msgid "Food cost (%)"
msgstr "Coût matière (%)"

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,field_description:bf_kitchen_school_meal.field_bf_school_meal_order__bf_kitchen_picking_id
msgid "Kitchen consumption"
msgstr "Consommation cuisine"

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,field_description:bf_kitchen_school_meal.field_bf_school_meal_item__bf_kitchen_dish_id
msgid "Kitchen dish"
msgstr "Plat de la cuisine"

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,field_description:bf_kitchen_school_meal.field_stock_picking__bf_kitchen_source
msgid "Kitchen source"
msgstr "Source cuisine"

#. module: bf_kitchen_school_meal
#: model:ir.model,name:bf_kitchen_school_meal.model_bf_kitchen_variance
msgid "Kitchen variance between two counts"
msgstr "Écart de la cuisine entre deux comptages"

#. module: bf_kitchen_school_meal
#: model:ir.actions.server,name:bf_kitchen_school_meal.ir_cron_kitchen_school_meals_ir_actions_server
msgid "Kitchen: school meals served leave the stock"
msgstr "Cuisine : les repas scolaires servis sortent du stock"

#. module: bf_kitchen_school_meal
#. odoo-python
#: code:addons/bf_kitchen_school_meal/models/school_meal.py:0
msgid "Meal cancelled after the cut-off"
msgstr "Repas annulé après l'heure limite"

#. module: bf_kitchen_school_meal
#: model:ir.model,name:bf_kitchen_school_meal.model_bf_school_meal_item
msgid "Meal on the menu"
msgstr "Repas au menu"

#. module: bf_kitchen_school_meal
#: model:ir.model,name:bf_kitchen_school_meal.model_bf_school_meal_order
msgid "Meal ordered"
msgstr "Repas commandé"

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,field_description:bf_kitchen_school_meal.field_bf_school_meal_item__bf_kitchen_cost
msgid "Plate cost"
msgstr "Coût de l'assiette"

#. module: bf_kitchen_school_meal
#: model:ir.model.fields.selection,name:bf_kitchen_school_meal.selection__stock_picking__bf_kitchen_source__school_meal
msgid "School meals"
msgstr "Repas scolaires"

#. module: bf_kitchen_school_meal
#. odoo-python
#: code:addons/bf_kitchen_school_meal/models/school_meal.py:0
msgid "The dish of a meal belongs to the school's company."
msgstr "Le plat d'un repas appartient à la société de l'école."

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,help:bf_kitchen_school_meal.field_bf_school_meal_item__bf_kitchen_dish_id
msgid ""
"The dish of the kitchen this meal is: its recipe gives the cost and the "
"allergens, and the meals served take its ingredients out of the stock."
msgstr ""
"Le plat de la cuisine qu'est ce repas : sa recette donne le coût et les "
"allergènes, et les repas servis sortent ses ingrédients du stock."

#. module: bf_kitchen_school_meal
#. odoo-python
#: code:addons/bf_kitchen_school_meal/models/school_meal.py:0
msgid "The kitchen consumption of a meal is set by the kitchen itself."
msgstr ""
"La consommation cuisine d'un repas est posée par la cuisine elle-même."

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,help:bf_kitchen_school_meal.field_bf_school_meal_order__bf_kitchen_picking_id
msgid ""
"The transfer that took this meal's ingredients out of the stock, at the "
"cancellation hour."
msgstr ""
"Le transfert qui a sorti du stock les ingrédients de ce repas, à l'heure "
"limite d'annulation."

#. module: bf_kitchen_school_meal
#: model:ir.model,name:bf_kitchen_school_meal.model_stock_picking
msgid "Transfer"
msgstr "Transfert"

#. module: bf_kitchen_school_meal
#: model:ir.model.fields,help:bf_kitchen_school_meal.field_stock_picking__bf_kitchen_source
msgid "Where a kitchen consumption comes from."
msgstr "D'où vient une consommation cuisine."
