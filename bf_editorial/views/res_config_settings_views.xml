<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_editorial" model="ir.ui.view">
        <field name="name">res.config.settings.form.editorial</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Editorial workshop" name="bf_editorial"
                     logo="/bf_editorial/static/description/icon.png">
                    <block title="Multilingual policy"
                           help="What the module considers &quot;published&quot; when an article exists in several languages.">
                        <setting id="require_all_langs"
                                 help="An article whose translation has not come out stays incomplete and does not count in the cadence. Each calendar can override this setting.">
                            <field name="bf_editorial_require_all_langs"/>
                        </setting>
                    </block>
                    <block title="Sources" help="Freshness of the cited references.">
                        <setting id="source_recheck"
                                 help="After this period, a source is considered outdated.">
                            <field name="bf_editorial_source_recheck_months"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
