<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_secaware" model="ir.ui.view">
        <field name="name">res.partner.form.secaware</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_phishing_results" type="object"
                        class="oe_stat_button" icon="fa-fish"
                        groups="bf_security_awareness.group_bf_secaware_user">
                    <field name="phishing_result_count" widget="statinfo"
                           string="Tests d'hameçonnage"/>
                </button>
                <button name="action_view_training_assignments" type="object"
                        class="oe_stat_button" icon="fa-graduation-cap"
                        groups="bf_security_awareness.group_bf_secaware_user">
                    <field name="training_assignment_count" widget="statinfo"
                           string="Formations"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
