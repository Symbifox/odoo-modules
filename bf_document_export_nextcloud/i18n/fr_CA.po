msgid ""
"A selection of documents is not deposited on Nextcloud: only a full export "
"replaces the published copy."
msgstr ""
"Une sélection de documents n'est pas déposée sur Nextcloud : seul un export "
"complet remplace la copie publiée."

#. module: bf_document_export_nextcloud
#. odoo-python
#: code:addons/bf_document_export_nextcloud/models/export_template.py:0
