<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_cx" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.bf.cx</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_bf_cx_feedback" type="object"
                        class="oe_stat_button" icon="fa-comments-o"
                        groups="bf_cx.group_bf_cx_user"
                        invisible="bf_cx_feedback_count == 0">
                    <field name="bf_cx_feedback_count" widget="statinfo" string="Feedback"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page string="Customer experience" name="bf_cx"
                      groups="bf_cx.group_bf_cx_user">
                    <group>
                        <group string="Solicitation">
                            <field name="bf_cx_last_solicited" readonly="1"/>
                            <field name="bf_cx_exclude_effective" invisible="1"/>
                        </group>
                        <group string="Account exclusion">
                            <field name="bf_cx_exclude"/>
                            <field name="bf_cx_exclude_reason"
                                   placeholder="Why this account is excluded from surveys"
                                   invisible="not bf_cx_exclude"/>
                            <field name="bf_cx_exclude_date"
                                   invisible="not bf_cx_exclude"/>
                            <field name="bf_cx_exclude_user_id"
                                   invisible="not bf_cx_exclude"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="bf_cx_exclude or not bf_cx_exclude_effective">
                        Excluded from surveys because their company is. Lifting the exclusion is done on the company's record, not here.
                    </div>
                    <div class="text-muted mt-2">
                        "Never solicit" is a decision of your organization about an account: it covers waves, post-meeting, post-loss, project ratings and ticket CSAT, and nothing else — neither invoicing nor the privacy register. Set on a company, it covers all its contacts, including those created later. Not to be confused with "Do not contact", which is an objection raised by the person themselves.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
