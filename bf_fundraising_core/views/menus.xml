<odoo>
    <!-- Rebrand the Donation app as « Levée de fonds » with the BF icon -->
    <menuitem
        id="donation.donation_top_menu"
        name="Fundraising"
        web_icon="bf_fundraising_core,static/description/icon.png"
        sequence="38"
        groups="donation.group_donation_viewer"
    />

    <!-- Constituents (donors / members / prospects) -->
    <menuitem
        id="menu_bf_constituents"
        name="Constituents"
        parent="donation.donation_top_menu"
        action="action_bf_constituents"
        sequence="4"
        groups="donation.group_donation_viewer"
    />

    <!-- Funds (top-level: central to attribution) -->
    <menuitem
        id="menu_bf_fund"
        name="Funds"
        parent="donation.donation_top_menu"
        action="action_bf_fund"
        sequence="20"
        groups="donation.group_donation_user"
    />

    <!-- Collection structure under Configuration -->
    <menuitem
        id="menu_bf_appeal"
        name="Appeals"
        parent="donation.donation_config_donation_menu"
        action="action_bf_appeal"
        sequence="32"
        groups="donation.group_donation_user"
    />
    <menuitem
        id="menu_bf_package"
        name="Packages"
        parent="donation.donation_config_donation_menu"
        action="action_bf_package"
        sequence="34"
        groups="donation.group_donation_user"
    />
    <menuitem
        id="menu_bf_solicit_code"
        name="Solicit codes"
        parent="donation.donation_config_donation_menu"
        action="action_bf_solicit_code"
        sequence="36"
        groups="donation.group_donation_manager"
    />
</odoo>
