<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bf_route_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bf_route_sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_route.res_config_settings_view_form_bf_route"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='bf_route_engine']" position="before">
                <block title="Payments on the road" name="bf_route_payments">
                    <setting string="Journals" help="Where the payments recorded on the phone go. Empty = the first cash or bank journal.">
                        <div class="row"><label for="bf_route_cash_journal_id" class="col-lg-4"/><field name="bf_route_cash_journal_id"/></div>
                        <div class="row"><label for="bf_route_cheque_journal_id" class="col-lg-4"/><field name="bf_route_cheque_journal_id"/></div>
                        <div class="row"><label for="bf_route_card_journal_id" class="col-lg-4"/><field name="bf_route_card_journal_id"/></div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
