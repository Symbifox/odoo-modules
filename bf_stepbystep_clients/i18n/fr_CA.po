#. module: bf_stepbystep_clients
#: model:mail.template,body_html:bf_stepbystep_clients.mail_template_progression_notice
msgid ""
"<div style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:15px; line-height:24px; color:#374151;\">\n"
"    <t t-foreach=\"ctx.get('bf_avis_lignes') or []\" t-as=\"ligne\">\n"
"        <p style=\"margin:0 0 12px 0; font-size:15px; line-height:24px; color:#374151;\"><t t-out=\"ligne\"/></p>\n"
"    </t>\n"
"    <p t-if=\"ctx.get('bf_avis_url')\" style=\"margin:16px 0 0 0;\">\n"
"        <a t-att-href=\"ctx.get('bf_avis_url')\" style=\"display:inline-block; padding:10px 18px; border-radius:6px; background-color:#212529; color:#FFFFFF; text-decoration:none; font-size:14px;\"><t t-out=\"ctx.get('bf_avis_bouton') or ''\"/></a>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

#. module: bf_stepbystep_clients
#. odoo-python
#: code:addons/bf_stepbystep_clients/models/progression_otp.py:0
msgid ""
"<p>Hello,</p><p>Your access code for the progress page of your mandate is "
"<strong style=\"font-size:1.4em;letter-"
"spacing:.1em\">%(code)s</strong></p><p>It expires in %(minutes)s minutes. If"
" you did not ask for this code, you can ignore this message.</p>"
msgstr ""
"<p>Bonjour,</p><p>Votre code d'accès à la page de suivi de votre mandat est "
"<strong style=\"font-size:1.4em;letter-"
"spacing:.1em\">%(code)s</strong></p><p>Il expire dans %(minutes)s minutes. "
"Si vous n'avez pas demandé ce code, vous pouvez ignorer ce message.</p>"

