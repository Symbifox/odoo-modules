<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="credential_vault_view_list" model="ir.ui.view">
        <field name="name">project.credential.vault.list</field>
        <field name="model">project.credential.vault</field>
        <field name="arch" type="xml">
            <list string="Second-factor holders">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="shared"/>
                <field name="base_url" widget="url" optional="hide"/>
                <field name="credential_count" string="Credentials"/>
            </list>
        </field>
    </record>

    <record id="credential_vault_view_form" model="ir.ui.view">
        <field name="name">project.credential.vault.form</field>
        <field name="model">project.credential.vault</field>
        <field name="arch" type="xml">
            <form string="Second-factor holder">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_credentials" type="object"
                                class="oe_stat_button" icon="fa-key">
                            <field name="credential_count" widget="statinfo" string="Credentials"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Team vault"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="shared"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="base_url" widget="url"
                                   placeholder="https://vault.example.com"/>
                            <field name="item_url_pattern"
                                   placeholder="https://vault.example.com/#/vault?itemId={ref}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        This model says <strong>where</strong> a second factor lives, never what it contains. The link template leads to the item at its holder; no seed comes in here.
                    </div>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="What you need to know to access it..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="credential_vault_view_search" model="ir.ui.view">
        <field name="name">project.credential.vault.search</field>
        <field name="model">project.credential.vault</field>
        <field name="arch" type="xml">
            <search string="Second-factor holders">
                <field name="name"/>
                <field name="kind"/>
                <filter string="Shared access" name="filter_shared"
                        domain="[('shared', '=', True)]"/>
                <filter string="Held by one person" name="filter_not_shared"
                        domain="[('shared', '=', False)]"/>
                <separator/>
                <filter string="Archived holders" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter string="Kind" name="group_kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="credential_vault_action" model="ir.actions.act_window">
        <field name="name">Second-factor holders</field>
        <field name="res_model">project.credential.vault</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="credential_vault_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Declare a holder
            </p>
            <p>
                A holder is a place where a second factor lives: a team vault, an authenticator app, someone's phone, a hardware token. The register says where to look; it keeps no secret.
            </p>
        </field>
    </record>

</odoo>
