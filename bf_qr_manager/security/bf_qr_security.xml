<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Les assistants sont ouverts à tout usager des pastilles : c'est la
         méthode d'association qui contrôle, avec les groupes de la société.
         Un droit d'accès au modèle ne donne donc rien par lui-même. -->
    <record id="regle_lot_societe" model="ir.rule">
        <field name="name">Lots d'étiquettes QR : cloison des sociétés</field>
        <field name="model_id" ref="model_bf_qr_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
