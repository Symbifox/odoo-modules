#. module: bf_school_conduct
#: model:mail.template,body_html:bf_school_conduct.mail_template_followup
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\" t-out=\"object.summary or ''\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/conduct\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            See the follow-up\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\" t-out=\"object.summary or ''\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/conduct\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Voir le suivi\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: bf_school_conduct
#: model:mail.template,body_html:bf_school_conduct.mail_template_incident
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The school informs you of a situation concerning <strong t-out=\"object.student_id.name or ''\"/>: <t t-out=\"object.rule_id.name or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The details and the measures taken are in the family portal. To talk about it, contact the school office.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/conduct\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            See the follow-up\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">L'école vous informe d'une situation concernant <strong t-out=\"object.student_id.name or ''\"/>: <t t-out=\"object.rule_id.name or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Les détails et les mesures prises sont dans le portail des familles. Pour en parler, contactez le secrétariat.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/conduct\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Voir le suivi\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

