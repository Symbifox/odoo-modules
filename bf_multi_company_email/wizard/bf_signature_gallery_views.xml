<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_signature_gallery_view_form" model="ir.ui.view">
        <field name="name">bf.signature.gallery.form</field>
        <field name="model">bf.signature.gallery</field>
        <field name="arch" type="xml">
            <form string="Choose a signature model">
                <field name="can_set_company" invisible="1"/>
                <field name="user_id" invisible="1"/>
                <div class="oe_title">
                    <h2>Signature models</h2>
                    <p class="text-muted">
                        Every preview is rendered with <b>your</b> data: your name, your title, your phone numbers, your links. Nothing is saved until you choose.
                    </p>
                </div>
                <div class="alert alert-info" role="alert"
                     invisible="not is_locked">
                    <field name="is_locked" invisible="1"/>
                    Your company enforces its signature: you can look, not change. Your pronouns, your title and your links stay editable and fall back into place on their own.
                </div>
                <group>
                    <group>
                        <field name="scope" widget="radio"
                               readonly="is_locked"/>
                    </group>
                    <group>
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="false" delete="false" editable="bottom"
                          decoration-success="is_current">
                        <field name="template_id" column_invisible="1"/>
                        <field name="selected" string="" widget="boolean_toggle"/>
                        <field name="name" readonly="1"/>
                        <field name="is_current" string="Current" readonly="1"
                               widget="boolean_toggle"/>
                        <field name="preview" string="Preview" readonly="1"
                               widget="html"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object"
                            string="Use this model"
                            class="btn-primary"
                            invisible="is_locked"/>
                    <button name="action_reset_to_company" type="object"
                            string="Return to the company model"
                            class="btn-secondary"
                            invisible="is_locked or scope == 'company'"/>
                    <button string="Close" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bf_signature_gallery" model="ir.actions.act_window">
        <field name="name">Signature models</field>
        <field name="res_model">bf.signature.gallery</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bf_signature_gallery"
              name="Signature models"
              parent="bf_email_management.menu_bf_email_config"
              action="action_bf_signature_gallery"
              sequence="19"/>

</odoo>
