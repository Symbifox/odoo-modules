<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- 🔴 Un avis nomme le locataire et dit ce qu'on lui demande : même
             sensibilité que le bail, donc même cloisonnement. Le défaut oublié
             sur bf.rental.lease, trouvé à la sonde, ne se
             reproduit pas ici. -->
        <record id="rule_rental_notice_company" model="ir.rule">
            <field name="name">Avis : multi-société</field>
            <field name="model_id" ref="model_bf_rental_notice"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- ⚠️ PAS de règle société sur le moratoire, et c'est délibéré : l'état
             d'une loi du Québec ne dépend pas de la société qui le lit. Une
             règle ici forcerait chaque société à tenir son propre constat du
             même texte, et elles divergeraient. -->

    </data>
</odoo>
