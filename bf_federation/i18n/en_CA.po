#: code:addons/bf_federation/models/federation_peer.py:0
msgid ""
"<p>%(nous)s vous invite à fédérer votre Symbifox avec le sien : les objets "
"partagés d'un côté paraissent chez l'autre, sans que personne ait besoin "
"d'un compte chez l'autre.</p><p>Dans votre Symbifox, <i>Fédération › "
"Accepter une invitation</i> :</p><ul><li>Adresse : "
"<code>%(url)s</code></li><li>Code : <code>%(code)s</code></li></ul><p>Le "
"code ne sert qu'une fois et expire le %(fin)s.</p>"
msgstr ""
"<p>%(nous)s invites you to federate your Symbifox with theirs: objects "
"shared on one side appear on the other, without anyone needing an account on"
" the other side.</p><p>In your Symbifox, <i>Federation › Accept an "
"invitation</i>:</p><ul><li>Address: <code>%(url)s</code></li><li>Code: "
"<code>%(code)s</code></li></ul><p>The code works once and expires on "
"%(fin)s.</p>"

#. module: bf_federation
#. odoo-python
#: code:addons/bf_federation/models/project_task.py:0
