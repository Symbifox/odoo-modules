#. module: bf_property_lobby
#: model:mail.template,body_html:bf_property_lobby.mail_template_lobby_notify
msgid ""
"<t t-set=\"company\" t-value=\"object.company_id or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and 'report_brand_primary' in company._fields and company.report_brand_primary) or '#714B67'\"/>\n"
"<div style=\"margin:0;padding:0;\">\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\"><t t-out=\"ctx.get('lobby_summary') or ''\"/></p>\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\"><t t-out=\"object.building_id.name or ''\"/></p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 20px 0;\">\n"
"        <tbody>\n"
"            <tr>\n"
"                <td t-attf-style=\"border-radius:10px;background-color:{{ brand_primary }};text-align:center;\">\n"
"                    <a t-att-href=\"ctx.get('lobby_link')\" style=\"display:inline-block;padding:12px 24px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none !important;\">Ouvrir dans Odoo</a>\n"
"                </td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">Vous recevez ce courriel parce que cette tablette prévient aussi par courriel. Le gestionnaire le règle sur la fiche de la tablette.</p>\n"
"</div>\n"
"        "
msgstr ""
"<t t-set=\"company\" t-value=\"object.company_id or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and 'report_brand_primary' in company._fields and company.report_brand_primary) or '#714B67'\"/>\n"
"<div style=\"margin:0;padding:0;\">\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\"><t t-out=\"ctx.get('lobby_summary') or ''\"/></p>\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\"><t t-out=\"object.building_id.name or ''\"/></p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 20px 0;\">\n"
"        <tbody>\n"
"            <tr>\n"
"                <td t-attf-style=\"border-radius:10px;background-color:{{ brand_primary }};text-align:center;\">\n"
"                    <a t-att-href=\"ctx.get('lobby_link')\" style=\"display:inline-block;padding:12px 24px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none !important;\">Open in Odoo</a>\n"
"                </td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">You are receiving this email because this tablet also notifies by email. The manager sets this on the tablet's record.</p>\n"
"</div>\n"
"        "

