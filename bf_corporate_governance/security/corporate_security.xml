<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Catégorie de module pour la liste déroulante des droits.

             Créée par project_knowledge_matrix jusqu'à sa 18.0.11.5.0, puis
             réattribuée à ce module par sa migration 18.0.12.0.0. L'ID externe
             ne change pas de NOM, seulement de module : les utilisateurs qui
             portaient déjà le groupe le gardent. -->
        <record id="module_category_corporate" model="ir.module.category">
            <field name="name">Gouvernance corporative</field>
            <field name="sequence">33</field>
        </record>

        <!-- Un seul groupe : la gouvernance corporative n'a pas d'échelle
             utilisateur/gestionnaire. Elle se lit à deux niveaux — les
             utilisateurs de documents lisent, le gestionnaire corporatif
             écrit — et le second implique le premier par le gestionnaire de
             documents. -->
        <record id="group_corporate_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="comment">Accès complet aux fonctionnalités de gouvernance corporative (résolutions, administrateurs, dirigeants, conformité).</field>
            <field name="category_id" ref="module_category_corporate"/>
            <field name="implied_ids" eval="[(4, ref('project_knowledge_matrix.group_document_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
