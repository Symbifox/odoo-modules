<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Même cloisonnement multi-société que le socle : un gestionnaire ne
             voit que les budgets des sociétés qui lui sont ouvertes. -->
        <record id="rule_property_budget_company" model="ir.rule">
            <field name="name">Budgets : multi-société</field>
            <field name="model_id" ref="model_bf_property_budget"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_property_fund_call_company" model="ir.rule">
            <field name="name">Appels de fonds : multi-société</field>
            <field name="model_id" ref="model_bf_property_fund_call"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_property_payment_company" model="ir.rule">
            <field name="name">Encaissements : multi-société</field>
            <field name="model_id" ref="model_bf_property_payment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- L'état nomme le proposant acquéreur, le propriétaire et les
             dettes de ce dernier : renseignements personnels, cloisonnement
             non optionnel. -->
        <record id="rule_charge_statement_company" model="ir.rule">
            <field name="name">États des charges : multi-société</field>
            <field name="model_id" ref="model_bf_property_charge_statement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
