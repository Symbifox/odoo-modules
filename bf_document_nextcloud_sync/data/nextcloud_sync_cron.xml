<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: Check NC file modifications (daily at 6 AM) -->
        <record id="ir_cron_check_nc_modifications" model="ir.cron">
            <field name="name">Documents: Verifier modifications Nextcloud</field>
            <field name="model_id" ref="project_knowledge_matrix.model_project_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_nc_modifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
