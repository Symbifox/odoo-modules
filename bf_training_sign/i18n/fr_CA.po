#. module: bf_training_sign
#: model_terms:ir.ui.view,arch_db:bf_training_sign.view_document_distribution_form_training
msgid ""
"The acknowledgement of this distribution will write a line in the training register.\n"
"                    If a signature is required, nothing is recorded while it is missing."
msgstr ""
"L'accusé de cette remise écrira une ligne au registre de formation.\n"
"                    Si une signature est exigée, rien n'est consigné tant qu'elle manque."

#. module: bf_training_sign
#: model:ir.model.fields,help:bf_training_sign.field_bf_training_record__document_version_id
msgid ""
"The exact version the person confirmed having read. It is what decides "
"whether the acknowledgement still holds."
msgstr ""
"La version exacte que la personne a confirmé avoir lue. C'est elle qui "
"décide si l'accusé vaut encore."

#. module: bf_training_sign
#: model:ir.model.fields,help:bf_training_sign.field_bf_training_activity__document_id
#: model:ir.model.fields,help:bf_training_sign.field_bf_training_assignment__document_id
msgid ""
"The policy or the procedure whose reading counts as training. Each module of"
" an onboarding process has its own."
msgstr ""
"La politique ou la procédure dont la lecture vaut formation. Chaque module "
"d'un processus d'accueil a le sien."

#. module: bf_training_sign
#: model:ir.model.constraint,message:bf_training_sign.constraint_bf_training_activity_document_unique
msgid "This document is already linked to an activity."
msgstr "Ce document est déjà adossé à une activité."

#. module: bf_training_sign
#: model:ir.model.fields,field_description:bf_training_sign.field_bf_training_record__document_version_number
msgid "Version number"
msgstr "Numéro de version"

#. module: bf_training_sign
#: model:ir.model.fields,field_description:bf_training_sign.field_bf_training_record__document_version_id
msgid "Version read"
msgstr "Version lue"

#. module: bf_training_sign
#. odoo-python
