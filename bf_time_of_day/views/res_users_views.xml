<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_users_view_form_inherit_bf_time_of_day" model="ir.ui.view">
        <field name="name">res.users.form.inherit.bf.time.of.day</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Plages horaires" name="bf_time_of_day_prefs">
                    <p class="text-muted">
                        Pour chaque plage, je peux fixer mon heure personnelle. Elle
                        remplace l'heure suggérée par l'admin quand je sélectionne la
                        plage sur une tâche.
                    </p>
                    <field name="bf_time_of_day_pref_ids">
                        <list editable="bottom">
                            <field name="time_of_day_id"/>
                            <field name="override_time" widget="float_time"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
