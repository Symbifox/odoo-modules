<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Modèle d'export : Services d'hébergement - Complet -->
        <record id="export_hosting_service_full" model="ir.exports">
            <field name="name">Services d'hébergement - Export complet</field>
            <field name="resource">hosting.service</field>
        </record>

        <!-- Champs d'export pour l'export complet des services -->
        <record id="export_line_service_code" model="ir.exports.line">
            <field name="export_id" ref="export_hosting_service_full"/>
            <field name="name">code</field>
        </record>
        <record id="export_line_service_name" model="ir.exports.line">
            <field name="export_id" ref="export_hosting_service_full"/>
