<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_absence_closure_wizard_form" model="ir.ui.view">
        <field name="name">bf.absence.closure.wizard.form</field>
        <field name="model">bf.absence.closure.wizard</field>
        <field name="arch" type="xml">
            <form string="Seed a known shutdown">
                <div class="alert alert-info" role="status">
                    Québec's construction holidays are published a year ahead by the CCQ. A client in that industry therefore closes on a known date, which no auto-reply needs to tell us.
                </div>
                <group>
                    <group string="Which shutdown">
                        <field name="closure"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Where">
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="industry_id" options="{'no_create': True}"/>
                        <field name="only_with_contacts"/>
                        <field name="reminder"/>
                    </group>
                </group>
                <footer>
                    <button name="action_seed" type="object" string="Seed"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bf_absence_closure_wizard" model="ir.actions.act_window">
        <field name="name">Seed a known shutdown</field>
        <field name="res_model">bf.absence.closure.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
