<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bf_outreach_tag_list" model="ir.ui.view">
        <field name="name">bf.outreach.tag.list</field>
        <field name="model">bf.outreach.tag</field>
        <field name="arch" type="xml">
            <list string="Étiquettes" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_bf_outreach_tag" model="ir.actions.act_window">
        <field name="name">Étiquettes</field>
        <field name="res_model">bf.outreach.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer une étiquette</p>
            <p>Les étiquettes servent à segmenter les cibles : secteur, taille, provenance…</p>
        </field>
    </record>

</odoo>
