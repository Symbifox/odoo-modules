<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_mass_note_wizard_view_form" model="ir.ui.view">
        <field name="name">bf.mass.note.wizard.form</field>
        <field name="model">bf.mass.note.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter une note en lot">
                <group>
                    <field name="model_name" invisible="1"/>
                    <field name="model_label" string="Modèle" readonly="1"/>
                    <field name="record_count" string="Enregistrements sélectionnés" readonly="1"/>
                    <field name="post_type" widget="radio"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="post_type != 'comment'">
                    Un « Message » sera publié sur le fil de chaque enregistrement sélectionné et
                    notifiera ses abonnés. Selon la configuration, ceci peut générer des courriels.
                </div>
                <field name="confirm_message" invisible="post_type != 'comment'"/>
                <separator string="Contenu"/>
                <field name="body" nolabel="1"
                       placeholder="Saisissez la note à publier sur tous les enregistrements sélectionnés…"/>
                <footer>
                    <button name="action_post" string="Publier" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
