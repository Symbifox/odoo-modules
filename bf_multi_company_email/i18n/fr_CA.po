"                                </tr></tbody>\n"
"                            </table>\n"
"                            <div t-if=\"sig['tagline']\" t-attf-style=\"margin-top:6px;font-size:11px;color:{{ sig['muted'] }};\"><t t-out=\"sig['tagline']\"/></div>\n"
"                        </td>\n"
"                    </tr></tbody>\n"
"                </table>\n"
"                <!-- Avertissement : tableau &#224; part, aucune cellule &#233;tal&#233;e (18.0.5.2.0).\n"
