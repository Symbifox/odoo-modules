<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_note_user_pref_view_form" model="ir.ui.view">
        <field name="name">bf.note.user.preferences.form</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Notepad preferences">
                <sheet>
                    <group>
                        <field name="bf_note_default_reminder"/>
                    </group>
                    <p class="text-muted">
                        This reminder will be preselected in the quick creation dialog
                        (systray icon or <kbd>Alt+N</kbd>). You can still change it
                        when creating.
                    </p>
                </sheet>
                <footer>
                    <button string="Save" type="object"
                            name="action_open_bf_note_preferences"
                            class="btn-primary" special="save"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bf_note_user_pref_action" model="ir.actions.server">
        <field name="name">My preferences</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env.user.action_open_bf_note_preferences()</field>
    </record>

</odoo>
