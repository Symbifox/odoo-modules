<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_nextcloud_contacts_sync_config_tree" model="ir.ui.view">
        <field name="name">nextcloud.contacts.sync.config.list</field>
        <field name="model">nextcloud.contacts.sync.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="nextcloud_user"/>
                <field name="sync_direction"/>
                <field name="exclude_tag_id"/>
                <field name="contact_count"/>
                <field name="last_sync"/>
                <field name="last_sync_status" widget="badge"
                    decoration-success="last_sync_status == 'success'"
                    decoration-danger="last_sync_status == 'error'"
                    decoration-warning="last_sync_status == 'partial'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nextcloud_contacts_sync_config_form" model="ir.ui.view">
        <field name="name">nextcloud.contacts.sync.config.form</field>
        <field name="model">nextcloud.contacts.sync.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_push_to_nextcloud" type="object"
                        string="Push to Nextcloud" class="btn-primary"
                        invisible="sync_direction == 'nc_to_odoo'"/>
                    <button name="action_pull_from_nextcloud" type="object"
                        string="Pull from Nextcloud" class="btn-primary"
                        invisible="sync_direction == 'odoo_to_nc'"/>
                    <button name="action_test_connection" type="object"
                        string="Test Connection" class="btn-secondary"/>
                    <button name="action_force_full_resync" type="object"
                        string="Force Full Resync" class="btn-secondary"
                        confirm="This will clear all ETags and re-sync all contacts. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contacts" type="object"
                            class="oe_stat_button" icon="fa-address-book">
                            <field name="contact_count" widget="statinfo" string="Contacts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Nextcloud Contacts"/>
                        </h1>
                    </div>
                    <group>
                        <group name="nextcloud" string="Nextcloud Configuration">
                            <field name="nextcloud_base_url"
                                placeholder="https://nextcloud.example.com"/>
                            <field name="carddav_path"
                                placeholder="/remote.php/dav/addressbooks/users/jdoe/contacts/"/>
                            <field name="nextcloud_user"/>
                            <field name="nextcloud_app_password" password="True"/>
                        </group>
                        <group name="sync" string="Sync Settings">
                            <field name="sync_direction"/>
                            <field name="exclude_tag_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group name="status" string="Sync Status" invisible="not last_sync">
                        <group>
                            <field name="last_sync"/>
                            <field name="last_sync_status" widget="badge"
                                decoration-success="last_sync_status == 'success'"
                                decoration-danger="last_sync_status == 'error'"
                                decoration-warning="last_sync_status == 'partial'"/>
                        </group>
                        <group>
                            <field name="last_sync_message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_nextcloud_contacts_sync_config_search" model="ir.ui.view">
        <field name="name">nextcloud.contacts.sync.config.search</field>
        <field name="model">nextcloud.contacts.sync.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nextcloud_user"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="bidirectional" string="Bidirectional"
                    domain="[('sync_direction', '=', 'both')]"/>
                <filter name="nc_to_odoo" string="NC → Odoo"
                    domain="[('sync_direction', '=', 'nc_to_odoo')]"/>
                <filter name="odoo_to_nc" string="Odoo → NC"
                    domain="[('sync_direction', '=', 'odoo_to_nc')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="Nextcloud User"
                        context="{'group_by': 'nextcloud_user'}"/>
                    <filter name="group_direction" string="Sync Direction"
                        context="{'group_by': 'sync_direction'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nextcloud_contacts_sync_config" model="ir.actions.act_window">
        <field name="name">Nextcloud Address Books</field>
        <field name="res_model">nextcloud.contacts.sync.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nextcloud_contacts_sync_config_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Nextcloud address books for contact synchronization
            </p>
            <p>
                Add Nextcloud CardDAV address books to sync contacts between Odoo and Nextcloud.
                Only contacts with the configured tag will be synchronized.
            </p>
        </field>
    </record>
</odoo>
