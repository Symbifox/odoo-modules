<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="bf_process.Visualiseur">
    <div class="o_bf_process_visualiseur"
         t-att-class="{ 'o_bf_process_plein': state.plein }">
        <div t-if="state.erreur" class="alert alert-info m-2" role="status">
            <t t-esc="state.erreur"/>
        </div>
        <t t-elif="state.donnees">
            <div class="o_bf_process_barre">
                <select t-if="state.donnees.niveaux.length > 1"
                        class="form-select form-select-sm o_bf_process_choix"
                        t-on-change="changerNiveau">
                    <option t-foreach="state.donnees.niveaux" t-as="n" t-key="n.id"
                            t-att-value="n.id"
                            t-att-selected="n.id === state.donnees.niveau_id"
                            t-esc="n.titre"/>
                </select>
                <span t-else="" class="o_bf_process_titre"
                      t-esc="state.donnees.titre"/>
                <span t-if="state.donnees.gele" class="badge text-bg-secondary"
                      title="Une version validée ne se modifie plus. Rouvrez-la, ou créez la suivante.">
                    Version validée · lecture seule
                </span>
                <span t-if="state.donnees.delta" class="o_bf_process_delta"
                      t-esc="state.donnees.delta"/>
                <span class="flex-grow-1"/>
                <div t-if="state.donnees.modifiable" class="btn-group btn-group-sm"
                     role="group" aria-label="Outils d'édition">
                    <button t-foreach="outils" t-as="o" t-key="o.code"
                            type="button" class="btn"
                            t-att-class="state.outil === o.code ? 'btn-primary' : 'btn-light'"
                            t-att-title="o.aide"
                            t-att-disabled="state.occupe"
                            t-on-click="() => this.choisirOutil(o.code)"
                            t-esc="o.nom"/>
                </div>
                <select t-if="state.donnees.modifiable and state.outil === 'poser'"
                        class="form-select form-select-sm o_bf_process_genre"
                        t-model="state.genre">
                    <option t-foreach="state.donnees.palette" t-as="g" t-key="g.code"
                            t-att-value="g.code" t-esc="g.nom"/>
                </select>
                <button class="btn btn-sm btn-light" t-on-click="() => this.zoomer(-0.2)"
                        title="Réduire">−</button>
                <span class="o_bf_process_zoom"
                      t-esc="Math.round(state.zoom * 100) + ' %'"/>
                <button class="btn btn-sm btn-light" t-on-click="() => this.zoomer(0.2)"
                        title="Agrandir (Ctrl + molette)">+</button>
                <button class="btn btn-sm btn-light" t-on-click="() => this.ajuster()"
                        title="Ajuster à la largeur">Ajuster</button>
                <button class="btn btn-sm btn-light" t-on-click="() => this.telecharger()"
                        title="Télécharger le tracé en SVG">SVG</button>
                <button class="btn btn-sm btn-primary" t-on-click="() => this.plein_ecran()"
                        t-att-title="state.plein ? 'Quitter le plein écran' : 'Plein écran'">
                    <t t-esc="state.plein ? 'Réduire' : 'Plein écran'"/>
                </button>
            </div>
            <div t-if="state.donnees.modifiable and state.outil !== 'consulter'"
                 class="o_bf_process_aide">
                <t t-esc="aideOutil"/>
                <t t-if="state.depuis">
                    <t t-esc="' — origine prise : ' + state.depuis"/>
                </t>
            </div>
            <div class="o_bf_process_toile" t-ref="toile"
                 t-att-class="'o_bf_process_outil_' + state.outil"
                 t-on-wheel="surMolette"
                 t-on-mousedown="debutGlisse"
                 t-on-mousemove="surGlisse"
                 t-on-mouseup="finGlisse"
                 t-on-mouseleave="annulerGlisse"
                 t-on-click="surClicFond">
                <svg t-ref="svg"
                     t-att-width="state.donnees.largeur * state.zoom"
                     t-att-height="state.donnees.hauteur * state.zoom"
                     t-att-viewBox="'0 0 ' + state.donnees.largeur + ' ' + state.donnees.hauteur"
                     xmlns="http://www.w3.org/2000/svg">
                    <t t-foreach="elements" t-as="e" t-key="e_index">
                        <rect t-if="e.t === 'rect'" t-att-x="e.x" t-att-y="e.y"
                              t-att-width="e.w" t-att-height="e.h"
                              t-att-rx="e.r or 0" t-att-fill="e.fill"
                              t-att-stroke="e.stroke" t-att-stroke-width="e.sw"/>
                        <circle t-if="e.t === 'cercle'" t-att-cx="e.cx" t-att-cy="e.cy"
                                t-att-r="e.r" t-att-fill="e.fill"
                                t-att-stroke="e.stroke" t-att-stroke-width="e.sw"/>
                        <polyline t-if="e.t === 'ligne'" t-att-points="points(e.pts)"
                                  fill="none" t-att-stroke="e.stroke"
                                  t-att-stroke-width="e.sw"
                                  t-att-stroke-dasharray="e.tirets"/>
                        <polygon t-if="e.t === 'poly'" t-att-points="points(e.pts)"
                                 t-att-fill="e.fill" t-att-stroke="e.stroke"
                                 t-att-stroke-width="e.sw"/>
                        <t t-if="e.t === 'bloc'">
                            <t t-foreach="lignes(e)" t-as="l" t-key="l_index">
                                <text t-att-x="e.x" t-att-y="l.y"
                                      t-att-text-anchor="e.ancre or 'middle'"
                                      t-att-font-size="e.taille"
                                      t-att-font-weight="e.gras ? 600 : 400"
                                      t-att-fill="e.couleur"
                                      font-family="Lexend, sans-serif"
                                      t-esc="l.s"/>
                            </t>
                        </t>
                        <polyline t-if="e.t === 'lien'" t-att-points="points(e.pts)"
                                  fill="none" stroke="transparent"
                                  stroke-width="12" data-rid="lien"
                                  class="o_bf_process_lien"
                                  t-on-click="(ev) => this.surClicFlux(e.f, ev)">
                            <title>Couper ce lien</title>
                        </polyline>
                        <rect t-if="e.t === 'fantome'" t-att-x="e.x" t-att-y="e.y"
                              t-att-width="e.w" t-att-height="e.h"
                              fill="none" stroke="#29ABE1" stroke-width="1.4"
                              stroke-dasharray="5 3" pointer-events="none"/>
                        <rect t-if="e.t === 'zone'" t-att-x="e.x" t-att-y="e.y"
                              t-att-width="e.w" t-att-height="e.h"
                              fill="transparent" class="o_bf_process_zone"
                              t-att-class="{ 'o_bf_process_pris': e.pris }"
                              t-att-data-rid="e.n.rid"
                              t-on-mousedown="(ev) => this.debutDeplacement(e.n, ev)"
                              t-on-click="(ev) => this.surClicNoeud(e.n, ev)">
                            <title t-esc="this.infobulle(e.n)"/>
                        </rect>
                        <text t-if="e.t === 'vtexte'" t-att-x="e.x" t-att-y="e.y"
                              text-anchor="middle" t-att-font-size="e.taille"
                              t-att-font-weight="e.gras ? 600 : 400" fill="#2D3031"
                              font-family="Lexend, sans-serif"
                              t-att-transform="'rotate(-90 ' + e.x + ' ' + e.y + ')'"
                              t-esc="e.s"/>
                    </t>
                </svg>
            </div>
        </t>
    </div>
</t>

</templates>
