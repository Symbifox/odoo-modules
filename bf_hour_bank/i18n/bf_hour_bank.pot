#. module: bf_hour_bank
#: model:mail.template,body_html:bf_hour_bank.email_template_hour_bank_report
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"></t>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"></t>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"></t>\n"
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#F8FAFC;\">\n"
"    <tbody>\n"
"        <tr>\n"
"            <td align=\"center\" style=\"padding:24px;\">\n"
"                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" align=\"center\" role=\"presentation\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td>\n"
"                                <br>\n"
"                                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;\">\n"
"                                    <tbody>\n"
"                                        <!-- En-t&#234;te -->\n"
"                                        <tr>\n"
"                                            <td t-attf-style=\"background-color:{{ brand_dark }}; padding:16px 24px; border-radius:12px 12px 0 0;\">\n"
"                                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                                    <tbody>\n"
"                                                        <tr>\n"
"                                                            <td align=\"left\" style=\"color:#FFFFFF; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:16px; font-weight:600;\">\n"
"                                                                <a t-attf-href=\"{{ company.website or object.get_base_url() }}\" style=\"text-decoration:none;\">\n"
"                                                                    <img t-attf-src=\"/brand/logo/{{ company.id }}\" t-att-alt=\"company.name or 'Logo'\" style=\"height:48px; width:auto; display:block; border:0;\">\n"
"                                                                </a>\n"
"                                                            </td>\n"
"                                                            <td align=\"right\" style=\"color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;\">\n"
"                                                                Hour bank\n"
"                                                            </td>\n"
"                                                        </tr>\n"
"                                                    </tbody>\n"
"                                                </table>\n"
"                                            </td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- Barre d'accentuation -->\n"
"                                        <tr>\n"
"                                            <td t-attf-style=\"height:4px; line-height:4px; background-color:{{ brand_primary }};\">&amp;nbsp;</td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- Contenu -->\n"
"                                        <tr>\n"
"                                            <td style=\"padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif;\">\n"
"                                                <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">\n"
"                                                    Hello,\n"
"                                                </p>\n"
"                                                <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;\">\n"
"                                                    Please find attached the hour bank statement for\n"
"                                                    <strong><t t-out=\"object.partner_id.name\"></t></strong>.\n"
"                                                </p>\n"
"                                                <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;\">\n"
"                                                    The PDF and Excel files are attached.\n"
"                                                </p>\n"
"                                                <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0;\">\n"
"                                                    Kind regards,<br>\n"
"                                                    <t t-out=\"user.name\"></t>\n"
"                                                </p>\n"
"                                                <p style=\"font-size:13px; line-height:20px; color:#6B7280; margin:16px 0 0 0;\">\n"
"                                                    If you have any questions, contact us at\n"
"                                                    <a t-attf-href=\"mailto:{{ company.email or 'service@example.com' }}\" t-attf-style=\"color:{{ brand_primary }}; text-decoration:none;\"><t t-out=\"company.email or 'service@example.com'\"></t></a>\n"
"                                                    or call\n"
"                                                    <a t-attf-href=\"tel:{{ company.phone or '+15555555555' }}\" t-attf-style=\"color:{{ brand_primary }}; text-decoration:none;\"><t t-out=\"company.phone or '555-555-5555'\"></t></a>.\n"
"                                                </p>\n"
"                                            </td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- S&#233;parateur -->\n"
"                                        <tr>\n"
"                                            <td style=\"height:1px; line-height:1px; background-color:#E5E7EB;\">&amp;nbsp;</td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- Pied de page -->\n"
"                                        <tr>\n"
"                                            <td style=\"padding:16px 24px 24px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;\">\n"
"                                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                                    <tbody>\n"
"                                                        <tr>\n"
"                                                            <td style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280;\">\n"
"                                                                <strong t-attf-style=\"color:{{ brand_dark }};\">Hour bank by <t t-out=\"company.name\"></t></strong><br>\n"
"                                                                Automatic tracking of hours consumed vs. hours allocated.\n"
"                                                            </td>\n"
"                                                            <td align=\"right\" style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#9CA3AF;\">\n"
"                                                                <a t-if=\"company and 'brand_privacy_url' in company and company.brand_privacy_url\" t-attf-href=\"{{ company.brand_privacy_url }}\" style=\"color:#9CA3AF; text-decoration:underline;\">Privacy policy</a>\n"
"                                                                <span t-if=\"company and 'brand_privacy_url' in company and company.brand_privacy_url and company and 'brand_terms_url' in company and company.brand_terms_url\" style=\"color:#9CA3AF;\"> | </span>\n"
"                                                                <a t-if=\"company and 'brand_terms_url' in company and company.brand_terms_url\" t-attf-href=\"{{ company.brand_terms_url }}\" style=\"color:#9CA3AF; text-decoration:underline;\">Terms</a>\n"
"                                                            </td>\n"
"                                                        </tr>\n"
"                                                    </tbody>\n"
"                                                </table>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </tbody>\n"
"                                </table>\n"
"\n"
"                                <!-- Barre d'accentuation inf&#233;rieure -->\n"
"                                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:12px auto 0;\">\n"
"                                    <tbody>\n"
"                                        <tr>\n"
"                                            <td t-attf-style=\"height:3px; line-height:3px; background-color:{{ brand_primary }}; width:50%;\">&amp;nbsp;</td>\n"
"                                            <td t-attf-style=\"height:3px; line-height:3px; background-color:{{ brand_dark }}; width:50%;\">&amp;nbsp;</td>\n"
"                                        </tr>\n"
"                                    </tbody>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </td>\n"
"        </tr>\n"
"    </tbody>\n"
"</table>"
msgstr ""

