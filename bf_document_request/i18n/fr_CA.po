#. module: bf_document_request
#: model_terms:ir.ui.view,arch_db:bf_document_request.bf_document_request_view_form
msgid ""
"This link IS the key to the upload: it was sent to the\n"
"                                client, by email or by text message, and should not travel\n"
"                                any other way. Cancelling the request kills it on the spot."
msgstr ""
"Ce lien EST la clé du dépôt : il a été envoyé au client, par\n"
"                                courriel ou par SMS, et ne devrait pas circuler autrement.\n"
"                                Annuler la demande le tue sur-le-champ."

#. module: bf_document_request
