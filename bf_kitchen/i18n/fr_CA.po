#: model:ir.model.fields,field_description:bf_kitchen.field_bf_kitchen_count_step__applied_date
msgid "Applied on"
msgstr "Appliqué le"

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/kitchen_count.py:0
msgid ""
"Apply the step %(location)s before finishing: sales, receipts and "
"preparations move the stock there, and a count that skips it counts that "
"stock twice."
msgstr ""
"Appliquez l'emplacement %(location)s avant de terminer : les ventes, les "
"réceptions et les préparations y déplacent le stock, et un comptage qui le "
"saute compte ce stock deux fois."

#. module: bf_kitchen
#: model_terms:ir.ui.view,arch_db:bf_kitchen.bf_kitchen_bom_view_form
