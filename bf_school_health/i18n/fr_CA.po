msgstr "1 auto-injecteur"

#. module: bf_school_health
#: model:mail.template,body_html:bf_school_health.mail_template_epinephrine
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">During a severe allergic reaction, the school gave epinephrine to <strong t-out=\"object.student_id.name or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\"><strong>Call the school office now.</strong></p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Lors d'une réaction allergique grave, l'école a donné de l'épinéphrine à <strong t-out=\"object.student_id.name or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\"><strong>Appelez le secrétariat de l'école maintenant.</strong></p>\n"
"</div>\n"
"            "

#. module: bf_school_health
#: model:mail.template,body_html:bf_school_health.mail_template_medication_request
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The school asks for your written authorisation to give a prescribed medication at school: <strong t-out=\"object.name or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Read the details and answer in the family portal.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/health\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Read and answer\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">L'école demande votre autorisation écrite pour donner un médicament prescrit à l'école : <strong t-out=\"object.name or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Lisez les détails et répondez dans le portail des familles.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/health\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Lire et répondre\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

