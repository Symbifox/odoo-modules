<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_editorial_waiver_form" model="ir.ui.view">
        <field name="name">bf.editorial.waiver.form</field>
        <field name="model">bf.editorial.waiver</field>
        <field name="arch" type="xml">
            <form string="Signer une dérogation">
                <field name="entry_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <p>
                        La QA continue de dire ce qu'elle voit. Ce que vous
                        signez, c'est le refus de publier : il cède sur les
                        motifs ci-dessous, et sur ceux-là seulement.
                    </p>
                    <p class="mb-0">
                        Dès que le texte de l'article bouge, la dérogation
                        cesse de couvrir quoi que ce soit et la garde reprend.
                    </p>
                </div>
                <group>
                    <field name="problems" nolabel="1" colspan="2"
                           readonly="1"/>
                </group>
                <group>
                    <field name="reason" nolabel="1" colspan="2"
                           placeholder="Pourquoi ces motifs sont acceptables sur cet article."/>
                </group>
                <footer>
                    <button name="action_sign" type="object" string="Signer"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
