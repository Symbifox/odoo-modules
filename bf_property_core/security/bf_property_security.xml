<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_property" model="ir.module.category">
            <field name="name">Copropriété</field>
            <field name="description">Gestion des syndicats de copropriété</field>
            <field name="sequence">22</field>
        </record>

        <record id="group_bf_property_user" model="res.groups">
            <field name="name">Consultation</field>
            <field name="category_id" ref="module_category_property"/>
            <field name="comment">Consulte les syndicats, immeubles et fractions sans pouvoir les modifier.</field>
        </record>

        <record id="group_bf_property_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="category_id" ref="module_category_property"/>
            <field name="implied_ids" eval="[(4, ref('group_bf_property_user'))]"/>
            <field name="comment">Crée et modifie la structure de copropriété.</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Cloisonnement multi-société : un gestionnaire ne voit que les
             syndicats des sociétés qui lui sont ouvertes. -->
        <record id="rule_property_syndicat_company" model="ir.rule">
            <field name="name">Syndicats : multi-société</field>
            <field name="model_id" ref="model_bf_property_syndicat"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_property_building_company" model="ir.rule">
            <field name="name">Immeubles : multi-société</field>
            <field name="model_id" ref="model_bf_property_building"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_property_unit_company" model="ir.rule">
            <field name="name">Fractions : multi-société</field>
            <field name="model_id" ref="model_bf_property_unit"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Contient des noms de copropriétaires, donc des renseignements
             personnels : le cloisonnement n'est pas optionnel ici. -->
        <record id="rule_property_ownership_company" model="ir.rule">
            <field name="name">Propriétés : multi-société</field>
            <field name="model_id" ref="model_bf_property_ownership"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_property_common_area_company" model="ir.rule">
            <field name="name">Parties communes : multi-société</field>
            <field name="model_id" ref="model_bf_property_common_area"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
