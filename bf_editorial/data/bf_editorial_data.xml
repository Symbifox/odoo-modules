<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Étapes de production. L'ordre suit le vrai parcours d'un billet :
             on ne fact-checke pas un texte qui n'existe pas encore. -->
        <record id="stage_idea" model="bf.editorial.stage">
            <field name="name">Idea</field>
            <field name="sequence">10</field>
            <field name="description">A topic identified, nothing written.</field>
        </record>
        <record id="stage_selected" model="bf.editorial.stage">
            <field name="name">Selected</field>
            <field name="sequence">20</field>
            <field name="description">The topic is a go, the angle is still being sought.</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_brief" model="bf.editorial.stage">
            <field name="name">Brief</field>
            <field name="sequence">30</field>
            <field name="description">Angle, promise and audience settled.</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_writing" model="bf.editorial.stage">
            <field name="name">Writing</field>
            <field name="sequence">40</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_draft" model="bf.editorial.stage">
            <field name="name">Draft</field>
            <field name="sequence">50</field>
            <field name="description">The text exists in Odoo, unpublished.</field>
        </record>
        <record id="stage_factcheck" model="bf.editorial.stage">
            <field name="name">Fact-check</field>
            <field name="sequence">60</field>
            <field name="description">Claims and sources under verification.</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_qa" model="bf.editorial.stage">
            <field name="name">QA</field>
            <field name="sequence">70</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_ready" model="bf.editorial.stage">
            <field name="name">Ready</field>
            <field name="sequence">80</field>
            <field name="description">Preflight guard green, waiting for a slot.</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_scheduled" model="bf.editorial.stage">
            <field name="name">Scheduled</field>
            <field name="sequence">90</field>
            <field name="description">Date approved, the scheduled job takes care of it.</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_published" model="bf.editorial.stage">
            <field name="name">Live</field>
            <field name="sequence">100</field>
            <field name="is_closing">True</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_blocked" model="bf.editorial.stage">
            <field name="name">Blocked</field>
            <field name="sequence">110</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_abandoned" model="bf.editorial.stage">
            <field name="name">Abandoned</field>
            <field name="sequence">120</field>
            <field name="is_abandoned">True</field>
            <field name="fold">True</field>
        </record>

        <!-- Gabarits de liste de contrôle : les restes humains qui reviennent
             à chaque article. -->
        <record id="checklist_tpl_images" model="bf.editorial.checklist.template">
            <field name="name">Visuals produced and placed</field>
            <field name="sequence">10</field>
            <field name="kind">blog</field>
        </record>
        <record id="checklist_tpl_alt" model="bf.editorial.checklist.template">
            <field name="name">Alt text written in each language</field>
            <field name="sequence">20</field>
            <field name="kind">blog</field>
        </record>
        <record id="checklist_tpl_og" model="bf.editorial.checklist.template">
            <field name="name">Open Graph image set</field>
            <field name="sequence">30</field>
            <field name="kind">blog</field>
        </record>
        <record id="checklist_tpl_read" model="bf.editorial.checklist.template">
            <field name="name">Human proofreading done</field>
            <field name="sequence">40</field>
        </record>
        <record id="checklist_tpl_crosslink" model="bf.editorial.checklist.template">
            <field name="name">Cross-links placed in the cited articles</field>
            <field name="sequence">50</field>
            <field name="kind">blog</field>
        </record>
        <record id="checklist_tpl_blurbs" model="bf.editorial.checklist.template">
            <field name="name">Blurbs written in each language</field>
            <field name="sequence">60</field>
            <field name="is_blocking">False</field>
        </record>

        <!-- Publication différée. Toutes les heures : une date approuvée à la
             minute près n'apporte rien, et un cron bavard coûte. -->
        <record id="cron_publish_scheduled" model="ir.cron">
            <field name="name">Editorial workshop: scheduled publishing</field>
            <field name="model_id" ref="model_bf_editorial_entry"/>
            <field name="state">code</field>
            <field name="code">model._cron_publish_scheduled()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
