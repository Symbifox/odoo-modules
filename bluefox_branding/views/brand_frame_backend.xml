<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Forme du cadre dans le client web.

        Hérite de web.webclient_bootstrap, jamais de web.layout : web.layout
        sert aussi le site public, le portail et la page de connexion, qui ont
        leur propre thème (le site règle ses arrondis dans son éditeur). La
        relecture du 2026-10-22 l'a mesuré : posée dans web.layout, la forme
        repeignait le site et le portail.

        Ajoutée à la fin de head_web, donc après les feuilles du client. Au
        défaut, la méthode rend une chaîne vide et rien n'est émis.
    -->
    <template id="brand_frame_backend"
              inherit_id="web.webclient_bootstrap"
              name="Forme du cadre (client web)">
        <xpath expr="//t[@t-set='head_web']" position="inside">
            <t t-set="_brand_frame_co" t-value="request and request.env and request.env['res.company']._brand_active_company()"/>
            <t t-set="_brand_frame_css" t-value="_brand_frame_co and _brand_frame_co._brand_frame_css()"/>
            <style t-if="_brand_frame_css" id="bf_brand_frame"><t t-out="_brand_frame_css"/></style>
        </xpath>
    </template>

</odoo>
