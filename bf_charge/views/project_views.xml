<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_project_form_charge" model="ir.ui.view">
        <field name="name">project.project.form.charge</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="charge_kind"/>
                <field name="charge_last_timesheet_date"/>
            </xpath>
        </field>
    </record>

    <!-- La charge se pose sous le temps alloué, dont elle est la suite, et
         jamais à côté de l'échéance : dans le formulaire d'Odoo 18,
         `date_deadline` vit dans un `<div class="d-inline-flex">` où le groupe ne
         pose aucune étiquette. Ancrés `after` sur le champ, cinq champs y
         tombaient sans libellé et rognaient la date jusqu'à la rendre illisible.
         Ancrés après le bloc du temps alloué, ils reçoivent leurs propres
         rangées.
         Une tâche ordinaire n'en montre qu'une : la charge corrigée, seule
         saisie. La charge retenue ne se dit que lorsqu'elle diffère du temps
         alloué (corrigée à la main, ou vente écartée avec son motif), et le
         non plaçable seulement quand la tâche ne porte aucune date. -->
    <record id="view_task_form_charge" model="ir.ui.view">
        <field name="name">project.task.form.charge</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='allocated_hours']]" position="after">
                <field name="charge_hours_manual"/>
                <field name="charge_placeable" invisible="1"/>
                <label for="charge_hours"
                       invisible="charge_source not in ('manuel', 'vente_ecartee')"/>
                <div name="bf_charge_retenue"
                     invisible="charge_source not in ('manuel', 'vente_ecartee')">
                    <field name="charge_hours" class="oe_inline"/>
                    <span class="mx-1">·</span>
                    <field name="charge_source" class="oe_inline"/>
                    <div class="text-muted" invisible="not charge_reject_reason">
                        <field name="charge_reject_reason"/>
                    </div>
                </div>
                <label for="charge_placeable" string="Plan de charge"
                       invisible="charge_placeable"/>
                <div name="bf_charge_non_placable" class="text-muted"
                     invisible="charge_placeable">Non plaçable, aucune date</div>
            </xpath>
        </field>
    </record>
</odoo>
