<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_challenge_list" model="ir.ui.view">
        <field name="name">bf.gamification.challenge.list</field>
        <field name="model">bf.gamification.challenge</field>
        <field name="arch" type="xml">
            <list string="D&#233;fis du jour" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="source"/>
                <field name="model_name"/>
                <field name="target"/>
                <field name="xp_reward"/>
                <field name="icon"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_challenges" model="ir.actions.act_window">
        <field name="name">D&#233;fis du jour</field>
        <field name="res_model">bf.gamification.challenge</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
