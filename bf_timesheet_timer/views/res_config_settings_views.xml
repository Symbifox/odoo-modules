<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_bf_timer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bf_timer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Timesheets" string="Timesheets"
                     name="bf_timesheet_timer"
                     groups="hr_timesheet.group_timesheet_manager">
                    <block title="Timer rounding">
                        <setting string="Rounding mode"
                                 help="Defines how timer durations are rounded.">
                            <field name="bf_timer_rounding_mode" widget="radio"/>
                        </setting>
                        <setting string="Rounding increment"
                                 help="Durations are rounded up to the next multiple of this increment.">
                            <field name="bf_timer_rounding_increment"/>
                        </setting>
                        <setting string="Rounding threshold (minutes)"
                                 help="In 'Round below a threshold' mode, only durations below this threshold are rounded."
                                 invisible="bf_timer_rounding_mode != 'round_below_threshold'">
                            <field name="bf_timer_rounding_threshold"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
