#: code:addons/bf_employee_photo_age/models/hr_employee.py
msgid "Put a recent one in your preferences: your avatar at the top right, then Preferences."
msgstr "Posez-en une récente dans vos préférences : votre avatar en haut à droite, puis Préférences."

#. module: bf_employee_photo_age
msgid "Remind an employee to update a photo older than this. 0 turns the reminder off."
msgstr "Rappeler à un employé de mettre à jour une photo plus vieille que ceci. 0 coupe le rappel."

#. module: bf_employee_photo_age
msgid "Remind an employee whose photo is older than this many months. 0 turns it off."
msgstr "Rappeler à un employé dont la photo a plus que ce nombre de mois. 0 le coupe."

#. module: bf_employee_photo_age
#. odoo-python
#: code:addons/bf_employee_photo_age/models/hr_employee.py
msgid "Send a recent one to the person in charge of HR, who will put it on file."
msgstr "Envoyez-en une récente à la personne responsable des RH, qui la mettra au dossier."

#. module: bf_employee_photo_age
#. odoo-python
#: code:addons/bf_employee_photo_age/models/hr_employee.py
msgid "Update your photo"
msgstr "Mettez votre photo à jour"

#. module: bf_employee_photo_age
msgid "When the current photo was put on file. Empty when there is no photo, only a drawn avatar."
msgstr "Quand la photo actuelle a été mise au dossier. Vide s'il n'y a pas de photo, seulement un avatar dessiné."

#. module: bf_employee_photo_age
