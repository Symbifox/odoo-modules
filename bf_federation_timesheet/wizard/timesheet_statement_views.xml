<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_federation_timesheet_statement_form" model="ir.ui.view">
        <field name="name">federation.timesheet.statement.form</field>
        <field name="model">federation.timesheet.statement</field>
        <field name="arch" type="xml">
            <form string="Deliver a timesheet statement">
                <p class="text-muted">
                    The statement is filed as a deliverable: it carries a version, and the partner acknowledges receipt. Producing the statement again for a period already delivered publishes a new version, and the previous receipt drops. No amount leaves.
                </p>
                <group>
                    <group>
                        <field name="project_id"/>
                        <field name="partner_id"/>
                        <field name="allowed_peer_ids" invisible="1"/>
                        <field name="federation_peer_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="group_by" widget="radio"/>
                        <field name="include_descriptions"/>
                    </group>
                </group>
                <group>
                    <field name="line_count"/>
                    <field name="total_hours" widget="float_time"/>
                </group>
                <footer>
                    <button name="action_produce" type="object" string="Produce the statement" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_federation_timesheet_statement" model="ir.actions.act_window">
        <field name="name">Deliver a timesheet statement</field>
        <field name="res_model">federation.timesheet.statement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_federation_timesheet_statement"
              name="Timesheet statement"
              parent="bf_federation.menu_federation_root"
              action="action_federation_timesheet_statement"
              groups="project.group_project_manager"
              sequence="45"/>
</odoo>
