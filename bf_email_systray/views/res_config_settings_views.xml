<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Le bouton de la barre système se règle là où se règle la boîte de
         réception : sous « Gestion des courriels », dans le bloc qui porte
         déjà les dossiers IMAP et la signature. Un onglet à part pour trois
         champs enterrerait le réglage -->
    <record id="res_config_settings_view_form_bf_email_systray" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf_email_systray</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="bf_email_management.res_config_settings_view_form_bf_email"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='bf_email_inbox_setting_container']"
                   position="inside">
                <setting id="bf_email_systray_mode_setting"
                         string="Systray button"
                         help="What the inbox icon in the top bar does. The panel opens over the current screen and leaves it in place; full page replaces it, like the menu. Everyone can choose differently from the button's menu, and their choice prevails over this one.">
                    <field name="bf_email_systray_mode" widget="radio"/>
                    <div class="content-group"
                         invisible="bf_email_systray_mode != 'panneau'">
                        <div class="row mt16">
                            <label for="bf_email_systray_width_pct"
                                   class="col-lg-4 o_light_label"/>
                            <field name="bf_email_systray_width_pct"
                                   class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="bf_email_systray_height_pct"
                                   class="col-lg-4 o_light_label"/>
                            <field name="bf_email_systray_height_pct"
                                   class="col-lg-2"/>
                        </div>
                        <div class="text-muted mt8">
                            Starting size, between 40 and 100%. The panel's handle lets you resize it, and that size is remembered per person.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
