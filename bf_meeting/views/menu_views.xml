    <!-- Par projet -->
    <menuitem id="menu_meeting_by_project"
              name="Par projet"
              parent="menu_meeting_root"
              action="meeting_record_action_by_project"
              groups="group_meeting_user"
              sequence="30"/>

</odoo>
