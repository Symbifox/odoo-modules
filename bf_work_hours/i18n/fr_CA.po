"Your days from before you turned your hours on, taken in from the same "
"traces."
msgstr ""
"Vos journées d'avant l'activation de vos heures, reprises à partir des mêmes"
" traces."

#. module: bf_work_hours
#. odoo-python
#: code:addons/bf_work_hours/wizard/activate_wizard.py:0
msgid ""
"Your days from before, reconstructed the same way and with the same bounds, "
"and your indicators for those days if you turned them on. They appear a "
"slice at a time, within minutes."
msgstr ""
"Vos journées d'avant, reconstituées de la même façon et avec les mêmes "
"bornes, et vos indicateurs pour ces journées si vous les avez activés. Elles"
" apparaissent par tranches, en quelques minutes."

#. module: bf_work_hours
#. odoo-python
#: code:addons/bf_work_hours/wizard/activate_wizard.py:0
msgid "Your earlier days"
msgstr "Vos jours d'avant"

#. module: bf_work_hours
#. odoo-python
#: code:addons/bf_work_hours/models/work_day.py:0
msgid ""
"Your earlier days are being taken in, back to %(date)s: they appear a slice "
"at a time."
msgstr ""
"Vos jours d'avant sont en cours de reprise, jusqu'au %(date)s : ils "
"apparaissent par tranches."

#. module: bf_work_hours
#. odoo-python
#: code:addons/bf_work_hours/models/work_day.py:0
msgid "Your earlier days are taken in from %(date)s."
msgstr "Vos jours d'avant sont repris depuis le %(date)s."

#. module: bf_work_hours
#. odoo-python
