<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_verification_code" model="mail.template">
        <field name="name">Consentement : Code de vérification 2FA</field>
        <field name="model_id" ref="model_privacy_consent_verification"/>
        <field name="subject">Code de vérification : {{ object.code }} / Verification Code: {{ object.code }}</field>
        <field name="email_from">{{ (object.consent_id.company_id.email or user.email_formatted) }}</field>
        <field name="email_to">{{ object.consent_id.subject_partner_id.email }}</field>
        <field name="body_html"><![CDATA[

<t t-set="company" t-value="('company_id' in object._fields and object.company_id) or user.company_id"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<div style="max-width:600px; margin:0 auto; font-family:Arial, Helvetica, sans-serif;">
    <!-- Header -->
    <div t-attf-style="background-color:{{ brand_dark }}; padding:20px 30px; border-radius:8px 8px 0 0; border-bottom:4px solid {{ brand_primary }};">
        <h2 style="color:#ffffff; margin:0; font-weight:600;">Code de vérification / Verification Code</h2>
    </div>

    <!-- Body -->
    <div style="background-color:#ffffff; padding:30px; border:1px solid #dee2e6; border-top:none;">
        <p style="color:#333333; font-size:14px; margin-bottom:20px;">
            Bonjour,<br/><br/>
            Votre code de vérification pour confirmer votre action de consentement est :
        </p>

        <!-- Code display -->
        <div style="text-align:center; margin:30px 0;">
            <div t-attf-style="display:inline-block; background-color:#f0f9ff; border:2px solid {{ brand_primary }}; border-radius:12px; padding:20px 40px;">
                <span t-attf-style="font-size:36px; font-weight:700; letter-spacing:8px; color:{{ brand_dark }}; font-family:'Courier New', monospace;">
                    {{ object.code }}
                </span>
            </div>
        </div>

        <p style="color:#666666; font-size:13px; text-align:center; margin-bottom:20px;">
            Ce code expire dans <strong>15 minutes</strong>.<br/>
            <em style="color:#999999;">This code expires in <strong>15 minutes</strong>.</em>
        </p>

        <hr style="border:none; border-top:1px solid #dee2e6; margin:20px 0;"/>

        <p style="color:#333333; font-size:14px; margin-bottom:10px;">
            <em>Hello,<br/><br/>
            Your verification code to confirm your consent action is shown above.</em>
        </p>

        <p style="color:#999999; font-size:12px; margin-top:20px;">
            Si vous n'avez pas fait cette demande, ignorez ce courriel.<br/>
            <em>If you did not make this request, please ignore this email.</em>
        </p>
    </div>

    <!-- Footer -->
    <div style="background-color:#f8f9fa; padding:15px 30px; border:1px solid #dee2e6; border-top:none; border-radius:0 0 8px 8px;">
        <p style="color:#999999; font-size:11px; margin:0; text-align:center;">
            {{ object.consent_id.company_id.name or '' }} - Conformité {{ object.consent_id.get_framework().law_short_label }}
        </p>
    </div>
</div>
]]></field>
    </record>
</odoo>
