<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_celebration_board_list" model="ir.ui.view">
        <field name="name">bf.celebration.board.list</field>
        <field name="model">bf.celebration.board</field>
        <field name="arch" type="xml">
            <list string="Cards">
                <field name="name"/>
                <field name="recipient_name"/>
                <field name="delivery_date"/>
                <field name="published_post_count" string="Signatures"/>
                <field name="organizer_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-success="state == 'delivered'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_celebration_board_form" model="ir.ui.view">
        <field name="name">bf.celebration.board.form</field>
        <field name="model">bf.celebration.board</field>
        <field name="arch" type="xml">
            <form string="Group card">
                <header>
                    <button name="action_ouvrir" type="object"
                            string="Open for signatures now" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_apercu" type="object"
                            string="View the page" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_diaporama" type="object"
                            string="Slideshow" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_inviter_signataires" type="object"
                            string="Invite the signatories" class="btn-secondary"
                            invisible="state != 'open'"
                            groups="bf_celebrations.group_organizer"
                            help="Sends the link to the groups and the other signatories who have not received it yet. The person celebrated is never written to."/>
                    <button name="action_livrer_maintenant" type="object"
                            string="Deliver now"
                            invisible="state != 'open'"
                            confirm="The person celebrated will receive the card right away, with the PDF and the keepsake page attached. Carry on?"/>
                    <button name="action_regenerer_jeton" type="object"
                            string="Cut the link" invisible="state != 'open'"
                            confirm="The old link will stop working for everybody. Carry on?"/>
                    <button name="action_annuler" type="object"
                            string="Cancel" invisible="state in ('delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Happy celebration!"/></h1>
                    </div>
                    <div class="alert alert-info o_cel_lien" role="status"
                         invisible="state == 'draft'">
                        <div class="d-flex flex-wrap align-items-start gap-3">
                            <div class="flex-grow-1">
                                <p class="mb-1"><strong>The link to share</strong></p>
                                <field name="contribution_url" widget="CopyClipboardChar"
                                       nolabel="1"/>
                                <p class="mb-1 mt-2">
                                    No account is needed. The QR code leads to
                                    the same page: print it, stick it in the
                                    kitchen.
                                </p>
                                <p class="mb-0" invisible="state != 'delivered'">
                                    <strong>The card delivered:</strong>
                                    <field name="board_url" widget="CopyClipboardChar"
                                           nolabel="1"/>
                                </p>
                                <field name="access_token" invisible="1"/>
                            </div>
                            <!-- ⚠️ La 1.0 annonçait le code QR ici et ne
                                 l'affichait pas : la phrase finissait sur un
                                 champ invisible. -->
                            <field name="qr_image" widget="image" nolabel="1"
                                   class="o_cel_qr"
                                   options="{'size': [140, 140], 'zoom': true}"/>
                        </div>
                    </div>
                    <group>
                        <group string="For whom">
                            <field name="recipient_employee_id"/>
                            <field name="recipient_partner_id"/>
                            <field name="recipient_email"/>
                            <field name="occasion_id"/>
                        </group>
                        <group string="When and how">
                            <field name="delivery_date"/>
                            <field name="organizer_id"/>
                            <field name="theme"/>
                            <field name="moderation"/>
                            <field name="allow_images"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-success" role="status"
                         invisible="not thanks_html">
                        <p class="mb-1"><strong>Thank-you from the person celebrated</strong>,
                           received on <field name="thanks_date" readonly="1" class="oe_inline"/></p>
                        <field name="thanks_html" readonly="1" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Signatories" name="signataires"
                              groups="bf_celebrations.group_organizer">
                            <p class="text-muted">
                                Who the card is held out to. The link goes out once
                                per address, when it opens and on each
                                "Invite the signatories". The person celebrated is
                                taken out by all of their addresses, even if they
                                belong to the department.
                            </p>
                            <group>
                                <field name="signer_group_ids" widget="many2many_tags"
                                       options="{'no_quick_create': true}"/>
                                <field name="signer_partner_ids" widget="many2many_tags"
                                       options="{'no_quick_create': true}"/>
                                <field name="invited_count" readonly="1"/>
                            </group>
                            <field name="invited_keys" invisible="1"/>
                        </page>
                        <page string="Opening message" name="intro">
                            <field name="intro_html"
                                   placeholder="What people read when they land on the page."/>
                            <field name="background_image" widget="image"
                                   class="mt-3" options="{'size': [400, 200]}"/>
                        </page>
                        <page string="Signatures" name="messages">
                            <field name="post_ids" readonly="1">
                                <list>
                                    <field name="author_name"/>
                                    <field name="body" widget="html"/>
                                    <field name="style" optional="show"/>
                                    <field name="has_ink" string="Drawing" optional="show"/>
                                    <field name="image" widget="image"
                                           options="{'size': [60, 60]}"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'pending'"
                                           decoration-success="state == 'published'"
                                           decoration-muted="state == 'rejected'"/>
                                    <button name="action_publier" type="object"
                                            icon="fa-check" title="Publish"
                                            invisible="state == 'published'"/>
                                    <button name="action_retirer" type="object"
                                            icon="fa-ban" title="Remove"
                                            invisible="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="published_post_count" invisible="1"/>
                    <field name="recipient_name" invisible="1"/>
                    <field name="recipient_user_id" invisible="1"/>
                    <field name="empty_notified" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_celebration_board_kanban" model="ir.ui.view">
        <field name="name">bf.celebration.board.kanban</field>
        <field name="model">bf.celebration.board</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="recipient_name"/>
                            </div>
                            <div class="mt-2">
                                <i class="fa fa-pencil me-1" title="Signatures" role="img" aria-label="Signatures"/>
                                <field name="published_post_count"/>
                                signature(s)
                            </div>
                            <div class="text-muted">
                                <i class="fa fa-clock-o me-1" title="Delivery planned" role="img" aria-label="Delivery planned"/>
                                <field name="delivery_date" widget="date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_celebration_board" model="ir.actions.act_window">
        <field name="name">Group cards</field>
        <field name="res_model">bf.celebration.board</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No card yet</p>
            <p>A card opens from an occasion in the calendar, or here
               for an event that has no date on file.</p>
        </field>
    </record>

</odoo>
