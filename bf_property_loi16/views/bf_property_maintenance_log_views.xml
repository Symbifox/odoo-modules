<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_log_list" model="ir.ui.view">
        <field name="name">bf.property.maintenance.log.list</field>
        <field name="model">bf.property.maintenance.log</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'superseded'"
                  decoration-danger="revision_state == 'due' or update_state == 'due'">
                <field name="name"/>
                <field name="syndicat_id"/>
                <field name="building_id" optional="show"/>
                <field name="established_date"/>
                <field name="revision_years" optional="show"/>
                <field name="last_update_date" optional="hide"/>
                <field name="next_update_date" optional="show"/>
                <field name="last_revision_date" optional="hide"/>
                <field name="next_revision_date"/>
                <field name="update_state" optional="hide" widget="badge"/>
                <field name="revision_state" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_log_form" model="ir.ui.view">
        <field name="name">bf.property.maintenance.log.form</field>
        <field name="model">bf.property.maintenance.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_establish" type="object" string="Porter comme établi"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_record_update" type="object"
                            string="Consigner la mise à jour annuelle"
                            invisible="state != 'established'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,established"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Carnet d'entretien 2026"/></h1>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="revision_state != 'due'">
                        La révision du carnet est échue. Art. 5 du règlement.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="update_state != 'due'">
                        La mise à jour annuelle est échue. Art. 4 du règlement : le
                        conseil met le carnet à jour minimalement une fois par année, et
                        mentionne les travaux prévus qui n'ont pas été effectués ainsi
                        que leurs raisons.
                    </div>

                    <group>
                        <group string="Portée">
                            <field name="syndicat_id"/>
                            <field name="building_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Dates">
                            <field name="established_date"/>
                            <field name="last_update_date"/>
                            <field name="last_revision_date"/>
                            <field name="planning_horizon_date"/>
                        </group>
                        <group string="Auteur (art. 1 du règlement)">
                            <field name="author_partner_id"/>
                            <field name="author_order"/>
                            <field name="author_practice"/>
                            <field name="author_independent"/>
                            <field name="site_declaration"/>
                            <field name="site_declaration_date"
                                   required="site_declaration"/>
                        </group>
                        <group string="Échéances">
                            <field name="revision_years"/>
                            <field name="next_revision_date"/>
                            <field name="revision_state"/>
                            <field name="next_update_date"/>
                            <field name="update_state"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="not revision_rule">
                        <field name="revision_rule" readonly="1" nolabel="1"/>
                    </div>

                    <notebook>
                        <page string="Biens au carnet" name="items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="common_area_id" optional="show"/>
                                    <field name="in_private_portion" optional="hide"/>
                                    <field name="syndicat_maintains" optional="hide"/>
                                    <field name="install_date" optional="hide"/>
                                    <field name="maintenance_frequency" optional="hide"/>
                                    <field name="last_maintenance_date" optional="hide"/>
                                    <field name="condition" optional="show"/>
                                    <field name="remaining_life_years" optional="show"/>
                                    <field name="major_work" optional="show"/>
                                    <field name="major_work_year" optional="show"/>
                                    <field name="major_work_cost" optional="show"
                                           sum="Coût estimé"/>
                                    <field name="in_horizon" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Art. 3 du règlement : l'estimation de l'état, de la durée
                                de vie utile restante et du coût des travaux appartient à
                                la personne qui signe le carnet. Le module la conserve, il
                                ne la produit pas.
                            </div>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_log_search" model="ir.ui.view">
        <field name="name">bf.property.maintenance.log.search</field>
        <field name="model">bf.property.maintenance.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="syndicat_id"/>
                <filter name="established" string="Établis"
                        domain="[('state', '=', 'established')]"/>
                <filter name="revision_due" string="Révision échue"
                        domain="[('revision_state', '=', 'due')]"/>
                <filter name="update_due" string="Mise à jour échue"
                        domain="[('update_state', '=', 'due')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_syndicat" string="Syndicat"
                            context="{'group_by': 'syndicat_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_log" model="ir.actions.act_window">
        <field name="name">Carnets d'entretien</field>
        <field name="res_model">bf.property.maintenance.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Établir un carnet d'entretien</p>
            <p>
                Art. 1070.2 C.c.Q. Le carnet ne peut être établi que par un membre de
                l'un de quatre ordres professionnels, exerçant principalement dans
                l'immobilier et indépendant du syndicat : le gestionnaire de l'immeuble
                ne peut pas établir le carnet de l'immeuble qu'il gère.
            </p>
        </field>
    </record>

</odoo>
