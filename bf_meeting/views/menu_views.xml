    <menuitem id="menu_meeting_agendas"
              name="Ordres du jour"
              parent="menu_meeting_root"
              sequence="20"/>
    <menuitem id="menu_meeting_agendas_today"
              name="Aujourd'hui"
              parent="menu_meeting_agendas"
              action="meeting_agenda_action_today"
