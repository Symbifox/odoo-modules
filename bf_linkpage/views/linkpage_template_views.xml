<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_linkpage_template_list" model="ir.ui.view">
        <field name="name">bf.linkpage.template.list</field>
        <field name="model">bf.linkpage.template</field>
        <field name="arch" type="xml">
            <list string="Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="target"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="is_default"/>
                            <field name="layout"/>
                            <field name="theme"/>
                            <field name="accent_color" widget="color"/>
                <field name="page_count" string="Pages"/>
            </list>
        </field>
    </record>

    <record id="view_bf_linkpage_template_form" model="ir.ui.view">
        <field name="name">bf.linkpage.template.form</field>
        <field name="model">bf.linkpage.template</field>
        <field name="arch" type="xml">
            <form string="Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Consulting team"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="target"/>
                            <field name="group_ids" widget="many2many_tags"
                                   invisible="target != 'person'"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="page_count" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The most specific template wins: one whose user belongs to a group takes precedence over the default template. In case of a tie, the sequence decides, so that the choice does not depend on the order of insertion in the database.
                    </div>
                    <notebook>
                        <page string="Links" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="subtitle" optional="show"/>
                                    <field name="source_code"/>
                                    <field name="url" readonly="source_code != 'manual'"/>
                                    <field name="icon" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_linkpage_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">bf.linkpage.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
