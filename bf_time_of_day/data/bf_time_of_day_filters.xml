<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="filter_my_day_by_slot" model="ir.filters">
            <field name="name">Ma journée par plage</field>
            <field name="model_id">project.task</field>
            <field name="user_id" eval="False"/>
            <field name="domain">[('user_ids', 'in', uid), ('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_deadline', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]</field>
            <field name="context">{'group_by': ['time_of_day_id']}</field>
        </record>

    </data>

    <!-- Filtre géré par le module (hors noupdate) : reste aligné aux upgrades. -->
    <data>

        <!-- Colonnes kanban = jour d'échéance ; combiné à la barre de progression
             "plage horaire" du kanban all-tasks, donne jour en X / plage en Y.
             Restreint aux tâches qui portent une plage : la barre n'a alors pas
             de segment "Autre" et le compteur de colonne ne compte que le planifié. -->
        <record id="filter_tasks_by_day" model="ir.filters">
            <field name="name">Tâches par jour</field>
            <field name="model_id">project.task</field>
            <field name="user_id" eval="False"/>
            <field name="domain">[('date_deadline', '!=', False), ('time_of_day_code', '!=', False)]</field>
            <field name="context">{'group_by': ['date_deadline:day']}</field>
        </record>

    </data>
</odoo>
