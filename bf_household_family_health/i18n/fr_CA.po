msgstr "Médicaments : %s"

#. module: bf_household_family_health
#. odoo-python
#: code:addons/bf_household_family_health/models/emergency_card.py:0
msgid "Nothing active in Healthy Fox."
msgstr "Rien d'actif dans Healthy Fox."

#. module: bf_household_family_health
#. odoo-python
#: code:addons/bf_household_family_health/models/health_dependent.py:0
msgid ""
"Only the child's parent who holds their records starts following their "
"health."
msgstr ""
"Seul le parent qui tient les fiches de l'enfant commence le suivi de sa "
"santé."

#. module: bf_household_family_health
#: model:ir.model.constraint,message:bf_household_family_health.constraint_health_dependent_bf_health_dependent_child_unique
msgid "This child is already followed in Healthy Fox."
msgstr "Cet enfant est déjà suivi dans Healthy Fox."
