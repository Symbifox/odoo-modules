<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="hosting_backup_repository_view_tree" model="ir.ui.view">
        <field name="name">hosting.backup.repository.view.tree</field>
        <field name="model">hosting.backup.repository</field>
        <field name="arch" type="xml">
            <list decoration-warning="is_stale or discovered" decoration-muted="not active">
                <field name="name"/>
                <field name="discovered" widget="boolean" string="To acknowledge" optional="show"/>
                <field name="category" widget="badge"/>
                <field name="snapshot_count"/>
                <field name="latest_snapshot_date"/>
                <field name="is_stale" widget="boolean" string="Stale"/>
                <field name="size_human" string="Size"/>
                <field name="bucket_size_share" string="% of bucket" widget="float" digits="[5,2]"/>
                <field name="last_watchdog_sync" optional="hide"/>
                <field name="active" optional="hide" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="hosting_backup_repository_view_form" model="ir.ui.view">
        <field name="name">hosting.backup.repository.view.form</field>
        <field name="model">hosting.backup.repository</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_acknowledge"
                            string="Acknowledge this destination"
                            type="object"
                            class="oe_highlight"
                            groups="hosting_management.group_hosting_manager"
                            invisible="not discovered"/>
                    <button name="action_auto_link_services"
                            string="Auto-link matching services"
                            type="object"
                            class="oe_highlight"/>
                    <field name="is_stale" widget="boolean_toggle" readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="To acknowledge" bg_color="bg-warning" invisible="not discovered"/>
                    <widget name="web_ribbon" title="Stale" bg_color="bg-warning" invisible="not is_stale or discovered"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Repository"/>
                        <h1><field name="name" placeholder="Internal Backups/Database"/></h1>
                        <field name="category" widget="badge" readonly="1"/>
                    </div>
                    <group>
                        <group string="S3 storage">
                            <field name="s3_url"/>
                            <field name="password_file_path"/>
                            <field name="active"/>
                        </group>
                        <group string="Registry">
                            <field name="discovered" readonly="1"/>
                            <field name="discovered_date" readonly="1" invisible="not discovered_date"/>
                            <div class="text-muted" colspan="2" invisible="not discovered"><span>The watchdog found this destination on the host while the registry did not know it. Its snapshots are real; no service is reported as covered by it until it is acknowledged.</span></div>
                        </group>
                        <group string="State (watchdog sync)">
                            <field name="snapshot_count"/>
                            <field name="latest_snapshot_date"/>
                            <field name="size_human"/>
                            <field name="size_bytes" invisible="1"/>
                            <field name="bucket_size_share" widget="percentage"/>
                            <field name="last_watchdog_sync"/>
                        </group>
                    </group>
                    <group string="Restic retention">
                        <group>
                            <field name="retention_daily"/>
                            <field name="retention_weekly"/>
                            <field name="retention_monthly"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Snapshots" name="snapshots">
                            <field name="snapshot_ids" readonly="1">
                                <list>
                                    <field name="snapshot_date"/>
                                    <field name="snapshot_id"/>
                                    <field name="container"/>
                                    <field name="files_new"/>
                                    <field name="data_added_human" string="Added"/>
                                    <field name="duration_sec" string="Duration (s)"/>
                                    <field name="run_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Linked services" name="services">
                            <field name="service_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="hosting_backup_repository_view_search" model="ir.ui.view">
        <field name="name">hosting.backup.repository.view.search</field>
        <field name="model">hosting.backup.repository</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="To acknowledge" name="filter_discovered" domain="[('discovered', '=', True)]"/>
                <filter string="Stale" name="filter_stale" domain="[('is_stale', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Internal" name="filter_internal" domain="[('category', '=', 'internal')]"/>
                <filter string="Tenant" name="filter_tenant" domain="[('category', '=', 'tenant')]"/>
                <filter string="Clients" name="filter_clients" domain="[('category', '=', 'clients')]"/>
                <group expand="0" string="Group by">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hosting_backup_repository_action" model="ir.actions.act_window">
        <field name="name">Restic repositories</field>
        <field name="res_model">hosting.backup.repository</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Restic repository configured
            </p>
            <p>
                Restic repositories are created automatically at install from <code>~/.config/restic/repos.json</code>.
            </p>
        </field>
    </record>

</odoo>
