msgid "A held slot cannot repeat."
msgstr "Une plage retenue ne se répète pas."

#. module: bf_calendar_hold
#. odoo-python
#: code:addons/bf_calendar_hold/models/calendar_event.py:0
msgid "A meeting with held slots cannot itself be a held slot."
msgstr "Une rencontre qui a des plages retenues ne peut pas être une plage."

#. module: bf_calendar_hold
#. odoo-python
#: code:addons/bf_calendar_hold/models/calendar_event.py:0
msgid "A slot cannot be held for another held slot."
msgstr "Une plage ne peut pas être retenue pour une autre plage."

#. module: bf_calendar_hold
#. odoo-python
#: code:addons/bf_calendar_hold/models/calendar_event.py:0
msgid "A slot cannot be held for itself."
msgstr "Une plage ne peut pas être retenue pour elle-même."

