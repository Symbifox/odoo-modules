<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- L'état de transmission du procès-verbal (art. 1102.1) dépend de la
             date du jour, pas d'une écriture : sans ce rafraîchissement, une
             assemblée dont le délai vient d'expirer resterait « à transmettre »
             jusqu'à ce que quelqu'un l'ouvre. Même raison d'être que le cron du
             socle sur les propriétés en cours. -->
        <record id="cron_assembly_refresh_minutes_state" model="ir.cron">
            <field name="name">Copropriété : rafraîchir l'état de transmission des PV</field>
            <field name="model_id" ref="model_bf_property_assembly"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_minutes_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
