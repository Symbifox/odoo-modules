msgstr ""
"Les liens s'affichent en pied de signature : prise de\n"
"                rendez-vous, dépôt de fichier, salle de rencontre."

#. module: bf_multi_company_email
#: model_terms:ir.ui.view,arch_db:bf_multi_company_email.res_config_settings_view_form_bf_signature
