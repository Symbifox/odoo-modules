<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show cancellation reason on the booking form when present. -->
    <record id="resource_booking_form_inherit_cancellation_reason" model="ir.ui.view">
        <field name="name">resource.booking.form.inherit.bf_appointment.cancellation_reason</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='videocall_location']" position="after">
                <field name="cancellation_reason"
                       invisible="state != 'canceled' and not cancellation_reason"
                       readonly="state == 'canceled'"
                       placeholder="Saisie par le client lors de l'annulation"/>
            </xpath>
        </field>
    </record>

    <!-- Provenance : visible seulement quand la réservation vient d'ailleurs
         que du formulaire public. Le bouton résout `bf_source_ref` au clic,
         donc la vue ne référence aucun modèle satellite. -->
    <record id="resource_booking_form_inherit_bf_source" model="ir.ui.view">
        <field name="name">resource.booking.form.inherit.bf_appointment.source</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='videocall_location']" position="after">
                <field name="guest_state" invisible="guest_state == 'none'" readonly="1"/>
                <field name="guest_ids" invisible="not guest_ids" readonly="1">
                    <list>
                        <field name="email"/>
                        <field name="name"/>
                        <field name="state" widget="badge"
                               decoration-warning="state == 'pending'"
                               decoration-success="state == 'confirmed'"/>
                        <field name="confirmed_at" optional="hide"/>
                    </list>
                </field>
                <field name="bf_source" invisible="not bf_source" readonly="1"/>
                <field name="link_state" invisible="bf_source != 'onetime'" readonly="1"/>
                <field name="link_expires_at" invisible="bf_source != 'onetime'"/>
                <field name="link_single_use" invisible="bf_source != 'onetime'"/>
                <field name="link_used_at" invisible="not link_used_at" readonly="1"/>
                <field name="one_time_url" widget="CopyClipboardChar"
                       invisible="bf_source != 'onetime'" readonly="1"/>
                <field name="bf_source_ref" invisible="1"/>
                <button name="action_bf_source"
                        type="object"
                        string="Voir l'origine"
                        class="btn-link"
                        invisible="not bf_source_ref"/>
                <field name="bf_consent_state" widget="badge"
                       invisible="bf_consent_state == 'none'"
                       readonly="1"
                       decoration-success="bf_consent_state == 'granted'"
                       decoration-info="bf_consent_state == 'requested'"
                       decoration-danger="bf_consent_state in ('missing', 'refused')"/>
                <button name="action_bf_request_consents"
                        type="object"
                        string="Demander le consentement"
                        class="btn-link"
                        invisible="bf_consent_state != 'missing'"/>
            </xpath>
        </field>
    </record>

    <!-- Une réservation « à découvert » ne se voit que si on peut la chercher.
         Sans ce filtre, l'état calculé n'est qu'une décoration sur la fiche de
         quelqu'un qui savait déjà où regarder. -->
    <record id="resource_booking_list_inherit_bf_consent" model="ir.ui.view">
        <field name="name">resource.booking.list.inherit.bf_appointment.consent</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="bf_consent_state" widget="badge" optional="show"
                       decoration-success="bf_consent_state == 'granted'"
                       decoration-info="bf_consent_state == 'requested'"
                       decoration-danger="bf_consent_state in ('missing', 'refused')"/>
            </xpath>
        </field>
    </record>

    <record id="resource_booking_search_inherit_bf_consent" model="ir.ui.view">
        <field name="name">resource.booking.search.inherit.bf_appointment.consent</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='is_scheduled']" position="after">
                <separator/>
                <filter name="bf_consent_missing"
                        string="Consentement manquant"
                        domain="[('bf_consent_state', '=', 'missing')]"/>
                <filter name="bf_consent_refused"
                        string="Consentement refusé"
                        domain="[('bf_consent_state', '=', 'refused')]"/>
                <filter name="bf_consent_not_granted"
                        string="Non enregistrable"
                        domain="[('bf_consent_state', 'in', ['missing', 'refused', 'requested'])]"/>
            </xpath>
        </field>
    </record>

    <!-- 🔴 Les deux boutons « Share » d'OCA ouvraient l'assistant de partage
         d'Odoo, qui expédie « vous a invité à accéder au/à la resource
         booking » : le nom technique du modèle, sans date ni fichier
         d'agenda. Ils cèdent la place à un renvoi qui emprunte le chemin de
         l'envoi automatique. -->
    <record id="resource_booking_form_inherit_resend" model="ir.ui.view">
        <field name="name">resource.booking.form.renvoi</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='%(portal.portal_share_action)d'][1]" position="replace">
                <button name="action_bf_resend_invitations"
                        type="object"
                        class="oe_highlight"
                        string="Renvoyer les invitations"
                        help="Renvoie la confirmation brandée, avec le fichier d'agenda, dans la langue et le fuseau de chaque destinataire."
                        invisible="state != 'pending'"/>
            </xpath>
            <xpath expr="//header/button[@name='%(portal.portal_share_action)d'][1]" position="replace">
                <button name="action_bf_resend_invitations"
                        type="object"
                        string="Renvoyer les invitations"
                        help="Renvoie la confirmation brandée, avec le fichier d'agenda, dans la langue et le fuseau de chaque destinataire."
                        invisible="state not in ('scheduled', 'confirmed')"/>
            </xpath>
        </field>
    </record>

</odoo>
