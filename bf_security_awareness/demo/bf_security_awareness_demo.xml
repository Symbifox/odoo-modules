        <record id="demo_q1" model="slide.question">
            <field name="slide_id" ref="demo_slide_quiz"/>
            <field name="sequence">1</field>
            <field name="question">Un courriel « urgent » vous demande de confirmer votre mot de passe via un lien. Que faites-vous ?</field>
        </record>
        <record id="demo_q1_a1" model="slide.answer">
            <field name="question_id" ref="demo_q1"/>
            <field name="sequence">1</field>
            <field name="text_value">Je ne clique pas et je signale le message à l'équipe TI</field>
            <field name="is_correct" eval="True"/>
            <field name="comment">Exactement. Un service légitime ne demande jamais votre mot de passe par courriel.</field>
        </record>
        <record id="demo_q1_a2" model="slide.answer">
            <field name="question_id" ref="demo_q1"/>
            <field name="sequence">2</field>
            <field name="text_value">Je clique pour vérifier rapidement avant la fermeture</field>
            <field name="is_correct" eval="False"/>
            <field name="comment">C'est précisément ce que l'attaquant veut. L'urgence est un piège.</field>
        </record>
        <record id="demo_q1_a3" model="slide.answer">
            <field name="question_id" ref="demo_q1"/>
            <field name="sequence">3</field>
            <field name="text_value">Je saisis mon mot de passe pour confirmer mon identité</field>
            <field name="is_correct" eval="False"/>
            <field name="comment">Jamais. Vous donneriez vos accès directement à l'attaquant.</field>
        </record>

        <record id="demo_q2" model="slide.question">
            <field name="slide_id" ref="demo_slide_quiz"/>
            <field name="sequence">2</field>
            <field name="question">Quelle est la meilleure façon de protéger un compte ?</field>
        </record>
        <record id="demo_q2_a1" model="slide.answer">
            <field name="question_id" ref="demo_q2"/>
            <field name="sequence">1</field>
            <field name="text_value">Une phrase de passe unique et la double authentification (MFA)</field>
            <field name="is_correct" eval="True"/>
            <field name="comment">Oui : long, unique, et une seconde preuve d'identité.</field>
        </record>
        <record id="demo_q2_a2" model="slide.answer">
            <field name="question_id" ref="demo_q2"/>
            <field name="sequence">2</field>
            <field name="text_value">Le même mot de passe partout pour ne pas l'oublier</field>
            <field name="is_correct" eval="False"/>
            <field name="comment">Une seule fuite compromettrait alors tous vos comptes.</field>
        </record>
        <record id="demo_q2_a3" model="slide.answer">
            <field name="question_id" ref="demo_q2"/>
            <field name="sequence">3</field>
            <field name="text_value">Un mot de passe court mais très compliqué</field>
            <field name="is_correct" eval="False"/>
            <field name="comment">La longueur protège bien plus que la complexité d'un mot court.</field>
        </record>

        <record id="demo_q3" model="slide.question">
            <field name="slide_id" ref="demo_slide_quiz"/>
            <field name="sequence">3</field>
            <field name="question">Vous réalisez que vous avez cliqué sur un lien suspect. Quelle est la bonne réaction ?</field>
        </record>
        <record id="demo_q3_a1" model="slide.answer">
            <field name="question_id" ref="demo_q3"/>
            <field name="sequence">1</field>
            <field name="text_value">Je préviens l'équipe TI et je change mon mot de passe</field>
            <field name="is_correct" eval="True"/>
            <field name="comment">Parfait. Agir vite et signaler limite les dégâts.</field>
        </record>
        <record id="demo_q3_a2" model="slide.answer">
            <field name="question_id" ref="demo_q3"/>
            <field name="sequence">2</field>
            <field name="text_value">Je ne dis rien en espérant qu'il ne se passe rien</field>
            <field name="is_correct" eval="False"/>
            <field name="comment">Le silence laisse le temps à l'attaquant d'agir. On signale toujours.</field>
        </record>
        <record id="demo_q3_a3" model="slide.answer">
            <field name="question_id" ref="demo_q3"/>
            <field name="sequence">3</field>
            <field name="text_value">J'éteins mon ordinateur et je rentre chez moi</field>
            <field name="is_correct" eval="False"/>
            <field name="comment">Éteindre ne règle rien et empêche les TI de réagir à temps.</field>
        </record>

        <!-- ============================================================ -->
        <!-- Phishing templates (3 scenarios)                             -->
        <!-- ============================================================ -->
        <record id="demo_tpl_m365" model="bf.phishing.template">
            <field name="name">Microsoft 365 — Expiration du mot de passe</field>
            <field name="category">credential_harvest</field>
            <field name="difficulty">easy</field>
            <field name="landing_mode">credential</field>
            <field name="capture_field_lengths" eval="True"/>
            <field name="sender_name">Microsoft 365 — Sécurité du compte</field>
            <field name="email_from">no-reply@m365-securite.example</field>
            <field name="subject">Action requise : votre mot de passe expire aujourd'hui</field>
            <field name="landing_title">Connectez-vous à votre compte Microsoft</field>
            <field name="training_channel_id" ref="demo_channel"/>
            <field name="email_body" type="html">
                <div style="font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222;">
                    <p>Bonjour,</p>
                    <p>Votre mot de passe Microsoft 365 <strong>expire aujourd'hui</strong>.
                       Pour éviter la suspension de votre boîte courriel et de vos fichiers,
                       veuillez confirmer vos informations dès maintenant.</p>
                    <p style="text-align:center;margin:28px 0;">
                        <a t-att-href="object.landing_url"
                           style="background:#0067b8;color:#fff;text-decoration:none;
                                  padding:12px 22px;border-radius:3px;font-weight:bold;">
                            Conserver mon mot de passe
                        </a>
                    </p>
                    <p style="color:#666;font-size:12px;">Si vous n'agissez pas, l'accès à
                       votre compte sera temporairement bloqué.</p>
                    <p>Service de sécurité<br/>Microsoft 365</p>
                </div>
            </field>
            <field name="teachable_html" type="html">
                <p>Bonne nouvelle : <strong>aucune donnée n'a été compromise</strong>. Ce
                   courriel faisait partie d'une simulation interne et autorisée.</p>
                <p>Ce qui aurait dû vous alerter :</p>
                <ul>
                    <li>le domaine de l'expéditeur (<em>m365-securite.example</em>) n'est pas
                        un domaine Microsoft officiel;</li>
                    <li>l'urgence (« expire aujourd'hui ») qui pousse à agir vite;</li>
                    <li>une demande de saisir votre mot de passe hors du portail officiel.</li>
                </ul>
                <p>Microsoft ne vous demandera jamais votre mot de passe par courriel.</p>
            </field>
        </record>

        <record id="demo_tpl_bec" model="bf.phishing.template">
            <field name="name">Fraude au président — Virement urgent</field>
            <field name="category">wire_fraud</field>
            <field name="difficulty">hard</field>
            <field name="landing_mode">awareness</field>
            <field name="capture_field_lengths" eval="False"/>
            <field name="sender_name">Alex Tremblay (Direction générale)</field>
            <field name="email_from">direction@demltech.example</field>
            <field name="subject">Confidentiel — virement à traiter aujourd'hui</field>
            <field name="training_channel_id" ref="demo_channel"/>
            <field name="email_body" type="html">
                <div style="font-family:Arial,sans-serif;font-size:14px;color:#222;">
                    <p>Bonjour,</p>
                    <p>Je suis en réunion et je ne peux pas être dérangé. Nous devons
                       finaliser une acquisition aujourd'hui et un acompte doit partir
                       <strong>avant 15 h</strong>.</p>
                    <p>Peux-tu préparer un virement de 24 850 $ vers le fournisseur ?
                       Réponds-moi ici et je t'envoie les coordonnées bancaires. Garde ça
                       confidentiel pour l'instant.</p>
                    <p style="text-align:center;margin:24px 0;">
                        <a t-att-href="object.landing_url"
                           style="background:#444;color:#fff;text-decoration:none;
                                  padding:11px 20px;border-radius:3px;">
                            Voir les instructions de paiement
                        </a>
                    </p>
                    <p>Merci, je compte sur toi.<br/>Alex</p>
                </div>
            </field>
            <field name="teachable_html" type="html">
                <p>Ceci était une <strong>simulation autorisée</strong> de « fraude au
                   président » (BEC). Aucune somme n'a été engagée.</p>
                <p>Les signaux classiques :</p>
                <ul>
                    <li>l'adresse de l'expéditeur est falsifiée (<em>demltech</em> au lieu de
                        <em>demitech</em> — un « l » remplace le « i »);</li>
                    <li>l'urgence et le secret demandé (« avant 15 h », « confidentiel »);</li>
                    <li>une demande de virement inhabituelle, hors du processus normal.</li>
                </ul>
                <p>Réflexe : toujours confirmer une demande de paiement par un second canal
                   (téléphone, en personne), jamais uniquement par courriel.</p>
            </field>
        </record>

        <record id="demo_tpl_onedrive" model="bf.phishing.template">
            <field name="name">Document partagé — OneDrive</field>
            <field name="category">credential_harvest</field>
            <field name="difficulty">medium</field>
            <field name="landing_mode">credential</field>
            <field name="capture_field_lengths" eval="True"/>
