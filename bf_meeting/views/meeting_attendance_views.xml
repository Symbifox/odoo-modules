<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inline list view for meeting.attendance (used in meeting.record form) -->
    <record id="meeting_attendance_view_list" model="ir.ui.view">
        <field name="name">meeting.attendance.list</field>
        <field name="model">meeting.attendance</field>
        <field name="arch" type="xml">
            <!-- `status` deliberately has no widget="badge": BadgeField is a
                 read-only <span>, which makes the cell uneditable even in an
                 editable list. Decorations give the same colour cue. -->
            <list editable="bottom">
                <field name="partner_id"/>
                <field name="status"
                       decoration-success="status == 'present'"
                       decoration-danger="status == 'absent'"
                       decoration-warning="status == 'excused'"/>
                <field name="role"/>
            </list>
        </field>
    </record>

</odoo>
