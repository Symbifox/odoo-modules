<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==============================================================
         ⚠️ Ces pages ne s'appuient sur AUCUN gabarit du site. Le corps du
         site public de Blue Fox est sombre avec un texte blanc, et une
         carte blanche qui hérite de cette couleur rend du blanc sur blanc :
         le contenu disparaît sans qu'aucune erreur ne soit levée. Chaque
         surface déclare donc son fond ET sa couleur de texte.
         ============================================================== -->

    <template id="style_commun" name="Célébrations : variables de thème">
        <style>
            :root {
                --cel-fond: <t t-esc="palette.get('fond', '#FDF6EC')"/>;
                --cel-surface: <t t-esc="palette.get('surface', '#FFFFFF')"/>;
                --cel-texte: <t t-esc="palette.get('texte', '#2D3031')"/>;
                --cel-accent: <t t-esc="palette.get('accent', '#E8632B')"/>;
                --cel-accent-texte: <t t-esc="palette.get('accent_texte', '#BA4514')"/>;
                --cel-bouton-fond: <t t-esc="palette.get('bouton_fond', '#BA4514')"/>;
                --cel-bouton-texte: <t t-esc="palette.get('bouton_texte', '#FFFFFF')"/>;
                --cel-entete: <t t-esc="palette.get('entete', '#2D3031')"/>;
            }
        </style>
    </template>

    <!-- Le merci de la personne fêtée, tel que les signataires le lisent. -->
    <template id="bloc_merci" name="Célébrations : le merci">
        <section class="cel-carte cel-merci" t-if="board.thanks_html">
            <p class="cel-merci-etiquette">
                <t t-esc="board.recipient_name"/> vous remercie
            </p>
            <div class="cel-merci-corps cel-manuscrit">
                <div class="cel-mot-corps" t-out="board.thanks_html"/>
            </div>
            <p class="cel-mot-signature">— <t t-esc="board.recipient_name"/></p>
        </section>
    </template>

    <template id="page_signature" name="Célébrations : signer la carte">
        <t t-out="doctype"/>
        <html lang="fr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Signer la carte de <t t-esc="board.recipient_name"/></title>
                <link rel="stylesheet" href="/bf_celebrations/static/src/css/celebrations_public.css"/>
                <t t-call="bf_celebrations.style_commun"/>
            </head>
            <body class="cel-body">
                <main class="cel-wrap">
                    <header class="cel-header">
                        <h1 class="cel-title"><t t-esc="board.name"/></h1>
                        <p class="cel-subtitle" t-if="not ferme">
                            Ajoutez un mot. Aucun compte n'est demandé, et
                            <t t-esc="board.recipient_name"/> ne verra rien
                            avant la livraison.
                        </p>
                        <p class="cel-subtitle" t-else="">
                            Cette carte est livrée. Elle se lit encore, mais
                            elle ne se signe plus.
                        </p>
                        <p class="cel-actions" t-if="ferme and board.state == 'delivered'">
                            <a class="cel-bouton cel-bouton-secondaire"
                               t-attf-href="/celebration/#{token}/tableau">
                                Voir la carte</a>
                        </p>
                    </header>

                    <div t-if="board.intro_html" class="cel-intro"
                         t-out="board.intro_html"/>

                    <t t-if="ferme" t-call="bf_celebrations.bloc_merci"/>

                    <div t-if="merci" class="cel-alerte cel-alerte-ok">
                        Merci, votre mot est sur la carte.
                    </div>
                    <div t-if="en_attente" class="cel-alerte cel-alerte-info">
                        Merci. Votre mot attend le feu vert de la personne qui
                        organise avant de paraître.
                    </div>
                    <div t-if="request.params.get('erreur') == 'nom'"
                         class="cel-alerte cel-alerte-avis">
                        Signez votre mot : la carte a besoin de savoir de qui
                        il vient.
                    </div>
                    <div t-if="request.params.get('erreur') == 'vide'"
                         class="cel-alerte cel-alerte-avis">
                        Écrivez un mot, tracez quelque chose ou ajoutez une image.
                    </div>
                    <div t-if="request.params.get('erreur') == 'image'"
                         class="cel-alerte cel-alerte-avis">
                        Cette image n'a pas été retenue. Formats acceptés :
                        PNG, JPEG, GIF, WebP, jusqu'à 8 Mo.
                    </div>
                    <div t-if="request.params.get('erreur') == 'encre'"
                         class="cel-alerte cel-alerte-avis">
                        Le tracé n'a pas été retenu. Réessayez, avec un peu
                        moins de traits.
                    </div>

                    <section class="cel-carte cel-formulaire" t-if="not ferme">
                        <form method="post"
                              t-attf-action="/celebration/#{token}/signer"
                              enctype="multipart/form-data">
                            <label class="cel-label" for="author_name">
                                Votre nom
                            </label>
                            <input class="cel-input" type="text" id="author_name"
                                   name="author_name" maxlength="80" required="required"
                                   placeholder="Comment vous signez"/>

                            <div class="cel-onglets" role="tablist" aria-label="Comment écrire">
                                <button type="button" class="cel-onglet cel-onglet-actif"
                                        role="tab" aria-selected="true"
                                        data-cel-onglet="clavier">Écrire</button>
                                <button type="button" class="cel-onglet" role="tab"
                                        aria-selected="false"
                                        data-cel-onglet="main">À la main</button>
                            </div>

                            <div data-cel-volet="clavier">
                                <label class="cel-label" for="body">Votre mot</label>
                                <textarea class="cel-input cel-textarea" id="body"
                                          name="body" rows="5" maxlength="1200"
                                          placeholder="Ce que vous auriez écrit dans la carte de papier."/>
                                <label class="cel-case">
                                    <input type="checkbox" name="style" value="hand"/>
                                    Afficher mon mot en écriture manuscrite
                                </label>
                            </div>

                            <div data-cel-volet="main" hidden="hidden">
                                <label class="cel-label" for="cel-encre">
                                    Tracez votre mot ou votre signature
                                </label>
                                <!-- ⚠️ `touch-action: none` est dans la feuille :
                                     sans lui, le doigt fait défiler la page au
                                     lieu d'écrire. -->
                                <canvas id="cel-encre" class="cel-encre cel-encre-vide"
                                        width="800" height="320"
                                        aria-label="Zone pour écrire à la main"
                                        role="img"/>
                                <div class="cel-encre-outils">
                                    <button type="button" class="cel-bouton cel-bouton-secondaire cel-bouton-petit"
                                            id="cel-encre-annuler">Annuler le dernier trait</button>
                                    <button type="button" class="cel-bouton cel-bouton-secondaire cel-bouton-petit"
                                            id="cel-encre-effacer">Tout effacer</button>
                                </div>
                                <input type="hidden" name="ink" id="cel-encre-donnees"/>
                                <p class="cel-aide">Au doigt, au stylet ou à la souris.
                                   Le trait prend la couleur de la carte.</p>
                            </div>

                            <t t-if="board.allow_images">
                                <label class="cel-label" for="image">
                                    Une image ou un GIF, si le cœur vous en dit
                                </label>
                                <input class="cel-input cel-file" type="file"
                                       id="image" name="image"
                                       accept="image/png,image/jpeg,image/gif,image/webp"/>
                            </t>

                            <button class="cel-bouton" type="submit">
                                Ajouter à la carte
                            </button>
                        </form>
                    </section>

                    <section class="cel-mur">
                        <h2 class="cel-mur-titre" t-if="messages">
                            Déjà sur la carte
                        </h2>
                        <div class="cel-grille">
                            <article t-foreach="messages" t-as="mot"
                                     t-attf-class="cel-carte cel-mot #{'cel-manuscrit' if mot.style == 'hand' else ''}">
                                <img class="cel-mot-image" t-if="mot.image"
                                     t-attf-src="/celebration/#{token}/image/#{mot.id}"
                                     t-attf-alt="Image de #{mot.author_name}"/>
                                <div class="cel-mot-encre" t-if="mot.has_ink"
                                     t-out="mot.ink_svg()"/>
                                <div class="cel-mot-corps" t-out="mot.body"/>
                                <p class="cel-mot-signature">
                                    — <t t-esc="mot.author_name"/>
                                </p>
                            </article>
                        </div>
                        <p class="cel-vide" t-if="not messages">
                            Personne n'a encore signé. Vous pouvez être la
                            première personne.
                        </p>
                    </section>

                    <footer class="cel-pied">
                        <p>Cette page est privée : elle n'est pas indexée et
                           n'existe que pour qui a le lien.</p>
                    </footer>
                </main>
                <script t-if="not ferme" type="text/javascript"
                        src="/bf_celebrations/static/src/js/encre.js"/>
            </body>
        </html>
    </template>

    <template id="page_tableau" name="Célébrations : la carte">
        <t t-out="doctype"/>
        <html lang="fr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title><t t-esc="board.name"/></title>
                <link rel="stylesheet" href="/bf_celebrations/static/src/css/celebrations_public.css"/>
                <t t-call="bf_celebrations.style_commun"/>
            </head>
            <body class="cel-body">
                <!-- L'ouverture : une enveloppe, seulement quand la carte est
                     livrée et qu'il y a des mots. Cachée d'office ; le script
                     décide de la montrer (jamais si la personne a demandé
                     moins de mouvement, ni une seconde fois sans « Rejouer »). -->
                <div t-if="livre and messages" id="cel-ouverture"
                     class="cel-ouverture" hidden="hidden"
                     t-att-data-token="token"
                     t-att-data-rejouer="'1' if rejouer else '0'"
                     role="button" tabindex="0"
                     aria-label="Ouvrir la carte">
                    <div class="cel-enveloppe" aria-hidden="true">
                        <div class="cel-enveloppe-dos"/>
                        <div class="cel-enveloppe-carte">
                            <span class="cel-enveloppe-pour">Pour</span>
                            <strong t-esc="board.recipient_name"/>
                        </div>
                        <div class="cel-enveloppe-poche"/>
                        <div class="cel-enveloppe-rabat"/>
                    </div>
                    <p class="cel-ouverture-aide">Touchez pour ouvrir</p>
                </div>
                <div id="cel-confettis" class="cel-confettis" hidden="hidden"
                     aria-hidden="true"/>

                <main class="cel-wrap">
                    <header class="cel-header">
                        <h1 class="cel-title"><t t-esc="board.name"/></h1>
                        <p class="cel-subtitle">
                            <t t-esc="len(messages)"/> mot(s) de vos collègues.
                        </p>
                        <p class="cel-actions">
                            <a class="cel-bouton cel-bouton-secondaire"
                               t-attf-href="/celebration/#{token}/diaporama">
                                Voir en diaporama</a>
                            <a t-if="livre" class="cel-bouton cel-bouton-secondaire"
                               t-attf-href="/celebration/#{token}/tableau?ouvrir=1">
                                Rejouer l'ouverture</a>
                        </p>
                    </header>

                    <div t-if="board.intro_html" class="cel-intro"
                         t-out="board.intro_html"/>

                    <div t-if="merci_envoye" class="cel-alerte cel-alerte-ok">
                        Votre merci est parti à celles et ceux qui ont signé.
                    </div>
                    <div t-if="request.params.get('erreur') == 'vide'"
                         class="cel-alerte cel-alerte-avis">
                        Écrivez un mot avant d'envoyer.
                    </div>

                    <t t-call="bf_celebrations.bloc_merci"/>

                    <!-- Le formulaire de merci : seulement avec la clé qui n'est
                         que dans le courriel de la personne fêtée, et une fois. -->
                    <section class="cel-carte cel-merci-formulaire" t-if="peut_remercier">
                        <h2 class="cel-souvenir-titre">Dire merci</h2>
                        <p>Un mot pour celles et ceux qui ont signé. Il paraîtra
                           ici, et il leur sera envoyé une fois.</p>
                        <form method="post" t-attf-action="/celebration/#{token}/merci">
                            <input type="hidden" name="cle" t-att-value="cle"/>
                            <label class="cel-label" for="cel-merci-body">Votre mot</label>
                            <textarea class="cel-input cel-textarea" id="cel-merci-body"
                                      name="body" rows="4" maxlength="1200"
                                      placeholder="Merci à vous toutes et tous…"/>
                            <button class="cel-bouton" type="submit">Envoyer le merci</button>
                        </form>
                    </section>

                    <section class="cel-mur">
                        <div class="cel-grille">
                            <article t-foreach="messages" t-as="mot"
                                     t-attf-class="cel-carte cel-mot #{'cel-manuscrit' if mot.style == 'hand' else ''}">
                                <img class="cel-mot-image" t-if="mot.image"
                                     t-attf-src="/celebration/#{token}/image/#{mot.id}"
                                     t-attf-alt="Image de #{mot.author_name}"/>
                                <div class="cel-mot-encre" t-if="mot.has_ink"
                                     t-out="mot.ink_svg()"/>
                                <div class="cel-mot-corps" t-out="mot.body"/>
                                <p class="cel-mot-signature">
                                    — <t t-esc="mot.author_name"/>
                                </p>
                            </article>
                        </div>
                        <p class="cel-vide" t-if="not messages">
                            La carte est vide.
                        </p>
                    </section>

                    <!-- Ce qui reste quand le lien ne mènera plus nulle part :
                         un compte fermé, une purge de rétention. Les deux
                         fichiers sont aussi partis en pièces jointes du
                         courriel de livraison. -->
                    <section class="cel-carte cel-souvenir" t-if="livre">
                        <h2 class="cel-souvenir-titre">Garder cette carte</h2>
                        <p>Ce lien ne durera pas toujours. Téléchargez la carte
                           pour la garder : en PDF, ou en page complète qui
                           s'ouvre sans rien d'autre, où les images animées
                           bougent encore.</p>
                        <p class="cel-actions cel-actions-gauche">
                            <a class="cel-bouton" t-attf-href="/celebration/#{token}/pdf">
                                Télécharger en PDF</a>
                            <a class="cel-bouton cel-bouton-secondaire"
                               t-attf-href="/celebration/#{token}/souvenir">
                                Télécharger la page</a>
                        </p>
                    </section>
                </main>
                <script t-if="livre and messages" type="text/javascript"
                        src="/bf_celebrations/static/src/js/livraison.js"/>
            </body>
        </html>
    </template>

    <!-- ==============================================================
         La page souvenir : la carte entière dans UN fichier. Feuille de
         style, police et images sont dedans ; aucun script, aucun lien vers
         nous. Elle s'ouvre depuis le disque dans dix ans.
         ============================================================== -->
    <template id="page_souvenir" name="Célébrations : page souvenir">
        <t t-out="doctype"/>
        <html lang="fr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title><t t-esc="board.name"/></title>
                <t t-call="bf_celebrations.style_commun"/>
                <style t-out="css"/>
            </head>
            <body class="cel-body">
                <main class="cel-wrap">
                    <header class="cel-header">
                        <h1 class="cel-title"><t t-esc="board.name"/></h1>
                        <p class="cel-subtitle">
                            <t t-esc="len(messages)"/> mot(s) de vos collègues<t
                                t-if="board.delivered_date">, livrés le <t
                                t-esc="board.delivered_date"
                                t-options="{'widget': 'date'}"/></t>.
                        </p>
                    </header>
                    <div t-if="board.intro_html" class="cel-intro"
                         t-out="board.intro_html"/>
                    <section class="cel-mur">
                        <div class="cel-grille">
                            <article t-foreach="messages" t-as="mot"
                                     t-attf-class="cel-carte cel-mot #{'cel-manuscrit' if mot.style == 'hand' else ''}">
                                <img class="cel-mot-image"
                                     t-if="images.get(mot.id)"
                                     t-att-src="images.get(mot.id)"
                                     t-attf-alt="Image de #{mot.author_name}"/>
                                <div class="cel-mot-encre" t-if="mot.has_ink"
                                     t-out="mot.ink_svg()"/>
                                <div class="cel-mot-corps" t-out="mot.body"/>
                                <p class="cel-mot-signature">
                                    — <t t-esc="mot.author_name"/>
                                </p>
                            </article>
                        </div>
                    </section>
                    <footer class="cel-pied">
                        <p>Carte gardée depuis <t t-esc="board.company_id.name"/>.
                           Cette page est complète : elle n'a besoin de rien
                           d'autre pour s'ouvrir.</p>
                    </footer>
                </main>
            </body>
        </html>
    </template>

    <template id="page_diaporama" name="Célébrations : diaporama">
        <t t-out="doctype"/>
        <html lang="fr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Diaporama — <t t-esc="board.name"/></title>
                <link rel="stylesheet" href="/bf_celebrations/static/src/css/celebrations_public.css"/>
                <t t-call="bf_celebrations.style_commun"/>
            </head>
            <body class="cel-body cel-diapo-body">
                <div class="cel-diapo">
                    <h1 class="cel-diapo-titre"><t t-esc="board.name"/></h1>
                    <div class="cel-diapo-scene">
                        <article t-foreach="messages" t-as="mot"
                                 t-attf-class="cel-diapo-mot #{'cel-manuscrit' if mot.style == 'hand' else ''}"
                                 t-att-data-index="mot_index">
                            <img class="cel-diapo-image" t-if="mot.image"
                                 t-attf-src="/celebration/#{token}/image/#{mot.id}"
                                 t-attf-alt="Image de #{mot.author_name}"/>
                            <div class="cel-diapo-encre" t-if="mot.has_ink"
                                 t-out="mot.ink_svg()"/>
                            <div class="cel-diapo-corps" t-out="mot.body"/>
                            <p class="cel-diapo-signature">
                                — <t t-esc="mot.author_name"/>
                            </p>
                        </article>
                        <p class="cel-vide" t-if="not messages">
                            Rien à montrer pour l'instant.
                        </p>
                    </div>
                    <p class="cel-diapo-aide">
                        Espace met en pause, les flèches avancent et reculent.
                    </p>
                </div>
                <script type="text/javascript"
                        src="/bf_celebrations/static/src/js/diaporama.js"/>
            </body>
        </html>
    </template>

    <template id="page_indisponible" name="Célébrations : lien inutilisable">
        <t t-out="doctype"/>
        <html lang="fr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Lien indisponible</title>
                <link rel="stylesheet" href="/bf_celebrations/static/src/css/celebrations_public.css"/>
            </head>
            <body class="cel-body cel-body-neutre">
                <main class="cel-wrap">
                    <section class="cel-carte">
                        <h1 class="cel-title">Ce lien ne mène nulle part</h1>
                        <p class="cel-mot-corps"><t t-esc="motif"/></p>
                    </section>
                </main>
            </body>
        </html>
    </template>

</odoo>
