#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"%(auteur)s made the decision of %(qui)s on version %(version)s optional: it "
"no longer blocks publication."
msgstr ""
"%(auteur)s a rendu facultatif l'avis de %(qui)s sur la version %(version)s :"
" il ne bloque plus la publication."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"%(auteur)s recorded, on behalf of %(qui)s, the decision \"%(quoi)s\" on "
"version %(version)s.%(motif)s"
msgstr ""
"%(auteur)s a consigné, au nom de %(qui)s, l'avis « %(quoi)s » sur la version"
" %(version)s.%(motif)s"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "%(auteur)s removed %(qui)s from the approvers of version %(version)s."
msgstr ""
"%(auteur)s a retiré %(qui)s des approbateurs de la version %(version)s."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"%(auteur)s replaced %(avant)s with %(apres)s among the approvers of version "
"%(version)s."
msgstr ""
"%(auteur)s a remplacé %(avant)s par %(apres)s parmi les approbateurs de la "
"version %(version)s."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"%(geste)s: refused. %(n)s decision(s) still missing.\n"
"\n"
"Waiting for %(qui)s."
msgstr ""
"%(geste)s est refusé : %(n)s avis manquent encore.\n"
"\n"
"En attente de %(qui)s."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"%(geste)s: refused. %(qui)s rejected this version.\n"
"\n"
"%(motifs)s"
msgstr ""
"%(geste)s est refusé : %(qui)s a rejeté cette version.\n"
"\n"
"%(motifs)s"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "%(qui)s has %(quoi)s version %(version)s.%(motif)s"
msgstr "%(qui)s a %(quoi)s la version %(version)s.%(motif)s"

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"%(qui)s has given their decision: the line can no longer be removed and no "
"longer changes holder or required status. To start the approvals over, "
"create a new version."
msgstr ""
"L'avis de %(qui)s est donné : sa ligne ne se retire plus et ne change plus "
"de titulaire ni de caractère requis. Pour reprendre le tour de table, créez "
"une nouvelle version."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"A decision cannot be edited directly: the named person gives it with the "
"Approve and Reject buttons."
msgstr ""
"Un avis ne s'écrit pas : il se donne avec les boutons Approuver et Refuser, "
"par la personne nommée."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid ""
"A rejection without a reason cannot be acted on: say what needs to change."
msgstr "Un refus sans motif ne se traite pas : dites ce qui doit changer."

#. module: bf_document_approval
#. odoo-python
#: code:addons/bf_document_approval/models/approbation.py:0
msgid "A version that is not approved cannot be distributed."
msgstr "On ne diffuse pas une version qui n'est pas approuvée."

#. module: bf_document_approval
#: model_terms:ir.ui.view,arch_db:bf_document_approval.view_document_version_form_approbation
msgid "Approval"
msgstr "Approbation"

