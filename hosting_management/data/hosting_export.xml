        </record>
        <record id="export_line_service_software" model="ir.exports.line">
            <field name="export_id" ref="export_hosting_service_full"/>
            <field name="name">software_id/name</field>
        </record>
        <record id="export_line_service_version" model="ir.exports.line">
            <field name="export_id" ref="export_hosting_service_full"/>
