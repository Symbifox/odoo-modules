<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_nfc_tag_list" model="ir.ui.view">
        <field name="name">bf.nfc.tag.list</field>
        <field name="model">bf.nfc.tag</field>
        <field name="arch" type="xml">
            <list string="Tags">
                <field name="name"/>
                <field name="code"/>
                <field name="gesture_id"/>
                <field name="place" optional="show"/>
                <!-- ⚠️ PAS « cible » ici : une référence non stockée recalcule sa
                     sélection (deux recherches et un regroupement) à chaque LIGNE.
                     Le nom technique suffit en liste ; la fiche se lit au formulaire. -->
                <field name="res_model" optional="hide" string="Record type"/>
                <field name="sdm_enabled" optional="hide" string="Signed"/>
                <field name="tap_count" optional="show"/>
                <field name="last_tap_date" optional="show"/>
                <field name="date_expiry" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bf_nfc_tag_form" model="ir.ui.view">
        <field name="name">bf.nfc.tag.form</field>
        <field name="model">bf.nfc.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <header>
                    <button name="action_regenerer_code" type="object"
                            string="Change the code"
                            confirm="The physical tag will stop working and must be engraved again. Continue?"
                            groups="bf_nfc.group_nfc_manager"/>
                    <button name="action_voir_journal" type="object" string="Log"/>
                    <button name="action_ouvrir_cible" type="object" string="Open the target record"
                            invisible="not cible"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Retired" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Office door, client file, reception desk…"/></h1>
                    </div>
                    <group>
                        <group string="What it does">
                            <field name="gesture_id"/>
                            <field name="gesture_writes" invisible="1"/>
                            <field name="gesture_kind" invisible="1"/>
                            <field name="cible" options="{'no_create': True}"/>
                            <field name="res_model" groups="base.group_no_one" readonly="1"/>
                            <field name="res_id" groups="base.group_no_one" readonly="1"/>
                            <field name="params" placeholder="{&quot;minutes&quot;: 15}"/>
                            <field name="confirm_required" invisible="not gesture_writes"/>
                        </group>
                        <group string="What this tag is">
                            <field name="code"/>
                            <field name="url" widget="url" invisible="not url"/>
                            <field name="place"/>
                            <field name="date_expiry"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Signed tag (NTAG 424 DNA)"
                           groups="bf_nfc.group_nfc_manager">
                        <div class="text-muted" colspan="2">
                            A signed tag acts without an account: the chip signs every tap and its counter never goes back. This is what you need for a tag handed to someone else.
                        </div>
                        <field name="sdm_enabled"/>
                        <field name="sdm_uid" invisible="not sdm_enabled"
                               placeholder="04DE5F1EACC040"/>
                        <field name="user_id" invisible="not sdm_enabled"
                               required="sdm_enabled"/>
                        <field name="sdm_counter" invisible="not sdm_enabled"/>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Where it is placed, why, who engraved it."/>
                    </group>
                    <notebook>
                        <page string="Menu" name="menu" invisible="gesture_kind != 'menu'">
                            <div class="text-muted mb-2">
                                The buttons offered when the phone comes close. Each plays its gesture on the tag's record, with its own safeguards. Then engrave the tag from “My tags” in the app.
                            </div>
                            <field name="choice_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="gesture_id"/>
                                    <field name="style"/>
                                    <field name="params" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Log" name="journal">
                            <field name="tap_ids" readonly="1">
                                <list>
                                    <field name="tapped_at" string="When"/>
                                    <field name="offline" string="Sent later" optional="hide"/>
                                    <field name="user_id"/>
                                    <field name="door"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bf_nfc_tag_search" model="ir.ui.view">
        <field name="name">bf.nfc.tag.search</field>
        <field name="model">bf.nfc.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="place"/>
                <field name="gesture_id"/>
                <filter name="en_service" string="In service" domain="[('active', '=', True)]"/>
                <filter name="signees" string="Signed" domain="[('sdm_enabled', '=', True)]"/>
                <filter name="jamais_tapee" string="Never tapped" domain="[('tap_count', '=', 0)]"/>
                <filter name="expirees" string="Expired"
                        domain="[('date_expiry', '!=', False), ('date_expiry', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="retirees" string="Retired" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="par_geste" string="Gesture" context="{'group_by': 'gesture_id'}"/>
                    <filter name="par_type" string="Record type" context="{'group_by': 'res_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_nfc_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">bf.nfc.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_en_service': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Engrave a first tag</p>
            <p>A tag carries a public code and nothing else. Start with one that opens a record: it writes nothing, and it tells you whether the phone reads the chip through what you stuck it on.</p>
        </field>
    </record>
</odoo>
