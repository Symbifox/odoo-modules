<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Les lignes d'adresse du geste portent l'ancienne adresse, souvent
             l'ancien nom : comme l'assistant du socle, elles ne sont lues que
             par celui qui l'a ouvert. Règle globale, administrateur compris. -->
        <record id="rule_bf_preferred_name_rename_address_own" model="ir.rule">
            <field name="name">Change preferred name: own address lines only</field>
            <field name="model_id" ref="model_bf_preferred_name_rename_address"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

    </data>
</odoo>
