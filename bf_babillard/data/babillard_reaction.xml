<?xml version="1.0" encoding="utf-8"?>
<!-- 🔴 `noupdate="1"`, et ce n'est pas une précaution de style : c'est ce qui rend
     le décochage durable. Odoo ne retouche pas un enregistrement dont l'identifiant
     externe existe déjà, donc une réaction décochée par l'administration le reste
     à chaque mise à jour. Sans ça, un `-u` recochait les douze, et l'écran d'une
     maison qui n'en voulait que deux se regarnissait tout seul. -->
<odoo noupdate="1">

    <!-- Les cinq offertes d'emblée. Ni pouce vers le bas, ni symbole qui juge :
         sur une annonce de la maison, un 👎 n'ouvre pas une conversation, il la
         ferme. Qui veut nuancer a le fil de discussion juste en dessous. -->
    <record id="reaction_jaime" model="bf.babillard.reaction">
        <field name="name">J'aime</field>
        <field name="symbole">👍</field>
        <field name="sequence">10</field>
        <field name="active" eval="True"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_bravo" model="bf.babillard.reaction">
        <field name="name">Bravo</field>
        <field name="symbole">🎉</field>
        <field name="sequence">20</field>
        <field name="active" eval="True"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_coup_de_coeur" model="bf.babillard.reaction">
        <field name="name">Coup de cœur</field>
        <field name="symbole">❤️</field>
        <field name="sequence">30</field>
        <field name="active" eval="True"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_bonne_idee" model="bf.babillard.reaction">
        <field name="name">Bonne idée</field>
        <field name="symbole">💡</field>
        <field name="sequence">40</field>
        <field name="active" eval="True"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_merci" model="bf.babillard.reaction">
        <field name="name">Merci</field>
        <field name="symbole">🙏</field>
        <field name="sequence">50</field>
        <field name="active" eval="True"/>
        <field name="predefinie" eval="True"/>
    </record>

    <!-- Les sept autres attendent dans la liste, décochées. Elles sont là pour
         être cochées en deux secondes plutôt que retapées. -->
    <record id="reaction_bien_joue" model="bf.babillard.reaction">
        <field name="name">Bien joué</field>
        <field name="symbole">👏</field>
        <field name="sequence">60</field>
        <field name="active" eval="False"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_d_accord" model="bf.babillard.reaction">
        <field name="name">D'accord</field>
        <field name="symbole">🤝</field>
        <field name="sequence">70</field>
        <field name="active" eval="False"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_excellent" model="bf.babillard.reaction">
        <field name="name">Excellent</field>
        <field name="symbole">🔥</field>
        <field name="sequence">80</field>
        <field name="active" eval="False"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_rire" model="bf.babillard.reaction">
        <field name="name">Ça m'a fait rire</field>
        <field name="symbole">😂</field>
        <field name="sequence">90</field>
        <field name="active" eval="False"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_etonnant" model="bf.babillard.reaction">
        <field name="name">Étonnant</field>
        <field name="symbole">😮</field>
        <field name="sequence">100</field>
        <field name="active" eval="False"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_a_creuser" model="bf.babillard.reaction">
        <field name="name">À creuser</field>
        <field name="symbole">🤔</field>
        <field name="sequence">110</field>
        <field name="active" eval="False"/>
        <field name="predefinie" eval="True"/>
    </record>

    <record id="reaction_en_route" model="bf.babillard.reaction">
        <field name="name">En route</field>
        <field name="symbole">🚀</field>
        <field name="sequence">120</field>
        <field name="active" eval="False"/>
        <field name="predefinie" eval="True"/>
    </record>

</odoo>
