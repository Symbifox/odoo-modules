<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_contact_cc_rule_list" model="ir.ui.view">
        <field name="name">contact.cc.rule.list</field>
        <field name="model">contact.cc.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false">
                <field name="persona_id" readonly="1"/>
                <field name="rule_type"/>
                <field name="cc_partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="mandatory" widget="boolean_toggle" invisible="rule_type == 'never'"/>
                <field name="state" readonly="1" widget="badge"
                       decoration-info="state == 'suggested'"
                       decoration-success="state == 'active'"/>
                <field name="evidence"/>
                <field name="notes" optional="hide"/>
                <button name="action_confirm" type="object" string="Confirmer"
                        icon="fa-check" invisible="state != 'suggested'"/>
                <button name="action_reject" type="object" string="Rejeter"
                        icon="fa-times" invisible="state != 'suggested'"/>
            </list>
        </field>
    </record>

    <record id="view_contact_cc_rule_search" model="ir.ui.view">
        <field name="name">contact.cc.rule.search</field>
        <field name="model">contact.cc.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="persona_id"/>
                <field name="cc_partner_ids"/>
                <filter string="Suggérées" name="filter_suggested" domain="[('state','=','suggested')]"/>
                <filter string="Actives" name="filter_active" domain="[('state','=','active')]"/>
                <filter string="Rejetées" name="filter_rejected" domain="[('state','=','rejected')]"/>
            </search>
        </field>
    </record>

    <record id="action_contact_cc_rule" model="ir.actions.act_window">
        <field name="name">Règles de copie</field>
        <field name="res_model">contact.cc.rule</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_contact_cc_rule_search"/>
        <field name="context">{'search_default_filter_suggested': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune règle de copie à revoir.</p>
            <p>Les règles suggérées viennent des courriels envoyés : une personne habituellement
               en copie avec un contact. Rien ne s'applique avant confirmation.</p>
        </field>
    </record>

</odoo>
