<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="bf_otp.App">
    <div class="o_bf_otp d-flex flex-column h-100">

        <!-- Contexte non sécurisé : rien ne peut marcher, et il vaut mieux le
             dire une fois que d'échouer champ par champ. -->
        <div t-if="!state.secure" class="alert alert-danger m-4" role="alert">
            <h5>Encryption unavailable</h5>
            <p class="mb-0">
                This vault encrypts seeds in the browser, which requires a secure connection. This page is served without HTTPS, so
                <code>crypto.subtle</code> is not available. Open Odoo over HTTPS.
            </p>
        </div>

        <t t-elif="!state.ready">
            <div class="d-flex justify-content-center p-5"><span class="fa fa-circle-o-notch fa-spin fa-2x text-muted"/></div>
        </t>

        <!-- Aucun coffre : on en crée un -->
        <t t-elif="!state.vault">
            <div class="o_bf_otp_gate mx-auto p-4">
                <h4 class="mb-3">Create your token vault</h4>
                <div class="alert alert-warning" role="alert">
                    <strong>Read this before continuing.</strong>
                    Seeds are encrypted here, in your browser, with a key derived from this passphrase. The server never receives it and cannot recover it. <strong>Lost passphrase, lost tokens</strong> (keep it in your password manager before confirming).
                </div>
                <form t-on-submit="onCreateVault">
                    <div class="mb-2">
                        <label class="form-label" for="bf_otp_pass">Passphrase</label>
                        <input id="bf_otp_pass" type="password" class="form-control"
                               t-ref="passphrase" autocomplete="new-password"
                               placeholder="at least twelve characters"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bf_otp_pass2">Repeat it</label>
                        <input id="bf_otp_pass2" type="password" class="form-control"
                               t-ref="confirm" autocomplete="new-password"/>
                    </div>
                    <div t-if="state.error" class="alert alert-danger py-2" t-esc="state.error"/>
                    <button class="btn btn-primary" type="submit" t-att-disabled="state.busy">
                        <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                        Create the vault
                    </button>
                </form>
            </div>
        </t>

        <!-- Coffre fermé -->
        <t t-elif="!state.unlocked">
            <div class="o_bf_otp_gate mx-auto p-4 text-center">
                <div class="mb-3"><span class="fa fa-lock fa-3x text-muted"/></div>
                <h4>Vault locked</h4>
                <p class="text-muted">
                    <t t-esc="state.vault.token_count"/> token(s) inside.
                </p>
                <button t-if="credentials.length and state.passkeyOk"
                        class="btn btn-primary w-100 mb-3"
                        t-on-click="onUnlockWithPasskey" t-att-disabled="state.busy">
                    <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                    <span t-else="" class="fa fa-fingerprint me-1"/>
                    Unlock with a passkey
                </button>
                <div t-if="credentials.length and state.passkeyOk" class="text-muted small mb-2">or</div>
                <!-- Disparaît dès la première clé enrôlée : ce n'est pas un
                     bandeau permanent, c'est la seule occasion de dire que le
                     déverrouillage par capteur existe. -->
                <p t-if="!credentials.length and state.passkeyOk" class="text-muted small mb-2">
                    <span class="fa fa-fingerprint me-1"/>
                    This vault can also be unlocked by touching a sensor. Unlock it, then click "Passkey" in the top bar.
                </p>
                <form t-if="!state.useRecovery" t-on-submit="onUnlock" class="text-start">
                    <input type="password" class="form-control mb-2" t-ref="passphrase"
                           autocomplete="current-password" placeholder="Passphrase"/>
                    <div t-if="state.error" class="alert alert-danger py-2" t-esc="state.error"/>
                    <button class="btn w-100" type="submit" t-att-disabled="state.busy"
                            t-att-class="credentials.length and state.passkeyOk ? 'btn-secondary' : 'btn-primary'">
                        <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                        Unlock
                    </button>
                </form>

                <!-- ⚠️ Le code de relève ne s'annonce QUE s'il en existe un.
                     Proposer une porte qui n'a pas été fabriquée enverrait
                     quelqu'un fouiller un coffre-fort vide, le jour précis où
                     il a déjà perdu sa phrase. -->
                <form t-if="state.useRecovery" t-on-submit="onUnlockWithRecovery" class="text-start">
                    <label class="form-label small">Recovery code</label>
                    <input type="text" class="form-control mb-2 font-monospace text-uppercase"
                           t-model="state.recovInput" autocomplete="off" spellcheck="false"
                           placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"/>
                    <div class="form-text mb-2">
                        Dashes, spaces and letter case do not matter.
                    </div>
                    <div t-if="state.error" class="alert alert-danger py-2" t-esc="state.error"/>
                    <button class="btn btn-primary w-100" type="submit" t-att-disabled="state.busy">
                        <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                        Unlock with this code
                    </button>
                </form>
                <button t-if="recoveries.length" class="btn btn-link btn-sm mt-2"
                        t-on-click="() => { state.useRecovery = !state.useRecovery; state.error = ''; }">
                    <t t-esc="state.useRecovery ? txt.revenirPhrase : txt.phrasePerdue"/>
                </button>
            </div>
        </t>

        <!-- Coffre ouvert -->
        <t t-else="">
            <div class="o_bf_otp_bar d-flex align-items-center gap-2 p-2 border-bottom">
                <input type="search" class="form-control form-control-sm o_bf_otp_search"
                       placeholder="Search for an account, an issuer, a grouping"
                       t-model="state.search"/>
                <button class="btn btn-sm btn-primary" t-on-click="() => this.openForm()">
                    <span class="fa fa-plus me-1"/>Add
                </button>
                <button class="btn btn-sm btn-secondary" t-on-click="() => state.showImport = true">
                    <span class="fa fa-upload me-1"/>Import
                </button>
                <button class="btn btn-sm btn-secondary"
                        t-on-click="() => { state.showExport = true; state.error = ''; }"
                        title="Write the vault to an encrypted file">
                    <span class="fa fa-download me-1"/>Export
                </button>
                <button class="btn btn-sm btn-light ms-auto"
                        t-on-click="toggleSort"
                        t-att-title="state.sortMode === 'recent' ? txt.trieRecent : txt.trieNom">
                    <span t-att-class="state.sortMode === 'recent' ? 'fa fa-history me-1' : 'fa fa-sort-alpha-asc me-1'"/>
                    <t t-esc="state.sortMode === 'recent' ? txt.recents : 'A-Z'"/>
                </button>
                <button class="btn btn-sm btn-light" t-on-click="() => state.compact = !state.compact"
                        t-att-title="state.compact ? txt.vueCartes : txt.vueCompacte">
                    <span t-att-class="state.compact ? 'fa fa-th-large' : 'fa fa-bars'"/>
                </button>
                <button class="btn btn-sm btn-light" t-on-click="openArchive"
                        title="Archive: put away, alive, and still usable">
                    <span class="fa fa-archive"/>
                    <span t-if="archivedTokens.length" class="badge text-bg-secondary ms-1"
                          t-esc="archivedTokens.length"/>
                </button>
                <button class="btn btn-sm btn-light" t-on-click="openTrash"
                        title="Trash">
                    <span class="fa fa-trash-o"/>
                </button>
                <!-- Tant qu'aucun code n'existe, le bouton porte son nom : c'est
                     la seule occasion de faire savoir que la phrase n'est plus
                     l'unique porte. Une fois un code en place, la barre se
                     resserre, comme pour les clés d'accès. -->
                <button class="btn btn-sm btn-light" t-on-click="openRecovery"
                        title="Recovery codes">
                    <span class="fa fa-life-ring"/>
                    <span t-if="!recoveries.length" class="ms-1">Recovery code</span>
                </button>
                <button t-if="state.passkeyOk" class="btn btn-sm btn-light"
                        t-on-click="onOpenKeys" title="Passkeys">
                    <span class="fa fa-fingerprint"/>
                    <!-- Tant que rien n'est enrôlé, l'icône seule ne dit à
                         personne que la fonction existe : elle porte donc son
                         nom. Une fois une clé en place, la barre se resserre. -->
                    <span t-if="!credentials.length" class="ms-1">Passkey</span>
                </button>
                <button class="btn btn-sm btn-light" t-on-click="() => this.lock()"
                        title="Lock the vault (Esc)">
                    <span class="fa fa-lock me-1"/>Lock vault
                </button>
            </div>

            <div class="flex-grow-1 overflow-auto p-3">
                <div t-if="state.tokens.length" class="small text-muted mb-2">
                    Type to search · <kbd>Enter key</kbd> copies the first one · <kbd>Esc key</kbd> clears, then locks
                </div>
                <div t-if="!state.tokens.length" class="text-center text-muted p-5">
                    <p class="mb-1">This vault is empty.</p>
                    <p>Add a token, or import the export from your OTP manager.</p>
                </div>

                <t t-foreach="groupes" t-as="grp" t-key="grp[0]">
                    <h6 class="text-uppercase text-muted small mt-3 mb-2" t-esc="grp[0]"/>
                    <div t-att-class="state.compact ? 'o_bf_otp_list' : 'o_bf_otp_grid'">
                        <t t-foreach="grp[1]" t-as="tok" t-key="tok.id">
                            <div class="o_bf_otp_card card"
                                 t-att-class="{ 'o_bf_otp_broken': tok.broken, 'o_bf_otp_compact': state.compact }">
                                <div class="card-body py-2 px-3">
                                    <div class="d-flex align-items-start">
                                        <span class="o_bf_otp_chip me-2" t-att-style="chipStyle(tok)">
                                            <svg t-if="icone(tok)" viewBox="0 0 24 24"
                                                 class="o_bf_otp_glyphe" aria-hidden="true"
                                                 xmlns="http://www.w3.org/2000/svg">
                                                <path t-att-d="icone(tok).d" fill="currentColor"/>
                                            </svg>
                                            <t t-else="" t-esc="chipText(tok)"/>
                                        </span>
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="fw-bold text-truncate" t-esc="tok.issuer or tok.name"/>
                                            <div class="small text-muted text-truncate" t-esc="tok.name"/>
                                            <div t-if="tok.partner_id or tok.project_id" class="small text-truncate">
                                                <span t-if="tok.partner_id" class="badge text-bg-light me-1">
                                                    <i class="fa fa-user me-1" title="Client"/><t t-esc="tok.partner_id[1]"/>
                                                </span>
                                                <span t-if="tok.project_id" class="badge text-bg-light">
                                                    <i class="fa fa-folder-o me-1" title="Project"/><t t-esc="tok.project_id[1]"/>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-light" t-on-click="() => this.toggleFavorite(tok)"
                                                    t-att-title="tok.favorite ? txt.retirerFavori : txt.mettreFavori">
                                                <span t-att-class="tok.favorite ? 'fa fa-star text-warning' : 'fa fa-star-o'"/>
                                            </button>
                                            <button class="btn btn-light" t-on-click="() => this.openForm(tok)"
                                                    title="Edit"><span class="fa fa-pencil"/></button>
                                            <!-- ⚠️ Ranger et supprimer côte à côte, mais jamais du
                                                 même ton : l'archive est grise et réversible, la
                                                 corbeille est rouge. Le geste qui coûte cher doit
                                                 se distinguer à l'œil, pas seulement à l'infobulle. -->
                                            <button class="btn btn-light" t-on-click="() => this.toggleArchive(tok)"
                                                    t-att-title="tok.archived ? txt.ressortir : txt.ranger">
                                                <span t-att-class="tok.archived ? 'fa fa-inbox text-primary' : 'fa fa-archive'"/>
                                            </button>
                                            <button class="btn btn-light text-danger" t-on-click="() => this.removeToken(tok)"
                                                    title="Delete"><span class="fa fa-trash"/></button>
                                        </div>
                                    </div>
                                    <div t-if="tok.broken" class="small text-danger mt-2">
                                        This token cannot be decrypted with this passphrase.
                                    </div>
                                    <div t-else="" class="d-flex align-items-center mt-2">
                                        <button class="o_bf_otp_code btn btn-link p-0 me-auto"
                                                t-on-click="() => this.copyCode(tok)"
                                                t-att-title="isRevealed(tok) ? txt.copier : txt.afficher">
                                            <span t-esc="displayCode(tok)"/>
                                        </button>
                                        <button t-if="tok.sensitive" class="btn btn-sm btn-light me-2"
                                                t-on-click="() => this.toggleReveal(tok)">
                                            <span t-att-class="isRevealed(tok) ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                                        </button>
                                        <span t-if="tok.otp_type === 'totp'" class="o_bf_otp_left small"
                                              t-att-class="tok.left &lt;= 5 ? 'text-danger' : 'text-muted'"
                                              t-esc="tok.left + ' s'"/>
                                        <span t-else="" class="badge text-bg-secondary">No. <t t-esc="tok.counter"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>

            <!-- Ajout / modification -->
            <div t-if="state.showForm" class="o_bf_otp_overlay">
                <div class="o_bf_otp_panel card shadow">
                    <div class="card-header d-flex align-items-center">
                        <strong t-esc="state.form.id ? txt.modifierToken : txt.ajouterToken"/>
                        <button class="btn-close ms-auto" t-on-click="() => state.showForm = false"/>
                    </div>
                    <form class="card-body" t-on-submit="saveToken">
                        <div class="mb-3">
                            <label class="form-label">Paste an otpauth:// address</label>
                            <input type="text" class="form-control" t-model="state.form.uri"
                                   t-on-change="onUriPasted"
                                   placeholder="otpauth://totp/…"/>
                            <div class="form-text">Fills in the fields below in one go.</div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label">Issuer</label>
                                <input class="form-control" t-model="state.form.issuer"/></div>
                            <div class="col-6"><label class="form-label">Account</label>
                                <input class="form-control" t-model="state.form.name" required="required"/></div>
                            <div class="col-12"><label class="form-label">Seed (base32)</label>
                                <input class="form-control font-monospace" type="password"
                                       t-model="state.form.secret" autocomplete="off"
                                       t-att-placeholder="state.form.id ? txt.laisserVide : ''"/></div>
                            <div class="col-4"><label class="form-label">Type</label>
                                <select class="form-select" t-model="state.form.otp_type">
                                    <option value="totp">TOTP</option>
                                    <option value="hotp">HOTP</option>
                                </select></div>
                            <div class="col-4"><label class="form-label">Algorithm</label>
                                <select class="form-select" t-model="state.form.algorithm">
                                    <option value="SHA1">SHA-1</option>
                                    <option value="SHA256">SHA-256</option>
                                    <option value="SHA512">SHA-512</option>
                                </select></div>
                            <div class="col-2"><label class="form-label">Number of digits</label>
                                <input class="form-control" type="number" t-model="state.form.digits" min="6" max="8"/></div>
                            <div class="col-2"><label class="form-label">Period</label>
                                <input class="form-control" type="number" t-model="state.form.period" min="1"/></div>
                            <div class="col-6 position-relative">
                                <label class="form-label">Client</label>
                                <div class="input-group">
                                    <input class="form-control" t-model="state.form.partner_label"
                                           t-on-input="(ev) => this.chercherCible('res.partner', ev.target.value)"
                                           placeholder="two letters are enough"/>
                                    <button class="btn btn-outline-secondary" type="button"
                                            t-if="state.form.partner_id"
                                            t-on-click="() => this.effacerCible('partner_id')"
                                            title="Detach">×</button>
                                </div>
                            </div>
                            <div class="col-6 position-relative">
                                <label class="form-label">Project</label>
                                <div class="input-group">
                                    <input class="form-control" t-model="state.form.project_label"
                                           t-on-input="(ev) => this.chercherCible('project.project', ev.target.value)"
                                           placeholder="two letters are enough"/>
                                    <button class="btn btn-outline-secondary" type="button"
                                            t-if="state.form.project_id"
                                            t-on-click="() => this.effacerCible('project_id')"
                                            title="Detach">×</button>
                                </div>
                            </div>
                            <div class="col-12" t-if="state.lookup.length">
                                <div class="list-group o_bf_otp_lookup">
                                    <t t-foreach="state.lookup" t-as="ligne" t-key="ligne[0]">
                                        <button type="button" class="list-group-item list-group-item-action py-1"
                                                t-on-click="() => this.choisirCible(ligne)">
                                            <t t-esc="ligne[1]"/>
                                        </button>
                                    </t>
                                </div>
                            </div>
                            <div class="col-6"><label class="form-label">Grouping</label>
                                <input class="form-control" t-model="state.form.group_name"
                                       placeholder="leave empty: the client serves as the grouping"/></div>
                            <div class="col-6 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="bf_otp_sens"
                                           t-model="state.form.sensitive"/>
                                    <label class="form-check-label" for="bf_otp_sens">Sensitive (code hidden)</label>
                                </div>
                            </div>
                        </div>
                        <div t-if="state.error" class="alert alert-danger py-2 mt-3" t-esc="state.error"/>
                        <div class="mt-3 text-end">
                            <button type="button" class="btn btn-secondary me-2"
                                    t-on-click="() => state.showForm = false">Cancel</button>
                            <button type="submit" class="btn btn-primary" t-att-disabled="state.busy">Save</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Clés d'accès -->
            <div t-if="state.showKeys" class="o_bf_otp_overlay">
                <div class="o_bf_otp_panel card shadow">
                    <div class="card-header d-flex align-items-center">
                        <strong>Passkeys</strong>
                        <button class="btn-close ms-auto" t-on-click="() => state.showKeys = false"/>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info" role="alert">
                            A passkey unlocks this vault with a touch of a sensor, without typing the passphrase. It seals a copy of the vault key; the server still cannot read anything.
                            <strong>Keep your passphrase</strong>: a passkey is tied to this device and this domain, and the passphrase is what saves you if you lose either one.
                        </div>

                        <div t-if="state.prfRefus" class="alert alert-warning" role="alert">
                            <p class="mb-2">
                                <strong>This passkey provider does not support the PRF extension.</strong>
                                Without it, a passkey proves who you are but returns no secret: there is nothing to seal the vault key with.
                            </p>
                            <p class="mb-2">
                                🔴 <strong>A useless passkey has just been created</strong> with your provider, under the name "Symbifox Tokens". Remove it, it will never work.
                            </p>
                            <p class="mb-0">
                                What works: a <strong>FIDO2 hardware key</strong>
                                (YubiKey and similar), the <strong>password manager on your phone</strong> via the QR code, or the device's built-in manager when it has one.
                                <span class="d-block mt-1 small">
                                    ⚠️ Bitwarden is in this situation: its extension does create the key, but does not return PRF.
                                </span>
                            </p>
                        </div>

                        <div t-if="!credentials.length" class="text-muted mb-3">
                            No passkey registered.
                        </div>
                        <ul t-else="" class="list-group mb-3">
                            <t t-foreach="credentials" t-as="c" t-key="c.id">
                                <li class="list-group-item d-flex align-items-center">
                                    <span class="fa fa-fingerprint me-2 text-muted"/>
                                    <span class="flex-grow-1" t-esc="c.name"/>
                                    <button class="btn btn-sm btn-light text-danger"
                                            t-on-click="() => this.onRemovePasskey(c)"
                                            title="Remove passkey"><span class="fa fa-trash"/></button>
                                </li>
                            </t>
                        </ul>

                        <form t-on-submit="onEnrolPasskey">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Device name</label>
                                    <input class="form-control" t-model="state.enrolName"
                                           placeholder="MacBook, yellow key…"/>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Your passphrase</label>
                                    <input type="password" class="form-control"
                                           t-model="state.enrolPass" autocomplete="current-password"/>
                                    <div class="form-text">Asked again on purpose to add a way to unlock.</div>
                                </div>
                            </div>
                            <div t-if="state.error" class="alert alert-danger py-2 mt-3" t-esc="state.error"/>
                            <div class="mt-3 text-end">
                                <button type="submit" class="btn btn-primary" t-att-disabled="state.busy">
                                    <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                                    Add this passkey
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Import -->
            <div t-if="state.showImport" class="o_bf_otp_overlay">
                <div class="o_bf_otp_panel card shadow">
                    <div class="card-header d-flex align-items-center">
                        <strong>Import from an OTP manager</strong>
                        <button class="btn-close ms-auto" t-on-click="() => state.showImport = false"/>
                    </div>
                    <form class="card-body" t-on-submit="runImport">
                        <p class="text-muted small mb-2">
                            Paste what you have. Three sources are recognized from the content, with nothing to choose:
                        </p>
                        <ul class="text-muted small">
                            <li>a <strong>Symbifox export</strong>, the one the "Export" button produces;</li>
                            <li>a <strong>Google Authenticator export</strong> (the
                                <code>otpauth-migration://</code> address contained in its QR code);</li>
                            <li>a <strong>Nextcloud OTP manager export</strong>, in JSON, encrypted or not.</li>
                        </ul>
                        <p class="text-muted small">
                            Decryption and re-encryption happen in this page: the server only sees encrypted data.
                        </p>
                        <textarea class="form-control font-monospace" rows="8"
                                  t-model="state.importText"
                                  placeholder='{"accounts": [ … ]}   ·   otpauth-migration://offline?data=…'/>
                        <div class="mt-2">
                            <label class="form-label">Export passphrase</label>
                            <input type="password" class="form-control" t-model="state.importPassword"
                                   autocomplete="off"/>
                            <div class="form-text">
                                Needed only if the file is encrypted: the passphrase chosen at export time for a Symbifox export, the original vault's passphrase for an <code>accounts_encrypted_secret.json</code>.
                            </div>
                        </div>
                        <div t-if="state.error" class="alert alert-danger py-2 mt-3" t-esc="state.error"/>
                        <div class="mt-3 text-end">
                            <button type="button" class="btn btn-secondary me-2"
                                    t-on-click="() => state.showImport = false">Cancel</button>
                            <button type="submit" class="btn btn-primary" t-att-disabled="state.busy">
                                <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>Import
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Export -->
            <div t-if="state.showExport" class="o_bf_otp_overlay">
                <div class="o_bf_otp_panel card shadow">
                    <div class="card-header d-flex align-items-center">
                        <strong>Export the vault</strong>
                        <button class="btn-close ms-auto" t-on-click="() => state.showExport = false"/>
                    </div>
                    <form class="card-body" t-on-submit="onExport">
                        <p class="text-muted small">
                            The file holds your
                            <t t-esc="state.tokens.length"/> token(s), encrypted with the passphrase you choose here. It is built in this page: the server takes no part in it and keeps nothing of it.
                        </p>
                        <div class="alert alert-warning py-2 small" role="alert">
                            <strong>This passphrase is not the vault's</strong>, and that is deliberate: the file goes elsewhere and outlives a session. Without it, no one can read the export again, not us and not anyone else.
                        </div>
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Passphrase for this file</label>
                                <input type="password" class="form-control" t-model="state.exportPass"
                                       autocomplete="new-password"/>
                            </div>
                            <div class="col-12">
                                <label class="form-label">The same one, to confirm</label>
                                <input type="password" class="form-control" t-model="state.exportConfirm"
                                       autocomplete="new-password"/>
                            </div>
                        </div>
                        <div t-if="state.error" class="alert alert-danger py-2 mt-3" t-esc="state.error"/>
                        <div class="mt-3 text-end">
                            <button type="button" class="btn btn-secondary me-2"
                                    t-on-click="() => state.showExport = false">Cancel</button>
                            <button type="submit" class="btn btn-primary" t-att-disabled="state.busy">
                                <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                                <span t-else="" class="fa fa-download me-1"/>Export
                            </button>
                        </div>
                    </form>

                    <!-- ══════════════════════════════════════════════════════
                         L'export EN CLAIR.

                         ⚠️ Hors du formulaire ci-dessus, et pas seulement parce
                         qu'un formulaire ne s'imbrique pas dans un autre : ce
                         sont deux gestes qui ne doivent jamais se confondre. Le
                         chiffré est le défaut et il a un bouton bleu ; le clair
                         est replié, rouge, et demande à écrire un mot.
                         ══════════════════════════════════════════════════════ -->
                    <div class="card-body border-top pt-3">
                        <button t-if="!state.clairOuvert" class="btn btn-sm btn-outline-danger"
                                t-on-click="ouvrirPorteClaire">
                            <span class="fa fa-unlock-alt me-1"/>Export in plaintext, without encryption
                        </button>
                        <form t-else="" t-on-submit="onExportClair">
                            <div class="alert alert-danger py-2 small" role="alert">
                                <strong>This file will contain your seeds in readable form.</strong>
                                Whoever opens it can generate your codes, with no password and no time limit. It does not expire, it cannot be revoked, and an automatic backup can copy it elsewhere without telling you. Use it to move to another manager, then delete it.
                            </div>
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label">Vault passphrase</label>
                                    <input type="password" class="form-control" t-model="state.clairPass"
                                           autocomplete="current-password"/>
                                    <div class="form-text">
                                        The one that unlocks this vault, asked again here: a screen left open is not a decision.
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">
                                        Type the word <strong t-esc="motDeGarde"/> to confirm
                                    </label>
                                    <input type="text" class="form-control" t-model="state.clairMot"
                                           autocomplete="off" t-att-placeholder="motDeGarde"/>
                                </div>
                            </div>
                            <div class="mt-3 text-end">
                                <button type="button" class="btn btn-secondary me-2"
                                        t-on-click="() => state.clairOuvert = false">Return</button>
                                <button type="submit" class="btn btn-danger" t-att-disabled="state.busy">
                                    <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                                    <span t-else="" class="fa fa-exclamation-triangle me-1"/>Download in plaintext
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Codes de relève -->
            <div t-if="state.showRecovery" class="o_bf_otp_overlay">
                <div class="o_bf_otp_panel card shadow">
                    <div class="card-header d-flex align-items-center">
                        <strong>Recovery codes</strong>
                        <button class="btn-close ms-auto" t-on-click="_fermerPanneaux"/>
                    </div>
                    <div class="card-body">
                        <!-- Le code, montré UNE fois. Tout le reste du panneau
                             disparaît pendant ce temps : rien ne doit inviter à
                             cliquer ailleurs avant de l'avoir mis à l'abri. -->
                        <div t-if="state.recovCode">
                            <div class="alert alert-warning" role="alert">
                                <strong>This code will never be shown again.</strong>
                                It was not sent to the server, and nothing anywhere can recover it. Put it somewhere safe before closing this screen.
                            </div>
                            <div class="o_bf_otp_code_releve font-monospace text-center my-3"
                                 t-esc="state.recovCode"/>
                            <p class="text-muted small">
                                This code unlocks the entire vault, exactly like your passphrase. It belongs in a sealed envelope, a safe, or a password manager other than the one these tokens protect.
                            </p>
                            <div class="text-end">
                                <button class="btn btn-secondary me-2" t-on-click="onImprimerCode">
                                    <span class="fa fa-print me-1"/>Print
                                </button>
                                <button class="btn btn-secondary me-2" t-on-click="onCopyRecoveryCode">
                                    <span class="fa fa-clipboard me-1"/>Copy
                                </button>
                                <button class="btn btn-primary" t-on-click="() => state.recovCode = ''">
                                    I have put it somewhere safe
                                </button>
                            </div>
                        </div>

                        <div t-else="">
                            <p class="text-muted small">
                                A passkey is tied to a device and a domain: it makes unlocking quick, it does not replace the passphrase. A recovery code, on the other hand, fits in an envelope and outlives the laptop.
                            </p>
                            <div t-if="recoveries.length" class="list-group mb-3">
                                <div t-foreach="recoveries" t-as="r" t-key="r.id"
                                     class="list-group-item d-flex align-items-center">
                                    <div>
                                        <div t-esc="r.name"/>
                                        <div class="text-muted small">
                                            Created on <t t-esc="r.created.slice(0, 10)"/>
                                            <t t-if="r.last_used">
                                                · used on <t t-esc="r.last_used.slice(0, 10)"/>
                                            </t>
                                        </div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger ms-auto"
                                            t-on-click="() => this.onRemoveRecovery(r)">Revoke</button>
                                </div>
                            </div>
                            <p t-else="" class="text-muted small fst-italic">
                                No code yet: the passphrase is the only way into this vault.
                            </p>

                            <form t-on-submit="onCreateRecovery">
                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label">Where it will be stored</label>
                                        <input type="text" class="form-control" t-model="state.recovName"
                                               placeholder="envelope in the safe"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Your passphrase</label>
                                        <input type="password" class="form-control" t-model="state.recovPass"
                                               autocomplete="current-password"/>
                                        <div class="form-text">
                                            Asked for on purpose: adding a way in is confirmed by what you know, not by the fact that this screen is open.
                                        </div>
                                    </div>
                                </div>
                                <div t-if="state.error" class="alert alert-danger py-2 mt-3" t-esc="state.error"/>
                                <div class="mt-3 text-end">
                                    <button type="submit" class="btn btn-primary" t-att-disabled="state.busy">
                                        <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                                        Create a code
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Corbeille -->
            <!-- ══════════════════════════════════════════════════════════
                 L'archive.

                 🔴 Elle ressemble à la corbeille et n'en est pas une. Aucun
                 bouton n'y détruit quoi que ce soit, et le code s'y produit
                 normalement : un token archivé est un token dont on se sert
                 deux fois par an, pas un token dont on ne veut plus.
                 ══════════════════════════════════════════════════════════ -->
            <div t-if="state.showArchive" class="o_bf_otp_overlay">
                <div class="o_bf_otp_panel card shadow">
                    <div class="card-header d-flex align-items-center">
                        <strong>Token archive</strong>
                        <span class="badge text-bg-secondary ms-2" t-esc="archivedTokens.length"/>
                        <button class="btn-close ms-auto" t-on-click="() => state.showArchive = false"/>
                    </div>
                    <div class="card-body">
                        <p t-if="!archivedTokens.length" class="text-muted text-center py-4 mb-0">
                            The archive is empty. The
                            <span class="fa fa-archive"/> button on a token puts it here: it leaves the everyday list, keeps its seed, and keeps generating its codes from this screen.
                        </p>
                        <div t-else="">
                            <p class="text-muted small">
                                These tokens are put away, not deleted. They generate their codes here, and the vault search finds them.
                            </p>
                            <div class="list-group">
                                <div t-foreach="archivedTokens" t-as="t" t-key="t.id"
                                     class="list-group-item d-flex align-items-center">
                                    <span class="o_bf_otp_chip me-2" t-att-style="chipStyle(t)">
                                        <svg t-if="icone(t)" viewBox="0 0 24 24"
                                             class="o_bf_otp_glyphe" aria-hidden="true"
                                             xmlns="http://www.w3.org/2000/svg">
                                            <path t-att-d="icone(t).d" fill="currentColor"/>
                                        </svg>
                                        <t t-else="" t-esc="chipText(t)"/>
                                    </span>
                                    <div class="min-w-0">
                                        <div class="text-truncate">
                                            <t t-if="t.issuer"><strong t-esc="t.issuer"/> · </t>
                                            <t t-esc="t.name"/>
                                        </div>
                                        <div class="text-muted small" t-if="t.archived_at">
                                            Put away on <t t-esc="t.archived_at.slice(0, 10)"/>
                                        </div>
                                    </div>
                                    <div class="ms-auto d-flex align-items-center">
                                        <button t-if="!t.broken" class="o_bf_otp_code btn btn-link p-0 me-3"
                                                t-on-click="() => this.copyCode(t)"
                                                t-att-title="isRevealed(t) ? txt.copier : txt.afficher">
                                            <span t-esc="displayCode(t)"/>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary"
                                                t-on-click="() => this.toggleArchive(t)">Bring back</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div t-if="state.showTrash" class="o_bf_otp_overlay">
                <div class="o_bf_otp_panel card shadow">
                    <div class="card-header d-flex align-items-center">
                        <strong>Trash</strong>
                        <button class="btn-close ms-auto" t-on-click="() => state.showTrash = false"/>
                    </div>
                    <div class="card-body">
                        <p t-if="!state.trash.length" class="text-muted text-center py-4 mb-0">
                            The trash is empty.
                        </p>
                        <div t-else="">
                            <p class="text-muted small">
                                A token removed from the vault lands here and stays here. Nothing destroys it on its own: destruction has to be requested, and it is permanent.
                            </p>
                            <div class="list-group">
                                <div t-foreach="state.trash" t-as="t" t-key="t.id"
                                     class="list-group-item d-flex align-items-center">
                                    <div>
                                        <div>
                                            <t t-if="t.issuer"><strong t-esc="t.issuer"/> · </t>
                                            <t t-esc="t.name"/>
                                        </div>
                                        <div class="text-muted small" t-if="t.deleted_at">
                                            Removed on <t t-esc="t.deleted_at.slice(0, 10)"/>
                                        </div>
                                    </div>
                                    <div class="ms-auto">
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                t-on-click="() => this.restoreToken(t)">Restore token</button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                t-on-click="() => this.purgeToken(t)">Destroy</button>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 text-end">
                                <button class="btn btn-outline-danger" t-on-click="emptyTrash">
                                    <span class="fa fa-trash me-1"/>Empty the trash
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
