msgstr "Purolator tracking is not connected. %s"

#. module: bf_property_parcel_tracking
#. odoo-python
#: code:addons/bf_property_parcel_tracking/models/bf_property_parcel.py:0
msgid "Le transporteur déclare ce colis livré (%s)."
msgstr "The carrier declares this parcel delivered (%s)."

#. module: bf_property_parcel_tracking
#. odoo-python
#: code:addons/bf_property_parcel_tracking/models/bf_property_parcel.py:0
msgid ""
"Le transporteur déclare ce colis livré : il passe en dépôt, et le "
"destinataire sera avisé."
msgstr ""
"The carrier declares this parcel delivered: it becomes held, and the "
"recipient will be notified."

#. module: bf_property_parcel_tracking
#. odoo-python
#: code:addons/bf_property_parcel_tracking/models/bf_property_parcel.py:0
msgid ""
"Le transporteur ne connaît pas ce numéro, après %s interrogations : il est "
"probablement mal saisi."
msgstr ""
"The carrier does not know this number, after %s queries: it is probably "
"mistyped."

#. module: bf_property_parcel_tracking
#: model:ir.model.fields.selection,name:bf_property_parcel_tracking.selection__bf_property_parcel__tracking_state__unknown
msgid "Le transporteur ne se prononce pas"
msgstr "The carrier does not say"

