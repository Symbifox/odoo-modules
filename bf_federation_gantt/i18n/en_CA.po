#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_origin
msgid "Origine"
msgstr "Origin"

#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_allowed_peer_ids
