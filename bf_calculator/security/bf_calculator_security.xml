<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Globale à dessein (aucun groupe) : l'historique d'une personne ne se
         lit pas, même par un administrateur. Ce qui a été versé au chatter
         suit, lui, les droits de la fiche. -->
    <record id="rule_bf_calculator_entry_own" model="ir.rule">
        <field name="name">Calculator: own history only</field>
        <field name="model_id" ref="model_bf_calculator_entry"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_bf_calculator_variable_own" model="ir.rule">
        <field name="name">Calculator: own variables only</field>
        <field name="model_id" ref="model_bf_calculator_variable"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
