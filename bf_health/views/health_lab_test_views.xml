<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="health_lab_test_view_list" model="ir.ui.view">
        <field name="name">health.lab.test.list</field>
        <field name="model">health.lab.test</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="test_type"/>
                <field name="date_requisition"/>
                <field name="date_performed"/>
                <field name="date_results"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'requisition'"
                       decoration-warning="state == 'scheduled'"
                       decoration-success="state in ('performed', 'results_received')"/>
                <field name="results_normal" widget="boolean"/>
                <field name="ordering_doctor"/>
                <field name="next_due_date"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="health_lab_test_view_form" model="ir.ui.view">
        <field name="name">health.lab.test.form</field>
        <field name="model">health.lab.test</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="requisition,scheduled,performed,results_received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'analyse"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Analyse">
                            <field name="test_type"/>
                            <field name="ordering_doctor"/>
                            <field name="lab_name"/>
                        </group>
                        <group string="Dates">
                            <field name="date_requisition"/>
                            <field name="date_performed"/>
                            <field name="date_results"/>
                            <field name="next_due_date"/>
                            <field name="next_due_lead_days"/>
                        </group>
                    </group>
                    <group string="Résultats">
                        <field name="results_normal"/>
                        <field name="results_summary"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="health_lab_test_view_kanban" model="ir.ui.view">
        <field name="name">health.lab.test.kanban</field>
        <field name="model">health.lab.test</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="test_type"/>
                <field name="date_performed"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5 mb-1">
                            <field name="name"/>
                        </div>
                        <div class="text-muted">
                            <field name="test_type"/>
                        </div>
                        <div t-if="record.date_performed.raw_value" class="mt-1">
                            <field name="date_performed"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar -->
    <record id="health_lab_test_view_calendar" model="ir.ui.view">
        <field name="name">health.lab.test.calendar</field>
        <field name="model">health.lab.test</field>
        <field name="arch" type="xml">
            <calendar string="Analyses" date_start="date_performed" color="test_type" mode="month">
                <field name="name"/>
                <field name="test_type"/>
            </calendar>
        </field>
    </record>

    <!-- Search -->
    <record id="health_lab_test_view_search" model="ir.ui.view">
        <field name="name">health.lab.test.search</field>
        <field name="model">health.lab.test</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ordering_doctor"/>
                <filter name="requisition" string="Réquisitions en attente" domain="[('state', 'in', ['requisition', 'scheduled'])]"/>
                <filter name="results" string="Résultats reçus" domain="[('state', '=', 'results_received')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'test_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Activity -->
    <record id="health_lab_test_view_activity" model="ir.ui.view">
        <field name="name">health.lab.test.activity</field>
        <field name="model">health.lab.test</field>
        <field name="arch" type="xml">
            <activity string="Analyses">
                <templates>
                    <div t-name="activity-box">
                        <field name="name" display="full"/>
                        <field name="test_type" muted="1" display="full"/>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- Actions -->
    <record id="health_lab_test_action" model="ir.actions.act_window">
        <field name="name">Analyses</field>
        <field name="res_model">health.lab.test</field>
        <field name="view_mode">list,kanban,form,calendar,activity</field>
        <field name="search_view_id" ref="health_lab_test_view_search"/>
    </record>

    <record id="health_lab_test_requisition_action" model="ir.actions.act_window">
        <field name="name">Réquisitions en attente</field>
        <field name="res_model">health.lab.test</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="health_lab_test_view_search"/>
        <field name="context">{'search_default_requisition': 1}</field>
    </record>

</odoo>
