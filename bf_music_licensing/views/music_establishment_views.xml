<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_music_establishment_list" model="ir.ui.view">
        <field name="name">bf.music.establishment.list</field>
        <field name="model">bf.music.establishment</field>
        <field name="arch" type="xml">
            <list string="Establishments">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="area_sqm" string="m²"/>
                <field name="music_source"/>
                <field name="entandem_account" optional="show"/>
                <field name="uncertified_period_count" string="Uncertified periods"/>
                <field name="amount_at_risk" sum="Total"/>
                <field name="adjustment_total" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_music_establishment_form" model="ir.ui.view">
        <field name="name">bf.music.establishment.form</field>
        <field name="model">bf.music.establishment</field>
        <field name="arch" type="xml">
            <form string="Establishment">
                <header>
                    <button name="action_build_history" type="object"
                            string="Assess exposure" class="oe_highlight"
                            confirm="A licence period will be created for each missing year since 2020, with its tariff lines. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_licences" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="licence_count" widget="statinfo" string="Periods"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Downtown branch"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="partner_id"/>
                            <field name="entandem_account" placeholder="Account number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Basis">
                            <label for="area_value"/>
                            <div class="o_row">
                                <field name="area_value"/>
                                <field name="area_uom"/>
                            </div>
                            <field name="area_sqm" readonly="1"/>
                            <field name="area_sqft" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Uses">
                            <field name="usage_background"/>
                            <field name="usage_on_hold"/>
                            <field name="on_hold_lines" invisible="not usage_on_hold"/>
                            <field name="days_of_operation"/>
                            <field name="seasonal"/>
                        </group>
                        <group string="Origin">
                            <field name="music_source"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not source_warning">
                        <field name="source_warning" readonly="1" nolabel="1"/>
                    </div>
                    <group string="Exposure">
                        <group>
                            <field name="amount_reference"/>
                            <field name="amount_at_risk"/>
                        </group>
                        <group>
                            <field name="uncertified_period_count"/>
                            <field name="adjustment_total"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Licence periods" name="licences">
                            <field name="licence_ids">
                                <list>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="due_date"/>
                                    <field name="amount_reference"/>
                                    <field name="amount_at_risk"/>
                                    <field name="adjustment_total"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'completed'"
                                           decoration-danger="status == 'overdue'"
                                           decoration-warning="status == 'due_soon'"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_music_establishment_search" model="ir.ui.view">
        <field name="name">bf.music.establishment.search</field>
        <field name="model">bf.music.establishment</field>
        <field name="arch" type="xml">
            <search string="Establishments">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="exposed" string="Uncertified periods"
                        domain="[('uncertified_period_count', '&gt;', 0)]"/>
                <filter name="no_account" string="Without an Entandem account"
                        domain="[('entandem_account', '=', False)]"/>
                <filter name="source_unknown" string="Unknown music source"
                        domain="[('music_source', '=', 'unknown')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_source" string="Origin" context="{'group_by': 'music_source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_music_establishment" model="ir.actions.act_window">
        <field name="name">Establishments</field>
        <field name="res_model">bf.music.establishment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No establishment</p>
            <p>An establishment is a place where music is played. Its area and its uses form the basis of the royalties.</p>
        </field>
    </record>

</odoo>
