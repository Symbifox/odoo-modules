<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_budget_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">budget_dashboard</field>
    </record>

    <!-- Analysis pivot/graph actions -->
    <record id="view_budget_analysis_pivot" model="ir.ui.view">
        <field name="name">personal.budget.analysis.pivot</field>
        <field name="model">personal.budget.analysis</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="category_id" type="row"/>
                <field name="year" type="col"/>
                <field name="self_total" type="measure"/>
                <field name="gross_total" type="measure"/>
                <field name="transaction_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_budget_analysis_graph" model="ir.ui.view">
        <field name="name">personal.budget.analysis.graph</field>
        <field name="model">personal.budget.analysis</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="category_id"/>
                <field name="self_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_budget_analysis_search" model="ir.ui.view">
        <field name="name">personal.budget.analysis.search</field>
        <field name="model">personal.budget.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="category_id"/>
                <field name="book_id"/>
                <filter name="revenue" string="Income" domain="[('category_type', '=', 'revenue')]"/>
                <filter name="expense" string="Expenses" domain="[('category_type', '=', 'expense')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_book" string="Budget" context="{'group_by': 'book_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'category_type'}"/>
                    <filter name="group_year" string="Year" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_budget_analysis" model="ir.actions.act_window">
        <field name="name">Analysis</field>
        <field name="res_model">personal.budget.analysis</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_budget_analysis_search"/>
    </record>
</odoo>
