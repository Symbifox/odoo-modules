#. module: bf_job_search
#. odoo-python
#: code:addons/bf_job_search/models/job_application.py:0
msgid ""
"<ul><li>Ask for the offer in writing, and the date they need an answer "
"by.</li><li>Negotiate before accepting: many employers would pay more if "
"asked.</li><li>Read the conditions: trial period, start date, "
"checks.</li><li>Do not resign from a current job before the agreement is "
"signed.</li></ul>"
msgstr ""

#. module: bf_job_search
#. odoo-python
#: code:addons/bf_job_search/models/job_interview.py:0
msgid ""
"<ul><li>Re-read the advert and what you sent.</li><li>Research the "
"organisation and, if you can, the interviewers.</li><li>Prepare STAR stories"
" for the main requirements.</li><li>Prepare two or three questions to ask "
"them.</li><li>Warn your referees.</li><li>Check the place or link, and the "
"time zone.</li></ul>"
msgstr ""

