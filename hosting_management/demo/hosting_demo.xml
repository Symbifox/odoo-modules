        <record id="software_collabora" model="hosting.software">
            <field name="name">Collabora Online</field>
            <field name="code">CO</field>
            <field name="software_type">self_hosted</field>
            <field name="latest_version">24.04.9</field>
            <field name="latest_version_date">2024-12-01</field>
            <field name="github_url">https://github.com/CollaboraOnline/online</field>
            <field name="docker_image">collabora/code:latest</field>
            <field name="notes">&lt;p&gt;LibreOffice Online for collaborative document editing.&lt;/p&gt;</field>
        </record>

