"                        <span><i class=\"o_pastille\" style=\"background:#1F7CB4\"/> In progress</span>\n"
"                        <span><i class=\"o_pastille\" style=\"background:#C0392B\"/> Overdue</span>\n"
"                        <span><i class=\"o_pastille\" style=\"background:#7A868F\"/> Upcoming</span>\n"
"                        <span><i class=\"o_pastille\" style=\"background:#9A9A9A\"/> Cancelled</span>\n"
"                        <span>◆ Milestone</span>\n"
"                        <span>Dotted line at the edge of a bar: approximate start.</span>"
msgstr ""
"<span><i class=\"o_pastille\" style=\"background:#4C9A4C\"/> Terminé</span>\n"
"                        <span><i class=\"o_pastille\" style=\"background:#1F7CB4\"/> En cours</span>\n"
"                        <span><i class=\"o_pastille\" style=\"background:#C0392B\"/> En retard</span>\n"
