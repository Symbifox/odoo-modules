<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Types d'identifiants prédéfinis -->

        <record id="credential_type_email" model="project.credential.type">
            <field name="code">EMAIL</field>
            <field name="name">Email account</field>
            <field name="sequence">10</field>
            <field name="icon">fa-envelope</field>
            <field name="color">1</field>
            <field name="description">Email account credentials (IMAP, SMTP, webmail)</field>
            <field name="show_url">True</field>
            <field name="show_domain">False</field>
            <field name="show_api_key">False</field>
            <field name="show_key_file">False</field>
        </record>

        <record id="credential_type_ad" model="project.credential.type">
            <field name="code">AD</field>
            <field name="name">Active Directory / Entra ID</field>
            <field name="sequence">20</field>
            <field name="icon">fa-windows</field>
            <field name="color">2</field>
            <field name="description">Windows Active Directory or Microsoft Entra ID credentials</field>
            <field name="show_url">True</field>
            <field name="show_domain">True</field>
            <field name="show_api_key">False</field>
            <field name="show_key_file">False</field>
        </record>

        <record id="credential_type_app" model="project.credential.type">
            <field name="code">APP</field>
            <field name="name">Application login</field>
            <field name="sequence">30</field>
            <field name="icon">fa-desktop</field>
            <field name="color">3</field>
            <field name="description">Login credentials for a web or desktop application</field>
            <field name="show_url">True</field>
            <field name="show_domain">False</field>
            <field name="show_api_key">False</field>
            <field name="show_key_file">False</field>
        </record>

        <record id="credential_type_db" model="project.credential.type">
            <field name="code">DB</field>
            <field name="name">Database</field>
            <field name="sequence">40</field>
            <field name="icon">fa-database</field>
            <field name="color">4</field>
            <field name="description">Database login credentials (PostgreSQL, MySQL, etc.)</field>
            <field name="show_url">True</field>
            <field name="show_domain">False</field>
            <field name="show_api_key">False</field>
            <field name="show_key_file">False</field>
        </record>

        <record id="credential_type_server" model="project.credential.type">
            <field name="code">SERVER</field>
            <field name="name">Server / SSH</field>
            <field name="sequence">50</field>
            <field name="icon">fa-server</field>
            <field name="color">5</field>
            <field name="description">Server access credentials, including SSH keys</field>
            <field name="show_url">True</field>
            <field name="show_domain">False</field>
            <field name="show_api_key">False</field>
            <field name="show_key_file">True</field>
        </record>

        <record id="credential_type_api" model="project.credential.type">
            <field name="code">API</field>
            <field name="name">API / Integration</field>
            <field name="sequence">60</field>
            <field name="icon">fa-plug</field>
            <field name="color">6</field>
            <field name="description">API keys and integration credentials</field>
            <field name="show_url">True</field>
            <field name="show_domain">False</field>
            <field name="show_api_key">True</field>
            <field name="show_key_file">False</field>
        </record>

        <record id="credential_type_vpn" model="project.credential.type">
            <field name="code">VPN</field>
            <field name="name">VPN / Remote access</field>
            <field name="sequence">70</field>
            <field name="icon">fa-shield</field>
            <field name="color">7</field>
            <field name="description">VPN and remote access credentials</field>
            <field name="show_url">True</field>
            <field name="show_domain">True</field>
            <field name="show_api_key">False</field>
            <field name="show_key_file">True</field>
        </record>

        <record id="credential_type_cloud" model="project.credential.type">
            <field name="code">CLOUD</field>
            <field name="name">Cloud platform</field>
            <field name="sequence">80</field>
            <field name="icon">fa-cloud</field>
            <field name="color">8</field>
            <field name="description">Cloud platform credentials (AWS, Azure, GCP, etc.)</field>
            <field name="show_url">True</field>
            <field name="show_domain">False</field>
            <field name="show_api_key">True</field>
            <field name="show_key_file">True</field>
        </record>

        <record id="credential_type_other" model="project.credential.type">
            <field name="code">OTHER</field>
            <field name="name">Other / ad hoc</field>
            <field name="sequence">100</field>
            <field name="icon">fa-key</field>
            <field name="color">9</field>
            <field name="description">Other credentials not covered by the specific types</field>
            <field name="show_url">True</field>
            <field name="show_domain">True</field>
            <field name="show_api_key">True</field>
            <field name="show_key_file">True</field>
        </record>

    </data>
</odoo>
