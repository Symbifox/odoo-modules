<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- L'assistant de choix liste des dossiers avec le compte Nextcloud de la
         personne qui l'ouvre : il n'est lisible et modifiable que par elle. Un
         transitoire n'est pas reserve a son createur dans Odoo 18 (revue adverse
         du lot 18.0.4.2.0). -->
    <record id="rule_bf_nc_folder_pick_own" model="ir.rule">
        <field name="name">Choix de dossier Nextcloud : les siens seulement</field>
        <field name="model_id" ref="model_bf_nc_folder_pick"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_bf_nc_folder_pick_line_own" model="ir.rule">
        <field name="name">Dossiers proposés : les siens seulement</field>
        <field name="model_id" ref="model_bf_nc_folder_pick_line"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_bf_nc_client_folder_create_own" model="ir.rule">
        <field name="name">Création de dossier client : les siennes seulement</field>
        <field name="model_id" ref="model_bf_nc_client_folder_create"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

</odoo>
