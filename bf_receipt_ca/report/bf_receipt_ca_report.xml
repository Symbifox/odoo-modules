<odoo>
    <record id="paperformat_receipt_ca" model="report.paperformat">
        <field name="name">Reçu de don (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Point the existing OCA receipt report at the Canadian paperformat and
         give it a French file name. The template body is overridden in
         bf_receipt_ca_templates.xml. -->
    <record id="donation_base.report_donation_tax_receipt" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_receipt_ca" />
        <field
            name="print_report_name"
        >'Recu_officiel-'+(object.number or '').replace('/','')</field>
    </record>
</odoo>
