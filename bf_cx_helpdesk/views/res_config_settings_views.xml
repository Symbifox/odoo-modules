<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.cx.helpdesk</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_cx.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='bf_cx_loop_block']" position="inside">
                <setting string="Automatic ticket for detractors"
                         help="In addition to the activity, create a helpdesk ticket (Complaints team) for each detractor or dissatisfied rating.">
                    <field name="bf_cx_auto_ticket"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
