    <menuitem id="menu_cx_feedback"
              name="Feedback"
              parent="menu_cx_root"
              action="action_cx_feedback"
              sequence="10"/>

    <menuitem id="menu_cx_program"
              name="Programs"
              parent="menu_cx_root"
              action="action_cx_program"
              sequence="20"/>

    <menuitem id="menu_cx_wave"
              name="Sending waves"
              parent="menu_cx_root"
              action="action_cx_wave"
              sequence="30"/>

    <menuitem id="menu_cx_complaint"
              name="Complaints"
              parent="menu_cx_root"
              action="action_cx_complaint"
              sequence="40"/>

    <menuitem id="menu_cx_testimonial"
              name="Testimonials"
              parent="menu_cx_root"
              action="action_cx_testimonial"
              sequence="50"/>

    <menuitem id="menu_cx_report"
              name="Analysis"
              parent="menu_cx_root"
              action="action_cx_report"
              sequence="60"/>

    <!-- Configuration (manager only). -->
    <menuitem id="menu_cx_config"
              name="Configuration"
              parent="menu_cx_root"
              groups="bf_cx.group_bf_cx_manager"
              sequence="90"/>

    <menuitem id="menu_cx_settings"
              name="Settings"
              parent="menu_cx_config"
              action="action_cx_settings"
              sequence="10"/>

</odoo>
