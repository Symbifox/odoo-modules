<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- US Letter, tight top margin so the letterhead banner reaches the edge.
         A little bottom room is kept for the absolute-positioned footer. -->
    <record id="paperformat_letter" model="report.paperformat">
        <field name="name">Lettre (US Letter)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

</odoo>
