<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_category_list" model="ir.ui.view">
        <field name="name">bf.training.category.list</field>
        <field name="model">bf.training.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color_hex" widget="bf_color" string="Colour" optional="show"/>
                <field name="activity_count" string="Activities"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_training_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">bf.training.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Name the subjects</p>
            <p>A category is mostly there for quotas: "six hours a year, three
               of them on this subject, and first aid does not count" cannot be
               said without them.</p>
        </field>
    </record>
</odoo>
