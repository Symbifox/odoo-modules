#. module: hosting_management
#: model:mail.template,body_html:hosting_management.email_template_backup_report
msgid ""
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" "
"border=\"0\" width=\"100%\" style=\"background-color:#2E3132;\">\n"
"  <tbody>\n"
"    <tr>\n"
"      <td align=\"center\" style=\"padding:24px;\">\n"
"        <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%"
"\" align=\"center\" role=\"presentation\">\n"
"          <tbody>\n"
"            <tr>\n"
"              <td>\n"
"                <br/><br/>\n"
"                <table role=\"presentation\" cellpadding=\"0\" "
"cellspacing=\"0\" border=\"0\" width=\"700\" style=\"margin:0 "
"auto;background-color:#ffffff;border-radius:12px;border:1px solid "
"#e5e7eb;max-width:700px;\">\n"
"                  <tbody>\n"
"                    <!-- Header -->\n"
"                    <tr>\n"
"                      <td style=\"background-color:#22303B;padding:16px "
"24px;border-radius:12px 12px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" "
"cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td align=\"left\" style=\"color:#FFFFFF;font-"
"family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-"
"weight:600;\">\n"
"                                <a href=\"https://"
"bluefoxconsultant.com\" style=\"text-decoration:none;\">\n"
"                                  <img src=\"https://"
"bluefoxconsultant.com/web/image/website/1/logo/Blue%20Fox?"
"unique=803cc14\" alt=\"Blue Fox\" "
"style=\"height:48px;width:auto;display:block;\" height=\"48\"/>\n"
"                                </a>\n"
"                              </td>\n"
"                              <td align=\"right\" style=\"color:#E6EDF3;font-"
"family:'Lexend','Segoe UI',Arial,sans-serif;font-size:22px;font-"
"weight:800;\">\n"
"                                Rapport de sauvegarde\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"                      </td>\n"
"                    </tr>\n"
"\n"
"                    <!-- Accent bar -->\n"
"                    <tr>\n"
"                      <td style=\"height:4px;line-height:4px;background-"
"color:#29ABE2;\">&amp;nbsp;</td>\n"
"                    </tr>\n"
"\n"
"                    <!-- Content -->\n"
"                    <tr>\n"
"                      <td style=\"padding:24px;\">\n"
"                        <h1 style=\"margin:0 0 8px 0;font-"
"family:'Lexend','Segoe UI',Arial,sans-serif;font-size:24px;line-"
"height:32px;color:#22303B;font-weight:500;\">\n"
"                          Rapport quotidien des sauvegardes\n"
"                        </h1>\n"
"                        <p style=\"margin:0 0 16px 0;font-"
"family:'Lexend','Segoe UI',Arial,sans-serif;font-size:17px;line-"
"height:26px;color:#374151;font-weight:300;\">\n"
"                          Exécuté le <t t-out=\"object.run_date.strftime('%Y-"
"%m-%d %H:%M:%S')\"/> sur <t t-out=\"object.hostname or 'serveur inconnu'\"/"
">\n"
"                        </p>\n"
"\n"
"                        <!-- Status summary -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" "
"cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-"
"radius:10px;margin-bottom:20px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td t-attf-style=\"padding:16px;border-"
"radius:10px;border:1px solid {{ '#FECACA' if object.state == 'failed' else "
"'#FDE68A' if object.state == 'partial' else '#A7F3D0' }};background-color:"
"{{ '#FEE2E2' if object.state == 'failed' else '#FEF3C7' if object.state == "
"'partial' else '#D1FAE5' }};\">\n"
"                                <table role=\"presentation\" width=\"100%\" "
"cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                  <tbody>\n"
"                                    <tr>\n"
"                                      <td t-attf-style=\"font-"
"family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;font-"
"weight:600;color:{{ '#DC2626' if object.state == 'failed' else '#D97706' if "
"object.state == 'partial' else '#059669' }};\">\n"
"                                        <t t-if=\"object.state == "
"'failed'\">ERREURS DÉTECTÉES</t>\n"
"                                        <t t-elif=\"object.state == "
"'partial'\">COMPLÉTÉ AVEC AVERTISSEMENTS</t>\n"
"                                        <t t-else=\"\">TOUS LES BACKUPS "
"RÉUSSIS</t>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                      <td style=\"padding-top:8px;font-"
"family:'Lexend','Segoe UI',Arial,sans-serif;font-"
"size:14px;color:#374151;\">\n"
"                                        <strong style=\"color:#059669;\"><t "
"t-out=\"object.success_count\"/></strong> réussis |\n"
"                                        <strong style=\"color:#DC2626;\"><t "
"t-out=\"object.failed_count\"/></strong> échoués |\n"
"                                        <strong style=\"color:#D97706;\"><t "
"t-out=\"object.skipped_count\"/></strong> ignorés |\n"
"                                        <strong><t t-"
"out=\"object.total_count\"/></strong> total\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
