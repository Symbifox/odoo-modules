<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="bf_onb_step_permissions" model="onboarding.onboarding.step">
        <field name="title">Assign the Persona access rights</field>
        <field name="description">[action:base.action_res_users] Give the "Persona user" group to the advisers and "Persona manager" to those in charge.</field>
        <field name="button_text">Manage the users</field>
        <field name="done_text">Access granted</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">1</field>
    </record>

    <record id="bf_onb_step_ntfy" model="onboarding.onboarding.step">
        <field name="title">Configure the ntfy key</field>
        <field name="description">Enter the ntfy webhook key in Settings to receive the persona degradation alerts.</field>
        <field name="button_text">Open Settings</field>
        <field name="done_text">Key configured</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">2</field>
    </record>

    <record id="bf_onb_step_defaults" model="onboarding.onboarding.step">
        <field name="title">Turn on the automations</field>
        <field name="description">Check that the crons (seed, refresh, degradation) are active and in step with your team's cadence.</field>
        <field name="button_text">Open Settings</field>
        <field name="done_text">Automations on</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">3</field>
    </record>

    <record id="bf_onb_step_seed" model="onboarding.onboarding.step">
        <field name="title">Create a first persona</field>
        <field name="description">[action:bf_persona.action_contact_persona] Create a persona from a key contact to get the module going.</field>
        <field name="button_text">Create a persona</field>
        <field name="done_text">First persona created</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">4</field>
    </record>

    <record id="bf_onb_step_dashboard" model="onboarding.onboarding.step">
        <field name="title">Review the dashboard</field>
        <field name="description">[action:bf_persona.action_contact_persona_dashboard] Check that the KPIs are visible and make sense.</field>
        <field name="button_text">Open the dashboard</field>
        <field name="done_text">Dashboard reviewed</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">5</field>
    </record>

    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Contact personas</field>
        <field name="route_name">bf_persona_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_persona</field>
        <field name="step_ids" eval="[
            Command.link(ref('bf_persona.bf_onb_step_permissions')),
            Command.link(ref('bf_persona.bf_onb_step_ntfy')),
            Command.link(ref('bf_persona.bf_onb_step_defaults')),
            Command.link(ref('bf_persona.bf_onb_step_seed')),
            Command.link(ref('bf_persona.bf_onb_step_dashboard')),
        ]"/>
    </record>

</odoo>
