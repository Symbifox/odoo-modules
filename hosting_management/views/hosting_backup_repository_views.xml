<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="hosting_backup_repository_view_tree" model="ir.ui.view">
        <field name="name">hosting.backup.repository.view.tree</field>
        <field name="model">hosting.backup.repository</field>
        <field name="arch" type="xml">
            <list decoration-warning="is_stale" decoration-muted="not active">
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="snapshot_count"/>
                <field name="latest_snapshot_date"/>
                <field name="is_stale" widget="boolean" string="Périmé"/>
                <field name="size_human" string="Taille"/>
                <field name="bucket_size_share" string="% bucket" widget="float" digits="[5,2]"/>
                <field name="last_watchdog_sync" optional="hide"/>
                <field name="active" optional="hide" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="hosting_backup_repository_view_form" model="ir.ui.view">
        <field name="name">hosting.backup.repository.view.form</field>
        <field name="model">hosting.backup.repository</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_auto_link_services"
                            string="Auto-lier les services correspondants"
                            type="object"
                            class="oe_highlight"/>
                    <field name="is_stale" widget="boolean_toggle" readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Périmé" bg_color="bg-warning" invisible="not is_stale"/>
                    <widget name="web_ribbon" title="Archivé" bg_color="bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Dépôt"/>
                        <h1><field name="name" placeholder="Internal Backups/Database"/></h1>
                        <field name="category" widget="badge" readonly="1"/>
                    </div>
                    <group>
                        <group string="Stockage S3">
                            <field name="s3_url"/>
                            <field name="password_file_path"/>
                            <field name="active"/>
                        </group>
                        <group string="État (sync watchdog)">
                            <field name="snapshot_count"/>
                            <field name="latest_snapshot_date"/>
                            <field name="size_human"/>
                            <field name="size_bytes" invisible="1"/>
                            <field name="bucket_size_share" widget="percentage"/>
                            <field name="last_watchdog_sync"/>
                        </group>
                    </group>
                    <group string="Rétention Restic">
                        <group>
                            <field name="retention_daily"/>
                            <field name="retention_weekly"/>
                            <field name="retention_monthly"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Snapshots" name="snapshots">
                            <field name="snapshot_ids" readonly="1">
                                <list>
                                    <field name="snapshot_date"/>
                                    <field name="snapshot_id"/>
                                    <field name="container"/>
                                    <field name="files_new"/>
                                    <field name="data_added_human" string="Ajouté"/>
                                    <field name="duration_sec" string="Durée (s)"/>
                                    <field name="run_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Services liés" name="services">
                            <field name="service_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes additionnelles..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="hosting_backup_repository_view_search" model="ir.ui.view">
        <field name="name">hosting.backup.repository.view.search</field>
        <field name="model">hosting.backup.repository</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Périmé (>27h)" name="filter_stale" domain="[('is_stale', '=', True)]"/>
                <filter string="Archivé" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Interne" name="filter_internal" domain="[('category', '=', 'internal')]"/>
                <filter string="Tenant" name="filter_tenant" domain="[('category', '=', 'tenant')]"/>
                <filter string="Clients" name="filter_clients" domain="[('category', '=', 'clients')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Catégorie" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hosting_backup_repository_action" model="ir.actions.act_window">
        <field name="name">Dépôts Restic</field>
        <field name="res_model">hosting.backup.repository</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun dépôt Restic configuré
            </p>
            <p>
                Les dépôts Restic sont créés automatiquement à l'installation
                depuis <code>~/.config/restic/repos.json</code>.
            </p>
        </field>
    </record>

</odoo>
