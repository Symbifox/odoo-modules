#. module: bf_training_session
#: model:ir.model.fields,help:bf_training_session.field_event_event__training_requires_signature
msgid ""
"Attendance must be signed by the person. Until it is, the completion is "
"written but marked incomplete."
msgstr ""
"La présence doit être signée par la personne. Tant qu'elle ne l'est pas, la "
"réalisation est écrite mais marquée incomplète."

#. module: bf_training_session
#: model:ir.actions.report,name:bf_training_session.action_report_attendance_sheet
