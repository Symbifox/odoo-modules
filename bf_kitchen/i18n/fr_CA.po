#. module: bf_kitchen
#: model:ir.model.fields,help:bf_kitchen.field_bf_kitchen_attach_line__pack_qty
msgid "12000 for a case of 12 x 1 L when the stock unit is the ml."
msgstr "12000 pour une caisse de 12 x 1 L quand l'unité de stock est le ml."

