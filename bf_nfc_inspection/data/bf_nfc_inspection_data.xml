<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequence_releve" model="ir.sequence">
        <field name="name">Readings per tag</field>
        <field name="code">bf.nfc.reading</field>
        <field name="prefix">REL-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="gesture_reading" model="bf.nfc.gesture">
        <field name="name">Take a reading</field>
        <field name="code">reading</field>
        <field name="kind">reading</field>
        <field name="sequence">44</field>
        <field name="writes" eval="True"/>
        <field name="needs_target" eval="False"/>
        <field name="accepte_differe" eval="True"/>
        <field name="description">Bringing the phone close shows the tag's checklist: compliant or not, a measured value, a choice. Saving writes the reading to the register, and each issue goes to the person in charge. Without a network, the reading keeps the phone's time.</field>
    </record>

    <record id="cron_guetter_releves" model="ir.cron">
        <field name="name">Tags: watch for missed readings</field>
        <field name="model_id" ref="bf_nfc.model_bf_nfc_tag"/>
        <field name="state">code</field>
        <field name="code">model._cron_guetter_releves()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
