<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_school_report_card_view_form" model="ir.ui.view">
        <field name="name">bf.school.report.card.form</field>
        <field name="model">bf.school.report.card</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh from the gradebook"
                            invisible="state != 'draft'" groups="bf_school_core.group_school_manager"/>
                    <button name="action_issue" type="object" string="Issue" class="btn-primary"
                            invisible="state != 'draft'" groups="bf_school_core.group_school_manager"
                            confirm="Issuing seals the report card: its content can no longer change."/>
                    <button name="action_publish" type="object" string="Show to the families" class="btn-primary"
                            invisible="state != 'issued' or published_on" groups="bf_school_core.group_school_manager"/>
                    <button name="action_render_pdf" type="object" string="Render the PDF"
                            invisible="state == 'draft'" groups="bf_school_core.group_school_manager"/>
                    <button name="action_download" type="object" string="PDF" icon="fa-download"
                            invisible="state == 'draft' or not pdf_name"/>
                    <button name="action_verify" type="object" string="Check the seal"
                            invisible="state == 'draft'" groups="bf_school_core.group_school_manager"/>
                    <button name="action_open_correct" type="object" string="Correct"
                            invisible="state != 'issued'" groups="bf_school_core.group_school_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not is_overdue">
                        This report card is past its deadline.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="recipient != 'student'">
                        The student is of age: the report card goes to them, not to the parents.
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="group_id"/>
                            <field name="level_id"/>
                            <field name="term_id"/>
                            <field name="lang"/>
                        </group>
                        <group>
                            <field name="deadline"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="recipient"/>
                            <field name="version"/>
                            <field name="correction_reason" invisible="not correction_reason"/>
                            <field name="issued_on"/>
                            <field name="issued_by_id"/>
                            <field name="issued_late" invisible="not issued_late"/>
                            <field name="published_on"/>
                            <field name="snapshot_sha256" groups="bf_school_core.group_school_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subjects" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="subject_name" readonly="1"/>
                                    <field name="has_percent" column_invisible="1"/>
                                    <field name="percent" readonly="1" invisible="not has_percent" width="120px"/>
                                    <field name="group_average" readonly="1" invisible="not has_percent" width="120px"/>
                                    <field name="has_final" column_invisible="1"/>
                                    <field name="exam_percent" readonly="1" optional="hide" width="120px"/>
                                    <field name="final_percent" readonly="1" invisible="not has_final" optional="show" width="120px"/>
                                    <field name="outcome" readonly="1" optional="show"/>
                                    <field name="units_earned" readonly="1" optional="hide"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comment and decision" name="comment">
                            <group>
                                <field name="comment"/>
                                <field name="decision" invisible="kind != 'final'"/>
                                <field name="decision_note" invisible="kind != 'final'"/>
                                <field name="kind" invisible="1"/>
                            </group>
                        </page>
                        <page string="Read receipts" name="reads" invisible="state == 'draft'"
                              groups="bf_school_core.group_school_manager">
                            <field name="read_ids">
                                <list create="0" delete="0" edit="0">
                                    <field name="guardian_id"/>
                                    <field name="read_on"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_school_report_card_view_list" model="ir.ui.view">
        <field name="name">bf.school.report.card.list</field>
        <field name="model">bf.school.report.card</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="is_overdue" decoration-muted="state == 'superseded'">
                <field name="student_id"/>
                <field name="group_id"/>
                <field name="term_id"/>
                <field name="version"/>
                <field name="deadline"/>
                <field name="state" widget="badge" decoration-success="state == 'issued'"/>
                <field name="published_on" optional="show"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="bf_school_report_card_view_search" model="ir.ui.view">
        <field name="name">bf.school.report.card.search</field>
        <field name="model">bf.school.report.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="group_id"/>
                <field name="term_id"/>
                <filter name="draft" string="Drafts" domain="[('state', '=', 'draft')]"/>
                <filter name="issued" string="Issued" domain="[('state', '=', 'issued')]"/>
                <filter name="unpublished" string="Not shown yet"
                        domain="[('state', '=', 'issued'), ('published_on', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="by_group" string="Group" context="{'group_by': 'group_id'}"/>
                    <filter name="by_term" string="Term" context="{'group_by': 'term_id'}"/>
                    <filter name="by_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_report_card_action" model="ir.actions.act_window">
        <field name="name">Report cards</field>
        <field name="res_model">bf.school.report.card</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

    <!-- The lines of the report cards, for the teacher of one subject: their own, to comment -->
    <record id="bf_school_report_card_line_view_list" model="ir.ui.view">
        <field name="name">bf.school.report.card.line.list</field>
        <field name="model">bf.school.report.card.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0" decoration-muted="state != 'draft'">
                <field name="student_id" readonly="1"/>
                <field name="term_id" readonly="1"/>
                <field name="subject_name" readonly="1"/>
                <field name="has_percent" column_invisible="1"/>
                <field name="state" column_invisible="1"/>
                <field name="percent" readonly="1" invisible="not has_percent" width="120px"/>
                <field name="group_average" readonly="1" invisible="not has_percent" width="120px"/>
                <field name="comment" readonly="state != 'draft'"/>
            </list>
        </field>
    </record>

    <record id="bf_school_report_card_line_view_search" model="ir.ui.view">
        <field name="name">bf.school.report.card.line.search</field>
        <field name="model">bf.school.report.card.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="subject_name"/>
                <filter name="mine" string="My subjects" domain="[('course_id.teacher_ids', 'in', [uid])]"/>
                <filter name="draft" string="Drafts" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group by">
                    <filter name="by_subject" string="Subject" context="{'group_by': 'subject_name'}"/>
                    <filter name="by_term" string="Term" context="{'group_by': 'term_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_report_card_line_action" model="ir.actions.act_window">
        <field name="name">Comments on the subjects</field>
        <field name="res_model">bf.school.report.card.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_mine': 1, 'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No subject to comment</p>
            <p>The subjects you teach appear here, with their results, once the office has generated the drafts of the report cards.</p>
        </field>
    </record>

    <!-- Wizards -->
    <record id="bf_school_report_card_generate_view_form" model="ir.ui.view">
        <field name="name">bf.school.report.card.generate.form</field>
        <field name="model">bf.school.report.card.generate</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="group_id"/>
                    <field name="year_id" invisible="1"/>
                    <field name="term_id"/>
                    <field name="lang"/>
                </group>
                <p class="text-muted">
                    A draft report card is made for each student of the group, from the gradebook. Drafts that
                    already exist are refreshed and keep their comments; issued ones are left alone.
                </p>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bf_school_report_card_generate_action" model="ir.actions.act_window">
        <field name="name">Generate the report cards of a group</field>
        <field name="res_model">bf.school.report.card.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="bf_school_report_card_correct_view_form" model="ir.ui.view">
        <field name="name">bf.school.report.card.correct.form</field>
        <field name="model">bf.school.report.card.correct</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="card_id" invisible="1"/>
                    <field name="reason"/>
                </group>
                <p class="text-muted">A new version is made as a draft. The families keep seeing the issued one until the new one replaces it.</p>
                <footer>
                    <button name="action_correct" type="object" string="Make a corrected version" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bf_school_report_card_correct_action" model="ir.actions.act_window">
        <field name="name">Correct a report card</field>
        <field name="res_model">bf.school.report.card.correct</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Communications -->
    <record id="bf_school_communication_view_form" model="ir.ui.view">
        <field name="name">bf.school.communication.form</field>
        <field name="model">bf.school.communication</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_email" type="object" string="Send by email" class="btn-primary"
                            invisible="state == 'sent'"/>
                    <button name="action_mark_sent" type="object" string="Mark as sent (paper or in person)"
                            invisible="state == 'sent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not is_overdue">This communication is overdue.</div>
                    <group>
                        <group>
                            <field name="student_id" readonly="state == 'sent'"/>
                            <field name="year_id" readonly="state == 'sent'"/>
                            <field name="kind" readonly="state == 'sent'"/>
                            <field name="reason" invisible="kind != 'monthly'" readonly="state == 'sent'"/>
                        </group>
                        <group>
                            <field name="due_date" readonly="state == 'sent'"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="sent_on"/>
                            <field name="sent_by_id"/>
                            <field name="channel"/>
                            <field name="recipient_ids" widget="many2many_tags" invisible="not recipient_ids"/>
                        </group>
                    </group>
                    <group>
                        <field name="subject" readonly="state == 'sent'"/>
                        <field name="body" readonly="state == 'sent'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_school_communication_view_list" model="ir.ui.view">
        <field name="name">bf.school.communication.list</field>
        <field name="model">bf.school.communication</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue">
                <field name="student_id"/>
                <field name="kind"/>
                <field name="reason" optional="show"/>
                <field name="due_date"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="bf_school_communication_view_search" model="ir.ui.view">
        <field name="name">bf.school.communication.search</field>
        <field name="model">bf.school.communication</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <filter name="to_send" string="To send" domain="[('state', '=', 'to_send')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <group expand="0" string="Group by">
                    <filter name="by_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_communication_action" model="ir.actions.act_window">
        <field name="name">Written communications</field>
        <field name="res_model">bf.school.communication</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_send': 1}</field>
    </record>

    <!-- The year form gets its two preparation buttons -->
    <record id="bf_school_year_view_form_communications" model="ir.ui.view">
        <field name="name">bf.school.year.form.communications</field>
        <field name="model">bf.school.year</field>
        <field name="inherit_id" ref="bf_school_gradebook.bf_school_year_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_prepare_first_communications" type="object"
                        string="Prepare the first communications" groups="bf_school_core.group_school_manager"/>
                <button name="action_prepare_monthly_information" type="object"
                        string="Prepare this month's information" groups="bf_school_core.group_school_manager"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_school_report_cards_root" name="Report cards" parent="bf_school_core.menu_school_root" sequence="19"/>
    <menuitem id="menu_school_report_cards" name="Report cards" parent="menu_school_report_cards_root"
              action="bf_school_report_card_action" sequence="10"/>
    <menuitem id="menu_school_report_card_lines" name="Comments on the subjects" parent="menu_school_report_cards_root"
              action="bf_school_report_card_line_action" sequence="15"/>
    <menuitem id="menu_school_report_cards_generate" name="Generate" parent="menu_school_report_cards_root"
              action="bf_school_report_card_generate_action" sequence="20" groups="bf_school_core.group_school_manager"/>
    <menuitem id="menu_school_communications" name="Written communications" parent="menu_school_report_cards_root"
              action="bf_school_communication_action" sequence="30"/>
</odoo>
