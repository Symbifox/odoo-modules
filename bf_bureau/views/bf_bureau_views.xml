<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_bureau_desk_view_tree" model="ir.ui.view">
        <field name="name">bf.bureau.desk.tree</field>
        <field name="model">bf.bureau.desk</field>
        <field name="arch" type="xml">
            <list string="Mes bureaux">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="layout"/>
                <field name="active_when"/>
                <field name="shortcut_key"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <button name="action_open" type="object"
                        string="Ouvrir" icon="fa-external-link"/>
                <button name="action_set_default" type="object"
                        string="Définir par défaut" icon="fa-star-o"
                        invisible="is_default"/>
                <button name="action_duplicate_for_me" type="object"
                        string="Dupliquer" icon="fa-copy"/>
            </list>
        </field>
    </record>

    <record id="bf_bureau_desk_view_form" model="ir.ui.view">
        <field name="name">bf.bureau.desk.form</field>
        <field name="model">bf.bureau.desk</field>
        <field name="arch" type="xml">
            <form string="Bureau">
                <header>
                    <button name="action_open" type="object"
                            string="Ouvrir le bureau" class="oe_highlight"
                            icon="fa-external-link"/>
                    <button name="action_set_default" type="object"
                            string="Définir par défaut" icon="fa-star-o"
                            invisible="is_default"/>
                    <button name="action_duplicate_for_me" type="object"
                            string="Dupliquer" icon="fa-copy"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Par défaut"
                            invisible="not is_default"/>
                    <widget name="web_ribbon" title="Archivé"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Mon bureau"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="layout"/>
                            <field name="active_when"/>
                            <field name="shortcut_key"
                                   placeholder="alt+1"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="user_id" readonly="1" force_save="1"
                                   groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                            <field name="is_default" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Panneaux" name="panes">
                            <field name="pane_ids">
                                <list editable="bottom">
                                    <field name="slot"/>
                                    <field name="action_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="view_type"/>
                                    <field name="weight"/>
                                    <field name="name_override"
                                           placeholder="(Titre par défaut de l'action)"
                                           optional="show"/>
                                    <field name="domain_override"
                                           placeholder="[('priority','=','1')]"
                                           optional="hide"/>
                                    <field name="context_override"
                                           placeholder="{'search_default_my_filter': 1}"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_bureau_desk_action" model="ir.actions.act_window">
        <field name="name">Mes bureaux</field>
        <field name="res_model">bf.bureau.desk</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier bureau
            </p>
            <p>
                Un bureau est une mise en page de plusieurs actions Odoo
                affichées simultanément. Choisissez la mise en page,
                ajoutez des panneaux pointant vers vos actions favorites,
                puis ouvrez le bureau via le menu « Mon bureau ».
            </p>
        </field>
    </record>

    <record id="bf_bureau_open_default_desk_action" model="ir.actions.client">
        <field name="name">Mon bureau</field>
        <field name="tag">bf_bureau_desk</field>
    </record>

</odoo>
