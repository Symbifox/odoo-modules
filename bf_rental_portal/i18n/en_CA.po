#. module: bf_rental_portal
#: model_terms:ir.ui.view,arch_db:bf_rental_portal.portal_rental_notices
msgid ""
"<strong>Sans réponse de votre part, l'avis sera réputé\n"
"                        accepté</strong> et votre bail sera reconduit avec ce qui\n"
"                        y est demandé ("
msgstr ""
"<strong>If you do not reply, you are deemed to have agreed</strong> to the\n"
"                        renewal of the lease on the conditions proposed by the lessor ("

#. module: bf_rental_portal
#: model_terms:ir.ui.view,arch_db:bf_rental_portal.portal_rental_leases
