<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_editorial_entry_form" model="ir.ui.view">
        <field name="name">bf.editorial.entry.form</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <form string="Editorial entry">
                <header>
                    <button name="action_run_qa" type="object" string="Run the QA"
                            class="btn-secondary"
                            help="Deterministic checks. No artificial intelligence is involved."/>
                    <button name="action_sync_from_post" type="object"
                            string="Re-read language slots" class="btn-secondary"
                            invisible="not post_id"/>
                    <button name="action_apply_checklist_templates" type="object"
                            string="Reapply the templates" class="btn-secondary"
                            help="Useful after a change of pillar or kind."/>
                    <button name="action_fix_mechanical" type="object"
                            string="Fix mechanical defects"
                            class="btn-secondary" invisible="not post_id"
                            confirm="This action writes to the post. It only fixes empty headings and table headers without a scope, in all languages, then runs the QA again. Continue?"
                            help="Empty headings and table scopes, in all languages. Nothing that calls for judgment."/>
                    <button name="action_open_waiver" type="object"
                            string="Sign a waiver" class="btn-secondary"
                            invisible="preflight_ok or published_date or qa_waived"
                            groups="bf_editorial.group_editorial_manager"
                            help="Accept in writing the judgment-based reasons that hold back publication."/>
                    <button name="action_revoke_waiver" type="object"
                            string="Revoke the waiver" class="btn-secondary"
                            invisible="not qa_waived"
                            groups="bf_editorial.group_editorial_manager"/>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="published_date or not preflight_ok"
                            groups="bf_editorial.group_editorial_manager"/>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-secondary" invisible="published_date or preflight_ok"
                            groups="bf_editorial.group_editorial_manager"
                            help="The preflight guard will refuse and explain why."/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success"
                            invisible="not published_date"/>
                    <widget name="web_ribbon" title="Entry blocked" bg_color="text-bg-danger"
                            invisible="not is_blocked"/>
                    <div class="oe_title">
                        <label for="name" string="Working title"/>
                        <h1><field name="name" placeholder="The title may change, this one stays"/></h1>
                    </div>
                    <group>
                        <group string="Framing">
                            <field name="calendar_id"/>
                            <field name="kind"/>
                            <field name="pillar_id"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="post_id" invisible="kind != 'blog'"/>
                        </group>
                        <group string="Execution">
                            <field name="user_id"/>
                            <field name="reviewer_id"/>
                            <field name="planned_date"/>
                            <field name="scheduled_publish_date"
                                   help="The preflight guard also applies on this date."/>
                            <field name="published_date" invisible="not published_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert" invisible="preflight_ok">
                        <strong>Publishing is held back.</strong>
                        <field name="preflight_summary" nolabel="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="not preflight_ok or published_date">
                        <field name="preflight_summary" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not qa_waived or qa_waiver_stale">
                        <strong>This entry is under a waiver.</strong> The QA still sees what it sees; it is the refusal to publish that gave way, on the signed reasons and on those only.
                        <group class="mt-2">
                            <field name="qa_waived_by" readonly="1"/>
                            <field name="qa_waived_on" readonly="1"/>
                            <field name="qa_waiver_reason" readonly="1"/>
                            <field name="qa_waiver_problems" readonly="1"/>
                        </group>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not qa_waiver_stale">
                        <strong>The waiver no longer covers anything.</strong> The text has changed since it was signed. Sign it again on the current findings, or revoke it.
                    </div>
                    <field name="preflight_ok" invisible="1"/>
                    <field name="is_blocked" invisible="1"/>
                    <field name="qa_waived" invisible="1"/>
                    <field name="qa_waiver_stale" invisible="1"/>

                    <notebook>

                        <page string="Languages" name="langues">
                            <field name="language_summary" nolabel="1" readonly="1"/>
                            <field name="version_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="lang_id"/>
                                    <field name="is_source"/>
                                    <field name="state"/>
                                    <field name="word_count" readonly="1"/>
                                    <field name="translator_id"/>
                                    <field name="translated_date"/>
                                    <field name="qa_state" readonly="1"/>
                                    <field name="slug" readonly="1" optional="hide"/>
                                </list>
                            </field>
                            <group>
                                <!-- Cochables : cocher écrit l'état sur chaque
                                     créneau exigé ci-dessus. « Livrées » est un
                                     geste de publication, donc le groupe qui publie. -->
                                <field name="langs_ready"/>
                                <field name="langs_complete"
                                       groups="bf_editorial.group_editorial_manager"/>
                                <field name="langs_complete" readonly="1"
                                       groups="!bf_editorial.group_editorial_manager"/>
                                <field name="word_count" readonly="1"/>
                                <field name="word_floor" readonly="1"/>
                            </group>
                        </page>

                        <page string="Manual to-dos" name="controle">
                            <field name="checklist_ids" nolabel="1">
                                <list editable="bottom" decoration-muted="done">
                                    <field name="sequence" widget="handle"/>
                                    <field name="done" widget="boolean_toggle"/>
                                    <field name="name"/>
                                    <field name="is_blocking"/>
                                    <field name="note"/>
                                    <field name="done_by" readonly="1" optional="show"/>
                                    <field name="done_date" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="QA" name="qa">
                            <group>
                                <field name="qa_state" readonly="1"/>
                                <field name="qa_last_run" readonly="1"/>
                                <field name="qa_run_by" readonly="1"/>
                                <field name="qa_waived" readonly="1"/>
                                <field name="qa_waiver_stale" readonly="1"
                                       invisible="not qa_waived"/>
                            </group>
                            <field name="qa_findings" nolabel="1" readonly="1"
                                   placeholder="No findings. Run the QA to fill this area."/>
                        </page>

                        <page string="Accuracy" name="veracite">
                            <group>
                                <group>
                                    <field name="fact_check_date"/>
                                    <field name="fact_checked_by"/>
                                </group>
                                <group string="Topic freshness">
                                    <field name="subject_module_id"/>
                                    <field name="source_version"
                                           invisible="not subject_module_id"/>
                                    <field name="current_version" readonly="1"
                                           invisible="not subject_module_id"/>
                                    <field name="version_drift" readonly="1"
                                           invisible="not subject_module_id"/>
                                </group>
                            </group>
                            <separator string="Claims"/>
                            <field name="claim_ids" nolabel="1">
                                <list editable="bottom" decoration-warning="verdict == 'todo'"
                                      decoration-danger="verdict == 'false'">
                                    <field name="name"/>
                                    <field name="source_id"/>
                                    <field name="verdict"/>
                                    <field name="is_machine_proposed" readonly="1"/>
                                    <field name="correction" optional="hide"/>
                                    <field name="verdict_by" optional="hide"/>
                                    <button name="action_confirm" type="object"
                                            icon="fa-check" title="Confirm the proposed verdict"
                                            invisible="not is_machine_proposed"/>
                                </list>
                            </field>
                            <separator string="Sources"/>
                            <field name="source_ids" nolabel="1">
                                <list editable="bottom" decoration-danger="is_dead">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="url" widget="url"/>
                                    <field name="lang_id"/>
                                    <field name="http_status"/>
                                    <field name="checked_date"/>
                                    <field name="is_dead" readonly="1"/>
                                    <field name="archive_url" optional="hide" widget="url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Angle" name="angle">
                            <group>
                                <field name="hook" placeholder="The hook sentence"/>
                                <field name="thesis" placeholder="What the article argues, in one sentence"/>
                                <field name="reader_problem"/>
                                <field name="promise"/>
                                <field name="cta"/>
                            </group>
                            <group string="SEO">
                                <field name="target_keyword"/>
                                <field name="search_intent"/>
                                <field name="pattern"/>
                                <field name="competitor" invisible="pattern not in ('alternative', 'comparison')"/>
                                <field name="campaign_id"/>
                            </group>
                        </page>

                        <page string="Dependencies" name="dependances">
                            <group>
                                <field name="blocked_reason"
                                       placeholder="Blocking reason entered by hand"/>
                                <field name="blocking_summary" readonly="1"
                                       invisible="not is_blocked"/>
                            </group>
                            <separator string="Must be published after"/>
                            <field name="depends_on_ids" nolabel="1" widget="many2many_tags"/>
                            <separator string="Holds back"/>
                            <field name="blocks_ids" nolabel="1" widget="many2many_tags" readonly="1"/>
                            <group string="Raw measure">
                                <field name="raw_visits" readonly="1"/>
                                <field name="task_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_editorial_entry_kanban" model="ir.ui.view">
        <field name="name">bf.editorial.entry.kanban</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="false">
                <field name="stage_id"/>
                <field name="color"/>
                <field name="preflight_ok"/>
                <field name="is_blocked"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="pillar_id"/>
                            </div>
                            <div class="mt-1">
                                <span class="badge text-bg-danger" t-if="record.is_blocked.raw_value">Entry blocked</span>
                                <span class="badge text-bg-success" t-if="record.preflight_ok.raw_value">Preflight green</span>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="planned_date" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_editorial_entry_list" model="ir.ui.view">
        <field name="name">bf.editorial.entry.list</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_blocked" decoration-success="preflight_ok and not published_date"
                  decoration-muted="published_date">
                <header>
                    <button name="action_run_qa" type="object"
                            string="Run the QA" class="btn-secondary"
                            help="Deterministic checks on the selection. No artificial intelligence is involved."/>
                </header>
                <field name="name"/>
                <field name="calendar_id" optional="show"/>
                <field name="pillar_id" optional="show"/>
                <field name="stage_id"/>
                <field name="planned_date"/>
                <field name="published_date" optional="hide"/>
                <field name="word_count" optional="show" sum="Words"/>
                <field name="langs_complete" optional="show"/>
                <field name="qa_state" optional="show"/>
                <field name="preflight_ok"/>
                <field name="is_blocked" optional="hide"/>
                <field name="version_drift" optional="hide"/>
                <field name="raw_visits" optional="hide" sum="Visits (raw)"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_editorial_entry_calendar" model="ir.ui.view">
        <field name="name">bf.editorial.entry.calendar</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <calendar date_start="timeline_date" color="pillar_id" mode="month"
                      quick_create="false">
                <field name="color_resolved" invisible="1"/>
                <field name="name"/>
                <field name="pillar_id"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_editorial_entry_search" model="ir.ui.view">
        <field name="name">bf.editorial.entry.search</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="target_keyword"/>
                <field name="pillar_id"/>
                <field name="tag_ids"/>
                <field name="calendar_id"/>
                <filter name="mine" string="Mine"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="open" string="In progress"
                        domain="[('published_date', '=', False)]"/>
                <separator/>
                <filter name="ready" string="Preflight green"
                        domain="[('preflight_ok', '=', True), ('published_date', '=', False)]"/>
                <filter name="blocked" string="Blocked entries"
                        domain="[('is_blocked', '=', True)]"/>
                <filter name="drift" string="Version drift"
                        domain="[('version_drift', '=', True)]"/>
                <filter name="langs_missing" string="Missing language"
                        domain="[('langs_complete', '=', False)]"/>
                <filter name="langs_not_ready" string="Language not reviewed yet"
                        domain="[('langs_ready', '=', False)]"/>
                <filter name="waived" string="Under waiver"
                        domain="[('qa_waived', '=', True)]"/>
                <separator/>
                <filter name="planned" string="Planned date" date="planned_date"/>
                <filter name="published" string="Published entries" date="published_date"/>
                <group expand="0" string="Group by">
                    <filter name="g_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="g_pillar" string="Pillar" context="{'group_by': 'pillar_id'}"/>
                    <filter name="g_calendar" string="Calendar" context="{'group_by': 'calendar_id'}"/>
                    <filter name="g_user" string="Assignee" context="{'group_by': 'user_id'}"/>
                    <filter name="g_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_editorial_entry" model="ir.actions.act_window">
        <field name="name">Editorial entries</field>
        <field name="res_model">bf.editorial.entry</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a first entry</p>
            <p>An entry carries an article, or a publication that does not go through the blog. It holds the angle, the sources, the languages and what is left to do.</p>
        </field>
    </record>

</odoo>
