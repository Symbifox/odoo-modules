#. module: bf_school_admission
#: model:mail.template,body_html:bf_school_admission.mail_template_admission_update
msgid ""
"<div>\n"
"    <t t-set=\"event\" t-value=\"ctx.get('school_event')\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p t-if=\"event == 'fee'\" style=\"margin:0 0 12px 0;\">The school has checked the application. The fee is now to pay, online from the application page or at the school office; the application is studied once it is paid.</p>\n"
"    <p t-if=\"event == 'received'\" style=\"margin:0 0 12px 0;\">We have received the application and its fee. We will write to you at the next step.</p>\n"
"    <p t-if=\"event == 'convened'\" style=\"margin:0 0 12px 0;\">You are convened to the admission exam: <strong t-out=\"format_datetime(object.campaign_id.exam_datetime, tz=object.company_id.partner_id.tz or 'America/Toronto') or ''\"/><t t-if=\"object.campaign_id.exam_location\">, <t t-out=\"object.campaign_id.exam_location\"/></t>.</p>\n"
"    <p t-if=\"event == 'accepted'\" style=\"margin:0 0 12px 0;\">Good news: the application is accepted. The school will contact you to complete the registration.</p>\n"
"    <p t-if=\"event == 'waitlisted'\" style=\"margin:0 0 12px 0;\">The application is on the waiting list. We will write to you if a place opens.</p>\n"
"    <p t-if=\"event == 'refused'\" style=\"margin:0 0 12px 0;\">We are sorry: the school cannot offer a place this year.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}{{ object._status_url() }}\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            See the application\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"event\" t-value=\"ctx.get('school_event')\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p t-if=\"event == 'fee'\" style=\"margin:0 0 12px 0;\">L'école a vérifié la demande. Les droits sont maintenant à payer, en ligne depuis la page de la demande ou au secrétariat; la demande est étudiée une fois les droits payés.</p>\n"
"    <p t-if=\"event == 'received'\" style=\"margin:0 0 12px 0;\">Nous avons reçu la demande et ses frais. Nous vous écrirons à la prochaine étape.</p>\n"
"    <p t-if=\"event == 'convened'\" style=\"margin:0 0 12px 0;\">Votre convocation à l'examen d'admission : <strong t-out=\"format_datetime(object.campaign_id.exam_datetime, tz=object.company_id.partner_id.tz or 'America/Toronto') or ''\"/><t t-if=\"object.campaign_id.exam_location\">, <t t-out=\"object.campaign_id.exam_location\"/></t>.</p>\n"
"    <p t-if=\"event == 'accepted'\" style=\"margin:0 0 12px 0;\">Bonne nouvelle : la demande est acceptée. L'école communiquera avec vous pour compléter l'inscription.</p>\n"
"    <p t-if=\"event == 'waitlisted'\" style=\"margin:0 0 12px 0;\">La demande est sur la liste d'attente. Nous vous écrirons si une place se libère.</p>\n"
"    <p t-if=\"event == 'refused'\" style=\"margin:0 0 12px 0;\">Nous sommes désolés : l'école ne peut pas offrir de place cette année.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}{{ object._status_url() }}\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Voir la demande\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

