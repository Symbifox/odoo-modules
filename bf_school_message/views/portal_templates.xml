<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_school_news" name="School: announcements tile"
              inherit_id="portal.portal_my_home" priority="31">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/bf_school_core/static/description/icon.png'"/>
                <t t-set="title">School announcements</t>
                <t t-set="text">What the school tells you, and what it asks you to confirm</t>
                <t t-set="url" t-value="'/my/school/news'"/>
                <t t-set="placeholder_count" t-value="'school_news_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_school_news" name="School: announcements breadcrumbs"
              inherit_id="portal.portal_breadcrumbs" priority="31">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'school_news'" class="breadcrumb-item active">School announcements</li>
            <li t-if="page_name == 'school_news_detail'" class="breadcrumb-item">
                <a href="/my/school/news">School announcements</a>
            </li>
            <li t-if="page_name == 'school_news_detail'" class="breadcrumb-item active" t-out="post.name"/>
        </xpath>
    </template>

    <template id="portal_my_school_news_link" name="School: link to announcements"
              inherit_id="bf_school_portal.portal_my_school">
        <xpath expr="//div[hasclass('o_school_links')]" position="inside">
            <a href="/my/school/news" class="btn btn-secondary">
                <i class="fa fa-bullhorn me-1"/>School announcements</a>
        </xpath>
    </template>

    <template id="portal_school_news" name="School: announcements">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">School announcements</t>
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">School announcements</t>
            </t>
            <div t-if="not posts" class="alert alert-info mt-3">No announcement for now.</div>
            <div class="list-group mt-3">
                <a t-foreach="posts" t-as="post" t-att-href="'/my/school/news/%s' % post.id"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="fw-semibold">
                            <i t-if="post.epingle" class="fa fa-thumb-tack me-1 text-muted" title="Pinned"/>
                            <t t-out="post.name"/>
                        </div>
                        <small class="text-muted">
                            <t t-out="post.school_id.name"/> ·
                            <span t-field="post.date_jour"/>
                        </small>
                    </div>
                    <t t-if="post.lecture_requise">
                        <span t-if="read_on.get(post.id)" class="badge text-bg-success">Confirmed</span>
                        <span t-else="" class="badge text-bg-warning">To confirm</span>
                    </t>
                </a>
            </div>
        </t>
    </template>

    <template id="portal_school_news_detail" name="School: announcement">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="post.name"/>
            <div class="o_portal_school_news mt-3" style="max-width: 760px;">
                <small class="text-muted">
                    <t t-out="post.school_id.name"/>
                    <t t-if="children"> · <t t-out="first_names(children)"/></t>
                </small>
                <h2 class="mt-1" t-out="post.name"/>
                <p class="text-muted small">
                    <span t-field="post.date_jour"/>
                    · <t t-out="post.auteur_user_id.name"/>
                </p>
                <img t-if="post.image_couverture" t-att-src="'/my/school/news/%s/image' % post.id"
                     class="img-fluid rounded mb-3" alt=""/>
                <div class="mb-4" t-out="post.corps_html"/>
                <t t-if="post.lecture_requise">
                    <div t-if="read_on" class="alert alert-success">
                        You confirmed reading this announcement on
                        <span t-out="read_on" t-options="{'widget': 'datetime', 'tz_name': (post.company_id.partner_id.tz or 'America/Toronto')}"/>.
                    </div>
                    <form t-else="" method="post" t-att-action="'/my/school/news/%s/read' % post.id">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <p class="text-muted small">The school asks you to confirm that you have read it.</p>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-check me-1"/>I have read it
                        </button>
                    </form>
                </t>
            </div>
        </t>
    </template>
</odoo>
