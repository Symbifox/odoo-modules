<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_detect_relationship_degradation" model="ir.cron">
        <field name="name">Persona : mesurer les relations</field>
        <field name="model_id" ref="model_contact_persona"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_relationship()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="cron_suggest_cc_rules" model="ir.cron">
        <field name="name">Persona : suggérer des règles de copie</field>
        <field name="model_id" ref="model_contact_persona"/>
        <field name="state">code</field>
        <field name="code">model.cron_suggest_cc_rules()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
