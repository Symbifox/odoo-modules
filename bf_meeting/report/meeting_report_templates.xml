<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Enveloppe : chaque document se rend dans SA langue d'envoi.
         Le libellé statique d'un gabarit se traduit dans la langue du t-call
         (`t-lang`), pas dans celle d'une variable : avant, les données
         suivaient `_bf_langue_envoi()` et les intitulés la langue de qui
         imprimait. Le corps garde l'identifiant `report_meeting_record`, que
         d'autres modules étendent (bf_meeting_timer). -->
    <template id="report_meeting_record_main">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="bf_meeting.report_meeting_record" t-lang="doc._bf_langue_envoi()"/>
            </t>
        </t>
    </template>

    <template id="report_meeting_record">
                <t t-set="lang" t-value="doc._bf_langue_envoi()"/>
                <t t-set="doc" t-value="doc.with_context(lang=lang)"/>
                <t t-set="data" t-value="doc._get_report_data()"/>
                <t t-set="brand_company" t-value="doc.company_id or env.company"/>
                <t t-set="brand_primary" t-value="(brand_company and brand_company.report_brand_primary) or '#714B67'"/>
                <t t-set="brand_dark" t-value="(brand_company and brand_company.report_brand_dark) or '#212529'"/>
                <!-- Sur la bannière sombre, la primaire telle quelle peut être
                     illisible : Deep Teal sur Deep Navy tombait à 1,47:1. -->
                <t t-set="brand_accent_on_dark" t-value="doc.report_accent_on_dark()"/>
                <div class="article" style="padding: 0 !important; margin: 0 !important;">
                    <link rel="stylesheet" href="/bf_lexend/static/src/scss/lexend_report.css"/>
                    <style>
                        .container, .o_body_html, body, #wrapwrap, main, .article {
                            max-width: 100% !important;
                            width: 100% !important;
                            padding-left: 0 !important;
                            padding-right: 0 !important;
                            margin-left: 0 !important;
                            margin-right: 0 !important;
                        }

                        .mr-page {
                            font-family: "Lexend", system-ui, -apple-system, sans-serif;
                            font-size: 9pt;
                            line-height: 1.4;
                            color: <t t-esc="brand_dark"/>;
                        }

                        .mr-banner {
                            background: <t t-esc="brand_dark"/>;
                            padding: 18pt 24pt 16pt 24pt;
                            display: table;
                            width: 100%;
                        }
                        .mr-banner .banner-logo {
                            display: table-cell;
                            vertical-align: middle;
                            width: 90px;
                            padding-right: 18pt;
                        }
                        .mr-banner .banner-logo img {
                            max-height: 50px;
                            max-width: 80px;
                        }
                        .mr-banner .banner-content {
                            display: table-cell;
                            vertical-align: middle;
                        }
                        .mr-banner .doc-type {
                            font-size: 8pt;
                            font-weight: 600;
                            text-transform: uppercase;
                            letter-spacing: 2pt;
                            color: <t t-esc="brand_accent_on_dark"/>;
                            margin: 0 0 3pt 0;
                        }
                        .mr-banner h1 {
                            font-size: 16pt;
                            font-weight: 600;
                            color: #ffffff;
                            margin: 0 0 2pt 0;
                            line-height: 1.25;
                        }
                        .mr-banner .doc-subtitle {
                            font-size: 10pt;
                            color: rgba(255,255,255,0.7);
                            margin: 0;
                        }
                        .mr-accent-bar {
                            height: 3px;
                            background: <t t-esc="brand_primary"/>;
                            margin: 0;
                            width: 100%;
                        }

                        .mr-meta {
                            display: table;
                            width: 100%;
                            background: #f8f9fb;
                            padding: 10pt 24pt;
                            border-bottom: 1px solid #eaedf0;
                        }
                        .mr-meta-item {
                            display: table-cell;
                            vertical-align: middle;
                        }
                        .mr-meta-item.right {
                            text-align: right;
                        }
                        .mr-meta-label {
                            font-size: 8pt;
                            color: #888;
                            text-transform: uppercase;
                            letter-spacing: 0.5pt;
                        }
                        .mr-meta-value {
                            font-size: 11pt;
                            font-weight: 600;
                            color: <t t-esc="brand_dark"/>;
                        }

                        .mr-kpi-grid {
                            display: table;
                            width: 100%;
                            padding: 12pt 24pt 8pt 24pt;
                            table-layout: fixed;
                        }
                        .mr-kpi-card {
                            display: table-cell;
                            text-align: center;
                            padding: 10pt 8pt;
                            border: 1px solid #eaedf0;
                            border-radius: 4px;
                            background: #fff;
                        }
                        .mr-kpi-card + .mr-kpi-card {
                            border-left: none;
                        }
                        .mr-kpi-number {
                            font-size: 18pt;
                            font-weight: 700;
                            line-height: 1.2;
                            color: <t t-esc="brand_dark"/>;
                        }
                        .mr-kpi-label {
                            font-size: 7.5pt;
                            color: #888;
                            text-transform: uppercase;
                            letter-spacing: 0.5pt;
                            margin-top: 2pt;
                        }

                        .mr-content {
                            padding: 12pt 24pt;
                        }
                        .mr-section-title {
                            font-size: 11pt;
                            font-weight: 600;
                            color: <t t-esc="brand_dark"/>;
                            margin: 16pt 0 8pt 0;
                            padding-bottom: 4pt;
                            border-bottom: 2px solid <t t-esc="brand_primary"/>;
                            display: inline-block;
                        }
                        .mr-section-title:first-child {
                            margin-top: 0;
                        }

                        .mr-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 8pt;
                            margin-bottom: 6pt;
                        }
                        .mr-table th {
                            background: <t t-esc="brand_dark"/>;
                            color: #fff;
                            padding: 5pt 6pt;
                            text-align: left;
                            font-weight: 600;
                            font-size: 7.5pt;
                        }
                        .mr-table td {
                            padding: 4pt 6pt;
                            border-bottom: 1px solid #eaedf0;
                            vertical-align: middle;
                        }
                        .mr-table tr:nth-child(even) td {
                            background: #f8f9fb;
                        }

                        .mr-footer {
                            padding: 8pt 24pt 0 24pt;
                            border-top: 1px solid #dde0e4;
                            display: table;
                            width: 100%;
                            font-size: 8pt;
                            color: #aaa;
                            margin-top: 16pt;
                        }
                        .mr-footer-left {
                            display: table-cell;
                            text-align: left;
                        }
                        .mr-footer-right {
                            display: table-cell;
                            text-align: right;
                        }
                    </style>

                    <div class="mr-page">

                        <!-- Banner -->
                        <div class="mr-banner">
                            <div class="banner-logo">
                                <img t-att-src="image_data_uri(doc.company_id.meeting_logo or doc.company_id.logo)" alt="Logo"/>
                            </div>
                            <div class="banner-content">
                                <div class="doc-type">Meeting minutes</div>
                                <h1><t t-out="doc.room_name or doc.name"/></h1>
                                <div class="doc-subtitle">
                                    <t t-if="doc.project_id">
                                        Project: <t t-out="doc.project_id.name"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="mr-accent-bar"/>

                        <!-- Metadata -->
                        <div class="mr-meta">
                            <div class="mr-meta-item">
                                <div class="mr-meta-label">Meeting date</div>
                                <div class="mr-meta-value">
                                    <t t-out="data['date_display']"/>
                                </div>
                            </div>
                            <div class="mr-meta-item right">
                                <div class="mr-meta-label">Duration</div>
                                <div class="mr-meta-value">
                                    <t t-if="doc.duration_minutes">
                                        <t t-out="doc.duration_minutes"/> min
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- KPI -->
                        <div class="mr-kpi-grid">
                            <div class="mr-kpi-card">
                                <div class="mr-kpi-number"><t t-if="doc.attendance_count"><t t-out="doc.attendance_count"/></t><t t-else=""><t t-out="data['participant_count']"/></t></div>
                                <div class="mr-kpi-label">Participants</div>
                            </div>
                            <div class="mr-kpi-card">
                                <div class="mr-kpi-number"><t t-out="data['decision_count']"/></div>
                                <div class="mr-kpi-label">Decisions</div>
                            </div>
                            <div class="mr-kpi-card">
                                <div class="mr-kpi-number"><t t-out="data['task_count']"/></div>
                                <div class="mr-kpi-label">Action items</div>
                            </div>
                        </div>

                        <div class="mr-content">

                            <!-- Participants -->
                            <t t-if="doc.attendance_ids or doc.participant_ids">
                                <div class="mr-section-title">Participants</div>
                                <p>
                                    <t t-if="doc.attendance_ids">
                                        <t t-foreach="doc.attendance_ids" t-as="a">
                                            <t t-set="absent" t-value="a.status != 'present'"/>
                                            <span t-attf-style="color: {{ '#999999' if absent else 'inherit' }};"><t t-out="a.partner_id.name"/><t t-if="a.status == 'excused'"> (excused)</t><t t-if="a.status == 'absent'"> (absent)</t></span><t t-if="not a_last">, </t>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <t t-foreach="doc.participant_ids" t-as="p">
                                            <t t-out="p.name"/><t t-if="not p_last">, </t>
                                        </t>
                                    </t>
                                </p>
                            </t>

                            <!-- Summary -->
                            <t t-if="doc.summary">
                                <div class="mr-section-title">Summary</div>
                                <p><t t-out="doc.summary"/></p>
                            </t>

                            <!-- Topics -->
                            <t t-if="data['topics']">
                                <t t-foreach="data['topics']" t-as="topic">
                                    <div class="mr-section-title"><t t-out="topic.get('title', '')"/></div>
                                    <t t-if="topic.get('points')">
                                        <ul>
                                            <t t-foreach="topic['points']" t-as="point">
                                                <li><t t-out="point"/></li>
                                            </t>
                                        </ul>
                                    </t>
                                </t>
                            </t>

                            <!-- Decisions -->
                            <t t-if="doc.decision_ids">
                                <div class="mr-section-title">Decisions</div>
                                <table class="mr-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 5%;">#</th>
                                            <th style="width: 55%;">Decision</th>
                                            <th style="width: 20%;">Decision maker</th>
                                            <th style="width: 20%;">Related item</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.decision_ids" t-as="dec">
                                            <tr>
                                                <td><t t-out="dec.sequence"/></td>
                                                <td><t t-out="dec.name"/></td>
                                                <td><t t-out="dec.decision_maker_id.name or ''"/></td>
                                                <td><t t-out="dec.knowledge_item_id.name or ''"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- Action items -->
                            <t t-if="doc.task_ids">
                                <div class="mr-section-title">Action items</div>
                                <table class="mr-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 55%;">Task</th>
                                            <th style="width: 25%;">Assignee</th>
                                            <th style="width: 20%;">Deadline</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.task_ids" t-as="task">
                                            <tr>
                                                <td><t t-out="task.name"/></td>
                                                <td>
                                                    <t t-foreach="task.user_ids" t-as="u">
                                                        <t t-out="u.name"/><t t-if="not u_last">, </t>
                                                    </t>
                                                </td>
                                                <td><t t-out="str(task.date_deadline) if task.date_deadline else ''"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- Existing tasks the meeting discussed -->
                            <t t-set="discussed_tasks" t-value="doc._discussed_tasks_for_report()"/>
                            <t t-if="discussed_tasks">
                                <div class="mr-section-title">Existing tasks discussed</div>
                                <table class="mr-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 55%;">Task</th>
                                            <th style="width: 25%;">Assignee</th>
                                            <th style="width: 20%;">Deadline</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="discussed_tasks" t-as="task">
                                            <tr>
                                                <td><t t-out="task.name"/></td>
                                                <td>
                                                    <t t-foreach="task.user_ids" t-as="u">
                                                        <t t-out="u.name"/><t t-if="not u_last">, </t>
                                                    </t>
                                                </td>
                                                <td><t t-out="str(task.date_deadline) if task.date_deadline else ''"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- Open questions -->
                            <t t-if="data['open_questions']">
                                <div class="mr-section-title">Open questions</div>
                                <ul>
                                    <t t-foreach="data['open_questions']" t-as="q">
                                        <li>
                                            <t t-if="isinstance(q, str)"><t t-out="q"/></t>
                                            <t t-else=""><t t-out="q.get('question', str(q))"/></t>
                                        </li>
                                    </t>
                                </ul>
                            </t>

                            <!-- Deliverables -->
                            <t t-if="data['deliverables']">
                                <div class="mr-section-title">Deliverables</div>
                                <ul>
                                    <t t-foreach="data['deliverables']" t-as="d">
                                        <li>
                                            <t t-if="isinstance(d, str)"><t t-out="d"/></t>
                                            <t t-else=""><t t-out="d.get('description', str(d))"/></t>
                                        </li>
                                    </t>
                                </ul>
                            </t>

                        </div>

                        <!-- Footer -->
                        <div class="mr-footer">
                            <div class="mr-footer-left">
                                <t t-out="doc.company_id.name"/>
                            </div>
                            <div class="mr-footer-right">
                                Meeting minutes &#8212; Confidential document
                            </div>
                        </div>

                    </div>
                </div>
    </template>

</odoo>
