    <record id="module_category_health" model="ir.module.category">
        <field name="name">Santé</field>
        <field name="description">Suivi de la santé personnelle</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_health_user" model="res.groups">
        <field name="name">Utilisateur santé</field>
        <field name="category_id" ref="module_category_health"/>
        <field name="comment">Accès complet au suivi de santé personnel</field>
    </record>

