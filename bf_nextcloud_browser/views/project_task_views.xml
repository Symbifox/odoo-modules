<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form2_nc_browser" model="ir.ui.view">
        <field name="name">project.task.form.nc.browser</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Fichiers Nextcloud" name="nc_browser"
                      groups="bf_nextcloud_browser.group_nc_browser_user">
                    <group>
                        <field name="nc_task_subfolder" placeholder="(optionnel) sous-dossier propre a la tache"/>
                    </group>
                    <widget name="nc_browser_panel"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
