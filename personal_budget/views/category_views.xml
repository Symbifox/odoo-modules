<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_category_list" model="ir.ui.view">
        <field name="name">personal.budget.category.list</field>
        <field name="model">personal.budget.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_type" widget="badge"
                       decoration-info="category_type == 'revenue'"
                       decoration-muted="category_type == 'expense'"/>
                <field name="is_recurring"/>
                <field name="book_id" optional="show"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_budget_category_form" model="ir.ui.view">
        <field name="name">personal.budget.category.form</field>
        <field name="model">personal.budget.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_type"/>
                            <field name="book_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_recurring"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_category_search" model="ir.ui.view">
        <field name="name">personal.budget.category.search</field>
        <field name="model">personal.budget.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="book_id"/>
                <filter name="revenue" string="Income" domain="[('category_type', '=', 'revenue')]"/>
                <filter name="expense" string="Expenses" domain="[('category_type', '=', 'expense')]"/>
                <separator/>
                <filter name="recurring" string="Recurring categories" domain="[('is_recurring', '=', True)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_type" string="Type" context="{'group_by': 'category_type'}"/>
                    <filter name="group_book" string="Budget" context="{'group_by': 'book_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_budget_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">personal.budget.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
