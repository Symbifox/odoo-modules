<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_charge_statement_list" model="ir.ui.view">
        <field name="name">bf.property.charge.statement.list</field>
        <field name="model">bf.property.charge.statement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-danger="state in ('late', 'issued_late')"
                  decoration-success="state == 'issued'">
                <field name="name"/>
                <field name="syndicat_id" optional="hide"/>
                <field name="unit_id"/>
                <field name="requester_partner_id"/>
                <field name="request_date"/>
                <field name="deadline_date"/>
                <field name="owner_notice_date" optional="show"/>
                <field name="issued_date" optional="show"/>
                <field name="amount_total" sum="Total dû"/>
                <field name="acquirer_bound" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_charge_statement_form" model="ir.ui.view">
        <field name="name">bf.property.charge.statement.form</field>
        <field name="model">bf.property.charge.statement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_lines" type="object"
                            string="Relever les charges dues" class="btn-primary"
                            invisible="issued_date or cancelled"/>
                    <button name="action_notify_owner" type="object"
                            string="Aviser le propriétaire"
                            invisible="issued_date or cancelled or owner_notice_date"/>
                    <button name="action_issue" type="object" string="Fournir l'état"
                            class="btn-primary"
                            invisible="issued_date or cancelled"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="cancelled"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,issued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="state not in ('late', 'issued_late')">
                        <field name="binding_rule" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state not in ('requested', 'issued')">
                        <field name="binding_rule" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="owner_notice_date or issued_date or cancelled">
                        Art. 1069 al. 2 C.c.Q. : le syndicat n'est autorisé à fournir
                        l'état que « sauf à en aviser au préalable le propriétaire de la
                        fraction ou ses ayants cause ». Le préavis conditionne
                        l'autorisation, et l'état porte les dettes d'une personne nommée.
                    </div>

                    <group>
                        <group string="Demande">
                            <field name="syndicat_id"/>
                            <field name="unit_id"/>
                            <field name="requester_partner_id"/>
                            <field name="owner_partner_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cancelled" invisible="1"/>
                        </group>
                        <group string="Délai de l'art. 1069 al. 2">
                            <field name="request_date"/>
                            <field name="deadline_date"/>
                            <field name="owner_notice_date"/>
                            <field name="issued_date"/>
                            <field name="acquirer_bound"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Charges dues" name="lines">
                            <field name="line_ids" readonly="issued_date != False">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="amount_capital" sum="Capital"/>
                                    <field name="amount_interest" sum="Intérêts"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_capital"/>
                                <field name="amount_interest"/>
                                <field name="adjustment_amount"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Ajustement au budget" name="adjustment">
                            <group>
                                <field name="budget_id"/>
                                <field name="adjustment_amount"/>
                            </group>
                            <field name="adjustment_note"
                                   placeholder="Art. 1069 al. 3 : comment l'état a été ajusté selon le dernier budget annuel."/>
                        </page>
                    </notebook>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_charge_statement_search" model="ir.ui.view">
        <field name="name">bf.property.charge.statement.search</field>
        <field name="model">bf.property.charge.statement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="requester_partner_id"/>
                <filter name="open" string="À fournir"
                        domain="[('state', 'in', ('requested', 'late'))]"/>
                <filter name="late" string="Délai dépassé"
                        domain="[('state', 'in', ('late', 'issued_late'))]"/>
                <filter name="lost" string="Créance perdue"
                        domain="[('state', '=', 'issued_late')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_syndicat" string="Syndicat"
                            context="{'group_by': 'syndicat_id'}"/>
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_charge_statement" model="ir.actions.act_window">
        <field name="name">États des charges dues</field>
        <field name="res_model">bf.property.charge.statement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrer une demande</p>
            <p>
                Art. 1069 al. 2 C.c.Q. Demandé par celui qui se propose d'acquérir, avec
                préavis obligatoire au propriétaire. Le délai de 15 jours joue contre le
                syndicat : passé ce jour, l'acquéreur n'est plus tenu des charges dues,
                et la créance devra être réclamée au vendeur.
            </p>
            <p>
                À ne pas confondre avec l'attestation de l'art. 1068.1, que demande le
                copropriétaire vendeur, ni avec les documents de l'art. 1068.2, que
                demande le promettant acheteur à ses frais.
            </p>
        </field>
    </record>

</odoo>
