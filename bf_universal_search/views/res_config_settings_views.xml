<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_bf_universal_search" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bf.universal.search</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="after">
                <block title="Universal search" name="bf_universal_search_setting_container">
                    <setting id="bf_universal_search_ctrl_k_setting"
                             string="Ctrl+K opens universal search"
                             help="The command palette opens with the * prefix already in place: you type what you are looking for straight away. Backspace on the empty field brings back the Odoo commands. Each user can choose otherwise in their preferences.">
                        <field name="bf_universal_search_ctrl_k_star"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
