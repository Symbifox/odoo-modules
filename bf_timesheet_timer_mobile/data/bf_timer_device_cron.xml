<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ⚠️ Un appariement abandonné laisse une fiche sans jeton, avec un code
         périmé. Inerte, mais elle encombre la table ; la purge ne touche jamais
         un appareil qui a reçu son jeton. -->
    <record id="cron_purger_appariements" model="ir.cron">
        <field name="name">Chronomètre : purger les appariements abandonnés</field>
        <field name="model_id" ref="model_bf_timer_device"/>
        <field name="state">code</field>
        <field name="code">model._purger_codes_perimes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
