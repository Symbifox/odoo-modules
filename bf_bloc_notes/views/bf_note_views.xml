<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_note_view_form" model="ir.ui.view">
        <field name="name">bf.note.form</field>
        <field name="model">bf.note</field>
        <field name="arch" type="xml">
            <form string="Quick note">
                <header>
                    <button name="action_create_activity_quick"
                            type="object"
                            string="🗓️ Today"
                            class="btn-primary"
                            context="{'offset': 0}"/>
                    <button name="action_create_activity_quick"
                            type="object"
                            string="Tomorrow"
                            context="{'offset': 1}"/>
                    <button name="action_create_activity_quick"
                            type="object"
                            string="+2 days"
                            context="{'offset': 2}"/>
                    <button name="action_create_activity_quick"
                            type="object"
                            string="+1 week"
                            context="{'offset': 7}"/>
                    <button name="action_open_activity_wizard"
                            type="object"
                            string="Customise…"/>
                    <button name="action_open_task_wizard"
                            type="object"
                            string="Convert to task"
                            class="btn-secondary"/>
                    <button name="action_open_reroute_wizard"
                            type="object"
                            string="Reroute…"
                            class="btn-secondary"/>
                    <button name="action_toggle_pinned"
                            type="object"
                            string="Pin"
                            invisible="pinned"/>
                    <button name="action_toggle_pinned"
                            type="object"
                            string="Unpin"
                            invisible="not pinned"/>
                    <button name="toggle_active"
                            type="object"
                            string="Archive"
                            class="btn-secondary"
                            invisible="not active"
                            confirm="Archive this note?"/>
                    <button name="toggle_active"
                            type="object"
                            string="Unarchive"
                            class="btn-secondary"
                            invisible="active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-external-link"
                                invisible="not res_id">
                            <field name="res_name" string="See the record"/>
                        </button>
                        <button name="action_open_activities"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks"
                                invisible="tracked_activity_count == 0">
                            <field name="tracked_activity_count" widget="statinfo" string="Activities"/>
                        </button>
                        <button name="action_open_tasks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check-square-o"
                                invisible="tracked_task_count == 0">
                            <field name="tracked_task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" title="Pinned"
                            bg_color="text-bg-warning"
                            invisible="not pinned or not active"/>
                    <widget name="web_ribbon" title="Shared"
                            bg_color="text-bg-info"
                            invisible="not is_shared or not active or pinned"/>
                    <field name="active" invisible="1"/>
                    <field name="color" widget="color_picker"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Title (automatic if empty)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="deadline_date"/>
                        </group>
                        <group>
                            <field name="is_shared"/>
                            <field name="pinned"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="body">
                            <field name="body"
                                   widget="html"
                                   options="{'collaborative': false}"
                                   placeholder="Write your note here…"/>
                        </page>
                        <page string="Links" name="links">
                            <field name="link_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="target_ref" string="Form"
                                           widget="bf_chatter_target"/>
                                    <field name="res_name" string="Name"/>
                                    <button name="action_open" type="object" icon="fa-external-link" string="Open"/>
                                </list>
                            </field>
                            <p class="text-muted small">
                                Tip: "Reroute…" in the header moves the note to another record
                                (or adds it to a second one). Everywhere here, a record is found by its name,
                                its number, a shortcut (<code>task:22299</code>) or a pasted Odoo URL.
                            </p>
                            <group>
                                <field name="res_ref" string="Add a primary link"
                                       widget="bf_chatter_target"
                                       placeholder="Name, number, task:22299, or Odoo URL…"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_note_view_list" model="ir.ui.view">
        <field name="name">bf.note.list</field>
        <field name="model">bf.note</field>
        <field name="arch" type="xml">
            <list string="Notes" decoration-warning="pinned"
                  decoration-danger="deadline_date and deadline_date &lt; current_date"
                  multi_edit="1">
                <field name="pinned" widget="boolean_toggle"/>
                <field name="is_shared" widget="boolean_toggle" optional="hide"/>
                <field name="name"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="res_name" string="Linked to"/>
                <field name="deadline_date" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="write_date" string="Modified"/>
            </list>
        </field>
    </record>

    <record id="bf_note_view_kanban" model="ir.ui.view">
        <field name="name">bf.note.kanban</field>
        <field name="model">bf.note</field>
        <field name="arch" type="xml">
            <kanban default_order="pinned desc, write_date desc"
                    class="o_kanban_dashboard o_bf_note_kanban"
                    sample="1">
                <field name="color"/>
                <field name="pinned"/>
                <field name="is_shared"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_bf_note_card #{kanban_color(record.color.raw_value)}">
                            <div class="o_dropdown_kanban dropdown">
                                <a role="button" class="dropdown-toggle btn px-1 py-0"
                                   data-bs-toggle="dropdown" data-bs-display="static"
                                   aria-label="Actions" title="Actions">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item"
                                       t-if="widget.editable">Edit</a>
                                    <a role="menuitem" type="object" name="toggle_active"
                                       class="dropdown-item">
                                        <t t-if="record.active.raw_value">Archive</t>
                                        <t t-else="">Unarchive</t>
                                    </a>
                                    <a role="menuitem" type="delete" class="dropdown-item"
                                       t-if="widget.deletable">Delete</a>
                                    <div role="separator" class="dropdown-divider"/>
                                    <ul class="oe_kanban_colorpicker" data-field="color"/>
                                </div>
                            </div>
                            <div class="o_bf_note_card_color_strip"/>
                            <div class="o_bf_note_card_header d-flex align-items-start">
                                <strong class="flex-grow-1">
                                    <field name="name"/>
                                </strong>
                                <button class="btn btn-link p-0 ms-1 o_bf_note_pin_btn"
                                        type="object"
                                        name="action_toggle_pinned"
                                        title="Pin / unpin"
                                        t-attf-style="opacity: #{record.pinned.raw_value ? 1 : 0.35};">
                                    <i class="fa fa-thumb-tack"/>
                                </button>
                                <i t-if="record.is_shared.raw_value"
                                   class="fa fa-users ms-1 text-info"
                                   title="Shared"/>
                            </div>
                            <div class="o_bf_note_card_body">
                                <field name="body" widget="html_text" class="text-muted"/>
                            </div>
                            <div class="o_bf_note_card_footer d-flex align-items-center mt-2">
                                <field name="tag_ids"
                                       widget="many2many_tags"
                                       options="{'color_field': 'color'}"
                                       class="flex-grow-1"/>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                            <div t-if="record.res_name.raw_value" class="text-muted small mt-1">
                                <i class="fa fa-link" title="Linked to"/> <field name="res_name"/>
                            </div>
                            <div t-if="record.deadline_date.raw_value"
                                 t-attf-class="small #{record.deadline_date.raw_value &lt; (new Date()).toISOString().slice(0,10) ? 'text-danger fw-bold' : 'text-muted'}">
                                <i class="fa fa-calendar" title="Due date"/> <field name="deadline_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="bf_note_view_calendar" model="ir.ui.view">
        <field name="name">bf.note.calendar</field>
        <field name="model">bf.note</field>
        <field name="arch" type="xml">
            <calendar string="Notes"
                      date_start="deadline_date"
                      color="color"
                      mode="month"
                      quick_create="0">
                <field name="name"/>
                <field name="tag_ids"/>
                <field name="user_id"/>
                <field name="res_name"/>
            </calendar>
        </field>
    </record>

    <record id="bf_note_view_search" model="ir.ui.view">
        <field name="name">bf.note.search</field>
        <field name="model">bf.note</field>
        <field name="arch" type="xml">
            <search string="Notes">
                <field name="name"/>
                <field name="body"/>
                <field name="tag_ids"/>
                <field name="res_name"/>
                <filter name="my_notes" string="My notes" domain="[('user_id', '=', uid)]"/>
                <filter name="pinned" string="Pinned" domain="[('pinned', '=', True)]"/>
                <filter name="shared" string="Shared" domain="[('is_shared', '=', True)]"/>
                <filter name="linked" string="Linked to a record" domain="[('link_ids', '!=', False)]"/>
                <separator/>
                <filter name="filter_today" string="Modified today"
                        domain="[('write_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_week" string="This week"
                        domain="[('write_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="deadline_overdue" string="Overdue"
                        domain="[('deadline_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="deadline_today" string="Due today"
                        domain="[('deadline_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_user" string="Author" context="{'group_by': 'user_id'}"/>
                    <filter name="group_tag" string="Tag" context="{'group_by': 'tag_ids'}"/>
                    <filter name="group_color" string="Colour" context="{'group_by': 'color'}"/>
                    <filter name="group_model" string="Linked model" context="{'group_by': 'res_model'}"/>
                    <filter name="group_deadline" string="Due date" context="{'group_by': 'deadline_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_note_action" model="ir.actions.act_window">
        <field name="name">Notepad</field>
        <field name="res_model">bf.note</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="search_view_id" ref="bf_note_view_search"/>
        <field name="context">{'search_default_my_notes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first quick note
            </p>
            <p>
                Shortcut: <b>Alt+N</b> for a new note, <b>Alt+Shift+N</b> for the list.
            </p>
        </field>
    </record>

    <record id="bf_note_action_pinned" model="ir.actions.act_window">
        <field name="name">Pinned notes</field>
        <field name="res_model">bf.note</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('pinned', '=', True), '|', ('user_id', '=', uid), ('is_shared', '=', True)]</field>
        <field name="context">{'search_default_pinned': 1}</field>
    </record>

</odoo>
