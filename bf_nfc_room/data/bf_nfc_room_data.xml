<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gesture_room" model="bf.nfc.gesture">
        <field name="name">Meeting room</field>
        <field name="code">room</field>
        <field name="kind">room</field>
        <field name="sequence">42</field>
        <field name="writes" eval="True"/>
        <field name="needs_target" eval="True"/>
        <field name="accepte_differe" eval="False"/>
        <field name="target_model_id" ref="bf_nfc_room.model_bf_nfc_room"/>
        <field name="description">On the door: tells whether the room is free or taken, offers to take it, confirm a booking or release it. Never acts without a button.</field>
    </record>

    <record id="cron_room_release" model="ir.cron">
        <field name="name">Tags: release unconfirmed rooms</field>
        <field name="model_id" ref="bf_nfc_room.model_bf_nfc_room"/>
        <field name="state">code</field>
        <field name="code">model._cron_liberer()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
