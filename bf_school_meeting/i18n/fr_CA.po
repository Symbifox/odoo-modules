#. module: bf_school_meeting
#: model:mail.template,body_html:bf_school_meeting.mail_template_meeting_booked
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Your meeting is booked:\n"
"        <strong t-out=\"format_datetime(object.start, tz=object.company_id.partner_id.tz or 'America/Toronto', dt_format='d MMMM, HH:mm') or ''\"/>,\n"
"        with <t t-out=\"object.teacher_id.name or ''\"/>, about <t t-out=\"object.student_id.name or ''\"/>.</p>\n"
"    <p t-if=\"object.session_id.location\" style=\"margin:0 0 12px 0;\">Place: <t t-out=\"object.session_id.location\"/></p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/meetings\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            My meetings\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Votre rencontre est réservée :\n"
"        <strong t-out=\"format_datetime(object.start, tz=object.company_id.partner_id.tz or 'America/Toronto', dt_format='d MMMM, HH:mm') or ''\"/>,\n"
"        avec <t t-out=\"object.teacher_id.name or ''\"/>, au sujet de <t t-out=\"object.student_id.name or ''\"/>.</p>\n"
"    <p t-if=\"object.session_id.location\" style=\"margin:0 0 12px 0;\">Lieu : <t t-out=\"object.session_id.location\"/></p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/meetings\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Mes rencontres\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

