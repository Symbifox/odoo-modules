<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_forecast_view_list" model="ir.ui.view">
        <field name="name">bf.budget.forecast.list</field>
        <field name="model">bf.budget.forecast</field>
        <field name="arch" type="xml">
            <list string="Prévisions" decoration-muted="state == 'superseded'">
                <field name="name"/>
                <field name="vintage"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="actuals_through"/>
                <field name="amount_actual" sum="Réel"/>
                <field name="amount_forecast" sum="Prévu"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'superseded'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="bf_budget_forecast_view_form" model="ir.ui.view">
        <field name="name">bf.budget.forecast.form</field>
        <field name="model">bf.budget.forecast</field>
        <field name="arch" type="xml">
            <form string="Prévision glissante">
                <header>
                    <button name="action_generate_lines" string="Une ligne par poste"
                            type="object" invisible="state != 'draft'"/>
                    <button name="action_seed" string="Amorcer les mois ouverts"
                            type="object" invisible="state != 'draft'"/>
                    <button name="action_publish" string="Publier la passe" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_roll_forward" string="Rouler d'un mois" type="object"
                            class="btn-primary" invisible="state == 'superseded'"/>
                    <button name="action_reset_draft" string="Remettre au brouillon"
                            type="object" invisible="state != 'published'"/>
                    <button name="action_open_comparison" string="Comparer à la précédente"
                            type="object" invisible="not previous_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state == 'draft'">
                        Cette passe est publiée : ses chiffres sont la trace de ce qu'on croyait
                        au <field name="actuals_through" readonly="1" nolabel="1" class="oe_inline"/>.
                        Pour prévoir autrement, roulez une nouvelle passe.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Exploitation glissante"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vintage"/>
                            <field name="previous_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="actuals_through"/>
                            <field name="month_count"/>
                            <field name="closed_month_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="position_id"/>
                                    <field name="amount_actual" sum="Réel des mois clos"/>
                                    <field name="amount_forecast" sum="Prévu des mois ouverts"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mois" name="periods">
                            <field name="line_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="position_id"/>
                                </list>
                            </field>
                            <separator string="Le détail mois par mois s'ouvre depuis la ligne"/>
                        </page>
                        <page string="Totaux" name="totals">
                            <group>
                                <field name="amount_actual"/>
                                <field name="amount_forecast"/>
                                <field name="amount_total"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_budget_forecast_line_view_list" model="ir.ui.view">
        <field name="name">bf.budget.forecast.line.list</field>
        <field name="model">bf.budget.forecast.line</field>
        <field name="arch" type="xml">
            <list string="Lignes de prévision" create="0">
                <field name="forecast_id"/>
                <field name="position_id"/>
                <field name="amount_actual" sum="Réel"/>
                <field name="amount_forecast" sum="Prévu"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_view_periods" type="object" string="Mois" icon="fa-calendar"/>
            </list>
        </field>
    </record>

    <record id="bf_budget_forecast_line_view_search" model="ir.ui.view">
        <field name="name">bf.budget.forecast.line.search</field>
        <field name="model">bf.budget.forecast.line</field>
        <field name="arch" type="xml">
            <search string="Lignes de prévision">
                <field name="forecast_id"/>
                <field name="position_id"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_forecast" string="Passe" context="{'group_by': 'forecast_id'}"/>
                    <filter name="group_position" string="Poste" context="{'group_by': 'position_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_budget_forecast_period_view_list" model="ir.ui.view">
        <field name="name">bf.budget.forecast.period.list</field>
        <field name="model">bf.budget.forecast.period</field>
        <field name="arch" type="xml">
            <list string="Mois" editable="bottom" create="0" decoration-muted="is_closed">
                <field name="name" readonly="1"/>
                <field name="position_id" readonly="1" optional="hide"/>
                <field name="is_closed" readonly="1"/>
                <field name="amount_forecast" readonly="is_closed" sum="Prévu"/>
                <field name="amount_actual" readonly="1" sum="Réel"/>
                <field name="variance" readonly="1" sum="Écart"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="bf_budget_forecast_period_view_pivot" model="ir.ui.view">
        <field name="name">bf.budget.forecast.period.pivot</field>
        <field name="model">bf.budget.forecast.period</field>
        <field name="arch" type="xml">
            <pivot string="Prévision par mois">
                <field name="position_id" type="row"/>
                <field name="name" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="bf_budget_forecast_action" model="ir.actions.act_window">
        <field name="name">Prévisions glissantes</field>
        <field name="res_model">bf.budget.forecast</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ouvrez votre première passe</p>
            <p>
                Une prévision se refait chaque mois : le réel gagne un mois, l'horizon
                avance d'autant, et la passe précédente reste lisible telle qu'on l'avait
                faite. C'est la comparaison entre les passes qui apprend quelque chose,
                pas le chiffre d'une passe isolée.
            </p>
        </field>
    </record>

    <record id="bf_budget_forecast_period_action" model="ir.actions.act_window">
        <field name="name">Prévision par mois</field>
        <field name="res_model">bf.budget.forecast.period</field>
        <field name="view_mode">pivot,list</field>
    </record>
</odoo>
