#. module: bf_calendar_hold
#. odoo-python
#: code:addons/bf_calendar_hold/models/calendar_event.py:0
msgid "Slots are held for a meeting, not for another held slot."
msgstr "On retient des plages pour une rencontre, pas pour une autre plage."

#. module: bf_calendar_hold
#: model:ir.model.fields,help:bf_calendar_hold.field_calendar_event__bf_hold_for_id
msgid ""
"The meeting this slot is held for. Choosing the slot moves that meeting here "
"and releases its other held slots."
msgstr ""
"La rencontre pour laquelle cette plage est retenue. Choisir la plage y "
"déplace la rencontre et libère ses autres plages retenues."

