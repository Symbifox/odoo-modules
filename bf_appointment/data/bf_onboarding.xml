<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Configure booking pages</field>
        <field name="description">Review Blue Fox Appointment settings — public slug, timezone, branding, and notification templates.</field>
        <field name="button_text">Open Settings</field>
        <field name="done_text">Settings reviewed</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>

    <record id="bf_onb_step_first_type" model="onboarding.onboarding.step">
        <field name="title">Create your first appointment type</field>
        <field name="description">[action:resource_booking.resource_booking_type_action] Define a bookable resource type so visitors can self-serve a slot.</field>
        <field name="button_text">New appointment type</field>
        <field name="done_text">Booking page is live</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">2</field>
    </record>

    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Blue Fox Appointment</field>
        <field name="route_name">bf_appointment_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_appointment</field>
        <field name="step_ids" eval="[
            Command.link(ref('bf_appointment.bf_onb_step_settings')),
            Command.link(ref('bf_appointment.bf_onb_step_first_type')),
        ]"/>
    </record>

</odoo>
