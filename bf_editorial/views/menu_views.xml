<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Une application dont la racine n'a pas d'action ne s'ouvre pas :
         `menu_service.selectMenu` sort dès que `actionID` est vide, et le
         premier enfant est « Prochain article », qui rend une fenêtre
         `target="new"`. Cliquer l'application ne menait donc nulle part, ou
         à un dialogue posé sur un écran vide. La racine ouvre les entrées. -->
    <menuitem id="menu_editorial_root" name="Atelier éditorial"
              web_icon="bf_editorial,static/description/icon.png"
              action="action_editorial_entry"
              groups="bf_editorial.group_editorial_user" sequence="55"/>

    <record id="action_editorial_propose_next" model="ir.actions.server">
        <field name="name">Prochain article</field>
        <field name="model_id" ref="model_bf_editorial_proposal"/>
        <field name="state">code</field>
        <field name="code">action = env["bf.editorial.proposal"].action_open_next()</field>
    </record>

    <menuitem id="menu_editorial_propose" name="Prochain article"
              parent="menu_editorial_root" action="action_editorial_propose_next"
              sequence="5"/>

    <menuitem id="menu_editorial_entry" name="Entrées"
              parent="menu_editorial_root" action="action_editorial_entry"
              sequence="10"/>

    <menuitem id="menu_editorial_calendar" name="Calendriers"
              parent="menu_editorial_root" action="action_editorial_calendar"
              sequence="20"/>

    <menuitem id="menu_editorial_config" name="Configuration"
              parent="menu_editorial_root"
              groups="bf_editorial.group_editorial_manager" sequence="90"/>

    <menuitem id="menu_editorial_pillar" name="Piliers"
              parent="menu_editorial_config" action="action_editorial_pillar"
              sequence="10"/>

    <menuitem id="menu_editorial_stage" name="Étapes"
              parent="menu_editorial_config" action="action_editorial_stage"
              sequence="20"/>

    <menuitem id="menu_editorial_checklist_tpl" name="Gabarits de contrôle"
              parent="menu_editorial_config"
              action="action_editorial_checklist_template" sequence="30"/>

</odoo>
