<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ir_cron_outreach_followups" model="ir.cron">
        <field name="name">Démarchage : rappels de relance</field>
        <field name="model_id" ref="model_bf_outreach_campaign"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_followup_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <!-- 11:00 UTC = 7:00 heure de l'Est -->
        <field name="nextcall" eval="(DateTime.now().replace(hour=11, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</odoo>
