<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_dav_calendar_list" model="ir.ui.view">
        <field name="name">bf.dav.calendar.list</field>
        <field name="model">bf.dav.calendar</field>
        <field name="arch" type="xml">
            <list string="Calendars for apps">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="owner_id" groups="base.group_system"/>
                <field name="slug"/>
                <field name="is_default"/>
                <field name="color" widget="color" string="Color in apps"/>
                <field name="odoo_color" widget="color_picker"/>
                <field name="event_count"/>
            </list>
        </field>
    </record>
    <record id="view_bf_dav_calendar_form" model="ir.ui.view">
        <field name="name">bf.dav.calendar.form</field>
        <field name="model">bf.dav.calendar</field>
        <field name="arch" type="xml">
            <form string="Calendar for apps">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_events" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="event_count" widget="statinfo" string="Events"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="owner_id" groups="base.group_system"/>
                            <field name="slug"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="color" widget="color" string="Color in apps"/>
                            <field name="odoo_color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Shown to calendar apps"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bf_dav_calendar" model="ir.actions.act_window">
        <field name="name">Calendars for apps</field>
        <field name="res_model">bf.dav.calendar</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No calendar yet</p>
            <p>Each calendar here appears as its own calendar in Thunderbird, Apple Calendar and DAVx5.</p>
        </field>
    </record>
    <menuitem id="menu_bf_dav_calendar" name="Calendars for apps" parent="calendar.calendar_menu_config"
              action="action_bf_dav_calendar" sequence="40"/>
    <record id="view_calendar_event_calendar_dav" model="ir.ui.view">
        <field name="name">calendar.event.calendar.dav</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="inside">
                <field name="bf_dav_calendar_id" string="Calendars" filters="1" color="odoo_color"
                       invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_calendar_event_form_dav" model="ir.ui.view">
        <field name="name">calendar.event.form.dav</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="bf_dav_calendar_id" string="Calendar (apps)" options="{'no_create': True}"
                       domain="[('owner_id', '=', uid)]"/>
            </field>
        </field>
    </record>
</odoo>
