<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reward Kanban (Catalogue) -->
    <record id="view_gamification_reward_kanban" model="ir.ui.view">
        <field name="name">bf.gamification.reward.kanban</field>
        <field name="model">bf.gamification.reward</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0">
                <field name="name"/>
                <field name="image"/>
                <field name="xp_cost"/>
                <field name="category"/>
                <field name="stock"/>
                <field name="available"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column align-items-center p-2">
                            <field name="image" widget="image" options='{"size": [120, 120]}'
                                   class="mb-2"/>
                            <strong class="fs-5"><field name="name"/></strong>
                            <span class="badge text-bg-info mt-1">
                                <field name="xp_cost"/> XP
                            </span>
                            <span class="text-muted small mt-1" t-if="record.stock.raw_value > 0">
                                Stock: <field name="stock"/>
                            </span>
                            <span class="badge text-bg-success mt-1" t-if="record.available.raw_value">
                                Disponible
                            </span>
                            <span class="badge text-bg-secondary mt-1" t-if="!record.available.raw_value">
                                Indisponible
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Reward Form -->
    <record id="view_gamification_reward_form" model="ir.ui.view">
        <field name="name">bf.gamification.reward.form</field>
        <field name="model">bf.gamification.reward</field>
        <field name="arch" type="xml">
            <form string="R&#233;compense">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de la r&#233;compense"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="xp_cost"/>
                            <field name="category"/>
                            <field name="available"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="stock"/>
                            <field name="limit_per_user"/>
                            <field name="claim_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Reward List -->
    <record id="view_gamification_reward_list" model="ir.ui.view">
        <field name="name">bf.gamification.reward.list</field>
        <field name="model">bf.gamification.reward</field>
        <field name="arch" type="xml">
            <list string="R&#233;compenses">
                <field name="name"/>
                <field name="xp_cost"/>
                <field name="category"/>
                <field name="stock"/>
                <field name="available"/>
                <field name="claim_count"/>
            </list>
        </field>
    </record>

    <record id="action_reward_catalog" model="ir.actions.act_window">
        <field name="name">Catalogue</field>
        <field name="res_model">bf.gamification.reward</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('available', '=', True)]</field>
    </record>

    <record id="action_reward_manage" model="ir.actions.act_window">
        <field name="name">G&#233;rer les r&#233;compenses</field>
        <field name="res_model">bf.gamification.reward</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
