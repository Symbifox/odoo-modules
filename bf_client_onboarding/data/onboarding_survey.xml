<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Intake survey: lightweight starter set; refine the questions per practice. -->
    <record id="survey_client_intake" model="survey.survey">
        <field name="title">Intake — Démarrage de mandat Blue Fox</field>
        <field name="description"><![CDATA[
            <p>Quelques questions pour aligner le mandat. Comptez 10 minutes.</p>
        ]]></field>
        <field name="access_mode">token</field>
        <field name="users_can_go_back" eval="True"/>
        <field name="questions_layout">page_per_section</field>
        <field name="state">open</field>
    </record>

    <record id="survey_page_context" model="survey.question">
        <field name="title">Contexte</field>
        <field name="survey_id" ref="survey_client_intake"/>
        <field name="sequence">10</field>
        <field name="is_page" eval="True"/>
        <field name="question_type">char_box</field>
    </record>

    <record id="survey_q_main_contact" model="survey.question">
        <field name="title">Personne-ressource principale au mandat</field>
        <field name="survey_id" ref="survey_client_intake"/>
        <field name="page_id" ref="survey_page_context"/>
        <field name="sequence">11</field>
        <field name="question_type">char_box</field>
    </record>

    <record id="survey_q_main_goal" model="survey.question">
        <field name="title">Quel est le principal résultat que vous espérez atteindre avec ce mandat ?</field>
        <field name="survey_id" ref="survey_client_intake"/>
        <field name="page_id" ref="survey_page_context"/>
        <field name="sequence">12</field>
        <field name="question_type">text_box</field>
    </record>

    <record id="survey_page_ops" model="survey.question">
        <field name="title">Opérations</field>
        <field name="survey_id" ref="survey_client_intake"/>
        <field name="sequence">20</field>
        <field name="is_page" eval="True"/>
        <field name="question_type">char_box</field>
    </record>

    <record id="survey_q_systems" model="survey.question">
        <field name="title">Quels systèmes principaux utilisez-vous (CRM, comptabilité, RH, etc.) ?</field>
        <field name="survey_id" ref="survey_client_intake"/>
        <field name="page_id" ref="survey_page_ops"/>
        <field name="sequence">21</field>
        <field name="question_type">text_box</field>
    </record>

    <record id="survey_q_communication" model="survey.question">
        <field name="title">Quel canal préférez-vous pour les échanges réguliers ?</field>
        <field name="survey_id" ref="survey_client_intake"/>
        <field name="page_id" ref="survey_page_ops"/>
        <field name="sequence">22</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': 'Courriel'}),
            (0, 0, {'value': 'Teams / Slack'}),
            (0, 0, {'value': 'Rencontre vidéo'}),
            (0, 0, {'value': 'Téléphone'}),
        ]"/>
    </record>

</odoo>
