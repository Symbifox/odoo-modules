<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_study_list" model="ir.ui.view">
        <field name="name">bf.property.contingency.study.list</field>
        <field name="model">bf.property.contingency.study</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'superseded'"
                  decoration-danger="study_state == 'due'">
                <field name="name"/>
                <field name="syndicat_id"/>
                <field name="log_id" optional="show"/>
                <field name="obtained_date"/>
                <field name="author_order" optional="show"/>
                <field name="recommended_annual_amount" sum="Somme annuelle"/>
                <field name="next_study_date"/>
                <field name="study_state" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_study_form" model="ir.ui.view">
        <field name="name">bf.property.contingency.study.form</field>
        <field name="model">bf.property.contingency.study</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_obtain" type="object" string="Porter comme obtenue"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,obtained"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Étude du fonds de prévoyance 2026"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert">
                        Art. 8 du règlement : l'étude se base sur la description des
                        réparations majeures et des remplacements incluse au carnet
                        d'entretien. Elle ne peut donc pas le précéder. Le module ne se
                        prononce jamais sur la suffisance du fonds : c'est l'affaire de
                        la personne qui signe.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="study_state != 'due'">
                        L'étude a plus de cinq ans. Art. 8 du règlement : une nouvelle
                        étude doit être obtenue minimalement tous les 5 ans.
                    </div>

                    <group>
                        <group string="Portée">
                            <field name="syndicat_id"/>
                            <field name="log_id"/>
                            <field name="obtained_date"/>
                            <field name="next_study_date"/>
                            <field name="study_state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Auteur (art. 7 du règlement)">
                            <field name="author_partner_id"/>
                            <field name="author_order"/>
                            <field name="author_practice"
                                   invisible="author_order == 'cpa'"/>
                            <field name="author_independent"/>
                            <field name="signed"/>
                        </group>
                    </group>

                    <group string="Contenu minimal (art. 8 al. 2 du règlement)">
                        <group>
                            <field name="fund_balance_used"/>
                            <field name="recommended_opening_balance"/>
                        </group>
                        <group>
                            <field name="recommended_annual_amount"/>
                            <field name="restricted_share"/>
                            <field name="fund_insufficient"/>
                            <field name="shortfall_amount"
                                   invisible="not fund_insufficient"
                                   required="fund_insufficient"/>
                        </group>
                    </group>
                    <group string="Explication des calculs (par. 4°)">
                        <field name="calculation_note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_study" model="ir.actions.act_window">
        <field name="name">Études du fonds de prévoyance</field>
        <field name="res_model">bf.property.contingency.study</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrer une étude</p>
            <p>
                Art. 1071 al. 2 C.c.Q. Un comptable professionnel agréé indépendant peut
                la réaliser, au même titre qu'un ingénieur, un évaluateur agréé, un
                architecte ou un technologue professionnel. Elle se base obligatoirement
                sur un carnet d'entretien établi.
            </p>
        </field>
    </record>

</odoo>
