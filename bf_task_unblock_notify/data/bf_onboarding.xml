<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Notifications de déblocage</field>
        <field name="description">Choisissez qui est notifié quand une tâche bloquante est débloquée et le format des messages.</field>
        <field name="button_text">Ouvrir Paramètres</field>
        <field name="done_text">Notifications actives</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>
    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Notifications déblocage</field>
        <field name="route_name">bf_task_unblock_notify_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_task_unblock_notify</field>
        <field name="step_ids" eval="[Command.link(ref('bf_task_unblock_notify.bf_onb_step_settings'))]"/>
    </record>
</odoo>
