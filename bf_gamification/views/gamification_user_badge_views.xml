<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_user_badge_list" model="ir.ui.view">
        <field name="name">bf.gamification.user.badge.list</field>
        <field name="model">bf.gamification.user.badge</field>
        <field name="arch" type="xml">
            <list string="Badges obtenus" create="0" delete="0">
                <field name="date_earned"/>
                <field name="user_id" widget="many2one_avatar"/>
                <field name="badge_id"/>
                <field name="granted_by"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_user_badge_search" model="ir.ui.view">
        <field name="name">bf.gamification.user.badge.search</field>
        <field name="model">bf.gamification.user.badge</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="user_id"/>
                <field name="badge_id"/>
                <filter name="my_badges" string="Mes badges" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_badge" string="Badge" context="{'group_by': 'badge_id'}"/>
                    <filter name="group_user" string="Utilisateur" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_my_badges" model="ir.actions.act_window">
        <field name="name">Mes badges</field>
        <field name="res_model">bf.gamification.user.badge</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_my_badges': 1}</field>
    </record>

    <record id="action_badge_history" model="ir.actions.act_window">
        <field name="name">Historique des badges</field>
        <field name="res_model">bf.gamification.user.badge</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
