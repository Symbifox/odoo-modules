<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gamification_level_list" model="ir.ui.view">
        <field name="name">bf.gamification.level.list</field>
        <field name="model">bf.gamification.level</field>
        <field name="arch" type="xml">
            <list string="Niveaux" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="min_xp"/>
                <field name="title"/>
                <field name="css_class"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_gamification_level_form" model="ir.ui.view">
        <field name="name">bf.gamification.level.form</field>
        <field name="model">bf.gamification.level</field>
        <field name="arch" type="xml">
            <form string="Niveau">
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du niveau"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="min_xp"/>
                            <field name="title"/>
                        </group>
                        <group>
                            <field name="css_class"/>
                            <field name="color" widget="color_picker"/>
                            <field name="badge_image" widget="image"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gamification_levels" model="ir.actions.act_window">
        <field name="name">Niveaux</field>
        <field name="res_model">bf.gamification.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
