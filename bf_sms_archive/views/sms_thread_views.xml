<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Thread: Tree View -->
    <record id="sms_thread_view_tree" model="ir.ui.view">
        <field name="name">sms.archive.thread.tree</field>
        <field name="model">sms.archive.thread</field>
        <field name="arch" type="xml">
            <list decoration-muted="is_hidden or not active" decoration-bf="unread_count &gt; 0">
                <field name="active" column_invisible="1"/>
                <field name="contact_name" string="Contact"/>
                <field name="phone_normalized" string="Phone"/>
                <field name="partner_id" string="Odoo contact"/>
                <field name="unread_count" string="Unread" optional="show"/>
                <field name="message_count" string="Messages"/>
                <field name="call_count" string="Calls" optional="hide"/>
                <field name="last_message_date" string="Last message"/>
                <field name="last_call_date" string="Last call" optional="hide"/>
                <field name="last_message_preview" string="Preview" optional="show"/>
                <field name="is_hidden" string="Confidential" widget="boolean_toggle"/>
                <field name="task_ids" string="Tasks" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Thread: Form View -->
    <record id="sms_thread_view_form" model="ir.ui.view">
        <field name="name">sms.archive.thread.form</field>
        <field name="model">sms.archive.thread</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_match_partner" string="Link to Odoo contact"
                            type="object" class="btn-secondary"
                            invisible="partner_id"/>
                    <button name="action_archive_thread" string="Archive"
                            type="object" class="btn-secondary" icon="fa-archive"
                            invisible="not active"/>
                    <button name="action_unarchive_thread" string="Unarchive"
                            type="object" class="btn-secondary" icon="fa-inbox"
                            invisible="active"/>
                    <button name="action_export_csv" string="Export CSV"
                            type="object" class="btn-secondary" icon="fa-file-text-o"/>
                    <button name="action_export_xml" string="Export XML"
                            type="object" class="btn-secondary" icon="fa-code"/>
                    <button name="action_print_pdf" string="Export PDF"
                            type="object" class="btn-secondary" icon="fa-file-pdf-o"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-secondary" invisible="active"/>
                    <widget name="web_ribbon" title="Confidential"
                            bg_color="text-bg-danger" invisible="not is_hidden"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                        <button name="action_view_calls" type="object"
                                class="oe_stat_button" icon="fa-phone">
                            <field name="call_count" widget="statinfo" string="Calls"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="contact_name"/>
                        <h1>
                            <field name="contact_name" placeholder="Contact name"/>
                        </h1>
                        <h3>
                            <field name="phone_normalized" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="phone_raw" string="Original number" readonly="1"/>
                            <field name="partner_id" string="Odoo contact"/>
                            <field name="owner_id" string="Owner" readonly="1"/>
                            <field name="line_id" string="Origin line" readonly="1"/>
                        </group>
                        <group string="Settings">
                            <field name="is_hidden" string="Confidential"/>
                            <field name="last_message_date" string="Last message" readonly="1"/>
                            <field name="last_call_date" string="Last call" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="message_ids" nolabel="1" readonly="1">
                                <list decoration-info="direction == 'out'"
                                      decoration-muted="direction == 'draft'"
                                      default_order="date_sent asc">
                                    <field name="direction" string="Direction" widget="badge"
                                           decoration-info="direction == 'out'"
                                           decoration-success="direction == 'in'"
                                           decoration-muted="direction == 'draft'"/>
                                    <field name="body" string="Content"/>
                                    <field name="date_sent" string="Date"/>
                                    <field name="contact_name" string="Contact" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Calls" name="calls">
                            <field name="call_ids" nolabel="1" readonly="1">
                                <list default_order="date desc"
                                      decoration-danger="call_type == 'missed'"
                                      decoration-muted="call_type in ('rejected', 'blocked')">
                                    <field name="call_type" string="Type" widget="badge"
                                           decoration-success="call_type == 'incoming'"
                                           decoration-info="call_type == 'outgoing'"
                                           decoration-danger="call_type == 'missed'"
                                           decoration-warning="call_type == 'voicemail'"
                                           decoration-muted="call_type in ('rejected', 'blocked')"/>
                                    <field name="date" string="Date"/>
                                    <field name="duration_display" string="Duration"/>
                                    <field name="contact_name" string="Contact" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Linked tasks" name="tasks">
                            <field name="task_ids" nolabel="1"
                                   widget="many2many" options="{'no_create': True}">
                                <list>
                                    <field name="project_id" string="Project"/>
                                    <field name="name" string="Task"/>
                                    <field name="stage_id" string="Stage"/>
                                </list>
                            </field>
                            <separator string="Automatic follow-up"/>
                            <div class="text-muted small mb-2">
                                Each new message in this conversation goes
                                to the chatter of these tasks. No effect on
                                messages already archived.
                            </div>
                            <field name="auto_post_task_ids" nolabel="1"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="Links" name="links">
                            <div class="text-muted small mb-2">
                                Where each message went. A single message can
                                target several records; "Undo" removes the
                                link, and the chatter note along with it
                                once no message points to it anymore.
                            </div>
                            <field name="link_ids" nolabel="1" readonly="1">
                                <!-- La fiche d'abord : c'est la colonne qu'on lit.
                                     Mise après le message, elle se faisait écraser
                                     par le nom long de celui-ci et se réduisait à
                                     « Renouvelle… », ce qui ne distingue plus rien. -->
                                <list create="false" default_order="create_date desc">
                                    <field name="res_name" string="Record"/>
                                    <field name="res_model_label" string="Type"/>
                                    <field name="message_id" string="Message"
                                           optional="show"/>
                                    <field name="call_id" string="Call"
                                           optional="hide"/>
                                    <field name="is_auto" string="Auto"
                                           widget="boolean_toggle" readonly="1"/>
                                    <field name="user_id" string="By"
                                           optional="hide"/>
                                    <field name="create_date" string="Linked on"/>
                                    <button name="action_open_target" type="object"
                                            icon="fa-external-link"
                                            title="Open the record"/>
                                    <button name="action_undo" type="object"
                                            icon="fa-chain-broken" title="Undo"
                                            confirm="Remove this link? The chatter note goes with it if no message points to it anymore."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Thread: Search View -->
    <record id="sms_thread_view_search" model="ir.ui.view">
        <field name="name">sms.archive.thread.search</field>
        <field name="model">sms.archive.thread</field>
        <field name="arch" type="xml">
            <search>
                <field name="contact_name" string="Contact"/>
                <field name="phone_normalized" string="Phone"/>
                <field name="partner_id" string="Odoo contact"/>
                <filter name="filter_visible" string="Visible"
                        domain="[('is_hidden', '=', False)]"/>
                <filter name="filter_hidden" string="Confidential threads"
                        domain="[('is_hidden', '=', True)]"/>
                <filter name="filter_unmatched" string="No Odoo contact"
                        domain="[('partner_id', '=', False)]"/>
                <separator/>
                <filter name="filter_unread" string="Unread"
                        domain="[('unread_count', '&gt;', 0)]"/>
                <filter name="filter_active" string="Active (inbox)"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived threads"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group by">
                    <filter name="group_partner" string="Odoo contact"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Thread: Actions -->
    <record id="sms_thread_action" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">sms.archive.thread</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sms_thread_view_search"/>
        <!-- active_test=False : la liste « Conversations » montre par défaut TOUS les
             fils (actifs + archivés). Les filtres « Actives (boîte) » et « Archivés »
             permettent de restreindre. search_default_filter_visible masque encore les
             fils confidentiels (is_hidden) par défaut. -->
        <field name="context">{'search_default_filter_visible': 1, 'active_test': False}</field>
    </record>

</odoo>
