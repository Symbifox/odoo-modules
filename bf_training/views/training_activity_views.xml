<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_activity_list" model="ir.ui.view">
        <field name="name">bf.training.activity.list</field>
        <field name="model">bf.training.activity</field>
        <field name="arch" type="xml">
            <list string="Activities">
                <field name="name"/>
                <field name="category_id"/>
                <field name="mode"/>
                <field name="duration_hours" sum="Hours"/>
                <field name="validity_months"/>
                <field name="provider_partner_id" optional="show"/>
                <field name="requires_plan" optional="hide"/>
                <field name="record_count" string="Completions"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_training_activity_form" model="ir.ui.view">
        <field name="name">bf.training.activity.form</field>
        <field name="model">bf.training.activity</field>
        <field name="arch" type="xml">
            <form string="Activity">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_records" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="record_count" widget="statinfo" string="Completions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="First aid suited to early childhood"/></h1>
                    </div>
                    <group>
                        <group string="What it is">
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="mode"/>
                            <field name="duration_hours"/>
                            <field name="validity_months"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Content version">
                            <field name="content_version"/>
                            <field name="reopen_on_change"/>
                            <button name="action_bump_version" type="object"
                                    string="Bump the version" class="btn-link"
                                    confirm="Anyone who took the previous version will have to take it again."/>
                        </group>
                        <group string="Who gives it">
                            <field name="provider_type"/>
                            <field name="provider_partner_id"/>
                            <field name="employer_issues_attestation"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Eligibility conditions">
                        <field name="requires_plan"/>
                        <field name="requires_support"/>
                        <div class="text-muted" colspan="2">
                            On-the-job training and self-directed learning, online
                            included, count only if the duration is set out in a
                            training plan and support is provided during the
                            learning.
                        </div>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_training_activity_search" model="ir.ui.view">
        <field name="name">bf.training.activity.search</field>
        <field name="model">bf.training.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="provider_partner_id"/>
                <filter name="sous_plan" string="Require a plan" domain="[('requires_plan', '=', True)]"/>
                <filter name="perissable" string="With an expiry" domain="[('validity_months', '&gt;', 0)]"/>
                <filter name="archivees" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_mode" string="Mode" context="{'group_by': 'mode'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_training_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">bf.training.activity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_activity_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build the catalogue</p>
            <p>An activity says what it is, how long it lasts, who gives it
               and how long it stays valid. Who has to complete it is said
               elsewhere, in the requirements.</p>
        </field>
    </record>
</odoo>
