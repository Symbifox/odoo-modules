<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.bf.linkpage</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <!-- ⚠️ `name` est OBLIGATOIRE sur le bloc app. Odoo 18 le lit
                     pour compiler la page ; sans lui, `toStringExpression(null)`
                     fait tomber TOUTE la page des paramètres, pas seulement ce
                     bloc, et l'erreur n'apparaît qu'au navigateur. -->
                <app string="Link pages" name="bf_linkpage"
                     logo="/bf_linkpage/static/description/icon.png">

                    <block title="Automation for employees"
                           name="bf_linkpage_auto_block">

                        <setting id="bf_linkpage_autocreate_setting"
                                 string="Create a page for each employee"
                                 help="A periodic run creates the missing page for active employees who have a contact or a user account. It also catches up those who arrived before activation.">
                            <field name="bf_linkpage_autocreate"/>
                            <div class="content-group mt16" invisible="not bf_linkpage_autocreate">
                                <div class="row">
                                    <label for="bf_linkpage_autocreate_state" class="col-lg-4 o_light_label"/>
                                    <field name="bf_linkpage_autocreate_state"/>
                                </div>
                                <div class="text-muted mt8">
                                    A published page exposes the person's work email and phone on a public URL.
                                </div>
                            </div>
                        </setting>

                        <setting id="bf_linkpage_autorefresh_setting"
                                 string="Refresh pages that follow a template"
                                 help="Reapplies the template on each run. Links added by hand on a page are kept: only those from the template are replaced.">
                            <field name="bf_linkpage_autorefresh"/>
                        </setting>

                        <setting id="bf_linkpage_cron_setting"
                                 string="Scheduled run"
                                 help="Creation and refresh go through the same scheduled job.">
                            <div class="content-group">
                                <div class="text-muted">
                                    <field name="bf_linkpage_cron_active" invisible="1"/>
                                    <span invisible="not bf_linkpage_cron_active">
                                        Next run:
                                        <field name="bf_linkpage_cron_next" readonly="1" class="oe_inline"/>
                                    </span>
                                    <span invisible="bf_linkpage_cron_active" class="text-warning">
                                        The scheduled job is stopped. Nothing will happen on its own.
                                    </span>
                                </div>
                                <div class="mt8">
                                    <button type="object" name="action_bf_linkpage_sync_now"
                                            string="Run now" class="btn-primary"/>
                                    <button type="object" name="action_bf_linkpage_open_cron"
                                            string="Set the frequency" class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="One-off pages" name="bf_linkpage_oneoff_block">
                        <setting id="bf_linkpage_expiry_setting"
                                 string="Default lifetime"
                                 help="A one-off page has no owner: it is armed with an expiry from creation, and closes on its own without any job having to run. An empty or zero value falls back to 90 days.">
                            <div class="content-group">
                                <div class="row">
                                    <field name="bf_linkpage_oneoff_expiry_days" class="col-lg-3"/>
                                    <span class="col-lg-3 o_light_label">days</span>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Organization pages" name="bf_linkpage_org_block">
                        <setting id="bf_linkpage_org_expiry_setting"
                                 string="Default lifetime"
                                 help="An organization page is created with an expiry date. It is the only safeguard against a welcome page left open three years after the engagement ends: its address is opaque, so no one will find it again to close it.">
                            <div class="content-group">
                                <div class="row">
                                    <field name="bf_linkpage_org_expiry_days" class="col-lg-3"/>
                                    <span class="col-lg-3 o_light_label">days</span>
                                </div>
                            </div>
                        </setting>
                        <setting id="bf_linkpage_org_warn_setting"
                                 string="Warn before closing"
                                 help="A one-off page that expires has done its job. An organization page that expires during an engagement returns a 404 to the client without warning anyone: this daily run warns the advisor before that happens.">
                            <div class="content-group">
                                <div class="row">
                                    <field name="bf_linkpage_org_warn_days" class="col-lg-3"/>
                                    <span class="col-lg-3 o_light_label">days before</span>
                                </div>
                            </div>
                        </setting>
                        <setting id="bf_linkpage_guide_setting"
                                 string="User guide"
                                 help="The address served by the &quot;User guide&quot; source. Left empty, the source resolves nothing and the link disappears from the page: a missing link costs less than a link that lands on a login screen.">
                            <div class="content-group">
                                <div class="row">
                                    <field name="bf_linkpage_guide_url_fr" class="col-lg-8"
                                           placeholder="https://example.com/guide/"/>
                                </div>
                                <div class="row">
                                    <field name="bf_linkpage_guide_url_en" class="col-lg-8"
                                           placeholder="https://example.com/guide/en/"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_bf_linkpage_settings" model="ir.actions.act_window">
        <field name="name">Link page settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'bf_linkpage'}</field>
    </record>
</odoo>
