#. module: bf_budget
#. odoo-python
#: code:addons/bf_budget/models/bf_budget.py:0
msgid "\"%(name)s\" has no lines: there is nothing to open."
msgstr "« %(name)s » n'a aucune ligne : il n'y a rien à ouvrir."

#. module: bf_budget
#. odoo-python
#: code:addons/bf_budget/models/bf_budget.py:0
msgid ""
"\"%(name)s\" is no longer a draft: its plan can no longer be edited. Create "
"a revision from it, or reset it to draft."
msgstr ""
"« %(name)s » n'est plus au brouillon : son plan ne se modifie plus. Tirez-en"
" une révision, ou remettez-le au brouillon."

#. module: bf_budget
#. odoo-python
#: code:addons/bf_budget/wizard/bf_budget_position_wizard.py:0
