<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_absence_backfill_wizard_form" model="ir.ui.view">
        <field name="name">bf.absence.backfill.wizard.form</field>
        <field name="model">bf.absence.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Lire le courrier déjà reçu">
                <div class="alert alert-info" role="status">
                    Le courrier déjà reçu contient des répondeurs d'absence que personne n'a
                    encore lus. Cette passe les relève une fois et propose les périodes ;
                    elle n'écrit aucune absence toute seule.
                </div>
                <group>
                    <field name="days"/>
                    <field name="limit"/>
                    <field name="pending" readonly="1"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Lire"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bf_absence_backfill_wizard" model="ir.actions.act_window">
        <field name="name">Lire le courrier déjà reçu</field>
        <field name="res_model">bf.absence.backfill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
