<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bf_outreach_tag_list" model="ir.ui.view">
        <field name="name">bf.outreach.tag.list</field>
        <field name="model">bf.outreach.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color_hex" widget="bf_color" string="Color"/>
            </list>
        </field>
    </record>

    <record id="action_bf_outreach_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">bf.outreach.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a tag</p>
            <p>Tags are there to segment the targets: sector, size, origin…</p>
        </field>
    </record>

</odoo>
