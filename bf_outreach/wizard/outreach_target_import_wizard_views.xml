<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bf_outreach_target_import_wizard_form" model="ir.ui.view">
        <field name="name">bf.outreach.target.import.wizard.form</field>
        <field name="model">bf.outreach.target.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter des cibles">
                <sheet>
                    <group>
                        <group>
                            <field name="campaign_id" options="{'no_create': True}"/>
                            <field name="source" placeholder="ex. Liste salon 2026"/>
                        </group>
                        <group>
                            <field name="assign_mode"/>
                            <field name="user_id" invisible="assign_mode != 'user'"
                                   required="assign_mode == 'user'"
                                   widget="many2one_avatar_user"/>
                            <field name="skip_existing"/>
                        </group>
                    </group>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_quick_create': True}"
                           placeholder="Contacts à démarcher"/>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Ajouter" class="btn-primary"/>
                    <button special="cancel" string="Annuler" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
