<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_line_view_list" model="ir.ui.view">
        <field name="name">bf.budget.line.list</field>
        <field name="model">bf.budget.line</field>
        <field name="arch" type="xml">
            <list string="Budget lines" decoration-danger="is_alert" create="0">
                <field name="budget_id"/>
                <field name="name"/>
                <field name="source" optional="show"/>
                <field name="amount_planned" sum="Planned"/>
                <field name="amount_theoretical" sum="Theoretical"/>
                <field name="amount_actual" sum="Actual"/>
                <field name="amount_committed" sum="Committed"/>
                <field name="amount_drift" sum="Variance from theoretical"/>
                <field name="drift_pct" optional="show"/>
                <field name="is_alert" optional="hide"/>
                <field name="overrun_accepted" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="bf_budget_line_view_form" model="ir.ui.view">
        <field name="name">bf.budget.line.form</field>
        <field name="model">bf.budget.line</field>
        <field name="arch" type="xml">
            <form string="Budget line">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not has_unvalued_time">
                        Hours are logged on this line but costed at zero: the hourly cost of the people involved is not set. The line would read "nothing spent" when a setting is missing.
                    </div>
                    <group>
                        <group>
                            <field name="budget_id"/>
                            <field name="budget_type" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="state" invisible="1"/>
                            <field name="source"/>
                            <field name="position_id" required="source == 'accounting'"/>
                            <field name="analytic_account_ids" widget="many2many_tags"
                                   required="source == 'internal_cost'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="amount_planned"/>
                            <field name="amount_theoretical"/>
                            <field name="theoretical_basis"/>
                            <field name="amount_actual"/>
                            <field name="amount_committed"/>
                            <field name="amount_drift"/>
                            <field name="is_alert"/>
                            <field name="has_unvalued_time" invisible="1"/>
                            <field name="unvalued_hours" invisible="not has_unvalued_time"/>
                        </group>
                    </group>
                    <group string="Overrun" invisible="not is_alert and not overrun_accepted">
                        <field name="overrun_accepted"/>
                        <field name="overrun_reason" required="overrun_accepted"/>
                    </group>
                    <notebook>
                        <page string="Monthly breakdown" name="periods">
                            <button name="action_spread_evenly" string="Spread evenly"
                                    type="object" class="btn-secondary"
                                    invisible="state != 'draft'"/>
                            <field name="period_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="date_start" readonly="1"/>
                                    <field name="date_end" readonly="1"/>
                                    <field name="amount_planned" sum="Planned"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_budget_line_view_pivot" model="ir.ui.view">
        <field name="name">bf.budget.line.pivot</field>
        <field name="model">bf.budget.line</field>
        <field name="arch" type="xml">
            <pivot string="Budget vs. actual">
                <field name="position_id" type="row"/>
                <field name="amount_planned" type="measure"/>
                <field name="amount_committed" type="measure"/>
                <field name="amount_drift" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="bf_budget_line_view_graph" model="ir.ui.view">
        <field name="name">bf.budget.line.graph</field>
        <field name="model">bf.budget.line</field>
        <field name="arch" type="xml">
            <graph string="Budget vs. actual" type="bar">
                <field name="position_id"/>
                <field name="amount_planned" type="measure"/>
                <field name="amount_committed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="bf_budget_line_view_search" model="ir.ui.view">
        <field name="name">bf.budget.line.search</field>
        <field name="model">bf.budget.line</field>
        <field name="arch" type="xml">
            <search string="Budget lines">
                <field name="budget_id"/>
                <field name="position_id"/>
                <filter name="alerts" string="Flagged" domain="[('is_alert', '=', True)]"/>
                <filter name="accepted" string="Accepted overrun" domain="[('overrun_accepted', '=', True)]"/>
                <separator/>
                <filter name="accounting" string="Accounting" domain="[('source', '=', 'accounting')]"/>
                <filter name="internal" string="Internal cost" domain="[('source', '=', 'internal_cost')]"/>
                <separator/>
                <filter name="open_budgets" string="Open budgets" domain="[('state', '=', 'open')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_budget" string="Budget" context="{'group_by': 'budget_id'}"/>
                    <filter name="group_position" string="Budget item" context="{'group_by': 'position_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_budget_line_action" model="ir.actions.act_window">
        <field name="name">Budget tracking</field>
        <field name="res_model">bf.budget.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_open_budgets': 1, 'search_default_group_budget': 1}</field>
    </record>

    <record id="bf_budget_line_alert_action" model="ir.actions.act_window">
        <field name="name">Flagged lines</field>
        <field name="res_model">bf.budget.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_alert', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No flagged line</p>
            <p>
                A line is flagged when its drift exceeds both the budget's percentage and its dollar floor. Both, never just one: a percentage alone screams on small budget items, an amount alone stays silent on large ones.
            </p>
        </field>
    </record>
</odoo>
