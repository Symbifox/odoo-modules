#. module: bf_key_management
#: model:ir.module.module,shortdesc:base.module_bf_key_management
msgid "Symbifox Keys"
msgstr "Clés Symbifox"

#. module: bf_key_management
#: model:ir.module.module,summary:base.module_bf_key_management
msgid ""
"Who holds which key, card or remote of the premises, which doors each one "
"opens, and nothing forgotten when someone leaves"
msgstr ""
"Qui détient quelle clé, carte ou télécommande des locaux, quelles portes "
"chacune ouvre, et rien d'oublié au départ d'une personne"

#. module: bf_key_management
#. odoo-python
#: code:addons/bf_key_management/wizard/bf_key_issue_wizard.py:0
msgid ""
"%(copy)s is held by %(who)s. Record its return first: a copy never goes "
"directly from one person to another."
msgstr ""
"L'exemplaire %(copy)s est détenu par %(who)s. Enregistrez d'abord son retour"
" : un exemplaire ne passe jamais directement d'une personne à une autre."

#. module: bf_key_management
#. odoo-python
#: code:addons/bf_key_management/wizard/bf_key_loss_wizard.py:0
msgid ""
"%(count)s doors open with this key. Decide whether to rekey them, and record"
" the decision on the incident."
msgstr ""
"%(count)s portes s'ouvrent avec cette clé. Décidez s'il faut les recléer, et"
" consignez la décision sur l'incident."

#. module: bf_key_management
#. odoo-python
#: code:addons/bf_key_management/models/bf_key_type.py:0
msgid ""
"%(key)s and the key above it must belong to the same master key system."
msgstr ""
"La clé %(key)s et celle au-dessus d'elle doivent appartenir au même "
"organigramme de cléage."

#. module: bf_key_management
#. odoo-python
#: code:addons/bf_key_management/models/bf_key_type.py:0
msgid "%(key)s is deeper than the %(levels)s levels of its master key system."
msgstr ""
"La clé %(key)s dépasse les %(levels)s niveaux de son organigramme de cléage."

#. module: bf_key_management
#. odoo-python
#: code:addons/bf_key_management/wizard/bf_key_issue_wizard.py:0
