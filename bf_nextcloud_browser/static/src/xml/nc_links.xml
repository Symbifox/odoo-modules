<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Bouton du composeur, a cote du trombone. Le sous-gabarit `attachFiles`
        est appele par les deux barres d'actions du composeur (normale et
        « extra ») : l'heriter une fois couvre les deux.
    -->
    <t t-name="bf_nextcloud_browser.Composer.attachFiles" t-inherit="mail.Composer.attachFiles" t-inherit-mode="extension">
        <xpath expr="//FileUploader" position="after">
            <button t-if="bfNcVisible" type="button"
                    class="o-bf-nc-insert btn border-0 rounded-circle p-0"
                    t-att-disabled="!state.active"
                    title="Insert a Nextcloud link" aria-label="Insert a Nextcloud link"
                    t-on-click="onClickBfNcInsert">
                <i class="fa fa-fw fa-lg fa-cloud"/>
            </button>
        </xpath>
    </t>

    <!-- Bouton de la barre du chatter, a cote de la loupe. -->
    <t t-name="bf_nextcloud_browser.Chatter" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o-mail-Chatter-topbarGrow')]" position="after">
            <button t-if="bfNcLinksVisible" class="btn btn-link text-action o-bf-nc-linked"
                    type="button" t-on-click="onClickBfNcLinkedFiles"
                    aria-label="Linked Nextcloud files" title="Nextcloud files linked in this thread">
                <i class="fa fa-cloud" role="img"/>
            </button>
            <button t-if="bfNcLinksVisible" class="btn btn-link text-action o-bf-nc-file"
                    type="button" t-on-click="onClickBfNcFile"
                    aria-label="File attachments in the client folder" title="File attachments in the client folder">
                <i class="fa fa-folder-open-o" role="img"/>
            </button>
        </xpath>
    </t>

    <t t-name="bf_nextcloud_browser.NcFileDialog">
        <Dialog title="title" size="'xl'" contentClass="'o_nc_file_dialog'">
            <div t-if="state.loading" class="text-muted p-2"><i class="fa fa-spinner fa-spin me-1"/>Reading the thread…</div>
            <div t-elif="state.error" class="alert alert-warning mb-0" t-esc="state.error"/>
            <div t-else="" class="row g-3">
                <div class="col-lg-4 o_nc_file_list">
                    <div class="fw-bold mb-2">Thread attachments</div>
                    <div t-if="!state.attachments.length" class="text-muted">No attachments in this thread.</div>
                    <div t-if="state.selected.length >= state.batchMax" class="small text-warning mb-1">
                        At most <t t-esc="state.batchMax"/> attachments at a time.
                    </div>
                    <label t-foreach="state.attachments" t-as="att" t-key="att.id"
                           class="d-flex align-items-start gap-2 py-1 border-bottom o_nc_file_item"
                           t-att-class="{ 'text-muted': att.too_big }">
                        <input type="checkbox" class="form-check-input mt-1" t-att-disabled="isLocked(att)"
                               t-att-checked="state.selected.includes(att.id)" t-on-change="() => this.toggle(att)"/>
                        <span class="flex-grow-1 text-break">
                            <span t-esc="att.name"/>
                            <small class="d-block text-muted">
                                <t t-esc="att.date"/> · <t t-esc="att.size_display"/>
                                <t t-if="att.too_big"> · too large</t>
                            </small>
                        </span>
                    </label>
                </div>
                <div class="col-lg-8">
                    <div t-if="!state.startRel" class="alert alert-info py-1 small">
                        This record has no client folder: choose where to copy.
                    </div>
                    <NcBrowserApp startRel="state.startRel" noMemory="true" onNavigate.bind="onNavigate"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <span class="text-muted small me-auto">The attachment is copied, it also stays in Odoo.</span>
                <button class="btn btn-primary o_nc_file_go" t-att-disabled="!canFile" t-on-click="file">
                    <i t-if="state.busy" class="fa fa-spinner fa-spin me-1"/>
                    Copy <t t-esc="state.selected.length"/> attachment(s) to « <t t-esc="where"/> »
                </button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="bf_nextcloud_browser.NcPickerDialog">
        <Dialog title="title" size="'xl'" contentClass="'o_nc_picker_dialog'">
            <NcBrowserApp onPick.bind="onPick"/>
            <t t-set-slot="footer">
                <span class="text-muted small me-auto">Click a file, or "Insert" for a folder.</span>
                <button class="btn btn-secondary" t-on-click="() => props.close()">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="bf_nextcloud_browser.NcLinkedFilesDialog">
        <Dialog title="title" size="'lg'">
            <div t-if="state.loading" class="text-muted p-2"><i class="fa fa-spinner fa-spin me-1"/>Reading messages and Nextcloud…</div>
            <div t-elif="state.error" class="alert alert-info mb-0" t-esc="state.error"/>
            <div t-elif="!state.links.length" class="text-muted p-2">
                No Nextcloud link in this record's messages. To add one, use the cloud in the composer.
            </div>
            <t t-else="">
                <p t-if="state.truncated" class="text-muted small">Only the 200 most recent links are shown.</p>
                <table class="table table-sm align-middle o_nc_linked_table mb-0">
                    <thead>
                        <tr>
                            <th>File</th>
                            <th>Status</th>
                            <th class="text-end">Cited</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.links" t-as="l" t-key="l.kind + ':' + l.key">
                            <tr t-att-class="{ 'text-muted': !l.found }">
                                <td>
                                    <i class="fa me-1" t-att-class="l.kind === 'internal' ? 'fa-lock' : 'fa-globe'"/>
                                    <span t-esc="label(l)"/>
                                    <div t-if="where(l)" class="small text-muted text-truncate"><i class="fa fa-folder-o me-1"/><t t-esc="where(l)"/></div>
                                </td>
                                <td class="small">
                                    <span t-if="l.found and l.share and l.share.is_public and !l.share.expiration and l.share.expiry_checked" class="badge text-bg-warning me-1">No expiry</span>
                                    <t t-esc="stateLabel(l)"/>
                                </td>
                                <td class="text-end small text-nowrap">
                                    <t t-esc="l.mentions"/> times
                                    <div class="text-muted" t-esc="l.last_date.slice(0, 10)"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.open(l)" title="Open link"><i class="fa fa-external-link"/></button>
                                    <button class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.copy(l)" title="Copy link"><i class="fa fa-clipboard"/></button>
                                    <button t-if="l.share and l.share.can_revoke" class="btn btn-sm btn-link text-danger p-0"
                                            t-on-click="() => this.revoke(l)" title="Remove this share"><i class="fa fa-ban"/></button>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.load()" t-att-disabled="state.loading"><i class="fa fa-refresh me-1"/>Reload</button>
                <button class="btn btn-primary" t-on-click="() => props.close()">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
