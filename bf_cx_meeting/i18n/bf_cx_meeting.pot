#. module: bf_cx_meeting
#: model:mail.template,body_html:bf_cx_meeting.mail_template_meeting_rating
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#29ABE2'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#2E3132'\"/>\n"
"<t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"/>\n"
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#F8FAFC;\">\n"
"    <tbody><tr><td align=\"center\" style=\"padding:24px;\">\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;\">\n"
"            <tbody>\n"
"                <tr>\n"
"                    <td t-attf-style=\"background-color:{{ brand_dark }}; padding:16px 24px; border-radius:12px 12px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tbody><tr>\n"
"                            <td align=\"left\">\n"
"                                <img t-att-src=\"'/brand/logo/%d' % company.id\" alt=\"Logo\" style=\"height:40px; width:auto; display:block; border:0;\"/>\n"
"                            </td>\n"
"                            <td align=\"right\" style=\"color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;\">\n"
"                                Your feedback\n"
"                            </td>\n"
"                        </tr></tbody></table>\n"
"                    </td>\n"
"                </tr>\n"
"                <tr><td t-attf-style=\"height:4px; line-height:4px; background-color:{{ brand_primary }};\">&amp;nbsp;</td></tr>\n"
"                <tr>\n"
"                    <td style=\"padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif; color:#2E3132;\">\n"
"                        <p style=\"font-size:15px; margin:0 0 12px 0;\">\n"
"                            Hello <t t-out=\"object.partner_id.name or ''\"/>,\n"
"                        </p>\n"
"                        <p style=\"font-size:15px; margin:0 0 12px 0;\">\n"
"                            We have just sent you the report from our meeting. In one click, how would you rate our services so far?\n"
"                        </p>\n"
"                        <table role=\"presentation\" style=\"margin:24px auto; text-align:center;\">\n"
"                            <tbody><tr>\n"
"                                <td style=\"padding:0 16px;\">\n"
"                                    <a t-attf-href=\"/rate/{{ access_token }}/5\">\n"
"                                        <img alt=\"Satisfied\" src=\"/rating/static/src/img/rating_5.png\" title=\"Satisfied\"/>\n"
"                                    </a>\n"
"                                </td>\n"
"                                <td style=\"padding:0 16px;\">\n"
"                                    <a t-attf-href=\"/rate/{{ access_token }}/3\">\n"
"                                        <img alt=\"Okay\" src=\"/rating/static/src/img/rating_3.png\" title=\"Okay\"/>\n"
"                                    </a>\n"
"                                </td>\n"
"                                <td style=\"padding:0 16px;\">\n"
"                                    <a t-attf-href=\"/rate/{{ access_token }}/1\">\n"
"                                        <img alt=\"Dissatisfied\" src=\"/rating/static/src/img/rating_1.png\" title=\"Dissatisfied\"/>\n"
"                                    </a>\n"
"                                </td>\n"
"                            </tr></tbody>\n"
"                        </table>\n"
"                        <p style=\"font-size:13px; color:#6B7280; margin:0;\">\n"
"                            You can add a free-form comment after clicking. Thank you!\n"
"                        </p>\n"
"                    </td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:16px 24px 20px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;\">\n"
"                        <p style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:0;\">\n"
"                            <t t-if=\"company.name\"><t t-out=\"company.name\"/><br/></t>\n"
"                            Prefer not to receive feedback requests?\n"
"                            <a t-att-href=\"object.partner_id.bf_cx_unsubscribe_url\" style=\"color:#6B7280;\">Unsubscribe</a>.\n"
"                        </p>\n"
"                    </td>\n"
"                </tr>\n"
"            </tbody>\n"
"        </table>\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:12px auto 0;\">\n"
"            <tbody><tr>\n"
"                <td t-attf-style=\"height:3px; line-height:3px; background-color:{{ brand_primary }}; width:50%;\">&amp;nbsp;</td>\n"
"                <td t-attf-style=\"height:3px; line-height:3px; background-color:{{ brand_dark }}; width:50%;\">&amp;nbsp;</td>\n"
"            </tr></tbody>\n"
"        </table>\n"
"    </td></tr></tbody>\n"
"</table>\n"
"            "
msgstr ""

