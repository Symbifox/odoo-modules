<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_note_reroute_view_form" model="ir.ui.view">
        <field name="name">bf.note.reroute.form</field>
        <field name="model">bf.note.reroute</field>
        <field name="arch" type="xml">
            <form string="Reroute the note">
                <group invisible="state != 'draft'">
                    <group string="Selected note(s)">
                        <field name="note_count"/>
                        <field name="sample_name" readonly="1"
                               invisible="note_count != 1"/>
                        <field name="current_target" readonly="1"
                               invisible="note_count != 1"/>
                        <field name="note_ids" widget="many2many_tags"
                               invisible="note_count == 1"
                               readonly="1"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Destination">
                        <field name="target_reference"
                               widget="bf_chatter_target"
                               required="1"
                               placeholder="Name, number, task:22299, bf.email:17, or Odoo URL…"/>
                        <field name="mode" widget="radio"/>
                    </group>
                    <div class="alert alert-info" role="alert" colspan="2">
                        <p class="mb-1"><strong>How it works:</strong></p>
                        <ul class="mb-0">
                            <li>Any record with a chatter is a valid destination: task, ticket, contact, opportunity, archived email, agenda, secure transfer…</li>
                            <li>Search for the record by its name: the picker scans every module at once, without having to choose the type of object.</li>
                            <li>A number (<code>22299</code>), a shortcut (<code>task:22299</code>), a technical reference (<code>bf.email:17</code>) or a pasted Odoo URL resolve to the exact record, listed first.</li>
                            <li><em>Replace</em> moves the note: its current links are removed in favour of the new record. <em>Add</em> leaves it attached to both.</li>
                            <li>Nothing is posted or sent: only the note's links change.</li>
                        </ul>
                    </div>
                </group>
                <group invisible="state != 'done'">
                    <field name="result_text" nolabel="1" colspan="2"/>
                </group>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_confirm"
                            string="Reroute"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bf_note_reroute_action" model="ir.actions.act_window">
        <field name="name">Reroute the note</field>
        <field name="res_model">bf.note.reroute</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Re-routage en lot depuis la liste des notes -->
    <record id="bf_note_reroute_action_bulk" model="ir.actions.server">
        <field name="name">Reroute to a record</field>
        <field name="model_id" ref="model_bf_note"/>
        <field name="binding_model_id" ref="model_bf_note"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_reroute_wizard()</field>
    </record>

</odoo>
