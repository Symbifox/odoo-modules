<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_subscription" model="ir.sequence">
            <field name="name">Abonnement</field>
            <field name="code">subscription.subscription</field>
            <!-- ⚠️ company_id EXPLICITEMENT vide : sans ça, le défaut d'ir.sequence
                 (la société courante) estampille la séquence à la société qui charge
                 les données. Sous toute autre société, next_by_code ne trouve alors
                 rien, rend False, et le create retombe sur le littéral « Nouveau » —
                 que la contrainte unique (code, société) refuse au DEUXIÈME
                 abonnement, avec une erreur Postgres brute. -->
            <field name="company_id" eval="False"/>
            <field name="prefix">SUB-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
        </record>
    </data>
</odoo>
