<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_kitchen_station_view_list" model="ir.ui.view">
        <field name="name">bf.kitchen.station.list</field>
        <field name="model">bf.kitchen.station</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pos_config_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="pos_categ_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
            </list>
        </field>
    </record>
    <record id="bf_kitchen_station_action" model="ir.actions.act_window">
        <field name="name">Kitchen stations</field>
        <field name="res_model">bf.kitchen.station</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a kitchen station</p>
            <p>A station shows the dishes its registers send: the hot line, the cold line, the bar. Choose its
               register categories, or none for every dish.</p>
        </field>
    </record>
</odoo>
