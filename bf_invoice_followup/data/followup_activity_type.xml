<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated activity type: the cron idempotence AND the clear-on-paid
             sweep key off this xmlid. Reusing the generic To-Do would wipe
             unrelated activities. -->
        <record id="mail_activity_type_relance" model="mail.activity.type">
            <field name="name">Relance de facture</field>
            <field name="summary">Relancer la facture client en retard</field>
            <field name="res_model">account.move</field>
            <field name="icon">fa-bell</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
        </record>
    </data>
</odoo>
