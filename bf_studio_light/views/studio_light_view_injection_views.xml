<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="studio_light_view_injection_list" model="ir.ui.view">
        <field name="name">studio.light.view.injection.list</field>
        <field name="model">studio.light.view.injection</field>
        <field name="arch" type="xml">
            <list string="View injections">
                <field name="model_name"/>
                <field name="view_type"/>
                <field name="target_field"/>
                <field name="position"/>
                <field name="studio_field_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="studio_light_view_injection_form" model="ir.ui.view">
        <field name="name">studio.light.view.injection.form</field>
        <field name="model">studio.light.view.injection</field>
        <field name="arch" type="xml">
            <form string="View injection">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="view_type"/>
                            <field name="parent_view_id"
                                   domain="[('model', '=', model_name), ('type', '=', view_type)]"/>
                            <field name="studio_field_id"
                                   domain="[('model_id', '=', model_id)]"/>
                        </group>
                        <group>
                            <field name="target_field"/>
                            <field name="custom_xpath" placeholder="//field[@name='email']"/>
                            <field name="position"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="ir_view_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Custom arch (optional)">
                        <field name="arch_snippet"
                               nolabel="1"
                               placeholder="&lt;field name='x_studio_my_field'/&gt;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_studio_light_view_injection" model="ir.actions.act_window">
        <field name="name">View injections</field>
        <field name="res_model">studio.light.view.injection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
