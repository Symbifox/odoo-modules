#. module: bf_llm
#: model:ir.model.fields,help:bf_llm.field_bf_llm_provider__enabled
msgid "A disabled provider is never returned by default()/for_feature()."
msgstr ""
"Un fournisseur désactivé n'est jamais rendu par default() ni par "
"for_feature()."

#. module: bf_llm
#: model:ir.model.fields,field_description:bf_llm.field_bf_llm_provider__api_key
msgid "API Key"
msgstr "Clé API"

#. module: bf_llm
#: model:ir.model.fields,help:bf_llm.field_bf_llm_provider__base_url
msgid ""
"API base URL. Blank uses the per-provider default (Anthropic: "
"https://api.anthropic.com, OpenAI: https://api.openai.com/v1). Required for "
"OpenAI-compatible/local (e.g. http://localhost:11434/v1)."
msgstr ""
"Adresse de base de l'API. Laissée vide, celle du fournisseur s'applique "
"(Anthropic : https://api.anthropic.com, OpenAI : https://api.openai.com/v1)."
" Nécessaire pour un serveur compatible OpenAI ou local (p. ex. "
"http://localhost:11434/v1)."

#. module: bf_llm
#. odoo-python
#: code:addons/bf_llm/models/bf_llm_provider.py:0
msgid ""
"An internal/private address is not allowed for a cloud provider base URL."
msgstr ""
"Une adresse interne ou privée n'est pas permise comme adresse de base d'un "
"fournisseur en nuage."

