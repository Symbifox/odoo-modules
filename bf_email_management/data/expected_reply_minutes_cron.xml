<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_expected_reply_minutes" model="ir.cron">
            <field name="name">Courriels : recalcul du temps de réponse attendu (par contact, 30j)</field>
            <field name="model_id" ref="model_bf_email"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_expected_reply()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
