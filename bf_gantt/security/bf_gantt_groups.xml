<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_bf_gantt" model="ir.module.category">
            <field name="name">Échéancier</field>
            <field name="description">Échéanciers Gantt, plans autonomes et partage au portail.</field>
            <field name="sequence">45</field>
        </record>

        <!-- Deux niveaux, pas trois. Lire un échéancier n'est pas un privilège :
             quiconque voit le projet voit son échéancier. Le groupe « gestion »
             existe pour ce qui engage : créer un plan et surtout PUBLIER. -->
        <record id="group_bf_gantt_user" model="res.groups">
            <field name="name">Lecture</field>
            <field name="category_id" ref="module_category_bf_gantt"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <record id="group_bf_gantt_manager" model="res.groups">
            <field name="name">Gestion et publication</field>
            <field name="category_id" ref="module_category_bf_gantt"/>
            <field name="implied_ids" eval="[(4, ref('bf_gantt.group_bf_gantt_user'))]"/>
        </record>

        <!-- ⚠️ Aucun groupe n'est accordé automatiquement à un profil existant.
             Publier un échéancier le rend lisible sans compte : c'est un geste
             qui se donne à quelqu'un, il ne s'hérite pas d'un rôle de projet. -->

    </data>
</odoo>
