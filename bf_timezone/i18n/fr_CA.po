#. module: bf_timezone
#: model_terms:ir.ui.view,arch_db:bf_timezone.res_config_settings_view_form
msgid ""
"Fallback timezone for meeting displays, appointment emails and ICS files "
"when no contact/user/calendar timezone is set."
msgstr ""
"Fuseau de repli pour l'affichage des rencontres, les courriels de rendez-"
"vous et les fichiers ICS, quand aucun fuseau de contact, d'usager ou "
"d'agenda n'est posé."

#. module: bf_timezone
#: model:ir.model.fields,help:bf_timezone.field_res_config_settings__bf_default_tz
msgid ""
"Fallback timezone used by Blue Fox modules when no contact, user or calendar"
" timezone is available (e.g. meeting displays, appointment emails, ICS "
"files). Set this to Pacific/Auckland after relocating."
msgstr ""
"Fuseau de repli employé par les modules Blue Fox quand aucun fuseau de "
"contact, d'usager ou d'agenda n'est disponible (affichage des rencontres, "
"courriels de rendez-vous, fichiers ICS). À poser sur Pacific/Auckland après "
"un déménagement."

#. module: bf_timezone
