<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_assignment_form_slides" model="ir.ui.view">
        <field name="name">bf.training.assignment.form.slides</field>
        <field name="model">bf.training.assignment</field>
        <field name="inherit_id" ref="bf_training.view_training_assignment_form"/>
        <field name="arch" type="xml">
            <button name="action_remind" position="before">
                <button name="action_enroll" type="object" string="Inscrire au cours"
                        class="btn-primary"
                        invisible="not slide_channel_id or channel_partner_id"/>
                <button name="action_open_course" type="object" string="Ouvrir le cours"
                        invisible="not slide_channel_id"/>
            </button>
            <field name="record_id" position="after">
                <field name="slide_channel_id"/>
                <field name="channel_partner_id"/>
                <field name="member_status"/>
            </field>
        </field>
    </record>
</odoo>
