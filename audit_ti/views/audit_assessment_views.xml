<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_assessment_list" model="ir.ui.view">
        <field name="name">audit.assessment.list</field>
        <field name="model">audit.assessment</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'adequate'" decoration-danger="status == 'inadequate'" decoration-warning="status in ('partial', 'declared')" decoration-muted="status == 'na'">
                <field name="client_id"/>
                <field name="supplier_id"/>
                <field name="element_num" string="N°"/>
                <field name="element_id"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'adequate'"
                    decoration-danger="status == 'inadequate'"
                    decoration-warning="status in ('partial', 'to_validate', 'declared')"
                    decoration-info="status == 'pending'"/>
                <field name="response_received_date" optional="hide"/>
                <field name="assessed_by"/>
                <field name="assessed_date"/>
                <field name="recommendation" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_audit_assessment_form" model="ir.ui.view">
        <field name="name">audit.assessment.form</field>
        <field name="model">audit.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_watchpoint" string="Créer un point de vigilance"
                        type="object" class="btn-secondary"
                        invisible="status not in ('inadequate', 'partial')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="supplier_id"/>
                            <field name="element_id"/>
                            <field name="element_num" string="N°" readonly="1"/>
                        </group>
                        <group>
                            <field name="status" widget="radio"/>
                            <field name="assessed_by"/>
                            <field name="assessed_date"/>
                            <field name="response_received_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Réponse du fournisseur">
                            <field name="response" placeholder="Copier/coller la réponse du fournisseur depuis le tableau d'alignement..."/>
                        </page>
                        <page string="Notes de l'évaluateur">
                            <field name="notes" placeholder="Notes, justification de l'évaluation..."/>
                        </page>
                        <page string="Recommandation au client">
                            <field name="recommendation" placeholder="Recommandation spécifique pour le client concernant ce fournisseur/élément..."/>
                        </page>
                        <page string="Meilleures pratiques">
                            <field name="element_best_practices" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_audit_assessment_search" model="ir.ui.view">
        <field name="name">audit.assessment.search</field>
        <field name="model">audit.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="client_id"/>
                <field name="supplier_id"/>
                <field name="element_id"/>
                <separator/>
                <filter name="adequate" string="Adéquat" domain="[('status', '=', 'adequate')]"/>
                <filter name="partial" string="Partiel" domain="[('status', '=', 'partial')]"/>
                <filter name="declared" string="Déclaré" domain="[('status', '=', 'declared')]"/>
                <filter name="to_validate" string="À valider" domain="[('status', '=', 'to_validate')]"/>
                <filter name="inadequate" string="Inadéquat" domain="[('status', '=', 'inadequate')]"/>
                <filter name="pending" string="En attente" domain="[('status', '=', 'pending')]"/>
                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_supplier" string="Fournisseur" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_element" string="Élément" context="{'group_by': 'element_id'}"/>
                    <filter name="group_status" string="Statut" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_audit_assessment" model="ir.actions.act_window">
        <field name="name">Évaluations</field>
        <field name="res_model">audit.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
