<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_celebration_signer_group_list" model="ir.ui.view">
        <field name="name">bf.celebration.signer.group.list</field>
        <field name="model">bf.celebration.signer.group</field>
        <field name="arch" type="xml">
            <list string="Signatory groups">
                <field name="name"/>
                <field name="department_ids" widget="many2many_tags" optional="show"/>
                <field name="member_count"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_celebration_signer_group_form" model="ir.ui.view">
        <field name="name">bf.celebration.signer.group.form</field>
        <field name="model">bf.celebration.signer.group</field>
        <field name="arch" type="xml">
            <form string="Signatory group">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Montréal team"/></h1>
                    </div>
                    <p class="text-muted">
                        Who a card is held out to. The group resolves at the moment
                        of sending: somebody who joined the department since
                        receives the link, somebody who left does not. It
                        never says who signed.
                    </p>
                    <group>
                        <group>
                            <field name="department_ids" widget="many2many_tags"
                                   options="{'no_quick_create': true}"/>
                            <field name="employee_ids" widget="many2many_tags"
                                   options="{'no_quick_create': true}"/>
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags"
                                   options="{'no_quick_create': true}"/>
                            <field name="member_count"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Why this group, and for whom."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_celebration_signer_group" model="ir.actions.act_window">
        <field name="name">Signatory groups</field>
        <field name="res_model">bf.celebration.signer.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No group yet</p>
            <p>A group gathers people, departments or contacts
               the link of a card is sent to, once each.
               It is reused from one card to the next.</p>
        </field>
    </record>

</odoo>
