<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_school_forms" name="School: authorisations tile"
              inherit_id="portal.portal_my_home" priority="32">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/bf_school_core/static/description/icon.png'"/>
                <t t-set="title">Authorisations</t>
                <t t-set="text">Field trips and activities: authorise or refuse in one click</t>
                <t t-set="url" t-value="'/my/school/forms'"/>
                <t t-set="placeholder_count" t-value="'school_form_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_school_forms" name="School: authorisations breadcrumbs"
              inherit_id="portal.portal_breadcrumbs" priority="32">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'school_forms'" class="breadcrumb-item active">Authorisations</li>
        </xpath>
    </template>

    <template id="portal_my_school_forms_link" name="School: link to authorisations"
              inherit_id="bf_school_portal.portal_my_school">
        <xpath expr="//div[hasclass('o_school_links')]" position="inside">
            <a href="/my/school/forms" class="btn btn-secondary">
                <i class="fa fa-pencil-square-o me-1"/>Authorisations</a>
        </xpath>
    </template>

    <template id="portal_school_forms" name="School: authorisations">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Authorisations</t>
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Authorisations</t>
            </t>
            <div t-if="not answers" class="alert alert-info mt-3">No authorisation for now.</div>
            <div class="list-group mt-3">
                <a t-foreach="answers" t-as="answer" t-att-href="'/my/school/forms/%s' % answer.id"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="fw-semibold" t-out="answer.form_id.name"/>
                        <small class="text-muted">
                            <t t-out="answer.student_id.name"/> · answer by
                            <span t-field="answer.form_id.deadline"/>
                        </small>
                    </div>
                    <span t-if="answer.decision == 'accepted'" class="badge text-bg-success">Authorised</span>
                    <span t-elif="answer.decision == 'refused'" class="badge text-bg-danger">Refused</span>
                    <span t-elif="answer.form_id.state == 'closed'" class="badge text-bg-secondary">Closed</span>
                    <span t-else="" class="badge text-bg-warning">To answer</span>
                </a>
            </div>
        </t>
    </template>

    <template id="portal_school_form" name="School: one authorisation">
        <t t-call="portal.frontend_layout">
            <t t-set="additional_title" t-value="form.name"/>
            <div class="container py-4" style="max-width: 760px;">
                <small class="text-muted">
                    <t t-out="form.school_id.name"/> · <t t-out="answer.student_id.name"/>
                </small>
                <h2 class="mt-1" t-out="form.name"/>
                <p class="text-muted small">
                    <t t-if="form.event_date">Date: <span t-field="form.event_date"/> · </t>
                    Answer by <span t-field="form.deadline"/>
                </p>
                <div class="mb-4" t-out="form.body_html"/>
                <div t-if="error" class="alert alert-warning">
                    This answer could not be recorded: you may already have answered, or the
                    authorisation is closed. Contact the school office if needed.
                </div>
                <t t-if="answer.decision == 'pending' and form.state == 'sent'">
                    <form method="post" t-att-action="action" class="d-flex gap-2 flex-wrap">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" name="decision" value="accepted" class="btn btn-success">
                            <i class="fa fa-check me-1"/>I authorise
                        </button>
                        <button type="submit" name="decision" value="refused" class="btn btn-outline-danger">
                            <i class="fa fa-times me-1"/>I refuse
                        </button>
                    </form>
                    <p class="text-muted small mt-3">
                        Your answer is final and dated. To change it afterwards, contact the school office.
                    </p>
                </t>
                <div t-elif="answer.decision == 'accepted'" class="alert alert-success">
                    You authorised on <span t-field="answer.answered_on" t-options="{'widget': 'datetime', 'tz_name': (form.company_id.partner_id.tz or 'America/Toronto')}"/>.
                </div>
                <div t-elif="answer.decision == 'refused'" class="alert alert-danger">
                    You refused on <span t-field="answer.answered_on" t-options="{'widget': 'datetime', 'tz_name': (form.company_id.partner_id.tz or 'America/Toronto')}"/>.
                </div>
                <div t-else="" class="alert alert-secondary">This authorisation is closed.</div>
            </div>
        </t>
    </template>
</odoo>
