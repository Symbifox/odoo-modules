<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Cartes sur la page d'accueil du portail. -->
        <template id="portal_my_home_property" name="Copropriété : accueil du portail"
                  inherit_id="portal.portal_my_home" priority="40">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/bf_property_portal/static/description/icon.png'"/>
                    <t t-set="title">Ma copropriété</t>
                    <t t-set="text">Mes fractions, les annonces et les documents du syndicat</t>
                    <t t-set="url" t-value="'/my/property'"/>
                    <t t-set="placeholder_count" t-value="'property_unit_count'"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/bf_property_portal/static/description/icon.png'"/>
                    <t t-set="title">Mes demandes d'entretien</t>
                    <t t-set="text">Signaler un problème et suivre ce qu'il devient</t>
                    <t t-set="url" t-value="'/my/property/requests'"/>
                    <t t-set="placeholder_count" t-value="'property_request_count'"/>
                </t>
            </xpath>
        </template>

        <!-- Accueil « Ma copropriété ». -->
        <template id="portal_property_home" name="Ma copropriété">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Ma copropriété</t>
                </t>

                <t t-if="not roles">
                    <div class="alert alert-info" role="status">
                        Aucune fraction n'est rattachée à votre compte. Le syndicat
                        inscrit les copropriétaires au registre de l'article 1070
                        du Code civil, et les locataires y figurent par leur nom et
                        leur adresse.
                    </div>
                </t>

                <t t-foreach="roles.items()" t-as="entry">
                    <t t-set="syndicat" t-value="entry[0]"/>
                    <t t-set="role" t-value="entry[1]"/>
                    <div class="card mb-3">
                        <div class="card-header">
                            <span t-field="syndicat.name"/>
                            <span t-if="role['owner']" class="badge text-bg-primary ms-2">Copropriétaire</span>
                            <span t-if="role['occupant']" class="badge text-bg-secondary ms-2">Occupant</span>
                        </div>
                        <div class="card-body">
                            <t t-set="mine" t-value="(owned_units | occupied_units).filtered(lambda u: u.syndicat_id == syndicat)"/>
                            <table class="table table-sm mb-3">
                                <thead>
                                    <tr>
                                        <th>Fraction</th>
                                        <th>Immeuble</th>
                                        <th class="text-end">Quote-part</th>
                                        <th>À quel titre</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="mine" t-as="unit">
                                        <td><span t-field="unit.name"/></td>
                                        <td><span t-field="unit.building_id.name"/></td>
                                        <td class="text-end"><span t-field="unit.quote_part"/></td>
                                        <td>
                                            <t t-if="unit in owned_units">Copropriétaire</t>
                                            <t t-elif="unit in occupied_units">Occupant</t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <t t-if="syndicat.portal_contact_name or syndicat.portal_contact_email or syndicat.portal_contact_phone">
                                <h6>Pour joindre le syndicat</h6>
                                <p class="mb-1">
                                    <span t-if="syndicat.portal_contact_name" t-field="syndicat.portal_contact_name"/>
                                    <span t-if="syndicat.portal_contact_email">
                                        <br/><a t-attf-href="mailto:{{ syndicat.portal_contact_email }}"
                                                t-field="syndicat.portal_contact_email"/>
                                    </span>
                                    <span t-if="syndicat.portal_contact_phone">
                                        <br/><span t-field="syndicat.portal_contact_phone"/>
                                    </span>
                                </p>
                                <p t-if="syndicat.portal_contact_note" class="text-muted small mb-0"
                                   style="white-space: pre-line;"
                                   t-field="syndicat.portal_contact_note"/>
                            </t>
                        </div>
                    </div>
                </t>

                <div class="d-flex gap-2">
                    <a class="btn btn-secondary" href="/my/property/announcements">Toutes les annonces</a>
                    <a class="btn btn-secondary" href="/my/property/documents">Les documents</a>
                    <a class="btn btn-secondary" href="/my/property/requests">Mes demandes d'entretien</a>
                </div>
            </t>
        </template>

        <!-- Annonces. -->
        <template id="portal_property_announcements" name="Annonces de l'immeuble">
            <t t-call="portal.portal_layout">
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Annonces</t>
                </t>
                <t t-if="not announcements">
                    <div class="alert alert-info" role="status">Aucune annonce en ce moment.</div>
                </t>
                <div t-foreach="announcements" t-as="announcement" class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>
                            <i t-if="announcement.pinned" class="fa fa-thumb-tack me-2" title="Épinglée"/>
                            <span t-field="announcement.name"/>
                        </span>
                        <small class="text-muted">
                            <span t-field="announcement.syndicat_id.name"/>
                            <span t-if="announcement.building_id"> · <span t-field="announcement.building_id.name"/></span>
                            · <span t-field="announcement.date_start"/>
                        </small>
                    </div>
                    <div class="card-body" t-field="announcement.body"/>
                </div>
            </t>
        </template>

        <!-- Documents. -->
        <template id="portal_property_documents" name="Documents du syndicat">
            <t t-call="portal.portal_layout">
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Documents</t>
                </t>

                <t t-if="register_items">
                    <div class="alert alert-secondary" role="note">
                        Certaines de ces pièces font partie du registre du syndicat
                        (article 1070 du Code civil). L'article 1070.1 prévoit que
                        le registre se consulte en présence d'un administrateur ou
                        d'une personne désignée, à des heures raisonnables et selon
                        les modalités du règlement de l'immeuble, et que la copie
                        s'obtient moyennant des frais raisonnables. Le syndicat a
                        choisi de les déposer ici, ce qui va au-delà de ce que
                        l'article demande.
                    </div>
                </t>

                <t t-if="not documents">
                    <div class="alert alert-info" role="status">Aucun document publié.</div>
                </t>
                <table t-if="documents" class="table table-sm">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>Nature</th>
                            <th>Date</th>
                            <th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="documents" t-as="document">
                            <td>
                                <span t-field="document.name"/>
                                <span t-if="document.is_register_item"
                                      class="badge text-bg-light ms-2"
                                      title="Pièce du registre, article 1070 C.c.Q.">Registre</span>
                            </td>
                            <td><span t-field="document.category"/></td>
                            <td><span t-field="document.date"/></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-secondary"
                                   t-attf-href="/my/property/document/{{ document.id }}">Télécharger</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </template>


        <!-- Demandes d'entretien. -->
        <template id="portal_property_requests" name="Mes demandes d'entretien">
            <t t-call="portal.portal_layout">
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Mes demandes d'entretien</t>
                </t>

                <div t-if="request.params.get('error') == 'unit'" class="alert alert-warning">
                    Indiquez la fraction visée : votre compte en touche plus d'une.
                </div>
                <div t-if="request.params.get('error') == 'description'" class="alert alert-warning">
                    Décrivez ce que vous constatez : c'est le corps de la demande.
                </div>

                <t t-if="not form_values['units']">
                    <div class="alert alert-info" role="status">
                        Aucune fraction n'est rattachée à votre compte, alors il n'y
                        a personne à qui adresser une demande. Le syndicat inscrit
                        les copropriétaires au registre de l'article 1070 du Code
                        civil, et les locataires y figurent par leur nom et leur
                        adresse.
                    </div>
                </t>

                <t t-if="form_values['units']">
                    <div class="card mb-4">
                        <div class="card-header">Signaler quelque chose</div>
                        <div class="card-body">
                            <form action="/my/property/requests/new" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="unit_id">Fraction visée</label>
                                        <select class="form-select" name="unit_id" id="unit_id">
                                            <option value="">Aucune en particulier (hall, ascenseur, terrain)</option>
                                            <option t-foreach="form_values['units']" t-as="unit"
                                                    t-att-value="unit.id"
                                                    t-esc="unit.display_name"/>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="category">Catégorie</label>
                                        <select class="form-select" name="category" id="category">
                                            <option t-foreach="form_values['categories']" t-as="item"
                                                    t-att-value="item[0]" t-esc="item[1]"/>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="portion_type">Partie visée</label>
                                    <select class="form-select" name="portion_type" id="portion_type">
                                        <option t-foreach="form_values['portions']" t-as="item"
                                                t-att-value="item[0]" t-esc="item[1]"/>
                                    </select>
                                    <div class="form-text">
                                        Si vous hésitez, laissez « À déterminer » : c'est au
                                        syndicat de qualifier la partie, et cela décide qui
                                        porte la dépense (article 1064 du Code civil).
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="description">Ce que vous constatez</label>
                                    <textarea class="form-control" name="description" id="description"
                                              rows="4" required="required"
                                              placeholder="Où, depuis quand, ce que vous voyez ou entendez."/>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox"
                                           name="is_safety" id="is_safety" value="1"/>
                                    <label class="form-check-label" for="is_safety">
                                        Cela touche la sécurité des personnes ou la conservation
                                        de l'immeuble
                                    </label>
                                </div>
                                <button type="submit" class="btn btn-primary">Envoyer la demande</button>
                            </form>
                        </div>
                    </div>
                </t>

                <t t-if="not requests">
                    <div class="alert alert-info" role="status">Aucune demande de votre part.</div>
                </t>
                <div t-foreach="requests" t-as="req" class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>
                            <span t-field="req.name"/>
                            <span t-if="req.is_safety" class="badge text-bg-danger ms-2">Sécurité</span>
                        </span>
                        <span>
                            <span class="badge text-bg-secondary" t-field="req.state"/>
                            <small class="text-muted ms-2"><span t-field="req.date_submitted"/></small>
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="mb-2" style="white-space: pre-line;" t-field="req.description"/>
                        <p class="text-muted small mb-1">
                            <span t-field="req.category"/>
                            <span t-if="req.unit_id"> · <span t-field="req.unit_id.name"/></span>
                            · <span t-field="req.cost_bearer"/>
                        </p>
                        <t t-if="req.resolution">
                            <hr/>
                            <p class="mb-0"><strong>Ce qui a été fait : </strong>
                                <span t-field="req.resolution"/></p>
                        </t>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
