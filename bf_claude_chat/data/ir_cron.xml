<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Un tour dont le fil est mort avec son processus (travailleur recyclé,
         conteneur redémarré) reste vivant chez le pont une heure : ce cron s'y
         rattache quand aucun écran ne l'a fait, et clôt les tours d'avant ce
         mécanisme restés « en cours ». -->
    <record id="ir_cron_recover_stale_turns" model="ir.cron">
        <field name="name">Gen: resume turns left without a worker</field>
        <field name="model_id" ref="model_claude_chat_message"/>
        <field name="state">code</field>
        <field name="code">model._recover_stale_turns()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="priority">5</field>
    </record>
    <!-- Une conversation qui a grandi change souvent de sujet ;
         son titre suit, sauf si la personne l'a nommée à la main. -->
    <record id="ir_cron_retitle_sessions" model="ir.cron">
        <field name="name">Gen: rename conversations that have grown</field>
        <field name="model_id" ref="model_claude_chat_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_retitle_sessions()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="priority">20</field>
    </record>
    <!-- Une conversation sans nouvelle depuis deux jours est
         relancée (message dans la conversation, note interne sur la fiche) ;
         rien n'est jamais archivé ici. Sans effet tant que le réglage
         « Conversations aim to close » est éteint. -->
    <record id="ir_cron_closure_followup" model="ir.cron">
        <field name="name">Gen: follow up on conversations left without news</field>
        <field name="model_id" ref="model_claude_chat_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_closure_followup()</field>
        <field name="user_id" ref="base.user_root"/>
        <!-- 7 h UTC : 3 h à Montréal, loin de toute conversation en cours. -->
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="priority">20</field>
    </record>
</odoo>
