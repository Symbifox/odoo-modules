<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Titre ou élément associé, pour toute la liste -->
    <t t-name="bf_claude_chat.ListModeSwitch">
        <div class="btn-group btn-group-sm w-100 mt-2 bf-gen-list-mode" role="group">
            <button type="button"
                    t-att-class="'btn ' + (state.listMode === 'title' ? 'btn-secondary' : 'btn-outline-secondary')"
                    t-on-click.stop="() => this.onSetListMode('title')">Titles</button>
            <button type="button"
                    t-att-class="'btn ' + (state.listMode === 'element' ? 'btn-secondary' : 'btn-outline-secondary')"
                    t-on-click.stop="() => this.onSetListMode('element')">Records</button>
        </div>
    </t>

    <!-- Ce qui attend quelque chose (à fermer, t'attend, dort, relancé) -->
    <t t-name="bf_claude_chat.ToFollowSwitch">
        <button t-if="state.closureEnabled" type="button"
                t-att-class="'btn btn-sm w-100 mt-1 bf-gen-to-follow ' + (state.toFollow ? 'btn-secondary' : 'btn-outline-secondary')"
                t-on-click.stop="onToggleToFollow">
            <i class="fa fa-bell-o me-1"/>To follow
        </button>
    </t>

    <!-- La proposition de fermeture, ou de rattachement, sous la conversation -->
    <t t-name="bf_claude_chat.ClosureBar">
        <t t-set="closureBar" t-value="closureBarKind()"/>
        <div t-if="closureBar === 'archive'"
             class="bf-gen-closure-bar d-flex align-items-center gap-2 px-3 py-2 border-top">
            <span t-if="state.closure.state === 'done'" aria-hidden="true">📥</span>
            <i t-else="" class="fa fa-moon-o text-muted"/>
            <div class="flex-grow-1 small overflow-hidden">
                <!-- Par t-esc : un texte de gabarit voit ses blancs repliés par
                     OWL (\s+), espace insécable comprise, et le « ? » tombait seul
                     à la ligne. -->
                <div class="fw-semibold" t-esc="closureQuestion()"/>
                <div t-if="state.closure.reason" class="text-muted text-truncate"
                     t-att-title="state.closure.reason" t-esc="state.closure.reason"/>
            </div>
            <button class="btn btn-sm btn-primary text-nowrap" t-on-click.stop="onClosureArchive">Archive</button>
            <button class="btn btn-sm btn-secondary text-nowrap" t-on-click.stop="onClosureLater">Not yet</button>
        </div>
        <div t-elif="closureBar === 'link'"
             class="bf-gen-closure-bar d-flex align-items-center gap-2 px-3 py-2 border-top">
            <i class="fa fa-link text-muted"/>
            <div class="flex-grow-1 small overflow-hidden">
                <div class="fw-semibold" t-esc="closureQuestion()"/>
                <div class="text-muted text-truncate" t-att-title="state.closure.linkTask.name"
                     t-esc="state.closure.linkTask.name"/>
            </div>
            <button class="btn btn-sm btn-primary text-nowrap" t-on-click.stop="() => this.onLinkAnswer(true)">Link it</button>
            <button class="btn btn-sm btn-secondary text-nowrap" t-on-click.stop="() => this.onLinkAnswer(false)">No</button>
        </div>
    </t>

    <!-- L'élément associé en pastille, lien vers la fiche -->
    <t t-name="bf_claude_chat.RecordPill">
        <a t-if="recordHref(session)"
           t-att-href="recordHref(session)"
           class="bf-gen-record-pill text-truncate"
           t-att-title="session.res_label"
           t-on-click="(ev) => this.onOpenRecord(ev, session)"
           t-on-auxclick.stop="() => {}"
           t-esc="session.res_label"/>
    </t>

    <!-- Main chat action layout (full page) -->
    <t t-name="bf_claude_chat.ChatAction">
        <div class="bf-chat-container d-flex h-100">
            <!-- Sidebar -->
            <div class="bf-chat-sidebar d-flex flex-column border-end">
                <div class="p-3 border-bottom">
                    <button class="btn btn-primary w-100" t-on-click="onNewChat">
                        <i class="fa fa-plus me-1"/> New Chat
                    </button>
                    <t t-call="bf_claude_chat.ListModeSwitch"/>
                    <t t-call="bf_claude_chat.ToFollowSwitch"/>
                </div>
                <div class="bf-chat-session-list flex-grow-1 overflow-auto">
                    <t t-foreach="state.sessions" t-as="session" t-key="session.id">
                        <div t-att-class="'bf-chat-session-item p-3 border-bottom cursor-pointer '
                                         + (state.activeSessionId === session.id ? 'active' : '')"
                             t-on-click="() => this.onSelectSession(session.id)">
                            <div class="d-flex justify-content-between align-items-start">
                                <!-- Inline rename input -->
                                <t t-if="state.editingSessionId === session.id">
                                    <input type="text"
                                           class="form-control form-control-sm bf-chat-rename-input flex-grow-1"
                                           t-att-value="state.editingName"
                                           t-on-input="(ev) => this.state.editingName = ev.target.value"
                                           t-on-keydown="onRenameKeydown"
                                           t-on-blur="onConfirmRename"
                                           t-on-click.stop="() => {}"
                                           t-ref="renameInput"/>
                                </t>
                                <t t-else="">
                                    <t t-set="label" t-value="sessionLabel(session)"/>
                                    <span t-if="closureInbox(session)" class="me-1 bf-gen-closure-icon"
                                          t-att-title="closureIconTitle(session)">📥</span>
                                    <i t-elif="closureIcon(session)"
                                       t-att-class="'fa me-1 mt-1 bf-gen-closure-icon ' + closureIcon(session)"
                                       t-att-title="closureIconTitle(session)"/>
                                    <span t-att-class="'bf-chat-session-title text-truncate flex-grow-1'
                                                       + (label.dim ? ' bf-gen-label-dim' : '')"
                                          t-att-title="label.text"
                                          t-on-dblclick.stop="() => this.onStartRename(session)"
                                          t-esc="label.text"/>
                                </t>
                                <div class="d-flex ms-2 bf-chat-session-actions">
                                    <button t-if="session.res_label"
                                            class="btn btn-link btn-sm text-muted p-0 me-1 bf-chat-action-btn"
                                            t-on-click.stop="() => this.onFlipRow(session)"
                                            title="Switch between title and linked record">
                                        <i class="fa fa-exchange"/>
                                    </button>
                                    <button class="btn btn-link btn-sm text-muted p-0 bf-chat-action-btn"
                                            t-on-click.stop="() => this.onStartRename(session)"
                                            title="Rename">
                                        <i class="fa fa-pencil"/>
                                    </button>
                                    <button class="btn btn-link btn-sm text-muted p-0 ms-1 bf-chat-action-btn"
                                            t-on-click.stop="() => this.onDeleteSession(session.id)"
                                            title="Archive">
                                        <i class="fa fa-archive"/>
                                    </button>
                                </div>
                            </div>
                            <div class="d-flex align-items-center bf-gen-session-meta">
                                <small class="text-muted flex-shrink-0" t-esc="formatDate(session.write_date)"/>
                                <t t-call="bf_claude_chat.RecordPill"/>
                            </div>
                        </div>
                    </t>
                    <div t-if="state.sessions.length === 0" class="p-3 text-muted text-center">
                        No conversations yet
                    </div>
                </div>
            </div>

            <!-- Chat panel -->
            <div class="bf-chat-panel d-flex flex-column flex-grow-1">
                <t t-if="state.activeSessionId">
                    <!-- Chat header with share button -->
                    <div class="bf-chat-panel-header d-flex align-items-center justify-content-end px-3 py-2 border-bottom"
                         t-if="state.activeSessionId > 0">
                        <button class="btn btn-sm btn-link text-muted p-1" title="Share to task"
                                t-on-click="onToggleShare">
                            <i class="fa fa-share-alt"/>
                        </button>
                    </div>

                    <!-- Share panel (full-page) -->
                    <div t-if="state.shareOpen" class="bf-share-panel border-bottom px-3 py-2">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa fa-share-alt text-muted"/>
                            <span class="fw-semibold small">Share to task</span>
                            <button class="btn btn-sm btn-link text-muted p-0 ms-auto"
                                    t-on-click="onToggleShare">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <input type="text" class="form-control form-control-sm bf-share-search-input"
                               placeholder="Search tasks..."
                               t-att-value="state.shareQuery"
                               t-on-input="onShareSearchInput"/>
                        <div t-if="state.shareTasks.length > 0" class="bf-share-task-list mt-1">
                            <t t-foreach="state.shareTasks" t-as="task" t-key="task.id">
                                <div class="bf-share-task-item px-2 py-1 cursor-pointer rounded"
                                     t-on-click="() => this.onShareToTask(task.id)">
                                    <small t-esc="task.name"/>
                                </div>
                            </t>
                        </div>
                        <div t-if="state.shareLoading" class="text-muted small mt-1">
                            <i class="fa fa-spinner fa-spin me-1"/>Sharing...
                        </div>
                    </div>

                    <!-- Messages area -->
                    <div class="bf-chat-messages flex-grow-1 overflow-auto p-3"
                         t-ref="messagesContainer">
                        <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                            <div t-att-class="'bf-chat-message mb-3 d-flex align-items-end gap-2 '
                                             + (msg.role === 'user' ? 'justify-content-end' : 'justify-content-start')">
                                <!-- Avatar assistant (left) -->
                                <div t-if="msg.role === 'assistant'"
                                     class="bf-chat-avatar bf-chat-avatar-assistant">
                                    <i class="fa fa-robot"/>
                                </div>
                                <!-- Bubble -->
                                <div t-att-class="'bf-chat-bubble '
                                                 + (msg.role === 'user' ? 'bf-chat-bubble-user' : 'bf-chat-bubble-assistant')
                                                 + (msg.followup ? ' bf-gen-followup' : '')">
                                    <t t-if="msg.role === 'assistant'">
                                        <div t-if="msg.notice" class="bf-stream-notice">
                                            <i class="fa fa-refresh me-1"/><t t-esc="msg.notice"/>
                                        </div>
                                        <GenSteps t-if="msg.tools and msg.tools.length" steps="msg.tools" live="!!msg.streaming and msg.phase !== 'tool'"/>
                                        <div t-if="msg.content"
                                             t-att-class="'bf-chat-content' + (msg.streaming ? ' bf-streaming' : '')"
                                             t-out="renderMarkdown(msg.content)"/>
                                        <GenWaitLine t-if="msg.streaming" msg="msg"/>
                                        <div t-if="msg.reconnecting" class="bf-stream-notice">
                                            <i class="fa fa-plug me-1"/>Connection lost. Picking the thread back up…
                                        </div>
                                        <div t-if="msg.interrupted" class="bf-stream-interrupted">
                                            <i class="fa fa-exclamation-circle me-1"/>Answer interrupted. Ask me to continue.
                                        </div>
                                        <!-- Même vocabulaire que le Cockpit et que Comms : jetons NEUFS
                                             en tête, contexte relu à part. Le total additionne la
                                             relecture et se lit très mal. -->
                                        <div t-if="msg.usageLabel" class="bf-chat-usage"
                                             t-att-title="msg.usageTitle">
                                            <t t-esc="msg.usageLabel"/>
                                        </div>
                                    </t>
                                    <div t-else=""
                                         class="bf-chat-content">
                                        <t t-esc="msg.content"/>
                                        <div t-if="msg.queued" class="bf-chat-queued">
                                            <i class="fa fa-hourglass-half me-1"/>Queued: Gen will read this when it comes up for air.
                                        </div>
                                    </div>
                                </div>
                                <!-- Avatar user (right) -->
                                <div t-if="msg.role === 'user'"
                                     class="bf-chat-avatar bf-chat-avatar-user">
                                    <i class="fa fa-user"/>
                                </div>
                            </div>
                        </t>
                        <!-- Thinking indicator (buffered path only; streaming shows it in-bubble) -->
                        <div t-if="state.isThinking and !state.streamingActive" class="bf-chat-message mb-3 d-flex align-items-end gap-2 justify-content-start">
                            <div class="bf-chat-avatar bf-chat-avatar-assistant">
                                <i class="fa fa-robot"/>
                            </div>
                            <div class="bf-chat-bubble bf-chat-bubble-assistant">
                                <div class="bf-chat-thinking">
                                    <span/><span/><span/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-call="bf_claude_chat.ClosureBar"/>

                    <!-- Input area -->
                    <div class="bf-chat-input-area border-top p-3">
                        <div class="d-flex gap-2">
                            <textarea class="form-control bf-chat-input"
                                      t-ref="chatInput"
                                      t-att-disabled="state.isThinking and !state.streamingActive"
                                      t-on-keydown="onInputKeydown"
                                      rows="1"
                                      placeholder="Type your message..."/>
                            <button t-if="state.streamingActive"
                                    class="btn btn-outline-danger bf-chat-send-btn"
                                    t-on-click="onStop" title="Arrêter">
                                <i class="fa fa-stop"/>
                            </button>
                            <button t-else=""
                                    class="btn btn-primary bf-chat-send-btn"
                                    t-att-disabled="state.isThinking and !state.streamingActive"
                                    t-on-click="onSend">
                                <i t-att-class="state.isThinking ? 'fa fa-spinner fa-spin' : 'fa fa-paper-plane'"/>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- Empty state -->
                <t t-else="">
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                        <i class="fa fa-comments-o fa-3x mb-3 opacity-50"/>
                        <h4>Gen</h4>
                        <p>Start a new chat or select an existing one</p>
                        <button class="btn btn-primary" t-on-click="onNewChat">
                            <i class="fa fa-plus me-1"/> New Chat
                        </button>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <!-- Systray: button + side panel -->
    <t t-name="bf_claude_chat.SystrayItem">
        <!-- Systray button in navbar -->
        <button class="btn d-flex align-items-center gap-1" title="Gen"
                t-on-click="onTogglePanel">
            <i class="fa fa-commenting"/>
            <span class="d-none d-lg-inline">Gen</span>
        </button>

        <!-- Side panel (slides in from right) -->
        <t t-if="state.open">
            <div class="bf-panel-overlay" t-on-click="onClickOverlay" t-ref="panelOverlay">
                <div class="bf-side-panel" t-on-click.stop="() => {}">
                    <!-- Header bar -->
                    <div class="bf-side-panel-header d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                        <div class="d-flex align-items-center gap-2 flex-grow-1 overflow-hidden">
                            <i class="fa fa-commenting text-primary"/>
                            <span t-if="showChat" class="fw-semibold text-truncate"
                                  t-esc="activeSessionName"/>
                            <span t-else="" class="fw-semibold">Gen</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button t-if="showChat and state.activeSessionId > 0"
                                    class="btn btn-sm btn-link p-1" title="Share to task"
                                    t-on-click.stop="onToggleShare">
                                <i class="fa fa-share-alt"/>
                            </button>
                            <button class="btn btn-sm btn-link p-1" title="New Chat"
                                    t-on-click.stop="onNewChat">
                                <i class="fa fa-plus"/>
                            </button>
                            <button class="btn btn-sm btn-link p-1" title="Open full page"
                                    t-on-click.stop="onOpenFullPage">
                                <i class="fa fa-expand"/>
                            </button>
                            <button class="btn btn-sm btn-link p-1" title="Close"
                                    t-on-click.stop="onClosePanel">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>

                    <!-- Context badge (always visible when context is available, for new sessions) -->
                    <t t-if="activeContext and state.activeSessionId === -1">
                        <div class="px-3 pt-2">
                            <div class="bf-context-badge">
                                <i class="fa fa-map-marker"/>
                                <span t-esc="contextLabel"/>
                                <i class="fa fa-times bf-context-dismiss"
                                   t-on-click.stop="onDismissContext"/>
                            </div>
                        </div>
                    </t>

                    <!-- Share panel -->
                    <div t-if="state.shareOpen" class="bf-share-panel border-bottom px-3 py-2">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa fa-share-alt text-muted small"/>
                            <span class="fw-semibold" style="font-size:0.8rem">Share to task</span>
                            <button class="btn btn-sm btn-link text-muted p-0 ms-auto"
                                    t-on-click.stop="onToggleShare">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <input type="text" class="form-control form-control-sm bf-share-search-input"
                               placeholder="Search tasks..."
                               t-att-value="state.shareQuery"
                               t-on-input.stop="onShareSearchInput"
                               t-on-click.stop="() => {}"/>
                        <div t-if="state.shareTasks.length > 0" class="bf-share-task-list mt-1">
                            <t t-foreach="state.shareTasks" t-as="task" t-key="task.id">
                                <div class="bf-share-task-item px-2 py-1 cursor-pointer rounded"
                                     t-on-click.stop="() => this.onShareToTask(task.id)">
                                    <small t-esc="task.name"/>
                                </div>
                            </t>
                        </div>
                        <div t-if="state.shareLoading" class="text-muted small mt-1">
                            <i class="fa fa-spinner fa-spin me-1"/>Sharing...
                        </div>
                    </div>

                    <div class="d-flex bf-side-panel-body">
                        <!-- Mini session list -->
                        <div class="bf-side-panel-sessions border-end">
                            <div class="px-2 py-1 border-bottom">
                                <t t-call="bf_claude_chat.ListModeSwitch"/>
                                <t t-call="bf_claude_chat.ToFollowSwitch"/>
                            </div>
                            <t t-foreach="state.sessions" t-as="session" t-key="session.id">
                                <div t-att-class="'bf-side-panel-session-item px-2 py-1 cursor-pointer text-truncate '
                                                 + (state.activeSessionId === session.id ? 'active' : '')"
                                     t-on-click.stop="() => this.onSelectSession(session.id)"
                                     t-att-title="sessionLabel(session).text">
                                    <t t-if="state.editingSessionId === session.id">
                                        <input type="text"
                                               class="form-control form-control-sm bf-side-panel-rename-input"
                                               t-att-value="state.editingName"
                                               t-on-input="(ev) => this.state.editingName = ev.target.value"
                                               t-on-keydown="onRenameKeydown"
                                               t-on-blur="onConfirmRename"
                                               t-on-click.stop="() => {}"/>
                                    </t>
                                    <t t-else="">
                                        <t t-set="label" t-value="sessionLabel(session)"/>
                                        <div class="d-flex align-items-center">
                                            <span t-if="closureInbox(session)" class="me-1 bf-gen-closure-icon"
                                                  t-att-title="closureIconTitle(session)">📥</span>
                                            <i t-elif="closureIcon(session)"
                                               t-att-class="'fa me-1 bf-gen-closure-icon ' + closureIcon(session)"
                                               t-att-title="closureIconTitle(session)"/>
                                            <small t-att-class="'text-truncate flex-grow-1'
                                                                + (label.dim ? ' bf-gen-label-dim' : '')"
                                                   t-on-dblclick.stop="() => this.onStartRename(session)"
                                                   t-esc="label.text"/>
                                            <button t-if="session.res_label"
                                                    class="btn btn-link btn-sm text-muted p-0 ms-1 bf-side-panel-flip"
                                                    t-on-click.stop="() => this.onFlipRow(session)"
                                                    title="Switch between title and linked record">
                                                <i class="fa fa-exchange"/>
                                            </button>
                                        </div>
                                        <div t-if="recordHref(session)" class="d-flex bf-gen-session-meta">
                                            <t t-call="bf_claude_chat.RecordPill"/>
                                        </div>
                                    </t>
                                </div>
                            </t>
                            <div t-if="state.sessions.length === 0"
                                 class="text-muted text-center small p-2">
                                <t t-if="hasFilteredContext">No chats for this record</t>
                                <t t-else="">No chats</t>
                            </div>
                        </div>

                        <!-- Chat area -->
                        <div class="bf-side-panel-chat-main d-flex flex-column flex-grow-1">
                            <t t-if="showChat">
                                <!-- Messages -->
                                <div class="bf-side-panel-messages flex-grow-1 overflow-auto p-2"
                                     t-ref="systrayMessages">
                                    <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                                        <div t-att-class="'bf-side-panel-msg mb-2 d-flex align-items-end gap-1 '
                                                         + (msg.role === 'user' ? 'justify-content-end' : 'justify-content-start')">
                                            <!-- Avatar assistant (left) -->
                                            <div t-if="msg.role === 'assistant'"
                                                 class="bf-side-panel-avatar bf-chat-avatar-assistant">
                                                <i class="fa fa-robot"/>
                                            </div>
                                            <div t-att-class="'bf-side-panel-bubble px-2 py-1 '
                                                             + (msg.role === 'user' ? 'bf-chat-bubble-user' : 'bf-chat-bubble-assistant')
                                                             + (msg.followup ? ' bf-gen-followup' : '')">
                                                <t t-if="msg.role === 'assistant'">
                                                    <div t-if="msg.notice" class="bf-stream-notice">
                                                        <i class="fa fa-refresh me-1"/><t t-esc="msg.notice"/>
                                                    </div>
                                                    <GenSteps t-if="msg.tools and msg.tools.length" steps="msg.tools" live="!!msg.streaming and msg.phase !== 'tool'"/>
                                                    <div t-if="msg.content"
                                                         t-att-class="'bf-chat-content' + (msg.streaming ? ' bf-streaming' : '')"
                                                         t-out="renderMarkdown(msg.content)"/>
                                                    <GenWaitLine t-if="msg.streaming" msg="msg"/>
                                                    <div t-if="msg.reconnecting" class="bf-stream-notice">
                                                        <i class="fa fa-plug me-1"/>Connection lost. Picking the thread back up…
                                                    </div>
                                                    <div t-if="msg.interrupted" class="bf-stream-interrupted">
                                                        <i class="fa fa-exclamation-circle me-1"/>Answer interrupted.
                                                    </div>
                                                    <!-- Même vocabulaire que le Cockpit et que Comms : jetons NEUFS
                                                         en tête, contexte relu à part. Le total additionne la
                                                         relecture et se lit très mal. -->
                                                    <div t-if="msg.usageLabel" class="bf-chat-usage"
                                                         t-att-title="msg.usageTitle">
                                                        <t t-esc="msg.usageLabel"/>
                                                    </div>
                                                </t>
                                                <div t-else="">
                                                    <t t-esc="msg.content"/>
                                                    <div t-if="msg.queued" class="bf-chat-queued">
                                                        <i class="fa fa-hourglass-half me-1"/>Queued: Gen will read this when it comes up for air.
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- Avatar user (right) -->
                                            <div t-if="msg.role === 'user'"
                                                 class="bf-side-panel-avatar bf-chat-avatar-user">
                                                <i class="fa fa-user"/>
                                            </div>
                                        </div>
                                    </t>
                                    <!-- Thinking (buffered path only; streaming shows it in-bubble) -->
                                    <div t-if="state.isThinking and !state.streamingActive"
                                         class="bf-side-panel-msg mb-2 d-flex align-items-end gap-1 justify-content-start">
                                        <div class="bf-side-panel-avatar bf-chat-avatar-assistant">
                                            <i class="fa fa-robot"/>
                                        </div>
                                        <div class="bf-side-panel-bubble bf-chat-bubble-assistant px-2 py-1">
                                            <div class="bf-chat-thinking">
                                                <span/><span/><span/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <t t-call="bf_claude_chat.ClosureBar"/>

                                <!-- Input -->
                                <div class="bf-side-panel-input border-top p-2">
                                    <div class="d-flex gap-1">
                                        <textarea class="form-control form-control-sm bf-side-panel-textarea"
                                                  t-ref="systrayInput"
                                                  t-att-disabled="state.isThinking and !state.streamingActive"
                                                  t-on-keydown="onInputKeydown"
                                                  rows="1"
                                                  placeholder="Message Gen..."/>
                                        <button t-if="state.streamingActive"
                                                class="btn btn-outline-danger btn-sm bf-side-panel-send"
                                                t-on-click.stop="onStop" title="Arrêter">
                                            <i class="fa fa-stop"/>
                                        </button>
                                        <button t-else=""
                                                class="btn btn-primary btn-sm bf-side-panel-send"
                                                t-att-disabled="state.isThinking and !state.streamingActive"
                                                t-on-click.stop="onSend">
                                            <i t-att-class="state.isThinking ? 'fa fa-spinner fa-spin' : 'fa fa-paper-plane'"/>
                                        </button>
                                    </div>
                                </div>
                            </t>

                            <!-- Empty state -->
                            <t t-else="">
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted p-3">
                                    <i class="fa fa-comments-o fa-2x mb-2 opacity-50"/>
                                    <small>Start a new chat</small>
                                    <button class="btn btn-primary btn-sm mt-2"
                                            t-on-click.stop="onNewChat">
                                        <i class="fa fa-plus me-1"/> New Chat
                                    </button>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </t>

    <!-- Ce que Gen montre pendant qu'il travaille. -->
    <t t-name="bf_claude_chat.GenWaitLine">
        <div class="bf-gen-wait" role="status" aria-live="polite">
            <span class="bf-chat-thinking bf-gen-wait-dots"><span/><span/><span/></span>
            <span class="bf-gen-wait-label" t-esc="label"/>
            <span class="bf-gen-wait-time" t-esc="elapsed"/>
        </div>
    </t>

    <t t-name="bf_claude_chat.GenSteps">
        <details class="bf-gen-steps">
            <summary><i class="fa fa-list-ul me-1"/><t t-esc="summary"/><span t-if="latest" class="bf-gen-steps-latest"> · <t t-esc="latest"/></span></summary>
            <ol>
                <li t-foreach="props.steps" t-as="step" t-key="step_index"
                    t-att-title="step.detail ? step.label : ''">
                    <t t-esc="step.detail or step.label"/>
                    <ul t-if="step.sub and step.sub.length" class="bf-gen-steps-sub">
                        <li t-foreach="step.sub" t-as="ligne" t-key="ligne_index"
                            t-esc="ligne"/>
                    </ul>
                </li>
            </ol>
        </details>
    </t>

</templates>
