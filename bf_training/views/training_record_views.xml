<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_record_list" model="ir.ui.view">
        <field name="name">bf.training.record.list</field>
        <field name="model">bf.training.record</field>
        <field name="arch" type="xml">
            <list string="Réalisations"
                  decoration-danger="expiry_state == 'expired'"
                  decoration-warning="expiry_state == 'expiring'"
                  decoration-muted="state == 'cancelled'">
                <field name="date_done"/>
                <field name="employee_id"/>
                <field name="activity_id"/>
                <field name="category_id" optional="hide"/>
                <field name="mode" optional="hide"/>
                <field name="hours" sum="Heures"/>
                <field name="total_cost" sum="Coût" optional="show" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date_expiry" optional="show"/>
                <field name="expiry_state" widget="badge"
                       decoration-success="expiry_state == 'valid'"
                       decoration-warning="expiry_state == 'expiring'"
                       decoration-danger="expiry_state == 'expired'"/>
                <field name="content_version" optional="hide"/>
                <field name="is_outdated" widget="boolean_toggle" optional="hide" readonly="1"/>
                <field name="is_complete" widget="boolean_toggle" optional="show" readonly="1"/>
                <field name="missing_info" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>
    <record id="view_training_record_form" model="ir.ui.view">
        <field name="name">bf.training.record.form</field>
        <field name="model">bf.training.record</field>
        <field name="arch" type="xml">
            <form string="Réalisation">
                <header>
                    <button name="action_confirm" type="object" string="Confirmer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Remettre en brouillon"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Périmée" bg_color="text-bg-danger"
                            invisible="expiry_state != 'expired'"/>
                    <div class="oe_title">
                        <label for="activity_id"/>
                        <h1><field name="activity_id" class="w-100" placeholder="Quelle formation ?"/></h1>
                    </div>
                    <group>
                        <group string="Qui, quand, combien">
                            <field name="employee_id"/>
                            <field name="date_done"/>
                            <field name="hours"/>
                            <field name="mode"/>
                            <field name="category_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="La preuve">
                            <field name="provider_partner_id"/>
                            <field name="certificate_number"/>
                            <field name="date_issued"/>
                            <field name="date_expiry"/>
                            <field name="expiry_state"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="is_complete">
                        Il manque <field name="missing_info" readonly="1" nolabel="1" class="oe_inline"/>.
                        La ligne reste au registre, et elle sort des totaux : ce qui
                        manque ne vaut pas zéro.
                    </div>
                    <group>
                        <group string="Coût">
                            <field name="hourly_cost" widget="monetary"/>
                            <field name="salary_cost" widget="monetary"/>
                            <field name="payroll_charge_rate"/>
                            <field name="payroll_charges" widget="monetary"/>
                            <field name="other_cost" widget="monetary"/>
                            <field name="total_cost" widget="monetary" class="fw-bold"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="is_complete" invisible="1"/>
                        </group>
                        <group string="Encadrement">
                            <field name="plan_id"/>
                            <field name="support_provided"/>
                            <field name="trainer_employee_id"/>
                            <field name="trainer_partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pièces justificatives" name="pieces">
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <div class="text-muted">
                                L'attestation reçue de l'extérieur se range ici. Elle se
                                conserve six ans après la dernière année à laquelle elle
                                se rapporte.
                            </div>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_training_record_search" model="ir.ui.view">
        <field name="name">bf.training.record.search</field>
        <field name="model">bf.training.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="activity_id"/>
                <field name="provider_partner_id"/>
                <field name="certificate_number"/>
                <filter name="confirmees" string="Confirmées" domain="[('state', '=', 'confirmed')]"/>
                <filter name="incompletes" string="Incomplètes" domain="[('is_complete', '=', False)]"/>
                <separator/>
                <filter name="perimees" string="Périmées" domain="[('expiry_state', '=', 'expired')]"/>
                <filter name="expirent" string="Expirent bientôt" domain="[('expiry_state', '=', 'expiring')]"/>
                <separator/>
                <filter name="cette_annee" string="Cette année civile"
                        domain="[('date_done', '&gt;=', (context_today()).strftime('%Y-01-01')),
                                 ('date_done', '&lt;=', (context_today()).strftime('%Y-12-31'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_employee" string="Personne" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_activity" string="Activité" context="{'group_by': 'activity_id'}"/>
                    <filter name="group_category" string="Catégorie" context="{'group_by': 'category_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date_done:year'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_training_record" model="ir.actions.act_window">
        <field name="name">Registre</field>
        <field name="res_model">bf.training.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ouvrir le registre</p>
            <p>Une ligne par formation suivie, avec la vraie date, les heures et la
               pièce. Un renouvellement est une ligne de plus, jamais une ligne
               réécrite.</p>
        </field>
    </record>
</odoo>
