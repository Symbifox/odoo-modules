<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cx_wave_list" model="ir.ui.view">
        <field name="name">bf.cx.wave.list</field>
        <field name="model">bf.cx.wave</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="program_id"/>
                <field name="sent_date"/>
                <field name="invited_count"/>
                <field name="completed_count"/>
                <field name="completion_rate" widget="progressbar"/>
                <field name="program_type" column_invisible="True"/>
                <field name="subject_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="nps_score" string="NPS" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'sent'"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_cx_wave_form" model="ir.ui.view">
        <field name="name">bf.cx.wave.form</field>
        <field name="model">bf.cx.wave</field>
        <field name="arch" type="xml">
            <form string="Sending wave">
                <header>
                    <button name="action_send" type="object" string="Send the invitations"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Send an invitation to each recipient with an email address?"/>
                    <button name="action_send" type="object" string="Invite the new recipients"
                            invisible="state != 'sent'"
                            confirm="Send an invitation to the recipients added since the last sending?"/>
                    <button name="action_remind" type="object" string="Send a reminder"
                            invisible="state != 'sent'"
                            confirm="Resend the invitation to all non-respondents?"/>
                    <button name="action_send_test" type="object" string="Send a test"
                            confirm="Send an invitation to the test contact only? It counts in no statistic and does not feed the register."/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'sent'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_feedback" type="object"
                                class="oe_stat_button" icon="fa-comments-o">
                            <field name="completed_count" widget="statinfo" string="Answers"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-line-chart" disabled="1"
                                invisible="program_type not in ('nps', 'pulse')">
                            <field name="nps_score" widget="statinfo" string="NPS score"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-users" disabled="1"
                                invisible="program_type != 'internal' or not subject_user_id">
                            <div class="o_stat_info">
                                <field name="subject_summary" class="o_stat_text"/>
                                <span class="o_stat_text">360 result</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="program_id" readonly="state != 'draft'"/>
                            <field name="program_type" invisible="1"/>
                            <field name="subject_user_id"
                                   widget="many2one_avatar_user"
                                   invisible="program_type != 'internal'"
                                   readonly="state != 'draft'"/>
                            <field name="campaign_id"/>
                            <field name="deadline"/>
                        </group>
                        <group>
                            <field name="sent_date"/>
                            <field name="reminder_date"/>
                            <field name="invited_count"/>
                            <field name="completion_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recipients" name="recipients">
                            <field name="partner_ids"
                                   readonly="state == 'closed'">
                                <list>
                                    <field name="display_name"/>
                                    <field name="email"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invitations" name="answers">
                            <div class="text-muted mb-2">
                                An invitation that was deleted or never received is resent line by line, on the same answer link: the "Resend" button only affects that person and changes neither the counters nor the collective reminder.
                            </div>
                            <field name="user_input_ids" readonly="1">
                                <list decoration-muted="test_entry">
                                    <field name="partner_id"/>
                                    <field name="email"/>
                                    <field name="test_entry" string="Test" optional="show"/>
                                    <field name="state"/>
                                    <field name="create_date" string="Invited on"/>
                                    <field name="end_datetime" string="Answered on"/>
                                    <button name="action_bf_cx_resend_invite"
                                            type="object"
                                            string="Resend"
                                            icon="fa-paper-plane"
                                            class="btn-link"
                                            invisible="state == 'done'"
                                            confirm="Resend the invitation to this recipient only? The answer link stays the same and no one else is affected."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cx_wave_search" model="ir.ui.view">
        <field name="name">bf.cx.wave.search</field>
        <field name="model">bf.cx.wave</field>
        <field name="arch" type="xml">
            <search string="Waves">
                <field name="name"/>
                <field name="program_id"/>
                <filter string="Drafts" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <field name="subject_user_id"/>
                <group expand="0" string="Group by">
                    <filter string="Program" name="group_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Person reviewed" name="group_subject" context="{'group_by': 'subject_user_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cx_wave" model="ir.actions.act_window">
        <field name="name">Sending waves</field>
        <field name="res_model">bf.cx.wave</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cx_wave_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Launch a first wave
            </p>
            <p>
                Choose a program and a list of contacts: each recipient receives a personal invitation with their own answer token. Non-respondents are reminded automatically.
            </p>
        </field>
    </record>

</odoo>
