<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==========================================================
             The invitation. It asks, it does not inform of a done
             deal: that is the difference between a consent and a
             notice. It also says how to say no, on the same screen.
             ========================================================== -->
        <record id="mail_template_invitation" model="mail.template">
            <field name="name">Celebrations: invitation to answer</field>
            <field name="model_id" ref="model_bf_celebration_profile"/>
            <field name="subject">Would you like your celebration marked?</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6">
    <p>Hello <t t-out="object.employee_id.name or ''"/>,</p>
    <p>We would like to be able to mark celebrations at the office, and for that
       we have to ask you what you think. You decide, and you can change
       your mind whenever you want.</p>
    <p>Four possible answers:</p>
    <ul style="padding-left:18px">
        <li><strong>Yes, with a card</strong> signed by your colleagues</li>
        <li><strong>Yes, but no card</strong>: the date appears, nobody
            organises anything</li>
        <li><strong>No thanks</strong>: we take you out of everything, and we
            will not ask you again</li>
        <li>Do nothing, and nothing happens</li>
    </ul>
    <p>We ask you for the <strong>day and the month</strong> only. Your
       date of birth in the HR record is not read, not copied, not
       shown.</p>
    <p style="margin:24px 0">
        <a t-att-href="'%s/odoo/action-bf_celebrations.action_mon_profil' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url') or '')"
           style="background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block">
            Answer</a>
    </p>
    <p style="color:#6b7280;font-size:12px">Nobody but you sees
       your answer, not even human resources.</p>
</div>
            </field>
        </record>

        <!-- ==========================================================
             The reminder to whoever organises. It carries the link,
             because a reminder with no button produces nothing.
             ========================================================== -->
        <record id="mail_template_rappel_organisateur" model="mail.template">
            <field name="name">Celebrations: reminder to whoever is organising</field>
            <field name="model_id" ref="model_bf_celebration_occasion"/>
            <field name="subject">{{ object.person_name }}: a card to open before {{ object.date }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6">
    <p>Hello,</p>
    <p><t t-out="object.name or ''"/>, le
       <strong t-out="object.date and object.date.strftime('%d/%m/%Y') or ''"/>.</p>
    <p>Nothing is open yet. A wishes board is created in one click, and the
       link is then shared however you like: email, a team channel,
       or a printed QR code.</p>
    <p style="margin:24px 0">
        <a t-att-href="'%s/odoo/bf.celebration.occasion/%s' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url') or '', object.id)"
           style="background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block">
            Open the card</a>
    </p>
    <p style="color:#6b7280;font-size:12px">This person has agreed to have
       their celebration marked. They will see nothing before delivery.</p>
</div>
            </field>
        </record>

        <!-- ========================================================== -->
        <record id="mail_template_tableau_mince" model="mail.template">
            <field name="name">Celebrations: the board is thin</field>
            <field name="model_id" ref="model_bf_celebration_board"/>
            <field name="subject">{{ object.recipient_name }}'s card is still quite empty</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6">
    <p>Hello,</p>
    <p><strong t-out="object.recipient_name or ''"/>'s card goes out soon
       and it carries
       <strong t-out="object.published_post_count"/> message(s).</p>
    <p>The link to share again:</p>
    <p><a t-att-href="object.contribution_url" t-out="object.contribution_url"/></p>
    <p style="color:#6b7280;font-size:12px">An empty card is not delivered:
       it is held and you are told.</p>
</div>
            </field>
        </record>

        <!-- ==========================================================
             The delivery. It goes to the person celebrated, and it is
             the only email in the module addressed to them.
             ========================================================== -->
        <record id="mail_template_livraison" model="mail.template">
            <field name="name">Celebrations: board delivery</field>
            <field name="model_id" ref="model_bf_celebration_board"/>
            <field name="subject">{{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.recipient_email }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6">
    <p>Hello <t t-out="object.recipient_name or ''"/>,</p>
    <p>Your colleagues have written to you.
       <strong t-out="object.published_post_count"/> message(s) are
       waiting for you. Open the envelope.</p>
    <p style="margin:24px 0">
        <a t-att-href="object.recipient_url"
           style="background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block">
            Open the card</a>
    </p>
    <p style="color:#6b7280;font-size:12px">Attached, the card to
       keep: as a PDF, and as a complete page where animated images still
       move. The link will not last forever; those two files
       are yours. From the card you can thank those
       who signed: that link is yours, do not forward it.</p>
</div>
            </field>
        </record>

        <!-- ==========================================================
             The thank-you. It goes out once, to the people invited by email
             and to those who signed while signed in, when the person celebrated
             has written it from their card.
             ========================================================== -->
        <record id="mail_template_merci" model="mail.template">
            <field name="name">Celebrations: the thank-you from the person celebrated</field>
            <field name="model_id" ref="model_bf_celebration_board"/>
            <field name="subject">{{ object.recipient_name }} thanks you</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6">
    <p>Hello,</p>
    <p><strong t-out="object.recipient_name or ''"/> has received their card,
       <t t-out="object.name or ''"/>, and has written a message for those
       who signed it:</p>
    <blockquote style="margin:16px 0;padding:12px 16px;border-left:4px solid #177AA3;background:#F4F6F8" t-out="object.thanks_html"/>
    <p style="margin:24px 0">
        <a t-att-href="object.board_url"
           style="background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block">
            See the card again</a>
    </p>
</div>
            </field>
        </record>

        <!-- ==========================================================
             The invitation to sign. It goes to the signatory groups,
             once per address, never to the person celebrated. The first name
             comes from the context (`cel_invite_nom`), placed by the board at
             the moment of sending.
             ========================================================== -->
        <record id="mail_template_invitation_signataire" model="mail.template">
            <field name="name">Celebrations: invitation to sign</field>
            <field name="model_id" ref="model_bf_celebration_board"/>
            <field name="subject">A card to sign for {{ object.recipient_name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6">
    <p>Hello <t t-out="ctx.get('cel_invite_nom') or ''"/>,</p>
    <p>A group card is open for
       <strong t-out="object.recipient_name or ''"/>:
       <t t-out="object.name or ''"/>.</p>
    <p>A message, a photo, something drawn by hand: what you would have written
       in the paper card. No account is needed.</p>
    <p style="margin:24px 0">
        <a t-att-href="object.contribution_url"
           style="background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block">
            Sign the card</a>
    </p>
    <p t-if="object.delivery_date">The card goes out on
       <strong t-out="format_datetime(object.delivery_date, tz=user.tz or 'UTC', dt_format='long')"/>.</p>
    <p style="color:#6b7280;font-size:12px">The person celebrated sees nothing
       before delivery: keep the surprise for them, and do not forward
       this message to them.</p>
</div>
            </field>
        </record>

    </data>
</odoo>
