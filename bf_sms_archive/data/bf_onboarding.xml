<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Configure SMS Archive</field>
        <field name="description">Fill in the NC paths to watch for SMS/call backups and the purge options.</field>
        <field name="button_text">Open Settings</field>
        <field name="done_text">Settings ready</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>

    <record id="bf_onb_step_devices" model="onboarding.onboarding.step">
        <field name="title">Register the tracked devices</field>
        <field name="description">[action:bf_sms_archive.sms_device_action] Declare the phones and numbers whose SMS and calls you want to archive.</field>
        <field name="button_text">View devices</field>
        <field name="done_text">Devices registered</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">2</field>
    </record>

    <record id="bf_onb_step_threads" model="onboarding.onboarding.step">
        <field name="title">Inspect the SMS threads</field>
        <field name="description">[action:bf_sms_archive.sms_thread_action] Check that the conversations appear and are linked to Odoo contacts.</field>
        <field name="button_text">View threads</field>
        <field name="done_text">Archiving validated</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">3</field>
    </record>

    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">SMS Archive</field>
        <field name="route_name">bf_sms_archive_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_sms_archive</field>
        <field name="step_ids" eval="[
            Command.link(ref('bf_sms_archive.bf_onb_step_settings')),
            Command.link(ref('bf_sms_archive.bf_onb_step_devices')),
            Command.link(ref('bf_sms_archive.bf_onb_step_threads')),
        ]"/>
    </record>

</odoo>
