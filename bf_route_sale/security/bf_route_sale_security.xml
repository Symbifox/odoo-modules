<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_stop_line_company" model="ir.rule">
        <field name="name">Usual products: companies</field>
        <field name="model_id" ref="model_bf_route_stop_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_day_stop_line_company" model="ir.rule">
        <field name="name">Products sold at a stop: companies</field>
        <field name="model_id" ref="model_bf_route_day_stop_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_deposit_company" model="ir.rule">
        <field name="name">Containers held: companies</field>
        <field name="model_id" ref="model_bf_route_deposit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- ⚠️ A worker reads the products of their own stops only. -->
    <record id="rule_stop_line_worker" model="ir.rule">
        <field name="name">Usual products: the routes I drive</field>
        <field name="model_id" ref="model_bf_route_stop_line"/>
        <field name="domain_force">[('stop_id.route_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bf_route.group_route_user'))]"/>
    </record>
    <record id="rule_stop_line_manager" model="ir.rule">
        <field name="name">Usual products: all, for managers</field>
        <field name="model_id" ref="model_bf_route_stop_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bf_route.group_route_manager'))]"/>
    </record>
    <record id="rule_day_stop_line_worker" model="ir.rule">
        <field name="name">Products sold at a stop: mine</field>
        <field name="model_id" ref="model_bf_route_day_stop_line"/>
        <field name="domain_force">[('stop_id.day_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bf_route.group_route_user'))]"/>
    </record>
    <record id="rule_day_stop_line_manager" model="ir.rule">
        <field name="name">Products sold at a stop: all, for managers</field>
        <field name="model_id" ref="model_bf_route_day_stop_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bf_route.group_route_manager'))]"/>
    </record>
</odoo>
