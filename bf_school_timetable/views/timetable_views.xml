<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_school_timetable_view_form" model="ir.ui.view">
        <field name="name">bf.school.timetable.form</field>
        <field name="model">bf.school.timetable</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_days" type="object" string="Generate the calendar" invisible="day_ids"/>
                    <button name="action_open_import" type="object" string="Import classes from a file"/>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_draft" type="object" string="Back to draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="school_id"/>
                            <field name="year_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="cycle_days"/>
                            <field name="first_cycle_day"/>
                            <field name="slot_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Periods" name="periods">
                            <field name="period_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="is_break"/>
                                </list>
                            </field>
                        </page>
                        <page string="Classes" name="slots">
                            <field name="slot_ids">
                                <list editable="bottom">
                                    <field name="day_no"/>
                                    <field name="period_id"/>
                                    <field name="course_id"/>
                                    <field name="room_id"/>
                                    <field name="allow_overlap" optional="show"/>
                                    <field name="group_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Calendar" name="days">
                            <field name="day_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="kind"/>
                                    <field name="cycle_day"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_school_timetable_view_list" model="ir.ui.view">
        <field name="name">bf.school.timetable.list</field>
        <field name="model">bf.school.timetable</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="school_id"/>
                <field name="year_id"/>
                <field name="cycle_days"/>
                <field name="slot_count"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="bf_school_timetable_action" model="ir.actions.act_window">
        <field name="name">Timetables</field>
        <field name="res_model">bf.school.timetable</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="bf_school_timetable_slot_view_list" model="ir.ui.view">
        <field name="name">bf.school.timetable.slot.list</field>
        <field name="model">bf.school.timetable.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="timetable_id"/>
                <field name="day_no"/>
                <field name="period_id"/>
                <field name="group_id"/>
                <field name="course_id"/>
                <field name="teacher_ids" widget="many2many_avatar_user"/>
                <field name="room_id"/>
            </list>
        </field>
    </record>

    <record id="bf_school_timetable_slot_view_search" model="ir.ui.view">
        <field name="name">bf.school.timetable.slot.search</field>
        <field name="model">bf.school.timetable.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="group_id"/>
                <field name="course_id"/>
                <field name="teacher_ids"/>
                <field name="room_id"/>
                <filter name="mine" string="My classes" domain="[('teacher_ids', 'in', [uid])]"/>
                <group expand="0" string="Group by">
                    <filter name="by_group" string="Group" context="{'group_by': 'group_id'}"/>
                    <filter name="by_room" string="Room" context="{'group_by': 'room_id'}"/>
                    <filter name="by_day" string="Day of the cycle" context="{'group_by': 'day_no'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_timetable_slot_action" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">bf.school.timetable.slot</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_mine': 1}</field>
    </record>

    <record id="bf_school_room_view_list" model="ir.ui.view">
        <field name="name">bf.school.room.list</field>
        <field name="model">bf.school.room</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="school_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="bf_school_room_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">bf.school.room</field>
        <field name="view_mode">list</field>
    </record>

    <record id="bf_school_timetable_import_view_form" model="ir.ui.view">
        <field name="name">bf.school.timetable.import.form</field>
        <field name="model">bf.school.timetable.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="timetable_id" invisible="1"/>
                    <field name="file" filename="file_name" invisible="log"/>
                    <field name="file_name" invisible="1"/>
                    <field name="replace" invisible="log"/>
                    <field name="create_rooms" invisible="log"/>
                    <field name="log" invisible="not log"/>
                </group>
                <p class="text-muted" invisible="log">
                    A CSV file with one class per line and the columns group, subject, day, period and, if you
                    have it, room. The day is the day of the cycle; the period is its name or its number.
                </p>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary" invisible="log"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bf_school_timetable_import_action" model="ir.actions.act_window">
        <field name="name">Import classes from a file</field>
        <field name="res_model">bf.school.timetable.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_school_timetable_root" name="Timetable" parent="bf_school_core.menu_school_root" sequence="17"/>
    <menuitem id="menu_school_timetable_slots" name="Classes" parent="menu_school_timetable_root"
              action="bf_school_timetable_slot_action" sequence="10"/>
    <menuitem id="menu_school_timetables" name="Timetables" parent="menu_school_timetable_root"
              action="bf_school_timetable_action" sequence="20" groups="bf_school_core.group_school_manager"/>
    <menuitem id="menu_school_rooms" name="Rooms" parent="bf_school_core.menu_school_config"
              action="bf_school_room_action" sequence="45"/>
</odoo>
