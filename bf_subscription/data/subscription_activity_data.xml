<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Type dédié aux relances de renouvellement : il permet au cron de
             reconnaître SES propres relances (et de ne pas en empiler une
             deuxième), et au bouton « Renouvellement confirmé » de fermer
             exactement celles-là sans toucher aux autres tâches de la fiche. -->
        <record id="mail_activity_type_renewal" model="mail.activity.type">
            <field name="name">Renouvellement d'abonnement</field>
            <field name="icon">fa-refresh</field>
            <field name="res_model">subscription.subscription</field>
            <field name="delay_count">0</field>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>
