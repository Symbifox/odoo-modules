<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── delivery days on the supplier ──────────────────────────────────────── -->
    <record id="bf_kitchen_partner_form_delivery" model="ir.ui.view">
        <field name="name">res.partner.form.bf_kitchen.delivery</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="bf_kitchen.res_partner_form_view_kitchen"/>
        <field name="arch" type="xml">
            <field name="bf_food_supplier" position="after">
                <field name="bf_kitchen_delivery_day_ids" widget="many2many_tags" invisible="not bf_food_supplier"
                       options="{'no_create': True}" groups="bf_kitchen.group_kitchen_manager"/>
                <field name="bf_kitchen_order_days" invisible="not bf_food_supplier"
                       groups="bf_kitchen.group_kitchen_manager"/>
            </field>
        </field>
    </record>

    <!-- ── stock levels: Odoo's reordering rules of kitchen items ─────────────── -->
    <record id="bf_kitchen_orderpoint_view_list" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.bf_kitchen</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" column_invisible="True"/>
                <field name="product_id" domain="[('bf_kitchen_type', 'in', ('ingredient', 'preparation')), ('is_storable', '=', True)]"
                       options="{'no_create': True}"/>
                <field name="warehouse_id" groups="stock.group_stock_multi_warehouses" options="{'no_create': True}"/>
                <field name="location_id" column_invisible="True"/>
                <field name="product_uom_name" string="Unit"/>
                <field name="qty_on_hand" string="On hand"/>
                <field name="qty_forecast" string="Forecast"/>
                <field name="product_min_qty" string="Min"/>
                <field name="product_max_qty" string="Max"/>
                <field name="supplier_id" optional="show" options="{'no_create': True}"/>
                <field name="qty_to_order" string="To order" optional="show"/>
                <field name="trigger" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="bf_kitchen_orderpoint_action" model="ir.actions.act_window">
        <field name="name">Stock levels</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="bf_kitchen_orderpoint_view_list"/>
        <field name="domain">[('product_id.product_tmpl_id.bf_kitchen_type', 'in', ('ingredient', 'preparation')), ('trigger', '=', 'manual')]</field>
        <field name="context">{'default_trigger': 'manual'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set the min and max of your ingredients</p>
            <p>Below the min, the order guide suggests ordering up to the max, in the supplier's unit.</p>
        </field>
    </record>

    <!-- ── order guide ─────────────────────────────────────────────────────────── -->
    <record id="bf_kitchen_order_guide_view_form" model="ir.ui.view">
        <field name="name">bf.kitchen.order.guide.form</field>
        <field name="model">bf.kitchen.order.guide</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary"
                            invisible="computed"/>
                    <button name="action_compute" type="object" string="Compute again" invisible="not computed"/>
                    <button name="action_create_rfq" type="object" string="Create the request for quotation"
                            class="btn-primary" invisible="not computed or order_id" groups="purchase.group_purchase_user"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><span>Order guide</span></h1>
                        <div class="text-muted">What to order for the next delivery, in the supplier's unit.</div>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="computed" invisible="1"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="warehouse_id" groups="stock.group_stock_multi_warehouses" options="{'no_create': True}"/>
                        </group>
                        <group invisible="not computed">
                            <field name="delivery_date"/>
                            <field name="cover_until"/>
                            <field name="order_id" invisible="not order_id"/>
                        </group>
                    </group>
                    <field name="line_ids" invisible="not computed" readonly="order_id">
                        <list editable="bottom" create="0" delete="0" decoration-muted="qty == 0"
                              decoration-bf="suggested &gt; 0">
                            <field name="product_id" readonly="1"/>
                            <field name="on_hand" readonly="1" optional="show"/>
                            <field name="forecast" readonly="1"/>
                            <field name="in_progress" readonly="1" optional="show"/>
                            <field name="known_demand" readonly="1" optional="show"/>
                            <field name="min_qty" readonly="1" optional="show"/>
                            <field name="max_qty" readonly="1" optional="show"/>
                            <field name="stock_uom_id" readonly="1" optional="show"/>
                            <field name="suggested" readonly="1"/>
                            <field name="qty"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="price_unit" readonly="1" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_kitchen_order_guide_action" model="ir.actions.act_window">
        <field name="name">Order guide</field>
        <field name="res_model">bf.kitchen.order.guide</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
