<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_softphone" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf_softphone</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Phone" string="Phone"
                     name="bf_softphone" groups="base.group_system">
                    <block title="PBX">
                        <setting string="PBX host"
                                 help="Hostname serving the SIP WebSocket (wss://&lt;host&gt;/ws)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="bf_softphone_pbx_host" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_pbx_host" class="col-lg-6"
                                           placeholder="pbx.example.com"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="TURN media relay (Cloudflare)"
                           help="Cloudflare TURN key, used server-side to mint short-lived ICE credentials. These secrets never leave the server.">
                        <setting string="TURN key ID">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="bf_softphone_turn_key_id" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_turn_key_id" class="col-lg-6"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bf_softphone_turn_key_token" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_turn_key_token" class="col-lg-6" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Dialing through the PBX"
                           help="Lets a client without a SIP stack (the mobile app) request a call: the PBX rings the user's device, then dials the other party with the trunk's caller ID.">
                        <setting string="AMI link">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="bf_softphone_ami_host" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_ami_host" class="col-lg-6"
                                           placeholder="ami.example.internal"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bf_softphone_ami_port" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_ami_port" class="col-lg-6"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bf_softphone_ami_user" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_ami_user" class="col-lg-6"
                                           placeholder="clicktocall"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bf_softphone_ami_password" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_ami_password" class="col-lg-6"
                                           password="True"/>
                                </div>
                                <div class="mt8">
                                    <button name="action_softphone_test_ami" type="object"
                                            string="Test the link" class="btn-link"
                                            icon="fa-plug"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Dial plan">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="bf_softphone_trunk" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_trunk" class="col-lg-6"
                                           placeholder="my-trunk"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bf_softphone_originate_context" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_originate_context" class="col-lg-6"
                                           placeholder="from-clicktocall"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bf_softphone_outbound_cid" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_outbound_cid" class="col-lg-6"
                                           placeholder="514 555-0100"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Push wake-up"
                           help="Rings the mobile app even when it is closed: the PBX notifies Odoo before dialing, Odoo pushes a notification, the app registers again and the dial plan dials the contact that just appeared.">
                        <setting string="Enable wake-up"
                                 help="Turning off text message notifications does not turn off ringing: they are two separate switches.">
                            <field name="bf_softphone_wake_enabled"/>
                        </setting>
                        <setting string="Token shared with the PBX">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="bf_softphone_pbx_wake_token" class="col-lg-3 o_light_label"/>
                                    <field name="bf_softphone_pbx_wake_token" class="col-lg-6"
                                           password="True"/>
                                </div>
                                <div class="text-muted mt8">
                                    The same secret must live on the PBX side, where the dial plan reads it (for example <code>WAKE_TOKEN</code> in its environment). Empty: wake-up is refused.
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
