<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Credential Type Form View -->
    <record id="credential_type_view_form" model="ir.ui.view">
        <field name="name">project.credential.type.form</field>
        <field name="model">project.credential.type</field>
        <field name="arch" type="xml">
            <form string="Credential Type">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Email Account"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="icon" placeholder="fa-key"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Field Visibility">
                        <group>
                            <field name="show_url"/>
                            <field name="show_domain"/>
                        </group>
                        <group>
                            <field name="show_api_key"/>
                            <field name="show_key_file"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Optional description of this credential type..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Credential Type List View -->
    <record id="credential_type_view_list" model="ir.ui.view">
        <field name="name">project.credential.type.list</field>
        <field name="model">project.credential.type</field>
        <field name="arch" type="xml">
            <list string="Credential Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="show_url"/>
                <field name="show_domain"/>
                <field name="show_api_key"/>
                <field name="show_key_file"/>
            </list>
        </field>
    </record>

    <!-- Credential Type Action -->
    <record id="credential_type_action" model="ir.actions.act_window">
        <field name="name">Credential Types</field>
        <field name="res_model">project.credential.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a credential type
            </p>
            <p>
                Credential types define the category and which fields are displayed
                when creating credentials (e.g., Email, Server, API).
            </p>
        </field>
    </record>

</odoo>
