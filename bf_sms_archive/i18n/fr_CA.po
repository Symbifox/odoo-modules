"<strong>Endpoint:</strong>\n"
"                        <code>POST &lt;base_url&gt;/bf_sms_archive/api/ingest</code><br/>\n"
"                        <strong>Auth:</strong>\n"
"                        <code>Authorization: Bearer &lt;api_token&gt;</code><br/>\n"
"                        The <em>bf-sms-relay</em> app expects these two values in\n"
"                        its preferences."
msgstr ""
"<strong>Endpoint :</strong>\n"
"                        <code>POST &lt;base_url&gt;/bf_sms_archive/api/ingest</code><br/>\n"
"                        <strong>Auth :</strong>\n"
"                        <code>Authorization: Bearer &lt;api_token&gt;</code><br/>\n"
"                        L'app <em>bf-sms-relay</em> attend ces deux valeurs dans\n"
"                        ses préférences."

#. module: bf_sms_archive
#: model_terms:ir.ui.view,arch_db:bf_sms_archive.sms_import_wizard_view_form
msgid ""
"<strong>Large files (over 1 GB)</strong>: drop them via\n"
"                        <code>scp</code> into the <code>sms-inbox/</code> bind mount\n"
"                        of the compose file (mounted at <code>/mnt/sms-inbox</code> in the\n"
"                        container), then click \"Import from /mnt/sms-inbox\".\n"
"                        The disk import bypasses the form's HTTP/memory limit."
msgstr ""
"<strong>Fichiers volumineux (+1 Go)</strong> : déposez-les via\n"
"                        <code>scp</code> dans le bind mount <code>sms-inbox/</code>\n"
"                        du compose (monté sur <code>/mnt/sms-inbox</code> côté\n"
"                        container), puis cliquez sur « Importer depuis /mnt/sms-inbox ».\n"
"                        L'import disque contourne la limite HTTP/mémoire du formulaire."

