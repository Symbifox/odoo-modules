<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meeting_record_form_work_category" model="ir.ui.view">
        <field name="name">meeting.record.form.work.category</field>
        <field name="model">meeting.record</field>
        <field name="inherit_id" ref="bf_meeting.meeting_record_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='project_id'][not(ancestor::list)]" position="after">
                <label for="work_category_id"/>
                <div class="o_row">
                    <field name="work_category_id" options="{'no_open': True}"/>
                    <field name="work_category_origin" class="text-muted" invisible="not work_category_id"/>
                </div>
                <field name="work_category_manual_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="meeting_record_list_work_category" model="ir.ui.view">
        <field name="name">meeting.record.list.work.category</field>
        <field name="model">meeting.record</field>
        <field name="inherit_id" ref="bf_meeting.meeting_record_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="work_category_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="meeting_record_search_work_category" model="ir.ui.view">
        <field name="name">meeting.record.search.work.category</field>
        <field name="model">meeting.record</field>
        <field name="inherit_id" ref="bf_meeting.meeting_record_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="work_category_id"/>
                <filter name="groupby_work_category" string="Work category" context="{'group_by': 'work_category_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
