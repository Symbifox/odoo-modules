<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_purge_change_journal" model="ir.cron">
        <field name="name">CalDAV/CardDAV: forget old sync changes</field>
        <field name="model_id" ref="model_bf_dav_change"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_close_sent_updates" model="ir.cron">
        <field name="name">CalDAV: close the "send the update" to-dos once the guests are told</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_bf_dav_close_sent_updates()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
