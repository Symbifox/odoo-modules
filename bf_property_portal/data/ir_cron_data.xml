<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            ⚠️ Cette tâche SUPPRIME. Elle n'archive pas : archiver garde la
            donnée en la cachant, ce qui est le contraire du but. Et elle ne
            touche que les entrées CLOSES : un colis encore en dépôt et un
            visiteur encore attendu restent, quelle que soit leur date.

            Sans durée de conservation au syndicat (défaut zéro), elle ne
            supprime rien : le module ne choisit pas à la place du syndicat.
        -->
        <record id="cron_purge_portal_logs" model="ir.cron">
            <field name="name">Copropriété : purge des journaux de colis et de visiteurs</field>
            <field name="model_id" ref="bf_property_core.model_bf_property_organisation"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_portal_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.utcnow() - timedelta(hours=5, minutes=30) + relativedelta(days=1)).strftime('%Y-%m-%d 05:30:00')"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
