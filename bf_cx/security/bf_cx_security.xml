<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">
        <record id="module_category_cx" model="ir.module.category">
            <field name="name">Expérience client</field>
            <field name="description">Mesure de l'expérience client : NPS, feedback continu, plaintes et témoignages</field>
            <field name="sequence">45</field>
        </record>

        <!-- Operator: runs programs, follows up feedback, handles complaints.
             Implies the survey user role: the module drives survey.survey /
             survey.user_input under the current user's rights
             (_create_answer, _read_group on answers) and base.group_user
             alone has ZERO access to those models. -->
        <record id="group_bf_cx_user" model="res.groups">
            <field name="name">Opérateur</field>
            <field name="category_id" ref="module_category_cx"/>
            <field name="implied_ids" eval="[(4, ref('survey.group_survey_user'))]"/>
            <field name="comment">Peut gérer les programmes, vagues, feedbacks clients, plaintes et témoignages. Ne voit pas le feedback interne (360).</field>
        </record>

        <!-- Manager: everything, including internal 360 entries. -->
        <record id="group_bf_cx_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="category_id" ref="module_category_cx"/>
            <field name="implied_ids" eval="[(4, ref('group_bf_cx_user'))]"/>
            <field name="comment">Accès complet, incluant le feedback interne (360) et la configuration.</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="1">
        <!-- Multi-company scoping: GLOBAL rules (no groups). Group rules
             OR together while global rules AND - a company rule carrying a
             group would be bypassed by any other group rule. -->
        <record id="rule_cx_program_company" model="ir.rule">
            <field name="name">Programmes : multi-société</field>
            <field name="model_id" ref="model_bf_cx_program"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cx_wave_company" model="ir.rule">
            <field name="name">Vagues : multi-société</field>
            <field name="model_id" ref="model_bf_cx_wave"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cx_feedback_company" model="ir.rule">
            <field name="name">Feedbacks : multi-société</field>
            <field name="model_id" ref="model_bf_cx_feedback"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cx_complaint_company" model="ir.rule">
            <field name="name">Plaintes : multi-société</field>
            <field name="model_id" ref="model_bf_cx_complaint"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cx_testimonial_company" model="ir.rule">
            <field name="name">Témoignages : multi-société</field>
            <field name="model_id" ref="model_bf_cx_testimonial"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Internal (360) feedback is manager-only. These two ARE group
             rules (they OR together): operators capped to non-internal,
             managers see everything; the company rule above still ANDs. -->
        <record id="rule_cx_feedback_operator_no_internal" model="ir.rule">
            <field name="name">Feedbacks : opérateur sans le 360 interne</field>
            <field name="model_id" ref="model_bf_cx_feedback"/>
            <field name="domain_force">[('kind', '!=', 'internal')]</field>
            <field name="groups" eval="[(4, ref('group_bf_cx_user'))]"/>
        </record>

        <record id="rule_cx_feedback_manager_all" model="ir.rule">
            <field name="name">Feedbacks : gestionnaire voit tout</field>
            <field name="model_id" ref="model_bf_cx_feedback"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bf_cx_manager'))]"/>
        </record>
    </data>

</odoo>
