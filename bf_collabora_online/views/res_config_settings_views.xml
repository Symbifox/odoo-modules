<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_bf_collabora" model="ir.ui.view">
        <field name="name">res.config.settings.bf.collabora</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Collabora Online" name="bf_collabora_online">
                    <block title="Server discovery" name="bf_cool_decouverte">
                        <setting id="bf_cool_setting_ttl" string="Discovery lifetime"
                                 help="The upstream connector downloads the discovery file again each time a document opens. This delay keeps it in memory. 0 restores the original behaviour.">
                            <field name="bf_cool_decouverte_ttl"/> seconds
                            <div class="mt-2">
                                <button name="action_bf_vider_cache_decouverte" type="object"
                                        string="Clear the cache now" class="btn-link"/>
                                <div class="text-muted">
                                    Run after upgrading the Collabora server: the cached address carries its build number.
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
