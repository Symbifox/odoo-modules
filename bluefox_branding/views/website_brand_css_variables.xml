<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Portal pages use portal.frontend_layout. We add a small head
        block carrying the same :root CSS variables as the backend, so
        portal pages and customer-facing pages share branding.

        Loaded only when portal is installed (declared as an optional
        dep in __manifest__.py).
    -->
    <template id="brand_css_variables_portal"
              inherit_id="portal.frontend_layout"
              name="Brand CSS variables (portal)">
        <xpath expr="//head" position="inside">
            <t t-set="_brand_co" t-value="request and request.env and request.env['res.company']._brand_active_company()"/>
            <t t-if="_brand_co">
                <style>
                    :root {
                        <t t-if="_brand_co.report_brand_primary">--brand-primary: <t t-out="_brand_co.report_brand_primary"/>;</t>
                        <t t-if="_brand_co.report_brand_dark">--brand-dark: <t t-out="_brand_co.report_brand_dark"/>;</t>
                    }
                </style>
            </t>
        </xpath>
    </template>

</odoo>
