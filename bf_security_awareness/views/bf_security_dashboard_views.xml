<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client actions -->
    <record id="action_secaware_dashboard" model="ir.actions.client">
        <field name="name">Tableau de bord</field>
        <field name="tag">bf_secaware_dashboard</field>
    </record>

    <record id="action_secaware_my" model="ir.actions.client">
        <field name="name">Ma cybersécurité</field>
        <field name="tag">bf_secaware_my</field>
    </record>

    <!-- Manager dashboard: first entry under the Sensibilisation app -->
    <menuitem id="menu_secaware_dashboard"
              name="Tableau de bord"
              parent="menu_secaware_root"
              action="action_secaware_dashboard"
              groups="group_bf_secaware_user"
              sequence="1"/>

    <!-- Employee self-service: now lives under the single Sensibilisation app,
         visible to every internal user (admin entries above stay group-gated). -->
    <menuitem id="menu_my_secaware"
              name="Mon tableau de bord"
              parent="menu_secaware_root"
              action="action_secaware_my"
              groups="base.group_user"
              sequence="2"/>

</odoo>
