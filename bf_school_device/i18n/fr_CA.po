#. module: bf_school_device
#: model:mail.template,body_html:bf_school_device.mail_template_loan_reminder
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The computer <strong t-out=\"object.machine_id.hostname or ''\"/> lent to <strong t-out=\"object.student_id.name or ''\"/> is due back at the school office on <strong t-out=\"format_date(object.date_due) or ''\"/>, with its charger.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Work kept only on the computer stays on it: save what matters in the school's online storage before bringing it back.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Le poste <strong t-out=\"object.machine_id.hostname or ''\"/> prêté à <strong t-out=\"object.student_id.name or ''\"/> est à rendre au secrétariat de l'école le <strong t-out=\"format_date(object.date_due) or ''\"/>, avec son chargeur.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Le travail gardé seulement sur le poste y reste : enregistrez ce qui compte dans le stockage en ligne de l'école avant de le rapporter.</p>\n"
"</div>\n"
"            "

#. module: bf_school_device
#: model:mail.template,body_html:bf_school_device.mail_template_loan_overdue
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The computer <strong t-out=\"object.machine_id.hostname or ''\"/> lent to <strong t-out=\"object.student_id.name or ''\"/> was due back on <t t-out=\"format_date(object.date_due) or ''\"/> and the school office has not received it.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Please bring it back, or contact the school office if it was lost or damaged.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Le poste <strong t-out=\"object.machine_id.hostname or ''\"/> prêté à <strong t-out=\"object.student_id.name or ''\"/> était à rendre le <t t-out=\"format_date(object.date_due) or ''\"/> et le secrétariat de l'école ne l'a pas reçu.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Merci de le rapporter, ou de communiquer avec le secrétariat s'il a été perdu ou endommagé.</p>\n"
"</div>\n"
"            "

#. module: bf_school_device
#: model:mail.template,body_html:bf_school_device.mail_template_loan_out
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The school lends a computer to <strong t-out=\"object.student_id.name or ''\"/>: <strong t-out=\"object.machine_id.hostname or ''\"/>, lent on <t t-out=\"format_date(object.date_out) or ''\"/> and due back on <strong t-out=\"format_date(object.date_due) or ''\"/>.</p>\n"
"    <p t-if=\"object.condition_out\" style=\"margin:0 0 12px 0;\">Condition noted when lent: <t t-out=\"object.condition_out or ''\"/></p>\n"
"    <p style=\"margin:0 0 12px 0;\">Your child logs in with their school account. The first login must be made while the computer is online. Please take care of it and bring it back to the school office by the due date.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            See it in the family portal\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">L'école prête un poste à <strong t-out=\"object.student_id.name or ''\"/> : <strong t-out=\"object.machine_id.hostname or ''\"/>, prêté le <t t-out=\"format_date(object.date_out) or ''\"/> et à rendre le <strong t-out=\"format_date(object.date_due) or ''\"/>.</p>\n"
"    <p t-if=\"object.condition_out\" style=\"margin:0 0 12px 0;\">État noté au prêt : <t t-out=\"object.condition_out or ''\"/></p>\n"
"    <p style=\"margin:0 0 12px 0;\">Votre enfant s'y connecte avec son compte de l'école. La première connexion doit se faire pendant que le poste est en ligne. Merci d'en prendre soin et de le rapporter au secrétariat au plus tard à la date prévue.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Voir dans le portail des familles\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

