msgstr "Acknowledgement sent to %s."

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "Autorités hors Québec : %s"
msgstr "Authorities outside Québec: %s"

#. module: bf_federation_privacy
#: model:ir.model.fields,field_description:bf_federation_privacy.field_federation_link__breach_in_company
msgid "Avis dans mes sociétés"
msgstr "Notice in my companies"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "Avis de %(who)s : %(ref)s"
msgstr "Notice from %(who)s: %(ref)s"

#. module: bf_federation_privacy
#: model:ir.model.fields.selection,name:bf_federation_privacy.selection__federation_outbox__kind__breach_share
msgid "Avis de violation"
msgstr "Breach notice"

#. module: bf_federation_privacy
#: model:ir.model,name:bf_federation_privacy.model_privacy_breach_notice
