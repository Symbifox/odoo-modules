<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="letter_template_view_list" model="ir.ui.view">
        <field name="name">letter.template.list</field>
        <field name="model">letter.template</field>
        <field name="arch" type="xml">
            <list string="Letter templates">
                <field name="name"/>
                <field name="language"/>
                <field name="subject"/>
                <field name="letterhead_style"/>
            </list>
        </field>
    </record>

    <record id="letter_template_view_form" model="ir.ui.view">
        <field name="name">letter.template.form</field>
        <field name="model">letter.template</field>
        <field name="arch" type="xml">
            <form string="Letter template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Template name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="letterhead_style"/>
                            <field name="language"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="quicktext_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Body" name="body">
                            <field name="body_html" widget="html" nolabel="1"/>
                        </page>
                        <page string="Merge fields" name="merge_fields">
                            <div class="text-muted">
                                <p>Insert these tokens in the subject or the body. They are replaced when the template is applied to a letter.</p>
                                <ul>
                                    <li><code>{{ object.partner_id.name }}</code>: recipient name</li>
                                    <li><code>{{ object.partner_id.parent_id.name }}</code>: recipient organization</li>
                                    <li><code>{{ object.recipient_name }}</code>: recipient name (frozen on the letter)</li>
                                    <li><code>{{ object.letter_date_display }}</code>: letter date, written out in the letter's language</li>
                                    <li><code>{{ object.reference }}</code>: reference (LET-YYYY-NNN)</li>
                                    <li><code>{{ object.company_id.name }}</code>: sender name</li>
                                    <li><code>{{ object.signatory_id.name }}</code>: signatory name</li>
                                    <li><code>{{ object.signatory_function }}</code>: signatory title</li>
                                </ul>
                                <p>Only these fields can be used by someone who is not a template editor: any other expression stops the template from being applied.</p>
                                <p>Text between square brackets, such as <code>[date and time]</code>, is left for the writer to fill in. The letter warns while one remains.</p>
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1" placeholder="Internal description of the template..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="letter_template_view_search" model="ir.ui.view">
        <field name="name">letter.template.search</field>
        <field name="model">letter.template</field>
        <field name="arch" type="xml">
            <search string="Letter templates">
                <field name="name"/>
                <field name="subject"/>
                <filter string="French" name="language_fr" domain="[('language', '=', 'fr')]"/>
                <filter string="English" name="language_en" domain="[('language', '=', 'en')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Language" name="group_language" context="{'group_by': 'language'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_letter_template" model="ir.actions.act_window">
        <field name="name">Letter templates</field>
        <field name="res_model">letter.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first letter template
            </p>
        </field>
    </record>

</odoo>
