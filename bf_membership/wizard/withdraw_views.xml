<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_withdraw_form" model="ir.ui.view">
        <field name="name">bf.membership.withdraw.form</field>
        <field name="model">bf.membership.withdraw</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Le membre reste au registre comme ancien membre. Rien n'est supprimé.</p>
                <group>
                    <field name="membership_ids" widget="many2many_tags" readonly="1"/>
                    <field name="date"/>
                    <field name="reason" placeholder="Démission, décès, exclusion décidée par le conseil…"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Retirer" class="btn-primary"/>
                    <button special="cancel" string="Annuler"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
