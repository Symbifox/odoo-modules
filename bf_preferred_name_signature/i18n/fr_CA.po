#. module: bf_preferred_name_signature
#: model:ir.model,name:bf_preferred_name_signature.model_res_partner
msgid "Contact"
msgstr "Contact"

#. module: bf_preferred_name_signature
#: model:ir.model.fields,field_description:bf_preferred_name_signature.field_res_users__bf_signature_pronouns
msgid "Pronouns (from the contact)"
msgstr "Pronoms (de la fiche)"

#. module: bf_preferred_name_signature
#: model:ir.model.fields,help:bf_preferred_name_signature.field_res_users__bf_signature_pronouns
msgid ""
"Shown next to the name in the email signature. The same field as the "
"pronouns on the person's contact."
msgstr ""
"Affichés à côté du nom dans la signature de courriel. Le même champ que les "
"pronoms de la fiche de la personne."

#. module: bf_preferred_name_signature
#: model:ir.model,name:bf_preferred_name_signature.model_res_users
msgid "User"
msgstr "Usager"

#. module: bf_preferred_name_signature
#: model_terms:ir.ui.view,arch_db:bf_preferred_name_signature.res_users_preferences_bf_signature_one_pronoun
msgid ""
"Your organization sets the signature. Enter your pronouns\n"
"                    under your email, and your job title and links under\n"
"                    “Signature”: the signature updates by itself."
msgstr ""
"Votre organisation impose la signature. Renseignez vos pronoms\n"
"                    sous votre courriel, et votre titre et vos liens sous\n"
"                    « Signature » : elle se régénère toute seule."
