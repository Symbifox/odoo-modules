#. module: bf_appointment_poll
#: model:mail.template,body_html:bf_appointment_poll.mail_template_poll_reminder
msgid ""
"<t t-set=\"company\" t-value=\"(object.poll_id.type_id.company_id) or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Friendly reminder</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"        <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;\">Just a gentle reminder: we still need your availability to schedule the meeting “<strong><t t-out=\"object.poll_id.name or ''\"/></strong>”.</p>\n"
"        <t t-if=\"object.required\"><p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;\">Since your attendance is required, the meeting is waiting for your answer before it can be set.</p></t>\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin:16px 0 4px 0; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;\"><tbody>\n"
"         <tr><td style=\"padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px; width:38%;\">Subject</td><td style=\"padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;\"><t t-out=\"object.poll_id.name or ''\"/></td></tr>\n"
"         <tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Expected duration</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;\"><t t-out=\"object.poll_id.duration_display()\"/></td></tr>\n"
"         <tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Proposed slots</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;\"><t t-out=\"len(object.poll_id.slot_ids)\"/></td></tr>\n"
"         <t t-if=\"object.poll_id.close_date\"><tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Please reply by</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;\"><t t-out=\"object.poll_id.close_display()\"/></td></tr></t>\n"
"         <t t-if=\"object.required\"><tr><td style=\"padding:12px 16px; color:#6B7280; font-size:14px;\">Your attendance</td><td style=\"padding:12px 16px; font-size:14px; font-weight:600; color:#374151;\">Required</td></tr></t>\n"
"        </tbody></table>\n"
"        <p style=\"text-align:center; margin:24px 0 8px 0;\">\n"
"         <a t-att-href=\"object._vote_url()\" t-attf-style=\"background-color:{{ brand_primary }}; color:#ffffff; padding:14px 34px; text-decoration:none; border-radius:6px; font-weight:600; font-size:15px; display:inline-block;\">Reply now</a>\n"
"        </p>\n"
"        <p style=\"text-align:center; font-size:12px; color:#9CA3AF; margin:0 0 4px 0;\">This link is just for you.</p>\n"
"<p style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:24px 0 0 0;\">\n"
"      This poll was sent to you by <strong t-attf-style=\"color:{{ brand_dark }};\"><t t-out=\"object.poll_id.user_id.name or ''\"/></strong>\n"
"      via <t t-out=\"company.name\"/>. Your answers are only used to schedule this meeting.\n"
"     </p>"
msgstr ""

#. module: bf_appointment_poll
#: model:mail.template,body_html:bf_appointment_poll.mail_template_poll_invitation
msgid ""
"<t t-set=\"company\" t-value=\"(object.poll_id.type_id.company_id) or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Your availability</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"        <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;\"><t t-out=\"object.poll_id.user_id.name or ''\"/> is looking for a time that works for everyone for the meeting “<strong><t t-out=\"object.poll_id.name or ''\"/></strong>”.</p>\n"
"        <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;\">A few time slots are proposed. For each one, let us know whether it works for you, would work if need be, or does not work at all. It only takes a minute.</p>\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin:16px 0 4px 0; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;\"><tbody>\n"
"         <tr><td style=\"padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px; width:38%;\">Subject</td><td style=\"padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;\"><t t-out=\"object.poll_id.name or ''\"/></td></tr>\n"
"         <tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Expected duration</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;\"><t t-out=\"object.poll_id.duration_display()\"/></td></tr>\n"
"         <tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Proposed slots</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;\"><t t-out=\"len(object.poll_id.slot_ids)\"/></td></tr>\n"
"         <t t-if=\"object.poll_id.close_date\"><tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Please reply by</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;\"><t t-out=\"object.poll_id.close_display()\"/></td></tr></t>\n"
"         <t t-if=\"object.required\"><tr><td style=\"padding:12px 16px; color:#6B7280; font-size:14px;\">Your attendance</td><td style=\"padding:12px 16px; font-size:14px; font-weight:600; color:#374151;\">Required</td></tr></t>\n"
"        </tbody></table>\n"
"        <p style=\"text-align:center; margin:24px 0 8px 0;\">\n"
"         <a t-att-href=\"object._vote_url()\" t-attf-style=\"background-color:{{ brand_primary }}; color:#ffffff; padding:14px 34px; text-decoration:none; border-radius:6px; font-weight:600; font-size:15px; display:inline-block;\">Share my availability</a>\n"
"        </p>\n"
"        <p style=\"text-align:center; font-size:12px; color:#9CA3AF; margin:0 0 4px 0;\">This link is just for you.</p>\n"
"<p style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:24px 0 0 0;\">\n"
"      This poll was sent to you by <strong t-attf-style=\"color:{{ brand_dark }};\"><t t-out=\"object.poll_id.user_id.name or ''\"/></strong>\n"
"      via <t t-out=\"company.name\"/>. Your answers are only used to schedule this meeting.\n"
"     </p>"
msgstr ""

#. module: bf_appointment_poll
#: model:mail.template,body_html:bf_appointment_poll.mail_template_poll_otp
msgid ""
"<t t-set=\"company\" t-value=\"(object.poll_id.type_id.company_id) or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Your code</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"     <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">Here is the code that lets you change your answers to the poll “<strong><t t-out=\"object.poll_id.name or ''\"/></strong>”.</p>\n"
"     <p style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:34px; font-weight:800; letter-spacing:8px; color:#111827; margin:0 0 8px 0; text-align:center;\"><t t-out=\"ctx.get('bf_poll_otp') or ''\"/></p>\n"
"     <p style=\"font-size:14px; line-height:22px; color:#6B7280; margin:0 0 16px 0; text-align:center;\">Valid for 15&nbsp;minutes, for this change only.</p>\n"
"     <p style=\"font-size:14px; line-height:22px; color:#6B7280; margin:0;\">Didn’t ask for this? No need to do anything: without this code, no one can change your answers. The code expires on its own.</p>"
msgstr ""

#. module: bf_appointment_poll
#: model:mail.template,body_html:bf_appointment_poll.mail_template_poll_scheduled
msgid ""
"<t t-set=\"company\" t-value=\"(object.poll_id.type_id.company_id) or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<t t-set=\"booking\" t-value=\"object.poll_id.booking_id\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">It’s set</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"     <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">Thank you for sharing your availability. The meeting “<strong><t t-out=\"object.poll_id.name or ''\"/></strong>” is now scheduled.</p>\n"
"     <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin:16px 0 4px 0; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;\"><tbody>\n"
"      <tr><td style=\"padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px; width:38%;\">When</td><td style=\"padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;\"><t t-out=\"object.poll_id.scheduled_display(object)\"/></td></tr>\n"
"      <tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Duration</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;\"><t t-out=\"object.poll_id.duration_display()\"/></td></tr>\n"
"      <t t-if=\"booking and booking.videocall_location\"><tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Where</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;\"><a t-attf-href=\"{{ booking.videocall_location }}\" t-attf-style=\"color:{{ brand_primary }};\"><t t-out=\"booking.videocall_location\"/></a></td></tr></t>\n"
"      <tr><td style=\"padding:12px 16px; color:#6B7280; font-size:14px;\">With</td><td style=\"padding:12px 16px; font-size:14px; color:#374151;\"><t t-out=\"object.poll_id.user_id.name or ''\"/></td></tr>\n"
"     </tbody></table>\n"
"     <p style=\"font-size:14px; line-height:22px; color:#6B7280; margin:16px 0 0 0;\">The attached file adds the meeting to your calendar in one click.</p>\n"
"     <p style=\"font-size:14px; line-height:22px; color:#6B7280; margin:8px 0 0 0;\">Can’t make it? Reply to this email and we’ll find another time.</p>"
msgstr ""

