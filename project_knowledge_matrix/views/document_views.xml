<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== -->
    <!-- DOCUMENT VIEWS       -->
    <!-- ==================== -->

    <!-- Document Tree View -->
    <record id="view_project_document_tree" model="ir.ui.view">
        <field name="name">project.document.tree</field>
        <field name="model">project.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_expired" decoration-warning="is_expiring_soon or is_review_due">
                <field name="code"/>
                <field name="name"/>
                <field name="type_id"/>
                <field name="software_id" optional="show"/>
                <field name="is_internal" widget="boolean" optional="show"/>
                <field name="current_version"/>
                <field name="project_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="review_date" optional="show"/>
                <field name="expiration_date" optional="show"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="version_count" string="Versions"/>
                <field name="distribution_count" string="Distribués"/>
                <field name="pending_acknowledgment_count" string="En attente"/>
                <field name="is_expired" column_invisible="True"/>
                <field name="is_expiring_soon" column_invisible="True"/>
                <field name="is_review_due" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- Document Kanban View -->
    <record id="view_project_document_kanban" model="ir.ui.view">
        <field name="name">project.document.kanban</field>
        <field name="model">project.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="type_id" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="type_id"/>
                <field name="current_version"/>
                <field name="state"/>
                <field name="is_internal"/>
                <field name="owner_id"/>
                <field name="version_count"/>
                <field name="distribution_count"/>
                <field name="pending_acknowledgment_count"/>
                <field name="is_expired"/>
                <field name="is_expiring_soon"/>
                <field name="is_review_due"/>
                <field name="software_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="code"/>
                                    </span>
                                </div>
                                <span t-if="record.is_expired.raw_value" class="badge text-bg-danger me-1" title="Expiré">
                                    <i class="fa fa-exclamation-circle" title="Expiré"/>
                                </span>
                                <span t-elif="record.is_expiring_soon.raw_value" class="badge text-bg-warning me-1" title="Expire bientôt">
                                    <i class="fa fa-clock-o" title="Expire bientôt"/>
                                </span>
                                <span t-elif="record.is_review_due.raw_value" class="badge text-bg-warning me-1" title="Révision requise">
                                    <i class="fa fa-refresh" title="Révision requise"/>
                                </span>
                                <span t-if="record.is_internal.raw_value" class="badge text-bg-info me-1" title="Document interne">
                                    <i class="fa fa-building" title="Document interne"/>
                                </span>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'active': 'success', 'archived': 'secondary'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.current_version.value">
                                    <span class="badge text-bg-primary">v<field name="current_version"/></span>
                                    <span t-if="record.software_id.raw_value" class="badge text-bg-secondary ms-1">
                                        <field name="software_id"/>
                                    </span>
                                </div>
                                <div class="text-muted mt-1">
                                    <span t-if="record.version_count.raw_value" title="Versions">
                                        <i class="fa fa-copy" title="Versions"/> <field name="version_count"/> versions
                                    </span>
                                    <span t-if="record.distribution_count.raw_value" class="ms-2" title="Distributions">
                                        <i class="fa fa-users" title="Distributions"/> <field name="distribution_count"/>
                                    </span>
                                    <span t-if="record.pending_acknowledgment_count.raw_value" class="ms-2 text-warning" title="En attente">
                                        <i class="fa fa-clock-o" title="En attente"/> <field name="pending_acknowledgment_count"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left"/>
                                <div class="oe_kanban_bottom_right">
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Document Form View -->
    <record id="view_project_document_form" model="ir.ui.view">
        <field name="name">project.document.form</field>
        <field name="model">project.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_export_matrix_pdf" string="Exporter PDF" type="object"
                            class="btn-secondary" icon="fa-file-pdf-o"
                            invisible="not matrix_id"/>
                    <button name="action_set_active" string="Activer" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_archived" string="Archiver" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_set_draft" string="Remettre en brouillon" type="object"
                            invisible="state not in ['active', 'archived']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_matrix" icon="fa-th"
                                invisible="not matrix_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Matrice</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_versions" icon="fa-copy">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_distributions" icon="fa-users">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="acknowledgment_count" class="oe_inline"/>/<field name="distribution_count" class="oe_inline"/>
                                </span>
                                <span class="o_stat_text">Accusés</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="state != 'archived'"/>
                    <widget name="web_ribbon" title="Document interne" bg_color="text-bg-info" invisible="not is_internal"/>
                    <widget name="web_ribbon" title="Expiré" bg_color="text-bg-danger" invisible="not is_expired"/>
                    <widget name="web_ribbon" title="Expire bientôt" bg_color="text-bg-warning" invisible="is_expired or not is_expiring_soon"/>
                    <widget name="web_ribbon" title="Révision requise" bg_color="text-bg-warning" invisible="not is_review_due"/>
                    <div class="oe_title">
                        <label for="name" string="Nom du document"/>
                        <h1>
                            <field name="name" placeholder="ex: Manuel d'utilisation"/>
                        </h1>
                        <div class="d-flex align-items-center gap-2">
                            <field name="code" class="oe_inline" placeholder="Code de référence"/>
                            <span class="badge text-bg-primary" invisible="not current_version">
                                v<field name="current_version" class="oe_inline"/>
                            </span>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="is_internal" readonly="1"/>
                            <field name="project_id" invisible="is_internal"/>
                            <field name="department_id" invisible="not is_internal"/>
                            <field name="matrix_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="author_id" widget="many2one_avatar_user"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                            <field name="external_url" widget="url" placeholder="https://nextcloud.example.com/..."/>
                            <field name="latest_version_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Logiciel documenté" invisible="is_internal">
                        <group>
                            <field name="software_id" options="{'no_create': True}"/>
                            <field name="software_version_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Révision et expiration">
                        <group>
                            <field name="review_interval_months"/>
                            <field name="last_review_date"/>
                            <field name="review_date"/>
                            <field name="days_until_review" invisible="not review_date"/>
                        </group>
                        <group>
                            <field name="expiration_date"/>
                            <field name="days_until_expiration" invisible="not expiration_date"/>
                            <button name="action_mark_reviewed" string="Marquer comme révisé"
                                    type="object" class="btn-secondary"
                                    invisible="state != 'active'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description du document..."/>
                        </page>
                        <page string="Versions" name="versions">
                            <field name="version_ids">
                                <list editable="bottom" default_order="release_date desc, version_number desc">
                                    <field name="version_number"/>
                                    <field name="change_type" optional="show"/>
                                    <field name="change_summary" optional="show"/>
                                    <field name="author_id" widget="many2one_avatar_user"/>
                                    <field name="effective_date"/>
                                    <field name="release_date"/>
                                    <field name="approved_by_id" widget="many2one_avatar_user" optional="show"/>
                                    <field name="attachment_id" widget="attachment_preview"/>
                                    <field name="distribution_count" string="Envoyés"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-primary="state == 'review'"
                                           decoration-warning="state == 'approved'"
                                           decoration-success="state == 'released'"
                                           decoration-muted="state == 'superseded'"
                                           decoration-danger="state == 'withdrawn'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Document Search View -->
    <record id="view_project_document_search" model="ir.ui.view">
        <field name="name">project.document.search</field>
        <field name="model">project.document</field>
        <field name="arch" type="xml">
            <search string="Rechercher des documents">
                <field name="name"/>
                <field name="code"/>
                <field name="type_id"/>
                <field name="project_id"/>
                <field name="department_id"/>
                <field name="owner_id"/>
                <field name="software_id"/>
                <separator/>
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_active" string="Actif" domain="[('state', '=', 'active')]"/>
                <filter name="filter_archived" string="Archivé" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter name="filter_internal" string="Documents internes" domain="[('is_internal', '=', True)]"/>
                <filter name="filter_external" string="Documents clients" domain="[('is_internal', '=', False)]"/>
                <separator/>
                <filter name="filter_company_wide" string="À l'échelle de l'entreprise" domain="[('project_id', '=', False), ('is_internal', '=', False)]"/>
                <filter name="filter_project_specific" string="Spécifiques au projet" domain="[('project_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_expired" string="Expirés" domain="[('is_expired', '=', True)]"/>
                <filter name="filter_expiring_soon" string="Expire bientôt" domain="[('is_expiring_soon', '=', True)]"/>
                <filter name="filter_review_due" string="Révision requise" domain="[('is_review_due', '=', True)]"/>
                <filter name="filter_needs_attention" string="Requiert attention" domain="['|', '|', ('is_expired', '=', True), ('is_expiring_soon', '=', True), ('is_review_due', '=', True)]"/>
                <separator/>
                <filter name="filter_my_documents" string="Mes documents" domain="[('owner_id', '=', uid)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="groupby_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="groupby_internal" string="Interne/Client" context="{'group_by': 'is_internal'}"/>
                    <filter name="groupby_project" string="Projet" context="{'group_by': 'project_id'}"/>
                    <filter name="groupby_department" string="Département" context="{'group_by': 'department_id'}"/>
                    <filter name="groupby_software" string="Logiciel" context="{'group_by': 'software_id'}"/>
                    <filter name="groupby_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="groupby_owner" string="Responsable" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Document Actions -->
    <record id="project_document_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">project.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_project_document_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier document
            </p>
            <p>
                Suivez les versions et distributions de documentation.
            </p>
        </field>
    </record>

    <record id="project_document_action_internal" model="ir.actions.act_window">
        <field name="name">Politiques et procédures</field>
        <field name="res_model">project.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_project_document_search"/>
        <field name="domain">[('is_internal', '=', True)]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une politique ou procédure interne
            </p>
            <p>
                Gérez les politiques RH, procédures TI, et autres documents internes.
            </p>
        </field>
    </record>

    <record id="project_document_action_client" model="ir.actions.act_window">
        <field name="name">Documents clients</field>
        <field name="res_model">project.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_project_document_search"/>
        <field name="domain">[('is_internal', '=', False)]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un document client
            </p>
            <p>
                Gérez les manuels, contrats et guides destinés aux clients.
            </p>
        </field>
    </record>

    <record id="project_document_action_needs_attention" model="ir.actions.act_window">
        <field name="name">Documents à traiter</field>
        <field name="res_model">project.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_project_document_search"/>
        <field name="domain">['|', '|', ('is_expired', '=', True), ('is_expiring_soon', '=', True), ('is_review_due', '=', True)]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun document nécessitant une attention particulière
            </p>
            <p>
                Les documents expirés, expirant bientôt ou nécessitant une révision apparaîtront ici.
            </p>
        </field>
    </record>

    <!-- ==================== -->
    <!-- VERSION VIEWS        -->
    <!-- ==================== -->

    <!-- Document Version Tree View -->
    <record id="view_document_version_tree" model="ir.ui.view">
        <field name="name">project.document.version.tree</field>
        <field name="model">project.document.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="document_id"/>
                <field name="version_number"/>
                <field name="change_type" optional="show"/>
                <field name="change_summary" optional="show"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="effective_date"/>
                <field name="release_date"/>
                <field name="approved_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="review_date" optional="hide"/>
                <field name="attachment_id" widget="attachment_preview"/>
                <field name="distribution_count" string="Envoyés"/>
                <field name="pending_acknowledgment_count" string="En attente"/>
                <field name="is_current" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'review'"
                       decoration-warning="state == 'approved'"
                       decoration-success="state == 'released'"
                       decoration-muted="state == 'superseded'"
                       decoration-danger="state == 'withdrawn'"/>
            </list>
        </field>
    </record>

    <!-- Document Version Form View -->
    <record id="view_document_version_form" model="ir.ui.view">
        <field name="name">project.document.version.form</field>
        <field name="model">project.document.version</field>
        <field name="arch" type="xml">
            <form string="Version de document">
                <header>
                    <button name="action_submit_review" string="Soumettre pour révision" type="object"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approuver" type="object"
                            class="btn-primary" invisible="state not in ['draft', 'review']"/>
                    <button name="action_release" string="Publier" type="object"
                            class="btn-success" invisible="state not in ['draft', 'review', 'approved']"/>
                    <button name="action_withdraw" string="Retirer" type="object"
                            invisible="state not in ['draft', 'review', 'approved', 'released']"/>
                    <button name="action_set_draft" string="Remettre en brouillon" type="object"
                            invisible="state != 'withdrawn'"/>
                    <button name="action_create_distribution" string="Distribuer" type="object"
                            class="btn-secondary" invisible="state != 'released'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved,released"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_distributions" icon="fa-users">
                            <field name="distribution_count" widget="statinfo" string="Distributions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Version actuelle" bg_color="text-bg-success" invisible="not is_current"/>
                    <widget name="web_ribbon" title="Remplacé" bg_color="text-bg-warning" invisible="state != 'superseded'"/>
                    <widget name="web_ribbon" title="Retiré" bg_color="text-bg-danger" invisible="state != 'withdrawn'"/>
                    <div class="oe_title">
                        <label for="document_id" string="Document"/>
                        <h1>
                            <field name="document_id" options="{'no_create': True}"/>
                        </h1>
                        <h2>
                            Version <field name="version_number" class="oe_inline" placeholder="1.0"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="change_type"/>
                            <field name="change_summary" placeholder="ex: Mise à jour politique vacances"/>
                            <field name="author_id" widget="many2one_avatar_user"/>
                            <field name="previous_version_id"/>
                            <field name="is_current" invisible="1"/>
                            <field name="is_internal" invisible="1"/>
                        </group>
                        <group string="Dates">
                            <field name="effective_date"/>
                            <field name="expiration_date"/>
                            <field name="review_date"/>
                            <field name="release_date" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="state not in ['approved', 'released', 'superseded']">
                        <group string="Approbation">
                            <field name="approved_by_id" widget="many2one_avatar_user"/>
                            <field name="approval_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenu" name="content">
                            <group>
                                <field name="attachment_id" widget="attachment_preview"/>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                        <page string="Journal des modifications" name="changelog">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/> Utilisez le format Markdown pour structurer vos notes de modifications.
                            </div>
                            <field name="changelog" placeholder="## Modifications principales&#10;&#10;- Ajout de la section X&#10;- Mise à jour de la politique Y&#10;- Correction de l'erreur dans Z"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Document Version Search View -->
    <record id="view_document_version_search" model="ir.ui.view">
        <field name="name">project.document.version.search</field>
        <field name="model">project.document.version</field>
        <field name="arch" type="xml">
            <search string="Rechercher des versions">
                <field name="document_id"/>
                <field name="version_number"/>
                <field name="author_id"/>
                <field name="approved_by_id"/>
                <separator/>
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_review" string="En révision" domain="[('state', '=', 'review')]"/>
                <filter name="filter_approved" string="Approuvé" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_released" string="Publié" domain="[('state', '=', 'released')]"/>
                <filter name="filter_superseded" string="Remplacé" domain="[('state', '=', 'superseded')]"/>
                <filter name="filter_withdrawn" string="Retiré" domain="[('state', '=', 'withdrawn')]"/>
                <separator/>
                <filter name="filter_current" string="Versions actuelles" domain="[('is_current', '=', True)]"/>
                <filter name="filter_internal" string="Documents internes" domain="[('is_internal', '=', True)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="groupby_document" string="Document" context="{'group_by': 'document_id'}"/>
                    <filter name="groupby_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="groupby_change_type" string="Type de modification" context="{'group_by': 'change_type'}"/>
                    <filter name="groupby_author" string="Auteur" context="{'group_by': 'author_id'}"/>
                    <filter name="groupby_approved_by" string="Approuvé par" context="{'group_by': 'approved_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Document Version Action -->
    <record id="document_version_action" model="ir.actions.act_window">
        <field name="name">Versions de documents</field>
        <field name="res_model">project.document.version</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_document_version_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune version trouvée
            </p>
            <p>
                Créez des versions depuis le formulaire du document.
            </p>
        </field>
    </record>

    <!-- ==================== -->
    <!-- DISTRIBUTION VIEWS   -->
    <!-- ==================== -->

    <!-- Distribution Tree View -->
    <record id="view_document_distribution_tree" model="ir.ui.view">
        <field name="name">project.document.distribution.tree</field>
        <field name="model">project.document.distribution</field>
        <field name="arch" type="xml">
            <list decoration-warning="is_outdated" decoration-muted="state in ['superseded', 'recalled']">
                <field name="recipient_type" optional="hide"/>
                <field name="recipient_name"/>
                <field name="partner_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="document_name"/>
                <field name="version_number"/>
                <field name="is_internal" optional="show"/>
                <field name="distribution_date"/>
                <field name="distribution_method"/>
                <field name="distributed_by_id" widget="many2one_avatar_user"/>
                <field name="acknowledged_date"/>
                <field name="is_outdated" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'acknowledged'"
                       decoration-warning="state == 'superseded'"
                       decoration-danger="state == 'recalled'"/>
            </list>
        </field>
    </record>

    <!-- Distribution Kanban View -->
    <record id="view_document_distribution_kanban" model="ir.ui.view">
        <field name="name">project.document.distribution.kanban</field>
        <field name="model">project.document.distribution</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="recipient_name"/>
                <field name="recipient_type"/>
                <field name="document_name"/>
                <field name="version_number"/>
                <field name="state"/>
                <field name="is_outdated"/>
                <field name="is_internal"/>
                <field name="distribution_date"/>
                <field name="distributed_by_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="recipient_name"/>
                                    </strong>
                                    <span t-if="record.recipient_type.raw_value == 'employee'" class="badge text-bg-secondary ms-1" title="Employé">
                                        <i class="fa fa-user"/>
                                    </span>
                                </div>
                                <span t-if="record.is_outdated.raw_value" class="badge text-bg-warning">
                                    <i class="fa fa-exclamation-triangle" title="Version obsolète"/> Obsolète
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <span t-if="record.is_internal.raw_value" class="badge text-bg-info me-1" title="Document interne">
                                        <i class="fa fa-building"/>
                                    </span>
                                    <field name="document_name"/>
                                    <span class="badge text-bg-secondary ms-1">v<field name="version_number"/></span>
                                </div>
                                <div class="text-muted mt-1">
                                    <i class="fa fa-calendar"/> <field name="distribution_date"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left"/>
                                <div class="oe_kanban_bottom_right">
                                    <field name="distributed_by_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Distribution Form View -->
    <record id="view_document_distribution_form" model="ir.ui.view">
        <field name="name">project.document.distribution.form</field>
        <field name="model">project.document.distribution</field>
        <field name="arch" type="xml">
            <form string="Distribution de document">
                <header>
                    <button name="action_send_document" string="Envoyer le document" type="object"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_acknowledge" string="Marquer accusé reçu" type="object"
                            class="btn-secondary" invisible="state != 'pending'"/>
                    <button name="action_send_reminder" string="Envoyer un rappel" type="object"
                            class="btn-secondary" invisible="state != 'pending'"/>
                    <button name="action_send_update_notification" string="Notifier mise à jour" type="object"
                            class="btn-warning" invisible="not is_outdated or state not in ['pending', 'acknowledged']"/>
                    <button name="action_recall" string="Rappeler" type="object"
                            invisible="state in ['superseded', 'recalled']"/>
                    <button name="action_set_pending" string="Remettre en attente" type="object"
                            invisible="state not in ['acknowledged', 'recalled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,acknowledged"/>
                </header>
                <sheet>
                    <field name="has_file_or_url" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="has_file_or_url">
                        <strong>Aucun fichier ni lien externe</strong> — Le courriel sera envoyé sans pièce jointe.
                        Ajoutez un fichier dans la version ou un lien externe sur le document avant d'envoyer.
                    </div>
                    <widget name="web_ribbon" title="Obsolète" bg_color="text-bg-warning" invisible="not is_outdated"/>
                    <widget name="web_ribbon" title="Rappelé" bg_color="text-bg-danger" invisible="state != 'recalled'"/>
                    <widget name="web_ribbon" title="Document interne" bg_color="text-bg-info" invisible="not is_internal"/>
                    <group>
                        <group string="Document">
                            <field name="version_id" options="{'no_create': True}"/>
                            <field name="is_internal" invisible="1"/>
                            <field name="project_id" invisible="is_internal"/>
                            <field name="department_id" invisible="not is_internal"/>
                        </group>
                        <group string="Destinataire">
                            <field name="recipient_type" widget="radio"/>
                            <field name="partner_id" invisible="recipient_type != 'partner'" required="recipient_type == 'partner'"/>
                            <field name="user_id" invisible="recipient_type != 'employee'" required="recipient_type == 'employee'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Distribution">
                            <field name="distributed_by_id" widget="many2one_avatar_user"/>
                            <field name="distribution_date"/>
                            <field name="distribution_method"/>
                        </group>
                        <group string="Conformité" invisible="not is_internal">
                            <field name="requires_signature"/>
                            <field name="signature_date" invisible="not requires_signature"/>
                        </group>
                    </group>
                    <group string="Accusé de réception" invisible="state != 'acknowledged'">
                        <group>
                            <field name="acknowledged_date"/>
                            <field name="acknowledged_by_partner_id" invisible="recipient_type != 'partner'"/>
                            <field name="acknowledged_by_user_id" invisible="recipient_type != 'employee'"/>
                        </group>
                    </group>
                    <group string="Information sur la version" invisible="not is_outdated">
                        <group>
                            <field name="current_version_id" string="Dernière version disponible"/>
                            <field name="is_outdated" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notes additionnelles..."/>
                        <field name="compliance_notes" placeholder="Notes de conformité..." invisible="not is_internal"/>
                    </group>
                    <field name="document_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Distribution Search View -->
    <record id="view_document_distribution_search" model="ir.ui.view">
        <field name="name">project.document.distribution.search</field>
        <field name="model">project.document.distribution</field>
        <field name="arch" type="xml">
            <search string="Rechercher des distributions">
                <field name="recipient_name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="document_id"/>
                <field name="version_id"/>
                <field name="distributed_by_id"/>
                <separator/>
                <filter name="filter_pending" string="En attente" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_acknowledged" string="Accusé reçu" domain="[('state', '=', 'acknowledged')]"/>
                <filter name="filter_superseded" string="Remplacé" domain="[('state', '=', 'superseded')]"/>
                <filter name="filter_recalled" string="Rappelé" domain="[('state', '=', 'recalled')]"/>
                <separator/>
                <filter name="filter_active" string="Actifs" domain="[('state', 'in', ['pending', 'acknowledged'])]"/>
                <filter name="filter_outdated" string="Obsolètes" domain="[('is_outdated', '=', True)]"/>
                <separator/>
                <filter name="filter_internal" string="Documents internes" domain="[('is_internal', '=', True)]"/>
                <filter name="filter_external" string="Documents clients" domain="[('is_internal', '=', False)]"/>
                <separator/>
                <filter name="filter_employees" string="Employés" domain="[('recipient_type', '=', 'employee')]"/>
                <filter name="filter_clients" string="Clients" domain="[('recipient_type', '=', 'partner')]"/>
                <separator/>
                <filter name="filter_my_distributions" string="Distribués par moi" domain="[('distributed_by_id', '=', uid)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="groupby_recipient_type" string="Type de destinataire" context="{'group_by': 'recipient_type'}"/>
                    <filter name="groupby_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_user" string="Employé" context="{'group_by': 'user_id'}"/>
                    <filter name="groupby_document" string="Document" context="{'group_by': 'document_id'}"/>
                    <filter name="groupby_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="groupby_method" string="Méthode" context="{'group_by': 'distribution_method'}"/>
                    <filter name="groupby_internal" string="Interne/Client" context="{'group_by': 'is_internal'}"/>
                    <filter name="groupby_distributed_by" string="Distribué par" context="{'group_by': 'distributed_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Distribution Actions -->
    <record id="document_distribution_action" model="ir.actions.act_window">
        <field name="name">Distributions</field>
        <field name="res_model">project.document.distribution</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_document_distribution_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune distribution
            </p>
            <p>
                Distribuez des versions de documents à vos clients ou employés pour suivre qui a quoi.
            </p>
        </field>
    </record>

    <record id="document_distribution_action_internal" model="ir.actions.act_window">
        <field name="name">Accusés de réception internes</field>
        <field name="res_model">project.document.distribution</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_document_distribution_search"/>
        <field name="domain">[('is_internal', '=', True)]</field>
        <field name="context">{'search_default_filter_active': 1, 'default_recipient_type': 'employee'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun accusé de réception interne
            </p>
            <p>
                Suivez les accusés de réception des employés pour les politiques et procédures internes.
            </p>
        </field>
    </record>

    <record id="document_distribution_action_outdated" model="ir.actions.act_window">
        <field name="name">Documentation obsolète</field>
        <field name="res_model">project.document.distribution</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_document_distribution_search"/>
        <field name="domain">[('is_outdated', '=', True), ('state', 'in', ['pending', 'acknowledged'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune distribution obsolète
            </p>
            <p>
                Les clients ou employés ayant des versions obsolètes de documentation apparaîtront ici.
            </p>
        </field>
    </record>

    <!-- ==================== -->
    <!-- PARTNER INTEGRATION  -->
    <!-- ==================== -->

    <!-- Extend Partner Form: Add Documents Smart Button -->
    <record id="view_partner_form_inherit_documents" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.documents</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_documents"
                        icon="fa-file-text-o"
                        invisible="document_distribution_count == 0"
                        groups="project_knowledge_matrix.group_document_user">
                    <div class="d-flex flex-column align-items-center">
                        <field name="document_distribution_count" widget="statinfo" string="Documents"/>
                        <span class="text-warning" invisible="outdated_document_count == 0">
                            <i class="fa fa-exclamation-triangle" title="Documents obsolètes"/>
                            <field name="outdated_document_count" class="oe_inline"/> obsolètes
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
