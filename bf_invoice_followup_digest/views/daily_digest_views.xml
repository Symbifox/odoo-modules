<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_digest_config_form_invoice_followup" model="ir.ui.view">
        <field name="name">daily.digest.config.form.invoice.followup</field>
        <field name="model">daily.digest.config</field>
        <field name="inherit_id" ref="daily_todo_digest.view_daily_digest_config_form"/>
        <field name="arch" type="xml">
            <field name="include_quote" position="after">
                <field name="include_overdue_invoices"/>
                <field name="overdue_invoice_min_days"
                       invisible="not include_overdue_invoices"/>
            </field>
        </field>
    </record>
</odoo>
