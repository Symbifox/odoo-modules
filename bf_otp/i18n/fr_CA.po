msgid "to confirm"
msgstr "pour confirmer"

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/xml/otp_app.xml:0
msgid "token(s) inside."
msgstr "token(s) à l'intérieur."

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/xml/otp_app.xml:0
msgid ""
"token(s), encrypted with the passphrase you choose here. It is built in this"
" page: the server takes no part in it and keeps nothing of it."
msgstr ""
"token(s), chiffrés par la phrase\n"
"                            que vous choisissez ici. Il se fabrique dans cette page : le serveur\n"
"                            n'y participe pas et n'en garde rien."

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/xml/otp_app.xml:0
msgid "two letters are enough"
msgstr "deux lettres suffisent"

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/js/otp_app.js:0
msgid "vault"
msgstr "coffre"

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/xml/otp_app.xml:0
msgid "via the QR code, or the device's built-in manager when it has one."
msgstr ""
"en passant par le code QR, ou le gestionnaire\n"
"                                intégré de l'appareil quand il y en a un."

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/xml/otp_app.xml:0
msgid ""
"with your provider, under the name \"Symbifox Tokens\". Remove it, it will "
"never work."
msgstr ""
"chez votre fournisseur, sous le nom « Symbifox Tokens ». Retirez-la, elle ne"
" servira jamais."

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/xml/otp_app.xml:0
msgid "{\"accounts\": [ … ]}   ·   otpauth-migration://offline?data=…"
msgstr "{\"accounts\": [ … ]}   ·   otpauth-migration://offline?data=…"

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/xml/otp_app.xml:0
msgid "· used on"
msgstr "· a servi le"

#. module: bf_otp
#. odoo-javascript
#: code:addons/bf_otp/static/src/xml/otp_app.xml:0
msgid ""
"⚠️ Bitwarden is in this situation: its extension does create the key, but "
"does not return PRF."
msgstr ""
"⚠️ Bitwarden est dans ce cas : son extension crée bien la\n"
"                                    clé, mais ne rend pas PRF."
