<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_activity_form_session" model="ir.ui.view">
        <field name="name">bf.training.activity.form.session</field>
        <field name="model">bf.training.activity</field>
        <field name="inherit_id" ref="bf_training.view_training_activity_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_events" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="not event_count">
                    <field name="event_count" widget="statinfo" string="Séances"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
