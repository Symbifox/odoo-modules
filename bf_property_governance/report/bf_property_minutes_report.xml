<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Format Lettre, comme l'attestation : c'est le format des documents
         d'affaires au Québec, et le procès-verbal se classe au registre de
         l'art. 1070 à côté d'eux. -->
    <record id="paperformat_minutes" model="report.paperformat">
        <field name="name">Procès-verbal (Lettre)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_assembly_minutes" model="ir.actions.report">
        <field name="name">Procès-verbal de l'assemblée</field>
        <field name="model">bf.property.assembly</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_property_governance.report_minutes</field>
        <field name="report_file">bf_property_governance.report_minutes</field>
        <field name="print_report_name">'PV_assemblee_%s' % object._report_minutes_date()</field>
        <field name="binding_model_id" ref="model_bf_property_assembly"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_minutes"/>
    </record>

    <record id="action_report_council_minutes" model="ir.actions.report">
        <field name="name">Procès-verbal de la réunion du conseil</field>
        <field name="model">bf.property.council.meeting</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_property_governance.report_minutes</field>
        <field name="report_file">bf_property_governance.report_minutes</field>
        <field name="print_report_name">'PV_conseil_%s' % object._report_minutes_date()</field>
        <field name="binding_model_id" ref="model_bf_property_council_meeting"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_minutes"/>
    </record>

</odoo>
