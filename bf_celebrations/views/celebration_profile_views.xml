<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==============================================================
         La page « Mes célébrations ». Elle explique avant de demander :
         un consentement obtenu sans dire ce qu'on en fait n'en est pas un.
         ============================================================== -->
    <record id="view_celebration_profile_self_form" model="ir.ui.view">
        <field name="name">bf.celebration.profile.self.form</field>
        <field name="model">bf.celebration.profile</field>
        <field name="arch" type="xml">
            <form string="My celebrations">
                <sheet>
                    <div class="oe_title">
                        <h1>My celebrations</h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        Your answer is visible to you alone. It does not
                        touch your date of birth on the HR record,
                        which this module neither reads nor shows.
                        You can change your mind at any time, and the
                        withdrawal is immediate.
                    </div>
                    <group>
                        <group string="What I would like">
                            <field name="consent" widget="radio"
                                   nolabel="1"/>
                        </group>
                        <group string="The date to mark"
                               invisible="consent in ('pending', 'none')">
                            <label for="celebration_day" string="Day and month"/>
                            <div class="o_row">
                                <field name="celebration_day"
                                       required="consent in ('full','quiet')"
                                       class="oe_inline" style="max-width:70px"/>
                                <field name="celebration_month"
                                       required="consent in ('full','quiet')"
                                       class="oe_inline"/>
                            </div>
                            <field name="share_work_anniversary"/>
                        </group>
                    </group>
                    <group invisible="consent != 'none'">
                        <div class="text-muted">
                            You will appear nowhere, and you will no longer
                            receive invitations to answer.
                        </div>
                    </group>
                    <group string="Keep my cards" invisible="consent == 'none'">
                        <field name="keepsake_email" widget="email"
                               placeholder="vous@exemple.com"/>
                        <div class="text-muted" colspan="2">
                            Optional. A card delivered in the system disappears
                            with your account, then with the purge set by the
                            retention policy. The same delivery arrives at this
                            address, as a PDF and as a page to keep. Nobody
                            else sees this address.
                        </div>
                    </group>
                    <field name="employee_id" invisible="1"/>
                    <field name="consent_date" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue technique, réservée au groupe système : elle ne sert qu'au
         dépannage, la règle globale la vide pour tout le monde d'autre. -->
    <record id="view_celebration_profile_list" model="ir.ui.view">
        <field name="name">bf.celebration.profile.list</field>
        <field name="model">bf.celebration.profile</field>
        <field name="arch" type="xml">
            <list string="Profiles">
                <field name="employee_id"/>
                <field name="consent"/>
                <field name="celebration_day"/>
                <field name="celebration_month"/>
                <field name="consent_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_mon_profil" model="ir.actions.server">
        <field name="name">My celebrations</field>
        <field name="model_id" ref="model_bf_celebration_profile"/>
        <field name="state">code</field>
        <field name="code">action = model.action_mon_profil()</field>
    </record>

    <record id="action_celebration_profile_admin" model="ir.actions.act_window">
        <field name="name">Celebration profiles</field>
        <field name="res_model">bf.celebration.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to see here, and that is deliberate</p>
            <p>The global record rule limits reading to one's
               own profile. This list only fills up for the
               superuser, for troubleshooting.</p>
        </field>
    </record>

</odoo>
