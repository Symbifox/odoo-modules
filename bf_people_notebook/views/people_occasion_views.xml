<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_people_occasion_list" model="ir.ui.view">
        <field name="name">bf.people.occasion.list</field>
        <field name="model">bf.people.occasion</field>
        <field name="arch" type="xml">
            <list string="Occasions" editable="bottom">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="person_count" string="People"/>
                <button name="action_open_people" type="object" string="People" icon="fa-users"/>
            </list>
        </field>
    </record>

    <record id="view_people_occasion_search" model="ir.ui.view">
        <field name="name">bf.people.occasion.search</field>
        <field name="model">bf.people.occasion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="mine" string="Mine" domain="[('user_id', '=', uid)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_people_occasion" model="ir.actions.act_window">
        <field name="name">Occasions</field>
        <field name="res_model">bf.people.occasion</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Group the people you meet by occasion</p>
            <p>A trip, an event, a season: Gaspésie 2026, a wedding, a summer camp.</p>
        </field>
    </record>
</odoo>
