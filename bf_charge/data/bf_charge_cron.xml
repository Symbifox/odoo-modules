<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ⚠️ Livré INACTIF exprès. Un relevé pris avant qu'une capacité soit
             déclarée archive des zéros qui auront l'air d'une mesure. -->
        <record id="cron_bf_charge_snapshot" model="ir.cron">
            <field name="name">Plan de charge : relevé hebdomadaire</field>
            <field name="model_id" ref="model_bf_charge_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._cron_capture()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=7)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="active" eval="False"/>
            <field name="priority">30</field>
        </record>
    </data>
</odoo>
