<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_property_ownership_list" model="ir.ui.view">
        <field name="name">bf.property.ownership.list</field>
        <field name="model">bf.property.ownership</field>
        <field name="arch" type="xml">
            <list decoration-muted="not is_current">
                <field name="unit_id"/>
                <field name="partner_id"/>
                <field name="share"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current"/>
                <field name="syndicat_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_property_ownership_form" model="ir.ui.view">
        <field name="name">bf.property.ownership.form</field>
        <field name="model">bf.property.ownership</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="unit_id"/>
                            <field name="partner_id"/>
                            <field name="share"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_current" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_property_ownership_search" model="ir.ui.view">
        <field name="name">bf.property.ownership.search</field>
        <field name="model">bf.property.ownership</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="unit_id"/>
                <filter name="current" string="En cours" domain="[('is_current', '=', True)]"/>
                <filter name="past" string="Anciens" domain="[('is_current', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_partner" string="Copropriétaire"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_syndicat" string="Syndicat"
                            context="{'group_by': 'syndicat_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_property_ownership" model="ir.actions.act_window">
        <field name="name">Copropriétaires</field>
        <field name="res_model">bf.property.ownership</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
    </record>

</odoo>
