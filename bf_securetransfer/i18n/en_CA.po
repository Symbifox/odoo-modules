#. module: bf_securetransfer
#: model_terms:ir.ui.view,arch_db:bf_securetransfer.report_access_certificate_document
msgid ""
"<strong>Comment vérifier ce certificat sans nous faire confiance.</strong>\n"
"                    Chaque entrée porte une empreinte\n"
"                    <span style=\"font-family:monospace;\">SHA-256(empreinte précédente + charge utile canonique)</span>,\n"
"                    où la charge utile est le JSON trié des champs de l'entrée\n"
"                    (identifiant et nom du transfert, action, horodatage UTC, IP,\n"
"                    agent utilisateur, acteur, note) et où la première entrée part\n"
"                    d'une empreinte vide. Modifier, retirer ou intercaler une seule\n"
"                    entrée casse toutes les empreintes suivantes."
msgstr ""
"<strong>How to verify this certificate without trusting us.</strong>\n"
"                    Every entry carries a\n"
"                    <span style=\"font-family:monospace;\">SHA-256(previous hash + canonical payload)</span>\n"
"                    hash, where the payload is the sorted JSON of the entry's fields\n"
"                    (transfer id and name, action, UTC timestamp, IP, user agent,\n"
"                    actor, note) and where the first entry starts from an empty\n"
"                    hash. Altering, removing or inserting a single entry breaks\n"
"                    every hash that follows."

#. module: bf_securetransfer
#: model:mail.template,body_html:bf_securetransfer.mail_template_download_notice
msgid ""
"<t t-set=\"visuals\" t-value=\"object.brand_id._visuals()\"/>\n"
"                <t t-set=\"base\" t-value=\"object.brand_id._share_base_url()\"/>\n"
"                <t t-set=\"primary\" t-value=\"visuals['primary']\"/>\n"
"                <t t-set=\"dark\" t-value=\"visuals['dark']\"/>\n"
"                <t t-set=\"logo_src\" t-value=\"visuals['logo_url'] and (visuals['logo_url'].startswith('http') and visuals['logo_url'] or base + visuals['logo_url']) or False\"/>\n"
"                <div style=\"font-family:Lexend,system-ui,Arial,sans-serif; color:#2D3031; font-size:14px; line-height:1.55; max-width:600px; margin:0 auto;\">\n"
"                    <div t-attf-style=\"background:#{dark}; padding:18px 24px; border-radius:10px 10px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tbody><tr>\n"
"                            <td align=\"left\" style=\"vertical-align:middle;\">\n"
"                                <img t-if=\"logo_src\" t-att-src=\"logo_src\" t-att-alt=\"visuals['name']\" style=\"height:36px; display:block; border:0;\"/>\n"
"                                <span t-else=\"\" style=\"color:#ffffff; font-size:18px; font-weight:700;\" t-out=\"visuals['name']\"/>\n"
"                            </td>\n"
"                            <td align=\"right\" style=\"vertical-align:middle; color:#ffffff; font-family:Lexend,system-ui,Arial,sans-serif; font-size:20px; font-weight:700;\">Téléchargement</td>\n"
"                        </tr></tbody></table>\n"
"                    </div>\n"
"                    <div t-attf-style=\"height:4px; background:#{primary};\"/>\n"
"                    <div style=\"background:#ffffff; border:1px solid #e3e7eb; border-top:0; padding:24px; border-radius:0 0 10px 10px;\">\n"
"                        <p>Bonjour <t t-out=\"object.sender_name or ''\"/>,</p>\n"
"                        <p>Vos fichiers partagés (<strong t-out=\"object.name\"/>) viennent d'être téléchargés.</p>\n"
"                        <p style=\"color:#777; font-size:12px;\">Ce transfert reste accessible jusqu'à son expiration le\n"
"                            <strong t-out=\"format_date(object.expiry_date, lang_code=object.locale)\"/>.</p>\n"
"                    </div>\n"
"                    <div style=\"text-align:center; color:#9aa4ad; font-size:12px; padding:14px;\">\n"
"                        <div t-if=\"visuals['tagline']\" style=\"margin-bottom:6px;\" t-out=\"visuals['tagline']\"/>\n"
"                        <t t-if=\"visuals['powered_by']\">Propulsé par <t t-out=\"visuals['powered_by_name']\"/></t>\n"
"                        <div t-if=\"visuals['footer_html']\" style=\"margin-top:8px; color:#9aa4ad;\" t-out=\"visuals['footer_html']\"/>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""

#. module: bf_securetransfer
#: model:mail.template,body_html:bf_securetransfer.mail_template_transfer_link
msgid ""
"<t t-set=\"visuals\" t-value=\"object.brand_id._visuals()\"/>\n"
"                <t t-set=\"base\" t-value=\"object.brand_id._share_base_url()\"/>\n"
"                <t t-set=\"primary\" t-value=\"visuals['primary']\"/>\n"
"                <t t-set=\"dark\" t-value=\"visuals['dark']\"/>\n"
