<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Les dépôts du portail se lisent comme le projet qui les porte. Sans ces
         règles, un usager de Projet lisait les dépôts (nom de fichier, IP, pièce
         jointe) d'un projet privé ou d'une autre société. Les domaines reprennent
         ceux de `project.project` (project_public_members_rule, project_comp_rule,
         project_project_manager_rule). -->

    <record id="bf_progression_deposit_comp_rule" model="ir.rule">
        <field name="name">Progression deposit: multi-company</field>
        <field name="model_id" ref="model_bf_progression_deposit"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="bf_progression_deposit_user_rule" model="ir.rule">
        <field name="name">Progression deposit: deposits of the projects the user can read</field>
        <field name="model_id" ref="model_bf_progression_deposit"/>
        <field name="domain_force">['|',
                                        ('project_id.privacy_visibility', '!=', 'followers'),
                                        ('project_id.message_partner_ids', 'in', [user.partner_id.id])
                                    ]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="bf_progression_deposit_manager_rule" model="ir.rule">
        <field name="name">Progression deposit: project administrator sees all</field>
        <field name="model_id" ref="model_bf_progression_deposit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

</odoo>
