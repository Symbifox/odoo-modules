<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bf_bloc_notes.Systray">
        <div class="o_bf_note_systray d-flex align-items-center">
            <button class="btn btn-link text-reset p-1 opacity-75 opacity-100-hover"
                    title="New note (Alt+N); right-click or Alt+Shift+N for the list"
                    t-on-click="onClickNew"
                    t-on-contextmenu="onClickList">
                <i class="fa fa-sticky-note-o fs-5"/>
            </button>
        </div>
    </t>

    <t t-name="bf_bloc_notes.QuickCreateDialog">
        <Dialog title="title" size="'lg'" contentClass="'o_bf_note_quick_create'">
            <div class="o_bf_note_quick_create_body">
                <div t-if="state.linkedLabel" class="alert alert-info py-2 mb-2 small">
                    <i class="fa fa-link"/> Linked to: <strong t-esc="state.linkedLabel"/>
                </div>
                <input type="text"
                       class="form-control mb-2"
                       placeholder="Title (optional, filled in from the content)"
                       t-ref="title"
                       t-on-keydown="onKeydownTitle"
                       t-model="state.name"/>
                <div class="o_bf_note_editor form-control"
                     contenteditable="true"
                     t-ref="body"
                     t-on-keydown="onKeydownBody"
                     t-on-paste="onPasteBody"
                     t-on-drop="onDropBody"
                     t-on-dragover="onDragOverBody"
                     style="min-height: 220px; max-height: 60vh; overflow-y: auto;"/>
                <div class="text-muted small mt-1">
                    <i class="fa fa-image"/> You can paste or drag an image straight into the text area.
                </div>
                <div class="form-check mt-2">
                    <input type="checkbox"
                           id="bf_note_pinned"
                           class="form-check-input"
                           t-model="state.pinned"/>
                    <label for="bf_note_pinned" class="form-check-label">
                        <i class="fa fa-thumb-tack"/> Pin
                    </label>
                </div>
                <div class="o_bf_note_reminder mt-3">
                    <div class="text-muted small mb-1">
                        <i class="fa fa-bell-o"/> Reminder
                    </div>
                    <div class="btn-group btn-group-sm flex-wrap" role="group">
                        <button type="button"
                                class="btn"
                                t-att-class="state.reminderKey === 'none' ? 'btn-secondary' : 'btn-outline-secondary'"
                                t-on-click="() => this.setReminder('none')">
                            None
                        </button>
                        <button type="button"
                                class="btn"
                                t-att-class="state.reminderKey === 'today' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setReminder('today')">
                            🗓️ Today
                        </button>
                        <button type="button"
                                class="btn"
                                t-att-class="state.reminderKey === 'tomorrow' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setReminder('tomorrow')">
                            Tomorrow
                        </button>
                        <button type="button"
                                class="btn"
                                t-att-class="state.reminderKey === '2days' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setReminder('2days')">
                            +2 days
                        </button>
                        <button type="button"
                                class="btn"
                                t-att-class="state.reminderKey === '1week' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setReminder('1week')">
                            +1 week
                        </button>
                        <button type="button"
                                class="btn"
                                t-att-class="state.reminderKey === 'custom' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setReminder('custom')">
                            Customise…
                        </button>
                    </div>
                    <input t-if="state.reminderKey === 'custom'"
                           type="date"
                           class="form-control form-control-sm mt-2"
                           style="max-width: 220px;"
                           t-model="state.reminderDate"/>
                </div>
                <div class="text-muted small mt-2">
                    <kbd>Ctrl+Enter</kbd> to save
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary"
                        t-on-click="onSave"
                        t-att-disabled="state.saving">
                    <i class="fa fa-floppy-o"/> Save
                </button>
                <button class="btn btn-secondary"
                        t-on-click="onCreateTask"
                        t-att-disabled="state.saving"
                        title="Create a task with this title and content instead">
                    <i class="fa fa-tasks"/> Create a task
                </button>
                <button class="btn btn-secondary"
                        t-on-click="onSaveAndOpen"
                        t-att-disabled="state.saving">
                    Save + open the list
                </button>
                <button class="btn btn-link" t-on-click="onCancel">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
