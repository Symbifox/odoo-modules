#: model:ir.model.fields,field_description:bf_cx_ai.field_res_config_settings__bf_cx_ai_auto_analyze
#: model_terms:ir.ui.view,arch_db:bf_cx_ai.res_config_settings_view_form
msgid "Automatic AI analysis of verbatims"
msgstr "Analyse IA automatique des verbatims"

#. module: bf_cx_ai
#: model:ir.actions.server,name:bf_cx_ai.ir_cron_cx_ai_auto_analyze_ir_actions_server
msgid "Customer experience: AI analysis of verbatims"
msgstr "Expérience client : analyse IA des verbatims"

#. module: bf_cx_ai
#: model_terms:ir.ui.view,arch_db:bf_cx_ai.res_config_settings_view_form
msgid ""
"Every day, analyze (sentiment, themes, summary) up to 20 recent unanalyzed "
"comments through the AI bridge: the comments' text is sent to the AI model."
msgstr ""
"Chaque jour, analyser (sentiment, thèmes, résumé) jusqu'à 20 commentaires "
"récents non analysés par le pont IA : le texte des commentaires est transmis"
" au modèle d'IA."

