<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_key_door_list" model="ir.ui.view">
        <field name="name">bf.key.door.list</field>
        <field name="model">bf.key.door</field>
        <field name="arch" type="xml">
            <list string="Doors">
                <field name="area_id"/>
                <field name="name"/>
                <field name="lock_kind"/>
                <field name="keyed_type_id" groups="bf_key_management.group_key_area_manager"/>
                <field name="nmk" width="140px" groups="bf_key_management.group_key_area_manager" optional="hide"/>
                <field name="holder_count" width="105px" groups="bf_key_management.group_key_area_manager" string="Holders"/>
            </list>
        </field>
    </record>

    <record id="view_bf_key_door_search" model="ir.ui.view">
        <field name="name">bf.key.door.search</field>
        <field name="model">bf.key.door</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="area_id"/>
                <field name="keyed_type_id" groups="bf_key_management.group_key_area_manager"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="by_area" string="Area" context="{'group_by': 'area_id'}"/>
                    <filter name="by_lock" string="Lock" context="{'group_by': 'lock_kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bf_key_door_form" model="ir.ui.view">
        <field name="name">bf.key.door.form</field>
        <field name="model">bf.key.door</field>
        <field name="arch" type="xml">
            <form string="Door">
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="bf_key_management.group_key_area_manager">
                        <button name="action_view_holders" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="holder_count" widget="statinfo" string="Can open it"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Server room"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="area_id"/>
                            <field name="lock_kind"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group groups="bf_key_management.group_key_area_manager">
                            <field name="system_id"/>
                            <field name="cylinder_ref"/>
                            <field name="keyed_type_id"/>
                            <field name="nmk"/>
                            <field name="extra_type_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" groups="bf_key_management.group_key_area_manager" invisible="not cross_keyed">
                        Cross keyed: this cylinder also takes a key from another branch. Guides advise
                        against it; check that it is intended.
                        <field name="cross_keyed" invisible="1"/>
                    </div>
                    <notebook groups="bf_key_management.group_key_area_manager">
                        <page string="Opened by" name="openers">
                            <field name="opener_type_ids" readonly="1">
                                <list>
                                    <field name="symbol" width="105px"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="level"/>
                                    <field name="issued_count" width="120px"/>
                                </list>
                            </field>
                        </page>
                        <page string="Who can open it" name="holders">
                            <field name="holder_assignment_ids" readonly="1">
                                <list>
                                    <field name="holder_label"/>
                                    <field name="copy_id"/>
                                    <field name="date_issued" options="{'show_time': false}" width="105px"/>
                                    <field name="date_due" width="125px"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bf_key_door" model="ir.actions.act_window">
        <field name="name">Doors</field>
        <field name="res_model">bf.key.door</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a door</p>
            <p>Say which key its cylinder is keyed to: every master above that key opens it too,
               unless it is not master keyed.</p>
        </field>
    </record>
</odoo>
