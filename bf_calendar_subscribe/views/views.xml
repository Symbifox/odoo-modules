<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_calendar_subscription_view_list" model="ir.ui.view">
        <field name="name">bf.calendar.subscription.list</field>
        <field name="model">bf.calendar.subscription</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'error'" decoration-muted="not active">
                <field name="name"/>
                <field name="color_hex" widget="bf_color"/>
                <field name="state"/>
                <field name="last_fetch"/>
                <field name="event_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="bf_calendar_subscription_view_form" model="ir.ui.view">
        <field name="name">bf.calendar.subscription.form</field>
        <field name="model">bf.calendar.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh" type="object" string="Refresh now"
                            class="btn-primary" invisible="not id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_events" type="object" icon="fa-calendar"
                                invisible="not id">
                            <field name="event_count" widget="statinfo" string="Events"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Main client (Outlook)"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <field name="last_error" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="url" widget="url" password="False"/>
                            <field name="color_hex" widget="bf_color"/>
                            <field name="privacy"/>
                        </group>
                        <group>
                            <field name="import_free"/>
                            <field name="import_location"/>
                            <field name="refresh_minutes"/>
                            <field name="past_days"/>
                            <field name="future_days"/>
                            <field name="last_fetch"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Read only: events from this calendar are changed in that calendar, never here.
                        Their busy times close online booking slots. Only open standards are used
                        (iCalendar over https); in Outlook, publish the calendar and paste its ICS link.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_calendar_subscription_action" model="ir.actions.act_window">
        <field name="name">External calendars</field>
        <field name="res_model">bf.calendar.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Show another calendar in yours</p>
            <p>Paste the address a calendar publishes (Outlook, Google, Apple, Nextcloud).
               Its events appear in your calendar in their own colour, read only, and its
               busy times are no longer offered for online booking.</p>
        </field>
    </record>

    <record id="bf_calendar_subscription_menu_root" model="ir.ui.menu">
        <field name="name">External calendars</field>
        <field name="parent_id" ref="calendar.mail_menu_calendar"/>
        <field name="action" ref="bf_calendar_subscription_action"/>
        <field name="sequence">25</field>
    </record>
</odoo>
