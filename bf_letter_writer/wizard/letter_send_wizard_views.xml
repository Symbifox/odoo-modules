<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="letter_send_wizard_form" model="ir.ui.view">
        <field name="name">letter.send.wizard.form</field>
        <field name="model">letter.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Envoyer la lettre">
                <group>
                    <field name="letter_id" invisible="1"/>
                    <field name="recipient_ids" widget="many2many_tags"/>
                    <field name="subject"/>
                    <field name="attach_pdf"/>
                </group>
                <field name="body"/>
                <group invisible="not preview_url">
                    <div class="alert alert-success" role="alert">
                        <i class="fa fa-check-circle"/>
                        Aperçu généré &#8212; cliquez le lien pour l'ouvrir :
                        <field name="preview_url" widget="url" nolabel="1"/>
                    </div>
                </group>
                <footer>
                    <button name="action_preview_pdf" type="object"
                            string="Prévisualiser PDF" class="btn-secondary"
                            icon="fa-file-pdf-o"/>
                    <button name="action_send" type="object"
                            string="Envoyer" class="btn-primary"
                            icon="fa-paper-plane"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
