"                            </div>\n"
"                            <div t-if=\"sig['phone']\">\n"
"                                <a t-att-href=\"sig['phone_href']\" t-attf-style=\"color:{{ sig['text_color'] }};text-decoration:none;\"><t t-out=\"sig['phone']\"/></a>\n"
