<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_digest_config_form_hour_bank" model="ir.ui.view">
        <field name="name">daily.digest.config.form.hour.bank</field>
        <field name="model">daily.digest.config</field>
        <field name="inherit_id" ref="daily_todo_digest.view_daily_digest_config_form"/>
        <field name="arch" type="xml">
            <field name="include_quote" position="after">
                <field name="include_hour_bank_thresholds"/>
                <field name="hour_bank_threshold_days"
                       invisible="not include_hour_bank_thresholds"/>
                <field name="hour_bank_flag_unset"
                       invisible="not include_hour_bank_thresholds"/>
            </field>
        </field>
    </record>
</odoo>
