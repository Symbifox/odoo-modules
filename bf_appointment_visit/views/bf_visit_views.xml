<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_visit_form" model="ir.ui.view">
        <field name="name">bf.visit.form</field>
        <field name="model">bf.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Accepter"
                            class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_decline" type="object" string="Refuser"
                            invisible="state not in ('requested', 'approved')"/>
                    <button name="action_mark_arrived" type="object" string="Constater l'arrivée"
                            class="btn-primary"
                            invisible="arrived_at or state not in ('requested', 'approved')"/>
                    <button name="action_mark_departed" type="object" string="Constater le départ"
                            invisible="not arrived_at or departed_at"/>
                    <button name="action_mark_no_show" type="object" string="Personne ne s'est présenté"
                            invisible="arrived_at or state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('done', 'cancelled', 'no_show')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="listing_id" options="{'no_create': True}"/></h2>
                    </div>
                    <div class="alert alert-info" role="status" invisible="not arrived_at">
                        Le registre est fermé depuis l'arrivée. Une correction reste possible
                        pour un gestionnaire, et elle laisse une trace au dossier.
                    </div>
                    <group>
                        <group string="Le rendez-vous">
                            <field name="start"/>
                            <field name="duration" widget="float_time"/>
                            <field name="booking_id" readonly="1"/>
                            <field name="is_walkin" readonly="1"/>
                            <field name="accompanied_by_id"/>
                        </group>
                        <group string="Le visiteur">
                            <field name="visitor_name"/>
                            <field name="visitor_email" widget="email"/>
                            <field name="visitor_phone" widget="phone"/>
                            <field name="visitor_count"/>
                            <field name="visitor_partner_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Représentation (à poser à la première occasion)">
                        <group>
                            <field name="representation"/>
                            <field name="representation_asked_at" readonly="1"/>
                        </group>
                        <group invisible="representation != 'broker'">
                            <field name="buyer_broker_name"/>
                            <field name="buyer_broker_agency"/>
                            <field name="buyer_broker_email" widget="email"/>
                            <field name="buyer_broker_phone" widget="phone"/>
                        </group>
                    </group>
                    <group string="Identité et présence">
                        <group>
                            <field name="identity_method"/>
                            <field name="identity_doc_kind"/>
                            <button name="action_confirm_identity" type="object"
                                    string="Consigner la vérification" class="btn-secondary"
                                    invisible="identity_checked"/>
                            <field name="identity_checked" readonly="1"/>
                            <field name="identity_checked_by" readonly="1"
                                   invisible="not identity_checked"/>
                            <field name="identity_checked_at" readonly="1"
                                   invisible="not identity_checked"/>
                        </group>
                        <group>
                            <field name="arrived_at" readonly="1"/>
                            <field name="departed_at" readonly="1"/>
                            <field name="access_released" readonly="1"/>
                            <field name="tenant_notice_sent_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Décision du vendeur" name="seller">
                            <group>
                                <field name="seller_decision_at" readonly="1"/>
                                <field name="proposed_start"/>
                                <field name="seller_note"/>
                                <field name="url_decision" widget="CopyClipboardChar"
                                       groups="bf_appointment_visit.group_bf_visit_manager"/>
                            </group>
                        </page>
                        <page string="Après la visite" name="feedback">
                            <group>
                                <group>
                                    <field name="feedback_interest"/>
                                    <field name="feedback_price"/>
                                    <field name="feedback_received_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="feedback_shared"/>
                                </group>
                            </group>
                            <field name="feedback_comment"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bf_visit_list" model="ir.ui.view">
        <field name="name">bf.visit.list</field>
        <field name="model">bf.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start"/>
                <field name="listing_id"/>
                <field name="visitor_name"/>
                <field name="representation" optional="show"/>
                <field name="identity_checked" optional="show" widget="boolean_toggle" readonly="1"/>
                <field name="arrived_at" optional="hide"/>
                <field name="accompanied_by_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('approved', 'done')"
                       decoration-warning="state == 'requested'"
                       decoration-danger="state in ('declined', 'no_show')"/>
            </list>
        </field>
    </record>

    <record id="view_bf_visit_calendar" model="ir.ui.view">
        <field name="name">bf.visit.calendar</field>
        <field name="model">bf.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="start" color="listing_id" mode="week"
                      event_open_popup="1" quick_create="0">
                <field name="listing_id"/>
                <field name="visitor_name"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_bf_visit_search" model="ir.ui.view">
        <field name="name">bf.visit.search</field>
        <field name="model">bf.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="visitor_name"/>
                <field name="listing_id"/>
                <field name="buyer_broker_name"/>
                <filter name="upcoming" string="À venir"
                        domain="[('start', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="to_decide" string="En attente de décision"
                        domain="[('state', '=', 'requested')]"/>
                <filter name="unverified" string="Identité non vérifiée"
                        domain="[('identity_checked', '=', False), ('state', 'in', ('approved', 'done'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_listing" string="Inscription"
                            context="{'group_by': 'listing_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mois" context="{'group_by': 'start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_visit" model="ir.actions.act_window">
        <field name="name">Registre des visites</field>
        <field name="res_model">bf.visit</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="path">visits</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune visite au registre</p>
            <p>
                Qui est venu, quand, l'identité vérifiée et la question de la
                représentation par un courtier. Une fois l'arrivée constatée, le
                registre ne se réécrit plus.
            </p>
        </field>
    </record>

</odoo>
