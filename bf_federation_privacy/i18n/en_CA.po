#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "(aucune)"
msgstr "(none)"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "(non nommé)"
msgstr "(unnamed)"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "(sans catégorie)"
msgstr "(no category)"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "(sans numéro)"
msgstr "(no number)"

#. module: bf_federation_privacy
#: model_terms:ir.ui.view,arch_db:bf_federation_privacy.view_breach_notice_form_federation
msgid ""
". Il porte les faits que votre mandataire\n"
"                    constate : l'évaluation du risque et les avis à la Commission vous reviennent, dans la\n"
"                    fiche du registre"
msgstr ""
". It sets out the facts your service provider\n"
"                    observes: assessing the risk and notifying the Commission remain yours, in the\n"
"                    register record"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid ""
"<p>%(peer)s a renvoyé cet avis avec une autre empreinte : le miroir garde ce"
" qui a été reçu la première fois.</p>"
msgstr ""
"<p>%(peer)s sent this notice again with another fingerprint: the mirror "
"keeps what was received first.</p>"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid ""
"<p>Avis de violation reçu de <b>%(who)s</b> : %(ref)s, version %(v)s, signé "
"par %(signer)s.<br/>Empreinte SHA-256 : <code>%(sha)s</code></p>"
msgstr ""
"<p>Breach notice received from <b>%(who)s</b>: %(ref)s, version %(v)s, "
"signed by %(signer)s.<br/>SHA-256 fingerprint: <code>%(sha)s</code></p>"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid ""
"<p>Chez %(peer)s, %(who)s a accusé réception, mais l'accusé n'a pas été "
"retenu : %(why)s</p>"
msgstr ""
"<p>At %(peer)s, %(who)s acknowledged receipt, but the acknowledgement was "
"not kept: %(why)s</p>"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid ""
"<p>Chez %(peer)s, %(who)s a voulu accuser réception par la fédération, mais "
"le PDF n'y avait pas traversé : l'accusé passe par le lien du courriel.</p>"
msgstr ""
"<p>At %(peer)s, %(who)s tried to acknowledge receipt through federation, but"
" the PDF had not crossed: the acknowledgement goes through the email "
"link.</p>"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "<p>Chez %(peer)s, <b>%(who)s</b> a accusé réception de l'avis.</p>"
msgstr ""
"<p>At %(peer)s, <b>%(who)s</b> acknowledged receipt of the notice.</p>"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid ""
"<p>Un accusé est arrivé de %(peer)s, à qui cet avis n'a pas été partagé : il"
" n'est pas retenu.</p>"
msgstr ""
"<p>An acknowledgement arrived from %(peer)s, to whom this notice was not "
"shared: it is not kept.</p>"

#. module: bf_federation_privacy
#: model_terms:ir.ui.view,arch_db:bf_federation_privacy.view_breach_notice_form_federation
msgid "Accuser réception"
msgstr "Acknowledge receipt"

#. module: bf_federation_privacy
#: model:ir.model.fields.selection,name:bf_federation_privacy.selection__federation_outbox__kind__breach_ack
msgid "Accusé d'un avis de violation"
msgstr "Breach notice acknowledgement"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
