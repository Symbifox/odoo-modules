<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_time_of_day_view_list" model="ir.ui.view">
        <field name="name">bf.time.of.day.list</field>
        <field name="model">bf.time.of.day</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="icon" placeholder="fa-coffee"/>
                <field name="color" widget="color_picker"/>
                <field name="default_time" widget="float_time"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="bf_time_of_day_view_form" model="ir.ui.view">
        <field name="name">bf.time.of.day.form</field>
        <field name="model">bf.time.of.day</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivée" bg_color="bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="icon" placeholder="fa-coffee"/>
                            <field name="color" widget="color_picker"/>
                            <field name="default_time" widget="float_time"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        L'<b>heure suggérée</b> est appliquée à la deadline d'une tâche
                        quand un utilisateur sélectionne cette plage. Chaque utilisateur
                        peut surcharger cette heure dans ses préférences personnelles.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_time_of_day_action" model="ir.actions.act_window">
        <field name="name">Plages horaires</field>
        <field name="res_model">bf.time.of.day</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
