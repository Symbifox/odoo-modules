#. module: bf_babillard
#: model:mail.template,body_html:bf_babillard.mail_template_annonce_a_lire
msgid ""
"\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">\n"
"        An announcement asks you to confirm you read it:\n"
"        <strong t-out=\"object.name or ''\"/>\n"
"    </p>\n"
"    <div t-if=\"not is_html_empty(object.corps_html)\" style=\"margin:0 0 16px 0;\" t-out=\"object.corps_html\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=bf.babillard.post&amp;res_id={{ object.id }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Read and confirm\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        The confirmation happens in the application, after signing in: opening this\n"
"        email or following its link does not count as a read.\n"
"    </p>\n"
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">\n"
"        Une annonce vous demande de confirmer sa lecture :\n"
"        <strong t-out=\"object.name or ''\"/>\n"
"    </p>\n"
"    <div t-if=\"not is_html_empty(object.corps_html)\" style=\"margin:0 0 16px 0;\" t-out=\"object.corps_html\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=bf.babillard.post&amp;res_id={{ object.id }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Lire et confirmer\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        La confirmation se fait dans l'application, après la connexion : ouvrir ce\n"
"        courriel ou suivre son lien ne compte pas comme une lecture.\n"
"    </p>\n"
"</div>\n"
"            "

#. module: bf_babillard
#: model:mail.template,body_html:bf_babillard.mail_template_signalement_recu
msgid ""
"\n"
"    <t t-set=\"societe\" t-value=\"object.post_id.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">A report is waiting for your attention on the noticeboard.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=bf.babillard.signalement&amp;res_id={{ object.id }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Open the report\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        To keep it confidential, this email says neither what is reported\n"
"        nor who reported it.\n"
"    </p>\n"
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.post_id.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Un signalement attend votre attention au babillard.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=bf.babillard.signalement&amp;res_id={{ object.id }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Ouvrir le signalement\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        Pour préserver la confidentialité, ce courriel ne dit ni ce qui est signalé,\n"
"        ni qui le signale.\n"
"    </p>\n"
"</div>\n"
"            "

#. module: bf_babillard
#. odoo-python
#: code:addons/bf_babillard/models/babillard_post.py:0
msgid "\"%(nom)s\" is not offered on this noticeboard."
msgstr "« %(nom)s » n'est pas offerte sur ce babillard."

#. module: bf_babillard
#. odoo-python
#: code:addons/bf_babillard/models/babillard_reaction.py:0
msgid ""
"\"%(noms)s\" has already been placed on posts. Untick \"Offered\": the "
"reactions already there stay readable, and nobody places a new one."
msgstr ""
"« %(noms)s » a déjà été posée sur des publications. Décochez « Offerte » : "
"les réactions déjà là restent lisibles, et personne n'en pose de nouvelle."

#. module: bf_babillard
#. odoo-python
#: code:addons/bf_babillard/models/babillard_reaction.py:0
msgid ""
"\"%(noms)s\" ships with the module: untick \"Offered\" rather than deleting "
"it. Deleted, it comes back ticked at the next update."
msgstr ""
"« %(noms)s » vient avec le module : décochez « Offerte » plutôt que de la "
"supprimer. Supprimée, elle revient à la prochaine mise à jour, cochée."

#. module: bf_babillard
#. odoo-python
#: code:addons/bf_babillard/models/babillard_reaction.py:0
msgid "\"%(symbole)s\" is already offered under the name \"%(nom)s\"."
msgstr "« %(symbole)s » est déjà offert sous le nom « %(nom)s »."

