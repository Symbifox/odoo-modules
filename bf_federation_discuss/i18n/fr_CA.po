#. module: bf_federation_discuss
#. odoo-python
#: code:addons/bf_federation_discuss/models/discuss_channel.py:0
msgid "%s ⇄ %s"
msgstr "%s ⇄ %s"

#. module: bf_federation_discuss
#: model:ir.model.fields,field_description:bf_federation_discuss.field_federation_link__channel_id
#: model_terms:ir.ui.view,arch_db:bf_federation_discuss.view_federation_link_list_discuss
msgid "Channel"
msgstr "Canal"

#. module: bf_federation_discuss
#: model:ir.model.fields,field_description:bf_federation_discuss.field_federation_link__has_channel
msgid "Channel open"
msgstr "Canal ouvert"

#. module: bf_federation_discuss
#. odoo-python
#: code:addons/bf_federation_discuss/models/discuss_channel.py:0
msgid ""
"Conversation with %s about \"%s\". What is written here is posted to the "
"object's message thread, from where it travels to the peer. Allow two to "
"four minutes per round trip."
msgstr ""
"Conversation avec %s au sujet de « %s ». Ce qui s'écrit ici est posté au "
"chatter de l'objet, d'où il part chez le pair. Comptez deux à quatre minutes"
" par aller-retour."

#. module: bf_federation_discuss
#: model:ir.model.fields,field_description:bf_federation_discuss.field_discuss_channel__federation_link_id
msgid "Federated object"
msgstr "Objet fédéré"

#. module: bf_federation_discuss
#: model_terms:ir.ui.view,arch_db:bf_federation_discuss.view_federation_link_list_discuss
msgid "Open the channel"
msgstr "Ouvrir le canal"

#. module: bf_federation_discuss
#: model:ir.model.fields,help:bf_federation_discuss.field_discuss_channel__federation_link_id
msgid ""
"The channel of an object shared with a peer. What is said here goes through "
"the object's message thread, which remains the record."
msgstr ""
"Le canal d'un objet partagé avec un pair. Ce qui s'y dit passe par le "
"chatter de l'objet, qui reste le registre."

#. module: bf_federation_discuss
#. odoo-python
#: code:addons/bf_federation_discuss/models/federation_link.py:0
msgid "This link is no longer active: nothing would leave the channel."
msgstr "Ce lien n'est plus actif : rien ne partirait du canal."
