<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ballot_issue_form" model="ir.ui.view">
        <field name="name">bf.property.ballot.issue.form</field>
        <field name="model">bf.property.ballot.issue</field>
        <field name="arch" type="xml">
            <form string="Récépissés à distribuer">
                <div class="alert alert-warning" role="alert">
                    Ces codes ne s'affichent qu'une fois. Ils ne sont conservés
                    nulle part : la base ne garde que leur empreinte, ce qui est
                    précisément ce qui rend le scrutin secret. Un code perdu
                    laisse son bulletin dans l'urne sans qu'il puisse jamais y
                    être déposé.
                </div>
                <group>
                    <field name="resolution_id" readonly="1"/>
                </group>
                <field name="distribution" widget="text" readonly="1" nolabel="1"/>
                <footer>
                    <button string="Fermer" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_ballot_deposit_form" model="ir.ui.view">
        <field name="name">bf.property.ballot.deposit.form</field>
        <field name="model">bf.property.ballot.deposit</field>
        <field name="arch" type="xml">
            <form string="Déposer un bulletin">
                <div class="alert alert-success" role="alert" invisible="not feedback">
                    <field name="feedback" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="resolution_id" readonly="1"/>
                    <field name="receipt_code" placeholder="XXXX-XXXX-XXXX" required="1"/>
                    <field name="choice" widget="radio" required="1"/>
                </group>
                <footer>
                    <button name="action_deposit" type="object" string="Déposer"
                            class="btn-primary"/>
                    <button string="Fermer" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_ballot_receipt_form" model="ir.ui.view">
        <field name="name">bf.property.ballot.receipt.form</field>
        <field name="model">bf.property.ballot.receipt</field>
        <field name="arch" type="xml">
            <form string="Vérifier un récépissé">
                <div class="alert alert-info" role="alert" invisible="not outcome">
                    <field name="outcome" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="resolution_id" readonly="1"/>
                    <field name="receipt_code" placeholder="XXXX-XXXX-XXXX" required="1"/>
                </group>
                <footer>
                    <button name="action_check" type="object" string="Vérifier"
                            class="btn-primary"/>
                    <button string="Fermer" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
