<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- noupdate : un gabarit retouché dans l'interface ne doit pas être
             écrasé au prochain `-u`. Même convention que le module parent.
             Le rafraîchissement volontaire passe par migrations/. -->
        <record id="mail_template_poll_invitation" model="mail.template">
            <field name="name">Availability poll: invitation</field>
            <field name="model_id" ref="model_appointment_poll_participant"/>
            <field name="subject">{{ object.poll_id.name }}: your availability</field>
            <field name="email_from">{{ (object.poll_id.type_id.company_id.email_formatted or '') }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.partner_id.lang or object.poll_id.user_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html"><![CDATA[
<t t-set="company" t-value="(object.poll_id.type_id.company_id) or user.company_id"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">Your availability</p>
<p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">Hello <t t-out="object.name or ''"/>,</p>
        <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;"><t t-out="object.poll_id.user_id.name or ''"/> is looking for a time that works for everyone for the meeting &#8220;<strong><t t-out="object.poll_id.name or ''"/></strong>&#8221;.</p>
        <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;">A few time slots are proposed. For each one, let us know whether it works for you, would work if need be, or does not work at all. It only takes a minute.</p>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:16px 0 4px 0; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;"><tbody>
         <tr><td style="padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px; width:38%;">Subject</td><td style="padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;"><t t-out="object.poll_id.name or ''"/></td></tr>
         <tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Expected duration</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;"><t t-out="object.poll_id.duration_display()"/></td></tr>
         <tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Proposed slots</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;"><t t-out="len(object.poll_id.slot_ids)"/></td></tr>
         <t t-if="object.poll_id.close_date"><tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Please reply by</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;"><t t-out="object.poll_id.close_display()"/></td></tr></t>
         <t t-if="object.required"><tr><td style="padding:12px 16px; color:#6B7280; font-size:14px;">Your attendance</td><td style="padding:12px 16px; font-size:14px; font-weight:600; color:#374151;">Required</td></tr></t>
        </tbody></table>
        <p style="text-align:center; margin:24px 0 8px 0;">
         <a t-att-href="object._vote_url()" t-attf-style="background-color:{{ brand_primary }}; color:#ffffff; padding:14px 34px; text-decoration:none; border-radius:6px; font-weight:600; font-size:15px; display:inline-block;">Share my availability</a>
        </p>
        <p style="text-align:center; font-size:12px; color:#9CA3AF; margin:0 0 4px 0;">This link is just for you.</p>
<p style="font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:24px 0 0 0;">
      This poll was sent to you by <strong t-attf-style="color:{{ brand_dark }};"><t t-out="object.poll_id.user_id.name or ''"/></strong>
      via <t t-out="company.name"/>. Your answers are only used to schedule this meeting.
     </p>
]]></field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>

        <record id="mail_template_poll_reminder" model="mail.template">
            <field name="name">Availability poll: reminder</field>
            <field name="model_id" ref="model_appointment_poll_participant"/>
            <field name="subject">Reminder: {{ object.poll_id.name }}</field>
            <field name="email_from">{{ (object.poll_id.type_id.company_id.email_formatted or '') }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.partner_id.lang or object.poll_id.user_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html"><![CDATA[
<t t-set="company" t-value="(object.poll_id.type_id.company_id) or user.company_id"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">Friendly reminder</p>
<p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">Hello <t t-out="object.name or ''"/>,</p>
        <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;">Just a gentle reminder: we still need your availability to schedule the meeting &#8220;<strong><t t-out="object.poll_id.name or ''"/></strong>&#8221;.</p>
        <t t-if="object.required"><p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;">Since your attendance is required, the meeting is waiting for your answer before it can be set.</p></t>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:16px 0 4px 0; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;"><tbody>
         <tr><td style="padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px; width:38%;">Subject</td><td style="padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;"><t t-out="object.poll_id.name or ''"/></td></tr>
         <tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Expected duration</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;"><t t-out="object.poll_id.duration_display()"/></td></tr>
         <tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Proposed slots</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;"><t t-out="len(object.poll_id.slot_ids)"/></td></tr>
         <t t-if="object.poll_id.close_date"><tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Please reply by</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;"><t t-out="object.poll_id.close_display()"/></td></tr></t>
         <t t-if="object.required"><tr><td style="padding:12px 16px; color:#6B7280; font-size:14px;">Your attendance</td><td style="padding:12px 16px; font-size:14px; font-weight:600; color:#374151;">Required</td></tr></t>
        </tbody></table>
        <p style="text-align:center; margin:24px 0 8px 0;">
         <a t-att-href="object._vote_url()" t-attf-style="background-color:{{ brand_primary }}; color:#ffffff; padding:14px 34px; text-decoration:none; border-radius:6px; font-weight:600; font-size:15px; display:inline-block;">Reply now</a>
        </p>
        <p style="text-align:center; font-size:12px; color:#9CA3AF; margin:0 0 4px 0;">This link is just for you.</p>
<p style="font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:24px 0 0 0;">
      This poll was sent to you by <strong t-attf-style="color:{{ brand_dark }};"><t t-out="object.poll_id.user_id.name or ''"/></strong>
      via <t t-out="company.name"/>. Your answers are only used to schedule this meeting.
     </p>
]]></field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>

        <!-- ⚠️ Le SEUL courriel que ce module envoie vers une adresse entrée
             par le lien d'inscription. Il ne part qu'à une adresse déjà
             inscrite au sondage, jamais à une adresse arbitraire : c'est ce
             qui l'empêche de faire du lien public un relais signé DKIM.
             Le code arrive par le contexte (`ctx`) et n'existe nulle part
             ailleurs : la base n'en garde qu'une empreinte. -->
        <record id="mail_template_poll_otp" model="mail.template">
            <field name="name">Availability poll: edit code</field>
            <field name="model_id" ref="model_appointment_poll_participant"/>
            <field name="subject">{{ object.poll_id.name }}: your code to change your answers</field>
            <field name="email_from">{{ (object.poll_id.type_id.company_id.email_formatted or '') }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.partner_id.lang or object.poll_id.user_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html"><![CDATA[
<t t-set="company" t-value="(object.poll_id.type_id.company_id) or user.company_id"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">Your code</p>
<p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">Hello <t t-out="object.name or ''"/>,</p>
     <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">Here is the code that lets you change your answers to the poll &#8220;<strong><t t-out="object.poll_id.name or ''"/></strong>&#8221;.</p>
     <p style="font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:34px; font-weight:800; letter-spacing:8px; color:#111827; margin:0 0 8px 0; text-align:center;"><t t-out="ctx.get('bf_poll_otp') or ''"/></p>
     <p style="font-size:14px; line-height:22px; color:#6B7280; margin:0 0 16px 0; text-align:center;">Valid for 15&#160;minutes, for this change only.</p>
     <p style="font-size:14px; line-height:22px; color:#6B7280; margin:0;">Didn&#8217;t ask for this? No need to do anything: without this code, no one can change your answers. The code expires on its own.</p>
]]></field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>

        <!-- 🔴 Le sondage n'écrivait à personne en fixant la rencontre. La
             confirmation brandée du module parent existe, mais elle n'est
             envoyée que par la page publique et ne s'adresse qu'à UN
             destinataire (`object.partner_id`) : un sondage en a plusieurs.
             Celle-ci s'adresse au participant, comme l'invitation et la
             relance, donc chacun reçoit la sienne. -->
        <record id="mail_template_poll_scheduled" model="mail.template">
            <field name="name">Availability poll: meeting scheduled</field>
            <field name="model_id" ref="model_appointment_poll_participant"/>
            <field name="subject">It's set: {{ object.poll_id.name }}</field>
            <field name="email_from">{{ (object.poll_id.type_id.company_id.email_formatted or '') }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.partner_id.lang or object.poll_id.user_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html"><![CDATA[
<t t-set="company" t-value="(object.poll_id.type_id.company_id) or user.company_id"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<t t-set="booking" t-value="object.poll_id.booking_id"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">It&#8217;s set</p>
<p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">Hello <t t-out="object.name or ''"/>,</p>
     <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">Thank you for sharing your availability. The meeting &#8220;<strong><t t-out="object.poll_id.name or ''"/></strong>&#8221; is now scheduled.</p>
     <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:16px 0 4px 0; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;"><tbody>
      <tr><td style="padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px; width:38%;">When</td><td style="padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;"><t t-out="object.poll_id.scheduled_display(object)"/></td></tr>
      <tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Duration</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;"><t t-out="object.poll_id.duration_display()"/></td></tr>
      <t t-if="booking and booking.videocall_location"><tr><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;">Where</td><td style="padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;"><a t-attf-href="{{ booking.videocall_location }}" t-attf-style="color:{{ brand_primary }};"><t t-out="booking.videocall_location"/></a></td></tr></t>
      <tr><td style="padding:12px 16px; color:#6B7280; font-size:14px;">With</td><td style="padding:12px 16px; font-size:14px; color:#374151;"><t t-out="object.poll_id.user_id.name or ''"/></td></tr>
     </tbody></table>
     <p style="font-size:14px; line-height:22px; color:#6B7280; margin:16px 0 0 0;">The attached file adds the meeting to your calendar in one click.</p>
     <p style="font-size:14px; line-height:22px; color:#6B7280; margin:8px 0 0 0;">Can&#8217;t make it? Reply to this email and we&#8217;ll find another time.</p>
]]></field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>
    </data>
</odoo>
