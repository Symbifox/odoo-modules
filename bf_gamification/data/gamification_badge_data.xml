            <field name="rarity">epic</field>
            <field name="condition_type">threshold</field>
            <field name="threshold_field">longest_streak</field>
            <field name="condition_threshold">30</field>
            <field name="popup_effect">fireworks</field>
            <field name="popup_message">Rien ne peut &#233;teindre votre flamme !</field>
            <field name="hidden" eval="True"/>
        </record>
        <record id="badge_streak_90" model="bf.gamification.badge">
