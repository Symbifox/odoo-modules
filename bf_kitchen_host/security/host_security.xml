        <field name="model_id" ref="model_bf_host_seating"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wait_company" model="ir.rule">
        <field name="name">Waiting parties: own companies</field>
        <field name="model_id" ref="model_bf_host_wait"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
