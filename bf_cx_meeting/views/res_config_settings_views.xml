<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.cx.meeting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_cx.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='bf_cx_loop_block']" position="inside">
                <setting string="Feedback after a meeting report"
                         help="When a meeting report is sent, ask the project's customer for 3-emoji feedback (over-solicitation guard applied).">
                    <field name="bf_cx_meeting_feedback"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
