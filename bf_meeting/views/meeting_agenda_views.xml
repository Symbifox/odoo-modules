<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="meeting_agenda_view_list" model="ir.ui.view">
        <field name="name">meeting.agenda.list</field>
        <field name="model">meeting.agenda</field>
        <field name="arch" type="xml">
            <list default_order="date desc"
                  decoration-bf="is_today"
                  decoration-success="is_today"
                  decoration-muted="state == 'cancelled'">
                <field name="is_today" column_invisible="1"/>
                <field name="date"/>
                <field name="name"/>
                <field name="meeting_type_icon" string="" optional="show" width="40px"/>
                <field name="meeting_type" column_invisible="1"/>
                <field name="project_id"/>
                <field name="partner_id" optional="show"/>
                <field name="series_name" optional="hide"/>
                <field name="duration_planned" optional="show"/>
                <field name="topic_count"/>
                <field name="agenda_task_count" string="Tâches à discuter" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'done'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="send_state" widget="badge"
                       decoration-success="send_state in ('sent', 'manual')"
                       decoration-warning="send_state == 'prepared'"
                       decoration-danger="send_state == 'not_sent'"/>
                <field name="email_sent_date" optional="show"/>
                <field name="sent_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="meeting_agenda_view_kanban" model="ir.ui.view">
        <field name="name">meeting.agenda.kanban</field>
        <field name="model">meeting.agenda</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="topic_count"/>
                <field name="agenda_task_count"/>
                <field name="participant_ids"/>
                <field name="duration_planned"/>
                <field name="meeting_record_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="date" widget="date"/>
                                <t t-if="record.duration_planned.raw_value">
                                    — <field name="duration_planned"/> min
                                </t>
                            </div>
                            <div t-if="record.project_id.value">
                                <field name="project_id" widget="badge"/>
                            </div>
                            <div class="mt-1">
                                <field name="participant_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                            </div>
                            <div class="mt-1 d-flex gap-2">
                                <span t-if="record.topic_count.raw_value > 0"
                                      class="badge text-bg-secondary">
                                    <i class="fa fa-list"/> <field name="topic_count"/> sujets
                                </span>
                                <span t-if="record.agenda_task_count.raw_value > 0"
                                      class="badge text-bg-info">
                                    <i class="fa fa-tasks"/> <field name="agenda_task_count"/> à discuter
                                </span>
                                <span t-if="record.meeting_record_id.raw_value"
                                      class="badge text-bg-success">
                                    <i class="fa fa-check"/> CR
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="meeting_agenda_view_calendar" model="ir.ui.view">
        <field name="name">meeting.agenda.calendar</field>
        <field name="model">meeting.agenda</field>
        <field name="arch" type="xml">
            <calendar date_start="date" color="project_id" mode="week"
                      event_open_popup="true" quick_create="false">
                <field name="name"/>
                <field name="project_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Form View -->
    <record id="meeting_agenda_view_form" model="ir.ui.view">
        <field name="name">meeting.agenda.form</field>
        <field name="model">meeting.agenda</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirmer"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_meeting" type="object"
                            string="Démarrer la rencontre"
                            icon="fa-play"
                            class="btn-primary"
                            invisible="state not in ('draft','confirmed')"/>
                    <button name="action_quick_add_task" type="object"
                            string="Ajouter une action"
                            icon="fa-plus-square-o"
                            class="btn-secondary"
                            invisible="state not in ('draft','confirmed')"/>
                    <button name="action_send_agenda" type="object"
                            string="Envoyer"
                            class="btn-primary"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_send_agenda_wizard" type="object"
                            string="Envoyer avec options..."
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_refine_agenda" type="object"
                            string="Pré-remplir avec GenFox"
                            groups="bf_meeting.group_meeting_manager"
                            invisible="state != 'draft' or refine_state == 'queued'"
                            confirm="Lancer GenFox pour pré-remplir cet ordre du jour ? L'opération prend quelques minutes."/>
                    <!-- Une passe interrompue reste « en cours » pour toujours et
                         emportait le bouton avec elle : ce second bouton reprend
                         la main dès que la fenêtre utile est passée. -->
                    <button name="action_refine_agenda" type="object"
                            string="Relancer le pré-remplissage"
                            groups="bf_meeting.group_meeting_manager"
                            invisible="state != 'draft' or refine_state != 'queued' or refine_in_progress"
                            confirm="Le pré-remplissage précédent est sans nouvelle depuis un moment — il a probablement été interrompu. En relancer un ?"/>
                    <button name="action_clone_from_last_series" type="object"
                            string="Cloner depuis la série"
                            icon="fa-copy"
                            invisible="state != 'draft' or not series_name"
                            confirm="Reprendre les sujets, participants et durée de la dernière rencontre confirmée de cette série ?"/>
                    <button name="%(bf_meeting.action_report_meeting_agenda)d" type="action"
                            string="Imprimer PDF"
                            class="btn-secondary"/>
                    <button name="action_create_meeting_record" type="object"
                            string="Créer le compte rendu"
                            class="btn-secondary"
                            invisible="state != 'confirmed' or meeting_record_id"/>
                    <button name="action_done" type="object"
                            string="Terminer"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object"
                            string="Annuler"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_reset_draft" type="object"
                            string="Remettre en brouillon"
                            invisible="state not in ('cancelled',)"/>
                    <button name="action_mark_sent_manually" type="object"
                            string="Marquer envoyé à la main"
                            icon="fa-check-square-o"
                            invisible="send_state in ('sent', 'manual')"
                            confirm="Déclarer que cet ordre du jour a été transmis hors Odoo ? Il comptera comme envoyé et le rappel automatique cessera."/>
                    <button name="action_unmark_sent_manually" type="object"
                            string="Retirer l'envoi manuel"
                            invisible="send_state != 'manual'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_agenda_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                help="Tâches à discuter lors de cet ordre du jour"
                                invisible="agenda_task_count == 0">
                            <field name="agenda_task_count" widget="statinfo"
                                   string="À discuter"/>
                        </button>
                        <button name="action_view_meeting_record" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                help="Ouvrir le compte rendu issu de cet ordre du jour"
                                invisible="not meeting_record_id">
                            <span class="o_stat_text">Compte rendu</span>
                        </button>
                    </div>
                    <field name="refine_in_progress" invisible="1"/>
                    <!-- Même bande que sur le compte rendu : le pré-remplissage
                         prend quelques minutes et n'écrit rien tant qu'il n'a
                         pas fini. -->
                    <div class="alert alert-info d-flex align-items-center mb-2"
                         role="status" invisible="not refine_in_progress">
                        <i class="fa fa-circle-o-notch fa-spin me-2" title="En cours"/>
                        <span>
                            <b>GenFox pré-remplit cet ordre du jour.</b>
                            Comptez quelques minutes, puis rechargez la page.
                        </span>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="refine_state != 'queued' or refine_in_progress">
                        <b>Pré-remplissage sans nouvelle.</b>
                        La passe n'a jamais rendu de statut : elle a probablement été
                        interrompue. Relancez-la si l'ordre du jour est resté vide.
                    </div>
                    <div class="alert alert-danger mb-2" role="alert"
                         invisible="refine_state != 'error'">
                        <b>Le pré-remplissage a échoué.</b>
                        <field name="refine_message" readonly="1" class="d-inline" nolabel="1"/>
                    </div>
                    <field name="send_state" invisible="1"/>
                    <!-- L'état d'envoi se lisait uniquement dans l'onglet
                         Technique : personne ne pouvait dire, au coup d'œil,
                         si l'OdJ était parti. -->
                    <div class="alert alert-danger d-flex align-items-center mb-2"
                         role="alert" invisible="send_state != 'not_sent'">
                        <i class="fa fa-envelope-o me-2" title="Non envoyé"/>
                        <span>
                            <b>Ordre du jour non envoyé.</b>
                            Aucun courriel n'est parti aux destinataires.
                        </span>
                    </div>
                    <div class="alert alert-warning d-flex align-items-center mb-2"
                         role="alert" invisible="send_state != 'prepared'">
                        <i class="fa fa-exclamation-triangle me-2" title="Envoi non confirmé"/>
                        <span>
                            <b>Envoi amorcé, jamais confirmé.</b>
                            Un envoi a été préparé le
                            <field name="sent_date" readonly="1" nolabel="1" class="d-inline"/>
                            mais aucun courriel n'a quitté Odoo — le composeur a
                            vraisemblablement été fermé sans envoyer.
                        </span>
                    </div>
                    <div class="alert alert-success d-flex align-items-center mb-2"
                         role="status" invisible="send_state not in ('sent', 'manual')">
                        <i class="fa fa-paper-plane me-2" title="Envoyé"/>
                        <span>
                            <b>Ordre du jour envoyé</b> le
                            <field name="email_sent_date" readonly="1" nolabel="1" class="d-inline"/>
                            <span invisible="send_state != 'manual'">
                                — envoi déclaré à la main, hors Odoo.
                            </span>
                        </span>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Titre de l'ordre du jour"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="duration_planned"/>
                            <field name="meeting_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="location" invisible="meeting_type in ('phone', 'async')"/>
                            <field name="series_name"/>
                            <field name="organizer_id"/>
                            <field name="lang"/>
                            <field name="calendar_event_id"
                                   options="{'no_create': True}"
                                   placeholder="Lier un événement calendrier..."/>
                            <field name="auto_send_on_confirm"/>
                            <field name="allow_contributions"/>
                        </group>
                    </group>
                    <field name="contributions_open" invisible="1"/>
                    <div class="alert alert-success" role="alert"
                         invisible="not contributions_open">
                        <i class="fa fa-unlock"/> Les destinataires peuvent
                        proposer des sujets et laisser des commentaires via le
                        lien public jusqu'à la confirmation de l'ordre du jour.
                        <field name="contribution_url" widget="CopyClipboardChar"
                               readonly="1" nolabel="1"/>
                    </div>
                    <group string="Participants">
                        <field name="participant_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Sujets" name="topics">
                            <div class="alert alert-warning" role="alert"
                                 invisible="contribution_pending_count == 0">
                                <i class="fa fa-inbox"/> Des sujets proposés par
                                des destinataires sont en attente d'examen
                                (en jaune ci-dessous). Acceptez-les pour qu'ils
                                rejoignent l'ordre du jour officiel, ou rejetez-les.
                            </div>
                            <field name="contribution_pending_count" invisible="1"/>
                            <field name="topic_ids">
                                <list decoration-warning="moderation_state == 'pending'"
                                      decoration-muted="moderation_state == 'rejected'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="duration_planned"/>
                                    <field name="presenter_id"/>
                                    <field name="source" optional="show"/>
                                    <field name="contributor_name" optional="hide"/>
                                    <field name="moderation_state" widget="badge"
                                           decoration-warning="moderation_state == 'pending'"
                                           decoration-success="moderation_state == 'accepted'"
                                           decoration-danger="moderation_state == 'rejected'"/>
                                    <button name="action_accept_contribution" type="object"
                                            string="Accepter" icon="fa-check"
                                            invisible="moderation_state == 'accepted'"/>
                                    <button name="action_reject_contribution" type="object"
                                            string="Rejeter" icon="fa-times"
                                            invisible="moderation_state == 'rejected'"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="duration_planned"/>
                                        </group>
                                        <group>
                                            <field name="presenter_id"/>
                                            <field name="sequence"/>
                                        </group>
                                    </group>
                                    <group string="Provenance"
                                           invisible="source == 'staff'">
                                        <field name="source" readonly="1"/>
                                        <field name="moderation_state"/>
                                        <field name="contributor_name" readonly="1"/>
                                        <field name="contributor_email" readonly="1"/>
                                    </group>
                                    <separator string="Notes / Contexte"/>
                                    <field name="description" nolabel="1"/>
                                    <separator string="Notes en direct (pendant la rencontre)"/>
                                    <field name="live_notes_html" nolabel="1"
                                           placeholder="Prise de notes en direct sur ce sujet. N'apparaît pas dans le PDF de l'OdJ — sera transféré dans le compte rendu."/>
                                </form>
                            </field>
                        </page>
                        <page string="Décisions" name="live_decisions">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-gavel"/> Décisions prises pendant
                                la rencontre. Transférées automatiquement au
                                compte rendu à sa création.
                            </div>
                            <field name="live_decision_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" required="1"/>
                                    <field name="decision_maker_id"/>
                                    <field name="knowledge_item_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes en direct" name="live_notes">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-pencil-square-o"/> Scratchpad de prise de notes
                                pendant la rencontre. <strong>N'affecte pas l'ordre du
                                jour</strong> (PDF, courriel) ; le contenu est transféré
                                dans le résumé du compte rendu à sa création.
                            </div>
                            <field name="live_notes_html" nolabel="1"
                                   placeholder="Notes générales de la rencontre…"/>
                            <separator string="Notes par sujet"/>
                            <field name="topic_ids" nolabel="1" context="{'tree_view_ref': 'bf_meeting.meeting_agenda_topic_notes_list'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" readonly="1"/>
                                    <field name="live_notes_html" widget="html"/>
                                </list>
                            </field>
                        </page>
                        <page string="Éléments d'action à discuter" name="tagged_tasks">
                            <field name="agenda_task_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="date_deadline"/>
                                    <field name="stage_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="bf_discuss_tag"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contenu" name="content">
                            <separator string="Objectifs"/>
                            <field name="objectives" nolabel="1"
                                   placeholder="Ce que nous souhaitons accomplir lors de cette rencontre..."/>
                            <separator string="Contexte"/>
                            <field name="context_html" nolabel="1"
                                   placeholder="État des lieux avant la rencontre..."/>
                            <separator string="Préparation"/>
                            <field name="preparation_html" nolabel="1"
                                   placeholder="Ce qui doit être préparé avant la rencontre..."/>
                        </page>
                        <page string="Documents" name="documents">
                            <p class="text-muted">
                                Pièces jointes liées à l'OdJ. Choisissez <strong>Fichier</strong> pour
                                téléverser un document, ou <strong>URL</strong> pour pointer vers un
                                document externe. La colonne <strong>Fenêtre</strong> permet
                                de masquer un document hors d'une plage temporelle relative à la date
                                de la rencontre — utile pour les pre-reads ou les decks éphémères.
                            </p>
                            <field name="meeting_attachment_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name" required="1"/>
                                    <field name="type"/>
                                    <field name="datas" widget="binary" filename="name"
                                           invisible="type != 'binary'"/>
                                    <field name="url" widget="url"
                                           placeholder="https://..."
                                           invisible="type != 'url'"/>
                                    <field name="bf_visibility_window"/>
                                    <field name="bf_visible_from" optional="hide"/>
                                    <field name="bf_visible_until" optional="hide"/>
                                    <field name="bf_is_visible_now" widget="boolean_toggle" readonly="1"/>
                                    <field name="mimetype" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technique" name="technical">
                            <group>
                                <group>
                                    <field name="meeting_record_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="nc_path"/>
                                    <field name="sent_date"/>
                                    <field name="sent_manually"/>
                                    <field name="refine_state" widget="badge"
                                           decoration-info="refine_state == 'queued'"
                                           decoration-success="refine_state == 'done'"
                                           decoration-danger="refine_state == 'error'"/>
                                    <field name="refine_date"/>
                                    <field name="refine_message"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="active"/>
                                </group>
                            </group>
                            <separator string="Destinataires"/>
                            <field name="recipient_ids" widget="many2many_tags"
                                   placeholder="Si vide, les participants recevront le courriel."/>
                            <separator string="Contributions des destinataires"/>
                            <group>
                                <field name="allow_contributions"/>
                                <field name="contributions_open" readonly="1"/>
                                <field name="contribution_url" readonly="1"
                                       widget="CopyClipboardChar"
                                       invisible="not contribution_url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="meeting_agenda_view_search" model="ir.ui.view">
        <field name="name">meeting.agenda.search</field>
        <field name="model">meeting.agenda</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="series_name"/>
                <filter name="filter_draft" string="Brouillon"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmé"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_done" string="Terminé"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_not_sent" string="Non envoyé"
                        domain="[('send_state', 'in', ('not_sent', 'prepared'))]"/>
                <filter name="filter_send_unconfirmed" string="Envoi non confirmé"
                        domain="[('send_state', '=', 'prepared')]"/>
                <filter name="filter_sent" string="Envoyé"
                        domain="[('send_state', 'in', ('sent', 'manual'))]"/>
                <separator/>
                <filter name="filter_today" string="Aujourd'hui"
                        domain="[('date', '&gt;=', context_today().strftime('%%Y-%%m-%%d 00:00:00')),
                                 ('date', '&lt;=', context_today().strftime('%%Y-%%m-%%d 23:59:59'))]"/>
                <filter name="filter_upcoming" string="À venir"
                        domain="[('state', 'in', ('draft', 'confirmed')),
                                 ('date', '&gt;=', context_today().strftime('%%Y-%%m-%%d'))]"/>
                <filter name="filter_this_month" string="Ce mois"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%%Y-%%m-%%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <filter name="filter_type_in_person" string="Présentiel"
                        domain="[('meeting_type', '=', 'in_person')]"/>
                <filter name="filter_type_video" string="Visio"
                        domain="[('meeting_type', '=', 'video')]"/>
                <filter name="filter_type_phone" string="Téléphonique"
                        domain="[('meeting_type', '=', 'phone')]"/>
                <filter name="filter_type_hybrid" string="Hybride"
                        domain="[('meeting_type', '=', 'hybrid')]"/>
                <filter name="filter_type_async" string="Asynchrone"
                        domain="[('meeting_type', '=', 'async')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_project" string="Projet"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_month" string="Mois"
                            context="{'group_by': 'date:month'}"/>
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_send_state" string="Envoi"
                            context="{'group_by': 'send_state'}"/>
                    <filter name="group_series" string="Série"
                            context="{'group_by': 'series_name'}"/>
                    <filter name="group_meeting_type" string="Mode"
                            context="{'group_by': 'meeting_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="meeting_agenda_action" model="ir.actions.act_window">
        <field name="name">Ordres du jour</field>
        <field name="res_model">meeting.agenda</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="meeting_agenda_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun ordre du jour
            </p>
            <p>Créez un ordre du jour pour préparer votre prochaine rencontre.</p>
        </field>
    </record>

    <record id="meeting_agenda_action_upcoming" model="ir.actions.act_window">
        <field name="name">Ordres du jour à venir</field>
        <field name="res_model">meeting.agenda</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="meeting_agenda_view_search"/>
        <field name="context">{'search_default_filter_upcoming': 1}</field>
    </record>

