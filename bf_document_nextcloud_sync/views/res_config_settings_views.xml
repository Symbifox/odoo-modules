<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_nc_doc_sync" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nc.doc.sync</field>
        <field name="model">res.config.settings</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="project_knowledge_matrix.res_config_settings_view_form_knowledge_matrix"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project_knowledge_matrix']" position="inside">
                <block title="Nextcloud Documents" name="nc_doc_sync_settings">
                    <setting string="Default Nextcloud configuration"
                        help="Configuration used by default for new projects">
                        <field name="nc_doc_default_config_id"
                            options="{'no_create': True}"/>
                    </setting>
                    <setting string="Manage configurations"
                        help="Set up the Nextcloud connections">
                        <button name="%(bf_document_nextcloud_sync.action_nextcloud_document_config)d"
                            type="action" string="Nextcloud configurations"
                            class="btn-link" icon="fa-arrow-right"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
