"%(unit)s. Un paiement s'impute d'abord sur les intérêts, sauf consentement "
"du syndicat."
msgstr ""

#. module: bf_property_finance
#: model_terms:ir.ui.view,arch_db:bf_property_finance.view_payment_form
msgid ""
"Art. 1570 C.c.Q. : un paiement partiel sur capital et\n"
"                                intérêts s'impute d'abord sur les intérêts."
msgstr ""

