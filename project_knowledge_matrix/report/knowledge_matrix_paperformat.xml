<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_knowledge_matrix" model="report.paperformat">
        <field name="name">Matrice de connaissances (US Letter)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_knowledge_matrix" model="ir.actions.report">
        <field name="name">Matrice de connaissances</field>
        <field name="model">project.knowledge.matrix</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_knowledge_matrix.report_knowledge_matrix</field>
        <field name="report_file">project_knowledge_matrix.report_knowledge_matrix</field>
        <field name="print_report_name">'Matrice_%s_%s' % (object.name.replace(' ', '_'), time.strftime('%Y-%m-%d'))</field>
        <field name="paperformat_id" ref="paperformat_knowledge_matrix"/>
    </record>

</odoo>
