<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Every 2 weeks: create a relance activity 7 days past due (core ask).
             Bi-weekly rather than daily so a cleared relance is not re-created
             the next day. -->
        <record id="cron_overdue_followup_activities" model="ir.cron">
            <field name="name">Factures : activités de relance (en retard)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_overdue_followup_activities()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">30</field>
        </record>

        <!-- Daily tick: sends the digest to each subscribed user on their own
             cadence (per-user frequency in Preferences). -->
        <record id="cron_weekly_followup_digest" model="ir.cron">
            <field name="name">Factures : digest des recevables (par usager)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_weekly_followup_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">35</field>
        </record>
    </data>
</odoo>
