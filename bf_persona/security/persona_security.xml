<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_persona" model="ir.module.category">
        <field name="name">Contact personas</field>
        <field name="description">Managing relationship preferences, tone and payer rating per contact</field>
        <field name="sequence">56</field>
    </record>

    <record id="group_persona_user" model="res.groups">
        <field name="name">Persona user</field>
        <field name="category_id" ref="module_category_persona"/>
        <field name="comment">Can view and edit the personas (without the personal details).</field>
    </record>

    <record id="group_persona_manager" model="res.groups">
        <field name="name">Persona manager</field>
        <field name="category_id" ref="module_category_persona"/>
        <field name="implied_ids" eval="[(4, ref('group_persona_user'))]"/>
        <field name="comment">Full access, including the sensitive personal details.</field>
    </record>

    <!-- La comptabilité donne un KPI de délai de paiement, c'est-à-dire la
         cote de payeur sous un autre nom. Réservé au gestionnaire, comme le champ. -->
    <record id="rule_persona_kpi_user_no_account" model="ir.rule">
        <field name="name">KPI persona : sans la comptabilité pour l'utilisateur</field>
        <field name="model_id" ref="model_contact_persona_kpi"/>
        <field name="domain_force">[('source', '!=', 'account')]</field>
        <field name="groups" eval="[(4, ref('group_persona_user'))]"/>
    </record>
    <record id="rule_persona_kpi_manager_all" model="ir.rule">
        <field name="name">KPI persona : tout pour le gestionnaire</field>
        <field name="model_id" ref="model_contact_persona_kpi"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_persona_manager'))]"/>
    </record>

</odoo>
