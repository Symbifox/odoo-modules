<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_school_homework_view_form" model="ir.ui.view">
        <field name="name">bf.school.homework.form</field>
        <field name="model">bf.school.homework</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Read chapter 4"/></h1></div>
                    <group>
                        <group>
                            <field name="group_id" domain="[('teacher_ids', 'in', [uid]), ('year_id.state', '=', 'current')]"
                                   options="{'no_create': True}"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="date_assigned"/>
                            <field name="date_due"/>
                            <field name="teacher_id"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What to do, what to bring back."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_homework_view_list" model="ir.ui.view">
        <field name="name">bf.school.homework.list</field>
        <field name="model">bf.school.homework</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_due"/>
                <field name="group_id"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>

    <record id="bf_school_homework_view_calendar" model="ir.ui.view">
        <field name="name">bf.school.homework.calendar</field>
        <field name="model">bf.school.homework</field>
        <field name="arch" type="xml">
            <calendar date_start="date_due" mode="month" color="group_id">
                <field name="name"/>
                <field name="group_id"/>
            </calendar>
        </field>
    </record>

    <record id="bf_school_homework_action" model="ir.actions.act_window">
        <field name="name">Homework</field>
        <field name="res_model">bf.school.homework</field>
        <field name="view_mode">list,calendar,form</field>
    </record>

    <menuitem id="menu_school_homework" name="Homework" parent="bf_school_core.menu_school_root"
              action="bf_school_homework_action" sequence="19"/>
</odoo>
