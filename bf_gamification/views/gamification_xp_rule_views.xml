<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xp_rule_list" model="ir.ui.view">
        <field name="name">bf.gamification.xp.rule.list</field>
        <field name="model">bf.gamification.xp.rule</field>
        <field name="arch" type="xml">
            <list string="R&#232;gles XP" editable="bottom">
                <field name="name"/>
                <field name="source"/>
                <field name="trigger"/>
                <field name="xp_amount"/>
                <field name="min_value"/>
                <field name="condition_description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_xp_rules" model="ir.actions.act_window">
        <field name="name">R&#232;gles XP</field>
        <field name="res_model">bf.gamification.xp.rule</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
