<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Le panneau se pose dans l'onglet « Notes en direct », parce que c'est là
        que la personne qui préside a les mains : c'est là que se tapent les
        notes pendant la rencontre.

        ⚠️ Aucun champ `timer_*` de l'ordre du jour n'entre dans le formulaire.
        S'ils y étaient, une sauvegarde du formulaire réécrirait l'état du
        chronomètre avec ce que le navigateur avait en mémoire au chargement.
        Le panneau lit et écrit par ses propres appels.
    -->
    <record id="meeting_agenda_view_form_timer" model="ir.ui.view">
        <field name="name">meeting.agenda.form.timer</field>
        <field name="model">meeting.agenda</field>
        <field name="inherit_id" ref="bf_meeting.meeting_agenda_view_form"/>
        <field name="arch" type="xml">

            <!--
                Deux places possibles, une seule rendue : le champ de placement
                décide. Un `<widget>` rendu invisible n'est pas monté du tout,
                donc il n'y a jamais deux chronomètres qui battent en même temps
                (vérifié au navigateur, pas supposé).
            -->
            <xpath expr="//notebook" position="before">
                <field name="timer_panel_placement" invisible="1"/>
                <field name="timer_notes_layout" invisible="1"/>
                <widget name="bf_meeting_timer_panel"
                        invisible="timer_panel_placement == 'tab'"/>
            </xpath>

            <xpath expr="//page[@name='live_notes']/field[@name='live_notes_html']" position="before">
                <widget name="bf_meeting_timer_panel"
                        invisible="timer_panel_placement != 'tab'"/>
            </xpath>

            <!--
                Notes par sujet : les sujets à gauche, les notes du sujet
                choisi à droite. Le fil continu et la liste « Notes par sujet »
                restent dans la vue, cachés : ils y sont pour que le formulaire
                charge et enregistre les mêmes champs (les notes générales, et
                les notes de chaque ligne de sujet), qu'on édite désormais à
                droite. « Fil continu » au réglage de société rend l'ancienne
                mise en page telle quelle.
            -->
            <xpath expr="//page[@name='live_notes']/div[hasclass('alert')]" position="attributes">
                <attribute name="invisible">timer_notes_layout != 'flow'</attribute>
            </xpath>
            <xpath expr="//page[@name='live_notes']/field[@name='live_notes_html']" position="attributes">
                <attribute name="invisible">timer_notes_layout != 'flow'</attribute>
            </xpath>
            <xpath expr="//page[@name='live_notes']/separator" position="attributes">
                <attribute name="invisible">timer_notes_layout != 'flow'</attribute>
            </xpath>
            <xpath expr="//page[@name='live_notes']/field[@name='topic_ids']" position="attributes">
                <attribute name="invisible">timer_notes_layout != 'flow'</attribute>
            </xpath>
            <!--
                Le détail de chaque sujet se lit à côté de ses notes : la liste
                cachée le charge avec la ligne, sans lecture à part. Le lire sur
                la fiche montre aussi un détail modifié et pas encore enregistré.
            -->
            <xpath expr="//page[@name='live_notes']/field[@name='topic_ids']/list/field[@name='live_notes_html']"
                   position="after">
                <field name="description" column_invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='live_notes']" position="inside">
                <widget name="bf_meeting_timer_notes"
                        invisible="timer_notes_layout == 'flow'"/>
            </xpath>

            <!-- Après la rencontre, le temps réel se lit à côté du temps alloué. -->
            <xpath expr="//page[@name='topics']//field[@name='topic_ids']/list/field[@name='duration_planned']"
                   position="after">
                <field name="timer_minutes" optional="hide"/>
                <field name="timer_delta_minutes" optional="hide"/>
            </xpath>

        </field>
    </record>

</odoo>
