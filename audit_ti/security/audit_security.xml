<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_audit_ti" model="ir.module.category">
        <field name="name">Audit TI</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_audit_user" model="res.groups">
        <field name="name">Utilisateur Audit TI</field>
        <field name="category_id" ref="module_category_audit_ti"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_audit_manager" model="res.groups">
        <field name="name">Gestionnaire Audit TI</field>
        <field name="category_id" ref="module_category_audit_ti"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_user'))]"/>
    </record>
</odoo>
