<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_school_report_cards_link" name="School: link to report cards"
              inherit_id="bf_school_portal.portal_my_school">
        <xpath expr="//div[hasclass('o_school_links')]" position="inside">
            <a href="/my/school/report-cards" class="btn btn-secondary">
                <i class="fa fa-file-text-o me-1"/>Report cards</a>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_school_report_cards" name="School: report cards breadcrumbs"
              inherit_id="portal.portal_breadcrumbs" priority="36">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'school_report_cards'" class="breadcrumb-item active">Report cards</li>
        </xpath>
    </template>

    <template id="portal_school_report_cards" name="School: report cards">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Report cards</t>
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Report cards</t>
            </t>
            <div t-if="not cards" class="alert alert-info mt-3">No report card is available yet.</div>
            <div class="list-group mt-3">
                <a t-foreach="cards" t-as="card" t-attf-href="/school/report-card/#{card.id}/pdf"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <strong t-out="card.student_id.name"/> ·
                        <t t-out="card.year_id.name"/>, term <t t-out="card.term_id.sequence"/>
                        <small t-if="card.version &gt; 1" class="text-muted"> · corrected version</small>
                        <small class="text-muted d-block">Issued on <span t-field="card.issued_on" t-options='{"widget": "date"}'/></small>
                    </div>
                    <span t-if="card not in read" class="badge text-bg-primary">New</span>
                    <i t-else="" class="fa fa-download text-muted"/>
                </a>
            </div>
        </t>
    </template>
</odoo>
