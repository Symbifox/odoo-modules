<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_absence_calendar_source_list" model="ir.ui.view">
        <field name="name">bf.absence.calendar.source.list</field>
        <field name="model">bf.absence.calendar.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="calendar_slug"/>
                <field name="config_key"/>
                <field name="nature"/>
                <field name="last_run"/>
                <field name="last_message"/>
                <button name="action_read" type="object" icon="fa-refresh"
                        title="Read now"/>
            </list>
        </field>
    </record>

    <record id="view_bf_absence_calendar_source_form" model="ir.ui.view">
        <field name="name">bf.absence.calendar.source.form</field>
        <field name="model">bf.absence.calendar.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_read" type="object" string="Read now"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        The calendar is read, never written, and it does not enter Odoo's calendar. What is found is proposed, and a person decides.
                    </div>
                    <group>
                        <group string="Where to read">
                            <field name="name"/>
                            <field name="config_key"/>
                            <field name="calendar_slug" placeholder="migrated-vacances-cts"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="What to read">
                            <field name="days_back"/>
                            <field name="days_ahead"/>
                            <field name="nature"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shortcuts" name="alias">
                            <div class="alert alert-info py-2" role="status">
                                What gets written in the calendar that is nobody's name: initials, a nickname, a file name. The module does not guess it, it learns it here.
                            </div>
                            <field name="alias_ids">
                                <list editable="bottom">
                                    <field name="label" placeholder="Initials or nickname"/>
                                    <field name="partner_id" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Last read">
                        <field name="last_run" readonly="1"/>
                        <field name="last_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_absence_calendar_source" model="ir.actions.act_window">
        <field name="name">Absence calendars</field>
        <field name="res_model">bf.absence.calendar.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Read a hand-kept calendar</p>
            <p>The calendar where you note your clients' holidays becomes a source of proposals, without writing anything to it.</p>
        </field>
    </record>

</odoo>
