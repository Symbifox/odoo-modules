<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List (editable) -->
    <record id="health_nutrition_goal_view_list" model="ir.ui.view">
        <field name="name">health.nutrition.goal.list</field>
        <field name="model">health.nutrition.goal</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="daily_calorie_goal"/>
                <field name="protein_target_g"/>
                <field name="carbs_target_g"/>
                <field name="fat_target_g"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="health_nutrition_goal_view_form" model="ir.ui.view">
        <field name="name">health.nutrition.goal.form</field>
        <field name="model">health.nutrition.goal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'objectif"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Objectifs quotidiens">
                            <field name="daily_calorie_goal"/>
                            <field name="active"/>
                        </group>
                        <group string="Macros cibles">
                            <field name="protein_target_g"/>
                            <field name="carbs_target_g"/>
                            <field name="fat_target_g"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="health_nutrition_goal_action" model="ir.actions.act_window">
        <field name="name">Objectif nutritionnel</field>
        <field name="res_model">health.nutrition.goal</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
