<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Domain List View -->
    <record id="hosting_domain_view_tree" model="ir.ui.view">
        <field name="name">hosting.domain.tree</field>
        <field name="model">hosting.domain</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'" decoration-warning="state == 'expiring_soon'">
                <field name="name" string="Domain"/>
                <field name="partner_id" string="Client"/>
                <field name="registrar" string="Registrar"/>
                <field name="dns_provider" string="DNS"/>
                <field name="date_expiration" string="Expiration"/>
                <field name="days_until_expiration" string="Days left"/>
                <field name="ssl_type" string="SSL"/>
                <field name="ssl_expiry_date" string="SSL expiration"/>
                <field name="auto_renew" string="Auto-renew"/>
                <field name="state" string="State" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expiring_soon'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state == 'transferred'"/>
                <field name="annual_cost" string="Annual cost" optional="show"/>
                <field name="dmarc_managed" string="DMARC monitored" optional="hide"/>
                <field name="dmarc_policy" string="DMARC policy" optional="hide"/>
                <field name="dmarc_drift" string="DMARC drift" widget="boolean_toggle" optional="show"
                       readonly="1" invisible="not dmarc_managed"/>
            </list>
        </field>
    </record>

    <!-- Domain Form View -->
    <record id="hosting_domain_view_form" model="ir.ui.view">
        <field name="name">hosting.domain.form</field>
        <field name="model">hosting.domain</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_active" string="Activate" type="object"
                            class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_set_transferred" string="Transfer" type="object"
                            invisible="state == 'transferred'"/>
                    <button name="action_dmarc_check_now" string="Check DMARC now"
                            type="object" invisible="not dmarc_managed"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expiring_soon,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_services" type="object"
                                class="oe_stat_button" icon="fa-server">
                            <field name="service_count" widget="statinfo" string="Services"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="example.com"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Registrar and DNS">
                            <field name="partner_id" string="Client"/>
                            <field name="user_id" string="Assignee"/>
                            <field name="registrar" string="Registrar"/>
                            <field name="dns_provider" string="DNS provider"/>
                            <field name="date_registration" string="Registration date"/>
                            <field name="date_expiration" string="Expiry date"/>
                            <field name="days_until_expiration" string="Days left" readonly="1"/>
                            <field name="auto_renew" string="Automatic renewal"/>
                        </group>
                        <group string="SSL and costs">
                            <field name="ssl_type" string="SSL type"/>
                            <field name="ssl_issuer" string="SSL issuer"
                                   invisible="ssl_type == 'none'"/>
                            <field name="ssl_expiry_date" string="SSL expiration"
                                   invisible="ssl_type == 'none'"/>
                            <field name="days_until_ssl_expiry" string="Days until SSL expiration"
                                   readonly="1" invisible="ssl_type == 'none'"/>
                            <field name="annual_cost" string="Annual cost"/>
                            <field name="currency_id" string="Currency" groups="base.group_multi_currency"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Services" name="services">
                            <field name="service_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="code" string="Reference"/>
                                    <field name="name" string="Name"/>
                                    <field name="partner_id" string="Client"/>
                                    <field name="software_id" string="Software"/>
                                    <field name="state" string="State" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-danger="state == 'expired'"/>
                                </list>
                            </field>
                        </page>
                        <page string="DMARC" name="dmarc">
                            <group>
                                <group string="Configuration">
                                    <field name="dmarc_managed"/>
                                    <field name="dmarc_policy" required="dmarc_managed"
                                           invisible="not dmarc_managed"/>
                                    <field name="dmarc_rua" required="dmarc_managed"
                                           invisible="not dmarc_managed"
                                           placeholder="dmarc@example.com"/>
                                    <field name="dmarc_pct" invisible="not dmarc_managed"/>
                                    <field name="dmarc_next_review_date"
                                           invisible="not dmarc_managed"/>
                                </group>
                                <group string="DNS state">
                                    <field name="dmarc_dns_value_expected" readonly="1"
                                           invisible="not dmarc_managed"/>
                                    <field name="dmarc_dns_value_observed" readonly="1"
                                           invisible="not dmarc_managed"/>
                                    <field name="dmarc_last_dns_check" readonly="1"
                                           invisible="not dmarc_managed"/>
                                    <field name="dmarc_drift" readonly="1"
                                           widget="boolean_toggle"
                                           invisible="not dmarc_managed"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not dmarc_drift">
                                <strong>DMARC drift detected.</strong> The <code>_dmarc</code> TXT record seen via Cloudflare DoH does not match the expected value. Check the DNS zone or adjust the expected configuration.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>

                    <field name="active" invisible="1"/>
                    <field name="domain_activity_created" invisible="1"/>
                    <field name="ssl_activity_created" invisible="1"/>
                    <field name="dmarc_drift_notified" invisible="1"/>
                    <field name="dmarc_review_activity_created" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Domain Search View -->
    <record id="hosting_domain_view_search" model="ir.ui.view">
        <field name="name">hosting.domain.search</field>
        <field name="model">hosting.domain</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="registrar"/>
                <field name="dns_provider"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_expiring_soon" string="Expiring soon" domain="[('state', '=', 'expiring_soon')]"/>
                <filter name="filter_expired" string="Expired domains" domain="[('state', '=', 'expired')]"/>
                <filter name="filter_transferred" string="Transferred domains" domain="[('state', '=', 'transferred')]"/>
                <separator/>
                <filter name="filter_ssl_active" string="Active SSL" domain="[('ssl_type', '!=', 'none')]"/>
                <filter name="filter_ssl_expiring" string="Expiring SSL"
                        domain="[('ssl_type', '!=', 'none'), ('ssl_expiry_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')), ('ssl_expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_no_auto_renew" string="No auto-renewal" domain="[('auto_renew', '=', False)]"/>
                <separator/>
                <filter name="filter_dmarc_managed" string="DMARC monitored" domain="[('dmarc_managed', '=', True)]"/>
                <filter name="filter_dmarc_drift" string="DMARC drift" domain="[('dmarc_drift', '=', True)]"/>
                <filter name="filter_dmarc_review_due" string="DMARC review due"
                        domain="[('dmarc_managed', '=', True), ('dmarc_next_review_date', '!=', False), ('dmarc_next_review_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_archived" string="Archives" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_registrar" string="Registrar" context="{'group_by': 'registrar'}"/>
                    <filter name="group_dns" string="DNS provider" context="{'group_by': 'dns_provider'}"/>
                    <filter name="group_ssl" string="SSL type" context="{'group_by': 'ssl_type'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="hosting_domain_action" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">hosting.domain</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hosting_domain_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first domain
            </p>
            <p>
                Track your domain names, expiration dates, SSL certificates and registrars.
            </p>
        </field>
    </record>

    <record id="hosting_domain_action_all" model="ir.actions.act_window">
        <field name="name">All domains</field>
        <field name="res_model">hosting.domain</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hosting_domain_view_search"/>
    </record>

    <record id="hosting_domain_action_expiring" model="ir.actions.act_window">
        <field name="name">Expiring domains</field>
        <field name="res_model">hosting.domain</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hosting_domain_view_search"/>
        <field name="domain">[('state', 'in', ('expiring_soon', 'active')), ('date_expiration', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d')), ('date_expiration', '&gt;=', context_today().strftime('%Y-%m-%d'))]</field>
    </record>

    <record id="hosting_domain_action_ssl_expiring" model="ir.actions.act_window">
        <field name="name">Expiring SSL</field>
        <field name="res_model">hosting.domain</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hosting_domain_view_search"/>
        <field name="domain">[('ssl_type', '!=', 'none'), ('ssl_expiry_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')), ('ssl_expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]</field>
    </record>

</odoo>
