<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Séquence pour le registre de destruction -->
    <record id="seq_privacy_destruction_register" model="ir.sequence">
        <field name="name">Registre de destruction (vie privée)</field>
        <field name="code">privacy.destruction.register</field>
        <field name="prefix">REG-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Cron : Vérifier les réévaluations d'anonymisation dues -->
    <record id="cron_check_reassessment_due" model="ir.cron">
        <field name="name">Vie privée : Vérifier les réévaluations d'anonymisation</field>
        <field name="model_id" ref="model_privacy_anonymization_assessment"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_reassessment_due()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Cron : Vérifier l'intégrité de la chaîne du registre de destruction -->
    <record id="cron_verify_register_chain" model="ir.cron">
        <field name="name">Vie privée : Vérifier l'intégrité du registre de destruction</field>
        <field name="model_id" ref="model_privacy_destruction_register"/>
        <field name="state">code</field>
        <field name="code">model.cron_verify_chain_integrity()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
