<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Taille de lot du balayage. `set_param` plutôt qu'un `<record>` :
        `ir.config_parameter` porte une contrainte d'unicité sur la clé, et un
        enregistrement se heurterait à une valeur déjà posée à la main.
    -->
    <function model="ir.config_parameter" name="set_param">
        <value>bf_sms_privacy.batch_size</value>
        <value>500</value>
    </function>

    <data noupdate="1">

        <!--
            Le cron PROPOSE, il ne détruit pas.

            Il est livré actif, contrairement au cron de purge de
            `bf_meeting_privacy` : celui-là efface pour vrai, celui-ci dépose
            des lignes dans une campagne laissée EN RÉVISION. Rien ne part sans
            qu'un humain approuve puis exécute. Et sur une archive plus jeune
            que le régime, il ne trouve rien à proposer.

            `noupdate="1"` : le jour où quelqu'un l'éteint, un `-u` ne doit pas
            le rallumer. ⚠️ Conséquence, un `-u` ne réécrit ni son nom ni son
            code — renommer la méthode appelée EXIGERAIT une migration.
        -->
        <record id="cron_privacy_propose_destruction" model="ir.cron">
            <field name="name">Messagerie — proposition de destruction (TEL-001/002/003)</field>
            <field name="model_id" ref="bf_sms_archive.model_sms_archive_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_privacy_propose_destruction()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>

</odoo>
