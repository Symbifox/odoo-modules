<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
          ⚠️ Une allergie est un renseignement de SANTÉ, donc un renseignement
          personnel sensible au sens de la Loi 25. Même réponse que pour le
          registre d'usage : la personne concernée et
          l'administration. Le gestionnaire direct n'a rien ici.
        -->

        <record id="rule_allergy_own" model="ir.rule">
            <field name="name">Allergie : je ne vois et ne modifie que la mienne</field>
            <field name="model_id" ref="model_bf_ex_allergy"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_allergy_hr" model="ir.rule">
            <field name="name">Allergie : l'administration voit tout</field>
            <field name="model_id" ref="model_bf_ex_allergy"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_allergy_company" model="ir.rule">
            <field name="name">Allergie : société</field>
            <field name="model_id" ref="model_bf_ex_allergy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
