#. module: project_knowledge_matrix
#: model:mail.template,body_html:project_knowledge_matrix.mail_template_document_dashboard_report
msgid ""
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"box-sizing:border-box;border-collapse:collapse;background-color:#2E3132\">\n"
"    <tbody>\n"
"        <tr>\n"
"            <td align=\"center\" style=\"padding:24px 16px\">\n"
"                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"600\" align=\"center\" role=\"presentation\" style=\"border-collapse:collapse;width:600px;max-width:100%\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td>\n"
"                                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;background-color:#ffffff;border-radius:12px;overflow:hidden\">\n"
"                                    <tbody>\n"
"                                        <!-- Header -->\n"
"                                        <tr>\n"
"                                            <td style=\"background-color:#22303B;padding:20px 24px\">\n"
"                                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse\">\n"
"                                                    <tbody>\n"
"                                                        <tr>\n"
"                                                            <td align=\"left\">\n"
"                                                                <a href=\"https://bluefoxconsultant.com\" style=\"text-decoration:none\">\n"
"                                                                    <img src=\"https://bluefoxconsultant.com/web/image/website/1/logo/Blue%20Fox?unique=803cc14\" alt=\"Blue Fox\" style=\"display:block;border:0;height:44px;width:auto\" height=\"44\"/>\n"
"                                                                </a>\n"
"                                                            </td>\n"
"                                                            <td align=\"right\" style=\"color:#E6EDF3;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:20px;font-weight:700\">\n"
"                                                                Rapport documentaire\n"
"                                                            </td>\n"
"                                                        </tr>\n"
"                                                    </tbody>\n"
"                                                </table>\n"
"                                            </td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- Accent bar -->\n"
"                                        <tr>\n"
"                                            <td style=\"height:4px;line-height:4px;background-color:#29ABE2\">&amp;nbsp;</td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- Content -->\n"
"                                        <tr>\n"
"                                            <td style=\"padding:24px\">\n"
"                                                <!-- Title & Date -->\n"
"                                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;margin-bottom:20px\">\n"
"                                                    <tbody>\n"
"                                                        <tr>\n"
"                                                            <td>\n"
"                                                                <h1 style=\"margin:0 0 4px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:22px;font-weight:600;color:#22303B\">\n"
"                                                                    Tableau de bord\n"
"                                                                </h1>\n"
"                                                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#6B7280\">\n"
"                                                                    État au <t t-out=\"ctx.get('report_date', '')\"/>\n"
"                                                                </p>\n"
"                                                            </td>\n"
"                                                        </tr>\n"
"                                                    </tbody>\n"
"                                                </table>\n"
"\n"
"                                                <!-- ATTENTION SECTION (if needed) -->\n"
"                                                <t t-if=\"ctx.get('overdue_review', 0) &gt; 0 or ctx.get('expired_documents', 0) &gt; 0 or ctx.get('expiring_30d', 0) &gt; 0 or ctx.get('overdue_acknowledgments', 0) &gt; 0\">\n"
"                                                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;background-color:#fef2f2;border:1px solid #fecaca;border-radius:8px;margin-bottom:20px\">\n"
"                                                        <tbody>\n"
"                                                            <tr>\n"
