<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_connector_list" model="ir.ui.view">
        <field name="name">bf.property.access.connector.list</field>
        <field name="model">bf.property.access.connector</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kind"/>
                <field name="max_attempts"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_access_connector_form" model="ir.ui.view">
        <field name="name">bf.property.access.connector.form</field>
        <field name="model">bf.property.access.connector</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="kind"/>
                        <field name="max_attempts"/>
                        <field name="active" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="note" placeholder="Adresse de l'appareil, licence, contact du fournisseur…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_access_connector" model="ir.actions.act_window">
        <field name="name">Connecteurs</field>
        <field name="res_model">bf.property.access.connector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
