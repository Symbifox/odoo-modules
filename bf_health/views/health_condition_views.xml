<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="health_condition_view_list" model="ir.ui.view">
        <field name="name">health.condition.list</field>
        <field name="model">health.condition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="condition_type"/>
                <field name="date_onset"/>
                <field name="date_resolved"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'active'"
                       decoration-warning="state == 'managed'"
                       decoration-success="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="health_condition_view_form" model="ir.ui.view">
        <field name="name">health.condition.form</field>
        <field name="model">health.condition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,managed,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la condition"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="condition_type"/>
                            <field name="date_onset"/>
                            <field name="date_resolved"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                    <notebook>
                        <page string="Symptômes">
                            <field name="symptom_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="body_area"/>
                                    <field name="duration"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="health_condition_view_kanban" model="ir.ui.view">
        <field name="name">health.condition.kanban</field>
        <field name="model">health.condition</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="condition_type"/>
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <field name="color" widget="color_picker"/>
                        <div class="fw-bold fs-5 mb-1">
                            <field name="name"/>
                        </div>
                        <div class="text-muted">
                            <field name="condition_type"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="health_condition_view_search" model="ir.ui.view">
        <field name="name">health.condition.search</field>
        <field name="model">health.condition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active_cond" string="Actives" domain="[('state', 'in', ['active', 'managed'])]"/>
                <filter name="resolved" string="Résolues" domain="[('state', '=', 'resolved')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'condition_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="health_condition_action" model="ir.actions.act_window">
        <field name="name">Conditions</field>
        <field name="res_model">health.condition</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="health_condition_view_search"/>
    </record>

    <record id="health_condition_active_action" model="ir.actions.act_window">
        <field name="name">Conditions actives</field>
        <field name="res_model">health.condition</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="health_condition_view_search"/>
        <field name="context">{'search_default_active_cond': 1}</field>
    </record>

</odoo>
