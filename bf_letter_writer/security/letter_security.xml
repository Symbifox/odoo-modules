<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_letter_writer" model="ir.module.category">
        <field name="name">Rédacteur de lettres</field>
        <field name="description">Gestion des modèles de lettres, des blocs de texte et de l'en-tête.</field>
        <field name="sequence">90</field>
    </record>

    <!-- Every internal user can write letters (granted via ir.model.access on
         base.group_user). This group adds management of templates, quicktext
         blocks and the company letterhead configuration. -->
    <record id="group_letter_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="category_id" ref="module_category_letter_writer"/>
        <field name="comment">Peut créer et modifier les modèles de lettres, les blocs de texte et l'en-tête.</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">

        <!-- Multi-company scoping on letters -->
        <record id="rule_letter_document_company" model="ir.rule">
            <field name="name">Lettre : règle multi-société</field>
            <field name="model_id" ref="model_letter_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Multi-company scoping on quicktext blocks (blank = shared) -->
        <record id="rule_letter_quicktext_company" model="ir.rule">
            <field name="name">Bloc de texte : règle multi-société</field>
            <field name="model_id" ref="model_letter_quicktext"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>

</odoo>
