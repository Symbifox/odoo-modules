<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_floorplan_zone_view_form" model="ir.ui.view">
        <field name="name">bf.floorplan.zone.form</field>
        <field name="model">bf.floorplan.zone</field>
        <field name="arch" type="xml">
            <form string="Zone">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. : Salle Fleuve"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="code"/>
                            <field name="genre"/>
                            <field name="capacite"/>
                            <field name="occupes"/>
                        </group>
                        <group string="Géométrie (cm)">
                            <field name="x"/>
                            <field name="y"/>
                            <field name="w"/>
                            <field name="h"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Éléments" name="elements">
                            <field name="element_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="genre"/>
                                    <field name="employee_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_floorplan_zone_view_list" model="ir.ui.view">
        <field name="name">bf.floorplan.zone.list</field>
        <field name="model">bf.floorplan.zone</field>
        <field name="arch" type="xml">
            <list string="Zones">
                <field name="plan_id"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="genre"/>
                <field name="capacite"/>
                <field name="occupes"/>
                <field name="element_count"/>
            </list>
        </field>
    </record>

    <record id="bf_floorplan_zone_view_search" model="ir.ui.view">
        <field name="name">bf.floorplan.zone.search</field>
        <field name="model">bf.floorplan.zone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="plan_id"/>
                <group expand="0" string="Regrouper par">
                    <filter name="par_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="par_genre" string="Nature" context="{'group_by': 'genre'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_floorplan_zone" model="ir.actions.act_window">
        <field name="name">Zones</field>
        <field name="res_model">bf.floorplan.zone</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_par_plan': 1}</field>
    </record>
</odoo>
