<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Profile Form -->
    <record id="view_gamification_profile_form" model="ir.ui.view">
        <field name="name">bf.gamification.profile.form</field>
        <field name="model">bf.gamification.profile</field>
        <field name="arch" type="xml">
            <form string="Profil Fox Quest">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="avatar" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="user_id" readonly="1"/></h1>
                        <h3>
                            <field name="title" readonly="1"/>
                            <span class="text-muted"> — </span>
                            <field name="level_id" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Progression">
                            <field name="total_xp"/>
                            <field name="xp_to_next_level"/>
                            <field name="progress_percent" widget="progressbar"/>
                            <field name="rank"/>
                        </group>
                        <group string="Activit&#233;">
                            <field name="current_streak"/>
                            <field name="longest_streak"/>
                            <field name="last_activity_date"/>
                            <field name="xp_this_week"/>
                            <field name="xp_this_month"/>
                        </group>
                    </group>
                    <group string="Badges">
                        <field name="badge_count"/>
                        <field name="showcase_badge_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Profile List (Leaderboard) -->
    <record id="view_gamification_profile_list" model="ir.ui.view">
        <field name="name">bf.gamification.profile.list</field>
        <field name="model">bf.gamification.profile</field>
        <field name="arch" type="xml">
            <list string="Classement Fox Quest" default_order="total_xp desc" create="0" delete="0">
                <field name="rank" string="#"/>
                <field name="user_id" widget="many2one_avatar"/>
                <field name="title"/>
                <field name="level_id"/>
                <field name="total_xp"/>
                <field name="badge_count"/>
                <field name="current_streak" string="Streak"/>
                <field name="xp_this_week"/>
                <field name="xp_this_month"/>
                <field name="progress_percent" widget="progressbar"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_my_profile" model="ir.actions.act_window">
        <field name="name">Mon profil</field>
        <field name="res_model">bf.gamification.profile</field>
        <field name="view_mode">form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'form_view_initial_mode': 'readonly'}</field>
    </record>

    <record id="action_leaderboard" model="ir.actions.act_window">
        <field name="name">Classement</field>
        <field name="res_model">bf.gamification.profile</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
