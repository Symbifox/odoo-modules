<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_cx_wave_reminders" model="ir.cron">
            <field name="name">Expérience client : entretien des vagues</field>
            <field name="model_id" ref="model_bf_cx_wave"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_cx_complaint_ack" model="ir.cron">
            <field name="name">Expérience client : plaintes sans accusé de réception</field>
            <field name="model_id" ref="model_bf_cx_complaint"/>
            <field name="state">code</field>
            <field name="code">model._cron_ack_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
