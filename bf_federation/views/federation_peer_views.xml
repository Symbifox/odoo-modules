<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_federation_peer_form" model="ir.ui.view">
        <field name="name">federation.peer.form</field>
        <field name="model">federation.peer</field>
        <field name="arch" type="xml">
            <form string="Federation peer">
                <header>
                    <button name="action_generate_invitation" type="object" string="Generate an invitation"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_ping" type="object" string="Test the connection" invisible="state != 'active'"/>
                    <button name="action_suspend" type="object" string="Suspend" invisible="state != 'active'"
                            confirm="Suspending this peer stops all exchange until it is reactivated. Continue?"/>
                    <button name="action_reactivate" type="object" string="Reactivate" invisible="state != 'suspended'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invited,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(bf_federation.action_federation_link)d" type="action" class="oe_stat_button" icon="fa-exchange"
                                context="{'search_default_peer_id': id}">
                            <field name="link_count" widget="statinfo" string="Federated objects"/>
                        </button>
                        <button name="%(bf_federation.action_federation_outbox)d" type="action" class="oe_stat_button" icon="fa-paper-plane" groups="base.group_system"
                                context="{'search_default_peer_id': id, 'search_default_pending': 1}">
                            <field name="outbox_pending" widget="statinfo" string="To send"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Peer name"/></h1></div>
                    <group>
                        <group string="The peer">
                            <field name="base_url" placeholder="https://…" widget="url"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="last_ping"/>
                            <field name="accepted_kinds" string="Kinds accepted by the peer"
                                   placeholder="never announced" readonly="1"/>
                            <field name="last_error" invisible="not last_error"/>
                        </group>
                        <group string="What I receive from them">
                            <field name="mirror_user_id"/>
                            <field name="mirror_project_id" readonly="1"/>
                            <field name="send_notes"/>
                            <field name="attachment_limit_mb"/>
                            <field name="federation_model_ids" invisible="1"/>
                            <field name="inbound_policy" widget="radio"/>
                            <field name="inbound_model_ids" widget="many2many_tags"
                                   invisible="inbound_policy != 'listed'"
                                   required="inbound_policy == 'listed'"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Invitation" invisible="state != 'invited'" groups="base.group_system">
                        <div class="alert alert-info" role="alert" colspan="2">
                            The peer needs two things: your address
                            (<field name="base_url" invisible="1"/><span class="fw-bold">this instance's</span>)
                            and the code below. On their side: Federation › Accept an invitation.
                            Pass them along however you like, or have them sent by email.
                        </div>
                        <field name="invitation_code" widget="CopyClipboardChar"/>
                        <field name="invitation_expiry"/>
                        <div colspan="2">
                            <field name="invitation_email" widget="email" class="oe_inline"
                                   placeholder="who to send the code to"/>
                            <button name="action_send_invitation" type="object"
                                    string="Send the invitation" class="btn-link"
                                    invisible="not invitation_email"/>
                        </div>
                    </group>
                    <notebook>
                        <page string="Matched people" name="identities">
                            <div class="text-muted mb-2">Who is who, between the two instances. This table is yours: the peer presents an email, it never designates an account here.
                                <br/>A received message whose author carries this email is written under the <b>contact</b>'s name. With no row, it carries the name of the peer's organisation.
                                <br/>A task the peer addresses to this email is assigned to the <b>account</b>. With no account here, the contact provides one if it has exactly one, internal and active; otherwise the task is left with the fallback person, with a note saying who it was addressed to.</div>
                            <field name="identity_ids">
                                <list editable="bottom">
                                    <field name="remote_email"/>
                                    <field name="remote_name"/>
                                    <field name="local_partner_id"/>
                                    <field name="local_user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" name="technical" groups="base.group_system">
                            <group>
                                <field name="uuid"/>
                                <field name="remote_uuid"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_federation_peer_list" model="ir.ui.view">
        <field name="name">federation.peer.list</field>
        <field name="model">federation.peer</field>
        <field name="arch" type="xml">
            <list string="Peers">
                <field name="name"/>
                <field name="base_url"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'invited'" decoration-muted="state == 'suspended'"/>
                <field name="link_count"/>
                <field name="outbox_pending"/>
                <field name="last_ping"/>
            </list>
        </field>
    </record>

    <record id="action_federation_peer" model="ir.actions.act_window">
        <field name="name">Peers</field>
        <field name="res_model">federation.peer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No peer yet</p>
            <p>Create a peer and generate an invitation, or accept the invitation another instance sent you.</p>
        </field>
    </record>
</odoo>
