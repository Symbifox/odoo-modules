<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view -->
    <record id="hour_bank_client_form" model="ir.ui.view">
        <field name="name">hour.bank.client.form</field>
        <field name="model">hour.bank.client</field>
        <field name="arch" type="xml">
            <form string="Hour bank">
                <header>
                    <button name="action_generate_pdf" type="object"
                            string="Generate PDF" class="btn-primary"
                            icon="fa-file-pdf-o"/>
                    <button name="action_generate_xlsx" type="object"
                            string="Generate Excel"
                            icon="fa-file-excel-o"/>
                    <button name="action_open_send_wizard" type="object"
                            string="Send report" class="btn-secondary"
                            icon="fa-envelope-o"/>
                    <button name="action_open_invoice_wizard" type="object"
                            string="Generate the invoice" class="btn-secondary"
                            icon="fa-file-text-o"
                            groups="account.group_account_invoice"/>
                    <button name="action_check_thresholds_now" type="object"
                            string="Check thresholds now"
                            icon="fa-bell-o"
                            invisible="threshold_mode == 'disabled'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-clock-o" name="action_generate_pdf" type="object">
                            <div class="o_stat_info">
                                <field name="current_balance" class="o_stat_value" widget="float" options="{'digits': [16, 2]}"/>
                                <span class="o_stat_text">Balance (h)</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-bell-o"
                                name="action_view_threshold_events" type="object"
                                invisible="threshold_event_count == 0">
                            <field name="threshold_event_count" widget="statinfo" string="Alerts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" placeholder="Select a client"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="active" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="last_report_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Projects" name="projects">
                            <field name="project_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Billing" name="invoicing">
                            <group string="Company filter">
                                <field name="company_filter_mode" widget="radio"/>
                                <field name="filter_company_ids" widget="many2many_tags"
                                       invisible="company_filter_mode == 'all'"
                                       options="{'no_create': True}"/>
                            </group>
                            <group string="Partner filter">
                                <field name="invoice_partner_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </group>
                            <group string="Product filter">
                                <field name="product_filter_mode" widget="radio"/>
                                <field name="filter_product_ids" widget="many2many_tags"
                                       invisible="product_filter_mode == 'all'"/>
                            </group>
                            <separator string="Extra invoices"/>
                            <field name="extra_invoice_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <group string="Invoice generated from the bank" name="generated_invoice">
                                <field name="invoice_mode" widget="radio"/>
                                <field name="invoice_block_hours"
                                       invisible="invoice_mode != 'prepaid'"/>
                                <field name="invoice_product_id"
                                       domain="[('id', 'in', filter_product_ids)] if product_filter_mode == 'include' and filter_product_ids else ([('id', 'not in', filter_product_ids)] if product_filter_mode == 'exclude' and filter_product_ids else [])"
                                       options="{'no_create': True}"/>
                                <field name="invoice_hourly_rate"/>
                                <field name="invoice_split_by_project"
                                       invisible="invoice_mode != 'postpaid'"/>
                            </group>
                        </page>
                        <page string="Adjustments" name="adjustments">
                            <field name="adjustment_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="hours"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Recipients" name="recipients">
                            <group>
                                <field name="recipient_ids" widget="many2many_tags" nolabel="1"/>
                            </group>
                            <separator string="Automatic sending"/>
                            <group>
                                <field name="auto_send"/>
                                <field name="send_frequency"
                                       invisible="not auto_send"/>
                            </group>
                        </page>
                        <page string="Thresholds" name="thresholds">
                            <group>
                                <field name="threshold_mode" widget="radio"/>
                                <field name="threshold_budget_hours"
                                       invisible="threshold_mode != 'budget_pct'"
                                       required="threshold_mode == 'budget_pct'"/>
                            </group>
                            <separator string="Thresholds to watch"
                                       invisible="threshold_mode == 'disabled'"/>
                            <field name="threshold_line_ids"
                                   invisible="threshold_mode == 'disabled'">
                                <list editable="bottom">
                                    <field name="value"/>
                                    <field name="name" readonly="1"/>
                                    <field name="is_armed" readonly="1" widget="boolean_toggle"/>
                                    <field name="last_fired_date" readonly="1"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <separator string="Alert recipients"
                                       invisible="threshold_mode == 'disabled'"/>
                            <group invisible="threshold_mode == 'disabled'">
                                <field name="alert_recipient_ids" widget="many2many_tags"/>
                                <field name="notify_internal_followers"/>
                            </group>
                        </page>
                        <page string="Alert history" name="threshold_history"
                              invisible="threshold_event_count == 0">
                            <field name="threshold_event_ids" readonly="1">
                                <list>
                                    <field name="fired_date"/>
                                    <field name="mode_snapshot"/>
                                    <field name="value_snapshot"/>
                                    <field name="measured_value"/>
                                    <field name="recipient_ids" widget="many2many_tags"/>
                                    <field name="attachment_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="hour_bank_client_list" model="ir.ui.view">
        <field name="name">hour.bank.client.list</field>
        <field name="model">hour.bank.client</field>
        <field name="arch" type="xml">
            <list string="Hour banks">
                <field name="partner_id"/>
                <field name="current_balance" string="Balance (h)" widget="float"/>
                <field name="auto_send" string="Auto"/>
                <field name="send_frequency" optional="hide"/>
                <field name="last_report_date"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="hour_bank_client_search" model="ir.ui.view">
        <field name="name">hour.bank.client.search</field>
        <field name="model">hour.bank.client</field>
        <field name="arch" type="xml">
            <search string="Hour banks">
                <field name="partner_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hour_bank_client" model="ir.actions.act_window">
        <field name="name">Hour banks</field>
        <field name="res_model">hour.bank.client</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hour_bank_client_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first hour bank
            </p>
            <p>
                Set up hour tracking for the clients who have an hour bank.
            </p>
        </field>
    </record>

</odoo>
