<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_bf_visit" model="ir.module.category">
            <field name="name">Visites de propriétés</field>
            <field name="description">Faire visiter une propriété : inscriptions, plages, registre des visites.</field>
            <field name="sequence">21</field>
        </record>

        <record id="group_bf_visit_user" model="res.groups">
            <field name="name">Courtier</field>
            <field name="category_id" ref="module_category_bf_visit"/>
            <!-- 🔴 Un courtier LIT le moteur de réservation : sans
                 `resource_booking.group_user`, il publie son inscription puis
                 se fait refuser la lecture du type qu'il vient de fabriquer
                 (« You are not allowed to access Resource Booking Type »).
                 Trouvé en jouant le parcours comme un courtier, pas comme
                 administrateur. -->
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('resource_booking.group_user'))]"/>
            <field name="comment">Monte ses inscriptions, tient le registre, constate les arrivées.</field>
        </record>

        <record id="group_bf_visit_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="category_id" ref="module_category_bf_visit"/>
            <field name="implied_ids" eval="[(4, ref('bf_appointment_visit.group_bf_visit_user')), (4, ref('resource_booking.group_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Voit toutes les inscriptions de la société, et reste seul à pouvoir corriger un registre déjà fermé.</field>
        </record>

        <!-- Un courtier voit les inscriptions de sa société. La cloison utile
             n'est pas entre courtiers d'une même agence : c'est entre sociétés,
             et Odoo la tient déjà par company_id. -->
        <record id="rule_bf_visit_listing_company" model="ir.rule">
            <field name="name">Inscriptions : par société</field>
            <field name="model_id" ref="model_bf_visit_listing"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_bf_visit_company" model="ir.rule">
            <field name="name">Visites : par société</field>
            <field name="model_id" ref="model_bf_visit"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
