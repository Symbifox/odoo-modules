<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_editorial_waiver_form" model="ir.ui.view">
        <field name="name">bf.editorial.waiver.form</field>
        <field name="model">bf.editorial.waiver</field>
        <field name="arch" type="xml">
            <form string="Sign a waiver">
                <field name="entry_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <p>
                        The QA keeps saying what it sees. What you are signing is the refusal to publish: it gives way on the reasons below, and on those only.
                    </p>
                    <p class="mb-0">
                        As soon as the article text changes, the waiver stops covering anything and the guard resumes.
                    </p>
                </div>
                <group>
                    <field name="problems" nolabel="1" colspan="2"
                           readonly="1"/>
                </group>
                <group>
                    <field name="reason" nolabel="1" colspan="2"
                           placeholder="Why these reasons are acceptable on this article."/>
                </group>
                <footer>
                    <button name="action_sign" type="object" string="Sign"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
