msgstr "(sans titre)"

#. module: bf_federation_gantt
#: model_terms:ir.ui.view,arch_db:bf_federation_gantt.view_bf_gantt_plan_form_federation
msgid ""
". It is read-only here: the sender's next change will replace it, and it is "
"not published to the portal."
msgstr ""
".\n"
"                    Il se lit ici : le prochain changement de l'émetteur le remplacera, et il ne se\n"
"                    publie pas au portail."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "<p>At %s, the schedule changed: from %s to %s, status %s.</p>"
msgstr "<p>Chez %s, l'échéancier a changé : du %s au %s, statut %s.</p>"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid ""
"<p>Schedule received from %s: <b>%s</b>, %s line(s). It is read-only here; "
"each change by the sender will replace it.</p>"
msgstr ""
"<p>Échéancier reçu de %s : <b>%s</b>, %s ligne(s). Il se lit ici ; chaque "
"changement de l'émetteur le remplacera.</p>"

#. module: bf_federation_gantt
#: model:ir.model.fields,help:bf_federation_gantt.field_bf_gantt_plan__federation_is_mirror
msgid ""
"A received schedule is read-only: the sender's next version will replace it."
msgstr ""
"Un échéancier reçu se lit : la prochaine version de l'émetteur le "
"remplacera."

#. module: bf_federation_gantt
