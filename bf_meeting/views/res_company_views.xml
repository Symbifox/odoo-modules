<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_bf_meeting" model="ir.ui.view">
        <field name="name">res.company.form.inherit.bf_meeting</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='logo']" position="after">
                <field name="meeting_logo" widget="image" class="oe_avatar"/>
                <field name="meeting_exchange_default"/>
                <field name="meeting_resend_changes_default"/>
                <field name="meeting_gen_installed" invisible="1"/>
                <field name="meeting_task_assign_quiet" invisible="not meeting_gen_installed"/>
                <field name="meeting_auto_refine" invisible="not meeting_gen_installed"/>
            </xpath>
        </field>
    </record>

</odoo>
