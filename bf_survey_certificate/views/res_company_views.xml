<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_bf_certificate" model="ir.ui.view">
        <field name="name">res.company.form.bf.survey.certificate</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Certificates" name="bf_certificates">
                    <group>
                        <group string="Signature on certificates">
                            <field name="bf_certificate_signatory_name"/>
                            <field name="bf_certificate_signatory_title"/>
                        </group>
                        <group>
                            <field name="bf_certificate_signature" widget="image"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
