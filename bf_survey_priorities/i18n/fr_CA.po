#. module: bf_survey_priorities
#. odoo-python
#: code:addons/bf_survey_priorities/models/survey_question.py:0
msgid "%(column)s = %(points)s pts"
msgstr "%(column)s = %(points)s pts"

#. module: bf_survey_priorities
#. odoo-python
#: code:addons/bf_survey_priorities/models/survey_question.py:0
msgid "%(column)s: %(count)s"
msgstr "%(column)s : %(count)s"

#. module: bf_survey_priorities
#. odoo-python
#: code:addons/bf_survey_priorities/models/survey_survey.py:0
msgid "%(count)s respondent(s)"
msgstr "%(count)s répondant(s)"

#. module: bf_survey_priorities
#. odoo-python
#: code:addons/bf_survey_priorities/models/survey_survey.py:0
msgid ""
"%(count)s ticked several rows in one column: those columns' points are "
"shared"
msgstr ""
"%(count)s ont coché plusieurs lignes dans une même colonne : les points de "
"ces colonnes sont partagés"

#. module: bf_survey_priorities
#. odoo-python
#: code:addons/bf_survey_priorities/models/survey_question.py:0
msgid ""
"%(question)s: a mandatory matrix needs an answer on every row, and \"One row"
" per column\" allows only one row under each column. With more rows than "
"columns, nobody could finish the survey: make the question optional or "
"uncheck \"One row per column\"."
msgstr ""
"%(question)s : une matrice obligatoire exige une réponse sur chaque ligne, "
"et « Un seul choix par colonne » ne permet qu'une ligne sous chaque colonne."
" Avec plus de lignes que de colonnes, personne ne pourrait terminer le "
"sondage : rendez la question facultative ou décochez « Un seul choix par "
"colonne »."

#. module: bf_survey_priorities
#: model:ir.model.fields,help:bf_survey_priorities.field_survey_question__bf_rank_weighted
msgid ""
"A matrix whose columns carry points: its weighted trend is shown on the "
"results page and can be exported."
msgstr ""
"Une matrice dont les colonnes portent des points : sa tendance pondérée "
"s'affiche dans la page de résultats et peut être exportée."

#. module: bf_survey_priorities
#: model_terms:ir.ui.view,arch_db:bf_survey_priorities.question_result_matrix_bf_priorities
#: model_terms:ir.ui.view,arch_db:bf_survey_priorities.report_bf_survey_trend
msgid "By group"
msgstr "Par groupe"

#. module: bf_survey_priorities
#. odoo-javascript
#. odoo-python
#: code:addons/bf_survey_priorities/models/survey_question.py:0
#: code:addons/bf_survey_priorities/static/src/js/survey_form_priorities.js:0
msgid "Choose only one row in each column: uncheck the extra rows."
msgstr "Choisissez une seule ligne par colonne : décochez les lignes en trop."

#. module: bf_survey_priorities
#: model_terms:ir.ui.view,arch_db:bf_survey_priorities.report_bf_survey_trend
msgid "Completed responses"
msgstr "Réponses complétées"

#. module: bf_survey_priorities
#. odoo-python
#: code:addons/bf_survey_priorities/models/survey_survey.py:0
msgid ""
"Completed responses, test entries left out: %(count)s. Several rows ticked "
"in one column share that column's points."
msgstr ""
"Réponses complétées, hors essais : %(count)s. Plusieurs lignes cochées dans "
"une même colonne se partagent les points de cette colonne."

#. module: bf_survey_priorities
#: model_terms:ir.ui.view,arch_db:bf_survey_priorities.survey_question_form_inherit_bf_survey_priorities
msgid ""
"Give points to the columns (for example 10, 5 and 2 for priority 1, 2 and 3)"
" to see the weighted trend of all respondents on the results page. Rows can "
"share a group to be added up together."
msgstr ""
"Donnez des points aux colonnes (par exemple 10, 5 et 2 pour les priorités 1,"
" 2 et 3) pour voir la tendance pondérée de l'ensemble des répondants dans la"
" page de résultats. Des lignes peuvent partager un groupe pour être "
"additionnées ensemble."

#. module: bf_survey_priorities
#. odoo-python
