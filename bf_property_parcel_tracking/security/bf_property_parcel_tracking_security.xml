<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_carrier_account_company" model="ir.rule">
            <field name="name">Comptes de transporteur : multi-société</field>
            <field name="model_id" ref="model_bf_property_carrier_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- 🔴 La règle du journal pose `perm_create = False` pour le
             portail, exprès : un occupant n'écrit pas au registre de ce qui
             est reçu. Annoncer son propre colis n'est pas écrire au registre,
             et cette règle-ci n'ouvre QUE la création, et seulement pour ses
             propres colis. Elle s'ajoute à celle du journal, elle ne la
             réécrit pas. -->
        <record id="rule_parcel_portal_announce" model="ir.rule">
            <field name="name">Colis : annoncer le sien</field>
            <field name="model_id" ref="bf_property_portal.model_bf_property_parcel"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>
        <!-- Retirer SON annonce, tant qu'elle n'est qu'une annonce. Le
             journal de ce qui est RÉELLEMENT arrivé reste au bureau : la
             règle ne couvre que l'état « annoncé ». -->
        <record id="rule_parcel_portal_cancel" model="ir.rule">
            <field name="name">Colis : retirer son annonce</field>
            <field name="model_id" ref="bf_property_portal.model_bf_property_parcel"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('state', '=', 'expected')]</field>
        </record>
    </data>
</odoo>
