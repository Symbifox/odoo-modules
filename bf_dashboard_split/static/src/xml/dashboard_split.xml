<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="bf_dashboard_split.PaneSwitcher">
        <div class="bf-dash-switcher btn-group btn-group-sm" role="group">
            <t t-foreach="types" t-as="t" t-key="t">
                <button type="button"
                        class="btn"
                        t-att-class="t === current ? 'bf-dash-switch-active' : 'bf-dash-switch-idle'"
                        t-att-title="meta(t).label"
                        t-on-click="() => setType(t)">
                    <i class="fa" t-attf-class="fa {{meta(t).icon}}"/>
                </button>
            </t>
        </div>
    </t>

    <t t-name="bf_dashboard_split.View">
        <div class="bf-dash-split o_action_manager">
            <div class="bf-dash-top">
                <div class="bf-dash-pane bf-dash-tl">
                    <t t-call="bf_dashboard_split.PaneSwitcher">
                        <t t-set="types" t-value="activitiesViewTypes"/>
                        <t t-set="current" t-value="state.activitiesType"/>
                        <t t-set="meta" t-value="(t) => viewMeta(t)"/>
                        <t t-set="setType" t-value="(t) => setType('activities', t)"/>
                    </t>
                    <View t-props="activitiesProps"/>
                </div>
                <div class="bf-dash-pane bf-dash-tr">
                    <t t-call="bf_dashboard_split.PaneSwitcher">
                        <t t-set="types" t-value="tasksViewTypes"/>
                        <t t-set="current" t-value="state.tasksType"/>
                        <t t-set="meta" t-value="(t) => viewMeta(t)"/>
                        <t t-set="setType" t-value="(t) => setType('tasks', t)"/>
                    </t>
                    <View t-props="tasksProps"/>
                </div>
            </div>
            <div class="bf-dash-bottom">
                <div class="bf-dash-pane">
                    <t t-call="bf_dashboard_split.PaneSwitcher">
                        <t t-set="types" t-value="emailViewTypes"/>
                        <t t-set="current" t-value="state.emailType"/>
                        <t t-set="meta" t-value="(t) => viewMeta(t)"/>
                        <t t-set="setType" t-value="(t) => setType('email', t)"/>
                    </t>
                    <View t-props="emailProps"/>
                </div>
            </div>
        </div>
    </t>

</templates>
