<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_otp" model="ir.module.category">
            <field name="name">OTP tokens</field>
            <field name="sequence">32</field>
        </record>

        <record id="group_otp_user" model="res.groups">
            <field name="name">User</field>
            <field name="comment">Can keep their own OTP token vault.</field>
            <field name="category_id" ref="module_category_otp"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- 🔴 La règle la plus importante du module : un coffre n'appartient
             qu'à une personne, et PERSONNE d'autre ne le voit, pas même un
             administrateur fonctionnel.

             Ce n'est pas de la politesse. Le chiffré ne sert à rien sans la
             phrase, mais le laisser lire donnerait à qui veut nuire un point
             de départ pour une attaque hors ligne, et surtout la LISTE des
             comptes protégés, qui est déjà un renseignement.

             uid 1 (le superutilisateur) passe outre, comme partout dans Odoo :
             c'est inhérent, et c'est pour ça que la vraie protection reste que
             la clé n'existe nulle part côté serveur. -->
        <record id="rule_otp_vault_own" model="ir.rule">
            <field name="name">OTP vault: own only</field>
            <field name="model_id" ref="model_bf_otp_vault"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_otp_user'))]"/>
        </record>

        <record id="rule_otp_token_own" model="ir.rule">
            <field name="name">OTP tokens: own only</field>
            <field name="model_id" ref="model_bf_otp_token"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_otp_user'))]"/>
        </record>

        <record id="rule_otp_credential_own" model="ir.rule">
            <field name="name">OTP passkeys: own only</field>
            <field name="model_id" ref="model_bf_otp_credential"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_otp_user'))]"/>
        </record>

        <record id="rule_otp_recovery_own" model="ir.rule">
            <field name="name">OTP recovery codes: own only</field>
            <field name="model_id" ref="model_bf_otp_recovery"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_otp_user'))]"/>
        </record>

        <record id="rule_otp_device_own" model="ir.rule">
            <field name="name">Paired devices: own only</field>
            <field name="model_id" ref="model_bf_otp_device"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_otp_user'))]"/>
        </record>
    </data>
</odoo>
