"                                <img t-att-src=\"sig['logo_url']\" t-att-alt=\"sig['company_name']\" t-attf-style=\"display:block;width:{{ sig['logo_width'] }}px;height:auto;border:0;\" t-att-width=\"sig['logo_width']\"/>\n"
"                            </a>\n"
"                        </td>\n"
"                        <td valign=\"top\" t-attf-style=\"vertical-align:top;color:{{ sig['text_color'] }};\">\n"
