<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bf_outreach_target_list" model="ir.ui.view">
        <field name="name">bf.outreach.target.list</field>
        <field name="model">bf.outreach.target</field>
        <field name="arch" type="xml">
            <list string="Targets" multi_edit="1"
                  decoration-muted="stage_type in ('won', 'lost') or is_excluded"
                  decoration-danger="is_excluded">
                <field name="stage_type" column_invisible="1"/>
                <field name="priority" widget="priority" nolabel="1" optional="show"/>
                <field name="name"/>
                <field name="campaign_id" optional="show"/>
                <field name="contact_name" optional="show"/>
                <field name="phone" widget="phone" optional="show"/>
                <field name="mobile" widget="phone" optional="hide"/>
                <field name="email" widget="email" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="stage_id"/>
                <field name="call_count" string="Calls" sum="Calls"/>
                <field name="email_count" string="Emails" sum="Emails"/>
                <field name="letter_count" string="Letters" sum="Letters" optional="hide"/>
                <field name="last_touch_date" string="Last touch" optional="show"/>
                <field name="next_action_kind" string="Next" optional="show"/>
                <field name="next_action_date" string="Next action"
                       decoration-danger="next_action_date &lt; current_date"
                       decoration-warning="next_action_date == current_date"/>
                <field name="has_reply" optional="hide"/>
                <field name="is_excluded" optional="hide"/>
                <field name="source" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'bf_color': True}" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_log_call" type="object" icon="fa-phone" title="Log a call"/>
                <button name="action_log_email" type="object" icon="fa-envelope" title="Log an email"/>
                <button name="action_log_letter" type="object" icon="fa-envelope-o" title="Log a letter"/>
            </list>
        </field>
    </record>

    <record id="view_bf_outreach_target_kanban" model="ir.ui.view">
        <field name="name">bf.outreach.target.kanban</field>
        <field name="model">bf.outreach.target</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" highlight_color="color"
                    class="o_kanban_small_column" sample="1">
                <field name="next_action_date"/>
                <field name="stage_type"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="name" class="fw-bold fs-6"/>
                            <field name="priority" widget="priority" class="ms-auto"/>
                        </div>
                        <field name="contact_name" invisible="not contact_name" class="text-muted"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'bf_color': True}"/>
                        <div class="mt-1">
                            <span class="me-3"><i class="fa fa-phone me-1" title="Calls"/><field name="call_count"/></span>
                            <span class="me-3"><i class="fa fa-envelope me-1" title="Emails"/><field name="email_count"/></span>
                        </div>
                        <div t-if="record.next_action_date.raw_value" class="mt-1">
                            <i class="fa fa-clock-o me-1" title="Next action"/>
                            <field name="next_action_kind"/>
                            <field name="next_action_date" widget="remaining_days" class="ms-1"/>
                        </div>
                        <footer>
                            <field name="activity_ids" widget="kanban_activity"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bf_outreach_target_form" model="ir.ui.view">
        <field name="name">bf.outreach.target.form</field>
        <field name="model">bf.outreach.target</field>
        <field name="arch" type="xml">
            <form string="Target">
                <header>
                    <button name="action_log_call" type="object" string="Log a call"
                            class="btn-primary" icon="fa-phone"/>
                    <button name="action_log_email" type="object" string="Log an email"
                            icon="fa-envelope"/>
                    <button name="action_log_letter" type="object" string="Log a letter"
                            icon="fa-envelope-o"/>
                    <button name="action_send_campaign_email" type="object"
                            string="Send the email" icon="fa-paper-plane-o"
                            invisible="not email or is_excluded"/>
                    <button name="action_create_partner" type="object" string="Create the contact"
                            invisible="partner_id" icon="fa-address-card-o"/>
                    <button name="action_create_lead" type="object" string="Create an opportunity"
                            invisible="lead_id or is_excluded" icon="fa-star-o"/>
                    <button name="action_do_not_contact" type="object" string="Do not contact"
                            invisible="is_excluded" icon="fa-ban" class="btn-secondary"/>
                    <button name="action_allow_contact_again" type="object" string="Lift the exclusion"
                            invisible="not do_not_contact" icon="fa-undo"
                            groups="bf_outreach.group_bf_outreach_manager"
                            confirm="Lifting the exclusion restarts outreach on this target. Confirm?"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-history" type="object"
                                name="action_open_touches">
                            <field name="touch_count" widget="statinfo" string="Interactions"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-star" type="object"
                                name="action_open_lead" invisible="not lead_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Opportunity</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Do not contact" bg_color="text-bg-danger"
                            invisible="not is_excluded"/>
                    <widget name="web_ribbon" title="Converted" bg_color="text-bg-success"
                            invisible="stage_type != 'won' or is_excluded"/>
                    <widget name="web_ribbon" title="Dropped" bg_color="text-bg-danger"
                            invisible="stage_type != 'lost' or is_excluded"/>
                    <div class="oe_title">
                        <label for="name" string="Target"/>
                        <h1><field name="name" placeholder="Organization name"/></h1>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color', 'bf_color': True}" placeholder="Tags"/>
                    </div>
                    <group>
                        <group string="Contact details">
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="function"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group string="Follow-up">
                            <field name="campaign_id" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="priority" widget="priority"/>
                            <field name="source"/>
                            <field name="paused_until"/>
                            <field name="closed_reason" invisible="stage_type not in ('won', 'lost')"/>
                            <field name="lead_id" invisible="not lead_id" readonly="1"/>
                            <field name="do_not_contact" readonly="1"/>
                            <field name="do_not_contact_reason" readonly="1"
                                   invisible="not do_not_contact"/>
                            <field name="do_not_contact_date" readonly="1"
                                   invisible="not do_not_contact"/>
                            <field name="do_not_contact_user_id" readonly="1"
                                   invisible="not do_not_contact"/>
                            <field name="is_excluded" invisible="1"/>
                            <field name="email_normalized" invisible="1"/>
                            <field name="phone_normalized" invisible="1"/>
                            <field name="stage_type" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                            <field name="color" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="History">
                            <field name="call_count"/>
                            <field name="email_count"/>
                            <field name="letter_count"/>
                            <field name="last_touch_date"/>
                            <field name="has_reply"/>
                        </group>
                        <group string="Next follow-up">
                            <field name="next_action_kind"/>
                            <field name="next_action_date"
                                   decoration-danger="next_action_date &lt; current_date"/>
                            <field name="next_call_date"/>
                            <field name="next_email_date"/>
                            <field name="next_letter_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Interactions" name="touches">
                            <field name="touch_ids" context="{'default_target_id': id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="kind"/>
                                    <field name="direction"/>
                                    <field name="outcome"/>
                                    <field name="duration" optional="hide"/>
                                    <field name="summary"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pitch" name="pitch"
                              invisible="not campaign_pitch">
                            <field name="campaign_pitch" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Context, objections, commitments made…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bf_outreach_target_calendar" model="ir.ui.view">
        <field name="name">bf.outreach.target.calendar</field>
        <field name="model">bf.outreach.target</field>
        <field name="arch" type="xml">
            <calendar string="Follow-ups" date_start="next_action_date" color="user_id"
                      mode="month" hide_time="true" quick_create="0">
                <field name="color_resolved" invisible="1"/>
                <field name="user_id" filters="1"/>
                <field name="campaign_id"/>
                <field name="next_action_kind"/>
            </calendar>
        </field>
    </record>

    <record id="view_bf_outreach_target_pivot" model="ir.ui.view">
        <field name="name">bf.outreach.target.pivot</field>
        <field name="model">bf.outreach.target</field>
        <field name="arch" type="xml">
            <pivot string="Targets">
                <field name="campaign_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="call_count" type="measure"/>
                <field name="email_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_bf_outreach_target_graph" model="ir.ui.view">
        <field name="name">bf.outreach.target.graph</field>
        <field name="model">bf.outreach.target</field>
        <field name="arch" type="xml">
            <graph string="Targets" type="bar">
                <field name="campaign_id"/>
                <field name="stage_id"/>
            </graph>
        </field>
    </record>

    <record id="view_bf_outreach_target_activity" model="ir.ui.view">
        <field name="name">bf.outreach.target.activity</field>
        <field name="model">bf.outreach.target</field>
        <field name="arch" type="xml">
            <activity string="Targets">
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <field name="name" class="fw-bold"/>
                            <span class="text-muted"><field name="campaign_id"/></span>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="view_bf_outreach_target_search" model="ir.ui.view">
        <field name="name">bf.outreach.target.search</field>
        <field name="model">bf.outreach.target</field>
        <field name="arch" type="xml">
            <search string="Targets">
                <field name="name" string="Target"
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('contact_name', 'ilike', self), ('email', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="campaign_id"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <field name="tag_ids"/>
                <field name="source"/>
                <filter name="my_targets" string="My targets" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="due" string="Due"
                        domain="[('next_action_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('next_action_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="due_today" string="Today"
                        domain="[('next_action_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="untouched" string="Never contacted" domain="[('touch_count', '=', 0)]"/>
                <filter name="excluded" string="Do not contact" domain="[('is_excluded', '=', True)]"/>
                <filter name="replied" string="Replied" domain="[('has_reply', '=', True)]"/>
                <filter name="no_reply" string="No reply" domain="[('has_reply', '=', False), ('touch_count', '&gt;', 0)]"/>
                <separator/>
                <filter name="open" string="Open targets" domain="[('stage_type', 'in', ('todo', 'active'))]"/>
                <filter name="won" string="Converted targets" domain="[('stage_type', '=', 'won')]"/>
                <filter name="lost" string="Dropped targets" domain="[('stage_type', '=', 'lost')]"/>
                <separator/>
                <filter name="running_campaign" string="Running campaigns"
                        domain="[('campaign_state', '=', 'running')]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_by_campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_by_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_by_user" string="Owner" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_next" string="Next action" context="{'group_by': 'next_action_date'}"/>
                    <filter name="group_by_kind" string="Next action type" context="{'group_by': 'next_action_kind'}"/>
                    <filter name="group_by_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_outreach_target" model="ir.actions.act_window">
        <field name="name">Targets</field>
        <field name="res_model">bf.outreach.target</field>
        <field name="view_mode">kanban,list,form,calendar,activity,pivot,graph</field>
        <field name="search_view_id" ref="view_bf_outreach_target_search"/>
        <field name="context">{'search_default_running_campaign': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No target yet</p>
            <p>
                Add targets from the campaign, or select contacts then use the "Add to an outreach campaign" action.
            </p>
        </field>
    </record>

    <record id="action_bf_outreach_target_due" model="ir.actions.act_window">
        <field name="name">Due today</field>
        <field name="res_model">bf.outreach.target</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="search_view_id" ref="view_bf_outreach_target_search"/>
        <field name="context">{'search_default_due': 1, 'search_default_my_targets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to follow up today</p>
            <p>Targets come back here according to the cadence set on their campaign.</p>
        </field>
    </record>

    <record id="action_bf_outreach_target_overdue" model="ir.actions.act_window">
        <field name="name">Overdue follow-ups</field>
        <field name="res_model">bf.outreach.target</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_bf_outreach_target_search"/>
        <field name="context">{'search_default_overdue': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing overdue</p>
            <p>Every target is being followed within the time its campaign allows.</p>
        </field>
    </record>

</odoo>
