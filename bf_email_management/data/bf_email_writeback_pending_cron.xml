<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          « Traité » depuis la boîte web n'attend plus le serveur IMAP.
          `action_archive` pose `imap_writeback_pending` et déclenche ce cron
          (`_trigger`), qui range dans les secondes qui suivent. Le passage
          horaire n'est qu'un filet.
        -->
        <record id="ir_cron_bf_email_writeback_pending" model="ir.cron">
            <field name="name">Courriels : rangement IMAP différé (Traité)</field>
            <field name="model_id" ref="model_bf_email"/>
            <field name="state">code</field>
            <field name="code">model._cron_imap_writeback_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
