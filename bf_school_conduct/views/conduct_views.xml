<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_school_incident_view_form" model="ir.ui.view">
        <field name="name">bf.school.incident.form</field>
        <field name="model">bf.school.incident</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_inform_parents" type="object" string="Inform the parents" class="btn-primary"
                            invisible="parents_informed_on"
                            confirm="The adults who receive notices will get an email, and the breach will appear in their family portal. Continue?"/>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="date"/>
                            <field name="rule_id"/>
                            <field name="is_violence" invisible="1"/>
                            <field name="is_sexual" invisible="1"/>
                            <field name="reported_by_id"/>
                        </group>
                        <group>
                            <field name="prior_count"/>
                            <field name="suggested_sanction_id"/>
                            <field name="sanction_id"/>
                            <field name="student_consent" invisible="not is_sexual"/>
                            <field name="parents_informed_on"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What happened, in plain words. The family reads it once informed."/>
                    <group>
                        <field name="restorative_measure"/>
                        <field name="suspension_reasons" invisible="not sanction_id"/>
                        <field name="support_measures" invisible="not sanction_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_school_incident_view_list" model="ir.ui.view">
        <field name="name">bf.school.incident.list</field>
        <field name="model">bf.school.incident</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_violence">
                <field name="date"/>
                <field name="student_id"/>
                <field name="rule_id"/>
                <field name="sanction_id"/>
                <field name="is_violence" column_invisible="1"/>
                <field name="parents_informed_on"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="bf_school_incident_view_pivot" model="ir.ui.view">
        <field name="name">bf.school.incident.pivot</field>
        <field name="model">bf.school.incident</field>
        <field name="arch" type="xml">
            <pivot string="Annual report on bullying and violence">
                <field name="rule_id" type="row"/>
                <field name="date" interval="year" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="bf_school_followup_view_form" model="ir.ui.view">
        <field name="name">bf.school.followup.form</field>
        <field name="model">bf.school.followup</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="case"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="last_communication"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="communication_ids">
                        <list editable="top">
                            <field name="date"/>
                            <field name="channel"/>
                            <field name="summary"/>
                            <field name="author_id"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_school_followup_view_list" model="ir.ui.view">
        <field name="name">bf.school.followup.list</field>
        <field name="model">bf.school.followup</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="case"/>
                <field name="responsible_id"/>
                <field name="last_communication"/>
            </list>
        </field>
    </record>

    <record id="bf_school_incident_action" model="ir.actions.act_window">
        <field name="name">Breaches of the rules</field>
        <field name="res_model">bf.school.incident</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
    <record id="bf_school_violence_report_action" model="ir.actions.act_window">
        <field name="name">Annual report on bullying and violence</field>
        <field name="res_model">bf.school.incident</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('is_violence', '=', True)]</field>
    </record>
    <record id="bf_school_followup_action" model="ir.actions.act_window">
        <field name="name">Monthly follow-ups</field>
        <field name="res_model">bf.school.followup</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="bf_school_conduct_rule_action" model="ir.actions.act_window">
        <field name="name">Rules of conduct</field>
        <field name="res_model">bf.school.conduct.rule</field>
        <field name="view_mode">list</field>
    </record>
    <record id="bf_school_sanction_action" model="ir.actions.act_window">
        <field name="name">Sanctions</field>
        <field name="res_model">bf.school.sanction</field>
        <field name="view_mode">list</field>
    </record>

    <record id="bf_school_conduct_rule_view_list" model="ir.ui.view">
        <field name="name">bf.school.conduct.rule.list</field>
        <field name="model">bf.school.conduct.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_violence"/>
                <field name="is_sexual"/>
            </list>
        </field>
    </record>
    <record id="bf_school_sanction_view_list" model="ir.ui.view">
        <field name="name">bf.school.sanction.list</field>
        <field name="model">bf.school.sanction</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="level"/>
                <field name="is_suspension"/>
                <field name="is_restorative"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_school_conduct_root" name="Conduct" parent="bf_school_core.menu_school_root" sequence="17"/>
    <menuitem id="menu_school_incidents" name="Breaches" parent="menu_school_conduct_root"
              action="bf_school_incident_action" sequence="10"/>
    <menuitem id="menu_school_followups" name="Monthly follow-ups" parent="menu_school_conduct_root"
              action="bf_school_followup_action" sequence="20"/>
    <menuitem id="menu_school_violence_report" name="Annual report" parent="menu_school_conduct_root"
              action="bf_school_violence_report_action" sequence="30" groups="bf_school_core.group_school_manager"/>
    <menuitem id="menu_school_conduct_rules" name="Rules of conduct" parent="bf_school_core.menu_school_config"
              action="bf_school_conduct_rule_action" sequence="60"/>
    <menuitem id="menu_school_sanctions" name="Sanctions" parent="bf_school_core.menu_school_config"
              action="bf_school_sanction_action" sequence="70"/>
</odoo>
