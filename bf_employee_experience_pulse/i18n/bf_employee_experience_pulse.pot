#. module: bf_employee_experience_pulse
#: model:mail.template,body_html:bf_employee_experience_pulse.mail_template_pulse_invite
msgid ""
"<div style=\"font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; color: #2e3132;\">\n"
"                    <p>Bonjour,</p>\n"
"                    <p>\n"
"                        Voici votre lien pour la vague\n"
"                        <t t-out=\"object.campaign_id.name or ''\"/>.\n"
"                        Ça prend deux minutes.\n"
"                    </p>\n"
"                    <p style=\"margin: 1.5rem 0;\">\n"
"                        <a t-attf-href=\"{{ object.campaign_id.get_base_url() }}/pulse/{{ object.token }}\" style=\"background:#29abe2;color:#fff;padding:.7rem 1.4rem;border-radius:.35rem;text-decoration:none;\">\n"
"                            Répondre\n"
"                        </a>\n"
"                    </p>\n"
"                    <p style=\"font-size:.9rem;color:#5b6163;\">\n"
"                        Vos réponses ne portent pas votre nom. Le lien sait que\n"
"                        vous avez répondu, pour ne pas vous relancer pour rien,\n"
"                        et il ne retient ni l'heure ni le contenu de votre\n"
"                        réponse. Un résultat ne s'affiche qu'au-dessus de\n"
"                        <t t-out=\"object.campaign_id.score_threshold or 3\"/>\n"
"                        répondants.\n"
"                    </p>\n"
"                    <p style=\"font-size:.9rem;color:#5b6163;\">\n"
"                        Ce lien est personnel : il ne sert qu'une fois, et\n"
"                        c'est ce qui empêche une même personne de peser deux\n"
"                        fois dans le résultat. Ne le transférez pas.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

