<odoo>
    <record id="donation_tax_receipt_form_bf" model="ir.ui.view">
        <field name="name">donation.tax.receipt.form.bf</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_void"
                    type="object"
                    string="Annuler le reçu"
                    confirm="Annuler ce reçu officiel ? Le reçu sera conservé pour l'audit mais marqué annulé."
                    invisible="state == 'cancelled'"
                />
                <button
                    name="action_reissue"
                    type="object"
                    string="Réémettre"
                    class="btn-primary"
                    invisible="state != 'cancelled'"
                />
                <field name="state" widget="statusbar" statusbar_visible="issued,cancelled" />
            </header>
            <field name="amount" position="after">
                <field name="advantage_amount" />
                <field name="advantage_description" />
                <field name="eligible_amount" />
                <field name="in_kind" />
                <field name="fmv" invisible="not in_kind" />
                <field name="property_description" invisible="not in_kind" />
                <field name="appraiser_name" invisible="not in_kind" />
                <field name="appraiser_address" invisible="not in_kind" />
                <field name="cancel_reason" invisible="state != 'cancelled'" />
                <field name="replaced_receipt_id" invisible="not replaced_receipt_id" />
                <field
                    name="replacement_receipt_id"
                    invisible="not replacement_receipt_id"
                />
            </field>
        </field>
    </record>

    <record id="donation_tax_receipt_tree_bf" model="ir.ui.view">
        <field name="name">donation.tax.receipt.list.bf</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_tree" />
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="eligible_amount" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'issued'"
                    decoration-danger="state == 'cancelled'"
                />
            </field>
        </field>
    </record>
</odoo>
