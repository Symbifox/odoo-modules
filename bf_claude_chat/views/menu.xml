<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Client action that loads our OWL component -->
    <record id="action_claude_chat" model="ir.actions.client">
        <field name="name">Gen</field>
        <field name="tag">claude_chat</field>
    </record>

    <!-- Top-level menu item -->
    <menuitem
        id="menu_claude_chat_root"
        name="Gen"
        action="action_claude_chat"
        web_icon="bf_claude_chat,static/description/icon.png"
        sequence="99"
    />

    <!-- ============================================================ -->
    <!-- Admin: Session moderation views                              -->
    <!-- ============================================================ -->

    <!-- Tree view -->
    <record id="view_claude_session_tree" model="ir.ui.view">
        <field name="name">claude.chat.session.tree</field>
        <field name="model">claude.chat.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="message_count" string="Messages"/>
                <field name="create_date" string="Created"/>
                <field name="write_date" string="Last Activity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_claude_session_form" model="ir.ui.view">
        <field name="name">claude.chat.session.form</field>
        <field name="model">claude.chat.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_archive" string="Archive"
                            type="object" invisible="not active"/>
                    <button name="action_unarchive" string="Unarchive"
                            type="object" invisible="active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="claude_session_id"/>
                            <field name="create_date"/>
                            <field name="write_date"/>
                            <field name="message_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids" readonly="1">
                                <list>
                                    <field name="role"/>
                                    <field name="content" widget="text"/>
                                    <field name="create_date" string="Sent"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: show all sessions including archived -->
    <record id="action_claude_session_admin" model="ir.actions.act_window">
        <field name="name">All Sessions</field>
        <field name="res_model">claude.chat.session</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_claude_session_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_claude_session_form')}),
        ]"/>
    </record>

    <!-- Admin menu: All Sessions (under GenFox root) -->
    <menuitem
        id="menu_claude_admin"
        name="Administration"
        parent="menu_claude_chat_root"
        sequence="90"
        groups="base.group_system"
    />
    <menuitem
        id="menu_claude_session_admin"
        name="All Sessions"
        parent="menu_claude_admin"
        action="action_claude_session_admin"
        sequence="10"
        groups="base.group_system"
    />
</odoo>
