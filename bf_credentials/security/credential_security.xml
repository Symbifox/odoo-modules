<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Catégorie et groupes créés par project_knowledge_matrix jusqu'à sa
             18.0.12.0.0, puis réattribués à ce module par sa migration
             18.0.13.0.0. Les identifiants externes ne changent pas de NOM,
             seulement de module : qui portait déjà le groupe le garde. -->
        <record id="module_category_credentials" model="ir.module.category">
            <field name="name">Identifiants</field>
            <field name="sequence">31</field>
        </record>

        <record id="group_credential_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="comment">Peut consulter et modifier les identifiants des projets auxquels il a accès.</field>
            <field name="category_id" ref="module_category_credentials"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <record id="group_credential_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="comment">Accès complet à tous les identifiants, y compris restreints, gestion des types et suppression.</field>
            <field name="category_id" ref="module_category_credentials"/>
            <field name="implied_ids" eval="[(4, ref('bf_credentials.group_credential_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- Identifiants : les utilisateurs voient ceux de leurs projets.

             Pas de clause « project_id = False » ici, contrairement aux
             documents : un identifiant sans projet ne serait visible de
             personne, et c'est voulu. Un secret qui n'est rattaché à rien n'a
             pas de porteur à qui l'ouvrir. -->
        <record id="rule_credential_user" model="ir.rule">
            <field name="name">Identifiants : Membres du projet</field>
            <field name="model_id" ref="model_project_credential"/>
            <field name="domain_force">[
                ('project_id.message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_credential_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_credential_manager" model="ir.rule">
            <field name="name">Identifiants : Accès complet gestionnaire</field>
            <field name="model_id" ref="model_project_credential"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_credential_manager'))]"/>
        </record>

        <record id="rule_credential_type_read" model="ir.rule">
            <field name="name">Types d'identifiants : Accès en lecture</field>
            <field name="model_id" ref="model_project_credential_type"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_credential_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Porteurs de deuxième facteur : lisibles par tous les utilisateurs
             d'identifiants, modifiables par les seuls gestionnaires. Le modèle
             ne contient aucun secret, mais la liste des endroits où vivent les
             facteurs est une carte utile à qui veut nuire : elle reste sous le
             même toit que le reste du coffre. -->
        <record id="rule_credential_vault_read" model="ir.rule">
            <field name="name">Porteurs de facteur : accès en lecture</field>
            <field name="model_id" ref="model_project_credential_vault"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_credential_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_credential_vault_manager" model="ir.rule">
            <field name="name">Porteurs de facteur : accès complet gestionnaire</field>
            <field name="model_id" ref="model_project_credential_vault"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_credential_manager'))]"/>
        </record>

        <record id="rule_credential_type_manager" model="ir.rule">
            <field name="name">Types d'identifiants : Accès complet gestionnaire</field>
            <field name="model_id" ref="model_project_credential_type"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_credential_manager'))]"/>
        </record>

    </data>
</odoo>
