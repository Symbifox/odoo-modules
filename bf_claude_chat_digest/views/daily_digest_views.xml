<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_digest_config_form_claude" model="ir.ui.view">
        <field name="name">daily.digest.config.form.claude.usage</field>
        <field name="model">daily.digest.config</field>
        <field name="inherit_id" ref="daily_todo_digest.view_daily_digest_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='widgets']" position="inside">
                <group>
                    <group string="Gen">
                        <field name="include_claude_usage"/>
                        <field name="include_gen_followups"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_claude_account_list_courriel" model="ir.ui.view">
        <field name="name">claude.account.list.courriel</field>
        <field name="model">claude.account</field>
        <field name="inherit_id" ref="bf_claude_chat.view_claude_account_list"/>
        <field name="arch" type="xml">
            <field name="subscription_type" position="before">
                <field name="courriel"/>
            </field>
        </field>
    </record>

    <record id="view_claude_account_form_courriel" model="ir.ui.view">
        <field name="name">claude.account.form.courriel</field>
        <field name="model">claude.account</field>
        <field name="inherit_id" ref="bf_claude_chat.view_claude_account_form"/>
        <field name="arch" type="xml">
            <field name="subscription_type" position="before">
                <field name="courriel"/>
            </field>
        </field>
    </record>

</odoo>
