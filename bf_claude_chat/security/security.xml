<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Users can only see their own sessions -->
    <record id="rule_claude_session_user" model="ir.rule">
        <field name="name">Claude Chat: own sessions only</field>
        <field name="model_id" ref="model_claude_chat_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Users can only see messages in their own sessions -->
    <record id="rule_claude_message_user" model="ir.rule">
        <field name="name">Claude Chat: own messages only</field>
        <field name="model_id" ref="model_claude_chat_message"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Admins can see all sessions -->
    <record id="rule_claude_session_admin" model="ir.rule">
        <field name="name">Claude Chat: admin sees all sessions</field>
        <field name="model_id" ref="model_claude_chat_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_claude_message_admin" model="ir.rule">
        <field name="name">Claude Chat: admin sees all messages</field>
        <field name="model_id" ref="model_claude_chat_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- Steering instructions: everyone reads the shared ones plus their own,
         but may only edit their own. Rules on one model for one group combine
         with OR, and these two govern different operations, so read and write
         stay independent. -->
    <record id="rule_claude_instruction_read" model="ir.rule">
        <field name="name">Claude Steering: read shared and own</field>
        <field name="model_id" ref="model_claude_chat_instruction"/>
        <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_claude_instruction_write" model="ir.rule">
        <field name="name">Claude Steering: edit own only</field>
        <field name="model_id" ref="model_claude_chat_instruction"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_claude_instruction_admin" model="ir.rule">
        <field name="name">Claude Steering: admin manages all</field>
        <field name="model_id" ref="model_claude_chat_instruction"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
