<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Set up the timer</field>
        <field name="description">Choose the timer's rounding, idle threshold and keyboard shortcut.</field>
        <field name="button_text">Open Settings</field>
        <field name="done_text">Timer ready</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>
    <record id="bf_onb_step_presets" model="onboarding.onboarding.step">
        <field name="title">Configure presets</field>
        <field name="description">[action:bf_timesheet_timer.action_bf_timer_preset] Prepare project/task presets to start a timer in one click.</field>
        <field name="button_text">See the presets</field>
        <field name="done_text">Presets ready</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">2</field>
    </record>
    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Timesheet timer</field>
        <field name="route_name">bf_timesheet_timer_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_timesheet_timer</field>
        <field name="step_ids" eval="[
            Command.link(ref('bf_timesheet_timer.bf_onb_step_settings')),
            Command.link(ref('bf_timesheet_timer.bf_onb_step_presets')),
        ]"/>
    </record>
</odoo>
