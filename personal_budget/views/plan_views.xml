<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_plan_list" model="ir.ui.view">
        <field name="name">personal.budget.plan.list</field>
        <field name="model">personal.budget.plan</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="year desc, category_type, category_id, month"
                  decoration-info="month == 0">
                <header>
                    <button name="action_init_monthly_rows" type="object"
                            string="Initialise 12 months"
                            help="For each selected plan, creates the 12 monthly lines prefilled with annual amount/12."/>
                </header>
                <field name="year"/>
                <field name="month" optional="show"/>
                <field name="month_name" optional="hide"/>
                <field name="category_id"/>
                <field name="category_type" widget="badge"
                       decoration-info="category_type == 'revenue'"
                       decoration-muted="category_type == 'expense'"/>
                <field name="planned_amount" sum="Planned total"/>
                <field name="planned_monthly" optional="hide"/>
                <field name="book_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_budget_plan_form" model="ir.ui.view">
        <field name="name">personal.budget.plan.form</field>
        <field name="model">personal.budget.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_init_monthly_rows" type="object"
                            string="Initialise 12 months"
                            class="btn-primary"
                            help="Creates the 12 monthly lines with annual amount/12 as a starting point."
                            invisible="month != 0"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="month_name"/>
                            <field name="category_id"/>
                            <field name="category_type"/>
                            <field name="book_id"/>
                        </group>
                        <group>
                            <field name="planned_amount"/>
                            <field name="planned_monthly"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_plan_pivot" model="ir.ui.view">
        <field name="name">personal.budget.plan.pivot</field>
        <field name="model">personal.budget.plan</field>
        <field name="arch" type="xml">
            <pivot string="Budget grid month × category">
                <field name="category_id" type="row"/>
                <field name="month" type="col"/>
                <field name="planned_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_budget_plan_search" model="ir.ui.view">
        <field name="name">personal.budget.plan.search</field>
        <field name="model">personal.budget.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="category_id"/>
                <field name="year"/>
                <field name="book_id"/>
                <filter name="revenue" string="Income" domain="[('category_type', '=', 'revenue')]"/>
                <filter name="expense" string="Expenses" domain="[('category_type', '=', 'expense')]"/>
                <separator/>
                <filter name="annual_only" string="Annual lines" domain="[('month', '=', 0)]"/>
                <filter name="monthly_only" string="Monthly lines" domain="[('month', '!=', 0)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_book" string="Budget" context="{'group_by': 'book_id'}"/>
                    <filter name="group_year" string="Year" context="{'group_by': 'year'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'category_type'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_budget_plan" model="ir.actions.act_window">
        <field name="name">Budget plans</field>
        <field name="res_model">personal.budget.plan</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_budget_plan_search"/>
    </record>
</odoo>
