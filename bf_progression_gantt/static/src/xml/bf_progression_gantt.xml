<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bf_progression_gantt.Gantt">
        <div class="o_bf_gantt">

            <!-- ============ Toolbar ============ -->
            <div class="o_bf_gantt_toolbar">
                <div class="o_bf_gantt_picker">
                    <i class="fa fa-folder-open-o"/>
                    <select class="form-select form-select-sm" t-on-change="onSelectProject">
                        <option t-foreach="state.portfolio" t-as="p" t-key="p.id"
                                t-att-value="p.id"
                                t-att-selected="p.id === state.projectId"
                                t-esc="p.name"/>
                    </select>
                </div>

                <div class="btn-group btn-group-sm o_bf_gantt_zoom" role="group">
                    <button class="btn"
                            t-att-class="state.zoom === 'day' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.setZoom('day')">Jour</button>
                    <button class="btn"
                            t-att-class="state.zoom === 'week' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.setZoom('week')">Semaine</button>
                    <button class="btn"
                            t-att-class="state.zoom === 'month' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.setZoom('month')">Mois</button>
                </div>

                <div class="o_bf_gantt_legend">
                    <span class="o_bf_gantt_legend_item"><span class="o_bf_gantt_swatch o_bf_gantt_bar_done"/>Terminé</span>
                    <span class="o_bf_gantt_legend_item"><span class="o_bf_gantt_swatch o_bf_gantt_bar_in_progress"/>En cours</span>
                    <span class="o_bf_gantt_legend_item"><span class="o_bf_gantt_swatch o_bf_gantt_bar_overdue"/>En retard</span>
                    <span class="o_bf_gantt_legend_item"><span class="o_bf_gantt_swatch o_bf_gantt_bar_upcoming"/>À venir</span>
                </div>

                <button class="btn btn-sm btn-light ms-auto" t-on-click="refresh"
                        title="Rafraîchir"><i class="fa fa-refresh"/></button>
            </div>

            <!-- ============ States ============ -->
            <t t-if="state.loading">
                <div class="o_bf_gantt_center">
                    <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                </div>
            </t>

            <t t-elif="!hasData">
                <div class="o_bf_gantt_center text-muted">
                    <i class="fa fa-calendar-o fa-3x mb-3"/>
                    <p class="mb-0">Aucune tâche à afficher pour ce projet.</p>
                </div>
            </t>

            <t t-else="">
                <!-- ============ Gantt ============ -->
                <div class="o_bf_gantt_scroll">
                    <div class="o_bf_gantt_grid"
                         t-att-style="'width:' + (260 + layout.chartWidth) + 'px;'">

                        <!-- LEFT : labels -->
                        <div class="o_bf_gantt_left">
                            <div class="o_bf_gantt_corner"
                                 t-att-style="'height:' + headerHeight + 'px;'">
                                <span class="text-truncate fw-bold"
                                      t-esc="state.data.project.name"/>
                            </div>
                            <t t-foreach="layout.rows" t-as="row" t-key="row.key">
                                <div t-if="row.type === 'step'" class="o_bf_gantt_step_label"
                                     t-att-style="'height:' + row.height + 'px;'">
                                    <span class="o_bf_gantt_step_num" t-esc="row.step.number"/>
                                    <span class="o_bf_gantt_step_name text-truncate"
                                          t-esc="row.step.name"/>
                                    <span class="o_bf_gantt_step_pct"
                                          t-esc="row.step.pct + '%'"/>
                                </div>
                                <div t-else="" class="o_bf_gantt_task_label"
                                     t-att-style="'height:' + row.height + 'px;'"
                                     t-on-click="() => this.openTask(row.task.id)">
                                    <span class="o_bf_gantt_task_name text-truncate"
                                          t-esc="row.task.name"/>
                                    <span t-if="row.task.assignee"
                                          class="o_bf_gantt_task_user text-truncate"
                                          t-esc="row.task.assignee"/>
                                </div>
                            </t>
                        </div>

                        <!-- RIGHT : timeline -->
                        <div class="o_bf_gantt_right"
                             t-att-style="'width:' + layout.chartWidth + 'px;'">

                            <div class="o_bf_gantt_header"
                                 t-att-style="'height:' + headerHeight + 'px;'">
                                <div class="o_bf_gantt_months">
                                    <div t-foreach="layout.months" t-as="m" t-key="m_index"
                                         class="o_bf_gantt_month"
                                         t-att-style="'left:' + m.left + 'px; width:' + m.width + 'px;'">
                                        <span class="text-truncate" t-esc="m.label"/>
                                    </div>
                                </div>
                                <div class="o_bf_gantt_ticks">
                                    <div t-foreach="layout.ticks" t-as="tk" t-key="tk_index"
                                         class="o_bf_gantt_tick"
                                         t-att-class="tk.major ? 'o_bf_gantt_tick_major' : ''"
                                         t-att-style="'left:' + tk.x + 'px;'">
                                        <span t-esc="tk.label"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_bf_gantt_body"
                                 t-att-style="'height:' + layout.chartHeight + 'px;'">

                                <div t-foreach="layout.ticks" t-as="gl" t-key="gl_index"
                                     class="o_bf_gantt_gridline"
                                     t-att-class="gl.major ? 'o_bf_gantt_gridline_major' : ''"
                                     t-att-style="'left:' + gl.x + 'px;'"/>

                                <div t-if="layout.todayX !== null" class="o_bf_gantt_today"
                                     t-att-style="'left:' + layout.todayX + 'px;'"/>

                                <t t-foreach="layout.rows" t-as="row" t-key="'b' + row.key">
                                    <div t-if="row.type === 'step'" class="o_bf_gantt_step_band"
                                         t-att-style="'top:' + row.top + 'px; height:' + row.height + 'px;'"/>
                                    <div t-else="" class="o_bf_gantt_bar"
                                         t-att-class="barClass(row.task.status)"
                                         t-att-style="'top:' + (row.top + (row.height - barHeight) / 2) + 'px; left:' + row.x + 'px; width:' + row.w + 'px; height:' + barHeight + 'px;'"
                                         t-on-click="() => this.openTask(row.task.id)"
                                         t-on-mouseenter="(ev) => this.onBarEnter(row.task, ev)"
                                         t-on-mouseleave="onBarLeave">
                                        <div class="o_bf_gantt_bar_fill"
                                             t-att-style="'width:' + row.task.progress + '%;'"/>
                                        <span class="o_bf_gantt_bar_pct"
                                              t-esc="row.task.progress + '%'"/>
                                    </div>
                                </t>

                                <svg class="o_bf_gantt_arrows"
                                     t-att-width="layout.chartWidth"
                                     t-att-height="layout.chartHeight">
                                    <defs>
                                        <marker id="bfGanttArrow" markerWidth="8" markerHeight="8"
                                                refX="7" refY="3" orient="auto">
                                            <path d="M0,0 L7,3 L0,6 Z"/>
                                        </marker>
                                    </defs>
                                    <path t-foreach="layout.arrows" t-as="ar" t-key="ar_index"
                                          t-att-d="ar.d" class="o_bf_gantt_arrow"
                                          marker-end="url(#bfGanttArrow)"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ============ Tooltip ============ -->
                <div t-if="state.hover" class="o_bf_gantt_tooltip"
                     t-att-style="'left:' + (state.hover.x + 14) + 'px; top:' + (state.hover.y + 14) + 'px;'">
                    <div class="o_bf_gantt_tip_title" t-esc="state.hover.task.name"/>
                    <div class="o_bf_gantt_tip_status">
                        <span class="o_bf_gantt_swatch" t-att-class="barClass(state.hover.task.status)"/>
                        <span t-esc="statusLabel(state.hover.task.status)"/>
                        <span class="ms-auto fw-bold" t-esc="state.hover.task.progress + '%'"/>
                    </div>
                    <div class="o_bf_gantt_tip_row">
                        <i class="fa fa-calendar-o"/>
                        <span t-esc="formatDate(state.hover.task.start)"/>
                        <span>→</span>
                        <span t-esc="formatDate(state.hover.task.end)"/>
                    </div>
                    <div class="o_bf_gantt_tip_row" t-if="state.hover.task.deadline">
                        <i class="fa fa-flag-checkered"/>
                        <span>Échéance : <t t-esc="formatDate(state.hover.task.deadline)"/></span>
                    </div>
                    <div class="o_bf_gantt_tip_row" t-if="state.hover.task.assignee">
                        <i class="fa fa-user-o"/>
                        <span t-esc="state.hover.task.assignee"/>
                    </div>
                    <div class="o_bf_gantt_tip_row" t-if="state.hover.task.allocated_hours">
                        <i class="fa fa-clock-o"/>
                        <span>
                            <t t-esc="state.hover.task.effective_hours"/> /
                            <t t-esc="state.hover.task.allocated_hours"/> h
                        </span>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
