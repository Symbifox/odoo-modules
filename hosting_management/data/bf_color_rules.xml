<?xml version="1.0" encoding="utf-8"?>
<!-- Règle de couleur par défaut : l'agenda garde son critère d'aujourd'hui, et une
     couleur posée sur la valeur (un projet, un pilier) s'affiche. Modifiable, jamais réécrite. -->
<odoo noupdate="1">
    <record id="bf_color_rule_maintenance_type" model="bf.color.rule">
        <field name="name">Maintenances selon le type</field>
        <field name="sequence">100</field>
        <field name="company_id" eval="False"/>
        <field name="model_id" ref="hosting_management.model_hosting_maintenance_schedule"/>
        <field name="field_id" ref="hosting_management.field_hosting_maintenance_schedule__maintenance_type"/>
    </record>
</odoo>
