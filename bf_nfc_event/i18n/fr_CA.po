#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Attendance recorded by tag at %s, sent later."
msgstr "Présence notée par pastille à %s, envoyée en différé."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid ""
"Attendance recorded, and registration created: you were not registered."
msgstr "Présence notée, et inscription créée : vous n'étiez pas inscrit."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Attendance recorded. Enjoy the session."
msgstr "Présence notée. Bonne séance."

#. module: bf_nfc_event
#: model:ir.model.fields,field_description:bf_nfc_event.field_bf_nfc_gesture__kind
msgid "Kind"
msgstr "Nature"

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "No session in progress at “%s”."
msgstr "Aucune séance en cours à « %s »."

#. module: bf_nfc_event
#: model:bf.nfc.gesture,description:bf_nfc_event.gesture_event_presence
msgid ""
"On the room door (the venue record) or on a session: bringing the phone "
"close records the person's attendance at the session in progress, and "
"creates their registration if they had none."
msgstr ""
"Sur la porte de la salle (la fiche du lieu) ou sur une séance : approcher le"
" téléphone note la présence de la personne à la séance en cours, et crée son"
" inscription si elle n'en avait pas."

#. module: bf_nfc_event
#: model:bf.nfc.gesture,name:bf_nfc_event.gesture_event_presence
#: model:ir.model.fields.selection,name:bf_nfc_event.selection__bf_nfc_gesture__kind__event_presence
msgid "Record my attendance at the session"
msgstr "Noter ma présence à la séance"

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Several sessions are taking place here right now."
msgstr "Plusieurs séances ont lieu ici en ce moment."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "This tag must point to a session or a session's venue."
msgstr "Cette pastille doit viser une séance ou le lieu d'une séance."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Which session?"
msgstr "Quelle séance ?"

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid "Your attendance was already recorded."
msgstr "Votre présence était déjà notée."

#. module: bf_nfc_event
#. odoo-python
#: code:addons/bf_nfc_event/models/bf_nfc_gesture.py:0
msgid ""
"“%(seance)s” takes place on %(quand)s: attendance is recorded during the "
"session."
msgstr ""
"« %(seance)s » a lieu le %(quand)s : la présence se note pendant la séance."
