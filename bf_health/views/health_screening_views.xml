<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="health_screening_view_list" model="ir.ui.view">
        <field name="name">health.screening.list</field>
        <field name="model">health.screening</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="screening_type"/>
                <field name="frequency"/>
                <field name="last_date"/>
                <field name="next_due"/>
                <field name="days_until_due"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'up_to_date'"
                       decoration-warning="state == 'due_soon'"
                       decoration-danger="state == 'overdue'"/>
                <field name="provider"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="health_screening_view_form" model="ir.ui.view">
        <field name="name">health.screening.form</field>
        <field name="model">health.screening</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'examen"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Examen">
                            <field name="screening_type"/>
                            <field name="provider"/>
                        </group>
                        <group string="Fréquence">
                            <field name="frequency"/>
                            <field name="frequency_months"
                                   invisible="frequency != 'custom'"/>
                            <field name="lead_days"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="last_date"/>
                            <field name="next_due"/>
                            <field name="days_until_due"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="health_screening_view_kanban" model="ir.ui.view">
        <field name="name">health.screening.kanban</field>
        <field name="model">health.screening</field>
        <field name="arch" type="xml">
            <kanban default_group_by="screening_type">
                <field name="name"/>
                <field name="screening_type"/>
                <field name="next_due"/>
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <field name="color" widget="color_picker"/>
                        <div class="fw-bold fs-5 mb-1">
                            <field name="name"/>
                        </div>
                        <div class="text-muted">
                            <field name="frequency"/>
                        </div>
                        <div t-if="record.next_due.raw_value" class="mt-1">
                            Prochaine : <field name="next_due"/>
                        </div>
                        <div class="mt-1">
                            <field name="state" widget="badge"
                                   decoration-success="state == 'up_to_date'"
                                   decoration-warning="state == 'due_soon'"
                                   decoration-danger="state == 'overdue'"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar -->
    <record id="health_screening_view_calendar" model="ir.ui.view">
        <field name="name">health.screening.calendar</field>
        <field name="model">health.screening</field>
        <field name="arch" type="xml">
            <calendar string="Examens" date_start="next_due" color="screening_type" mode="month">
                <field name="name"/>
                <field name="screening_type"/>
            </calendar>
        </field>
    </record>

    <!-- Search -->
    <record id="health_screening_view_search" model="ir.ui.view">
        <field name="name">health.screening.search</field>
        <field name="model">health.screening</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="provider"/>
                <filter name="overdue" string="En retard" domain="[('state', '=', 'overdue')]"/>
                <filter name="due_soon" string="Bientôt dû" domain="[('state', '=', 'due_soon')]"/>
                <filter name="up_to_date" string="À jour" domain="[('state', '=', 'up_to_date')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'screening_type'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Activity -->
    <record id="health_screening_view_activity" model="ir.ui.view">
        <field name="name">health.screening.activity</field>
        <field name="model">health.screening</field>
        <field name="arch" type="xml">
            <activity string="Examens">
                <templates>
                    <div t-name="activity-box">
                        <field name="name" display="full"/>
                        <field name="screening_type" muted="1" display="full"/>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- Actions -->
    <record id="health_screening_action" model="ir.actions.act_window">
        <field name="name">Examens</field>
        <field name="res_model">health.screening</field>
        <field name="view_mode">list,kanban,form,calendar,activity</field>
        <field name="search_view_id" ref="health_screening_view_search"/>
    </record>

    <record id="health_screening_calendar_action" model="ir.actions.act_window">
        <field name="name">Calendrier des examens</field>
        <field name="res_model">health.screening</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="health_screening_view_search"/>
    </record>

</odoo>
