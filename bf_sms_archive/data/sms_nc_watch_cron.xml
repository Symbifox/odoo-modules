<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_sms_nc_watch" model="ir.cron">
            <field name="name">SMS &amp; Calls : surveillance dossier Nextcloud</field>
            <field name="model_id" ref="model_sms_archive_import_wizard"/>
            <field name="state">code</field>
            <field name="code">model._cron_nc_watch_import()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <record id="ir_cron_sms_disk_import" model="ir.cron">
            <field name="name">SMS &amp; Calls : import depuis /mnt/sms-inbox</field>
            <field name="model_id" ref="model_sms_archive_import_wizard"/>
            <field name="state">code</field>
            <field name="code">model._cron_disk_import()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

    </data>

    <!-- Config parameters: use function to avoid UniqueViolation on upgrade -->
    <function model="ir.config_parameter" name="set_param">
        <value>bf_sms_archive.nc_watch_path</value>
        <value>/Backups/SMS/Live XML</value>
    </function>
    <function model="ir.config_parameter" name="set_param">
        <value>bf_sms_archive.nc_watch_user_id</value>
        <value>2</value>
    </function>

</odoo>
