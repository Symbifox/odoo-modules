<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_keys" model="ir.module.category">
        <field name="name">Keys</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_key_user" model="res.groups">
        <field name="name">Key holder</field>
        <field name="category_id" ref="module_category_keys"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees the keys they hold, confirms them during an audit, asks for a key.</field>
    </record>

    <record id="group_key_area_manager" model="res.groups">
        <field name="name">Area manager</field>
        <field name="category_id" ref="module_category_keys"/>
        <field name="implied_ids" eval="[(4, ref('group_key_user'))]"/>
        <field name="comment">Approves the requests of their areas, hands out and takes back their keys.</field>
    </record>

    <record id="group_key_manager" model="res.groups">
        <field name="name">Key manager</field>
        <field name="category_id" ref="module_category_keys"/>
        <field name="implied_ids" eval="[(4, ref('group_key_area_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Everything: master key systems, doors, audits, settings.</field>
    </record>

    <!-- Every employee holds keys: every internal user is a key holder. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_key_user'))]"/>
    </record>

    <!-- Companies. -->
    <record id="rule_area_company" model="ir.rule">
        <field name="name">Key areas: companies</field>
        <field name="model_id" ref="model_bf_key_area"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_system_company" model="ir.rule">
        <field name="name">Master key systems: companies</field>
        <field name="model_id" ref="model_bf_key_system"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_type_company" model="ir.rule">
        <field name="name">Key types: companies</field>
        <field name="model_id" ref="model_bf_key_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_door_company" model="ir.rule">
        <field name="name">Doors: companies</field>
        <field name="model_id" ref="model_bf_key_door"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_copy_company" model="ir.rule">
        <field name="name">Key copies: companies</field>
        <field name="model_id" ref="model_bf_key_copy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_assignment_company" model="ir.rule">
        <field name="name">Key hand-outs: companies</field>
        <field name="model_id" ref="model_bf_key_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_request_company" model="ir.rule">
        <field name="name">Key requests: companies</field>
        <field name="model_id" ref="model_bf_key_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_incident_company" model="ir.rule">
        <field name="name">Key incidents: companies</field>
        <field name="model_id" ref="model_bf_key_incident"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_audit_company" model="ir.rule">
        <field name="name">Key audits: companies</field>
        <field name="model_id" ref="model_bf_key_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_audit_line_company" model="ir.rule">
        <field name="name">Key audit lines: companies</field>
        <field name="model_id" ref="model_bf_key_audit_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Holders: their own. -->
    <record id="rule_copy_holder" model="ir.rule">
        <field name="name">Key copies: the ones I hold</field>
        <field name="model_id" ref="model_bf_key_copy"/>
        <field name="domain_force">[('current_assignment_id.holder_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_key_user'))]"/>
    </record>
    <record id="rule_assignment_holder" model="ir.rule">
        <field name="name">Key hand-outs: mine</field>
        <field name="model_id" ref="model_bf_key_assignment"/>
        <field name="domain_force">[('holder_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_key_user'))]"/>
    </record>
    <record id="rule_request_holder" model="ir.rule">
        <field name="name">Key requests: mine</field>
        <field name="model_id" ref="model_bf_key_request"/>
        <field name="domain_force">['|', ('requested_by_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_key_user'))]"/>
    </record>
    <record id="rule_audit_line_holder" model="ir.rule">
        <field name="name">Key audit lines: mine</field>
        <field name="model_id" ref="model_bf_key_audit_line"/>
        <field name="domain_force">[('holder_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_key_user'))]"/>
    </record>

    <!-- Area responsibles: their areas (and the sub-areas, through all_manager_ids). -->
    <record id="rule_copy_area" model="ir.rule">
        <field name="name">Key copies: my areas</field>
        <field name="model_id" ref="model_bf_key_copy"/>
        <field name="domain_force">[('type_id.area_id.all_manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_key_area_manager'))]"/>
    </record>
    <record id="rule_assignment_area" model="ir.rule">
        <field name="name">Key hand-outs: my areas</field>
        <field name="model_id" ref="model_bf_key_assignment"/>
        <field name="domain_force">[('area_id.all_manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_key_area_manager'))]"/>
    </record>
    <record id="rule_request_area" model="ir.rule">
        <field name="name">Key requests: my areas</field>
        <field name="model_id" ref="model_bf_key_request"/>
        <field name="domain_force">[('area_id.all_manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_key_area_manager'))]"/>
    </record>
    <record id="rule_incident_area" model="ir.rule">
        <field name="name">Key incidents: my areas</field>
        <field name="model_id" ref="model_bf_key_incident"/>
        <field name="domain_force">[('area_id.all_manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_key_area_manager'))]"/>
    </record>
    <record id="rule_audit_line_area" model="ir.rule">
        <field name="name">Key audit lines: my areas</field>
        <field name="model_id" ref="model_bf_key_audit_line"/>
        <field name="domain_force">[('area_id.all_manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_key_area_manager'))]"/>
    </record>

    <record id="rule_audit_area" model="ir.rule">
        <field name="name">Key audits: my areas</field>
        <field name="model_id" ref="model_bf_key_audit"/>
        <field name="domain_force">[('area_id.all_manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_key_area_manager'))]"/>
    </record>

    <!-- Key managers: everything. -->
    <record id="rule_copy_manager" model="ir.rule">
        <field name="name">Key copies: all</field>
        <field name="model_id" ref="model_bf_key_copy"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_manager'))]"/>
    </record>
    <record id="rule_assignment_manager" model="ir.rule">
        <field name="name">Key hand-outs: all</field>
        <field name="model_id" ref="model_bf_key_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_manager'))]"/>
    </record>
    <record id="rule_request_manager" model="ir.rule">
        <field name="name">Key requests: all</field>
        <field name="model_id" ref="model_bf_key_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_manager'))]"/>
    </record>
    <record id="rule_incident_manager" model="ir.rule">
        <field name="name">Key incidents: all</field>
        <field name="model_id" ref="model_bf_key_incident"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_manager'))]"/>
    </record>
    <record id="rule_audit_manager" model="ir.rule">
        <field name="name">Key audits: all</field>
        <field name="model_id" ref="model_bf_key_audit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_manager'))]"/>
    </record>
    <record id="rule_audit_line_manager" model="ir.rule">
        <field name="name">Key audit lines: all</field>
        <field name="model_id" ref="model_bf_key_audit_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_key_manager'))]"/>
    </record>
</odoo>
