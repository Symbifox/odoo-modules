<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Backup Run Tree View -->
    <record id="hosting_backup_run_view_tree" model="ir.ui.view">
        <field name="name">hosting.backup.run.view.tree</field>
        <field name="model">hosting.backup.run</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'success'" decoration-info="state == 'warning'" decoration-warning="state == 'partial'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="run_date" string="Date"/>
                <field name="report_type" widget="badge" decoration-info="report_type == 'restic'" decoration-muted="report_type == 'legacy'"/>
                <field name="hostname" string="Server"/>
                <field name="success_count" string="Succeeded"/>
                <field name="warning_count" string="Warn."/>
                <field name="failed_count" string="Failed"/>
                <field name="skipped_count" string="Skipped services"/>
                <field name="total_count" string="Total"/>
                <field name="state" string="State" widget="badge" decoration-success="state == 'success'" decoration-info="state == 'warning'" decoration-warning="state == 'partial'" decoration-danger="state == 'failed'"/>
                <field name="report_sent" string="Report sent" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Backup Run Form View -->
    <record id="hosting_backup_run_view_form" model="ir.ui.view">
        <field name="name">hosting.backup.run.view.form</field>
        <field name="model">hosting.backup.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_report" string="Send the report" type="object" class="btn-primary" invisible="report_sent"/>
                    <button name="action_send_report" string="Resend the report" type="object" invisible="not report_sent"/>
                    <field name="state" widget="statusbar" statusbar_visible="success,warning,partial,failed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="run_date" string="Run date"/>
                            <field name="report_type" widget="badge"/>
                            <field name="hostname" string="Server"/>
                            <field name="backup_root" string="Root directory" invisible="report_type == 'restic'"/>
                        </group>
                        <group>
                            <field name="success_count" string="Succeeded"/>
                            <field name="warning_count" string="Warnings"/>
                            <field name="failed_count" string="Failed"/>
                            <field name="skipped_count" string="Skipped services"/>
                            <field name="total_count" string="Total"/>
                            <field name="report_sent" string="Report sent"/>
                            <field name="report_sent_date" string="Sending date" invisible="not report_sent"/>
                        </group>
                    </group>
                    <group string="Restic repositories touched" invisible="report_type != 'restic'">
                        <field name="repository_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Backups details" name="details">
                            <field name="line_ids">
                                <list decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-muted="status == 'skipped'">
                                    <field name="service_name" string="Service"/>
                                    <field name="status" string="Status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status in ('skipped', 'partial')"/>
                                    <field name="backup_ratio" string="Archives"/>
                                    <field name="snapshot_count" string="Snapshots"/>
                                    <field name="duration" string="Duration"/>
                                    <field name="exit_code" string="Exit" optional="hide"/>
                                    <field name="file_count" string="Files" optional="hide"/>
                                    <field name="all_verified" string="Verified" widget="boolean" optional="hide"/>
                                    <field name="container_count" string="Containers" optional="hide"/>
                                    <field name="verified_file_count" string="Verified files" optional="hide"/>
                                    <field name="error_message" string="Error" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Restic snapshots" name="restic_snapshots" invisible="report_type != 'restic'">
                            <field name="repository_ids" invisible="1"/>
                            <p class="text-muted">Snapshots produced by this run, grouped by repository.</p>
                            <field name="line_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="service_name"/>
                                    <field name="snapshot_count"/>
                                    <field name="snapshot_ids" widget="many2many_tags" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Backup Line Form View (for popup) -->
    <record id="hosting_backup_line_view_form" model="ir.ui.view">
        <field name="name">hosting.backup.line.view.form</field>
        <field name="model">hosting.backup.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="service_name" string="Service"/>
                            <field name="status" string="Status"/>
                            <field name="duration" string="Duration"/>
                        </group>
                        <group>
                            <field name="container_count" string="Containers"/>
                            <field name="verified_file_count" string="Verified files"/>
                            <field name="backup_ratio" string="Ratio"/>
                            <field name="all_verified" string="All verified"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Backup files">
                        <field name="file_ids" nolabel="1">
                            <list>
                                <field name="name" string="Name"/>
                                <field name="size" string="Size"/>
                                <field name="verified" string="Verified" widget="boolean"/>
                                <field name="checksum" string="Checksum" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Backup Run Search View -->
    <record id="hosting_backup_run_view_search" model="ir.ui.view">
        <field name="name">hosting.backup.run.view.search</field>
        <field name="model">hosting.backup.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="hostname"/>
                <filter string="Today" name="filter_today" domain="[('run_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('run_date', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0)))]"/>
                <filter string="This week" name="filter_week" domain="[('run_date', '>=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This month" name="filter_month" domain="[('run_date', '>=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Restic" name="filter_restic" domain="[('report_type', '=', 'restic')]"/>
                <filter string="Legacy ZIP" name="filter_legacy" domain="[('report_type', '=', 'legacy')]"/>
                <separator/>
                <filter string="Successful" name="filter_success" domain="[('state', '=', 'success')]"/>
                <filter string="Warning" name="filter_warning" domain="[('state', '=', 'warning')]"/>
                <filter string="Partial" name="filter_partial" domain="[('state', '=', 'partial')]"/>
                <filter string="Failed" name="filter_failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="Report not sent" name="filter_not_sent" domain="[('report_sent', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Server" name="group_hostname" context="{'group_by': 'hostname'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'run_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Backup Run Action -->
    <record id="hosting_backup_run_action" model="ir.actions.act_window">
        <field name="name">Backups</field>
        <field name="res_model">hosting.backup.run</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No backups recorded
            </p>
            <p>
                Backups are created automatically when the backup system reports through the API.
            </p>
        </field>
    </record>

</odoo>
