<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
          Dix axes. Le découpage suit ce que la littérature du domaine mesure
          depuis quinze ans, et les libellés sont les nôtres. `noupdate="1"` :
          un client qui renomme un axe ne se le fait pas réécrire à la mise à
          jour suivante.
        -->

        <record id="metric_manager" model="bf.ex.pulse.metric">
            <field name="name">Manager relationship</field>
            <field name="code">manager</field>
            <field name="sequence">10</field>
            <field name="description">The quality of the relationship with the person you report to: availability, trust, and candour in both directions.</field>
        </record>

        <record id="metric_peers" model="bf.ex.pulse.metric">
            <field name="name">Peer relationships</field>
            <field name="code">peers</field>
            <field name="sequence">20</field>
            <field name="description">Day-to-day mutual support, and the climate between the people who work together.</field>
        </record>

        <record id="metric_feedback" model="bf.ex.pulse.metric">
            <field name="name">Feedback</field>
            <field name="code">feedback</field>
            <field name="sequence">30</field>
            <field name="description">Are you told where you stand, often enough and clearly enough for it to be of use?</field>
        </record>

        <record id="metric_recognition" model="bf.ex.pulse.metric">
            <field name="name">Recognition</field>
            <field name="code">recognition</field>
            <field name="sequence">40</field>
            <field name="description">Does good work get noticed, and does it get noticed by the right people?</field>
        </record>

        <record id="metric_growth" model="bf.ex.pulse.metric">
            <field name="name">Growth</field>
            <field name="code">growth</field>
            <field name="sequence">50</field>
            <field name="description">Learning, building skills, and seeing a path ahead.</field>
        </record>

        <record id="metric_alignment" model="bf.ex.pulse.metric">
            <field name="name">Alignment</field>
            <field name="code">alignment</field>
            <field name="sequence">60</field>
            <field name="description">Understanding where the organisation is going, and seeing how your own work contributes to it.</field>
        </record>

        <record id="metric_workload" model="bf.ex.pulse.metric">
            <field name="name">Workload and wellbeing</field>
            <field name="code">workload</field>
            <field name="sequence">70</field>
            <field name="description">Workload, pace, and the energy they leave behind. This is the dimension that touches on psychosocial risks.</field>
        </record>

        <record id="metric_autonomy" model="bf.ex.pulse.metric">
            <field name="name">Autonomy</field>
            <field name="code">autonomy</field>
            <field name="sequence">80</field>
            <field name="description">The latitude to decide how the work gets done, and the means that go with it.</field>
        </record>

        <record id="metric_satisfaction" model="bf.ex.pulse.metric">
            <field name="name">Satisfaction</field>
            <field name="code">satisfaction</field>
            <field name="sequence">90</field>
            <field name="description">Overall contentment, working conditions included.</field>
        </record>

        <record id="metric_ambassador" model="bf.ex.pulse.metric">
            <field name="name">Pride and recommendation</field>
            <field name="code">ambassador</field>
            <field name="sequence">100</field>
            <field name="description">Would you recommend this employer? This is the dimension that carries the eNPS.</field>
        </record>

    </data>
</odoo>
