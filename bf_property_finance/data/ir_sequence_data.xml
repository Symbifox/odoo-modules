<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_property_payment" model="ir.sequence">
            <field name="name">Copropriété : encaissements</field>
            <field name="code">bf.property.payment</field>
            <field name="prefix">ENC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_property_charge_statement" model="ir.sequence">
            <field name="name">Copropriété : états des charges dues</field>
            <field name="code">bf.property.charge.statement</field>
            <field name="prefix">ETC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
