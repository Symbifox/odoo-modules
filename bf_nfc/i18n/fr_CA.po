#: model:ir.model.fields,help:bf_nfc.field_bf_nfc_tag_lot__prefixe
msgid ""
"Added in front of each record's name: “Evening patrol · ” gives “Evening "
"patrol · Back door”."
msgstr ""
"Ajouté devant le nom de chaque fiche : « Ronde du soir · » donne « Ronde du "
"soir · Porte arrière »."

#. module: bf_nfc
#. odoo-python
