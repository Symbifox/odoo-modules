<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_dav_addressbook_list" model="ir.ui.view">
        <field name="name">bf.dav.addressbook.list</field>
        <field name="model">bf.dav.addressbook</field>
        <field name="arch" type="xml">
            <list string="Address books for apps" create="false">
                <field name="name"/>
                <field name="kind"/>
                <field name="owner_id"/>
                <field name="exclude_tag_ids" widget="many2many_tags"/>
                <field name="card_count" string="Cards"/>
            </list>
        </field>
    </record>
    <record id="view_bf_dav_addressbook_form" model="ir.ui.view">
        <field name="name">bf.dav.addressbook.form</field>
        <field name="model">bf.dav.addressbook</field>
        <field name="arch" type="xml">
            <form string="Address book for apps" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kind" readonly="1"/>
                            <field name="owner_id" readonly="1" invisible="kind == 'company'"/>
                            <field name="slug" readonly="1"/>
                        </group>
                        <group>
                            <field name="card_count" string="Cards"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="kind != 'company'">
                        <field name="exclude_tag_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bf_dav_addressbook" model="ir.actions.act_window">
        <field name="name">Address books for apps</field>
        <field name="res_model">bf.dav.addressbook</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No address book yet</p>
            <p>The company book serves the Odoo contacts to Thunderbird, Apple Contacts and DAVx5;
               each user also gets a private book.</p>
        </field>
    </record>
    <menuitem id="menu_bf_dav_addressbook" name="Address books for apps" parent="calendar.calendar_menu_config"
              action="action_bf_dav_addressbook" sequence="41" groups="base.group_system"/>
</odoo>
