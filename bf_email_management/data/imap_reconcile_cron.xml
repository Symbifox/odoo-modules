<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Watermark-independent safety net: re-scans the last N days of the
             live IMAP folders (INBOX + Sent) and ingests any message whose
             Message-ID has no bf.email row. Closes the permanent-gap class
             left by the forward-only live watermarks. Read-only IMAP. -->
        <record id="ir_cron_imap_reconcile" model="ir.cron">
            <field name="name">Courriels : réconciliation IMAP (rattrapage des trous)</field>
            <field name="model_id" ref="model_bf_email"/>
            <field name="state">code</field>
            <field name="code">model._cron_imap_reconcile()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

    </data>
</odoo>
