<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_editorial_entry_form_genfox" model="ir.ui.view">
        <field name="name">bf.editorial.entry.form.genfox</field>
        <field name="model">bf.editorial.entry</field>
        <field name="inherit_id" ref="bf_editorial.view_editorial_entry_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='action_run_qa']" position="after">
                <button name="action_genfox_full" type="object"
                        string="Gen review" class="btn-secondary"
                        invisible="not genfox_available or genfox_pending"
                        groups="bf_editorial.group_editorial_manager"
                        help="A single run: what regular expressions cannot reach (repetitions, link text, drift from the declared angle, house style) and an expanded text if the entry needs one. Nothing is written to the article on its own."/>
                <button name="action_view_suggestions" type="object"
                        string="Gen is working…" class="btn-secondary" disabled="1"
                        invisible="not genfox_pending"/>
                <!-- Deux variantes du même bouton, mutuellement exclusives : le
                     bleu signale une proposition qui attend une décision, le
                     gris n'annonce qu'une lecture. -->
                <button name="action_view_suggestions" type="object"
                        string="Gen suggestions" class="btn-primary"
                        invisible="not genfox_pending_decision or genfox_pending"/>
                <button name="action_view_suggestions" type="object"
                        string="Gen suggestions" class="btn-secondary"
                        invisible="genfox_pending_decision or not suggestion_ids or genfox_pending"/>
            </xpath>

            <xpath expr="//field[@name='preflight_ok'][@invisible='1']" position="after">
                <field name="genfox_available" invisible="1"/>
                <field name="genfox_pending" invisible="1"/>
                <field name="genfox_stalled" invisible="1"/>
                <field name="genfox_pending_decision" invisible="1"/>

                <div class="alert alert-info mb-2" role="alert"
                     invisible="not genfox_pending">
                    <i class="fa fa-circle-o-notch fa-spin me-2" title="In progress"/>
                    <span>
                        <b>Gen is working on this article.</b> Started on <field name="genfox_started" readonly="1" class="d-inline"/> (allow a few minutes, then reload the page). The result will open in the "Gen" tab.
                    </span>
                </div>
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not genfox_stalled">
                    <b>Stalled run.</b> The run started on <field name="genfox_started" readonly="1" class="d-inline"/>
                    never reported a status: the bridge was probably restarted, or the time limit passed. Nothing was written to the article. The buttons are available again, run it again.
                </div>
            </xpath>

            <xpath expr="//page[@name='qa']" position="after">
                <page string="Gen" name="genfox" invisible="not suggestion_ids">
                    <div class="alert alert-info" role="alert">
                        Gen suggests, you apply. A suggestion only enters the article through the "Apply to the post" button, and it refuses if the article has changed since it was computed.
                    </div>
                    <field name="suggestion_ids" nolabel="1" readonly="1">
                        <list decoration-muted="applied" decoration-danger="state == 'error'"
                              decoration-info="state == 'queued'"
                              decoration-primary="pending_decision">
                            <field name="create_date"/>
                            <field name="kind"/>
                            <field name="state"/>
                            <field name="has_proposal"/>
                            <field name="pending_decision" optional="hide"/>
                            <field name="applied"/>
                            <field name="triggered_by" optional="hide"/>
                            <button name="action_open" type="object"
                                    icon="fa-arrow-right" title="Open the suggestion"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
