msgid "<strong>What we need from you</strong>"
msgstr "<strong>Ce que nous attendons de vous</strong>"

#. module: bf_stepbystep_clients
#: model:mail.template,body_html:bf_stepbystep_clients.mail_template_progression_otp
msgid ""
"<t t-set=\"_champs\" t-value=\"object.company_id._fields\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"('report_brand_dark' in _champs and object.company_id.report_brand_dark) or '#212529'\"/>\n"
"<div style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:15px; line-height:24px; color:#374151;\">\n"
"    <p style=\"margin:0 0 12px 0; font-size:15px; line-height:24px; color:#374151;\">Hello,</p>\n"
"    <p style=\"margin:0 0 4px 0; font-size:15px; line-height:24px; color:#374151;\">Your access code for the progress page of your mandate:</p>\n"
"    <p t-attf-style=\"margin:12px 0 16px 0; font-size:30px; line-height:38px; font-weight:600; letter-spacing:0.22em; color:{{ brand_dark }};\"><t t-out=\"ctx.get('bf_progression_code') or ''\"/></p>\n"
"    <p style=\"margin:0 0 12px 0; font-size:15px; line-height:24px; color:#374151;\">It expires in <t t-out=\"ctx.get('bf_progression_minutes') or 30\"/> minutes, and it is asked once per device.</p>\n"
"    <p style=\"margin:0; font-size:13px; line-height:20px; color:#6B7280;\">If you did not ask for this code, you can ignore this message.</p>\n"
"</div>\n"
"        "
msgstr ""
"<t t-set=\"_champs\" t-value=\"object.company_id._fields\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"('report_brand_dark' in _champs and object.company_id.report_brand_dark) or '#212529'\"/>\n"
"<div style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:15px; line-height:24px; color:#374151;\">\n"
"    <p style=\"margin:0 0 12px 0; font-size:15px; line-height:24px; color:#374151;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 4px 0; font-size:15px; line-height:24px; color:#374151;\">Votre code d'accès à la page de suivi de votre mandat :</p>\n"
"    <p t-attf-style=\"margin:12px 0 16px 0; font-size:30px; line-height:38px; font-weight:600; letter-spacing:0.22em; color:{{ brand_dark }};\"><t t-out=\"ctx.get('bf_progression_code') or ''\"/></p>\n"
"    <p style=\"margin:0 0 12px 0; font-size:15px; line-height:24px; color:#374151;\">Il expire dans <t t-out=\"ctx.get('bf_progression_minutes') or 30\"/> minutes, et il n'est demandé qu'une fois par appareil.</p>\n"
"    <p style=\"margin:0; font-size:13px; line-height:20px; color:#6B7280;\">Si vous n'avez pas demandé ce code, vous pouvez ignorer ce message.</p>\n"
"</div>\n"
"        "

