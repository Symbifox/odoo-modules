msgid "Portal user not synchronised: %s"
msgstr "Usager portail non synchronisé : %s"

#. module: bf_school_student_portal
#: model:ir.model,name:bf_school_student_portal.model_bf_school
msgid "School"
msgstr "École"

#. module: bf_school_student_portal
#: model:ir.actions.server,name:bf_school_student_portal.ir_cron_school_portal_sync_ir_actions_server
msgid "School: students' portal users follow their accounts"
msgstr "École : les usagers portail des élèves suivent leurs comptes"

#. module: bf_school_student_portal
#: model:ir.model,name:bf_school_student_portal.model_bf_school_account
msgid "Student directory account"
msgstr "Compte d'annuaire de l'élève"

#. module: bf_school_student_portal
#: model:ir.model.fields,field_description:bf_school_student_portal.field_bf_school__student_oauth_provider_id
msgid "Student sign-in"
msgstr "Connexion des élèves"

#. module: bf_school_student_portal
#: model:ir.model.fields,help:bf_school_student_portal.field_bf_school__student_oauth_provider_id
msgid ""
"The OpenID application of the school's directory, whose subject is the "
"user's id (Authentik: subject mode « Based on the User's ID »). Students "
"sign in to the portal through it with the account that opens the school's "
"computers."
msgstr "L'application OpenID de l'annuaire de l'école, dont le sujet est l'identifiant de l'usager (Authentik : mode de sujet « Based on the User's ID »). Les élèves s'y connectent au portail avec le compte qui ouvre les ordinateurs de l'école."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/account.py:0
msgid "The portal user %s is not this student's: left alone."
msgstr "L'usager portail %s n'est pas celui de cet élève : il n'est pas touché."

#. module: bf_school_student_portal
#. odoo-python
#: code:addons/bf_school_student_portal/models/school.py:0
msgid "The student sign-in must go through the school's own directory (%s)."
msgstr "La connexion des élèves doit passer par l'annuaire de l'école (%s)."

#. module: bf_school_student_portal
#: model:ir.model.fields,help:bf_school_student_portal.field_bf_school_account__portal_user_id
msgid ""
"The student's portal user, tied to this directory account: the student signs"
" in to the portal through the school's directory."
msgstr "L'usager portail de l'élève, lié à ce compte d'annuaire : l'élève se connecte au portail par l'annuaire de l'école."

#. module: bf_school_student_portal
#: model:ir.model,name:bf_school_student_portal.model_res_users
msgid "User"
msgstr "Utilisateur"

