        <!-- ============================================================ -->
        <!-- La Chasse (Productivity / Timesheets / Streaks)              -->
        <!-- ============================================================ -->
        <record id="badge_first_timesheet" model="bf.gamification.badge">
            <field name="name">Premi&#232;res Pattes</field>
