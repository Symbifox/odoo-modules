    <!-- Le second parent nommé par le titulaire lit et écrit les fiches
         de l'enfant, tant qu'il est suivi. Les fiches qu'il crée passent au
         titulaire (create_uid réécrit, bf.health.dependent.mixin). Règles de
         groupe : elles s'ajoutent à celles du titulaire sans les changer. -->
    <record id="health_medication_rule_coparent" model="ir.rule">
        <field name="name">health.medication : le second parent, pour l'enfant suivi</field>
        <field name="model_id" ref="model_health_medication"/>
        <field name="domain_force">[('dependent_id.coparent_id', '=', user.id), ('dependent_id.state', 'in', ('suivi', 'offert'))]</field>
        <field name="groups" eval="[(4, ref('group_health_user'))]"/>
        <field name="perm_read" eval="True"/>
