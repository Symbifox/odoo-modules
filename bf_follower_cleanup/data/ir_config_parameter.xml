<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="param_always_remove_partner_ids" model="ir.config_parameter">
            <field name="key">bf_follower_cleanup.always_remove_partner_ids</field>
            <!-- Empty by default. Optional: comma-separated res.partner IDs
                 (e.g. service accounts) to purge unconditionally. -->
