#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "%s (%s)"
msgstr "%s (%s)"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "(sans titre)"
msgstr "(untitled)"

#. module: bf_federation_gantt
#: model_terms:ir.ui.view,arch_db:bf_federation_gantt.view_bf_gantt_plan_form_federation
msgid ".\n                    Il se lit ici : le prochain changement de l'émetteur le remplacera, et il ne se\n                    publie pas au portail."
msgstr ". It is read-only here: the sender's next change will replace it, and it is not published to the portal."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "<p>Chez %s, l'échéancier a changé : du %s au %s, statut %s.</p>"
msgstr "<p>At %s, the schedule changed: from %s to %s, status %s.</p>"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "<p>Échéancier reçu de %s : <b>%s</b>, %s ligne(s). Il se lit ici ; chaque changement de l'émetteur le remplacera.</p>"
msgstr "<p>Schedule received from %s: <b>%s</b>, %s line(s). It is read-only here; each change by the sender will replace it.</p>"

#. module: bf_federation_gantt
#: model:ir.model,name:bf_federation_gantt.model_federation_outbox
msgid "Boîte de sortie de la fédération"
msgstr "Federation outbox"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "Cet échéancier est reçu de %s : il a été partagé avec votre entreprise, pas avec vos clients. Il ne se publie pas au portail."
msgstr "This schedule is received from %s: it was shared with your company, not with your customers. It is not published to the portal."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "Cet échéancier est reçu de %s : il se lit ici. Le prochain changement de l'émetteur le remplacerait, et le travail fait dessus serait perdu."
msgstr "This schedule is received from %s: it is read-only here. The sender's next change would replace it, and any work done on it would be lost."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "Cet échéancier n'est pas partagé avec un pair."
msgstr "This schedule is not shared with a peer."

#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_remote_url
msgid "Chez le pair"
msgstr "On the peer"

#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_possible
msgid "Fédération possible"
msgstr "Federation possible"

#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_peer_id
