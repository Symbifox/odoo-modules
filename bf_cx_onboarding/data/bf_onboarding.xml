<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="bf_onb_step_program" model="onboarding.onboarding.step">
        <field name="title">Create a program</field>
        <field name="description">[action:bf_cx.action_cx_program] Create a measurement program (relationship NPS, transactional CSAT or continuous pulse) linked to its Odoo survey.</field>
        <field name="button_text">Open Programs</field>
        <field name="done_text">Program created</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">1</field>
    </record>
    <record id="bf_onb_step_cadence" model="onboarding.onboarding.step">
        <field name="title">Set up the cadence</field>
        <field name="description">[action:bf_cx.action_cx_settings] Set the global over-solicitation guard and, if needed, each program's own minimum cadence (common practice: 90 days for a relationship NPS).</field>
        <field name="button_text">Open Settings</field>
        <field name="done_text">Cadence configured</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">2</field>
    </record>
    <record id="bf_onb_step_wave" model="onboarding.onboarding.step">
        <field name="title">Launch a first wave</field>
        <field name="description">[action:bf_cx.action_cx_wave] Build a wave of recipients, then send the invitations: the answers feed the feedback register automatically.</field>
        <field name="button_text">Open Waves</field>
        <field name="done_text">First wave sent</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">3</field>
    </record>
    <record id="bf_onb_step_complaint_team" model="onboarding.onboarding.step">
        <field name="title">Set up the Complaints team</field>
        <field name="description">[action:base.action_res_users] Add your colleagues to the Customer experience groups (user or manager) and set the complaint acknowledgement delay in the settings.</field>
        <field name="button_text">Open Users</field>
        <field name="done_text">Complaints team set up</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">4</field>
    </record>
    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Customer experience</field>
        <field name="route_name">bf_cx_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_cx_onboarding</field>
        <field name="step_ids" eval="[
            Command.link(ref('bf_cx_onboarding.bf_onb_step_program')),
            Command.link(ref('bf_cx_onboarding.bf_onb_step_cadence')),
            Command.link(ref('bf_cx_onboarding.bf_onb_step_wave')),
            Command.link(ref('bf_cx_onboarding.bf_onb_step_complaint_team')),
        ]"/>
    </record>
</odoo>
