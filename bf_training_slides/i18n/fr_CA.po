#: model:ir.model.fields,field_description:bf_training_slides.field_bf_training_activity__slide_content_count_at_version
msgid "Contents at the latest version"
msgstr "Contenus à la dernière version"

#. module: bf_training_slides
#: model:ir.model.fields,field_description:bf_training_slides.field_bf_training_activity__default_plan_id
