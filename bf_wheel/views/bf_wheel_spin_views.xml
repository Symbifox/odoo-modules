<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_wheel_spin_list" model="ir.ui.view">
        <field name="name">bf.wheel.spin.list</field>
        <field name="model">bf.wheel.spin</field>
        <field name="arch" type="xml">
            <list string="Tirages" create="false" edit="false">
                <field name="date"/>
                <field name="wheel_id"/>
                <field name="winner_label"/>
                <field name="claim_name" optional="show"/>
                <field name="candidate_count"/>
                <field name="weight_total" optional="hide"/>
                <field name="spun_by_id"/>
                <field name="purged" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bf_wheel_spin_form" model="ir.ui.view">
        <field name="name">bf.wheel.spin.form</field>
        <field name="model">bf.wheel.spin</field>
        <field name="arch" type="xml">
            <form string="Tirage" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="winner_label" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Le tirage">
                            <field name="wheel_id"/>
                            <field name="date"/>
                            <field name="spun_by_id"/>
                            <field name="source"/>
                            <field name="candidate_count"/>
                            <field name="weight_total"/>
                            <field name="winner_index"/>
                        </group>
                        <group string="La personne tirée">
                            <field name="claim_name"/>
                            <field name="claim_contact"/>
                            <field name="claim_date"/>
                            <field name="purged"/>
                        </group>
                    </group>
                    <group string="Candidats du tirage" invisible="not candidates">
                        <field name="candidates" nolabel="1" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not purged">
                        Les coordonnées et la liste des candidats de ce tirage ont été
                        effacées au terme du délai de conservation de la roue.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bf_wheel_spin_search" model="ir.ui.view">
        <field name="name">bf.wheel.spin.search</field>
        <field name="model">bf.wheel.spin</field>
        <field name="arch" type="xml">
            <search string="Tirages">
                <field name="winner_label"/>
                <field name="wheel_id"/>
                <field name="claim_name"/>
                <filter name="claimed" string="Personne notée" domain="[('claim_name', '!=', False)]"/>
                <filter name="purged" string="Élagués" domain="[('purged', '=', True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_wheel" string="Roue" context="{'group_by': 'wheel_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_wheel_spin" model="ir.actions.act_window">
        <field name="name">Registre des tirages</field>
        <field name="res_model">bf.wheel.spin</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
