<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_school_meal_monthly" model="ir.cron">
        <field name="name">School: monthly meal invoices</field>
        <field name="model_id" ref="model_bf_school_meal_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_monthly_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall" eval="(DateTime.today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d 06:00:00')"/>
    </record>
    <record id="ir_cron_school_meal_invoice_pdf" model="ir.cron">
        <field name="name">School: official PDF of meal top-up invoices</field>
        <field name="model_id" ref="model_bf_school_meal_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_invoice_pdf()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
