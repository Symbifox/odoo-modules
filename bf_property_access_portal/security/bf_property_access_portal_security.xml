<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- La règle décide, le contrôleur cherche (même principe que
             bf_property_portal). Les droits retirés ou annulés ne se montrent
             plus : ce sont des traces, pas des accès. -->
        <record id="rule_access_grant_portal" model="ir.rule">
            <field name="name">Droits d'accès : les siens seulement</field>
            <field name="model_id" ref="bf_property_access.model_bf_property_access_grant"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('state', 'in', ('awaiting_consent', 'to_issue', 'issued', 'to_remove'))]</field>
        </record>
    </data>
</odoo>
