<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_otp_app" model="ir.actions.client">
        <field name="name">OTP tokens</field>
        <field name="tag">bf_otp.app</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         L'inventaire.

         ⚠️ Aucune de ces vues ne montre `secret_cipher` ni `secret_iv`. Ce
         n'est pas de la pudeur : le chiffré affiché dans une liste finit dans
         une capture d'écran, un export tableur ou un rapport, et il donne à qui
         le récupère un point de départ pour une attaque hors ligne. Il n'a
         aucune raison d'être lisible ici, puisque personne ne peut l'ouvrir
         depuis le back-office de toute façon.

         Ce que ces vues apportent et que l'application ne peut pas : rattacher
         CENT tokens à un client en une fois, et répondre à « qu'est-ce qu'on
         détient pour eux » depuis leur fiche.
         ══════════════════════════════════════════════════════════════════ -->

    <record id="view_otp_token_list" model="ir.ui.view">
        <field name="name">bf.otp.token.list</field>
        <field name="model">bf.otp.token</field>
        <field name="arch" type="xml">
            <!-- `create="0"` : un token neuf exige une graine chiffrée dans le
                 navigateur, donc il ne peut naître que dans l'application.
                 `delete="0"` : la corbeille est le chemin, et elle est là-bas. -->
            <list string="OTP tokens" create="0" delete="0"
                  multi_edit="1" editable="bottom" sample="1"
                  decoration-muted="archived">
                <field name="favorite" widget="boolean_favorite" string=" "/>
                <field name="issuer" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="otp_type" readonly="1" optional="hide"/>
                <field name="group_name"/>
                <field name="partner_id" options="{'no_create': True}"/>
                <field name="project_id" options="{'no_create': True}"/>
                <field name="sensitive" optional="show"/>
                <!-- ⚠️ Modifiable en lot exprès : ranger cent tokens d'un coup
                     est précisément ce que l'application ne sait pas faire et
                     que cette liste existe pour permettre. -->
                <field name="archived" optional="show"/>
                <field name="last_used" readonly="1" optional="show"/>
                <field name="deleted_at" readonly="1" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_otp_token_form" model="ir.ui.view">
        <field name="name">bf.otp.token.form</field>
        <field name="model">bf.otp.token</field>
        <field name="arch" type="xml">
            <form string="OTP token" create="0" duplicate="0">
                <sheet>
                    <div class="alert alert-info" role="status">
                        This token's seed cannot be read here, nor anywhere on the server. The code is computed in <em>My vault</em>, once the passphrase is entered. This screen is for filing: who this token belongs to, and for which engagement.
                    </div>
                    <widget name="web_ribbon" title="In the trash" bg_color="text-bg-danger"
                            invisible="active"/>
                    <!-- ⚠️ Deux rubans, jamais ensemble : la corbeille l'emporte
                         à l'affichage parce que c'est l'état qui a des
                         conséquences. -->
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary"
                            invisible="not archived or not active"/>
                    <group>
                        <group string="The account">
                            <field name="issuer" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="otp_type" readonly="1"/>
                            <field name="algorithm" readonly="1"/>
                            <field name="digits" readonly="1"/>
                            <field name="period" readonly="1"
                                   invisible="otp_type != 'totp'"/>
                            <field name="counter" readonly="1"
                                   invisible="otp_type != 'hotp'"/>
                        </group>
                        <group string="Filing">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="group_name"/>
                            <field name="favorite"/>
                            <field name="sensitive"/>
                            <field name="last_used" readonly="1"/>
                            <field name="archived"/>
                            <field name="archived_at" readonly="1" invisible="not archived"/>
                            <field name="deleted_at" readonly="1" invisible="active"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otp_token_search" model="ir.ui.view">
        <field name="name">bf.otp.token.search</field>
        <field name="model">bf.otp.token</field>
        <field name="arch" type="xml">
            <search string="OTP tokens">
                <field name="name" string="Account or issuer"
                       filter_domain="['|', ('name', 'ilike', self), ('issuer', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="group_name"/>
                <filter name="favoris" string="Favorites" domain="[('favorite', '=', True)]"/>
                <filter name="sensibles" string="Sensitive tokens" domain="[('sensitive', '=', True)]"/>
                <separator/>
                <!-- La vraie liste de départ avant un départ, une fin de mandat
                     ou un ménage : ce qu'on détient sans savoir pour qui. -->
                <filter name="sans_rattachement" string="No client or project"
                        domain="[('partner_id', '=', False), ('project_id', '=', False)]"/>
                <filter name="jamais_utilise" string="Never used"
                        domain="[('last_used', '=', False)]"/>
                <separator/>
                <!-- ⚠️ L'archive n'est PAS la corbeille, et les deux filtres se
                     suivent exprès pour que la différence se lise : au-dessus,
                     ce qui est rangé et vivant ; en dessous, ce qui attend
                     d'être détruit. -->
                <filter name="hors_archive" string="Not archived"
                        domain="[('archived', '=', False)]"/>
                <filter name="archives" string="Archived tokens"
                        domain="[('archived', '=', True)]"/>
                <separator/>
                <!-- ⚠️ Un domaine qui nomme `active` désactive de lui-même le
                     filtre implicite des archivés : pas besoin de contexte. -->
                <filter name="corbeille" string="In the trash"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="par_client" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="par_projet" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="par_groupe" string="Grouping" context="{'group_by': 'group_name'}"/>
                    <filter name="par_emetteur" string="Issuer" context="{'group_by': 'issuer'}"/>
                    <filter name="par_type" string="Type" context="{'group_by': 'otp_type'}"/>
                    <filter name="par_archive" string="Token archive" context="{'group_by': 'archived'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otp_tokens" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">bf.otp.token</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_otp_token_search"/>
        <!-- ⚠️ Le filtre par défaut se pose ICI, dans le contexte de l'action,
             et pas par un `<filter … default="1"/>` dans la vue de recherche :
             une vue de recherche partagée se départage au nom, et le défaut
             posé dans l'arbre s'est déjà fait ignorer en production sur un
             autre module. -->
        <field name="context">{'search_default_hors_archive': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No token in your vault</p>
            <p>
                Tokens are added from <em>My vault</em>, where the seed is encrypted in the browser before it leaves. This inventory is then used to file them: link a token to a client or an engagement, or find what you hold for someone.
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Les boutons intelligents.

         ⚠️ Restreints au groupe : sans ça, une fiche client afficherait à tout
         le monde un compteur qui vaut toujours zéro, et qui poserait la
         question « pourquoi zéro ? » à des gens qui n'ont pas de coffre.
         ══════════════════════════════════════════════════════════════════ -->

    <record id="view_partner_form_otp" model="ir.ui.view">
        <field name="name">res.partner.form.bf.otp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object" name="action_bf_otp_tokens"
                        class="oe_stat_button" icon="fa-key"
                        groups="bf_otp.group_otp_user"
                        invisible="bf_otp_token_count == 0">
                    <field name="bf_otp_token_count" widget="statinfo" string="OTP tokens"/>
                </button>
            </div>
        </field>
    </record>

    <record id="view_project_form_otp" model="ir.ui.view">
        <field name="name">project.project.form.bf.otp</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object" name="action_bf_otp_tokens"
                        class="oe_stat_button" icon="fa-key"
                        groups="bf_otp.group_otp_user"
                        invisible="bf_otp_token_count == 0">
                    <field name="bf_otp_token_count" widget="statinfo" string="OTP tokens"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Application à part entière : c'est le seul module de la suite qui
         détient des graines, et le sortir sous son propre toit rend visible ce
         qu'il est. Il porte aussi l'icône de token, donc il s'installe en PWA
         sous son propre nom. -->
    <menuitem id="menu_otp_root"
              name="OTP tokens"
              web_icon="bf_otp,static/description/icon.png"
              groups="group_otp_user"
              sequence="52"/>

    <menuitem id="menu_otp_app"
              name="My vault"
              parent="menu_otp_root"
              action="action_otp_app"
              groups="group_otp_user"
              sequence="10"/>

    <menuitem id="menu_otp_inventaire"
              name="Inventory"
              parent="menu_otp_root"
              action="action_otp_tokens"
              groups="group_otp_user"
              sequence="20"/>
</odoo>
