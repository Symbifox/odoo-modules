<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- Report wizard (the "Rapporter comme malveillant" popup)        -->
    <!-- ============================================================== -->
    <record id="bf_report_phish_wizard_form" model="ir.ui.view">
        <field name="name">bf.report.phish.wizard.form</field>
        <field name="model">bf.report.phish.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapporter un courriel suspect">
                <div class="alert alert-info" role="status">
                    Vous avez reçu un courriel douteux ? Signalez-le ici.
                    S'il s'agissait d'une simulation de sécurité, votre bon réflexe
                    sera reconnu. Sinon, l'équipe TI sera alertée pour analyse.
                    <strong>En cas de doute : ne cliquez sur aucun lien.</strong>
                </div>
                <group>
                    <field name="category"/>
                    <field name="email_from" placeholder="ex. support@exemple-banque.com"/>
                    <field name="subject" placeholder="Sujet du courriel"/>
                    <field name="suspicious_link" placeholder="Collez le lien SANS cliquer (facultatif)"/>
                </group>
                <field name="details" placeholder="Qu'est-ce qui vous a semblé suspect ? (urgence, pièce jointe inattendue, demande inhabituelle…)"/>
                <separator string="Pièces jointes (capture d'écran, copie du courriel)"/>
                <field name="attachment_ids" widget="many2many_binary"/>
                <footer>
                    <button name="action_submit" type="object" string="Signaler"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_phish_wizard" model="ir.actions.act_window">
        <field name="name">Rapporter un courriel suspect</field>
        <field name="res_model">bf.report.phish.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================== -->
    <!-- Triage records (manager / operator)                            -->
    <!-- ============================================================== -->
    <record id="bf_reported_phish_view_list" model="ir.ui.view">
        <field name="name">bf.reported.phish.list</field>
        <field name="model">bf.reported.phish</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-danger="state == 'threat_confirmed'"
                  decoration-info="state == 'triage'"
                  decoration-muted="state in ('false_alarm','simulation')">
                <field name="report_date"/>
                <field name="reporter_id"/>
                <field name="category"/>
                <field name="subject"/>
                <field name="email_from" optional="show"/>
                <field name="is_simulation"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'threat_confirmed'"
                       decoration-info="state == 'triage'"
                       decoration-success="state == 'simulation'"/>
            </list>
        </field>
    </record>

    <record id="bf_reported_phish_view_form" model="ir.ui.view">
        <field name="name">bf.reported.phish.form</field>
        <field name="model">bf.reported.phish</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_mark_threat" type="object"
                            string="Confirmer la menace" class="btn-danger"
                            invisible="state in ('threat_confirmed','simulation')"/>
                    <button name="action_mark_false_alarm" type="object"
                            string="Fausse alerte"
                            invisible="state in ('false_alarm','simulation')"/>
                    <button name="action_launch_clawback" type="object"
                            string="Retirer des boîtes (clawback)"
                            class="btn-warning"
                            groups="bf_security_awareness.group_bf_secaware_manager"
                            invisible="is_simulation or state in ('new','false_alarm','simulation')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,triage,threat_confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_ticket" type="object"
                                class="oe_stat_button" icon="fa-life-ring"
                                invisible="not has_ticket">
                            <span class="o_stat_text">Ticket Helpdesk</span>
                        </button>
                        <button name="action_view_clawbacks" type="object"
                                class="oe_stat_button" icon="fa-trash"
                                invisible="clawback_count == 0">
                            <field name="clawback_count" widget="statinfo"
                                   string="Retraits"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Simulation" bg_color="text-bg-success"
                            invisible="not is_simulation"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reporter_id" readonly="1"/>
                            <field name="report_date" readonly="1"/>
                            <field name="category"/>
                            <field name="is_simulation" readonly="1"/>
                            <field name="matched_result_id" readonly="1"
                                   invisible="not is_simulation"/>
                            <field name="has_ticket" invisible="1"/>
                        </group>
                        <group>
                            <field name="email_from"/>
                            <field name="subject"/>
                            <field name="suspicious_link" widget="url"/>
                            <field name="message_id"/>
                            <field name="clawback_count" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Précisions">
                        <field name="details" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_reported_phish_view_search" model="ir.ui.view">
        <field name="name">bf.reported.phish.search</field>
        <field name="model">bf.reported.phish</field>
        <field name="arch" type="xml">
            <search>
                <field name="reporter_id"/>
                <field name="subject"/>
                <field name="email_from"/>
                <filter name="to_triage" string="À trier"
                        domain="[('state','in',('new','triage'))]"/>
                <filter name="threats" string="Menaces confirmées"
                        domain="[('state','=','threat_confirmed')]"/>
                <filter name="real" string="Courriels réels"
                        domain="[('is_simulation','=',False)]"/>
                <filter name="simulations" string="Simulations"
                        domain="[('is_simulation','=',True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_category" string="Catégorie"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_reporter" string="Signaleur"
                            context="{'group_by': 'reporter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_reported_phish_action" model="ir.actions.act_window">
        <field name="name">Signalements</field>
        <field name="res_model">bf.reported.phish</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bf_reported_phish_view_search"/>
        <field name="context">{'search_default_to_triage': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun courriel signalé</p>
            <p>Les courriels signalés par les employés comme suspects arrivent ici.
               Les simulations reconnues sont classées automatiquement; les
               courriels réels sont à trier.</p>
        </field>
    </record>

    <!-- Manager menu: triage queue under the Sensibilisation app -->
    <menuitem id="menu_secaware_reported"
              name="Signalements"
              parent="menu_secaware_root"
              action="bf_reported_phish_action"
              groups="group_bf_secaware_user"
              sequence="25"/>

    <!-- Employee menu: the report button, under the single Sensibilisation app -->
    <menuitem id="menu_my_report_phish"
              name="Rapporter un courriel suspect"
              parent="menu_secaware_root"
              action="action_report_phish_wizard"
              groups="base.group_user"
              sequence="3"/>

</odoo>
