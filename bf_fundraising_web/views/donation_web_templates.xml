<odoo>
    <template id="donation_form" name="Formulaire de don">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-lg-7">
                        <h1 class="mb-4">Make a donation</h1>
                        <p class="text-muted">
                            Your donation supports our mission. You will receive an official tax receipt.
                        </p>
                        <div class="alert alert-warning mt-3" role="alert" t-if="error.get('rate')">
                            Too many submissions in a short time. Please try again in a few minutes.
                        </div>
                        <form action="/don/submit" method="post" class="mt-4">
                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="request.csrf_token()"
                            />
                            <div class="mb-3">
                                <label class="form-label">Full name *</label>
                                <input
                                    type="text"
                                    name="name"
                                    t-attf-class="form-control #{'is-invalid' if error.get('name') else ''}"
                                    t-att-value="values.get('name')"
                                />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email *</label>
                                <input
                                    type="email"
                                    name="email"
                                    t-attf-class="form-control #{'is-invalid' if error.get('email') else ''}"
                                    t-att-value="values.get('email')"
                                />
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Address</label>
                                    <input
                                        type="text"
                                        name="street"
                                        class="form-control"
                                        t-att-value="values.get('street')"
                                    />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">City</label>
                                    <input
                                        type="text"
                                        name="city"
                                        class="form-control"
                                        t-att-value="values.get('city')"
                                    />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Postal code</label>
                                    <input
                                        type="text"
                                        name="zip"
                                        class="form-control"
                                        t-att-value="values.get('zip')"
                                    />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Donation amount (CAD) *</label>
                                <input
                                    type="number"
                                    step="0.01"
                                    min="1"
                                    name="amount"
                                    t-attf-class="form-control #{'is-invalid' if error.get('amount') else ''}"
                                    t-att-value="values.get('amount')"
                                />
                            </div>
                            <div class="row" t-if="funds or campaigns">
                                <div class="col-md-6 mb-3" t-if="funds">
                                    <label class="form-label">Fund</label>
                                    <select name="fund_id" class="form-select">
                                        <option value="">(No fund)</option>
                                        <t t-foreach="funds" t-as="fund">
                                            <option t-att-value="fund.id">
                                                <t t-out="fund.display_name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3" t-if="campaigns">
                                    <label class="form-label">Campaign</label>
                                    <select name="campaign_id" class="form-select">
                                        <option value="">(No campaign)</option>
                                        <t t-foreach="campaigns" t-as="campaign">
                                            <option t-att-value="campaign.id">
                                                <t t-out="campaign.display_name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg mt-2">
                                Donate
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="donation_thanks" name="Merci de votre don">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-lg-7 text-center">
                        <h1 class="mb-3">Thank you for your generosity!</h1>
                        <p class="lead">
                            We have received your donation of
                            <strong><span t-field="donation.amount_total" /></strong>.
                        </p>
                        <p class="text-muted">
                            An official tax receipt will be sent to
                            <strong><t t-out="email" /></strong> once the donation is confirmed.
                        </p>
                        <a href="/" class="btn btn-secondary mt-3">Back to the home page</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- No website menu is auto-created: the public form lives at /don and each
         organisation adds its own « Faire un don » link/button where it wants
         (a consultancy site, for instance, should not carry a donate link). -->
</odoo>
