<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_school_meetings" name="School: meetings tile"
              inherit_id="portal.portal_my_home" priority="33">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/bf_school_core/static/description/icon.png'"/>
                <t t-set="title">Parent-teacher meetings</t>
                <t t-set="text">Book a slot with each of your child's teachers</t>
                <t t-set="url" t-value="'/my/school/meetings'"/>
                <t t-set="placeholder_count" t-value="'school_meeting_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_school_meetings_link" name="School: link to meetings"
              inherit_id="bf_school_portal.portal_my_school">
        <xpath expr="//div[hasclass('o_school_links')]" position="inside">
            <a href="/my/school/meetings" class="btn btn-secondary">
                <i class="fa fa-calendar me-1"/>Parent-teacher meetings</a>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_school_meetings" name="School: meetings breadcrumbs"
              inherit_id="portal.portal_breadcrumbs" priority="33">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'school_meetings'" class="breadcrumb-item active">Parent-teacher meetings</li>
        </xpath>
    </template>

    <template id="portal_school_meetings" name="School: parent-teacher meetings">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Parent-teacher meetings</t>
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Parent-teacher meetings</t>
            </t>
            <div t-if="error" class="alert alert-warning mt-3" t-out="error"/>
            <div t-if="not rows" class="alert alert-info mt-3">No meeting to book for now.</div>
            <div t-if="mine" class="card mt-3">
                <div class="card-body">
                    <h5>My meetings</h5>
                    <div t-foreach="mine.sorted('start')" t-as="slot" class="d-flex justify-content-between align-items-center border-bottom py-2">
                        <div>
                            <strong><span t-field="slot.start" t-options="{'widget': 'datetime', 'format': 'd MMMM, HH:mm', 'tz_name': (slot.company_id.partner_id.tz or 'America/Toronto')}"/></strong>
                            · <t t-out="slot.teacher_id.name"/> · <t t-out="slot.student_id.name"/>
                            <small t-if="slot.session_id.location" class="text-muted"> · <t t-out="slot.session_id.location"/></small>
                        </div>
                        <form method="post" action="/my/school/meetings/cancel">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
            <div t-foreach="rows" t-as="row" class="card mt-3">
                <div class="card-body">
                    <small class="text-muted"><t t-out="row['session'].name"/> · <t t-out="row['student'].name"/></small>
                    <h5 class="mt-1" t-out="row['teacher'].name"/>
                    <p t-if="row['booked']" class="mb-0 text-success">
                        Booked: <span t-field="row['booked'].start" t-options="{'widget': 'datetime', 'format': 'd MMMM, HH:mm', 'tz_name': (row['session'].company_id.partner_id.tz or 'America/Toronto')}"/>
                    </p>
                    <t t-elif="row['free']">
                        <form method="post" action="/my/school/meetings/book" class="d-flex flex-wrap gap-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="student_id" t-att-value="row['student'].id"/>
                            <button t-foreach="row['free']" t-as="slot" type="submit" name="slot_id"
                                    t-att-value="slot.id" class="btn btn-sm btn-outline-primary">
                                <span t-field="slot.start" t-options="{'widget': 'datetime', 'format': 'HH:mm', 'tz_name': (slot.company_id.partner_id.tz or 'America/Toronto')}"/>
                            </button>
                        </form>
                    </t>
                    <p t-else="" class="mb-0 text-muted">No slot left: contact the school office.</p>
                </div>
            </div>
        </t>
    </template>
</odoo>
