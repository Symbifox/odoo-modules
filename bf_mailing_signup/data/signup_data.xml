<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- La purge : traces des plafonds à 48 heures, relevés de mail_tracking
             et contacts jamais confirmés à sept jours (models/signup_trace.py). -->
        <record id="cron_purger" model="ir.cron">
            <field name="name">Public signup: erase caps traces, tracking records and unconfirmed contacts</field>
            <field name="model_id" ref="model_bf_mailing_signup_tracking"/>
            <field name="state">code</field>
            <field name="code">model._cron_purger()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!-- La dernière fenêtre pour laquelle l'avis « plafond global atteint »
             est parti. La ligne doit exister : l'avis la verrouille (FOR UPDATE)
             pour ne partir qu'une fois, même entre deux workers. -->
        <record id="param_plafond_avise" model="ir.config_parameter">
            <field name="key">bf_mailing_signup.plafond_avise</field>
            <field name="value">aucun</field>
        </record>
    </data>
</odoo>
