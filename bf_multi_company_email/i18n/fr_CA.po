#. module: bf_multi_company_email
#: model:mail.template,body_html:bf_multi_company_email.bf_signature_card
msgid ""
"<div>\n"
"                <t t-set=\"sig\" t-value=\"object.bf_signature_data()\"/>\n"
"<!-- Tableau enveloppe d'UNE colonne, deux rang&#233;es, aucune cellule &#233;tal&#233;e.\n"
"     Pourquoi : commentaire du record (18.0.5.2.0). -->\n"
