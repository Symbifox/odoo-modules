#. module: bf_meeting
#: model:mail.template,body_html:bf_meeting.meeting_agenda_mail_template
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Agenda</p>\n"
"<h2 t-attf-style=\"font-size:20px; font-weight:700; color:{{ brand_dark }}; margin:0 0 12px 0;\">\n"
"    <t t-out=\"object.name\"/>\n"
"</h2>\n"
"\n"
"<p style=\"font-size:13px; color:#6B7280; margin:0 0 20px 0;\">\n"
"    <t t-if=\"object.date\">\n"
"        <t t-set=\"is_placeholder\" t-value=\"object.date.hour == 0 and object.date.minute == 0 and object.date.second == 0\"/>\n"
"        <strong style=\"color:#374151;\">Date:</strong>\n"
"        <t t-if=\"is_placeholder\">\n"
"            <t t-out=\"object.date.strftime('%Y-%m-%d')\"/>\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <t t-out=\"object.report_date_display_html()\"/>\n"
"        </t>\n"
"    </t>\n"
"    <t t-if=\"object.duration_planned\">\n"
"        &nbsp;·&nbsp; <strong style=\"color:#374151;\">Planned duration:</strong> <t t-out=\"object.duration_planned\"/> min\n"
"    </t>\n"
"    <t t-if=\"object.location\">\n"
"        &nbsp;·&nbsp; <strong style=\"color:#374151;\">Location:</strong> <t t-out=\"object.location\"/>\n"
"    </t>\n"
"</p>\n"
"\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">\n"
"    Hello,\n"
"</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;\">\n"
"    Here is the agenda for the upcoming meeting.\n"
"</p>\n"
"\n"
"<!-- Renvoi : ce qui a chang&#233; depuis la copie que\n"
"     les destinataires tiennent d&#233;j&#224;. Rendu vide\n"
"     sur un premier envoi et quand la case est\n"
"     d&#233;coch&#233;e, donc rien &#224; masquer ici. -->\n"
"<t t-set=\"agenda_changes\" t-value=\"object.resend_changes_block_html()\"/>\n"
"<t t-if=\"agenda_changes\">\n"
"<div style=\"margin:0 0 20px 0; padding:14px 16px; background-color:#FFF8E1; border-left-width:4px; border-left-style:solid; border-left-color:#F0B429; border-radius:6px;\">\n"
"    <p style=\"font-size:14px; font-weight:600; color:#374151; margin:0 0 8px 0;\">\n"
"        What has changed since the last version\n"
"    </p>\n"
"    <div style=\"font-size:14px; line-height:22px; color:#374151;\">\n"
"        <t t-out=\"agenda_changes\"/>\n"
"    </div>\n"
"</div>\n"
"</t>\n"
"\n"
"<t t-if=\"object.participant_ids\">\n"
"<div style=\"margin:0 0 20px 0; padding:12px 14px; background-color:#F5F7FA; border-radius:6px; font-size:13px; color:#374151;\">\n"
"    <strong t-attf-style=\"color:{{ brand_dark }};\">Participants:</strong>\n"
"    <t t-foreach=\"object.participant_ids\" t-as=\"p\">\n"
"        <span t-attf-style=\"display:inline-block; margin:2px 4px; padding:2px 10px; background-color:#FFFFFF; border:1px solid #D8DEE4; border-radius:12px; font-size:12px; color:{{ brand_dark }};\"><t t-out=\"p.name\"/></span>\n"
"    </t>\n"
"</div>\n"
"</t>\n"
"\n"
"<t t-if=\"object.objectives\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Objectives</h3>\n"
"<div style=\"margin:0 0 20px 0; white-space:pre-wrap; color:#374151; font-size:15px; line-height:24px;\"><t t-out=\"object.objectives\"/></div>\n"
"</t>\n"
"\n"
"<t t-if=\"object.published_topic_ids\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Topics</h3>\n"
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; border-collapse:collapse; margin:8px 0; font-size:13px;\">\n"
"    <thead>\n"
"        <tr t-attf-style=\"background-color:{{ brand_dark }}; color:#FFFFFF;\">\n"
"            <th style=\"padding:8px 10px; text-align:left; font-weight:600; width:32px;\">#</th>\n"
"            <th style=\"padding:8px 10px; text-align:left; font-weight:600;\">Topic</th>\n"
"            <th style=\"padding:8px 10px; text-align:center; font-weight:600; width:70px;\">Duration</th>\n"
"            <th style=\"padding:8px 10px; text-align:left; font-weight:600; width:140px;\">Presenter</th>\n"
"        </tr>\n"
"    </thead>\n"
"    <tbody>\n"
"        <t t-foreach=\"object.published_topic_ids\" t-as=\"topic\">\n"
"            <tr style=\"border-bottom:1px solid #EAEEF2;\">\n"
"                <td style=\"padding:8px 10px; color:#8A9099;\"><t t-out=\"topic_index + 1\"/></td>\n"
"                <td style=\"padding:8px 10px; color:#374151;\"><strong t-attf-style=\"color:{{ brand_dark }};\"><t t-out=\"topic.name\"/></strong></td>\n"
"                <td style=\"padding:8px 10px; text-align:center; color:#6B7280;\">\n"
"                    <t t-if=\"topic.duration_planned\"><t t-out=\"topic.duration_planned\"/> min</t>\n"
"                </td>\n"
"                <td style=\"padding:8px 10px; color:#6B7280;\">\n"
"                    <t t-if=\"topic.presenter_id\"><t t-out=\"topic.presenter_id.name\"/></t>\n"
"                </td>\n"
"            </tr>\n"
"        </t>\n"
"    </tbody>\n"
"</table>\n"
"</t>\n"
"\n"
"<t t-if=\"object.agenda_task_ids\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Action items to discuss</h3>\n"
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; border-collapse:collapse; margin:8px 0; font-size:13px;\">\n"
"    <thead>\n"
"        <tr t-attf-style=\"background-color:{{ brand_dark }}; color:#FFFFFF;\">\n"
"            <th style=\"padding:8px 10px; text-align:left; font-weight:600; width:32px;\">#</th>\n"
"            <th style=\"padding:8px 10px; text-align:left; font-weight:600;\">Task</th>\n"
"            <th style=\"padding:8px 10px; text-align:left; font-weight:600; width:140px;\">Assigned to</th>\n"
"            <th style=\"padding:8px 10px; text-align:center; font-weight:600; width:100px;\">Deadline</th>\n"
"        </tr>\n"
"    </thead>\n"
"    <tbody>\n"
"        <t t-foreach=\"object.agenda_task_ids\" t-as=\"task\">\n"
"            <tr style=\"border-bottom:1px solid #EAEEF2;\">\n"
"                <td style=\"padding:8px 10px; color:#8A9099;\"><t t-out=\"task_index + 1\"/></td>\n"
"                <td style=\"padding:8px 10px; color:#374151;\"><strong t-attf-style=\"color:{{ brand_dark }};\"><t t-out=\"task.name\"/></strong></td>\n"
"                <td style=\"padding:8px 10px; color:#6B7280;\">\n"
"                    <t t-foreach=\"task.user_ids\" t-as=\"u\"><t t-out=\"u.name\"/><t t-if=\"not u_last\">, </t></t>\n"
"                </td>\n"
"                <td style=\"padding:8px 10px; text-align:center; color:#6B7280;\">\n"
"                    <t t-if=\"task.date_deadline\"><t t-out=\"task.date_deadline\"/></t>\n"
"                </td>\n"
"            </tr>\n"
"        </t>\n"
"    </tbody>\n"
"</table>\n"
"</t>\n"
"\n"
"<t t-if=\"object.preparation_html\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Preparation</h3>\n"
"<div style=\"margin:0 0 20px 0; color:#374151;\"><t t-out=\"object.preparation_html\"/></div>\n"
"</t>\n"
"\n"
"<t t-if=\"object.context_html\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Context</h3>\n"
"<div style=\"margin:0 0 20px 0; color:#374151;\"><t t-out=\"object.context_html\"/></div>\n"
"</t>\n"
"\n"
"<t t-set=\"shared_documents\" t-value=\"object._bf_shared_document_links()\"/>\n"
"<t t-if=\"shared_documents\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Documents</h3>\n"
"<ul style=\"margin:0 0 20px 0; padding-left:20px; color:#374151; font-size:15px; line-height:24px;\">\n"
"    <t t-foreach=\"shared_documents\" t-as=\"document\">\n"
"        <li style=\"margin:0 0 6px 0;\"><a t-att-href=\"document['url']\" t-attf-style=\"color:{{ brand_dark }}; text-decoration:underline;\"><t t-out=\"document['name']\"/></a></li>\n"
"    </t>\n"
"</ul>\n"
"</t>\n"
"\n"
"<p style=\"font-size:14px; line-height:22px; color:#6B7280; margin:28px 0 0 0;\">\n"
"    Please review the agenda and prepare your input.\n"
"</p>\n"
"\n"
"<t t-if=\"object.allow_contributions and object.access_token and object.contributions_open\">\n"
"    <t t-set=\"base\" t-value=\"object.get_base_url()\"/>\n"
"    <div style=\"margin:24px 0 0 0; padding:14px 16px; background-color:#F5F7FA; border-radius:6px;\">\n"
"        <p style=\"font-size:14px; color:#374151; margin:0 0 10px 0;\">\n"
"            Would you like to add a topic or leave a note before the meeting?\n"
"        </p>\n"
"        <a t-attf-href=\"{{ base }}/meeting/agenda/{{ object.access_token }}\" t-attf-style=\"display:inline-block; padding:10px 18px; background-color:{{ brand_primary }}; color:#FFFFFF; border-radius:6px; text-decoration:none; font-weight:600; font-size:14px;\">\n"
"            Suggest a topic or a comment\n"
"        </a>\n"
"    </div>\n"
"</t>\n"
"\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:24px 0 0 0;\">\n"
"    Kind regards,<br/>\n"
"    <t t-out=\"user.name\"/>\n"
"</p>\n"
"            "
msgstr ""

#. module: bf_meeting
#: model:mail.template,body_html:bf_meeting.meeting_report_mail_template
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Meeting minutes</p>\n"
"<h2 t-attf-style=\"font-size:20px; font-weight:700; color:{{ brand_dark }}; margin:0 0 12px 0;\">\n"
"    <t t-out=\"object.room_name or object.name\"/>\n"
"</h2>\n"
"\n"
"<p style=\"font-size:13px; color:#6B7280; margin:0 0 20px 0;\">\n"
"    <t t-if=\"object.date\">\n"
"        <t t-set=\"is_placeholder\" t-value=\"object.date.hour == 0 and object.date.minute == 0 and object.date.second == 0\"/>\n"
"        <strong style=\"color:#374151;\">Date:</strong>\n"
"        <t t-if=\"is_placeholder\">\n"
"            <t t-out=\"object.date.strftime('%Y-%m-%d')\"/>\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <t t-out=\"object.report_date_display_html()\"/>\n"
"        </t>\n"
"    </t>\n"
"    <t t-if=\"object.duration_minutes\">\n"
"        &nbsp;·&nbsp; <strong style=\"color:#374151;\">Duration:</strong> <t t-out=\"object.duration_minutes\"/> min\n"
"    </t>\n"
"    <t t-if=\"object.location\">\n"
"        &nbsp;·&nbsp; <strong style=\"color:#374151;\">Location:</strong> <t t-out=\"object.location\"/>\n"
"    </t>\n"
"</p>\n"
"\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">\n"
"    Hello,\n"
"</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;\">\n"
"    Please find the meeting minutes below. The full PDF is attached to this email.\n"
"</p>\n"
"\n"
"<t t-if=\"object.attendance_ids or object.participant_ids\">\n"
"<div style=\"margin:0 0 20px 0; padding:12px 14px; background-color:#F5F7FA; border-radius:6px; font-size:13px; color:#374151;\">\n"
"    <strong t-attf-style=\"color:{{ brand_dark }};\">Attendees:</strong>\n"
"    <t t-if=\"object.attendance_ids\">\n"
"        <t t-foreach=\"object.attendance_ids\" t-as=\"a\">\n"
"            <t t-set=\"absent\" t-value=\"a.status != 'present'\"/>\n"
"            <span t-attf-style=\"display:inline-block; margin:2px 4px; padding:2px 10px; background-color:#FFFFFF; border:1px solid #D8DEE4; border-radius:12px; font-size:12px; color:{{ '#9CA3AF' if absent else brand_dark }};\"><t t-out=\"a.partner_id.name\"/><t t-if=\"a.status == 'excused'\"> (excused)</t><t t-if=\"a.status == 'absent'\"> (absent)</t></span>\n"
"        </t>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"        <t t-foreach=\"object.participant_ids\" t-as=\"p\">\n"
"            <span t-attf-style=\"display:inline-block; margin:2px 4px; padding:2px 10px; background-color:#FFFFFF; border:1px solid #D8DEE4; border-radius:12px; font-size:12px; color:{{ brand_dark }};\"><t t-out=\"p.name\"/></span>\n"
"        </t>\n"
"    </t>\n"
"</div>\n"
"</t>\n"
"\n"
"<t t-if=\"object.summary\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Summary</h3>\n"
"<div style=\"margin:0 0 20px 0; white-space:pre-wrap; color:#374151; font-size:15px; line-height:24px;\"><t t-out=\"object.summary\"/></div>\n"
"</t>\n"
"\n"
"<t t-if=\"object.topic_ids\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Topics discussed</h3>\n"
"<ol style=\"margin:0 0 20px 0; padding-left:24px; color:#374151;\">\n"
"    <t t-foreach=\"object.topic_ids\" t-as=\"topic\">\n"
"        <li style=\"margin-bottom:10px;\">\n"
"            <strong t-attf-style=\"color:{{ brand_dark }};\"><t t-out=\"topic.name\"/></strong>\n"
"            <t t-if=\"topic.points_html\">\n"
"                <div style=\"margin-top:4px; color:#5C6368; font-size:14px;\"><t t-out=\"topic.points_html\"/></div>\n"
"            </t>\n"
"        </li>\n"
"    </t>\n"
"</ol>\n"
"</t>\n"
"\n"
"<t t-if=\"object.decision_ids\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Decisions</h3>\n"
"<ul style=\"margin:0 0 20px 0; padding-left:0; list-style:none;\">\n"
"    <t t-foreach=\"object.decision_ids\" t-as=\"decision\">\n"
"        <li t-attf-style=\"margin-bottom:8px; padding:8px 12px; background-color:#F5F7FA; border-left-width:3px; border-left-style:solid; border-left-color:{{ brand_primary }}; border-radius:3px; color:#374151;\">\n"
"            <strong t-attf-style=\"color:{{ brand_dark }};\"><t t-out=\"decision.name\"/></strong>\n"
"            <t t-if=\"decision.decision_maker_id\">\n"
"                <span style=\"color:#6B7280; font-size:13px;\"> — <t t-out=\"decision.decision_maker_id.name\"/></span>\n"
"            </t>\n"
"        </li>\n"
"    </t>\n"
"</ul>\n"
"</t>\n"
"\n"
"<t t-set=\"action_tasks\" t-value=\"object._action_tasks_for_report()\"/>\n"
"<t t-if=\"action_tasks\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Action items</h3>\n"
"<ul style=\"margin:0 0 20px 0; padding-left:24px; color:#374151;\">\n"
"    <t t-foreach=\"action_tasks\" t-as=\"task\">\n"
"        <li style=\"margin-bottom:6px;\">\n"
"            <t t-out=\"task.name\"/>\n"
"            <t t-if=\"task.user_ids\">\n"
"                <span style=\"color:#6B7280; font-size:13px;\"> — <t t-foreach=\"task.user_ids\" t-as=\"u\"><t t-if=\"not u_first\" t-out=\"', '\"/><t t-out=\"u.name\"/></t></span>\n"
"            </t>\n"
"            <t t-if=\"task.date_deadline\">\n"
"                <span style=\"color:#6B7280; font-size:13px;\"> (due <t t-out=\"task.date_deadline.strftime('%Y-%m-%d')\"/>)</span>\n"
"            </t>\n"
"        </li>\n"
"    </t>\n"
"</ul>\n"
"</t>\n"
"\n"
"<t t-set=\"discussed_tasks\" t-value=\"object._discussed_tasks_for_report()\"/>\n"
"<t t-if=\"discussed_tasks\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Existing tasks discussed</h3>\n"
"<ul style=\"margin:0 0 20px 0; padding-left:24px; color:#374151;\">\n"
"    <t t-foreach=\"discussed_tasks\" t-as=\"task\">\n"
"        <li style=\"margin-bottom:6px;\">\n"
"            <t t-out=\"task.name\"/>\n"
"            <t t-if=\"task.user_ids\">\n"
"                <span style=\"color:#6B7280; font-size:13px;\"> — <t t-foreach=\"task.user_ids\" t-as=\"u\"><t t-if=\"not u_first\" t-out=\"', '\"/><t t-out=\"u.name\"/></t></span>\n"
"            </t>\n"
"            <t t-if=\"task.date_deadline\">\n"
"                <span style=\"color:#6B7280; font-size:13px;\"> (due <t t-out=\"task.date_deadline.strftime('%Y-%m-%d')\"/>)</span>\n"
"            </t>\n"
"        </li>\n"
"    </t>\n"
"</ul>\n"
"</t>\n"
"\n"
"<t t-set=\"shared_documents\" t-value=\"object._bf_shared_document_links()\"/>\n"
"<t t-if=\"shared_documents\">\n"
"<h3 t-attf-style=\"color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};\">Documents</h3>\n"
"<ul style=\"margin:0 0 20px 0; padding-left:20px; color:#374151; font-size:15px; line-height:24px;\">\n"
"    <t t-foreach=\"shared_documents\" t-as=\"document\">\n"
"        <li style=\"margin:0 0 6px 0;\"><a t-att-href=\"document['url']\" t-attf-style=\"color:{{ brand_dark }}; text-decoration:underline;\"><t t-out=\"document['name']\"/></a></li>\n"
"    </t>\n"
"</ul>\n"
"</t>\n"
"\n"
"<p style=\"font-size:14px; line-height:22px; color:#6B7280; margin:28px 0 0 0;\">\n"
"    Feel free to reply to this email with any correction or clarification.\n"
"</p>\n"
"\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:24px 0 0 0;\">\n"
"    Kind regards,<br/>\n"
