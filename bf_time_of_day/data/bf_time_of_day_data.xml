<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="tod_morning" model="bf.time.of.day">
            <field name="name">Matinée</field>
            <field name="code">morning</field>
            <field name="sequence">10</field>
            <field name="color">10</field>
            <field name="icon">fa-coffee</field>
            <field name="default_time">9.0</field>
        </record>

        <record id="tod_midday" model="bf.time.of.day">
            <field name="name">Midi</field>
            <field name="code">midday</field>
            <field name="sequence">20</field>
            <field name="color">3</field>
            <field name="icon">fa-sun-o</field>
            <field name="default_time">12.0</field>
        </record>

        <record id="tod_eod" model="bf.time.of.day">
            <field name="name">Fin de jour</field>
            <field name="code">eod</field>
            <field name="sequence">30</field>
            <field name="color">4</field>
            <field name="icon">fa-clock-o</field>
            <field name="default_time">16.0</field>
        </record>

        <record id="tod_after_hours" model="bf.time.of.day">
            <field name="name">Hors heures</field>
            <field name="code">after_hours</field>
            <field name="sequence">40</field>
            <field name="color">9</field>
            <field name="icon">fa-moon-o</field>
            <field name="default_time">19.0</field>
        </record>

    </data>
</odoo>
