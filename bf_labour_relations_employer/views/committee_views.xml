<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_committee_list" model="ir.ui.view">
        <field name="name">bf.labour.committee.list</field>
        <field name="model">bf.labour.committee</field>
        <field name="arch" type="xml">
            <list string="Comités" decoration-warning="is_overdue == True">
                <field name="name"/>
                <field name="unit_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="cadence"/>
                <field name="last_meeting_date"/>
                <field name="next_expected_date"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_committee_form" model="ir.ui.view">
        <field name="name">bf.labour.committee.form</field>
        <field name="model">bf.labour.committee</field>
        <field name="arch" type="xml">
            <form string="Comité">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not is_overdue">
                        La cadence prévue n'est plus tenue : la dernière rencontre
                        tenue remonte à plus d'une période.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="unit_id" placeholder="Comité de la société"
                                   options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="unit_id" options="{'no_create': True}"/>
                            <field name="cadence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="last_meeting_date" readonly="1"/>
                            <field name="next_expected_date" readonly="1"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Représentation patronale">
                            <field name="employer_member_ids" nolabel="1" widget="many2many_tags"/>
                        </group>
                        <group>
                            <separator string="Représentation syndicale" colspan="2"
                                       invisible="not unit_id"/>
                            <separator string="Représentation des salariés" colspan="2"
                                       invisible="unit_id"/>
                            <field name="union_member_ids" nolabel="1" colspan="2"
                                   widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="meeting_ids" context="{'default_committee_id': id}">
                        <list>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_committee_meeting_list" model="ir.ui.view">
        <field name="name">bf.labour.committee.meeting.list</field>
        <field name="model">bf.labour.committee.meeting</field>
        <field name="arch" type="xml">
            <list string="Rencontres du comité">
                <field name="date"/>
                <field name="name"/>
                <field name="committee_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_committee_meeting_form" model="ir.ui.view">
        <field name="name">bf.labour.committee.meeting.form</field>
        <field name="model">bf.labour.committee.meeting</field>
        <field name="arch" type="xml">
            <form string="Rencontre du comité">
                <header>
                    <button name="action_hold" type="object" string="Marquer tenue"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="committee_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="committee_unit_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Griefs discutés"
                           invisible="not committee_unit_id and not grievance_ids">
                        <field name="grievance_ids" nolabel="1" widget="many2many_tags"
                               domain="[('company_id', '=', company_id)]"/>
                    </group>
                    <notebook>
                        <page string="Ordre du jour" name="agenda">
                            <field name="agenda"/>
                        </page>
                        <page string="Compte rendu" name="minutes">
                            <field name="minutes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_committee" model="ir.actions.act_window">
        <field name="name">Comités</field>
        <field name="res_model">bf.labour.committee</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_committee_meeting" model="ir.actions.act_window">
        <field name="name">Rencontres du comité</field>
        <field name="res_model">bf.labour.committee.meeting</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
