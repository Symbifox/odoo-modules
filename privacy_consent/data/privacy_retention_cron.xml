<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Séquence pour les certificats de destruction -->
    <record id="seq_privacy_destruction_request" model="ir.sequence">
        <field name="name">Certificat de destruction (vie privée)</field>
        <field name="code">privacy.destruction.request</field>
        <field name="prefix">DEST-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Cron : Créer les demandes de destruction selon les politiques de rétention -->
    <record id="cron_create_destruction_requests" model="ir.cron">
        <field name="name">Vie privée : Créer les demandes de destruction</field>
        <field name="model_id" ref="model_privacy_destruction_request"/>
        <field name="state">code</field>
        <field name="code">model.cron_create_destruction_requests()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Cron : Traiter les destructions planifiées -->
    <record id="cron_process_scheduled_destructions" model="ir.cron">
        <field name="name">Vie privée : Traiter les destructions planifiées</field>
        <field name="model_id" ref="model_privacy_destruction_request"/>
        <field name="state">code</field>
        <field name="code">model.cron_process_scheduled_destructions()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
