<odoo>
    <data noupdate="1">

        <!--
          Trois référentiels livrés, nommés par ce qu'ils MESURENT.

          ⚠️ Aucun NOM DE MARQUE d'éditeur dans le code : ni « DiSC », ni
          « Everything DiSC », ni « MBTI », ni « Myers-Briggs », qui appartiennent
          à leurs éditeurs. Chaque référentiel est nommé par ce qu'il mesure, et
          « DISC » en majuscules n'apparaît qu'entre parenthèses, comme acronyme
          générique du modèle de Marston, pour que le client reconnaisse la
          famille de son atelier. Le module n'administre aucun questionnaire : il
          enregistre un résultat obtenu ailleurs, et le client nomme lui-même son
          instrument dans « Instrument ou fournisseur ».

          ⚠️ Le C de cette famille s'appelle « Compliance » et non
          « Conscientiousness » : ce dernier est le C du Big Five, et les deux
          portaient le même libellé anglais, donc une seule traduction pour deux
          facteurs qui ne veulent pas dire la même chose.

          ⚠️ Les textes des seize types ne recopient aucun portrait d'éditeur :
          chacun est composé des quatre dichotomies de son code.

          🔴 `noupdate="1"` : le client renomme ses types et ajuste les textes,
          et une montée n'a pas à écraser son travail. Le prix est connu :
          corriger un texte livré demande une migration, pas un `-u`.
        -->

        <record id="framework_behaviour4" model="bf.ex.profile.framework">
            <field name="code">behaviour4</field>
            <field name="name">Four behavioural styles (DISC family)</field>
            <field name="sequence">10</field>
            <field name="result_mode">scored</field>
            <field name="scale_min">0</field>
            <field name="scale_max">100</field>
            <field name="description">Four behavioural styles, each scored. Most reports of this family give a score on all four and a dominant one; the dominant style is computed here from the scores rather than entered twice.</field>
        </record>

        <record id="type_behaviour4_d" model="bf.ex.profile.type">
            <field name="framework_id" ref="framework_behaviour4"/>
            <field name="code">d</field>
            <field name="abbr">D</field>
            <field name="name">Dominance</field>
            <field name="sequence">10</field>
            <field name="description">Gets to the point, takes the decision, dislikes being slowed down.</field>
            <field name="working_with">Direct and quick. Lead with the conclusion and the decision you want.</field>
        </record>

        <record id="type_behaviour4_i" model="bf.ex.profile.type">
            <field name="framework_id" ref="framework_behaviour4"/>
            <field name="code">i</field>
            <field name="abbr">I</field>
            <field name="name">Influence</field>
            <field name="sequence">20</field>
            <field name="description">Convinces, brings people along, needs the room to react.</field>
            <field name="working_with">Talk it through before writing it down, and say out loud what you agree with.</field>
        </record>

        <record id="type_behaviour4_s" model="bf.ex.profile.type">
            <field name="framework_id" ref="framework_behaviour4"/>
            <field name="code">s</field>
            <field name="abbr">S</field>
            <field name="name">Steadiness</field>
            <field name="sequence">30</field>
            <field name="description">Steady, reliable, takes a change badly when it arrives unannounced.</field>
            <field name="working_with">Give notice before a change, and say what stays the same.</field>
        </record>

        <record id="type_behaviour4_c" model="bf.ex.profile.type">
            <field name="framework_id" ref="framework_behaviour4"/>
            <field name="code">c</field>
            <field name="abbr">C</field>
            <field name="name">Compliance</field>
            <field name="sequence">40</field>
            <field name="description">Checks, documents, will not sign off on an approximation.</field>
            <field name="working_with">Send the detail in writing first, and expect questions on the detail.</field>
        </record>

        <record id="framework_types16" model="bf.ex.profile.framework">
            <field name="code">types16</field>
            <field name="name">Sixteen types (Jungian dichotomies)</field>
            <field name="sequence">20</field>
            <field name="result_mode">single</field>
            <field name="description">Sixteen types built from four dichotomies. One type per person, named by its four letters.</field>
        </record>

        <record id="type_types16_istj" model="bf.ex.profile.type">
            <field name="framework_id" ref="framework_types16"/>
            <field name="code">istj</field>
            <field name="abbr"></field>
            <field name="name">ISTJ</field>
            <field name="sequence">10</field>
            <field name="description">Introverted, sensing, thinking, judging.</field>
            <field name="working_with">Thinks before speaking, so leave a silence after a question. Wants the concrete facts first, not the intention behind them. Decides on stated criteria, so name them. Wants the matter settled, so say when it will be.</field>
        </record>

