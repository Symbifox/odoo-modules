<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_dav" model="ir.ui.view">
        <field name="name">res.users.preferences.form.dav</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <group name="access" position="after">
                <group name="bf_dav" string="Calendar and contacts apps">
                    <div colspan="2" class="text-muted">
                        Thunderbird, Apple Calendar and Contacts, and Android (with DAVx5) can read and
                        write your Odoo calendar and contacts. Give each device its own app password:
                        it opens your calendars and contacts only, and you can revoke it above, in the
                        list of keys.
                    </div>
                    <div colspan="2">
                        <button name="action_bf_dav_new_password" string="New app password" type="object"
                                class="btn btn-secondary" icon="fa-calendar"/>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
