<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_expense_mileage_wizard_view_form" model="ir.ui.view">
        <field name="name">bf.expense.mileage.wizard.form</field>
        <field name="model">bf.expense.mileage.wizard</field>
        <field name="arch" type="xml">
            <form string="Add mileage">
                <group>
                    <group>
                        <field name="employee_id" widget="many2one_avatar_employee"
                               options="{'relation': 'hr.employee.public', 'no_create': True}"/>
                        <field name="date"/>
                        <field name="distance_km"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                    </group>
                </group>
                <field name="name" placeholder="e.g. Office to the customer's plant and back, installation"/>
                <div invisible="not preview" class="mt-3">
                    <div class="text-muted">The kilometres will be claimed as:</div>
                    <field name="preview" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_create" type="object" string="Add" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bf_expense_mileage_wizard_action" model="ir.actions.act_window">
        <field name="name">Add mileage</field>
        <field name="res_model">bf.expense.mileage.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="bf_expense_mileage_menu" action="bf_expense_mileage_wizard_action"
              parent="hr_expense.menu_hr_expense_my_expenses" sequence="5"/>
</odoo>
