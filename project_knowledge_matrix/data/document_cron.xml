<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Entretien quotidien : les trois passes qui créent des activités.
             Elles avaient chacune leur tâche planifiée, dont deux partaient à
             la même minute. Un seul réveil, trois points de reprise.
             Les tâches qui ENVOIENT DU COURRIEL restent séparées : leur rythme
             et leur risque n'ont rien à voir avec ceux-ci. -->
        <record id="ir_cron_document_daily_maintenance" model="ir.cron">
            <field name="name">Documents : entretien quotidien</field>
            <field name="model_id" ref="model_project_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_document_maintenance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=5, minute=30, second=0))"/>
            <field name="active">True</field>
        </record>

        <!-- Rapport par courriel, bimensuel. Garde sa propre tâche : il sort du
             courriel, donc son échec ne doit pas se confondre avec celui d'une
             passe d'activités, et sa reprise n'a pas le même sens. -->
        <record id="ir_cron_document_dashboard_report" model="ir.cron">
            <field name="name">Documents: Rapport tableau de bord (bimensuel)</field>
            <field name="model_id" ref="model_project_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_dashboard_report()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
