<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="activity_type_recover" model="mail.activity.type">
        <field name="name">Recover a key</field>
        <field name="summary">Recover at departure</field>
        <field name="icon">fa-key</field>
        <field name="res_model">bf.key.assignment</field>
        <field name="delay_count">0</field>
        <field name="category">default</field>
    </record>

    <record id="cron_overdue" model="ir.cron">
        <field name="name">Keys: reminders for overdue hand-outs</field>
        <field name="model_id" ref="model_bf_key_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_retention" model="ir.cron">
        <field name="name">Keys: erase hand-out details past the retention period</field>
        <field name="model_id" ref="model_bf_key_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_review" model="ir.cron">
        <field name="name">Keys: master key systems due for review</field>
        <field name="model_id" ref="model_bf_key_system"/>
        <field name="state">code</field>
        <field name="code">model._cron_review()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
