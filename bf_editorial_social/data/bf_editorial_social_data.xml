<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Le médium UTM « Bluesky » manquait : sans lui, aucun clic ne
             s'attribue au réseau. -->
        <record id="utm_medium_bluesky" model="utm.medium">
            <field name="name">Bluesky</field>
        </record>

        <!-- ⚠️ Les deux travaux périodiques sont livrés ÉTEINTS. Une diffusion
             qui part toute seule est une décision d'exploitation. -->
        <record id="cron_send_scheduled" model="ir.cron">
            <field name="name">Atelier éditorial : diffusions sociales dues</field>
            <field name="model_id" ref="model_bf_social_post"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_scheduled()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="False"/>
        </record>
        <record id="cron_fetch_metrics" model="ir.cron">
            <field name="name">Atelier éditorial : mesures des billets sociaux</field>
            <field name="model_id" ref="model_bf_social_post"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_metrics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
