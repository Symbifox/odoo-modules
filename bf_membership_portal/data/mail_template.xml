<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          L'accusé de réception d'une demande venue du formulaire public. Il part
          à l'adresse saisie, que ce courriel soit déjà connu ou non, et ne dit
          rien de plus dans un cas que dans l'autre : le formulaire ne révèle pas
          qui est au registre. Il ne reprend aucun texte saisi au formulaire, pas
          même le nom, ni dans le corps ni dans l'en-tête « À » (il part à
          l'adresse seule) : sinon, n'importe qui ferait partir de l'adresse de
          l'organisme un texte de son choix vers une adresse de son choix.
        -->
        <record id="mail_template_signup_ack" model="mail.template">
            <field name="name">Membres : accusé de réception d'une demande</field>
            <field name="model_id" ref="bf_membership.model_bf_membership"/>
            <field name="subject">Votre demande d'adhésion est reçue</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <!-- 🔴 À l'adresse seule : avec `partner_to`, l'en-tête « À » porterait le nom tapé. -->
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>Bonjour,</p>
    <p>Nous avons bien reçu votre demande d'adhésion (<t t-out="object.type_id.name or ''"/>,
        <t t-out="object.company_id.name or ''"/>). L'organisme la traitera et communiquera avec vous au besoin.</p>
    <p>Vous n'avez rien envoyé ? Vous pouvez ignorer ce message : aucune adhésion ne sera
        confirmée sans la décision de l'organisme ou le paiement de la cotisation.</p>
    <p>Merci,<br/><t t-out="object.company_id.name or ''"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
