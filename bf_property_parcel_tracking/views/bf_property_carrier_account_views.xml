<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carrier_account_list" model="ir.ui.view">
        <field name="name">bf.property.carrier.account.list</field>
        <field name="model">bf.property.carrier.account</field>
        <field name="arch" type="xml">
            <list string="Comptes de transporteur">
                <field name="carrier"/>
                <field name="environment"/>
                <field name="locale" optional="hide"/>
                <field name="hourly_limit" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_carrier_account_form" model="ir.ui.view">
        <field name="name">bf.property.carrier.account.form</field>
        <field name="model">bf.property.carrier.account</field>
        <field name="arch" type="xml">
            <form string="Compte de transporteur">
                <header>
                    <button name="action_test_credentials" type="object"
                            string="Essayer les clés" class="btn-secondary"
                            groups="bf_property_core.group_bf_property_manager"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="carrier"/>
                            <field name="environment"/>
                            <field name="locale"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="hourly_limit"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="UPS" invisible="carrier != 'ups'"
                           groups="bf_property_core.group_bf_property_manager">
                        <field name="ups_client_id"/>
                        <field name="ups_client_secret" password="True"/>
                        <field name="ups_account_number"/>
                        <field name="ups_token_expires_at" readonly="1"/>
                        <field name="ups_token" invisible="1"/>
                    </group>
                    <group string="DHL" invisible="carrier != 'dhl'"
                           groups="bf_property_core.group_bf_property_manager">
                        <field name="dhl_api_key" password="True"/>
                    </group>
                    <group string="Purolator" invisible="carrier != 'purolator'"
                           groups="bf_property_core.group_bf_property_manager">
                        <div class="alert alert-warning" role="alert" colspan="2">
                            Purolator ne publie ni sa WSDL ni sa documentation sans compte :
                            le suivi n'est pas branché, et un numéro Purolator se suit à la
                            main. La clé de développement s'obtient au portail
                            ship.purolator.com/developer ; la clé de production exige un
                            numéro de compte d'affaires, la certification de l'intégration
                            et trois contacts de l'entreprise.
                        </div>
                        <field name="purolator_key" password="True"/>
                        <field name="purolator_password" password="True"/>
                        <field name="purolator_account_number"/>
                    </group>
                    <field name="note" placeholder="Note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_carrier_account" model="ir.actions.act_window">
        <field name="name">Comptes de transporteur</field>
        <field name="res_model">bf.property.carrier.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun compte de transporteur</p>
            <p>Avec les clés d'UPS ou de DHL, un colis annoncé par un résident se suit
               tout seul jusqu'à sa livraison, et le résident est prévenu à ce
               moment-là.</p>
        </field>
    </record>

    <menuitem id="menu_carrier_account" name="Transporteurs"
              parent="bf_property_portal.menu_property_portal"
              action="action_carrier_account" sequence="15"
              groups="bf_property_core.group_bf_property_manager"/>
</odoo>
