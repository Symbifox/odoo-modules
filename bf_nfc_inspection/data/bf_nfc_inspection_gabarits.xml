<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="gabarit_premiers_secours" model="bf.nfc.template">
        <field name="name">First aid kit and defibrillator</field>
        <field name="secteur">sst</field>
        <field name="sequence">10</field>
        <field name="recette">pastilles</field>
        <field name="gesture_id" ref="gesture_reading"/>
        <field name="checklist_id" ref="grille_premiers_secours"/>
        <field name="reference">Regulation respecting minimum standards of first aid and first aid services (A-3.001, r. 10)</field>
        <field name="description">A tag on each kit and each defibrillator. The monthly reading says whether the kit is complete and the defibrillator is ready; an expired product becomes an issue to correct.</field>
        <field name="exemple">Kit ; 2nd floor kitchen
Defibrillator ; reception</field>
    </record>

    <record id="gabarit_alarme" model="bf.nfc.template">
        <field name="name">Fire alarm panel: daily check</field>
        <field name="secteur">incendie</field>
        <field name="sequence">40</field>
        <field name="recette">pastilles</field>
        <field name="gesture_id" ref="gesture_reading"/>
        <field name="checklist_id" ref="grille_alarme"/>
        <field name="reference">Québec Safety Code, Building chapter (National Fire Code, 6.3.1.2)</field>
        <field name="description">A tag on the panel: the daily reading records the power supply and the absence of trouble signals. The watcher reports a day without a reading.</field>
        <field name="exemple">Alarm panel ; utility room</field>
    </record>

    <record id="gabarit_fermeture_bureau" model="bf.nfc.template">
        <field name="name">Office closing round</field>
        <field name="secteur">bureau</field>
        <field name="sequence">30</field>
        <field name="recette">pastilles</field>
        <field name="gesture_id" ref="gesture_reading"/>
        <field name="checklist_id" ref="grille_fermeture_bureau"/>
        <field name="description">A tag near the exit. The last person to leave taps it: doors, windows, alarm, appliances, lights. Anything left undone goes to the person in charge that same evening.</field>
        <field name="exemple">Closing ; main door</field>
    </record>
</odoo>
