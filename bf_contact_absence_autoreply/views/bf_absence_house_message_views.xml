<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_absence_house_message_list" model="ir.ui.view">
        <field name="name">bf.absence.house.message.list</field>
        <field name="model">bf.absence.house.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="tone"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_bf_absence_house_message_form" model="ir.ui.view">
        <field name="name">bf.absence.house.message.form</field>
        <field name="model">bf.absence.house.message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tone"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Message">
                        <field name="body_html" nolabel="1"/>
                    </group>
                    <group string="Stand-in sentence">
                        <div class="text-muted" colspan="2">
                            Added only when a stand-in is named. The name marker and the address marker are described in the field tooltip.
                        </div>
                        <field name="backup_html" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_absence_house_message" model="ir.actions.act_window">
        <field name="name">House absence messages</field>
        <field name="res_model">bf.absence.house.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No house message</p>
            <p>Without text, no responder arms. That is deliberate: an empty template sent to a client costs more than a silence.</p>
        </field>
    </record>

</odoo>
