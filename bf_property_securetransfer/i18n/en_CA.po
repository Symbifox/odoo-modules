#: model:ir.model.fields,field_description:bf_property_securetransfer.field_bf_property_disclosure__secure_frozen_attachment_id
#: model:ir.model.fields,field_description:bf_property_securetransfer.field_bf_property_secure_delivery__secure_frozen_attachment_id
msgid "Copie remise"
msgstr "Copy delivered"

#. module: bf_property_securetransfer
#: model:ir.model.fields.selection,name:bf_property_securetransfer.selection__bf_property_organisation__secure_otp_channel__email
msgid "Courriel"
msgstr "Email"

#. module: bf_property_securetransfer
#: model:ir.model,name:bf_property_securetransfer.model_bf_property_disclosure
msgid "Demande de documents (art. 1068.2)"
msgstr "Request for documents (art. 1068.2)"

#. module: bf_property_securetransfer
#. odoo-python
#: code:addons/bf_property_securetransfer/models/bf_property_disclosure.py:0
msgid "Documents de copropriété : %s"
msgstr "Co-ownership documents: %s"

#. module: bf_property_securetransfer
#: model:ir.model.fields,field_description:bf_property_securetransfer.field_bf_property_attestation__secure_unread
#: model:ir.model.fields,field_description:bf_property_securetransfer.field_bf_property_charge_statement__secure_unread
#: model:ir.model.fields,field_description:bf_property_securetransfer.field_bf_property_disclosure__secure_unread
#: model:ir.model.fields,field_description:bf_property_securetransfer.field_bf_property_secure_delivery__secure_unread
msgid "Expiré sans avoir été ouvert"
msgstr "Expired without being opened"

#. module: bf_property_securetransfer
#. odoo-python
#: code:addons/bf_property_securetransfer/models/bf_property_secure_mixin.py:0
msgid ""
"Joignez d'abord les pièces à remettre : le module n'en fabrique pas à votre "
"place."
msgstr ""
"Attach the documents to be delivered first: the module does not make any for"
" you."

#. module: bf_property_securetransfer
#. odoo-python
#: code:addons/bf_property_securetransfer/models/bf_property_disclosure.py:0
msgid ""
"La revue de vie privée n'est pas faite. L'art. 1068.2 n'autorise pas la "
"communication des renseignements personnels des autres copropriétaires, et "
"une pièce partie par un lien sécurisé ne se caviarde plus."
msgstr ""
"The privacy review has not been done. Art. 1068.2 does not authorize "
"communicating the personal information of the other co-owners, and a "
"document sent through a secure link can no longer be redacted."

#. module: bf_property_securetransfer
#. odoo-python
#: code:addons/bf_property_securetransfer/models/bf_property_secure_mixin.py:0
msgid ""
"Le destinataire n'a pas d'adresse courriel : le lien sécurisé n'aurait nulle"
" part où aller."
msgstr ""
"The recipient has no email address: the secure link would have nowhere to "
"go."

#. module: bf_property_securetransfer
#: model_terms:ir.ui.view,arch_db:bf_property_securetransfer.view_property_disclosure_form_secure
msgid "Le lien a expiré et personne ne l'a ouvert."
msgstr "The link expired and nobody opened it."

#. module: bf_property_securetransfer
#: model_terms:ir.ui.view,arch_db:bf_property_securetransfer.view_property_charge_statement_form_secure
msgid ""
"Le lien a expiré et personne ne l'a ouvert. Le délai de\n"
"                            quinze jours de l'article 1069 alinéa 2 joue contre le\n"
"                            syndicat : passé ce délai, l'acquéreur n'est plus tenu."
msgstr ""
"The link expired and nobody opened it. The fifteen-day\n"
"                            period of article 1069 paragraph 2 runs against the\n"
"                            syndicate: after it, the acquirer is no longer bound."

#. module: bf_property_securetransfer
#: model_terms:ir.ui.view,arch_db:bf_property_securetransfer.view_property_attestation_form_secure
msgid ""
"Le lien a expiré et personne ne l'a ouvert. Le syndicat a\n"
"                            envoyé ; le destinataire n'a rien reçu."
msgstr ""
"The link expired and nobody opened it. The syndicate\n"
"                            sent; the recipient received nothing."

#. module: bf_property_securetransfer
#: model:ir.model.fields,help:bf_property_securetransfer.field_bf_property_attestation__secure_transfer_id
#: model:ir.model.fields,help:bf_property_securetransfer.field_bf_property_charge_statement__secure_transfer_id
#: model:ir.model.fields,help:bf_property_securetransfer.field_bf_property_disclosure__secure_transfer_id
#: model:ir.model.fields,help:bf_property_securetransfer.field_bf_property_secure_delivery__secure_transfer_id
msgid "Le transfert par lequel la pièce est partie."
msgstr "The transfer by which the document went out."

#. module: bf_property_securetransfer
#. odoo-python
#: code:addons/bf_property_securetransfer/models/bf_property_secure_mixin.py:0
msgid ""
"Le transfert sécurisé n'a pas rendu d'identifiant : rien n'a été rattaché à "
"la fiche."
msgstr ""
"The secure transfer returned no identifier: nothing was attached to the "
"record."

