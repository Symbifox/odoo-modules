<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone public pages (bf_sign pattern): full HTML documents, NO
         portal/website layout — the website router must never hijack a brand
         Host.

         ⚠ The doctype is NOT written here: it comes from the `doctype` value
         that controllers/main.py._render_page injects. Odoo skips the
         translation of an ENTIRE view whose arch starts with a doctype
         (tools/translate.py: `avoid_pattern`), so these three pages used to
         export zero translatable terms and stayed French for an en_CA visitor
         whatever the .po said. Put a doctype back in the arch and you silently
         un-translate the whole public product.

         Rendering context passed by controllers/main.py:
           all pages      : brand, visuals (brand._visuals()), locale
           page_upload    : limits (brand._effective_limits()),
                            st_config_json (Markup JSON for #st-config)
           page_download  : transfer (sudo record), files, token,
                            locked (bool), pw_error, reported, expiry_display
           page_unavailable : message (str or False)
         DOM ids are the contract of static/src/js/st_upload.js and
         st_download.js — do not rename them without updating the JS. -->

    <!-- ============================================================= -->
    <!-- Brand CSS variables (shared by all public pages)               -->
    <!-- ============================================================= -->
    <template id="brand_style" name="Secure transfer: brand variables">
        <style>
            :root {
                --st-primary: <t t-esc="visuals['primary']"/>;
                --st-dark: <t t-esc="visuals['dark']"/>;
            }
        </style>
    </template>

    <!-- ============================================================= -->
    <!-- Public upload page                                             -->
    <!-- ============================================================= -->
    <template id="page_upload" name="Secure transfer: upload page">
        <t t-out="doctype"/>
        <html t-att-lang="(locale or 'fr_CA')[:2]">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title><t t-esc="st_txt['send_files']"/> — <t t-esc="visuals['name']"/></title>
                <link t-if="visuals['favicon_url']" rel="icon" t-att-href="visuals['favicon_url']"/>
                <link rel="stylesheet" href="/bf_securetransfer/static/src/css/st_public.css"/>
                <t t-call="bf_securetransfer.brand_style"/>
            </head>
            <body>
                <main class="st-wrap">
                    <header class="st-header">
                        <img t-if="visuals['logo_url']" class="st-logo"
                             t-att-src="visuals['logo_url']" t-att-alt="visuals['name']"/>
                        <span class="st-brand-name"><t t-esc="visuals['name']"/></span>
                    </header>

                    <div id="st-upload-panel">
                        <section class="st-card">
                            <t t-if="drop_mode">
                                <h1 class="st-title">Drop a file</h1>
                                <p class="st-subtitle">This link is reserved exclusively for your upload to <strong t-esc="drop_recipient_label"/>. Your files travel encrypted, the link has a limited lifetime, and its contents are deleted automatically once the deadline you choose has passed.</p>
                            </t>
                            <t t-else="">
                                <h1 class="st-title">Send files</h1>
                                <p class="st-subtitle">This link is reserved for your upload. Your files travel encrypted, the link has a limited lifetime, and its contents are deleted automatically once the deadline you choose has passed.</p>
                            </t>

                            <noscript>
                                <div class="st-error">JavaScript is required to upload files on this page.</div>
                            </noscript>

                            <!-- Errors raised by st_upload.js land here -->
                            <div id="st-error" class="st-error" hidden="hidden"></div>

                            <!-- WHO — filled first, before dropping files, so a
                                 file never triggers a « missing e-mail » error. -->
                            <div class="st-field">
                                <label for="st-sender-email">Your email *</label>
                                <input type="email" id="st-sender-email" required="required"
                                       autocomplete="email" maxlength="254"/>
                                <div class="st-field-hint">Required to send; you will receive a receipt.</div>
                            </div>
                            <div class="st-field">
                                <label for="st-sender-name">Your name</label>
                                <input type="text" id="st-sender-name" maxlength="128"
                                       autocomplete="name"/>
                            </div>
                            <div t-if="not drop_mode" class="st-field" id="st-recipients-row">
                                <label for="st-recipients">Recipient emails</label>
                                <input type="text" id="st-recipients"
                                       placeholder="name@example.com, other@example.com"/>
                                <div class="st-field-hint">Up to 10 addresses, comma-separated. Leave empty to only get the link.</div>
                            </div>
                            <!-- Drop page: the recipient is fixed to the page owner and
                                 forced server-side; show it, never let it be edited. -->
                            <div t-else="" class="st-drop-to">
                                <span class="st-drop-to-label">Recipient</span>
                                <span class="st-drop-to-value" t-esc="drop_recipient_label"/>
                            </div>

                            <!-- Tabs: Fichiers (défaut) / Message seul -->
                            <div class="st-tabs" role="tablist">
                                <button type="button" id="st-tab-files" class="st-tab st-tab-active"
                                        data-mode="files" role="tab">Files</button>
                                <button type="button" id="st-tab-message" class="st-tab"
                                        data-mode="message" role="tab">Message only</button>
                            </div>

                            <div id="st-mode-files">
                                <div id="st-dropzone" class="st-dropzone" tabindex="0" role="button"
                                     aria-label="Drop files">
                                    <span class="st-dropzone-icon" aria-hidden="true">&#8682;</span>
                                    <p>Drag your files here or click to browse</p>
                                    <p class="st-dropzone-hint">
                                        Up to <t t-esc="limits['max_files']"/> files,
                                        <t t-esc="st_size(limits['max_bytes'], True)"/>
                                        in total.</p>
                                </div>
                                <input type="file" id="st-file-input" multiple="multiple" hidden="hidden"/>
                                <div id="st-file-list" class="st-file-list"></div>
                                <div id="st-progress" class="st-progress" hidden="hidden"></div>
                            </div>

                            <div id="st-mode-message" hidden="hidden">
                                <p class="st-subtitle">Send a secure message with no file (a password, for instance). It opens through the same time-limited link.</p>
                            </div>

                            <div class="st-options">
                                <!-- The one line that tells the recipient what
                                     this is before they open anything. It rides
                                     the mail header, so the hint says plainly
                                     that it is not covered by the gates. -->
                                <div class="st-field">
                                    <label for="st-subject">Subject (optional)</label>
                                    <input type="text" id="st-subject" maxlength="120"
                                           placeholder="E.g. 2026 leases"/>
                                    <div class="st-field-hint">What the recipient sees
                                        in the email subject and as the page title.
                                        It travels in the clear: keep anything confidential out of it.</div>
                                </div>
                                <div class="st-field">
                                    <label for="st-message" id="st-message-label">Message (optional)</label>
                                    <textarea id="st-message" maxlength="2000" rows="3"></textarea>
                                </div>
                                <div class="st-options-grid">
                                    <div class="st-field">
                                        <label for="st-expiry">Availability period</label>
                                        <select id="st-expiry">
                                            <t t-foreach="limits['expiry_choices']" t-as="d">
                                                <option t-att-value="d"
                                                        t-att-selected="'selected' if d == 7 or (7 not in limits['expiry_choices'] and d == limits['expiry_choices'][0]) else None">
                                                    <t t-esc="st_txt['one_day'] if d == 1 else st_txt['days'] % d"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="st-field" id="st-password-row"
                                         t-if="limits['allow_password']">
                                        <label for="st-password">Password (optional)</label>
                                        <input type="password" id="st-password" maxlength="128"
                                               autocomplete="new-password"/>
                                        <div class="st-field-hint">Never send it by email or in the message itself. Pass it along another way (phone or text message); it never appears in our emails.</div>
                                    </div>
                                    <div class="st-field" id="st-max-downloads-row">
                                        <label for="st-max-downloads">Downloads allowed</label>
                                        <input type="number" id="st-max-downloads" min="0"
                                               t-att-max="limits['max_download_budget']"
                                               step="1" value="0"/>
                                        <div class="st-field-hint">0 = no limit. The link stops working once that number of downloads is reached.</div>
                                    </div>
                                    <div class="st-field st-check" id="st-burn-row"
                                         t-if="limits['allow_burn']">
                                        <label>
                                            <input type="checkbox" id="st-burn"/>
                                            Destroy after download
                                        </label>
                                        <div class="st-field-hint">The link stops working as soon as a recipient has downloaded every file in the transfer.</div>
                                    </div>
                                    <!-- Recipient code: the sender may ARM the gate here; when the
                                         instance already requires it for every transfer the box is
                                         shown ticked and locked, so nobody reads its absence as an
                                         opt-out. -->
                                    <div class="st-field st-check" id="st-recipient-otp-row"
                                         t-if="limits['allow_recipient_otp'] or limits['recipient_otp_forced']">
                                        <label>
                                            <input type="checkbox" id="st-recipient-otp"
                                                   t-att-checked="'checked' if limits['recipient_otp_forced'] else None"
                                                   t-att-disabled="'disabled' if limits['recipient_otp_forced'] else None"/>
                                            Require a code from the recipient
                                        </label>
                                        <div class="st-field-hint">
                                            <t t-if="limits['recipient_otp_forced']">Required by this service: the recipient will have to confirm their address and enter a code before seeing anything.</t>
                                            <t t-else="">The content stays held until the recipient enters a one-time code sent to their address; the link alone is no longer enough.</t>
                                        </div>
                                    </div>
                                    <div class="st-field st-check" id="st-notify-row">
                                        <label>
                                            <input type="checkbox" id="st-notify"
                                                   t-att-checked="'checked' if brand.notify_on_download else None"/>
                                            Notify me on the first download
                                        </label>
                                        <div class="st-field-hint">You get an email as soon as a recipient downloads the transfer.</div>
                                    </div>
                                </div>

                                <!-- Honeypot: humans never see it, bots fill it.
                                     The API answers a silent fake success. -->
                                <div class="st-hp" aria-hidden="true">
                                    <label for="website_url">URL</label>
                                    <input type="text" name="website_url" id="website_url"
                                           tabindex="-1" autocomplete="off"/>
                                </div>

                                <!-- Drop page: the file is delivered straight to
                                     the page owner, so the button says "send",
                                     not "get the link". st_upload.js keeps this
                                     label in sync per mode/locale (send_drop). -->
                                <button type="button" id="st-finalize"
                                        class="st-btn st-btn-primary" disabled="disabled">
                                    <t t-if="drop_mode">Send the files</t>
                                    <t t-else="">Get the link</t></button>
                            </div>
                        </section>
                    </div>

                    <!-- Sender OTP challenge (shown by st_upload.js when the
                         tenant requires sender confirmation) -->
                    <section id="st-otp" class="st-card st-gate" hidden="hidden">
                        <span class="st-gate-icon" aria-hidden="true">&#128231;</span>
                        <h1 class="st-title">Confirm your send</h1>
                        <p>A 6-digit code has just been sent to your email address. Enter it to send the transfer.</p>
                        <input type="text" id="st-otp-code" inputmode="numeric"
                               pattern="[0-9]*" maxlength="6" autocomplete="one-time-code"
                               aria-label="Confirmation code"/>
                        <button type="button" id="st-otp-confirm" class="st-btn st-btn-primary">
                            Confirm and send</button>
                        <button type="button" id="st-otp-resend" class="st-btn-link">
                            Send a new code</button>
                    </section>

                    <!-- Success panel (filled and shown by st_upload.js).
                         Drop page: the transfer was e-mailed straight to the
                         page owner — confirm the direct delivery, no link to
                         copy back. General page: the sender gets the share link
                         to forward themselves. st_upload.js null-checks the
                         link/copy/expiry nodes, so their absence in drop mode is
                         safe. -->
                    <section id="st-success" class="st-card st-success-panel" hidden="hidden">
                        <span class="st-success-icon" aria-hidden="true">&#10003;</span>
                        <t t-if="drop_mode">
                            <h1 class="st-title">Upload delivered</h1>
                            <p>Your upload was <strong>delivered straight to
                                <t t-esc="drop_recipient_label"/></strong>, who has just been notified by email. There is nothing else for you to do.</p>
                            <p class="st-expiry-note">A receipt has just been sent to your email address as well.</p>
                            <p class="st-after-note">If you protected this upload with a password, pass it along to them separately, by some means other than email (phone or text message).</p>
                        </t>
                        <t t-else="">
                            <h1 class="st-title">Transfer ready</h1>
                            <p>Here is your share link:</p>
                            <div class="st-share-row">
                                <input type="text" id="st-share-url" readonly="readonly"/>
                                <button type="button" id="st-copy" class="st-btn st-btn-secondary">
                                    Copy link</button>
                            </div>
                            <p id="st-expiry-note" class="st-expiry-note"
                               t-att-data-template="st_txt['expires_on']"></p>
                        </t>
                    </section>

                    <footer class="st-footer">
                        <span t-if="visuals['tagline']" class="st-tagline" t-esc="visuals['tagline']"/>
                        <span t-if="visuals['powered_by']" class="st-powered">
                            Powered by <t t-esc="visuals['powered_by_name']"/></span>
                    </footer>
                </main>

                <!-- Server config for st_upload.js: limits, API URLs and
                     translated strings — no server constant lives in the JS.
                     Non-executable JSON block (t-out of a server-built Markup
                     whose '</' sequences are escaped by the controller). -->
                <script type="application/json" id="st-config"><t t-out="st_config_json"/></script>
                <script src="/bf_securetransfer/static/src/js/st_upload.js"></script>
            </body>
        </html>
    </template>

    <!-- ============================================================= -->
    <!-- Public download page                                           -->
    <!-- ============================================================= -->
    <template id="page_download" name="Secure transfer: download page">
        <t t-out="doctype"/>
        <html t-att-lang="(locale or 'fr_CA')[:2]">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <!-- The subject deliberately stays OUT of the tab title: this
                     same <head> is rendered by the password and code gates,
                     and a forwarded link should not spill the sender's subject
                     to whoever holds it before the gate is passed. It is shown
                     in the card below, which only renders once the gates are
                     through. -->
                <title><t t-esc="st_txt['shared_files'] if transfer.file_count else st_txt['secure_message']"/> — <t t-esc="visuals['name']"/></title>
                <link t-if="visuals['favicon_url']" rel="icon" t-att-href="visuals['favicon_url']"/>
                <link rel="stylesheet" href="/bf_securetransfer/static/src/css/st_public.css"/>
                <t t-call="bf_securetransfer.brand_style"/>
            </head>
            <body>
                <main class="st-wrap">
                    <header class="st-header">
                        <img t-if="visuals['logo_url']" class="st-logo"
                             t-att-src="visuals['logo_url']" t-att-alt="visuals['name']"/>
                        <span class="st-brand-name"><t t-esc="visuals['name']"/></span>
                    </header>

                    <div t-if="reported" class="st-notice" style="max-width:560px; width:100%;">
                        Thank you, your report was forwarded to the team.</div>

                    <!-- Password gate -->
                    <t t-if="locked">
                        <section class="st-card st-gate">
                            <span class="st-gate-icon" aria-hidden="true">&#128274;</span>
                            <h1 class="st-title">Protected transfer</h1>
                            <p>This transfer is password-protected. The sender has given it to you separately.</p>
                            <div t-if="pw_error == '2'" class="st-error">
                                Too many attempts. Try again in a few minutes.</div>
                            <div t-elif="pw_error" class="st-error">
                                Incorrect password.</div>
                            <form method="post" t-attf-action="/s/#{token}/unlock">
                                <input type="password" id="st-password-input" name="password"
                                       required="required" autocomplete="off"
                                       aria-label="Password"/>
                                <button type="submit" class="st-btn st-btn-primary">Unlock</button>
                            </form>
                        </section>
                    </t>

                    <!-- Recipient OTP gate (tenant setting) -->
                    <t t-elif="otp_stage">
                        <section class="st-card st-gate">
                            <span class="st-gate-icon" aria-hidden="true">&#128231;</span>
                            <h1 class="st-title">Code verification</h1>
                            <div t-if="otp_error == '2'" class="st-error">
                                Too many attempts. Try again in a few minutes.</div>
                            <div t-elif="otp_error" class="st-error">
                                Invalid code or address.</div>
                            <t t-if="otp_stage == 'verify'">
                                <p t-if="identity_label">A 6-digit code has just been sent to <strong t-esc="identity_label"/>. Enter it to reach this content.</p>
                                <p t-else="">A 6-digit code has just been sent to you. Enter it to reach this content.</p>
                                <!-- Le défi vit dans la session (st_otp_chal_*),
                                     pas sur le transfert : un code demandé ici
                                     ne s'ouvre qu'ici. Sans cette phrase, le
                                     destinataire qui ouvre le lien sur son
                                     téléphone et lit le code sur son ordinateur
                                     se heurte à un refus incompréhensible. -->
                                <p class="st-field-hint">Enter it in <strong>this browser</strong>: the code is only valid for the request made here. If you open the link elsewhere, simply ask for a new one.</p>
                                <form method="post" t-attf-action="/s/#{token}/otp-verify">
                                    <input type="text" id="st-otp-input" name="code"
                                           inputmode="numeric" pattern="[0-9]*" maxlength="6"
                                           required="required" autocomplete="one-time-code"
                                           aria-label="Verification code"/>
                                    <button type="submit" class="st-btn st-btn-primary">Verify</button>
                                </form>
                                <form method="post" t-attf-action="/s/#{token}/otp-request" class="st-report">
                                    <input type="hidden" name="email"/>
                                    <button type="submit" class="st-btn-link">Send a new code</button>
                                </form>
                            </t>
                            <!-- Audience ouverte : le lien ne nomme personne, donc
                                 la question n'est plus « prouvez que vous êtes
                                 l'un des destinataires » mais « dites-nous qui
                                 vous êtes ». Le code part sur le moyen choisi
                                 ICI : c'est la seule forme qui atteste quelque
                                 chose. Deux formulaires distincts plutôt qu'un
                                 sélecteur — la page de téléchargement doit
                                 fonctionner sans JavaScript. -->
                            <t t-elif="audience_open">
                                <p>This link is not addressed to anyone in particular. To access the content, identify yourself: a one-time code will be sent to you, and confirming it opens access.</p>
                                <form method="post" t-attf-action="/s/#{token}/otp-request">
                                    <input type="hidden" name="kind" value="email"/>
                                    <input type="email" id="st-otp-email" name="identity"
                                           required="required" autocomplete="email"
                                           placeholder="you@example.com"
                                           aria-label="Your email address"/>
                                    <button type="submit" class="st-btn st-btn-primary">Get a code by email</button>
                                </form>
                                <t t-if="audience_sms">
                                    <p class="st-field-hint" style="margin:14px 0 6px;">or</p>
                                    <form method="post" t-attf-action="/s/#{token}/otp-request">
                                        <input type="hidden" name="kind" value="sms"/>
                                        <input type="tel" id="st-otp-phone" name="identity"
                                               required="required" autocomplete="tel"
                                               placeholder="514 555-1234"
                                               aria-label="Your mobile number"/>
                                        <button type="submit" class="st-btn st-btn-primary">Get a code by SMS</button>
                                    </form>
                                </t>
                                <p class="st-field-hint">The code is sent to the contact you enter here. Your identity is recorded in this transfer's access log.</p>
                            </t>
                            <t t-else="">
                                <p>To reach this content, confirm your email address (the one the link was sent to). A verification code will then be sent to you (by email or text message).</p>
                                <form method="post" t-attf-action="/s/#{token}/otp-request">
                                    <input type="email" id="st-otp-email" name="email"
                                           required="required" autocomplete="email"
                                           placeholder="you@example.com"
                                           aria-label="Your email address"/>
                                    <button type="submit" class="st-btn st-btn-primary">Send me a code</button>
                                </form>
                            </t>
                        </section>
                    </t>

                    <!-- Files (or message-only) -->
                    <t t-else="">
                        <section class="st-card">
                            <!-- The sender's subject becomes the page title
                                 when they wrote one: it is the whole point of
                                 the field. The generic label stays above it,
                                 so « files » vs « secure message » is still
                                 legible at a glance. -->
                            <t t-if="transfer.subject">
                                <p class="st-eyebrow"
                                   t-esc="st_txt['shared_files'] if files else st_txt['secure_message']"/>
                                <h1 class="st-title" t-esc="transfer.subject"/>
                            </t>
                            <h1 t-else="" class="st-title"
                                t-esc="st_txt['shared_files'] if files else st_txt['secure_message']"/>
                            <p class="st-download-meta">
                                From
                                <strong t-esc="transfer.sender_name or transfer.sender_email"/>
                                <t t-if="transfer.sender_name">
                                    (<t t-esc="transfer.sender_email"/>)</t>
                            </p>
                            <p t-if="transfer.message" class="st-download-message"
                               t-esc="transfer.message"/>
                            <!-- Audience ouverte : le visiteur doit voir sous quelle
                                 identité il est entré (c'est elle qui sera estampée
                                 sur les PDF) et ce qu'il lui reste. Rien de tout cela
                                 n'a de sens en mode destinataires nommés. -->
                            <p t-if="audience_open and identity_label" class="st-field-hint">
                                Access confirmed for <strong t-esc="identity_label"/>.
                                <t t-if="downloads_left is not None">
                                    Downloads left for you:
                                    <strong t-esc="downloads_left"/>.
                                </t>
                            </p>
                            <div t-foreach="files" t-as="f" class="st-download-file">
                                <div class="st-file-info">
                                    <span class="st-file-name" t-esc="f.filename"/>
                                    <span class="st-file-size"
                                          t-esc="st_size(f.size)"/>
                                </div>
                                <a class="st-btn st-btn-primary"
                                   t-attf-href="/s/#{token}/dl/#{f.id}"
                                   rel="nofollow noopener">Download</a>
                            </div>
                            <p class="st-expiry-note" t-if="expiry_display">
                                Available until <strong t-esc="expiry_display"/>. The files are then deleted permanently.</p>
                        </section>
                    </t>

                    <!-- ⚠ Le signalement vit HORS des branches ci-dessus, et
                         c'est le point : il était imbriqué dans la branche
                         « contenu », donc il n'apparaissait qu'une fois les
                         portes franchies. Or un envoi non sollicité se signale
                         AVANT de l'ouvrir — et un transfert protégé par un code
                         destinataire (tout envoi composé depuis le backend l'est)
                         ne montrait jamais le lien, puisqu'on n'atteint la page
                         de contenu qu'en réclamant un code. Le destinataire d'un
                         message indésirable n'avait donc aucun recours, sauf à
                         jouer le jeu de l'expéditeur.
                         La route /report ne dépend d'aucune de ces portes : elle
                         exige le jeton du lien, est limitée à 5 par jour et par
                         IP, et suspend le transfert en attente de revue. -->
                    <form method="post" t-attf-action="/s/#{token}/report"
                          id="st-report-form" class="st-report"
                          t-att-data-confirm="st_txt['report_confirm']">
                        <button type="submit" class="st-btn-link">Report abuse</button>
                    </form>

                    <footer class="st-footer">
                        <span t-if="visuals['tagline']" class="st-tagline" t-esc="visuals['tagline']"/>
                        <span t-if="visuals['powered_by']" class="st-powered">
                            Powered by <t t-esc="visuals['powered_by_name']"/></span>
                    </footer>
                </main>
                <script src="/bf_securetransfer/static/src/js/st_download.js"></script>
            </body>
        </html>
    </template>

    <!-- ============================================================= -->
    <!-- Neutral unavailable page — same body for expired, purged,      -->
    <!-- suspended, unknown or draft tokens: no metadata leaks.         -->
    <!-- ============================================================= -->
    <template id="page_unavailable" name="Secure transfer: unavailable page">
        <t t-out="doctype"/>
        <html t-att-lang="(locale or 'fr_CA')[:2]">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title><t t-esc="visuals['name']"/></title>
                <link t-if="visuals['favicon_url']" rel="icon" t-att-href="visuals['favicon_url']"/>
                <link rel="stylesheet" href="/bf_securetransfer/static/src/css/st_public.css"/>
                <t t-call="bf_securetransfer.brand_style"/>
            </head>
            <body>
                <main class="st-wrap">
                    <header class="st-header">
                        <img t-if="visuals['logo_url']" class="st-logo"
                             t-att-src="visuals['logo_url']" t-att-alt="visuals['name']"/>
                        <span class="st-brand-name"><t t-esc="visuals['name']"/></span>
                    </header>

                    <section class="st-card st-unavailable">
                        <span class="st-unavailable-icon" aria-hidden="true">&#8709;</span>
                        <p class="st-unavailable-title">This transfer is no longer available</p>
                        <p t-if="message" t-esc="message"/>
                        <p t-else="">The link may have expired, or the address may be mistyped. If needed, ask the sender to create a new transfer.</p>
                    </section>

                    <footer class="st-footer">
                        <span t-if="visuals['tagline']" class="st-tagline" t-esc="visuals['tagline']"/>
                        <span t-if="visuals['powered_by']" class="st-powered">
                            Powered by <t t-esc="visuals['powered_by_name']"/></span>
                    </footer>
                </main>
            </body>
        </html>
    </template>

</odoo>
