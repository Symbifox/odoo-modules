<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu — Top-level application -->
    <menuitem id="menu_meeting_root"
              name="Rencontres"
              web_icon="bf_meeting,static/description/icon.png"
              sequence="35"/>

    <!-- Comptes rendus -->
    <menuitem id="menu_meeting_records"
              name="Comptes rendus"
              parent="menu_meeting_root"
              sequence="10"/>
    <menuitem id="menu_meeting_records_all"
              name="Tous les comptes rendus"
              parent="menu_meeting_records"
              action="meeting_record_action"
              groups="group_meeting_user"
              sequence="10"/>
    <menuitem id="menu_meeting_records_draft"
              name="Brouillons"
              parent="menu_meeting_records"
              action="meeting_record_action_draft"
