<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Format Lettre : c'est celui des documents d'affaires et des actes au
         Québec. Le règlement ne dit rien du format, mais une attestation qui
         se classe avec l'acte de vente a intérêt à en avoir la taille. -->
    <record id="paperformat_attestation" model="report.paperformat">
        <field name="name">Attestation du syndicat (Lettre)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_attestation" model="ir.actions.report">
        <field name="name">Attestation du syndicat</field>
        <field name="model">bf.property.attestation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_property_loi16.report_attestation</field>
        <field name="report_file">bf_property_loi16.report_attestation</field>
        <field name="print_report_name">'Attestation_%s_%s' % ((object.unit_id.display_name or '').replace(' ', '_'), object._report_date())</field>
        <field name="binding_model_id" ref="model_bf_property_attestation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_attestation"/>
    </record>

</odoo>
