msgstr "Federated with"

#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_federation_outbox__kind
msgid "Genre"
msgstr "Kind"

#. module: bf_federation_gantt
#: model_terms:ir.ui.view,arch_db:bf_federation_gantt.view_bf_gantt_plan_form_federation
msgid "L'échéancier repart de lui-même quand une ligne bouge. Ce bouton                               le renvoie tel qu'il est, même s'il n'a pas changé."
msgstr "The schedule is sent again on its own when a line moves. This button sends it as it is, even if it has not changed."

#. module: bf_federation_gantt
#: model:ir.model.fields,help:bf_federation_gantt.field_bf_gantt_plan__federation_peer_id
msgid "Le pair chez qui cet objet a un miroir. Vider le champ archive le miroir."
msgstr "The peer where this object has a mirror. Clearing the field archives the mirror."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "Les lignes de cet échéancier sont reçues de %s : elles se lisent ici."
msgstr "The lines of this schedule are received from %s: they are read-only here."

#. module: bf_federation_gantt
#: model:ir.model.fields,field_description:bf_federation_gantt.field_bf_gantt_plan__federation_link_id
msgid "Lien fédéré"
