<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Backup Report Email Template -->
        <record id="email_template_backup_report" model="mail.template">
            <field name="name">Hébergement : Rapport de sauvegarde</field>
            <field name="model_id" ref="model_hosting_backup_run"/>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ (object.company_id.email or '') }}</field>
            <field name="subject">{{ '[ERREUR]' if object.state == 'failed' else '[PARTIEL]' if object.state == 'partial' else '[AVERTISSEMENT]' if object.state == 'warning' else '[OK]' }} Rapport de sauvegarde - {{ object.name }} - {{ object.run_date.strftime('%Y-%m-%d') }}</field>
            <field name="body_html" type="html">

<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F8FAFC;">
  <tbody>
    <tr>
      <td align="center" style="padding:24px;">
        <table cellspacing="0" cellpadding="0" border="0" width="100%" align="center" role="presentation">
          <tbody>
            <tr>
              <td>
                <br/><br/>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="700" style="margin:0 auto;background-color:#ffffff;border-radius:12px;border:1px solid #e5e7eb;max-width:700px;">
                  <tbody>
                    <!-- Header -->
                    <tr>
                      <td t-attf-style="background-color:{{ brand_dark }};padding:16px 24px;border-radius:12px 12px 0 0;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                          <tbody>
                            <tr>
                              <td align="left" style="color:#FFFFFF;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:600;">
                                <a t-attf-href="{{ company.website or 'https://bluefoxconsultant.com' }}" style="text-decoration:none;">
                                  <img t-attf-src="/web/image/res.company/{{ company.id }}/logo" t-att-alt="company.name or 'Logo'" style="height:48px;width:auto;display:block;" height="48"/>
                                </a>
                              </td>
                              <td align="right" style="color:#E6EDF3;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:22px;font-weight:800;">
                                Rapport de sauvegarde
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>

                    <!-- Accent bar -->
                    <tr>
                      <td t-attf-style="height:4px;line-height:4px;background-color:{{ brand_primary }};">&amp;nbsp;</td>
                    </tr>

                    <!-- Content -->
                    <tr>
                      <td style="padding:24px;">
                        <h1 t-attf-style="margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:24px;line-height:32px;color:{{ brand_dark }};font-weight:500;">
                          Rapport quotidien des sauvegardes
                        </h1>
                        <p style="margin:0 0 16px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:17px;line-height:26px;color:#374151;font-weight:300;">
                          Exécuté le <t t-out="object.run_date.strftime('%Y-%m-%d %H:%M:%S')"/> sur <t t-out="object.hostname or 'serveur inconnu'"/>
                        </p>

                        <!-- Status summary -->
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-radius:10px;margin-bottom:20px;">
                          <tbody>
                            <tr>
                              <td t-attf-style="padding:16px;border-radius:10px;border:1px solid {{ '#FECACA' if object.state == 'failed' else '#FDE68A' if object.state == 'partial' else '#BFDBFE' if object.state == 'warning' else '#A7F3D0' }};background-color:{{ '#FEE2E2' if object.state == 'failed' else '#FEF3C7' if object.state == 'partial' else '#DBEAFE' if object.state == 'warning' else '#D1FAE5' }};">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                  <tbody>
                                    <tr>
                                      <td t-attf-style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;font-weight:600;color:{{ '#DC2626' if object.state == 'failed' else '#D97706' if object.state == 'partial' else '#1D4ED8' if object.state == 'warning' else '#059669' }};">
                                        <t t-if="object.state == 'failed'">ERREURS DÉTECTÉES</t>
                                        <t t-elif="object.state == 'partial'">SUCCÈS PARTIEL — DONNÉES MANQUANTES</t>
                                        <t t-elif="object.state == 'warning'">TOUS LES BACKUPS RÉUSSIS (avec avertissements)</t>
                                        <t t-else="">TOUS LES BACKUPS RÉUSSIS</t>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td style="padding-top:8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#374151;">
                                        <strong style="color:#059669;"><t t-out="object.success_count"/></strong> réussis |
                                        <strong style="color:#1D4ED8;"><t t-out="object.warning_count"/></strong> avert. |
                                        <strong style="color:#DC2626;"><t t-out="object.failed_count"/></strong> échoués |
                                        <strong style="color:#D97706;"><t t-out="object.skipped_count"/></strong> ignorés |
                                        <strong><t t-out="object.total_count"/></strong> total
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <!-- Backup details table -->
                        <h2 t-attf-style="margin:24px 0 12px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;color:{{ brand_dark }};font-weight:500;">
                          Détails des sauvegardes
                        </h2>
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border:1px solid #E5E7EB;border-radius:8px;border-collapse:separate;">
                          <thead>
                            <tr style="background-color:#F9FAFB;">
                              <th style="padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;">Service</th>
                              <th style="padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;">Statut</th>
                              <th style="padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;">Archives</th>
                              <th style="padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;">Fichiers</th>
                              <th style="padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;">Durée</th>
                            </tr>
                          </thead>
                          <tbody>
                            <t t-foreach="object.line_ids" t-as="line">
                              <tr style="border-bottom:1px solid #E5E7EB;">
                                <td t-attf-style="padding:12px 8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;font-weight:600;color:{{ brand_dark }};vertical-align:top;">
                                  <t t-out="line.service_name"/>
                                </td>
                                <td style="padding:12px 8px;vertical-align:top;">
                                  <span t-attf-style="display:inline-block;padding:4px 8px;border-radius:4px;font-size:12px;font-weight:600;background-color:{{ '#D1FAE5' if line.status == 'success' else '#FEE2E2' if line.status == 'failed' else '#FEF3C7' }};color:{{ '#059669' if line.status == 'success' else '#DC2626' if line.status == 'failed' else '#D97706' }};">
                                    <t t-if="line.status == 'success'">OK</t>
                                    <t t-elif="line.status == 'failed'">ÉCHEC</t>
                                    <t t-else="">IGNORÉ</t>
                                  </span>
                                </td>
                                <td style="padding:12px 8px;vertical-align:top;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:13px;">
                                  <t t-if="line.report_type == 'restic'">
                                    <t t-if="line.snapshot_count > 0">
                                      <span style="font-weight:600;color:#059669;">
                                        <t t-out="line.snapshot_count"/>
                                      </span>
                                      <span style="color:#6B7280;font-size:11px;"> snapshot<t t-if="line.snapshot_count > 1">s</t></span>
                                    </t>
                                    <t t-else="">
                                      <span style="color:#9CA3AF;">-</span>
                                    </t>
                                  </t>
                                  <t t-elif="line.container_count > 0">
                                    <span t-attf-style="font-weight:600;color:{{ '#059669' if line.verified_file_count >= line.container_count else '#DC2626' }};">
                                      <t t-out="line.verified_file_count"/>/<t t-out="line.container_count"/>
                                    </span>
                                    <span style="color:#6B7280;font-size:11px;"> vérifiées</span>
                                  </t>
                                  <t t-elif="line.verified_file_count > 0">
                                    <span style="font-weight:600;color:#059669;"><t t-out="line.verified_file_count"/></span>
                                    <span style="color:#6B7280;font-size:11px;"> vérifiées</span>
                                  </t>
                                  <t t-else="">
                                    <span style="color:#9CA3AF;">-</span>
                                  </t>
                                </td>
                                <td style="padding:12px 8px;vertical-align:top;">
                                  <t t-if="line.report_type == 'restic'">
                                    <t t-foreach="line.snapshot_ids" t-as="snap">
                                      <div style="font-size:12px;color:#374151;margin-top:4px;">
                                        <span style="color:#059669;font-weight:bold;">✓</span>
                                        <t t-out="snap.container or snap.destination or '?'"/><br/>
                                        <span style="color:#9CA3AF;font-size:11px;">
                                          <t t-out="snap.files_new"/> fichiers ajoutés · <t t-out="snap.data_added_human"/>
                                        </span>
                                      </div>
                                    </t>
                                    <t t-if="not line.snapshot_ids">
                                      <span style="color:#9CA3AF;font-size:12px;">Aucun snapshot</span>
                                    </t>
                                  </t>
                                  <t t-else="">
                                    <t t-foreach="line.file_ids" t-as="file">
                                      <div style="font-size:12px;color:#374151;margin-top:4px;">
                                        <span t-attf-style="color:{{ '#059669' if file.verified else '#DC2626' }};font-weight:bold;">
                                          <t t-if="file.verified">✓</t>
                                          <t t-else="">✗</t>
                                        </span>
                                        <t t-out="file.name"/><br/>
                                        <span style="color:#9CA3AF;font-size:11px;">
                                          SHA256: <t t-out="(file.checksum or '')[:16]"/>... | Taille: <t t-out="file.size"/>
                                        </span>
                                      </div>
                                    </t>
                                    <t t-if="not line.file_ids">
                                      <span style="color:#9CA3AF;font-size:12px;">Aucun fichier</span>
                                    </t>
                                  </t>
                                  <t t-if="line.error_message">
                                    <div style="color:#DC2626;font-size:12px;margin-top:4px;">
                                      <t t-out="line.error_message"/>
                                    </div>
                                  </t>
                                </td>
                                <td style="padding:12px 8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#6B7280;vertical-align:top;">
                                  <t t-out="line.duration"/>
                                </td>
                              </tr>
                            </t>
                          </tbody>
                        </table>

                        <p style="margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:13px;line-height:20px;color:#6B7280;">
                          En cas de problème, contactez
                          <a t-attf-href="mailto:{{ company.email or '' }}" t-attf-style="color:{{ brand_primary }};text-decoration:none;"><t t-out="company.email or ''"/></a>
                        </p>
                      </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                      <td style="height:1px;line-height:1px;background-color:#E5E7EB;">&amp;nbsp;</td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                      <td style="padding:16px 24px 24px 24px;background-color:#FFFFFF;border-radius:0 0 12px 12px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                          <tbody>
                            <tr>
                              <td style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#6B7280;">
                                <strong t-attf-style="color:{{ brand_dark }};"><t t-out="company.name or 'Blue Fox'"/></strong><br/>
                                Rapport généré automatiquement par votre module d'hébergement.
                              </td>
                              <td align="right" style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#9CA3AF;">
                                <a t-attf-href="{{ company.website or 'https://bluefoxconsultant.com' }}/r/politique-de-confidentialite" style="color:#9ca3af;text-decoration:underline;">Politique de confidentialité</a>
                                <span style="color:#9CA3AF;"> | </span>
                                <a t-attf-href="{{ company.website or 'https://bluefoxconsultant.com' }}/r/termes-et-conditions" style="color:#9ca3af;text-decoration:underline;">Termes et conditions</a>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                  </tbody>
                </table>

                <!-- Bottom accent -->
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="700" style="margin:12px auto 0;">
                  <tbody>
                    <tr>
                      <td t-attf-style="height:3px;line-height:3px;background-color:{{ brand_primary }};width:50%;">&amp;nbsp;</td>
                      <td t-attf-style="height:3px;line-height:3px;background-color:{{ brand_dark }};width:50%;">&amp;nbsp;</td>
                    </tr>
                  </tbody>
                </table>

              </td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
  </tbody>
</table>
            </field>
        </record>

    </data>
</odoo>
