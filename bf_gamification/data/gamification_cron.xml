<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_update_streaks" model="ir.cron">
            <field name="name">Fox Quest : mise &#224; jour des streaks</field>
            <field name="model_id" ref="model_bf_gamification_profile"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_streaks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_check_badges" model="ir.cron">
            <field name="name">Fox Quest : v&#233;rification des badges</field>
            <field name="model_id" ref="model_bf_gamification_profile"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_badges()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
