#. module: bf_school_attendance
#: model:mail.template,body_html:bf_school_attendance.mail_template_unjustified_absence
msgid ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The school notes an absence for <strong t-out=\"object.student_id.name or ''\"/> today (<t t-out=\"object.session_id._slot_label() or ''\"/>), with no reason known.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">If you know about this absence, please justify it in the family portal. If not, call the school office now.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/attendance\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Justify the absence\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">L'école note une absence pour <strong t-out=\"object.student_id.name or ''\"/> aujourd'hui (<t t-out=\"object.session_id._slot_label() or ''\"/>), sans motif connu.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Si vous êtes au courant de cette absence, motivez-la dans le portail des familles. Sinon, appelez le secrétariat dès maintenant.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/attendance\" style=\"background-color:#875A7B;color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Motiver l'absence\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

