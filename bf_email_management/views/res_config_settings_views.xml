<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action: open the user's IMAP account list (replaces the legacy
         global settings page now that the module is per-user). -->
    <record id="action_bf_email_settings" model="ir.actions.act_window">
        <field name="name">Mes comptes IMAP</field>
        <field name="res_model">bf.email.account</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

    <!-- Réglages d'organisation. Le reste de la configuration du
         module est par usager et vit sous Courriels → Configuration ; ce qui
         est ici engage toute la base, donc `base.group_system`. -->
    <record id="res_config_settings_view_form_bf_email" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf_email_management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Gestion des courriels"
                     string="Gestion des courriels"
                     name="bf_email_management"
                     groups="base.group_system">
                    <block title="Bo&#238;te de r&#233;ception"
                           name="bf_email_inbox_setting_container">
                        <setting id="bf_email_show_imap_folders_setting"
                                 string="Dossiers IMAP dans la bo&#238;te de r&#233;ception"
                                 help="Les vrais dossiers du serveur apparaissent sous la bo&#238;te de r&#233;ception. Le contenu affich&#233; reste les courriels de cette base, avec leurs actions et leur lien vers la fiche o&#249; ils sont class&#233;s.">
                            <field name="bf_email_show_imap_folders"/>
                            <div class="content-group"
                                 invisible="not bf_email_show_imap_folders">
                                <div class="row mt16">
                                    <label for="bf_email_folder_cache_minutes"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="bf_email_folder_cache_minutes"
                                           class="col-lg-2"/>
                                </div>
                                <div class="mt8">
                                    <button type="object"
                                            name="action_bf_email_refresh_imap_folders"
                                            string="Relever mes dossiers maintenant"
                                            icon="fa-refresh"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="bf_email_signature_placement_setting"
                                 string="O&#249; vit la signature"
                                 help="Dans le brouillon : &#233;crite dans le corps d&#232;s l'ouverture du composeur, donc visible en &#233;crivant et dans la copie gard&#233;e au chatter. &#192; l'envoi seulement : le corps reste nu et la signature est pos&#233;e au rendu, juste avant la citation. Dans les deux cas le destinataire en re&#231;oit une seule.">
                            <field name="bf_email_signature_placement" widget="radio"/>
                        </setting>
                        <setting id="bf_email_popup_enabled_setting"
                                 string="Avis &#224; l'arriv&#233;e d'un courriel"
                                 help="Autorise l'avis qui s'affiche dans Odoo &#224; l'arriv&#233;e d'un courriel. Chacun r&#232;gle ensuite le sien sur ses comptes IMAP : &#233;ph&#233;m&#232;re, persistant, ou aucun. D&#233;coch&#233; par d&#233;faut, y compris apr&#232;s la mise &#224; jour.">
                            <field name="bf_email_popup_enabled"/>
                        </setting>
                        <setting id="bf_email_gen_enabled_setting"
                                 string="Assistance de Gen dans la bo&#238;te"
                                 help="Ajoute «&#160;R&#233;sumer le fil&#160;» et «&#160;Proposer une r&#233;ponse&#160;». Le texte est rendu &#224; l'&#233;cran et n'est jamais &#233;crit sur la ligne. D&#233;coch&#233; par d&#233;faut&#160;: envoyer du courrier de client &#224; un mod&#232;le est une communication &#224; un tiers.">
                            <field name="bf_email_gen_enabled"/>
                        </setting>
                        <setting id="bf_email_block_remote_images_setting"
                                 string="Bloquer les images distantes &#224; la lecture"
                                 help="Une image charg&#233;e depuis le serveur de l'exp&#233;diteur lui annonce la lecture, l'heure et l'adresse IP. Coch&#233; par d&#233;faut, y compris apr&#232;s la mise &#224; jour : le d&#233;faut d'une protection est la protection. Un bouton « Afficher les images » reste disponible sur chaque message.">
                            <field name="bf_email_block_remote_images"/>
                        </setting>
                        <setting id="bf_email_dnd_enabled_setting"
                                 string="Mode &#171;&#160;ne pas d&#233;ranger&#160;&#187;"
                                 help="Retient les avis pendant les rencontres, sur interrupteur manuel, ou aux heures calmes. Rien n'est jet&#233; : un seul r&#233;sum&#233; sort &#224; la fin. Chacun r&#232;gle ce qui l'arme dans ses pr&#233;f&#233;rences. D&#233;coch&#233; par d&#233;faut, y compris apr&#232;s la mise &#224; jour.">
                            <field name="bf_email_dnd_enabled"/>
                        </setting>
                    </block>
                    <block title="Comptes OAuth (Microsoft, Google)"
                           name="bf_email_oauth_block">
                        <div class="text-muted mb-3">
                            Microsoft refuse tout mot de passe sur IMAP depuis
                            la fin de l'authentification de base : son serveur
                            r&#233;pond &#171;&#160;Basic authentication is disabled&#160;&#187;.
                            Sans inscription d'application ici, aucune bo&#238;te
                            Microsoft ne peut &#234;tre branch&#233;e. Chez Google, le mot
                            de passe d'application suffit et reste le chemin
                            recommand&#233;.
                        </div>
                        <setting id="bf_email_oauth_redirect_setting"
                                 string="URL de retour &#224; d&#233;clarer"
                                 help="&#192; coller telle quelle dans l'inscription d'application, chez Microsoft comme chez Google.">
                            <field name="bf_email_oauth_redirect_uri" readonly="1"/>
                        </setting>
                        <setting id="bf_email_oauth_microsoft_setting"
                                 string="Microsoft (Entra)"
                                 help="Autorisations d&#233;l&#233;gu&#233;es&#160;: IMAP.AccessAsUser.All, SMTP.Send, offline_access.">
                            <field name="bf_email_oauth_microsoft_client_id"/>
                            <field name="bf_email_oauth_microsoft_client_secret" password="True"/>
                        </setting>
                        <setting id="bf_email_oauth_google_setting"
                                 string="Google"
                                 help="Facultatif. La port&#233;e mail.google.com est restreinte&#160;: au-del&#224; de cent usagers, Google exige une &#233;valuation de s&#233;curit&#233; CASA, factur&#233;e chaque ann&#233;e.">
                            <field name="bf_email_oauth_google_client_id"/>
                            <field name="bf_email_oauth_google_client_secret" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
