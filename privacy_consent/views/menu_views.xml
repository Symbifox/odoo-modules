              parent="menu_privacy_libresign"
              action="action_privacy_libresign_config"
              sequence="10"/>

    <menuitem id="menu_privacy_libresign_templates"
              name="Modèles"
              parent="menu_privacy_libresign"
              action="action_privacy_libresign_template"
              sequence="20"/>
