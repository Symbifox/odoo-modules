<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bf_outreach_exclude_wizard_form" model="ir.ui.view">
        <field name="name">bf.outreach.exclude.wizard.form</field>
        <field name="model">bf.outreach.exclude.wizard</field>
        <field name="arch" type="xml">
            <form string="Do not contact">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        The exclusion applies to every campaign, present and future. It is also set on the linked Odoo contact, if there is one.
                    </div>
                    <group>
                        <field name="reason" placeholder="What the person asked for, in their own words"/>
                        <field name="kind"/>
                        <field name="log_touch"/>
                    </group>
                    <group>
                        <field name="target_ids" widget="many2many_tags"
                               invisible="not target_ids" readonly="1"/>
                        <field name="partner_ids" widget="many2many_tags"
                               invisible="not partner_ids" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_exclude" type="object" string="Do not contact"
                            class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
