#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "Échéancier fédéré avec %s : ses lignes, ses couloirs, ses jalons, ses dépendances et leur avancement. Ce qui reste ici : les heures prévues de chaque ligne."
msgstr "Schedule federated with %s: its lines, lanes, milestones, dependencies and their progress. What stays here: the planned hours of each line."

#. module: bf_federation_gantt
#: model:ir.model.fields.selection,name:bf_federation_gantt.selection__federation_outbox__kind__gantt_card
msgid "Échéancier mis à jour"
msgstr "Schedule updated"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
