<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Per-user model (18.0.4.0.0):
      - Anyone with internal user access can configure their own
        bf.email.account rows and consume their own bf.email rows.
      - One owner ir.rule per model with domain_force = [('user_id', '=', user.id)].
      - The migration in migrations/18.0.4.0.0/post-migrate.py dropped the
        legacy group_email_user / group_email_manager records.

      Admin zone (18.0.5.2.0):
      - A dedicated group_email_admin grants READ-ONLY visibility on every
        user's rows (domain_force = [(1, '=', 1)], perm_read only).
      - ir.rule semantics: rules attached to different groups are OR-combined,
        so an admin (also a base.group_user member) sees own OR all = all, while
        a normal user still sees only their own. Write/create/unlink on foreign
        rows stays denied (admin rule is read-only and the owner rule's domain
        excludes them).
      - Membership is NOT shipped in data — assign group_email_admin to humans
        only, never to service accounts (Client.e, Meeting Processor API).
      - 18.0.6.0.0: bf.email.account is EXCLUDED from the admin zone. The
        account row stores the IMAP app password in cleartext; a read-all
        rule would expose every user's credential over RPC (field-level
        password="True" in the view only masks the widget). Admins see all
        emails and rules, never other users' accounts.
    -->

    <data noupdate="1">
        <record id="module_category_email" model="ir.module.category">
            <field name="name">Gestion des courriels</field>
            <field name="sequence">60</field>
        </record>

        <record id="group_email_admin" model="res.groups">
            <field name="name">Administrateur — tous les courriels</field>
            <field name="category_id" ref="module_category_email"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>

    <record id="bf_email_rule_admin_all" model="ir.rule">
        <field name="name">Courriel : admin voit tout (lecture seule)</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_rule_rule_admin_all" model="ir.rule">
        <field name="name">Règle courriel : admin voit tout (lecture seule)</field>
        <field name="model_id" ref="model_bf_email_rule"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_email_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="bf_email_rule_owner" model="ir.rule">
        <field name="name">Courriel : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="bf_email_account_rule_owner" model="ir.rule">
        <field name="name">Compte IMAP : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email_account"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="bf_email_rule_rule_owner" model="ir.rule">
        <field name="name">Règle courriel : visible uniquement au propriétaire</field>
        <field name="model_id" ref="model_bf_email_rule"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
