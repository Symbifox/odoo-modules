<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Withdraw Wizard Form -->
    <record id="privacy_consent_withdraw_wizard_form" model="ir.ui.view">
        <field name="name">privacy.consent.withdraw.wizard.form</field>
        <field name="model">privacy.consent.withdraw.wizard</field>
        <field name="arch" type="xml">
            <form string="Retirer le consentement">
                <group>
                    <group string="Info du consentement">
                        <field name="consent_id" invisible="1"/>
                        <field name="partner_id"/>
                        <field name="purpose_id"/>
                    </group>
                    <group string="Détails du retrait">
                        <field name="withdrawal_reason"/>
                        <field name="update_preferences" widget="boolean_toggle"/>
                    </group>
                </group>
                <separator string="Notes supplémentaires"/>
                <field name="withdrawal_notes" placeholder="Tout détail supplémentaire..."/>
                <footer>
                    <button name="action_withdraw" type="object"
                            string="Retirer le consentement" class="btn-danger"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
