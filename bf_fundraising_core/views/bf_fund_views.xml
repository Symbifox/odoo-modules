<odoo>
    <record id="bf_fund_view_list" model="ir.ui.view">
        <field name="name">bf.fund.list</field>
        <field name="model">bf.fund</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="fund_type" />
                <field name="analytic_account_id" />
                <field name="amount_raised" sum="Total amassé" />
                <field name="donation_count" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="bf_fund_view_form" model="ir.ui.view">
        <field name="name">bf.fund.form</field>
        <field name="model">bf.fund</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_donations"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-gift"
                        >
                            <field
                                name="donation_count"
                                widget="statinfo"
                                string="Dons"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Nom du fonds" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="fund_type" />
                            <field name="analytic_account_id" />
                        </group>
                        <group>
                            <field name="amount_raised" />
                            <field name="active" invisible="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_fund_view_search" model="ir.ui.view">
        <field name="name">bf.fund.search</field>
        <field name="model">bf.fund</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="analytic_account_id" />
                <filter
                    name="unrestricted"
                    string="Non affecté"
                    domain="[('fund_type', '=', 'unrestricted')]"
                />
                <filter
                    name="restricted"
                    string="Affecté"
                    domain="[('fund_type', '=', 'restricted')]"
                />
                <filter
                    name="endowment"
                    string="Dotation"
                    domain="[('fund_type', '=', 'endowment')]"
                />
                <group expand="0" string="Grouper par">
                    <filter
                        name="group_type"
                        string="Type de fonds"
                        context="{'group_by': 'fund_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_fund" model="ir.actions.act_window">
        <field name="name">Fonds</field>
        <field name="res_model">bf.fund</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier fonds</p>
            <p>Un fonds est une désignation (« où va l'argent ») reliée à un
            compte analytique pour la ventilation comptable des dons.</p>
        </field>
    </record>
</odoo>
