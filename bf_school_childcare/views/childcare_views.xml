<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== School settings and periods ===================== -->
    <record id="bf_school_view_form_childcare" model="ir.ui.view">
        <field name="name">bf.school.form.childcare</field>
        <field name="model">bf.school</field>
        <field name="inherit_id" ref="bf_school_core.bf_school_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Child care" name="childcare" groups="bf_school_childcare.group_school_childcare_manager">
                    <group>
                        <group>
                            <field name="childcare_booking_notice_hours"/>
                            <field name="childcare_cancel_notice_hours"/>
                        </group>
                        <group>
                            <field name="childcare_walk_alone_min_age"/>
                            <field name="childcare_manager_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="childcare_slot_ids" context="{'default_school_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="mon"/>
                            <field name="tue"/>
                            <field name="wed"/>
                            <field name="thu"/>
                            <field name="fri"/>
                            <field name="level_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="capacity"/>
                            <field name="grace_minutes"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="bf_school_childcare_slot_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.slot.list</field>
        <field name="model">bf.school.childcare.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="school_id" optional="show" options="{'no_open': True}"/>
                <field name="kind"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="level_ids" widget="many2many_tags"/>
                <field name="capacity"/>
                <field name="grace_minutes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_slot_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.slot.form</field>
        <field name="model">bf.school.childcare.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="After school"/></h1></div>
                    <group>
                        <group>
                            <field name="school_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="kind"/>
                            <label for="start_time" string="Hours"/>
                            <div class="o_row">
                                <field name="start_time" widget="float_time"/>
                                <span>-</span>
                                <field name="end_time" widget="float_time"/>
                            </div>
                            <field name="grace_minutes"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="level_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Days">
                        <group>
                            <field name="mon"/>
                            <field name="tue"/>
                            <field name="wed"/>
                        </group>
                        <group>
                            <field name="thu"/>
                            <field name="fri"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_childcare_slot_action" model="ir.actions.act_window">
        <field name="name">Periods</field>
        <field name="res_model">bf.school.childcare.slot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No child care period yet</p>
            <p>Before school, lunch time, after school, and the days without class: hours, days, levels and places.</p>
        </field>
    </record>

    <!-- ===================== Daily sheets ===================== -->
    <record id="bf_school_childcare_sheet_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.sheet.list</field>
        <field name="model">bf.school.childcare.sheet</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'">
                <field name="date"/>
                <field name="slot_id" options="{'no_open': True}"/>
                <field name="school_id" optional="hide" options="{'no_open': True}"/>
                <field name="expected_count"/>
                <field name="present_count"/>
                <field name="absent_count"/>
                <field name="departed_count"/>
                <field name="user_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_sheet_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.sheet.form</field>
        <field name="model">bf.school.childcare.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh" type="object" string="Refresh" icon="fa-refresh"
                            invisible="state != 'open' or not id"/>
                    <button name="action_close" type="object" string="Close the sheet" class="btn-primary"
                            invisible="state != 'open' or not id"
                            confirm="Close the sheet? Every child must have left."/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'closed'"
                            groups="bf_school_childcare.group_school_childcare_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="slot_id" readonly="id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="date" readonly="id"/>
                            <field name="slot_kind" invisible="1"/>
                        </group>
                        <group>
                            <field name="expected_count"/>
                            <field name="present_count"/>
                            <field name="departed_count"/>
                            <field name="absent_count"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'open'" context="{'default_sheet_id': id}">
                        <list editable="bottom" delete="0" decoration-muted="presence == 'absent'"
                              decoration-success="departed_on">
                            <field name="student_id" readonly="id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="origin" widget="badge" readonly="1"
                                   decoration-warning="origin == 'walk_in'" decoration-info="origin == 'booking'"/>
                            <field name="presence" widget="badge" readonly="1"
                                   decoration-success="presence == 'present'" decoration-muted="presence == 'absent'"/>
                            <field name="alert" readonly="1" decoration-danger="alert"/>
                            <field name="has_restriction" column_invisible="True"/>
                            <field name="restriction_names" readonly="1" decoration-danger="has_restriction"
                                   string="Must not pick up"/>
                            <field name="permitted_summary" readonly="1" optional="show"/>
                            <field name="arrived_time" readonly="1"/>
                            <field name="departed_time" readonly="1"/>
                            <field name="departure_label" readonly="1"/>
                            <field name="late_minutes" readonly="1" optional="show"/>
                            <field name="arrived_on" column_invisible="True"/>
                            <field name="departed_on" column_invisible="True"/>
                            <button name="action_arrive" type="object" string="Arrival" icon="fa-sign-in"
                                    class="btn-primary" invisible="arrived_on or not id"/>
                            <button name="action_absent" type="object" string="Absent" icon="fa-user-times"
                                    invisible="arrived_on or presence == 'absent' or not id"/>
                            <button name="action_departure" type="object" string="Departure" icon="fa-sign-out"
                                    class="btn-primary" invisible="not arrived_on or departed_on"/>
                            <button name="action_to_class" type="object" string="To class" icon="fa-graduation-cap"
                                    invisible="not arrived_on or departed_on or parent.slot_kind not in ('before', 'noon')"/>
                            <button name="action_remove" type="object" string="Remove" icon="fa-trash"
                                    title="Added by mistake" invisible="origin != 'walk_in' or departed_on or not id"
                                    confirm="Remove this child, added by mistake, from the sheet?"/>
                        </list>
                        <kanban class="o_kanban_mobile">
                            <field name="presence"/>
                            <field name="arrived_on"/>
                            <field name="departed_on"/>
                            <field name="has_restriction"/>
                            <field name="origin"/>
                            <templates>
                                <t t-name="card">
                                    <div class="d-flex justify-content-between">
                                        <field name="student_id" class="fw-bold"/>
                                        <field name="presence" widget="badge"/>
                                    </div>
                                    <field name="alert" class="text-danger"/>
                                    <div t-if="record.has_restriction.raw_value" class="text-danger">
                                        Must not pick up: <field name="restriction_names"/>
                                    </div>
                                    <div class="text-muted small">May pick up: <field name="permitted_summary"/></div>
                                    <div class="small">
                                        <span t-if="record.arrived_on.raw_value">Arrival <field name="arrived_time"/></span>
                                        <span t-if="record.departed_on.raw_value"> · Departure <field name="departed_time"/>,
                                            <field name="departure_label"/></span>
                                    </div>
                                    <div class="d-flex gap-1 mt-1">
                                        <button name="action_arrive" type="object" string="Arrival" class="btn btn-sm btn-primary"
                                                invisible="arrived_on"/>
                                        <button name="action_absent" type="object" string="Absent" class="btn btn-sm btn-secondary"
                                                invisible="arrived_on or presence == 'absent'"/>
                                        <button name="action_departure" type="object" string="Departure" class="btn btn-sm btn-primary"
                                                invisible="not arrived_on or departed_on"/>
                                        <button name="action_remove" type="object" string="Remove" class="btn btn-sm btn-link text-danger"
                                                invisible="origin != 'walk_in' or departed_on"
                                                confirm="Remove this child, added by mistake, from the sheet?"/>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_school_childcare_sheet_view_search" model="ir.ui.view">
        <field name="name">bf.school.childcare.sheet.search</field>
        <field name="model">bf.school.childcare.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="slot_id"/>
                <field name="date"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Group by">
                    <filter name="by_slot" string="Period" context="{'group_by': 'slot_id'}"/>
                    <filter name="by_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_childcare_sheet_action" model="ir.actions.act_window">
        <field name="name">Daily sheets</field>
        <field name="res_model">bf.school.childcare.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sheet open</p>
            <p>"Today" opens the sheets of the periods that run today, with the children expected.</p>
        </field>
    </record>

    <record id="action_childcare_today" model="ir.actions.server">
        <field name="name">Today</field>
        <field name="model_id" ref="model_bf_school_childcare_sheet"/>
        <field name="state">code</field>
        <field name="code">action = model._action_school_today()</field>
    </record>

    <record id="bf_school_childcare_line_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.sheet.line.list</field>
        <field name="model">bf.school.childcare.sheet.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="slot_id" options="{'no_open': True}"/>
                <field name="student_id" options="{'no_open': True}"/>
                <field name="origin" widget="badge"/>
                <field name="presence" widget="badge"/>
                <field name="arrived_time"/>
                <field name="departed_time"/>
                <field name="departure_label"/>
                <field name="late_minutes" sum="Minutes late"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_line_view_search" model="ir.ui.view">
        <field name="name">bf.school.childcare.sheet.line.search</field>
        <field name="model">bf.school.childcare.sheet.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="slot_id"/>
                <filter name="late" string="Late pick-up" domain="[('late_minutes', '>', 0)]"/>
                <filter name="walk_in" string="Not registered" domain="[('origin', '=', 'walk_in')]"/>
                <filter name="other" string="With someone else" domain="[('departure_kind', '=', 'other')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Group by">
                    <filter name="by_student" string="Student" context="{'group_by': 'student_id'}"/>
                    <filter name="by_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_childcare_line_action" model="ir.actions.act_window">
        <field name="name">Attendance and departures</field>
        <field name="res_model">bf.school.childcare.sheet.line</field>
        <field name="view_mode">list</field>
    </record>

    <!-- The departure window -->
    <record id="bf_school_childcare_departure_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.departure.form</field>
        <field name="model">bf.school.childcare.departure</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_id" invisible="1"/>
                <h3><field name="student_name" readonly="1"/></h3>
                <div class="alert alert-danger" role="alert" invisible="not restriction_names">
                    Must not pick up: <field name="restriction_names" readonly="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not alert">
                    <field name="alert" readonly="1"/>
                </div>
                <field name="choice_ids" nolabel="1" readonly="1">
                    <list create="0" delete="0">
                        <field name="label"/>
                        <field name="needs_id_check" readonly="1"/>
                        <button name="action_depart" type="object" string="Departure" icon="fa-sign-out"
                                class="btn-primary"/>
                    </list>
                </field>
                <group>
                    <field name="id_checked"/>
                    <field name="other_note" placeholder="Name, and how the family let the school know"/>
                </group>
                <footer>
                    <button name="action_other" type="object" string="Leaves with someone else" class="btn-secondary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================== Registrations ===================== -->
    <record id="bf_school_childcare_registration_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.registration.list</field>
        <field name="model">bf.school.childcare.registration</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('ended', 'cancelled')" decoration-info="state == 'draft'">
                <field name="student_id"/>
                <field name="school_id" optional="hide" options="{'no_open': True}"/>
                <field name="year_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="periods_per_week"/>
                <field name="channel" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_registration_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.registration.form</field>
        <field name="model">bf.school.childcare.registration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Put in force" class="btn-primary"
                            invisible="state != 'draft' or not id"/>
                    <button name="action_cancel" type="object" string="Cancel the request"
                            invisible="state != 'draft' or not id"/>
                    <button name="action_end" type="object" string="End" invisible="state != 'active'"
                            confirm="End this registration today?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,ended"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="school_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="year_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="periods_per_week"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="slot_id" domain="[('school_id', '=', parent.school_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="mon"/>
                            <field name="tue"/>
                            <field name="wed"/>
                            <field name="thu"/>
                            <field name="fri"/>
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="requested_by_id" readonly="1"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="confirmed_on"/>
                            <field name="confirmed_by_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Internal note, never shown to the family"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_school_childcare_registration_view_search" model="ir.ui.view">
        <field name="name">bf.school.childcare.registration.search</field>
        <field name="model">bf.school.childcare.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="year_id"/>
                <filter name="draft" string="Requests" domain="[('state', '=', 'draft')]"/>
                <filter name="active" string="In force" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group by">
                    <filter name="by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="by_year" string="School year" context="{'group_by': 'year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_childcare_registration_action" model="ir.actions.act_window">
        <field name="name">Registrations</field>
        <field name="res_model">bf.school.childcare.registration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No registration yet</p>
            <p>A regular place: some periods, some weekdays. Families ask on the portal; the manager puts the request in force.</p>
        </field>
    </record>

    <!-- ===================== Bookings, activities, absences ===================== -->
    <record id="bf_school_childcare_booking_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.booking.list</field>
        <field name="model">bf.school.childcare.booking</field>
        <field name="arch" type="xml">
            <list decoration-muted="state != 'booked'">
                <field name="date"/>
                <field name="slot_id" options="{'no_open': True}"/>
                <field name="student_id"/>
                <field name="activity_id" optional="show"/>
                <field name="late_notice" optional="show"/>
                <field name="cancel_late" optional="show"/>
                <field name="channel" optional="hide"/>
                <field name="booked_by_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'booked'"/>
                <button name="action_cancel" type="object" string="Cancel" icon="fa-times" invisible="state != 'booked'"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_booking_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.booking.form</field>
        <field name="model">bf.school.childcare.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object" string="Cancel the booking" invisible="state != 'booked' or not id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="id" options="{'no_create': True}"/>
                            <field name="slot_id" readonly="id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="date" readonly="id"/>
                            <field name="activity_id"/>
                        </group>
                        <group>
                            <field name="late_notice"/>
                            <field name="cancel_late"/>
                            <field name="booked_by_id"/>
                            <field name="channel"/>
                            <field name="cancelled_on"/>
                            <field name="cancelled_by_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_childcare_booking_view_search" model="ir.ui.view">
        <field name="name">bf.school.childcare.booking.search</field>
        <field name="model">bf.school.childcare.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="slot_id"/>
                <filter name="booked" string="Booked" domain="[('state', '=', 'booked')]"/>
                <filter name="late" string="Late notice or cancellation" domain="['|', ('late_notice', '=', True), ('cancel_late', '=', True)]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Group by">
                    <filter name="by_date" string="Date" context="{'group_by': 'date:day'}"/>
                    <filter name="by_slot" string="Period" context="{'group_by': 'slot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_childcare_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">bf.school.childcare.booking</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_booked': 1}</field>
    </record>

    <record id="bf_school_childcare_activity_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.activity.list</field>
        <field name="model">bf.school.childcare.activity</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="name"/>
                <field name="slot_id" options="{'no_open': True}"/>
                <field name="places"/>
                <field name="min_registrations"/>
                <field name="booked_count"/>
                <field name="deadline"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_activity_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.activity.form</field>
        <field name="model">bf.school.childcare.activity</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'open' or not id"/>
                    <button name="action_cancel" type="object" string="Cancel the activity"
                            invisible="state == 'cancelled' or not id"
                            confirm="Cancel the activity? Its bookings are cancelled at no charge and the families are told."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Outing to the sugar shack"/></h1></div>
                    <group>
                        <group>
                            <field name="slot_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="date"/>
                            <field name="deadline"/>
                        </group>
                        <group>
                            <field name="places"/>
                            <field name="min_registrations"/>
                            <field name="booked_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What the children will do, what to bring"/>
                    <field name="booking_ids" readonly="1">
                        <list>
                            <field name="student_id"/>
                            <field name="state" widget="badge"/>
                            <field name="cancel_late"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_childcare_activity_action" model="ir.actions.act_window">
        <field name="name">Days without class</field>
        <field name="res_model">bf.school.childcare.activity</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="bf_school_childcare_absence_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.absence.list</field>
        <field name="model">bf.school.childcare.absence</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="date"/>
                <field name="student_id" options="{'no_create': True}"/>
                <field name="school_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="slot_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="reason"/>
                <field name="declared_by_id" readonly="1"/>
                <field name="channel" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_absence_action" model="ir.actions.act_window">
        <field name="name">Absence notices</field>
        <field name="res_model">bf.school.childcare.absence</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ===================== Who may pick up ===================== -->
    <record id="bf_school_childcare_person_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.pickup.person.list</field>
        <field name="model">bf.school.childcare.pickup.person</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'revoked'">
                <field name="student_id"/>
                <field name="name"/>
                <field name="relationship"/>
                <field name="phone"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="id_checked_on"/>
                <field name="channel" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_person_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.pickup.person.form</field>
        <field name="model">bf.school.childcare.pickup.person</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke" type="object" string="Revoke" invisible="state != 'active' or not id"
                            confirm="Revoke this permission? The adults with parental authority are told."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="id" options="{'no_create': True}"/>
                            <field name="name" readonly="id"/>
                            <field name="relationship"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="id"/>
                            <field name="date_to" readonly="id"/>
                            <field name="id_checked_on"/>
                            <field name="id_checked_by_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="added_by_id"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="revoked_on"/>
                            <field name="revoked_by_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_childcare_person_action" model="ir.actions.act_window">
        <field name="name">Authorized people</field>
        <field name="res_model">bf.school.childcare.pickup.person</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="bf_school_childcare_restriction_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.restriction.list</field>
        <field name="model">bf.school.childcare.restriction</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_restriction_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.restriction.form</field>
        <field name="model">bf.school.childcare.restriction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="name"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Reserved to the child care manager and the Administration">
                        <field name="detail" nolabel="1" colspan="2"/>
                        <field name="document_name" invisible="1"/>
                        <field name="document" filename="document_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_childcare_restriction_action" model="ir.actions.act_window">
        <field name="name">Pick-up restrictions</field>
        <field name="res_model">bf.school.childcare.restriction</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="bf_school_childcare_walk_alone_view_list" model="ir.ui.view">
        <field name="name">bf.school.childcare.walk_alone.list</field>
        <field name="model">bf.school.childcare.walk_alone</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'revoked'">
                <field name="student_id"/>
                <field name="mon"/>
                <field name="tue"/>
                <field name="wed"/>
                <field name="thu"/>
                <field name="fri"/>
                <field name="from_time" widget="float_time"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="signed_by_id"/>
                <field name="channel" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="bf_school_childcare_walk_alone_view_form" model="ir.ui.view">
        <field name="name">bf.school.childcare.walk_alone.form</field>
        <field name="model">bf.school.childcare.walk_alone</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_record_paper" type="object" string="Record the signed paper" class="btn-primary"
                            invisible="state != 'draft' or not id"/>
                    <button name="action_revoke" type="object" string="Revoke" invisible="state != 'active'"
                            confirm="Revoke this permission? The adults with parental authority are told."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="from_time" widget="float_time" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="mon" readonly="state != 'draft'"/>
                            <field name="tue" readonly="state != 'draft'"/>
                            <field name="wed" readonly="state != 'draft'"/>
                            <field name="thu" readonly="state != 'draft'"/>
                            <field name="fri" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="terms" invisible="state != 'draft'"/>
                    <field name="text_signed" invisible="state == 'draft'"/>
                    <group>
                        <group>
                            <field name="signer_candidate_ids" invisible="1"/>
                            <field name="paper_signer_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="signed_by_id"/>
                            <field name="signed_on"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="text_hash"/>
                            <field name="revoked_on"/>
                            <field name="revoked_by_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_childcare_walk_alone_action" model="ir.actions.act_window">
        <field name="name">Leaving alone</field>
        <field name="res_model">bf.school.childcare.walk_alone</field>
        <field name="view_mode">list,form</field>
    </record>

