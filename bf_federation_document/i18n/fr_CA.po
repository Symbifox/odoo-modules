msgid "<p>At %s, <b>%s</b> acknowledged receipt of the deliverable.</p>"
msgstr "<p>Chez %s, <b>%s</b> a accusé réception du livrable.</p>"

#. module: bf_federation_document
#. odoo-python
#: code:addons/bf_federation_document/models/federation_document.py:0
msgid ""
"<p>At %s, the deliverable moved to version <b>%s</b>: the read receipt must "
"be given again.</p>"
msgstr ""
"<p>Chez %s, le livrable est passé à la version <b>%s</b> : l'accusé de "
"réception est à refaire.</p>"

#. module: bf_federation_document
#. odoo-python
#: code:addons/bf_federation_document/models/federation_document.py:0
msgid ""
"<p>At %s, version <b>%s</b> was read by %s, but we are now at <b>%s</b>: the"
" receipt does not apply to the current version.</p>"
msgstr ""
"<p>Chez %s, la version <b>%s</b> a été lue par %s, mais nous en sommes à la "
"<b>%s</b> : l'accusé ne vaut pas pour la version en cours.</p>"

#. module: bf_federation_document
#. odoo-python
#: code:addons/bf_federation_document/models/federation_document.py:0
msgid ""
"<p>Deliverable received from %s: <b>%s</b>, version %s, delivered on %s.</p>"
msgstr "<p>Livrable reçu de %s : <b>%s</b>, version %s, remis le %s.</p>"

