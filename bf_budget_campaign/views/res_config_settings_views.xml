<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- On se greffe sur la section « Budgets » du socle plutôt que d'en ouvrir
         une seconde : un réglage de la même famille se cherche au même endroit. -->
    <record id="res_config_settings_view_form_campaign" model="ir.ui.view">
        <field name="name">res.config.settings.form.bf.budget.campaign</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_budget.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='bf_budget']" position="inside">
                <block title="Campaigns" name="bf_budget_campaign">
                    <setting id="bf_campaign_hourly_cost_setting"
                             string="Default cost rate"
                             help="Used only to estimate the hours Odoo could not cost, for lack of an hourly cost on the employee record. The estimate stays separate and never enters actual spend.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="bf_campaign_hourly_cost" class="col-lg-4 o_light_label"/>
                                <field name="bf_campaign_hourly_cost"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
