"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Friendly reminder</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"        <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;\">Just a gentle reminder: we still need your availability to schedule the meeting “<strong><t t-out=\"object.poll_id.name or ''\"/></strong>”.</p>\n"
"        <t t-if=\"object.required\"><p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 8px 0;\">Since your attendance is required, the meeting is waiting for your answer before it can be set.</p></t>\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin:16px 0 4px 0; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;\"><tbody>\n"
"         <tr><td style=\"padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px; width:38%;\">Subject</td><td style=\"padding:12px 16px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;\"><t t-out=\"object.poll_id.name or ''\"/></td></tr>\n"
"         <tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Expected duration</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;\"><t t-out=\"object.poll_id.duration_display()\"/></td></tr>\n"
"         <tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Proposed slots</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; color:#374151;\"><t t-out=\"len(object.poll_id.slot_ids)\"/></td></tr>\n"
"         <t t-if=\"object.poll_id.close_date\"><tr><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; color:#6B7280; font-size:14px;\">Please reply by</td><td style=\"padding:12px 16px; border-bottom:1px solid #e5e7eb; font-size:14px; font-weight:600; color:#374151;\"><t t-out=\"object.poll_id.close_display()\"/></td></tr></t>\n"
"         <t t-if=\"object.required\"><tr><td style=\"padding:12px 16px; color:#6B7280; font-size:14px;\">Your attendance</td><td style=\"padding:12px 16px; font-size:14px; font-weight:600; color:#374151;\">Required</td></tr></t>\n"
"        </tbody></table>\n"
"        <p style=\"text-align:center; margin:24px 0 8px 0;\">\n"
"         <a t-att-href=\"object._vote_url()\" t-attf-style=\"background-color:{{ brand_primary }}; color:#ffffff; padding:14px 34px; text-decoration:none; border-radius:6px; font-weight:600; font-size:15px; display:inline-block;\">Reply now</a>\n"
