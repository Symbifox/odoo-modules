#. module: bf_cx
#: model:mail.template,body_html:bf_cx.mail_template_cx_360_invite
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#29ABE2'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#2E3132'\"/>\n"
"<t t-set=\"subject_name\" t-value=\"object.bf_cx_wave_id.subject_user_id.name or ''\"/>\n"
"<t t-set=\"hidden\" t-value=\"object.bf_cx_wave_id.program_id.hide_respondent\"/>\n"
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#F8FAFC;\">\n"
"    <tbody><tr><td align=\"center\" style=\"padding:24px;\">\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;\">\n"
"            <tbody>\n"
"                <tr>\n"
"                    <td t-attf-style=\"background-color:{{ brand_dark }}; padding:16px 24px; border-radius:12px 12px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tbody><tr>\n"
"                            <td align=\"left\">\n"
"                                <img t-att-src=\"'/brand/logo/%d' % company.id\" alt=\"Logo\" style=\"height:40px; width:auto; display:block; border:0;\"/>\n"
"                            </td>\n"
"                            <td align=\"right\" style=\"color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;\">\n"
"                                Feedback\n"
"                            </td>\n"
"                        </tr></tbody></table>\n"
"                    </td>\n"
"                </tr>\n"
"                <tr><td t-attf-style=\"height:4px; line-height:4px; background-color:{{ brand_primary }};\">&amp;nbsp;</td></tr>\n"
"                <tr>\n"
"                    <td style=\"padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif; color:#2E3132;\">\n"
"                        <p style=\"font-size:15px; margin:0 0 12px 0;\">\n"
"                            Hello <t t-out=\"object.partner_id.name or ''\"/>,\n"
"                        </p>\n"
"                        <p style=\"font-size:15px; margin:0 0 12px 0;\">\n"
"                            <t t-if=\"subject_name\">\n"
"                                We are collecting feedback on the work of <strong><t t-out=\"subject_name\"/></strong>. You work with this person: your view counts for more than ours.\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                We are collecting internal feedback on the way we work.\n"
"                            </t>\n"
"                        </p>\n"
"                        <p style=\"font-size:15px; margin:0 0 12px 0;\">\n"
"                            Allow three minutes. What helps are concrete examples, not round scores.\n"
"                        </p>\n"
"                        <div style=\"text-align:center; margin:28px 0;\">\n"
"                            <a t-att-href=\"object.get_start_url()\" t-attf-style=\"background-color:{{ brand_primary }}; color:#FFFFFF; text-decoration:none; padding:12px 28px; border-radius:6px; font-size:15px; display:inline-block;\">\n"
"                                Give my feedback\n"
"                            </a>\n"
"                        </div>\n"
"                        <t t-if=\"object.deadline\">\n"
"                            <p style=\"font-size:13px; color:#6B7280; margin:0 0 12px 0;\">\n"
"                                Feedback is collected until\n"
"                                <t t-out=\"format_date(object.deadline)\"/>.\n"
"                            </p>\n"
"                        </t>\n"
"                        <p style=\"font-size:13px; color:#6B7280; margin:0;\">\n"
"                            <t t-if=\"hidden\">\n"
"                                Your name is not entered in the feedback register: neither the summary, nor the lists, nor the exports show it. In a team this size, a comment can still be recognized by its content.\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                Your name comes with your answer.\n"
"                            </t>\n"
"                        </p>\n"
"                    </td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:16px 24px 20px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;\">\n"
"                        <p style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:0;\">\n"
"                            <t t-if=\"company.name\"><t t-out=\"company.name\"/></t>\n"
"                        </p>\n"
"                    </td>\n"
"                </tr>\n"
"            </tbody>\n"
"        </table>\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:12px auto 0;\">\n"
"            <tbody><tr>\n"
"                <td t-attf-style=\"height:3px; line-height:3px; background-color:{{ brand_primary }}; width:50%;\">&amp;nbsp;</td>\n"
"                <td t-attf-style=\"height:3px; line-height:3px; background-color:{{ brand_dark }}; width:50%;\">&amp;nbsp;</td>\n"
"            </tr></tbody>\n"
"        </table>\n"
"    </td></tr></tbody>\n"
"</table>\n"
"            "
msgstr ""

#. module: bf_cx
#: model:mail.template,body_html:bf_cx.mail_template_cx_reminder
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#29ABE2'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#2E3132'\"/>\n"
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#F8FAFC;\">\n"
"    <tbody><tr><td align=\"center\" style=\"padding:24px;\">\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;\">\n"
"            <tbody>\n"
"                <tr>\n"
"                    <td t-attf-style=\"background-color:{{ brand_dark }}; padding:16px 24px; border-radius:12px 12px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tbody><tr>\n"
"                            <td align=\"left\">\n"
"                                <img t-att-src=\"'/brand/logo/%d' % company.id\" alt=\"Logo\" style=\"height:40px; width:auto; display:block; border:0;\"/>\n"
"                            </td>\n"
"                            <td align=\"right\" style=\"color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;\"> A quick reminder </td>\n"
"                        </tr></tbody></table>\n"
"                    </td>\n"
"                </tr>\n"
"                <tr><td t-attf-style=\"height:4px; line-height:4px; background-color:{{ brand_primary }};\">&amp;nbsp;</td></tr>\n"
"                <tr>\n"
"                    <td style=\"padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif; color:#2E3132;\">\n"
"                        <p style=\"font-size:15px; margin:0 0 12px 0;\"> Hello <t t-out=\"object.partner_id.name or ''\"/>,\n"
"                        </p>\n"
"                        <p style=\"font-size:15px; margin:0 0 12px 0;\"> A quick, no-pressure reminder: your feedback would really help us, and it only takes two minutes. This is the only reminder you will receive. </p>\n"
"                        <div style=\"text-align:center; margin:28px 0;\">\n"
"                            <a t-att-href=\"object.get_start_url()\" t-attf-style=\"background-color:{{ brand_primary }}; color:#FFFFFF; text-decoration:none; padding:12px 28px; border-radius:6px; font-size:15px; display:inline-block;\"> Take the survey </a>\n"
"                        </div>\n"
"                        <p style=\"font-size:15px; margin:0;\"> Thank you so much! </p>\n"
"                    </td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:16px 24px 20px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;\">\n"
"                        <p style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:0;\">\n"
"                            <t t-if=\"company.name\"><t t-out=\"company.name\"/><br/></t> Prefer not to receive feedback requests? <a t-att-href=\"object.partner_id.bf_cx_unsubscribe_url\" style=\"color:#6B7280;\">Unsubscribe</a>.\n"
"                        </p>\n"
"                    </td>\n"
"                </tr>\n"
"            </tbody>\n"
"        </table>\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:12px auto 0;\">\n"
"            <tbody><tr>\n"
"                <td t-attf-style=\"height:3px; line-height:3px; background-color:{{ brand_primary }}; width:50%;\">&amp;nbsp;</td>\n"
"                <td t-attf-style=\"height:3px; line-height:3px; background-color:{{ brand_dark }}; width:50%;\">&amp;nbsp;</td>\n"
"            </tr></tbody>\n"
"        </table>\n"
"    </td></tr></tbody>\n"
"</table>\n"
"            "
msgstr ""

#. module: bf_cx
#: model:mail.template,body_html:bf_cx.mail_template_cx_invite
