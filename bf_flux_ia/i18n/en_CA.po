#. module: bf_flux_ia
#. odoo-python
#: code:addons/bf_flux_ia/models/flux_retenue.py:0
msgid "Une nouvelle qui concerne directement un sujet surveillé."
msgstr "News that directly concerns a watched topic."

#. module: bf_flux_ia
#: model:ir.model.fields,help:bf_flux_ia.field_bf_flux_liste__alerte_fraicheur_heures
msgid ""
"Une recherche ramène aussi des articles anciens : au-delà de ce délai depuis"
" la publication, l'élément va au résumé, jamais en alerte."
msgstr ""
"A search also brings back old articles: past this delay since publication, "
"the item goes to the digest, never to an alert."

