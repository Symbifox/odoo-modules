msgid "%s saisies."
msgstr "%s logged."

#. module: bf_nfc_timer
#: model:ir.model.fields.selection,name:bf_nfc_timer.selection__bf_nfc_gesture__kind__timer_stop
msgid "Arrêter le chrono et saisir"
msgstr "Stop the timer and log"

#. module: bf_nfc_timer
#. odoo-python
#: code:addons/bf_nfc_timer/models/bf_nfc_gesture.py:0
msgid "Aucun chrono en cours sur « %s »."
msgstr "No timer running on “%s”."

#. module: bf_nfc_timer
#. odoo-python
#: code:addons/bf_nfc_timer/models/bf_nfc_gesture.py:0
msgid "Cette pastille ne désigne pas une tâche."
msgstr "This tag does not point to a task."

#. module: bf_nfc_timer
#: model:bf.nfc.gesture,name:bf_nfc_timer.gesture_timer_stop
