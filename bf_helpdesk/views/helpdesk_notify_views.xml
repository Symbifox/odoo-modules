<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_helpdesk_notify_pref_list" model="ir.ui.view">
    <field name="name">helpdesk.notify.pref.list</field>
    <field name="model">helpdesk.notify.pref</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="user_id" groups="helpdesk_mgmt.group_helpdesk_manager"/>
        <field name="event"/>
        <field name="channel"/>
        <field name="mode" invisible="channel == 'none'"/>
      </list>
    </field>
  </record>

  <record id="action_helpdesk_notify_pref" model="ir.actions.act_window">
    <field name="name">Mes notifications d'assistance</field>
    <field name="res_model">helpdesk.notify.pref</field>
    <field name="view_mode">list</field>
    <field name="domain">[('user_id', '=', uid)]</field>
    <field name="context">{'default_user_id': uid}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Notifications d'assistance comme d'habitude</p>
      <p>Sans réglage, Odoo vous avise comme pour le reste (boîte de réception
        ou courriel, selon vos préférences). Ajoutez une ligne pour choisir, par
        événement, le canal (Odoo, courriel, ntfy ou aucun) et le moment : tout
        de suite, en condensé toutes les heures ou une fois par jour. Un billet
        de priorité très élevée vous avise toujours tout de suite.</p>
    </field>
  </record>

  <menuitem id="menu_helpdesk_notify_pref"
            name="Mes notifications"
            parent="helpdesk_mgmt.helpdesk_ticket_main_menu"
            action="action_helpdesk_notify_pref"
            sequence="90"
            groups="helpdesk_mgmt.group_helpdesk_user_team"/>

</odoo>
