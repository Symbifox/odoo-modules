<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Server actions bound to the form view cogwheel of common
            chatter-bearing models. Clicking « Réordonner ce chatter par
            date » invokes mail.message.action_backfill_chatter_dates()
            with the current record as active context.

            To extend to a new model: duplicate <record> and update the
            id + binding_model_id ref.
        -->

        <record id="action_chatter_chrono_project_task" model="ir.actions.server">
            <field name="name">Réordonner ce chatter par date</field>
            <field name="model_id" ref="mail.model_mail_message"/>
            <field name="binding_model_id" ref="project.model_project_task"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">action = env['mail.message'].action_backfill_chatter_dates()</field>
        </record>

