<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="hosting_endpoint_view_list" model="ir.ui.view">
        <field name="name">hosting.endpoint.list</field>
        <field name="model">hosting.endpoint</field>
        <field name="arch" type="xml">
            <list decoration-muted="lifecycle_state == 'retired'"
                  decoration-warning="lifecycle_state == 'in_repair'"
                  decoration-danger="os_eol_tag">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="endpoint_type" widget="badge"
                       decoration-info="endpoint_type == 'server'"
                       decoration-success="endpoint_type in ('workstation', 'laptop')"/>
                <field name="lifecycle_state" widget="badge"
                       decoration-success="lifecycle_state == 'deployed'"
                       decoration-warning="lifecycle_state == 'in_repair'"
                       decoration-muted="lifecycle_state == 'retired'"/>
                <field name="os" optional="show"/>
                <field name="os_eol_tag" string="EOL" optional="show"/>
                <field name="assigned_display" string="Usager" optional="show"/>
                <field name="serial" optional="hide"/>
                <field name="group_ids" widget="many2many_tags" optional="hide"/>
                <field name="warranty_end" optional="show"
                       decoration-warning="warranty_end &lt;= (context_today() + relativedelta(days=90))"
                       decoration-danger="warranty_end &lt; context_today()"/>
                <field name="action1_endpoint_id" string="A1" optional="hide"/>
                <field name="action1_last_sync" string="Sync A1" optional="hide"/>
                <field name="manual_override" string="Manuel" widget="boolean_toggle" optional="hide"/>
                <field name="action1_url" widget="url" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hosting_endpoint_view_form" model="ir.ui.view">
        <field name="name">hosting.endpoint.form</field>
        <field name="model">hosting.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="lifecycle_state" widget="statusbar"
                           statusbar_visible="in_stock,deployed,in_repair,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_licenses" type="object"
                                class="oe_stat_button" icon="fa-key"
                                invisible="license_seat_count == 0">
                            <field name="license_seat_count" widget="statinfo" string="Licences"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Retiré"
                            bg_color="text-bg-danger"
                            invisible="lifecycle_state != 'retired'"/>
                    <widget name="web_ribbon" title="EOL"
                            bg_color="text-bg-warning"
                            invisible="not os_eol_tag"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h3><field name="code" placeholder="EP-2026-0001"/></h3>
                        <label for="name"/>
                        <h1><field name="name" placeholder="Hostname ou nom convivial"/></h1>
                    </div>

                    <group>
                        <group string="Affectation">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="endpoint_type"/>
                            <field name="assigned_type" widget="radio"
                                   options="{'horizontal': True}"/>
                            <field name="assigned_partner_id"
                                   invisible="assigned_type != 'contact'"
                                   domain="[('is_company', '=', False), ('commercial_partner_id', '=', partner_id)]"
                                   options="{'no_quick_create': True}"/>
                            <field name="assigned_matrix_item_id"
                                   invisible="assigned_type != 'matrix_item'"
                                   domain="[('project_id.partner_id', '=', partner_id)]"/>
                            <field name="assigned_user_name"
                                   invisible="assigned_type != 'free_text'"/>
                            <field name="assigned_email" widget="email"/>
                            <field name="group_ids" widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Identité matériel">
                            <field name="manufacturer"/>
                            <field name="model_name"/>
                            <field name="serial"/>
                            <field name="purchase_date"/>
                            <field name="warranty_end"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="OS &amp; Réseau" name="os_network">
                            <group>
                                <group string="Système">
                                    <field name="os"/>
                                    <field name="os_build"/>
                                    <field name="os_eol_tag" readonly="1"/>
                                </group>
                                <group string="Réseau">
                                    <field name="hostname"/>
                                    <field name="mac_address"/>
                                    <field name="ip_address"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sécurité (BitLocker)" name="security"
                              groups="hosting_management.group_hosting_manager">
                            <div class="alert alert-warning" role="alert">
                                <strong>Champ sensible.</strong> Visible uniquement
                                pour les gestionnaires d'hébergement. Stocké en clair
                                en base — ne pas exporter ni copier dans un canal
                                non sécurisé.
                            </div>
                            <group>
                                <field name="bitlocker_recovery_key"
                                       widget="bf_secret_key"
                                       placeholder="123456-123456-123456-123456-123456-123456-123456-123456"/>
                                <field name="bitlocker_volume_id"
                                       placeholder="GUID du volume"/>
                            </group>
                        </page>
                        <page string="RMM &amp; MDM" name="rmm">
                            <group>
                                <group string="Action1">
                                    <field name="action1_endpoint_id" readonly="1"/>
                                    <field name="action1_url" widget="url"
                                           placeholder="https://app.action1.com/endpoints/..."/>
                                    <field name="action1_last_sync" readonly="1"/>
                                    <field name="manual_override" widget="boolean_toggle"/>
                                </group>
                                <group string="Microsoft">
                                    <field name="intune_device_id"
                                           placeholder="ID Intune managedDevice"/>
                                    <field name="entra_object_id"
                                           placeholder="GUID Entra ID"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 invisible="not action1_endpoint_id">
                                Ce poste est lié à Action1. Si la case « Saisie manuelle
                                prioritaire » est activée, la synchronisation ne touchera
                                aucun champ ; sinon, la stratégie globale s'applique
                                (Configuration → Paramètres → Action1).
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Historique, particularités, configurations..."/>
                        </page>
                    </notebook>

                    <field name="active" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="hosting_endpoint_view_search" model="ir.ui.view">
        <field name="name">hosting.endpoint.search</field>
        <field name="model">hosting.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="serial"/>
                <field name="hostname"/>
                <field name="assigned_display" string="Usager"/>
                <field name="assigned_partner_id"/>
                <field name="assigned_matrix_item_id"/>
                <separator/>
                <filter name="filter_deployed" string="Déployés"
                        domain="[('lifecycle_state', '=', 'deployed')]"/>
                <filter name="filter_in_stock" string="En stock"
                        domain="[('lifecycle_state', '=', 'in_stock')]"/>
                <filter name="filter_in_repair" string="En réparation"
                        domain="[('lifecycle_state', '=', 'in_repair')]"/>
                <filter name="filter_retired" string="Retirés"
                        domain="[('lifecycle_state', '=', 'retired')]"/>
                <separator/>
                <filter name="filter_warranty_warning" string="Garantie ≤ 90 j"
                        domain="[('warranty_end', '!=', False),
                                 ('warranty_end', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_warranty_expired" string="Garantie expirée"
                        domain="[('warranty_end', '!=', False),
                                 ('warranty_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_no_warranty" string="Pas de garantie saisie"
                        domain="[('warranty_end', '=', False)]"/>
                <separator/>
                <filter name="filter_os_eol" string="OS EOL"
                        domain="[('os_eol_tag', '!=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archivés"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_partner" string="Client"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'endpoint_type'}"/>
                    <filter name="group_lifecycle" string="Cycle de vie"
                            context="{'group_by': 'lifecycle_state'}"/>
                    <filter name="group_os" string="OS"
                            context="{'group_by': 'os'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="hosting_endpoint_view_kanban" model="ir.ui.view">
        <field name="name">hosting.endpoint.kanban</field>
        <field name="model">hosting.endpoint</field>
        <field name="arch" type="xml">
            <kanban default_group_by="lifecycle_state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="endpoint_type"/>
                <field name="lifecycle_state"/>
                <field name="warranty_end"/>
                <field name="os_eol_tag"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{record.lifecycle_state.raw_value == 'retired' ? 'opacity-50' : ''}">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="code"/> — <field name="partner_id"/>
                            </div>
                            <div class="mt-2">
                                <field name="endpoint_type" widget="badge"/>
                            </div>
                            <div class="mt-1" t-if="record.os_eol_tag.raw_value">
                                <span class="badge text-bg-danger">
                                    <field name="os_eol_tag"/>
                                </span>
                            </div>
                            <div class="mt-1" t-if="record.warranty_end.raw_value">
                                <span class="text-muted">Garantie : </span>
                                <field name="warranty_end"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="hosting_endpoint_action_all" model="ir.actions.act_window">
        <field name="name">Parc informatique</field>
        <field name="res_model">hosting.endpoint</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hosting_endpoint_view_search"/>
        <field name="context">{'search_default_filter_deployed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez votre premier poste au parc
            </p>
            <p>
                Suivez les postes, portables et serveurs des clients sous SLA :
                inventaire matériel, OS, garantie, BitLocker, Action1, Intune.
            </p>
        </field>
    </record>

    <record id="hosting_endpoint_action_warranty_warning" model="ir.actions.act_window">
        <field name="name">Garantie expirante (≤ 90 j)</field>
        <field name="res_model">hosting.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hosting_endpoint_view_search"/>
        <field name="context">{'search_default_filter_warranty_warning': 1}</field>
    </record>

    <record id="hosting_endpoint_action_os_eol" model="ir.actions.act_window">
        <field name="name">OS en fin de support</field>
        <field name="res_model">hosting.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hosting_endpoint_view_search"/>
        <field name="context">{'search_default_filter_os_eol': 1}</field>
    </record>

    <record id="hosting_endpoint_action_retired" model="ir.actions.act_window">
        <field name="name">Postes retirés</field>
        <field name="res_model">hosting.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hosting_endpoint_view_search"/>
        <field name="context">{'search_default_filter_retired': 1}</field>
    </record>

</odoo>
