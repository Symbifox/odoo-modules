<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="meeting_report_mail_template" model="mail.template">
            <field name="name">Compte rendu de réunion</field>
            <field name="model_id" ref="bf_meeting.model_meeting_record"/>
            <field name="lang">{{ object._bf_langue_envoi() }}</field>
            <field name="subject">Compte rendu — {{ object.room_name or object.name }} ({{ object.date.strftime('%Y-%m-%d') }})</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_to_ids }}</field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
            <field name="body_html" type="html">

<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">Compte rendu</p>
<h2 t-attf-style="font-size:20px; font-weight:700; color:{{ brand_dark }}; margin:0 0 12px 0;">
    <t t-out="object.room_name or object.name"/>
</h2>

<p style="font-size:13px; color:#6B7280; margin:0 0 20px 0;">
    <t t-if="object.date">
        <t t-set="is_placeholder" t-value="object.date.hour == 0 and object.date.minute == 0 and object.date.second == 0"/>
        <strong style="color:#374151;">Date :</strong>
        <t t-if="is_placeholder">
            <t t-out="object.date.strftime('%Y-%m-%d')"/>
        </t>
        <t t-else="">
            <t t-out="object.report_date_display_html()"/>
        </t>
    </t>
    <t t-if="object.duration_minutes">
        &#160;·&#160; <strong style="color:#374151;">Durée :</strong> <t t-out="object.duration_minutes"/> min
    </t>
    <t t-if="object.location">
        &#160;·&#160; <strong style="color:#374151;">Lieu :</strong> <t t-out="object.location"/>
    </t>
</p>

<p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">
    Bonjour,
</p>
<p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;">
    Veuillez trouver ci-dessous le compte rendu de la rencontre. Le PDF complet est joint à ce courriel.
</p>

<t t-if="object.attendance_ids or object.participant_ids">
<div style="margin:0 0 20px 0; padding:12px 14px; background-color:#F5F7FA; border-radius:6px; font-size:13px; color:#374151;">
    <strong t-attf-style="color:{{ brand_dark }};">Participants :</strong>
    <t t-if="object.attendance_ids">
        <t t-foreach="object.attendance_ids" t-as="a">
            <t t-set="absent" t-value="a.status != 'present'"/>
            <span t-attf-style="display:inline-block; margin:2px 4px; padding:2px 10px; background-color:#FFFFFF; border:1px solid #D8DEE4; border-radius:12px; font-size:12px; color:{{ '#9CA3AF' if absent else brand_dark }};"><t t-out="a.partner_id.name"/><t t-if="a.status == 'excused'"> (excusé)</t><t t-if="a.status == 'absent'"> (absent)</t></span>
        </t>
    </t>
    <t t-else="">
        <t t-foreach="object.participant_ids" t-as="p">
            <span t-attf-style="display:inline-block; margin:2px 4px; padding:2px 10px; background-color:#FFFFFF; border:1px solid #D8DEE4; border-radius:12px; font-size:12px; color:{{ brand_dark }};"><t t-out="p.name"/></span>
        </t>
    </t>
</div>
</t>

<t t-if="object.summary">
<h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};">Résumé</h3>
<div style="margin:0 0 20px 0; white-space:pre-wrap; color:#374151; font-size:15px; line-height:24px;"><t t-out="object.summary"/></div>
</t>

<t t-if="object.topic_ids">
<h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};">Sujets abordés</h3>
<ol style="margin:0 0 20px 0; padding-left:24px; color:#374151;">
    <t t-foreach="object.topic_ids" t-as="topic">
        <li style="margin-bottom:10px;">
            <strong t-attf-style="color:{{ brand_dark }};"><t t-out="topic.name"/></strong>
            <t t-if="topic.points_html">
                <div style="margin-top:4px; color:#5C6368; font-size:14px;"><t t-out="topic.points_html"/></div>
            </t>
        </li>
    </t>
</ol>
</t>

<t t-if="object.decision_ids">
<h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};">Décisions</h3>
<ul style="margin:0 0 20px 0; padding-left:0; list-style:none;">
    <t t-foreach="object.decision_ids" t-as="decision">
        <li t-attf-style="margin-bottom:8px; padding:8px 12px; background-color:#F5F7FA; border-left-width:3px; border-left-style:solid; border-left-color:{{ brand_primary }}; border-radius:3px; color:#374151;">
            <strong t-attf-style="color:{{ brand_dark }};"><t t-out="decision.name"/></strong>
            <t t-if="decision.decision_maker_id">
                <span style="color:#6B7280; font-size:13px;"> — <t t-out="decision.decision_maker_id.name"/></span>
            </t>
        </li>
    </t>
</ul>
</t>

<t t-if="object.task_ids">
<h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};">Éléments d'action</h3>
<ul style="margin:0 0 20px 0; padding-left:24px; color:#374151;">
    <t t-foreach="object.task_ids" t-as="task">
        <li style="margin-bottom:6px;">
            <t t-out="task.name"/>
            <t t-if="task.user_ids">
                <span style="color:#6B7280; font-size:13px;"> — <t t-foreach="task.user_ids" t-as="u"><t t-if="not u_first" t-out="', '"/><t t-out="u.name"/></t></span>
            </t>
            <t t-if="task.date_deadline">
                <span style="color:#6B7280; font-size:13px;"> (échéance <t t-out="task.date_deadline.strftime('%Y-%m-%d')"/>)</span>
            </t>
        </li>
    </t>
</ul>
</t>

<t t-set="discussed_tasks" t-value="object._discussed_tasks_for_report()"/>
<t t-if="discussed_tasks">
<h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left-width:4px; border-left-style:solid; border-left-color:{{ brand_primary }};">Tâches existantes discutées</h3>
<ul style="margin:0 0 20px 0; padding-left:24px; color:#374151;">
    <t t-foreach="discussed_tasks" t-as="task">
        <li style="margin-bottom:6px;">
            <t t-out="task.name"/>
            <t t-if="task.user_ids">
                <span style="color:#6B7280; font-size:13px;"> — <t t-foreach="task.user_ids" t-as="u"><t t-if="not u_first" t-out="', '"/><t t-out="u.name"/></t></span>
            </t>
            <t t-if="task.date_deadline">
                <span style="color:#6B7280; font-size:13px;"> (échéance <t t-out="task.date_deadline.strftime('%Y-%m-%d')"/>)</span>
            </t>
        </li>
    </t>
</ul>
</t>

<p style="font-size:14px; line-height:22px; color:#6B7280; margin:28px 0 0 0;">
    N'hésitez pas à répondre à ce courriel pour toute correction ou précision.
</p>

<p style="font-size:16px; line-height:26px; color:#374151; margin:24px 0 0 0;">
    Cordialement,<br/>
    <t t-out="user.name"/>
</p>
            </field>
            <field name="report_template_ids" eval="[(4, ref('bf_meeting.action_report_meeting_record'))]"/>
        </record>

    </data>
</odoo>
