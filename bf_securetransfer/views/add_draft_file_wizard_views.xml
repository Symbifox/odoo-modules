<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="add_draft_file_wizard_view_form" model="ir.ui.view">
        <field name="name">secure.transfer.add.file.wizard.form</field>
        <field name="model">secure.transfer.add.file.wizard</field>
        <field name="arch" type="xml">
            <form string="Add a file">
                <field name="transfer_state" invisible="1"/>
                <!-- ⚠ Sur UNE ligne : un texte de vue réparti sur plusieurs
                     lignes devient un msgid qui porte son indentation. -->
                <div class="alert alert-secondary" role="alert">
                    The file joins this draft without touching what is already there, and nothing is sent: the draft stays a draft until you send it. Your copy is removed from Odoo once the upload is confirmed, and the addition is written to the access trail.
                </div>
                <group>
                    <field name="transfer_id" readonly="1"/>
                </group>
                <group string="Files">
                    <field name="attachment_ids" widget="many2many_binary"
                           nolabel="1" colspan="2"/>
                    <div colspan="2" class="text-muted">
                        <field name="upload_hint" nolabel="1" readonly="1"/>
                    </div>
                </group>
                <footer>
                    <button string="Add" name="action_add" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
