<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Credential Form View -->
    <record id="credential_view_form" model="ir.ui.view">
        <field name="name">project.credential.form</field>
        <field name="model">project.credential</field>
        <field name="arch" type="xml">
            <form string="Identifiant">
                <header>
                    <button name="action_verify" type="object" string="Vérifier"
                            class="oe_highlight" invisible="state == 'revoked'"/>
                    <button name="action_rotate_password" type="object" string="Rotation du mot de passe"
                            invisible="state == 'revoked'"/>
                    <button name="action_revoke" type="object" string="Révoquer"
                            invisible="state == 'revoked'" confirm="Êtes-vous sûr de vouloir révoquer cet identifiant ?"/>
                    <button name="action_reactivate" type="object" string="Réactiver"
                            invisible="state != 'revoked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expiring,expired,revoked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Restreint" bg_color="text-bg-warning"
                            invisible="not restricted"/>
                    <widget name="web_ribbon" title="Expiré" bg_color="text-bg-danger"
                            invisible="not is_expired"/>
                    <widget name="web_ribbon" title="2e facteur sans relève" bg_color="text-bg-warning"
                            invisible="mfa_state != 'at_risk' or is_expired"/>
                    <widget name="web_ribbon" title="Expire bientôt" bg_color="text-bg-warning"
                            invisible="not is_expiring_soon or is_expired"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="ex. : Base de données production"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="environment"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="expiration_date"/>
                            <field name="restricted"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Identifiants" name="credentials">
                            <group>
                                <group>
                                    <field name="show_url" invisible="1"/>
                                    <field name="show_domain" invisible="1"/>
                                    <field name="show_api_key" invisible="1"/>
                                    <field name="show_key_file" invisible="1"/>
                                    <field name="url" widget="url" invisible="not show_url"
                                           placeholder="https://exemple.com/login"/>
                                    <field name="domain" invisible="not show_domain"
                                           placeholder="DOMAINE ou locataire.onmicrosoft.com"/>
                                    <field name="username" placeholder="utilisateur@exemple.com"/>
                                    <field name="password" widget="copyable_password"/>
                                    <field name="api_key" widget="copyable_password" invisible="not show_api_key"/>
                                </group>
                                <group>
                                    <field name="last_verified" readonly="1"/>
                                    <field name="last_rotated" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Fichiers" name="files" invisible="not show_key_file">
                            <group>
                                <group>
                                    <field name="key_file" filename="key_filename"/>
                                    <field name="key_filename" invisible="1"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Formats supportés :</strong> .pem, .key, .p12, .ppk, .cer, .crt
                            </div>
                        </page>
                        <page string="Deuxième facteur" name="mfa">
                            <div class="alert alert-info" role="alert">
                                Ce registre dit <strong>où</strong> vit le deuxième facteur et
                                <strong>qui</strong> peut produire un code. Il ne garde jamais la
                                graine : rangée ici, elle serait dans la même base que le mot de
                                passe qu'elle protège, ce qui ne laisserait qu'un seul facteur.
                            </div>
                            <group>
                                <group>
                                    <field name="mfa_type"/>
                                    <field name="mfa_vault_id"
                                           invisible="mfa_type in ('unknown', 'none')"
                                           options="{'no_quick_create': True}"/>
                                    <field name="mfa_reference"
                                           invisible="mfa_type in ('unknown', 'none')"
                                           placeholder="ex. : élément « Serveur de production » du coffre"/>
                                    <field name="mfa_item_url" widget="url"
                                           readonly="1" invisible="not mfa_item_url"/>
                                </group>
                                <group>
                                    <field name="mfa_holder_ids" widget="many2many_tags"
                                           invisible="mfa_type in ('unknown', 'none')"
                                           options="{'no_create': True}"/>
                                    <field name="mfa_holder_note"
                                           invisible="mfa_type in ('unknown', 'none')"
                                           placeholder="ex. : jeton dans le tiroir de la réception"/>
                                    <field name="mfa_recovery"
                                           invisible="mfa_type in ('unknown', 'none')"/>
                                    <field name="mfa_last_reviewed"/>
                                    <field name="mfa_state" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="mfa_state != 'at_risk'">
                                Ce deuxième facteur n'a personne de nommé pour le produire, ou
                                aucune reprise écrite. Le jour où son porteur disparaît, l'accès
                                est bloqué.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Instructions ou informations supplémentaires..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Credential List View -->
    <record id="credential_view_list" model="ir.ui.view">
        <field name="name">project.credential.list</field>
        <field name="model">project.credential</field>
        <field name="arch" type="xml">
            <!-- L'orange dit « ça demande de l'attention », sans préciser
                 laquelle : l'expiration proche OU un deuxième facteur sans
                 relève. La colonne « État du 2e facteur » dit laquelle des
                 deux, et une seule décoration par couleur est possible. -->
            <list string="Identifiants" decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring' or mfa_state == 'at_risk'"
                  decoration-muted="state == 'revoked'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="type_id"/>
                <field name="environment" optional="show"/>
                <field name="username"/>
                <field name="url" widget="url" optional="hide"/>
                <field name="expiration_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state == 'revoked'"/>
                <field name="restricted" optional="hide"/>
                <field name="mfa_type" optional="hide"/>
                <field name="mfa_state" widget="badge" optional="show"
                       decoration-success="mfa_state == 'covered'"
                       decoration-warning="mfa_state == 'at_risk'"
                       decoration-info="mfa_state == 'unknown'"
                       decoration-muted="mfa_state == 'absent'"/>
            </list>
        </field>
    </record>

    <!-- Credential Kanban View -->
    <record id="credential_view_kanban" model="ir.ui.view">
        <field name="name">project.credential.kanban</field>
        <field name="model">project.credential</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="type_id">
                <field name="name"/>
                <field name="project_id"/>
                <field name="type_id"/>
                <field name="username"/>
                <field name="state"/>
                <field name="restricted"/>
                <field name="is_expiring_soon"/>
                <field name="is_expired"/>
                <field name="environment"/>
                <field name="mfa_state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <span t-if="record.restricted.raw_value" class="badge text-bg-warning">
                                <i class="fa fa-lock"/> Restreint
                            </span>
                        </div>
                        <div class="text-muted">
                            <field name="project_id"/>
                        </div>
                        <div t-if="record.username.value" title="Nom d'utilisateur">
                            <i class="fa fa-user" title="Nom d'utilisateur"/> <field name="username"/>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span class="badge" t-attf-class="#{record.state.raw_value == 'active' ? 'text-bg-success' : record.state.raw_value == 'expiring' ? 'text-bg-warning' : record.state.raw_value == 'expired' ? 'text-bg-danger' : 'text-bg-secondary'}">
                                <field name="state"/>
                            </span>
                            <span class="badge text-bg-info">
                                <field name="environment"/>
                            </span>
                            <span t-if="record.mfa_state.raw_value == 'at_risk'"
                                  class="badge text-bg-warning" title="Deuxième facteur sans relève">
                                <i class="fa fa-shield" title="Deuxième facteur sans relève"/> Sans relève
                            </span>
                            <span t-if="record.mfa_state.raw_value == 'unknown'"
                                  class="badge text-bg-light" title="Deuxième facteur à documenter">
                                <i class="fa fa-question" title="Deuxième facteur à documenter"/> 2e facteur ?
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Credential Search View -->
    <record id="credential_view_search" model="ir.ui.view">
        <field name="name">project.credential.search</field>
        <field name="model">project.credential</field>
        <field name="arch" type="xml">
            <search string="Identifiants">
                <field name="name"/>
                <field name="project_id"/>
                <field name="type_id"/>
                <field name="username"/>
                <field name="url"/>
                <field name="reference"/>
                <separator/>
                <filter string="Actif" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Expire bientôt" name="filter_expiring" domain="[('state', '=', 'expiring')]"/>
                <filter string="Expiré" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Révoqué" name="filter_revoked" domain="[('state', '=', 'revoked')]"/>
                <separator/>
                <filter string="Production" name="filter_production" domain="[('environment', '=', 'production')]"/>
                <filter string="Pré-production" name="filter_staging" domain="[('environment', '=', 'staging')]"/>
                <filter string="Développement" name="filter_development" domain="[('environment', '=', 'development')]"/>
                <separator/>
                <filter string="Restreint" name="filter_restricted" domain="[('restricted', '=', True)]"/>
                <separator/>
                <filter string="2e facteur à documenter" name="filter_mfa_unknown"
                        domain="[('mfa_state', '=', 'unknown')]"/>
                <filter string="2e facteur sans relève" name="filter_mfa_at_risk"
                        domain="[('mfa_state', '=', 'at_risk')]"/>
                <filter string="Sans deuxième facteur" name="filter_mfa_absent"
                        domain="[('mfa_state', '=', 'absent')]"/>
                <filter string="2e facteur couvert" name="filter_mfa_covered"
                        domain="[('mfa_state', '=', 'covered')]"/>
                <!-- La vraie liste de départ avant un congé ou un départ : un
                     facteur chez un porteur que personne d'autre ne peut
                     ouvrir. Deux des cinq porteurs semés sont dans ce cas,
                     l'appareil d'une personne et le jeton matériel. -->
                <filter string="Porteur à détenteur unique" name="filter_mfa_sole_holder"
                        domain="[('mfa_vault_id.shared', '=', False)]"/>
                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter string="Projet" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Environnement" name="group_environment" context="{'group_by': 'environment'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Deuxième facteur" name="group_mfa_type" context="{'group_by': 'mfa_type'}"/>
                    <filter string="État du 2e facteur" name="group_mfa_state" context="{'group_by': 'mfa_state'}"/>
                    <filter string="Porteur du facteur" name="group_mfa_vault" context="{'group_by': 'mfa_vault_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Credential Action -->
    <record id="credential_action" model="ir.actions.act_window">
        <field name="name">Identifiants</field>
        <field name="res_model">project.credential</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="credential_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un identifiant
            </p>
            <p>
                Stocker et gérer les identifiants des ressources de projet de manière sécurisée.
                Les mots de passe et clés API sont chiffrés au repos.
            </p>
        </field>
    </record>

    <!-- Credential Rotate Wizard Form View -->
    <record id="credential_rotate_wizard_view_form" model="ir.ui.view">
        <field name="name">project.credential.rotate.wizard.form</field>
        <field name="model">project.credential.rotate.wizard</field>
        <field name="arch" type="xml">
            <form string="Rotation de mot de passe">
                <group>
                    <group>
                        <field name="credential_id" invisible="1"/>
                        <field name="credential_name"/>
                        <field name="project_id"/>
                    </group>
                    <group>
                        <field name="current_password" password="True" readonly="1"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="new_password" password="True"/>
                        <field name="confirm_password" password="True"/>
                    </group>
                    <group>
                        <field name="rotation_reason"/>
                    </group>
                </group>
                <group>
                    <field name="notes" placeholder="Notes optionnelles sur cette rotation..."/>
                </group>
                <footer>
                    <button name="action_rotate" type="object" string="Rotation du mot de passe" class="oe_highlight"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
