            <field name="notes">&lt;p&gt;Microsoft 365 and Google Workspace backup solution.&lt;/p&gt;</field>
        </record>

        <!-- Hostinger (SaaS) -->
        <record id="software_hostinger" model="hosting.software">
            <field name="name">Hostinger</field>
            <field name="code">HG</field>
            <field name="software_type">saas</field>
            <field name="notes">&lt;p&gt;Web hosting provider (SaaS).&lt;/p&gt;</field>
        </record>

        <!-- Software Versions -->

        <!-- Odoo versions -->
        <record id="version_odoo_18" model="hosting.software.version">
            <field name="software_id" ref="software_odoo"/>
            <field name="version">18.0</field>
            <field name="release_date">2024-10-01</field>
            <field name="is_lts" eval="False"/>
            <field name="support_status">supported</field>
            <field name="update_impact">major</field>
        </record>
        <record id="version_odoo_17" model="hosting.software.version">
            <field name="software_id" ref="software_odoo"/>
            <field name="version">17.0</field>
            <field name="release_date">2023-10-01</field>
            <field name="is_lts" eval="True"/>
            <field name="support_status">supported</field>
            <field name="update_impact">major</field>
        </record>
        <record id="version_odoo_16" model="hosting.software.version">
            <field name="software_id" ref="software_odoo"/>
            <field name="version">16.0</field>
            <field name="release_date">2022-10-01</field>
            <field name="is_lts" eval="False"/>
