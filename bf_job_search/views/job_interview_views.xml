<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_job_interview_view_form" model="ir.ui.view">
        <field name="name">bf.job.interview.form</field>
        <field name="model">bf.job.interview</field>
        <field name="arch" type="xml">
            <form string="Interview">
                <header>
                    <button name="action_prepared" type="object" string="Prepared" class="btn-primary"
                            invisible="prep_progress == 100"/>
                    <button name="action_add_to_calendar" type="object" string="Add to my calendar"
                            invisible="calendar_event_id or not date_start"/>
                    <button name="action_thanked" type="object" string="Thank-you sent"
                            invisible="thanked_date or not date_start"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="application_id" options="{'no_create': True}"
                                   placeholder="Application"/></h1>
                        <field name="employer"/>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="date_start"/>
                            <field name="duration" widget="float_time"/>
                            <field name="location"/>
                            <field name="calendar_event_id" invisible="not calendar_event_id"/>
                        </group>
                        <group>
                            <field name="interviewers" placeholder="Jane Doe &lt;jane@example.com&gt;"/>
                            <field name="thanked_date" invisible="not thanked_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preparation" name="prep">
                            <group>
                                <field name="prep_progress" widget="progressbar"/>
                                <field name="prep_research"/>
                                <field name="prep_star"/>
                                <field name="prep_questions"/>
                                <field name="prep_referees"/>
                                <field name="prep_logistics"/>
                            </group>
                        </page>
                        <page string="After the interview" name="after">
                            <field name="note" placeholder="One or two points from the conversation, written right after."/>
                            <separator string="Thank-you draft, one per interviewer"/>
                            <div class="text-muted mb-2">
                                By email, the next day. A few sentences: thank them, recall one point,
                                confirm your interest. Copy it into your mailbox and replace the brackets.
                            </div>
                            <field name="thank_you_draft" class="o_bf_job_draft"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_job_interview_view_list" model="ir.ui.view">
        <field name="name">bf.job.interview.list</field>
        <field name="model">bf.job.interview</field>
        <field name="arch" type="xml">
            <list string="Interviews">
                <field name="date_start"/>
                <field name="employer"/>
                <field name="position"/>
                <field name="kind"/>
                <field name="prep_progress" widget="progressbar"/>
                <field name="thanked_date"/>
            </list>
        </field>
    </record>

    <record id="bf_job_interview_view_calendar" model="ir.ui.view">
        <field name="name">bf.job.interview.calendar</field>
        <field name="model">bf.job.interview</field>
        <field name="arch" type="xml">
            <calendar string="Interviews" date_start="date_start" mode="month" quick_create="0">
                <field name="employer"/>
                <field name="kind"/>
            </calendar>
        </field>
    </record>

    <record id="bf_job_interview_action" model="ir.actions.act_window">
        <field name="name">Interviews</field>
        <field name="res_model">bf.job.interview</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No interview yet</p>
            <p>Add one from its application: the preparation and the thank-you note are scheduled for you.</p>
        </field>
    </record>
</odoo>
