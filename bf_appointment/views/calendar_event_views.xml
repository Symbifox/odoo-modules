<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Un événement d'agenda qui tient une réservation mène à
      elle. Réservé aux utilisateurs des rendez-vous : un compte agenda sans ce
      droit tomberait sur un refus d'accès en cliquant.
    -->
    <record id="view_calendar_event_form_booking" model="ir.ui.view">
        <field name="name">calendar.event.form.bf.booking</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_bf_open_bookings" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        groups="resource_booking.group_user"
                        invisible="bf_booking_count == 0">
                    <field name="bf_booking_count" widget="statinfo" string="Rendez-vous"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
