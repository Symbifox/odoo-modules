<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_note_task_wizard_form" model="ir.ui.view">
        <field name="name">bf.note.task.wizard.form</field>
        <field name="model">bf.note.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Convertir en tâche">
                <group>
                    <group>
                        <field name="project_id" options="{'no_create_edit': True}"/>
                        <field name="stage_id"
                               options="{'no_create': True}"
                               invisible="not project_id"/>
                        <field name="parent_id"
                               options="{'no_create': True}"
                               invisible="not project_id"/>
                        <field name="partner_id" options="{'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="user_ids"
                               widget="many2many_avatar_user"
                               options="{'no_create': True}"/>
                        <field name="date_deadline"/>
                        <field name="tag_ids"
                               widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </group>
                </group>
                <group>
                    <field name="name"/>
                </group>
                <field name="description"
                       widget="html"
                       placeholder="Description de la tâche…"/>
                <group>
                    <group>
                        <field name="link_back"/>
                        <field name="archive_note"/>
                    </group>
                    <group>
                        <field name="open_task"/>
                    </group>
                </group>
                <field name="note_id" invisible="1"/>
                <footer>
                    <button name="action_create"
                            type="object"
                            string="Créer la tâche"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
