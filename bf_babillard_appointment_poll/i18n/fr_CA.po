#. module: bf_babillard_appointment_poll
#. odoo-python
#: code:addons/bf_babillard_appointment_poll/models/pont.py:0
msgid "An availability poll is looking for answers: %(nom)s."
msgstr "Un sondage de disponibilités cherche des réponses : %(nom)s."

#. module: bf_babillard_appointment_poll
#: model_terms:ir.ui.view,arch_db:bf_babillard_appointment_poll.view_appointment_poll_form_babillard
msgid "Announce on the noticeboard"
msgstr "Annoncer au babillard"

#. module: bf_babillard_appointment_poll
#. odoo-python
#: code:addons/bf_babillard_appointment_poll/models/pont.py:0
msgid "Each person answers through their own link: ask %(qui)s for yours."
msgstr ""
"Chaque personne répond par son propre lien : demandez le vôtre à %(qui)s."

#. module: bf_babillard_appointment_poll
#. odoo-python
#: code:addons/bf_babillard_appointment_poll/models/pont.py:0
msgid "Give my availability"
msgstr "Donner mes disponibilités"

#. module: bf_babillard_appointment_poll
#. odoo-python
#: code:addons/bf_babillard_appointment_poll/models/pont.py:0
msgid "It closes on %(quand)s."
msgstr "Il ferme le %(quand)s."

#. module: bf_babillard_appointment_poll
#. odoo-python
#: code:addons/bf_babillard_appointment_poll/models/pont.py:0
msgid "Only a poll in progress can be announced: this one is \"%(etat)s\"."
msgstr "Seul un sondage en cours s'annonce : celui-ci est « %(etat)s »."

#. module: bf_babillard_appointment_poll
#. odoo-python
#: code:addons/bf_babillard_appointment_poll/models/pont.py:0
msgid "Only the editors post on the noticeboard."
msgstr "Seule la rédaction publie au babillard."

#. module: bf_babillard_appointment_poll
#: model:ir.module.module,shortdesc:base.module_bf_babillard_appointment_poll
msgid "Noticeboard: availability poll"
msgstr "Babillard : sondage de disponibilités"

#. module: bf_babillard_appointment_poll
#: model:ir.module.module,summary:base.module_bf_babillard_appointment_poll
msgid "Announce in the feed that an availability poll is looking for answers"
msgstr "Annoncer au fil qu'un sondage de dates cherche des réponses"
