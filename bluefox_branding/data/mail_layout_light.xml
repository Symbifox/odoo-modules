<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Branded card for system emails (18.0.3.26.0)                        -->
    <!-- Dark header with the brand logo, accent bar, the caller's content   -->
    <!-- (t-call body, rendered as `0`), company footer, double accent.      -->
    <!-- Reads `company` only: the light layout, the password reset and the  -->
    <!-- new device alert render with a minimal context, without             -->
    <!-- is_html_empty, subtype, signature or tracking values. bf_mail_layout -->
    <!-- needs those, which is why it cannot serve here.                     -->
    <!-- The caller wraps the card in its own outer table (#F8FAFC).         -->
    <!-- ================================================================== -->
    <template id="bf_mail_card" name="Branded card for system emails">
        <t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
        <t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
        <t t-set="brand_font_stack" t-value="((company and company.font) or 'Lexend') + &quot;,'Segoe UI',Arial,sans-serif&quot;"/>
        <t t-set="brand_tagline" t-value="(company and (company.brand_email_tagline or company.report_header)) or ''"/>
        <!-- No is_html_empty in this context: an editor-emptied footer (<p><br></p>) has no text,
             a footer made of an image alone has none either and still counts. -->
        <t t-set="brand_footer_html" t-value="company and company.brand_email_footer_html"/>
        <t t-set="brand_footer_has_text" t-value="bool(brand_footer_html and ('&lt;img' in brand_footer_html or brand_footer_html.striptags().strip()))"/>

        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px;max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,0.08);">
            <tbody>

                <!-- Header -->
                <tr>
                    <td t-attf-style="background-color:{{ brand_dark }};padding:20px 32px;border-radius:16px 16px 0 0;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tbody>
                                <tr>
                                    <td align="left">
                                        <t t-if="company">
                                            <a t-att-href="company.website or '#'" style="text-decoration:none;">
                                                <img t-attf-src="/brand/logo/{{ company.id }}/brand" t-att-alt="company.name" style="height:44px;width:auto;display:block;border:0;" height="44"/>
                                            </a>
                                        </t>
                                    </td>
                                    <td align="right" t-attf-style="color:#E6EDF3;font-family:{{ brand_font_stack }};font-size:14px;font-weight:400;letter-spacing:0.3px;">
                                        <t t-if="company" t-out="company.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>

                <!-- Accent bar -->
                <tr>
                    <td t-attf-style="height:4px;line-height:4px;background-color:{{ brand_primary }};">&#160;</td>
                </tr>

                <!-- Content -->
                <tr>
                    <td t-attf-style="padding:24px 32px;font-family:{{ brand_font_stack }};font-size:15px;line-height:24px;color:#374151;font-weight:300;">
                        <t t-out="0"/>
                    </td>
                </tr>

                <!-- Divider -->
                <tr>
                    <td style="padding:0 32px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tbody><tr><td style="height:1px;line-height:1px;background-color:#E5E7EB;">&#160;</td></tr></tbody>
                        </table>
                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="padding:24px 32px 28px 32px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tbody>
                                <tr>
                                    <td t-attf-style="font-family:{{ brand_font_stack }};font-size:13px;color:#6B7280;line-height:20px;">
                                        <strong t-attf-style="color:{{ brand_dark }};font-size:14px;"><t t-if="company" t-out="company.name"/></strong>
                                        <t t-if="brand_tagline">
                                            <br/><span t-out="brand_tagline"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td t-attf-style="padding-top:12px;font-family:{{ brand_font_stack }};font-size:12px;color:#9CA3AF;line-height:18px;">
                                        <t t-if="brand_footer_has_text" t-out="brand_footer_html"/>
                                        <t t-elif="company">
                                            <a t-if="company.email" t-attf-href="mailto:{{ company.email }}" t-attf-style="color:{{ brand_primary }};text-decoration:none;" t-out="company.email"/>
                                            <t t-if="company.email and company.phone"><span style="color:#D1D5DB;"> &#183; </span></t>
                                            <a t-if="company.phone" t-attf-href="tel:{{ company.phone }}" t-attf-style="color:{{ brand_primary }};text-decoration:none;" t-out="company.phone"/>
                                            <t t-if="(company.email or company.phone) and company.website"><span style="color:#D1D5DB;"> &#183; </span></t>
                                            <a t-if="company.website" t-att-href="company.website" t-attf-style="color:{{ brand_primary }};text-decoration:none;" t-out="company.website"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr t-if="company and (company.brand_privacy_url or company.brand_terms_url)">
                                    <td t-attf-style="padding-top:12px;font-family:{{ brand_font_stack }};font-size:11px;">
                                        <a t-if="company.brand_privacy_url" t-att-href="company.brand_privacy_url" style="color:#9CA3AF;text-decoration:underline;">Privacy</a>
                                        <t t-if="company.brand_privacy_url and company.brand_terms_url"><span style="color:#D1D5DB;"> | </span></t>
                                        <a t-if="company.brand_terms_url" t-att-href="company.brand_terms_url" style="color:#9CA3AF;text-decoration:underline;">Terms</a>
                                    </td>
                                </tr>
                                <!-- Odoo personalises this link for a follower who may unfollow, and removes
                                     the span for everyone else (mail.mail._personalize_outgoing_body).
                                     No span inside it: the removal stops at the first closing span. -->
                                <tr>
                                    <td t-attf-style="font-family:{{ brand_font_stack }};font-size:11px;">
                                        <span id="mail_unfollow"><a href="/mail/unfollow" style="color:#9CA3AF;text-decoration:underline;">Unfollow</a></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>

            </tbody>
        </table>

        <!-- Bottom double accent -->
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px;max-width:600px;margin:12px auto 0;">
            <tbody>
                <tr>
                    <td t-attf-style="height:3px;line-height:3px;background-color:{{ brand_primary }};width:50%;border-radius:2px 0 0 2px;">&#160;</td>
                    <td t-attf-style="height:3px;line-height:3px;background-color:{{ brand_dark }};width:50%;border-radius:0 2px 2px 0;">&#160;</td>
                </tr>
            </tbody>
        </table>
    </template>

    <!-- ================================================================== -->
    <!-- Odoo's "light" layout, in the brand (18.0.3.26.0)                   -->
    <!-- Named in Python by the security notices (_notify_security_setting_  -->
    <!-- update), the 2FA code and invitation, the unregistered users        -->
    <!-- reminder, and by some twenty modules (project sharing, surveys,     -->
    <!-- ratings, calendar, payment, helpdesk...). None of these paths goes  -->
    <!-- through a mail.template we could rewrite: the layout is the one     -->
    <!-- place they share.                                                   -->
    <!-- Only reads what every path provides: company, message,              -->
    <!-- model_description, has_button_access, button_access.                -->
    <!-- The first table keeps role="presentation": hr_recruitment extends   -->
    <!-- this layout with //t//table[@role='presentation'].                  -->
    <!-- The chatter layout (mail.mail_notification_layout) stays Odoo's.    -->
    <!-- ================================================================== -->
    <!-- priority 99: whatever extends the original body later applies BEFORE this
         replacement, never against it. -->
    <template id="mail_notification_light"
              inherit_id="mail.mail_notification_light"
              priority="99"
              name="Light mail layout: brand">
        <xpath expr="//body" position="replace">
            <t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
            <t t-set="brand_font_stack" t-value="((company and company.font) or 'Lexend') + &quot;,'Segoe UI',Arial,sans-serif&quot;"/>
            <body t-attf-style="margin:0;padding:0;background-color:#F8FAFC;font-family:{{ brand_font_stack }};color:#454748;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
                <t t-set="subtype_internal" t-value="False"/>
                <t t-call="mail.notification_preview"/>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F8FAFC;">
                    <tbody>
                        <tr>
                            <td align="center" style="padding:32px 16px;">
                                <t t-call="bluefox_branding.bf_mail_card">
                                    <!-- Button access (View in portal, Answer the survey...) -->
                                    <t t-if="has_button_access">
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0;">
                                            <tbody>
                                                <tr>
                                                    <td t-attf-style="border-radius:10px;background-color:{{ brand_primary }};text-align:center;">
                                                        <a t-att-href="button_access['url']" t-attf-style="display:inline-block;padding:10px 20px;font-family:{{ brand_font_stack }};font-size:14px;font-weight:600;color:#FFFFFF;text-decoration:none !important;">
                                                            <t t-out="button_access['title']"/>
                                                        </a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </t>
                                    <div t-out="message.body"/>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </body>
        </xpath>
    </template>

</odoo>
