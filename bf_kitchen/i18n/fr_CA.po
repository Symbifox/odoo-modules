msgstr "Un article paraît une seule fois par emplacement."

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/kitchen_count.py:0
msgid ""
"Another count of this warehouse is in progress: finish it first. Two counts "
"at once would set the same stock twice."
msgstr ""
"Un autre comptage de cet entrepôt est en cours : terminez-le d'abord. Deux "
"comptages à la fois poseraient deux fois le même stock."

#. module: bf_kitchen
#: model:ir.model.fields.selection,name:bf_kitchen.selection__bf_kitchen_count_step__state__applied
