<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_document_request_view_form" model="ir.ui.view">
        <field name="model">bf.document.request</field>
        <field name="arch" type="xml">
            <form string="Request for documents">
                <header>
                    <button name="action_send" type="object" string="Send by email"
                            class="btn-primary"
                            invisible="state != 'draft' or channel != 'email'"/>
                    <button name="action_send" type="object" string="Send by text message"
                            class="btn-primary"
                            invisible="state != 'draft' or channel != 'sms'"/>
                    <button name="action_resend" type="object" string="Resend by email"
                            invisible="state not in ('sent', 'partial') or channel != 'email'"/>
                    <button name="action_resend" type="object" string="Resend by text message"
                            invisible="state not in ('sent', 'partial') or channel != 'sms'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            confirm="The client's link will stop working immediately. Continue?"
                            invisible="state in ('draft', 'received', 'cancelled')"/>
                    <button name="action_print_certificate" type="object"
                            string="Access certificate (PDF)"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,partial,received"/>
                </header>
                <!-- The last link email failed: the email deletes itself
                     once sent, a failure stays. -->
                <field name="link_mail_state" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert"
                     name="link_mail_failed"
                     invisible="link_mail_state != 'failed'">
                    The last link email could not go out: check the
                    client's address, then click "Resend".
                    <div class="small">
                        This banner only sees immediate refusals from the
                        outgoing mail server: an email that was accepted, then
                        bounced later (address does not exist, mailbox full),
                        does not show here.
                    </div>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_transfer" type="object"
                                class="oe_stat_button" icon="fa-shield"
                                invisible="not transfer_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Transfer</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="channel" widget="radio" options="{'horizontal': true}"
                                   readonly="state not in ('draft', 'sent', 'partial')"/>
                            <field name="email" widget="email"
                                   invisible="channel != 'email'"
                                   readonly="state not in ('draft', 'sent', 'partial')"
                                   placeholder="name@example.com"/>
                            <field name="phone" invisible="channel != 'sms'"
                                   readonly="state not in ('draft', 'sent', 'partial')"
                                   placeholder="514 555-0123"/>
                        </group>
                        <group string="Request">
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="brand_id" readonly="state != 'draft'"/>
                            <field name="deadline" readonly="state == 'received'"
                                   options="{'show_seconds': false}"/>
                            <field name="reminder_count"
                                   invisible="state == 'draft'"/>
                            <field name="last_reminder_at"
                                   invisible="not last_reminder_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" placeholder="A note to the client, shown at the top of their page."
                               readonly="state != 'draft'" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Requested documents" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'sent', 'partial')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="document_type_id"/>
                                    <field name="required"/>
                                    <!-- Read-only: a document's status is
                                         only written by the client's
                                         upload. -->
                                    <field name="state" readonly="1"/>
                                    <field name="received_at" optional="hide"/>
                                    <field name="file_id" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="received_count"/>
                                <field name="doc_count"/>
                            </group>
                        </page>
                        <page string="Client link" name="link"
                              groups="bf_securetransfer.group_securetransfer_manager"
                              invisible="not token">
                            <group>
                                <field name="access_url" widget="CopyClipboardChar"/>
                                <field name="sent_at"/>
                                <field name="completed_at"/>
                            </group>
                            <div class="text-muted">
                                This link IS the key to the upload: it was sent to the
                                client, by email or by text message, and should not travel
                                any other way. Cancelling the request kills it on the spot.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_document_request_view_list" model="ir.ui.view">
        <field name="model">bf.document.request</field>
        <field name="arch" type="xml">
            <list string="Document requests"
                  decoration-muted="state in ('cancelled', 'expired')"
                  decoration-success="state == 'received'"
                  decoration-info="state == 'partial'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="channel" optional="show"/>
                <field name="received_count" string="Docs received"/>
                <field name="doc_count" string="Requested"/>
                <field name="deadline" options="{'show_seconds': false}"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="bf_document_request_view_search" model="ir.ui.view">
        <field name="model">bf.document.request</field>
        <field name="arch" type="xml">
            <search string="Requests">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'in', ('sent', 'partial'))]"/>
                <filter name="filter_received" string="Received requests"
                        domain="[('state', '=', 'received')]"/>
                <filter name="filter_late" string="Past deadline"
                        domain="[('state', 'in', ('sent', 'partial')),
                                 ('deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_mine" string="My requests"
                        domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Requester" context="{'group_by': 'user_id'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_document_request" model="ir.actions.act_window">
        <field name="name">Document requests</field>
        <field name="res_model">bf.document.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Request documents from a client</p>
            <p>Choose the client, tick the documents you need, send.
               They receive a link by email or by text message, photograph or
               attach their documents, and you receive them encrypted.</p>
        </field>
    </record>

    <record id="bf_document_type_view_form" model="ir.ui.view">
        <field name="model">bf.document.type</field>
        <field name="arch" type="xml">
            <form string="Document type">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Identity document"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="identity"/>
                            <field name="sequence"/>
                            <field name="two_sided"/>
                        </group>
                        <group>
                            <field name="expiry_policy_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Instructions to the client">
                        <field name="instructions" nolabel="1"
                               placeholder="Front and back, lying flat, without glare."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_document_type_view_list" model="ir.ui.view">
        <field name="model">bf.document.type</field>
        <field name="arch" type="xml">
            <list string="Document types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="expiry_policy_id"/>
                <field name="two_sided"/>
            </list>
        </field>
    </record>

    <record id="action_bf_document_type" model="ir.actions.act_window">
        <field name="name">Document types</field>
        <field name="res_model">bf.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bf_document_requests" name="Document requests"
              parent="bf_securetransfer.menu_securetransfer_root"
              action="action_bf_document_request" sequence="6"/>

    <menuitem id="menu_bf_document_types" name="Document types"
              parent="bf_securetransfer.menu_config"
              action="action_bf_document_type" sequence="30"/>

</odoo>
