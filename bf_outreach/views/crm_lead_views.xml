<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_lead_form_outreach" model="ir.ui.view">
        <field name="name">crm.lead.form.outreach</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='campaign_id']" position="after">
                <field name="outreach_campaign_id" readonly="1"
                       invisible="not outreach_campaign_id"
                       groups="bf_outreach.group_bf_outreach_user"/>
                <field name="outreach_target_id" readonly="1"
                       invisible="not outreach_target_id"
                       groups="bf_outreach.group_bf_outreach_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_search_outreach" model="ir.ui.view">
        <field name="name">crm.lead.search.outreach</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="outreach_campaign_id"
                       groups="bf_outreach.group_bf_outreach_user"/>
            </field>
            <filter name="assigned_to_me" position="after">
                <separator/>
                <filter name="from_outreach" string="Issues du démarchage"
                        domain="[('outreach_campaign_id', '!=', False)]"
                        groups="bf_outreach.group_bf_outreach_user"/>
            </filter>
        </field>
    </record>

</odoo>
