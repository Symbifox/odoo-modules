<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_meeting_record" model="report.paperformat">
        <field name="name">Compte rendu de réunion (US Letter)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_meeting_agenda" model="ir.actions.report">
        <field name="name">Ordre du jour</field>
        <field name="model">meeting.agenda</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_meeting.report_meeting_agenda_main</field>
        <field name="report_file">bf_meeting.report_meeting_agenda_main</field>
        <field name="print_report_name">object._bf_nom_fichier_pdf()</field>
        <field name="paperformat_id" ref="paperformat_meeting_record"/>
    </record>

    <record id="action_report_meeting_record" model="ir.actions.report">
        <field name="name">Compte rendu de réunion</field>
        <field name="model">meeting.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_meeting.report_meeting_record_main</field>
        <field name="report_file">bf_meeting.report_meeting_record_main</field>
        <field name="print_report_name">object._bf_nom_fichier_pdf()</field>
        <field name="paperformat_id" ref="paperformat_meeting_record"/>
    </record>

</odoo>
