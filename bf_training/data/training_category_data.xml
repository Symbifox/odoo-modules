<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Des catégories de départ, qu'on renomme ou qu'on jette. Elles ne
             sont là que pour que les quotas par sujet aient quelque chose à
             compter le premier jour. -->
        <record id="category_sst" model="bf.training.category">
            <field name="name">Santé et sécurité du travail</field>
            <field name="code">SST</field>
            <field name="sequence">10</field>
        </record>
        <record id="category_secourisme" model="bf.training.category">
            <field name="name">Secourisme</field>
            <field name="code">SEC</field>
            <field name="sequence">20</field>
        </record>
        <record id="category_metier" model="bf.training.category">
            <field name="name">Compétences du métier</field>
            <field name="code">MET</field>
            <field name="sequence">30</field>
        </record>
        <record id="category_conformite" model="bf.training.category">
            <field name="name">Conformité et vie privée</field>
            <field name="code">CONF</field>
            <field name="sequence">40</field>
        </record>
        <record id="category_accueil" model="bf.training.category">
            <field name="name">Accueil et intégration</field>
            <field name="code">ACC</field>
            <field name="sequence">50</field>
        </record>
        <record id="category_gestion" model="bf.training.category">
            <field name="name">Gestion et supervision</field>
            <field name="code">GES</field>
            <field name="sequence">60</field>
        </record>
    </data>
</odoo>
