<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regle_tournee_societe" model="ir.rule">
        <field name="name">Tournées : cloison des sociétés</field>
        <field name="model_id" ref="model_bf_nfc_round"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- ⚠️ Un agent voit ses propres tournées faites ; la gestion voit tout. -->
    <record id="regle_passage_les_miens" model="ir.rule">
        <field name="name">Passages de tournée : les miens</field>
        <field name="model_id" ref="model_bf_nfc_round_run"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bf_nfc.group_nfc_user'))]"/>
    </record>
    <record id="regle_passage_gestion" model="ir.rule">
        <field name="name">Passages de tournée : tout, pour la gestion</field>
        <field name="model_id" ref="model_bf_nfc_round_run"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bf_nfc.group_nfc_manager'))]"/>
    </record>
</odoo>
