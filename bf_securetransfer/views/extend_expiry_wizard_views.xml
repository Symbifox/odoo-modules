<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="extend_expiry_wizard_view_form" model="ir.ui.view">
        <field name="name">secure.transfer.extend.wizard.form</field>
        <field name="model">secure.transfer.extend.wizard</field>
        <field name="arch" type="xml">
            <form string="Prolonger l'échéance">
                <field name="transfer_state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="transfer_state != 'expired'">
                    Ce transfert est <strong>expiré</strong>. Le prolonger le
                    rouvrira : le lien déjà transmis recommencera à fonctionner,
                    sans qu'aucun courriel ne reparte. La prolongation est
                    inscrite au journal d'accès.
                </div>
                <div class="alert alert-secondary" role="alert" invisible="transfer_state == 'expired'">
                    La durée se compte depuis l'envoi, et se choisit parmi celles
                    que le service offre : c'est cette même grille qui fixe le
                    filet de cycle de vie du stockage. La prolongation est
                    inscrite au journal d'accès.
                </div>
                <group>
                    <field name="transfer_id" readonly="1"/>
                    <field name="current_expiry" readonly="1"/>
                    <field name="days"/>
                    <field name="new_expiry" readonly="1"/>
                </group>
                <footer>
                    <button string="Prolonger" name="action_apply" type="object"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
