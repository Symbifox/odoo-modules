<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vue_controle_liste" model="ir.ui.view">
        <field name="name">bf.oe2oc.check.list</field>
        <field name="model">bf.oe2oc.check</field>
        <field name="arch" type="xml">
            <list string="Contrôles" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'ok' or state == 'done'"
                       decoration-warning="state == 'warn'"
                       decoration-muted="state == 'na'"/>
                <field name="result"/>
                <field name="checked_on"/>
                <button name="action_run" type="object" string="Vérifier"
                        icon="fa-refresh" invisible="not automatic"/>
                <button name="action_mark_done" type="object" string="Réglé"
                        icon="fa-check" invisible="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="vue_controle_formulaire" model="ir.ui.view">
        <field name="name">bf.oe2oc.check.form</field>
        <field name="model">bf.oe2oc.check</field>
        <field name="arch" type="xml">
            <form string="Contrôle">
                <header>
                    <button name="action_run" type="object" string="Vérifier"
                            class="btn-primary" invisible="not automatic"/>
                    <button name="action_mark_done" type="object" string="Marquer réglé"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="todo,warn,ok,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category" readonly="1"/>
                            <field name="automatic" readonly="1"/>
                            <field name="key" readonly="1" groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="checked_on" readonly="1"/>
                        </group>
                    </group>
                    <group string="Ce qu'il vérifie">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Constat" invisible="not result">
                        <field name="result" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_controle" model="ir.actions.act_window">
        <field name="name">Contrôles d'après-migration</field>
        <field name="res_model">bf.oe2oc.check</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_controle_tout" model="ir.actions.server">
        <field name="name">Tout vérifier</field>
        <field name="model_id" ref="model_bf_oe2oc_check"/>
        <field name="state">code</field>
        <field name="code">action = model.action_run_all()</field>
    </record>

</odoo>
