<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_assembly_list" model="ir.ui.view">
        <field name="name">bf.property.assembly.list</field>
        <field name="model">bf.property.assembly</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'">
                <field name="date"/>
                <field name="name"/>
                <field name="syndicat_id"/>
                <field name="assembly_type"/>
                <field name="is_reconvened" optional="show"/>
                <field name="convocation_state" widget="badge"
                       decoration-success="convocation_state == 'ok'"
                       decoration-danger="convocation_state in ('late', 'early')"
                       decoration-warning="convocation_state == 'none'"/>
                <field name="votes_present" optional="show"/>
                <field name="quorum_reached" widget="boolean_toggle" readonly="1"/>
                <field name="resolution_count" string="Résolutions"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_assembly_form" model="ir.ui.view">
        <field name="name">bf.property.assembly.form</field>
        <field name="model">bf.property.assembly</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_attendance" type="object" string="Charger la feuille de présence"
                            invisible="state not in ('draft', 'convened')"/>
                    <button name="action_convene" type="object" string="Convoquer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_hold" type="object" string="Marquer tenue"
                            class="btn-primary" invisible="state != 'convened'"/>
                    <button name="action_close" type="object" string="Clôturer"
                            invisible="state != 'held'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,convened,held,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_resolutions" type="object"
                                class="oe_stat_button" icon="fa-gavel">
                            <field name="resolution_count" widget="statinfo" string="Résolutions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Assemblée annuelle 2026"/></h1>
                    </div>

                    <div class="alert alert-danger" role="alert" invisible="convocation_state != 'late'">
                        Préavis de <field name="convocation_notice_days" readonly="1" nolabel="1" class="oe_inline"/>
                        jours. L'art. 346 C.c.Q., que le syndicat rejoint par les art. 1039 et 334,
                        en exige au moins 10.
                        La déclaration peut allonger ce délai, jamais le raccourcir.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="convocation_state != 'early'">
                        Préavis de <field name="convocation_notice_days" readonly="1" nolabel="1" class="oe_inline"/>
                        jours, au-delà du maximum de 45 jours.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not participation_warning">
                        <field name="participation_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="quorum_reached or state == 'draft'">
                        Quorum non atteint : <field name="votes_present" readonly="1" nolabel="1" class="oe_inline"/>
                        voix présentes ou représentées pour <field name="quorum_required" readonly="1" nolabel="1" class="oe_inline"/>
                        requises. <field name="quorum_rule" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>

                    <group>
                        <group string="Tenue">
                            <field name="syndicat_id"/>
                            <field name="assembly_type"/>
                            <field name="date"/>
                            <field name="participation_mode"/>
                            <field name="location"
                                   invisible="participation_mode == 'remote'"/>
                            <field name="remote_means"
                                   invisible="participation_mode == 'in_person'"
                                   placeholder="Lien de visioconférence, plateforme, numéro"/>
                            <field name="remote_immediate_communication"
                                   invisible="participation_mode == 'in_person'"/>
                            <field name="remote_attendee_count"
                                   invisible="participation_mode == 'in_person'"/>
                            <field name="in_person_attendee_count"
                                   invisible="participation_mode == 'in_person'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Convocation">
                            <field name="convocation_date"/>
                            <field name="convocation_notice_days"/>
                            <field name="convocation_state"/>
                            <field name="agenda_request_deadline"/>
                        </group>
                        <group string="Reprise">
                            <field name="is_reconvened"/>
                            <field name="previous_assembly_id" invisible="not is_reconvened"/>
                        </group>
                        <group string="Quorum">
                            <field name="total_votes"/>
                            <field name="syndicat_held_votes"
                                   invisible="not syndicat_held_votes"/>
                            <field name="total_owners"/>
                            <field name="votes_present"/>
                            <field name="owners_present"/>
                            <field name="quorum_required"/>
                            <field name="quorum_reached"/>
                            <field name="quorum_rule"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Feuille de présence" name="attendance">
                            <field name="attendance_ids">
                                <list editable="bottom"
                                      decoration-muted="status == 'absent' or syndicat_held">
                                    <field name="unit_id"/>
                                    <field name="partner_id"/>
                                    <field name="ownership_share" optional="hide"/>
                                    <field name="base_votes"/>
                                    <field name="status"/>
                                    <field name="participation_mode"
                                           readonly="status == 'absent'"/>
                                    <field name="proxy_partner_id"
                                           column_invisible="0"
                                           readonly="status != 'represented'"/>
                                    <field name="mandate_refused" optional="hide"
                                           readonly="status != 'absent'"/>
                                    <field name="indivision_votes" optional="hide"/>
                                    <field name="syndicat_held" optional="hide"
                                           readonly="1"/>
                                    <field name="voting_deprived" optional="show"
                                           readonly="syndicat_held"/>
                                    <field name="vote_reduction" optional="hide"/>
                                    <field name="cap_reduction" optional="hide"/>
                                    <field name="cap_rule" optional="hide"/>
                                    <field name="withheld_votes" optional="hide"
                                           sum="Voix retranchées"/>
                                    <field name="votes" sum="Voix retenues"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Résolutions" name="resolutions">
                            <field name="resolution_ids" context="{'default_assembly_id': id}">
                                <list decoration-success="result == 'adopted'"
                                      decoration-danger="result == 'rejected'"
                                      decoration-muted="result == 'pending'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="majority_type"/>
                                    <field name="ballot_mode"/>
                                    <field name="votes_for"/>
                                    <field name="votes_against"/>
                                    <field name="votes_abstain"/>
                                    <field name="result" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Procès-verbal" name="minutes">
                            <div class="mb-2">
                                <button name="action_append_participation_to_minutes"
                                        type="object" class="btn btn-secondary"
                                        string="Ajouter le mode de tenue au PV"/>
                            </div>
                            <group>
                                <group string="Transmission (art. 1102.1)">
                                    <field name="minutes_deadline"/>
                                    <field name="minutes_sent_date"/>
                                    <field name="minutes_state"/>
                                </group>
                            </group>
                            <field name="minutes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_assembly_search" model="ir.ui.view">
        <field name="name">bf.property.assembly.search</field>
        <field name="model">bf.property.assembly</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="syndicat_id"/>
                <filter name="no_quorum" string="Quorum non atteint"
                        domain="[('quorum_reached', '=', False)]"/>
                <filter name="bad_notice" string="Avis non conforme"
                        domain="[('convocation_state', 'in', ('late', 'early'))]"/>
                <filter name="remote" string="Tenue à distance ou hybride"
                        domain="[('participation_mode', 'in', ('remote', 'hybrid'))]"/>
                <filter name="mode_fault" string="Défaut de mode"
                        domain="[('participation_warning', '!=', False)]"/>
                <filter name="open" string="En cours"
                        domain="[('state', 'not in', ('closed',))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_syndicat" string="Syndicat"
                            context="{'group_by': 'syndicat_id'}"/>
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_mode" string="Mode de tenue"
                            context="{'group_by': 'participation_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assembly" model="ir.actions.act_window">
        <field name="name">Assemblées</field>
        <field name="res_model">bf.property.assembly</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
