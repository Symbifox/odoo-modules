<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_mass_note_wizard_view_form" model="ir.ui.view">
        <field name="name">bf.mass.note.wizard.form</field>
        <field name="model">bf.mass.note.wizard</field>
        <field name="arch" type="xml">
            <form string="Add a note in bulk">
                <group>
                    <field name="model_name" invisible="1"/>
                    <field name="model_label" string="Model" readonly="1"/>
                    <field name="record_count" string="Selected records" readonly="1"/>
                    <field name="post_type" widget="radio"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="post_type != 'comment'">
                    A "Message" will be posted on the thread of each selected record and will notify its followers. Depending on the configuration, this may send emails.
                </div>
                <field name="confirm_message" invisible="post_type != 'comment'"/>
                <separator string="Content"/>
                <field name="body" nolabel="1"
                       placeholder="Type the note to post on all the selected records…"/>
                <footer>
                    <button name="action_post" string="Post" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
