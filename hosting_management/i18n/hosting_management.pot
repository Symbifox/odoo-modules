"                                  How to reach us\n"
"                                </p>\n"
"                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                  <tbody>\n"
"                                    <tr>\n"
"                                      <td style=\"padding:6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;color:#374151;font-weight:300;\">\n"
"                                        Email:\n"
"                                        <a t-attf-href=\"mailto:{{ ctx.get('support_email') or company.email or '' }}\" t-attf-style=\"color:{{ brand_primary }};text-decoration:none;font-weight:400;\">\n"
"                                          <t t-out=\"ctx.get('support_email') or company.email or ''\"/>\n"
"                                        </a>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                      <td style=\"padding:6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;color:#374151;font-weight:300;\">\n"
"                                        Phone:\n"
"                                        <a t-attf-href=\"tel:{{ ctx.get('support_phone') or company.phone or '' }}\" t-attf-style=\"color:{{ brand_primary }};text-decoration:none;font-weight:400;\">\n"
"                                          <t t-out=\"ctx.get('support_phone') or company.phone or ''\"/>\n"
"                                        </a>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                    <t t-if=\"ctx.get('portal_url')\">\n"
"                                      <tr>\n"
"                                        <td style=\"padding:6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;color:#374151;font-weight:300;\">\n"
"                                          Customer portal:\n"
"                                          <a t-attf-href=\"{{ ctx.get('portal_url') }}\" t-attf-style=\"color:{{ brand_primary }};text-decoration:none;font-weight:400;\">\n"
"                                            Go to the portal\n"
"                                          </a>\n"
"                                        </td>\n"
"                                      </tr>\n"
"                                    </t>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- CTA Button -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:28px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td align=\"center\">\n"
"                                <a t-attf-href=\"{{ ctx.get('cta_url') or company.website or object.get_base_url() }}\" t-attf-style=\"display:inline-block;padding:14px 36px;background-color:{{ brand_primary }};color:#ffffff;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:600;text-decoration:none;border-radius:10px;\">\n"
"                                  Discover our services\n"
"                                </a>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
