<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_training" model="ir.module.category">
            <field name="name">Registre de formation</field>
            <field name="description">Qui doit quelle formation, et qui l'a faite.</field>
            <field name="sequence">40</field>
        </record>

        <record id="group_training_officer" model="res.groups">
            <field name="name">Agent</field>
            <field name="category_id" ref="module_category_training"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Tient le registre : saisit les réalisations, assigne, relance.</field>
        </record>

        <record id="group_training_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="category_id" ref="module_category_training"/>
            <field name="implied_ids" eval="[(4, ref('bf_training.group_training_officer'))]"/>
            <!-- ⚠️ Sans cette ligne, personne n'est dans le groupe au lendemain de
                 l'installation : les menus existent, les vues refusent de s'ouvrir,
                 et le module a l'air cassé alors qu'il est seulement fermé. Constaté
                 en jouant `get_views` après la pose, ce qu'aucun essai Python ne
                 voit. L'administrateur entre d'office ; le reste se distribue à la
                 main. -->
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Écrit les exigences et les plans, et répond de la conformité.</field>
        </record>

        <record id="rule_training_activity_company" model="ir.rule">
            <field name="name">Activités de formation : société</field>
            <field name="model_id" ref="model_bf_training_activity"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_training_requirement_company" model="ir.rule">
            <field name="name">Exigences de formation : société</field>
            <field name="model_id" ref="model_bf_training_requirement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_training_plan_company" model="ir.rule">
            <field name="name">Plans de formation : société</field>
            <field name="model_id" ref="model_bf_training_plan"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_training_obligation_company" model="ir.rule">
            <field name="name">Obligations : société</field>
            <field name="model_id" ref="model_bf_training_obligation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_training_assignment_company" model="ir.rule">
            <field name="name">Assignations : société</field>
            <field name="model_id" ref="model_bf_training_assignment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_training_record_company" model="ir.rule">
            <field name="name">Réalisations : société</field>
            <field name="model_id" ref="model_bf_training_record"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Une personne voit ses propres formations, et rien de celles des autres.
             Les deux règles qui suivent s'additionnent pour qui porte les deux
             groupes : l'agent voit tout, l'employé ordinaire voit son dossier. -->
        <record id="rule_training_record_own" model="ir.rule">
            <field name="name">Réalisations : les miennes</field>
            <field name="model_id" ref="model_bf_training_record"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_training_record_officer" model="ir.rule">
            <field name="name">Réalisations : agent du registre</field>
            <field name="model_id" ref="model_bf_training_record"/>
            <field name="groups" eval="[(4, ref('bf_training.group_training_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_training_obligation_own" model="ir.rule">
            <field name="name">Obligations : les miennes</field>
            <field name="model_id" ref="model_bf_training_obligation"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_training_obligation_officer" model="ir.rule">
            <field name="name">Obligations : agent du registre</field>
            <field name="model_id" ref="model_bf_training_obligation"/>
            <field name="groups" eval="[(4, ref('bf_training.group_training_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_training_assignment_own" model="ir.rule">
            <field name="name">Assignations : les miennes</field>
            <field name="model_id" ref="model_bf_training_assignment"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_training_assignment_officer" model="ir.rule">
            <field name="name">Assignations : agent du registre</field>
            <field name="model_id" ref="model_bf_training_assignment"/>
            <field name="groups" eval="[(4, ref('bf_training.group_training_officer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
