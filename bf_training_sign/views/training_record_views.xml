<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_record_form_sign" model="ir.ui.view">
        <field name="name">bf.training.record.form.sign</field>
        <field name="model">bf.training.record</field>
        <field name="inherit_id" ref="bf_training.view_training_record_form"/>
        <field name="arch" type="xml">
            <field name="certificate_number" position="after">
                <field name="document_version_id" readonly="1"
                       invisible="not document_version_id"/>
                <field name="distribution_id" readonly="1"
                       invisible="not distribution_id"/>
            </field>
        </field>
    </record>
    <record id="view_training_record_list_sign" model="ir.ui.view">
        <field name="name">bf.training.record.list.sign</field>
        <field name="model">bf.training.record</field>
        <field name="inherit_id" ref="bf_training.view_training_record_list"/>
        <field name="arch" type="xml">
            <field name="date_expiry" position="before">
                <field name="document_version_number" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
