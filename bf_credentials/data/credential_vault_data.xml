<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Porteurs de référence. Génériques à dessein : ce module vise le
         catalogue, il ne nomme donc ni instance ni client. L'adresse et le
         gabarit de lien se remplissent à l'installation, chez qui installe.

         `noupdate="1"` : ces enregistrements sont un point de départ, pas une
         donnée de référence. Une mise à jour du module ne doit pas écraser
         l'adresse que quelqu'un y a mise. -->
    <data noupdate="1">

        <record id="vault_password_manager" model="project.credential.vault">
            <field name="name">Gestionnaire de mots de passe</field>
            <field name="kind">password_manager</field>
            <field name="shared" eval="True"/>
            <field name="sequence">10</field>
            <field name="notes">Coffre d'équipe. Le facteur y est accessible à plusieurs, ce qui est la seule forme qui survit à un départ sans intervention.</field>
        </record>

        <record id="vault_authenticator" model="project.credential.vault">
            <field name="name">Application d'authentification synchronisée</field>
            <field name="kind">authenticator</field>
            <field name="shared" eval="True"/>
            <field name="sequence">20</field>
            <field name="notes">Application dont les jetons sont synchronisés sur un serveur, donc récupérables sur un autre appareil.</field>
        </record>

        <record id="vault_personal_device" model="project.credential.vault">
            <field name="name">Appareil d'une personne</field>
            <field name="kind">device</field>
            <field name="shared" eval="False"/>
            <field name="sequence">30</field>
            <field name="notes">Le facteur ne vit que sur ce téléphone. Perte de l'appareil ou départ de la personne : l'accès est bloqué jusqu'à réémission.</field>
        </record>

        <record id="vault_hardware_token" model="project.credential.vault">
            <field name="name">Jeton matériel</field>
            <field name="kind">hardware</field>
            <field name="shared" eval="False"/>
            <field name="sequence">40</field>
            <field name="notes">Clé FIDO2 ou jeton à affichage. Se prête physiquement, ne se copie pas.</field>
        </record>

        <record id="vault_offline" model="project.credential.vault">
            <field name="name">Support hors ligne</field>
            <field name="kind">offline</field>
            <field name="shared" eval="True"/>
            <field name="sequence">50</field>
            <field name="notes">Codes de secours imprimés, enveloppe scellée, coffre-fort.</field>
        </record>

    </data>
</odoo>
