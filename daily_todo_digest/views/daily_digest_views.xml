<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Configuration Form View -->
    <record id="view_daily_digest_config_form" model="ir.ui.view">
        <field name="name">daily.digest.config.form</field>
        <field name="model">daily.digest.config</field>
        <field name="arch" type="xml">
            <form string="Configuration Digest">
                <header>
                    <button name="action_send_now"
                            type="object"
                            string="Envoyer maintenant"
                            class="btn-primary"
                            icon="fa-paper-plane"/>
                    <button name="action_send_test"
                            type="object"
                            string="Test (moi seul)"
                            class="btn-secondary"
                            icon="fa-user"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group string="Général">
                            <field name="name"/>
                            <field name="send_hour" widget="integer"/>
                            <field name="company_id"/>
                            <field name="last_sent" readonly="1"/>
                        </group>
                        <group string="Destinataires">
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Widgets" name="widgets">
                            <group>
                                <group string="Activités">
                                    <field name="include_overdue_activities"/>
                                    <field name="include_today_activities"/>
                                </group>
                                <group string="Tâches">
                                    <field name="include_overdue_tasks"/>
                                    <field name="include_today_tasks"/>
                                </group>
                            </group>
                            <group>
                                <group string="Rencontres">
                                    <field name="include_meetings"/>
                                </group>
                            </group>
                            <group>
                                <group string="Météo">
                                    <field name="include_weather"/>
                                    <field name="weather_city" invisible="not include_weather"/>
                                    <field name="weather_latitude" invisible="not include_weather"/>
                                    <field name="weather_longitude" invisible="not include_weather"/>
                                </group>
                                <group string="Citation">
                                    <field name="include_quote"/>
                                </group>
                            </group>
                        </page>
                        <page string="Aide" name="help">
                            <div class="alert alert-info" role="alert">
                                <h4>Comment fonctionne le digest quotidien?</h4>
                                <ul>
                                    <li><strong>Heure d'envoi:</strong> Le cron vérifie toutes les heures. Le digest part à l'heure configurée <strong>dans le fuseau horaire de chaque destinataire</strong> (champ Fuseau de sa fiche utilisateur).</li>
                                    <li><strong>Activités:</strong> Les activités (mail.activity) assignées aux destinataires sont incluses.</li>
                                    <li><strong>Tâches:</strong> Les tâches de projet assignées aux destinataires sont incluses (incluant les sous-tâches). La fenêtre « du jour » est calculée dans le fuseau de chaque destinataire.</li>
                                    <li><strong>Tâches à venir:</strong> Aperçu des tâches des prochains jours (1 à 7 jours configurables).</li>
                                    <li><strong>Météo:</strong> Utilise l'API gratuite Open-Meteo. La ville/coordonnées par défaut ci-dessus s'appliquent, mais chaque destinataire peut définir sa propre ville dans ses préférences (Ville météo (digest)).</li>
                                    <li><strong>Citations:</strong> Une citation aléatoire est sélectionnée parmi la collection.</li>
                                </ul>
                                <p class="mt-3">
                                    <strong>Coordonnées communes:</strong><br/>
                                    Montréal: 45.5017, -73.5673<br/>
                                    Québec: 46.8139, -71.2080<br/>
                                    Toronto: 43.6532, -79.3832<br/>
                                    Ottawa: 45.4215, -75.6972
                                </p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Configuration List View -->
    <record id="view_daily_digest_config_list" model="ir.ui.view">
        <field name="name">daily.digest.config.list</field>
        <field name="model">daily.digest.config</field>
        <field name="arch" type="xml">
            <list string="Digests quotidiens">
                <field name="name"/>
                <field name="send_hour"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="last_sent"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Configuration Action -->
    <record id="action_daily_digest_config" model="ir.actions.act_window">
        <field name="name">Digests quotidiens</field>
        <field name="res_model">daily.digest.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier digest quotidien
            </p>
            <p>
                Recevez chaque matin un résumé de vos activités et tâches en retard ou du jour,
                avec la météo et une citation inspirante.
            </p>
        </field>
    </record>

    <!-- Quotes List View -->
    <record id="view_daily_digest_quote_list" model="ir.ui.view">
        <field name="name">daily.digest.quote.list</field>
        <field name="model">daily.digest.quote</field>
        <field name="arch" type="xml">
            <list string="Citations inspirantes" editable="bottom">
                <field name="quote"/>
                <field name="author"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Quotes Action -->
    <record id="action_daily_digest_quote" model="ir.actions.act_window">
        <field name="name">Citations inspirantes</field>
        <field name="res_model">daily.digest.quote</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajouter des citations inspirantes
            </p>
            <p>
                Ces citations apparaîtront en rotation dans les emails du digest quotidien.
            </p>
        </field>
    </record>

    <!-- Menu Items - Under Settings > Technical -->
    <menuitem id="menu_daily_digest_root"
              name="Digest quotidien"
              parent="base.menu_custom"
              sequence="50"/>

    <menuitem id="menu_daily_digest_config"
              name="Configuration"
              parent="menu_daily_digest_root"
              action="action_daily_digest_config"
              sequence="10"/>

    <menuitem id="menu_daily_digest_quotes"
              name="Citations"
              parent="menu_daily_digest_root"
              action="action_daily_digest_quote"
              sequence="20"/>

</odoo>
