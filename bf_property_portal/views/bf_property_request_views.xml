<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_property_request_list" model="ir.ui.view">
            <field name="name">bf.property.request.list</field>
            <field name="model">bf.property.request</field>
            <field name="arch" type="xml">
                <list decoration-danger="is_overdue or is_safety"
                      decoration-muted="state in ('done', 'refused')">
                    <field name="name"/>
                    <field name="date_submitted"/>
                    <field name="building_id"/>
                    <field name="unit_id" optional="show"/>
                    <field name="requester_partner_id"/>
                    <field name="category"/>
                    <field name="portion_type"/>
                    <field name="is_safety" string="Sécurité"/>
                    <field name="responsible_user_id" optional="show"/>
                    <field name="acknowledge_deadline" optional="hide"/>
                    <field name="is_overdue" string="En retard"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'submitted'"
                           decoration-warning="state in ('acknowledged', 'in_progress')"
                           decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <record id="view_property_request_form" model="ir.ui.view">
            <field name="name">bf.property.request.form</field>
            <field name="model">bf.property.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_acknowledge" type="object" string="Prendre en charge"
                                class="btn-primary" invisible="state != 'submitted'"/>
                        <button name="action_start" type="object" string="Travaux en cours"
                                invisible="state not in ('submitted', 'acknowledged')"/>
                        <button name="action_done" type="object" string="Régler"
                                class="btn-primary" invisible="state in ('done', 'refused')"/>
                        <button name="action_refuse" type="object" string="Hors de l'objet du syndicat"
                                invisible="state in ('done', 'refused')"/>
                        <button name="action_reopen" type="object" string="Rouvrir"
                                invisible="state not in ('done', 'refused')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="submitted,acknowledged,in_progress,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="not is_safety">
                            Signalée comme touchant la sécurité des personnes ou la
                            conservation de l'immeuble. L'article 1039 du Code civil
                            fait de la conservation de l'immeuble l'objet même du syndicat.
                        </div>
                        <group>
                            <group>
                                <field name="syndicat_id"/>
                                <field name="building_id"/>
                                <field name="unit_id"/>
                                <field name="requester_partner_id"/>
                                <field name="category"/>
                            </group>
                            <group>
                                <field name="portion_type"/>
                                <field name="common_area_id"
                                       invisible="portion_type != 'restricted'"/>
                                <field name="work_type"/>
                                <field name="is_safety"/>
                                <field name="priority" widget="priority"/>
                                <field name="responsible_user_id"/>
                            </group>
                        </group>
                        <group string="Qui porte la dépense">
                            <field name="cost_bearer" nolabel="1" readonly="1"/>
                        </group>
                        <group>
                            <group>
                                <field name="date_submitted"/>
                                <field name="acknowledge_deadline"/>
                                <field name="is_overdue"/>
                            </group>
                            <group>
                                <field name="date_acknowledged"/>
                                <field name="date_done"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Demande" name="request">
                                <field name="description" readonly="1"/>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </page>
                            <page string="Ce qui a été fait" name="resolution">
                                <field name="resolution"
                                       placeholder="Ce qu'on relira dans deux ans en cherchant quand la fuite a été réparée."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_property_request_search" model="ir.ui.view">
            <field name="name">bf.property.request.search</field>
            <field name="model">bf.property.request</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="requester_partner_id"/>
                    <field name="building_id"/>
                    <filter name="open" string="Ouvertes"
                            domain="[('state', 'not in', ['done', 'refused'])]"/>
                    <filter name="overdue" string="Engagement dépassé"
                            domain="[('is_overdue', '=', True)]"/>
                    <filter name="safety" string="Sécurité"
                            domain="[('is_safety', '=', True)]"/>
                    <separator/>
                    <filter name="common" string="Parties communes"
                            domain="[('portion_type', 'in', ['common', 'restricted'])]"/>
                    <filter name="private" string="Parties privatives"
                            domain="[('portion_type', '=', 'private')]"/>
                    <group expand="1" string="Regrouper par">
                        <filter name="group_building" string="Immeuble"
                                context="{'group_by': 'building_id'}"/>
                        <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                        <filter name="group_category" string="Catégorie"
                                context="{'group_by': 'category'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- La vue du concierge : ouvertes, regroupées par immeuble. -->
        <record id="action_property_request" model="ir.actions.act_window">
            <field name="name">Demandes d'entretien</field>
            <field name="res_model">bf.property.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_open': 1, 'search_default_group_building': 1}</field>
        </record>

    </data>
</odoo>
