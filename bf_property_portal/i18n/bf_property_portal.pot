#. module: bf_property_portal
#: model:mail.template,body_html:bf_property_portal.mail_template_staff_alert
msgid ""
"<t t-set=\"company\" t-value=\"object.company_id or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and 'report_brand_primary' in company._fields and company.report_brand_primary) or '#714B67'\"/>\n"
"<div style=\"margin:0;padding:0;\">\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\"><t t-out=\"ctx.get('bf_body') or ''\"/></p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 20px 0;\">\n"
"        <tbody>\n"
"            <tr>\n"
"                <td t-attf-style=\"border-radius:10px;background-color:{{ brand_primary }};text-align:center;\">\n"
"                    <a t-att-href=\"ctx.get('bf_link')\" style=\"display:inline-block;padding:12px 24px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none !important;\">Ouvrir dans Odoo</a>\n"
"                </td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">Vous recevez ce courriel parce que vos préférences demandent les dépôts du portail par courriel. Elles se règlent dans Mes préférences.</p>\n"
"</div>\n"
"        "
msgstr ""

#. module: bf_property_portal
#: model:mail.template,body_html:bf_property_portal.mail_template_resident_invitation
msgid ""
"<t t-set=\"company\" t-value=\"object.company_id or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and 'report_brand_primary' in company._fields and company.report_brand_primary) or '#714B67'\"/>\n"
"<div style=\"margin:0;padding:0;\">\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\">Bonjour <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\"><t t-out=\"ctx.get('bf_organisation') or ''\"/> vous ouvre un accès à son portail. Vous y trouverez :</p>\n"
"    <ul style=\"margin:0 0 16px 0;padding-left:20px;font-size:15px;\">\n"
"        <li style=\"margin:0 0 4px 0;\">les annonces et les documents de l'immeuble ;</li>\n"
"        <li style=\"margin:0 0 4px 0;\">vos demandes d'entretien et leur suivi ;</li>\n"
"        <li style=\"margin:0 0 4px 0;\">la réservation des espaces communs ;</li>\n"
"        <li style=\"margin:0 0 4px 0;\">vos colis et les visiteurs que vous annoncez.</li>\n"
"    </ul>\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\">Votre identifiant : <strong t-out=\"object.login or ''\"/></p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 20px 0;\">\n"
"        <tbody>\n"
"            <tr>\n"
"                <td t-attf-style=\"border-radius:10px;background-color:{{ brand_primary }};text-align:center;\">\n"
"                    <a t-att-href=\"ctx.get('portal_url')\" style=\"display:inline-block;padding:12px 24px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none !important;\">Choisir mon mot de passe</a>\n"
"                </td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">Si vous n'attendiez pas ce courriel, vous pouvez l'ignorer : l'accès reste inutilisable tant qu'aucun mot de passe n'est choisi.</p>\n"
"</div>\n"
"        "
msgstr ""

