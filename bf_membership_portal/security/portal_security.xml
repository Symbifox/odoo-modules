<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
          Le portail LIT ses adhésions, et celles des organisations qu'il
          représente aujourd'hui. Rien d'autre : aucune écriture, et aucune
          adhésion d'un autre membre, même par son identifiant.

          🔴 Le délégué « en fonction » passe par `in_office`, un champ
          cherchable qui calcule la date à chaque recherche : une règle qui
          écrirait la date elle-même serait figée par le cache des règles.
        -->
        <record id="rule_membership_portal" model="ir.rule">
            <field name="name">Adhésion : les siennes et celles des organisations représentées (portail)</field>
            <field name="model_id" ref="bf_membership.model_bf_membership"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('partner_id.delegate_ids', 'any', [('partner_id', '=', user.partner_id.id), ('in_office', '=', True)])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
