<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_webmail" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf_webmail</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Courriel" string="Courriel"
                     name="bf_webmail" groups="base.group_system">
                    <block title="Webmail">
                        <setting string="URL du webmail"
                                 help="Adresse complète de l'interface SnappyMail (ex: Nextcloud)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="bf_webmail_url" class="col-lg-3 o_light_label"/>
                                    <field name="bf_webmail_url" class="col-lg-6"
                                           placeholder="https://nextcloud.example.com/index.php/apps/snappymail/"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="IMAP (compteur de courriels non lus)">
                        <setting string="Serveur IMAP"
                                 help="Serveur et identifiants pour vérifier les courriels non lus">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="bf_webmail_imap_host" class="col-lg-3 o_light_label"/>
                                    <field name="bf_webmail_imap_host" class="col-lg-4"
                                           placeholder="imap.example.com"/>
                                    <label for="bf_webmail_imap_port" class="col-lg-1 o_light_label"/>
                                    <field name="bf_webmail_imap_port" class="col-lg-2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bf_webmail_imap_user" class="col-lg-3 o_light_label"/>
                                    <field name="bf_webmail_imap_user" class="col-lg-6"
                                           placeholder="user@example.com"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bf_webmail_imap_password" class="col-lg-3 o_light_label"/>
                                    <field name="bf_webmail_imap_password" class="col-lg-6"
                                           password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
