#: model:ir.model.fields,field_description:bf_process.field_bf_process_node_resource__url
msgid "Address"
msgstr "Adresse"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/document.py:0
msgid "All levels on a single page, to browse on screen"
msgstr "Tous les niveaux sur une seule page, à parcourir à l’écran"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/document.py:0
msgid ""
"An AS-IS map is only worth something once it is recognized by the people who"
" do the work. Fill in and return with your corrections."
msgstr ""
"Une carte AS-IS n’a de valeur qu’une fois reconnue par ceux qui exécutent le"
" travail. À compléter et à retourner avec les corrections."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/structure.py:0
msgid "An activity must be named, as verb + object."
msgstr "Une activité doit être nommée, en verbe + complément."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ressource.py:0
msgid ""
"An annotation does not carry a resource: attach it to the step the "
"annotation comments on."
msgstr ""
"Une annotation ne porte pas de ressource : accrochez-la à l'étape que "
"l'annotation commente."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/flux.py:0
msgid "An annotation is linked by an association, not by a sequence flow."
msgstr ""
"Une annotation se relie par une association, pas par un flux de séquence."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/structure.py:0
msgid "An annotation without text says nothing."
msgstr "Une annotation sans texte ne dit rien."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/flux.py:0
msgid "An association must touch an annotation."
msgstr "Une association doit toucher une annotation."

#. module: bf_process
#: model_terms:ir.ui.view,arch_db:bf_process.view_bf_process_merge_form
msgid "Analyze"
msgstr "Analyser"

#. module: bf_process
#: model:ir.model.fields,field_description:bf_process.field_bf_process_flow__anchor_source
msgid "Anchor at origin"
msgstr "Accroche à l'origine"

#. module: bf_process
#: model:ir.model.fields,field_description:bf_process.field_bf_process_flow__anchor_target
msgid "Anchor at target"
msgstr "Accroche à la cible"

#. module: bf_process
#: model:ir.model.fields.selection,name:bf_process.selection__bf_process_node__kind__note
msgid "Annotation"
