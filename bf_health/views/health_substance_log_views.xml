<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List (editable) -->
    <record id="health_substance_log_view_list" model="ir.ui.view">
        <field name="name">health.substance.log.list</field>
        <field name="model">health.substance.log</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="date desc">
                <field name="date"/>
                <field name="substance_type"/>
                <field name="quantity"/>
                <field name="quantity_unit"/>
                <field name="context"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form (minimal) -->
    <record id="health_substance_log_view_form" model="ir.ui.view">
        <field name="name">health.substance.log.form</field>
        <field name="model">health.substance.log</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                    <field name="substance_type"/>
                    <field name="quantity"/>
                    <field name="quantity_unit"/>
                    <field name="context"/>
                    <field name="notes"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Graph (by type/month) -->
    <record id="health_substance_log_view_graph" model="ir.ui.view">
        <field name="name">health.substance.log.graph</field>
        <field name="model">health.substance.log</field>
        <field name="arch" type="xml">
            <graph string="Consommation" type="bar">
                <field name="date" interval="month"/>
                <field name="substance_type"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot -->
    <record id="health_substance_log_view_pivot" model="ir.ui.view">
        <field name="name">health.substance.log.pivot</field>
        <field name="model">health.substance.log</field>
        <field name="arch" type="xml">
            <pivot string="Consommation mensuelle">
                <field name="date" interval="month" type="row"/>
                <field name="substance_type" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search -->
    <record id="health_substance_log_view_search" model="ir.ui.view">
        <field name="name">health.substance.log.search</field>
        <field name="model">health.substance.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="substance_type"/>
                <field name="date"/>
                <filter name="alcohol" string="Alcool" domain="[('substance_type', '=', 'alcohol')]"/>
                <filter name="cannabis" string="Cannabis" domain="[('substance_type', '=', 'cannabis')]"/>
                <filter name="caffeine" string="Caféine" domain="[('substance_type', '=', 'caffeine')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Substance" context="{'group_by': 'substance_type'}"/>
                    <filter name="group_month" string="Mois" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="health_substance_log_action" model="ir.actions.act_window">
        <field name="name">Consommation</field>
        <field name="res_model">health.substance.log</field>
        <field name="view_mode">list,graph,form</field>
        <field name="search_view_id" ref="health_substance_log_view_search"/>
    </record>

    <record id="health_substance_log_pivot_action" model="ir.actions.act_window">
        <field name="name">Consommation mensuelle</field>
        <field name="res_model">health.substance.log</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="health_substance_log_view_search"/>
    </record>

</odoo>
