<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_contributor_list" model="ir.ui.view">
        <field name="name">personal.budget.contributor.list</field>
        <field name="model">personal.budget.contributor</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="is_default"/>
                <field name="book_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_budget_contributor" model="ir.actions.act_window">
        <field name="name">Contributors</field>
        <field name="res_model">personal.budget.contributor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
