<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_book_list" model="ir.ui.view">
        <field name="name">personal.budget.book.list</field>
        <field name="model">personal.budget.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="member_ids" widget="many2many_avatar_user"/>
                <field name="is_default"/>
                <field name="is_shared" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_budget_book_form" model="ir.ui.view">
        <field name="name">personal.budget.book.form</field>
        <field name="model">personal.budget.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_transactions" type="object"
                                class="oe_stat_button" icon="fa-list"
                                string="Transactions"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="is_owner" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="not is_owner and id"
                                   placeholder="Couple budget, Cottage, Holidays…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="1" widget="many2one_avatar_user"/>
                            <field name="is_default" readonly="not is_owner and id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="member_ids" widget="many2many_tags_avatar"
                                   readonly="not is_owner and id"
                                   domain="[('share', '=', False), ('id', '!=', user_id)]"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="member_ids">
                        Only you can see this budget. To make it a shared budget, add the household members you want to share it with.
                    </div>
                    <div class="text-muted" invisible="not member_ids">
                        The people added here see and edit everything in this budget: categories, transactions, plans, recurring expenses. Only the owner can change this sharing.
                    </div>
                    <group>
                        <field name="notes" readonly="not is_owner and id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_book_search" model="ir.ui.view">
        <field name="name">personal.budget.book.search</field>
        <field name="model">personal.budget.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="mine" string="My budgets" domain="[('user_id', '=', uid)]"/>
                <filter name="shared_with_me" string="Shared with me" domain="[('member_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="archived" string="Archived budgets" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_budget_book" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">personal.budget.book</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_budget_book_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a budget</p>
            <p>Each person has a budget of their own. A couple or household budget is created here, then shared with the people you choose.</p>
        </field>
    </record>
</odoo>
