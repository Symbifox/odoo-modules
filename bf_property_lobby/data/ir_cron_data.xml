<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_lobby_purge" model="ir.cron">
            <field name="name">Accès : purger le journal de la tablette (Loi 25)</field>
            <field name="model_id" ref="model_bf_property_lobby_call"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.utcnow() - timedelta(hours=5, minutes=30) + relativedelta(days=1)).strftime('%Y-%m-%d 05:30:00')"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
