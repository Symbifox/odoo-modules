msgstr "Une activité ne se pose que sur un rappel de crédit qui vous appartient."

#. module: bf_credit_identity
#. odoo-python
#: code:addons/bf_credit_identity/models/mail_activity.py:0
msgid "An activity on a credit reminder stays with the reminder's owner."
msgstr "L'activité d'un rappel de crédit reste à la personne qui possède le rappel."

#. module: bf_credit_identity
#: model:ir.model,name:bf_credit_identity.model_ir_attachment
msgid "Attachment"
msgstr "Pièce jointe"

#. module: bf_credit_identity
#. odoo-python
#: code:addons/bf_credit_identity/models/credit_reminder.py:0
msgid "Credit & Identity: reminders"
msgstr "Crédit et identité : rappels"

#. module: bf_credit_identity
