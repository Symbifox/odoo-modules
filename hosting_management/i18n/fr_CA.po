#. module: hosting_management
#: model:mail.template,body_html:hosting_management.mail_template_client_monthly_report
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Monthly report</p>\n"
"<p t-attf-style=\"margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;line-height:28px;color:{{ brand_dark }};font-weight:500;\">\n"
"                          Hello <t t-out=\"object.name or 'valued customer'\"/>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 24px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          Here is the summary of your services for <strong><t t-out=\"ctx.get('report_month', 'last month')\"/></strong>.\n"
"                        </p>\n"
"\n"
"                        <!-- KPI Grid - 2x2 -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <!-- Services actifs -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#F0F9FF;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#0369A1;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Active services\n"
"                                </p>\n"
"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('services_count', '-')\"/>\n"
"                                </p>\n"
"                              </td>\n"
"                              <td width=\"4%\">&amp;nbsp;</td>\n"
"                              <!-- Disponibilit&#233; -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#ECFDF5;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#047857;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Uptime\n"
"                                </p>\n"
"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('uptime_rate', '-')\"/>\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                            <tr><td colspan=\"3\" style=\"height:12px;\">&amp;nbsp;</td></tr>\n"
"                            <tr>\n"
"                              <!-- Sauvegardes -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#F0FDF4;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#15803D;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Successful backups\n"
"                                </p>\n"
"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('backups_ok', '-')\"/>\n"
"                                </p>\n"
"                              </td>\n"
"                              <td width=\"4%\">&amp;nbsp;</td>\n"
"                              <!-- Mises &#224; jour -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#EFF6FF;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#1D4ED8;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Updates applied\n"
"                                </p>\n"
"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('updates_count', '-')\"/>\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Prochaine maintenance -->\n"
"                        <t t-if=\"ctx.get('next_maintenance')\">\n"
"                          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;\">\n"
"                            <tbody>\n"
"                              <tr>\n"
"                                <td style=\"padding:16px 20px;background-color:#FFFBEB;border-radius:12px;border-left-width:4px; border-left-style:solid; border-left-color:#F59E0B;\">\n"
"                                  <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#92400E;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                    Next scheduled maintenance\n"
"                                  </p>\n"
"                                  <p t-attf-style=\"margin:6px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};\">\n"
"                                    <t t-out=\"ctx.get('next_maintenance')\"/>\n"
"                                  </p>\n"
"                                </td>\n"
"                              </tr>\n"
"                            </tbody>\n"
"                          </table>\n"
"                        </t>\n"
"\n"
"                        <!-- Message additionnel via ctx -->\n"
"                        <t t-if=\"ctx.get('message_body')\">\n"
"                          <t t-out=\"ctx.get('message_body')\"/>\n"
"                        </t>\n"
"\n"
"                        <p style=\"margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          If you have any questions about this report, feel free to contact us.\n"
"                        </p>\n"
"                        <p t-attf-style=\"margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:{{ brand_dark }};font-weight:400;\">\n"
"                          Best regards,<br/>\n"
"                          <strong>The <t t-out=\"company.name or 'support'\"/> team</strong>\n"
"                        </p>\n"
"            "
msgstr ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"></t>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"></t>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"></t>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Rapport mensuel</p>\n"
"<p t-attf-style=\"margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;line-height:28px;color:{{ brand_dark }};font-weight:500;\">\n"
"                          Bonjour <t t-out=\"object.name or 'cher client'\"></t>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 24px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          Voici le résumé de vos services pour <strong><t t-out=\"ctx.get('report_month', 'le mois dernier')\"></t></strong>.\n"
"                        </p>\n"
"\n"
"                        <!-- KPI Grid - 2x2 -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <!-- Services actifs -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#F0F9FF;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#0369A1;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Services actifs\n"
"                                </p>\n"
"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('services_count', '-')\"></t>\n"
"                                </p>\n"
"                              </td>\n"
"                              <td width=\"4%\">&amp;nbsp;</td>\n"
"                              <!-- Disponibilit&#233; -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#ECFDF5;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#047857;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Disponibilité\n"
"                                </p>\n"
"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('uptime_rate', '-')\"></t>\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                            <tr><td colspan=\"3\" style=\"height:12px;\">&amp;nbsp;</td></tr>\n"
"                            <tr>\n"
"                              <!-- Sauvegardes -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#F0FDF4;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#15803D;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Sauvegardes réussies\n"
"                                </p>\n"
"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('backups_ok', '-')\"></t>\n"
"                                </p>\n"
"                              </td>\n"
"                              <td width=\"4%\">&amp;nbsp;</td>\n"
"                              <!-- Mises &#224; jour -->\n"
"                              <td width=\"48%\" style=\"padding:16px;background-color:#EFF6FF;border-radius:12px;vertical-align:top;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#1D4ED8;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Mises à jour appliquées\n"
"                                </p>\n"
"                                <p t-attf-style=\"margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;\">\n"
"                                  <t t-out=\"ctx.get('updates_count', '-')\"></t>\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Prochaine maintenance -->\n"
"                        <t t-if=\"ctx.get('next_maintenance')\">\n"
"                          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;\">\n"
"                            <tbody>\n"
"                              <tr>\n"
"                                <td style=\"padding:16px 20px;background-color:#FFFBEB;border-radius:12px;border-left-width:4px; border-left-style:solid; border-left-color:#F59E0B;\">\n"
"                                  <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#92400E;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                    Prochaine maintenance planifiée\n"
"                                  </p>\n"
"                                  <p t-attf-style=\"margin:6px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};\">\n"
"                                    <t t-out=\"ctx.get('next_maintenance')\"></t>\n"
"                                  </p>\n"
"                                </td>\n"
"                              </tr>\n"
"                            </tbody>\n"
"                          </table>\n"
"                        </t>\n"
"\n"
"                        <!-- Message additionnel via ctx -->\n"
"                        <t t-if=\"ctx.get('message_body')\">\n"
"                          <t t-out=\"ctx.get('message_body')\"></t>\n"
"                        </t>\n"
"\n"
"                        <p style=\"margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          Pour toute question sur ce rapport, n'hésitez pas à nous contacter.\n"
"                        </p>\n"
"                        <p t-attf-style=\"margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:{{ brand_dark }};font-weight:400;\">\n"
"                          Cordialement,<br>\n"
"                          <strong>L'équipe <t t-out=\"company.name or 'de soutien'\"></t></strong>\n"
"                        </p>"

#. module: hosting_management
#: model:mail.template,body_html:hosting_management.mail_template_hosting_digest
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Services summary</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">\n"
"                                                    Hello,\n"
"                                                </p>\n"
"                                                <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;\">\n"
"                                                    Here is the summary of your hosting services. It covers expiring services, available updates, storage alerts and health issues.\n"
"                                                </p>\n"
"                                                <p style=\"font-size:13px; line-height:20px; color:#6B7280; margin:16px 0 0 0;\">\n"
"                                                    For any help, contact us at\n"
"                                                    <a t-attf-href=\"mailto:{{ company.email or '' }}\" t-attf-style=\"color:{{ brand_primary }}; text-decoration:none;\"><t t-out=\"company.email or ''\"/></a>\n"
"                                                    or call\n"
"                                                    <a t-attf-href=\"tel:{{ company.phone or '' }}\" t-attf-style=\"color:{{ brand_primary }}; text-decoration:none;\"><t t-out=\"company.phone or ''\"/></a>.\n"
"                                                </p>\n"
"<p style=\"font-size:12px; line-height:18px; color:#6B7280; margin:24px 0 0 0;\">Report generated automatically by your hosting module.</p>\n"
"            "
msgstr ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"></t>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"></t>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"></t>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Résumé des services</p>\n"
"<p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">\n"
"                                                    Bonjour,\n"
"                                                </p>\n"
"                                                <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;\">\n"
"                                                    Voici le résumé de vos services d'hébergement. Ce récapitulatif inclut les informations sur les services expirant, les mises à jour disponibles, les alertes de stockage et les problèmes de santé.\n"
"                                                </p>\n"
"                                                <p style=\"font-size:13px; line-height:20px; color:#6B7280; margin:16px 0 0 0;\">\n"
"                                                    Pour toute assistance, contactez-nous à\n"
"                                                    <a t-attf-href=\"mailto:{{ company.email or '' }}\" t-attf-style=\"color:{{ brand_primary }}; text-decoration:none;\"><t t-out=\"company.email or ''\"></t></a>\n"
"                                                    ou appelez le\n"
"                                                    <a t-attf-href=\"tel:{{ company.phone or '' }}\" t-attf-style=\"color:{{ brand_primary }}; text-decoration:none;\"><t t-out=\"company.phone or ''\"></t></a>.\n"
"                                                </p>\n"
"<p style=\"font-size:12px; line-height:18px; color:#6B7280; margin:24px 0 0 0;\">Rapport généré automatiquement par votre module d'hébergement.</p>"

#. module: hosting_management
#: model:mail.template,body_html:hosting_management.mail_template_client_welcome
msgid ""
