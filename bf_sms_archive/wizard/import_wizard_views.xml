<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Import Wizard Form -->
    <record id="sms_import_wizard_view_form" model="ir.ui.view">
        <field name="name">sms.archive.import.wizard.form</field>
        <field name="model">sms.archive.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import" string="Import"
                            type="object" class="btn-primary"/>
                    <button name="action_disk_import_now"
                            string="Import from /mnt/sms-inbox"
                            type="object" class="btn-secondary"
                            help="Immediately processes the XML files dropped into sms-inbox on the server (no size limit)."/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="file_data" filename="file_name"
                                   string="SMS backup file (XML or ZIP)"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Large files (over 1 GB)</strong>: drop them via
                        <code>scp</code> into the <code>sms-inbox/</code> bind mount
                        of the compose file (mounted at <code>/mnt/sms-inbox</code> in the
                        container), then click "Import from /mnt/sms-inbox".
                        The disk import bypasses the form's HTTP/memory limit.
                    </div>
                    <group invisible="not result_message">
                        <field name="result_message" string="Result" readonly="1"
                               widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Import Wizard Action -->
    <record id="sms_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import SMS</field>
        <field name="res_model">sms.archive.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
