def load_conf():
    conf = {}
    try:
        with open(CONF_PATH, encoding="utf-8") as handle:
            conf = json.load(handle)
    except (OSError, ValueError):
        pass
    for key, env in (("url", "SYMBIFOX_URL"), ("token", "SYMBIFOX_TOKEN")):
        if os.environ.get(env):
            conf[key] = os.environ[env]
    return conf


def save_conf(conf):
    # 0700 : le répertoire porte le jeton de la machine.
    # ⚠️ `os.makedirs(mode=..., exist_ok=True)` n'applique son mode QUE s'il crée
    # le répertoire. S'il existe déjà — l'installateur le pose — le mode est
    # ignoré en silence et un 0755 reste 0755. Le `chmod` qui suit n'est donc pas
    # redondant : c'est lui qui tient l'invariant.
    directory = os.path.dirname(CONF_PATH)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    os.chmod(directory, 0o700)
    # ⚠️ Ouvrir en 0600 dès la création. Un `open()` ordinaire suivi d'un
    # `chmod` laisse le jeton lisible par tous pendant l'écriture.
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    with os.fdopen(os.open(CONF_PATH, flags, 0o600), "w",
                   encoding="utf-8") as handle:
        json.dump(conf, handle, indent=2)
    os.chmod(CONF_PATH, 0o600)


def post(url, path, body, token=None):
    request = urllib.request.Request(
        url.rstrip("/") + path,
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    if token:
        request.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        try:
            return json.loads(error.read().decode("utf-8"))
        except (ValueError, OSError):
            return {"ok": False, "error": f"HTTP {error.code}"}
    except (urllib.error.URLError, OSError, ValueError) as error:
        return {"ok": False, "error": str(error)}


def main(argv=None):
    parser = argparse.ArgumentParser(prog="symbifox-hostd")
    sub = parser.add_subparsers(dest="command", required=True)

    enrol = sub.add_parser("enrol", help="échanger un code contre un jeton")
    enrol.add_argument("--url", required=True)
    enrol.add_argument("--code", required=True)
    enrol.add_argument(
        "--allow-http", action="store_true",
        help="autoriser une URL en clair (bancs d'essai seulement)",
    )

    sub.add_parser("report", help="relever et envoyer")
    sub.add_parser("show", help="relever et imprimer, sans rien envoyer")
    sub.add_parser("poll", help="demander un ordre, et l'exécuter")

    args = parser.parse_args(argv)
    if args.command == "show":
        print(json.dumps(collect(), indent=2, ensure_ascii=False))
        return 0

    if args.command == "enrol":
        # Le jeton voyage dans un en-tête Authorization : en clair, il est lu
        # par tout ce qui se trouve sur le chemin.
        if not args.url.startswith("https://") and not args.allow_http:
            print("refus : l'URL n'est pas en HTTPS et le jeton voyagerait en "
                  "clair. Ajouter --allow-http pour un banc d'essai.",
                  file=sys.stderr)
            return 2
        uuid = machine_uuid()
        if not uuid:
            print("note : UUID materiel illisible (il faut root). La machine "
                  "sera identifiee par son seul systeme.", file=sys.stderr)
        answer = post(args.url, "/symbifox/patch/v1/enrol", {
            "code": args.code,
            "machine_id": machine_id(),
            "machine_uuid": uuid,
            "os_family": os_family(),
            "os_release": os_release().get("PRETTY_NAME", ""),
            "hostname": run(["hostname"]).strip(),
        })
        if not answer.get("ok"):
            print(f"enrôlement refusé : {answer.get('error')}", file=sys.stderr)
            return 1
        save_conf({"url": args.url, "token": answer["token"],
                   "endpoint": answer.get("endpoint")})
        print(f"système « {answer.get('system')} » enrôlé sur "
              f"{answer.get('name')} ({answer.get('endpoint')})")
        return 0

    conf = load_conf()
    if not conf.get("url") or not conf.get("token"):
        print("pas de configuration : lancer d'abord « symbifox-hostd enrol »",
              file=sys.stderr)
        return 1

    if args.command == "poll":
        return do_poll(conf)

    answer = post(conf["url"], "/symbifox/patch/v1/report", collect(),
                  token=conf["token"])
    if not answer.get("ok"):
        print(f"relevé refusé : {answer.get('error')}", file=sys.stderr)
        return 1
    pending = answer.get("pending")
    known = answer.get("pending_known", True)
    compte = f"{pending} en attente ({answer.get('delta'):+d})" if known \
        else "compte INCONNU (le gestionnaire de paquets n'a pas répondu)"
    machine = answer.get("machine_state")
    suffixe = f", machine {machine}" if machine and machine != answer.get("state") else ""
    print(f"relevé déposé : {compte}, système {answer.get('state')}{suffixe}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
