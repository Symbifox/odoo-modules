<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ⚠️ Se périme. LinkedIn retire une version d'API au bout d'environ
             un an ; le paramètre existe pour la bouger sans redéployer.
             202608 est retirée le 17 août 2027.
             ⚠️ Ce bloc est noupdate : une mise à niveau ne corrigera PAS une
             base déjà installée. Y écrire le paramètre à la main. -->
        <record id="param_api_version" model="ir.config_parameter">
            <field name="key">bf_editorial_linkedin.api_version</field>
            <field name="value">202608</field>
        </record>

        <record id="cron_warn_token_expiry" model="ir.cron">
            <field name="name">Atelier éditorial : jeton LinkedIn qui approche de sa fin</field>
            <field name="model_id" ref="bf_editorial_social.model_bf_social_channel"/>
            <field name="state">code</field>
            <field name="code">model._cron_warn_linkedin_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
