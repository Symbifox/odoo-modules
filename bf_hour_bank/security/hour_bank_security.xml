<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Project managers can manage all hour bank records -->
        <record id="rule_hour_bank_manager" model="ir.rule">
            <field name="name">Banque d'heures : Acc&#232;s complet gestionnaire</field>
            <field name="model_id" ref="model_hour_bank_client"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        </record>

        <!-- Project users can read hour bank records -->
        <record id="rule_hour_bank_user" model="ir.rule">
            <field name="name">Banque d'heures : Lecture utilisateur projet</field>
            <field name="model_id" ref="model_hour_bank_client"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal users can read their own hour bank records -->
        <record id="rule_hour_bank_portal" model="ir.rule">
            <field name="name">Banque d'heures : Lecture portail client</field>
            <field name="model_id" ref="model_hour_bank_client"/>
            <field name="domain_force">[('partner_id', '=', user.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal users can only read adjustments for their own hour banks -->
        <record id="rule_hour_bank_adjustment_portal" model="ir.rule">
            <field name="name">Ajustement : Lecture portail client</field>
            <field name="model_id" ref="model_hour_bank_adjustment"/>
            <field name="domain_force">[('hour_bank_id.partner_id', '=', user.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
