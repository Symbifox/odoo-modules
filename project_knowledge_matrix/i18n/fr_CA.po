#. module: project_knowledge_matrix
#: model:mail.template,body_html:project_knowledge_matrix.mail_template_document_digest
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.name\"/>,\n"
"        <br/><br/>\n"
"        This is your daily digest of document distributions pending acknowledgment.\n"
"        <br/><br/>\n"
"        Please review the pending acknowledgments in the system and follow up with clients as needed.\n"
"        <br/><br/>\n"
"        Best regards,<br/>\n"
"        The Document Management System\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Bonjour <t t-out=\"object.name\"/>,\n"
"        <br/><br/>\n"
"        Voici votre résumé quotidien des distributions de documents en attente d'accusé de réception.\n"
"        <br/><br/>\n"
"        Veuillez examiner les accusés de réception en attente dans le système et effectuer les suivis auprès des clients au besoin.\n"
"        <br/><br/>\n"
"        Cordialement,<br/>\n"
"        Le système de gestion documentaire\n"
"    </p>\n"
"</div>\n"
"            "

#. module: project_knowledge_matrix
#: model:mail.template,body_html:project_knowledge_matrix.mail_template_document_outdated
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.partner_id.name\"/>,\n"
"        <br/><br/>\n"
"        A new version of the following document is now available:\n"
"        <br/><br/>\n"
"        <strong>Document:</strong> <t t-out=\"object.version_id.document_id.name\"/><br/>\n"
"        <strong>Your version:</strong> <t t-out=\"object.version_id.version_number\"/><br/>\n"
"        <strong>New version:</strong> <t t-out=\"object.current_version_id.version_number\"/><br/>\n"
"        <br/>\n"
"        Please contact us if you would like to receive the updated version.\n"
"        <br/><br/>\n"
"        Best regards,<br/>\n"
"        <t t-out=\"object.distributed_by_id.name or user.name\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.partner_id.name\"/>,\n"
"        <br/><br/>\n"
"        A new version of the following document is now available:\n"
"        <br/><br/>\n"
"        <strong>Document:</strong> <t t-out=\"object.version_id.document_id.name\"/><br/>\n"
"        <strong>Your version:</strong> <t t-out=\"object.version_id.version_number\"/><br/>\n"
"        <strong>New version:</strong> <t t-out=\"object.current_version_id.version_number\"/><br/>\n"
"        <br/>\n"
"        Please contact us if you would like to receive the updated version.\n"
"        <br/><br/>\n"
"        Best regards,<br/>\n"
"        <t t-out=\"object.distributed_by_id.name or user.name\"/>\n"
"    </p>\n"
"</div>\n"
"            "

