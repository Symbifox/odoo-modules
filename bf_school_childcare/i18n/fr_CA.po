#. module: bf_school_childcare
#: model_terms:ir.actions.act_window,help:bf_school_childcare.bf_school_childcare_sheet_action
msgid ""
"\"Today\" opens the sheets of the periods that run today, with the children "
"expected."
msgstr ""
"« Aujourd'hui » ouvre les feuilles des périodes qui ont lieu aujourd'hui, "
"avec les enfants attendus."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%(adult)s may not pick up %(student)s."
msgstr "%(adult)s ne peut pas venir chercher %(student)s."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
msgid ""
"%(count)s child(ren) booked, %(min)s needed: wait, or cancel the activity."
msgstr ""
"%(count)s réservation(s), minimum %(min)s : attendez, ou annulez l'activité."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/pickup.py:0
msgid "%(days)s, from %(time)s, %(validity)s. Signed by %(signer)s."
msgstr "%(days)s, dès %(time)s, %(validity)s. Signature de %(signer)s."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/registration.py:0
msgid "%(period)s: %(days)s"
msgstr "%(period)s : %(days)s"

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid ""
"%(person)s may not pick up %(student)s. Keep the child and call the child "
"care manager."
msgstr ""
"%(person)s ne peut pas venir chercher %(student)s. Gardez l'enfant et "
"appelez la personne responsable du service de garde."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%(slot)s does not run on %(date)s."
msgstr "%(slot)s n'a pas lieu le %(date)s."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/registration.py:0
msgid "%(slot)s is full on %(date)s (%(places)s places)."
msgstr "%(slot)s est complet le %(date)s (%(places)s places)."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
msgid "%(slot)s is full on %(date)s."
msgstr "%(slot)s est complet le %(date)s."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
#: code:addons/bf_school_childcare/models/registration.py:0
msgid "%(slot)s is not for the level of %(student)s."
msgstr "%(slot)s : niveau non admis pour %(student)s."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
msgid "%(student)s is already booked for %(slot)s that day."
msgstr "%(student)s a déjà une réservation à %(slot)s ce jour-là."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
msgid "%(student)s is already registered for %(slot)s that day."
msgstr "%(student)s a déjà une inscription à %(slot)s ce jour-là."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%(student)s left with someone not on file: %(note)s"
msgstr "Départ avec une personne absente du dossier (%(student)s) : %(note)s"

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%(student)s removed from the sheet by %(user)s (added by mistake)."
msgstr "%(student)s : retrait de la feuille par %(user)s (ajout par erreur)."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/registration.py:0
msgid ""
"%s already has a child care registration or a request over these dates: end "
"it first."
msgstr ""
"%s a déjà une inscription ou une demande au service de garde pour ces dates "
": terminez-la d'abord."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%s arrived: record the departure instead."
msgstr "Arrivée notée pour %s : notez plutôt le départ."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%s child(ren) added."
msgstr "%s ligne(s) ajoutée(s)."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/registration.py:0
msgid "%s does not run on one of the days ticked."
msgstr "%s n'a pas lieu l'un des jours cochés."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/registration.py:0
msgid "%s is a period of another school."
msgstr "%s est une période d'une autre école."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/pickup.py:0
msgid "%s is enrolled in no school: enrol the student first."
msgstr "%s : aucune inscription dans une école. Inscrire l'élève d'abord."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%s is here without registration nor booking."
msgstr "Présence sans inscription ni réservation : %s."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%s may not leave alone today at this time."
msgstr "%s ne peut pas partir sans adulte aujourd'hui à cette heure."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "%s, ID to check"
msgstr "%s, pièce d'identité à vérifier"

#. module: bf_school_childcare
#: model:ir.model.fields,help:bf_school_childcare.field_bf_school_childcare_activity__places
msgid "0: the places of the period."
msgstr "0 : les places de la période."

#. module: bf_school_childcare
#: model:mail.template,body_html:bf_school_childcare.mail_template_childcare_activity_cancelled
msgid ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The child care activity <strong t-out=\"object.activity_id.name or ''\"/> of <t t-out=\"object._school_date_label() or ''\"/> is cancelled. The booking of <strong t-out=\"object.student_id.name or ''\"/> is cancelled at no charge.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">To book child care another way that day, look at the family portal or call the school office.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/childcare\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Child care on the portal\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">L'activité <strong t-out=\"object.activity_id.name or ''\"/> du service de garde, le <t t-out=\"object._school_date_label() or ''\"/>, est annulée. La réservation pour <strong t-out=\"object.student_id.name or ''\"/> est annulée sans frais.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Pour réserver autrement ce jour-là, consultez le portail des familles ou appelez le secrétariat.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/childcare\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Le service de garde au portail\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: bf_school_childcare
#: model:mail.template,body_html:bf_school_childcare.mail_template_childcare_registration_confirmed
msgid ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">The child care registration of <strong t-out=\"object.student_id.name or ''\"/> at <t t-out=\"object.school_id.name or ''\"/> is confirmed, <t t-out=\"object._school_period_label() or ''\"/>:</p>\n"
"    <ul style=\"margin:0 0 12px 0;\">\n"
"        <li t-foreach=\"object._school_schedule_lines()\" t-as=\"schedule_line\" t-out=\"schedule_line\">\n"
"    </li></ul>\n"
"    <p style=\"margin:0 0 12px 0;\">On the family portal, you book another day, declare an absence and choose who may pick up the child.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/childcare\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Child care on the portal\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">L'inscription au service de garde est confirmée pour <strong t-out=\"object.student_id.name or ''\"/> (<t t-out=\"object.school_id.name or ''\"/>), <t t-out=\"object._school_period_label() or ''\"/> :</p>\n"
"    <ul style=\"margin:0 0 12px 0;\">\n"
"        <li t-foreach=\"object._school_schedule_lines()\" t-as=\"schedule_line\" t-out=\"schedule_line\">\n"
"    </li></ul>\n"
"    <p style=\"margin:0 0 12px 0;\">Au portail des familles, vous réservez un autre jour, déclarez une absence et choisissez qui peut venir chercher l'enfant.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/childcare\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Le service de garde au portail\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: bf_school_childcare
#: model:mail.template,body_html:bf_school_childcare.mail_template_childcare_person_change
msgid ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p t-if=\"ctx.get('childcare_change') == 'removed'\" style=\"margin:0 0 12px 0;\"><strong t-out=\"object.name or ''\"/> may no longer pick up <strong t-out=\"object.student_id.name or ''\"/> at child care. Change made by <t t-out=\"object.revoked_by_id.name or ''\"/>.</p>\n"
"    <p t-else=\"\" style=\"margin:0 0 12px 0;\"><strong t-out=\"object.display_name or ''\"/> may now pick up <strong t-out=\"object.student_id.name or ''\"/> at child care, <t t-out=\"object._validity_label() or ''\"/>. An ID is checked the first time. Change made by <t t-out=\"object.added_by_id.name or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Every adult with parental authority receives this notice. If you did not expect this change, contact the school at once.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/childcare\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            See who may pick up the child\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p t-if=\"ctx.get('childcare_change') == 'removed'\" style=\"margin:0 0 12px 0;\"><strong t-out=\"object.name or ''\"/> ne peut plus venir chercher <strong t-out=\"object.student_id.name or ''\"/> au service de garde. Modification faite par <t t-out=\"object.revoked_by_id.name or ''\"/>.</p>\n"
"    <p t-else=\"\" style=\"margin:0 0 12px 0;\"><strong t-out=\"object.display_name or ''\"/> peut maintenant venir chercher <strong t-out=\"object.student_id.name or ''\"/> au service de garde, <t t-out=\"object._validity_label() or ''\"/>. Une pièce d'identité est vérifiée la première fois. Modification faite par <t t-out=\"object.added_by_id.name or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Chaque adulte qui a l'autorité parentale reçoit cet avis. Si vous ne vous attendiez pas à ce changement, communiquez sans tarder avec l'école.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/childcare\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Voir qui peut venir chercher l'enfant\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: bf_school_childcare
#: model:mail.template,body_html:bf_school_childcare.mail_template_childcare_walk_alone_change
msgid ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Hello,</p>\n"
"    <p t-if=\"ctx.get('childcare_change') == 'revoked'\" style=\"margin:0 0 12px 0;\">The permission for <strong t-out=\"object.student_id.name or ''\"/> to leave child care alone is revoked. Change made by <t t-out=\"object.revoked_by_id.name or ''\"/>. From now on, an adult picks up the child.</p>\n"
"    <p t-else=\"\" style=\"margin:0 0 12px 0;\"><t t-out=\"object.signed_by_id.name or ''\"/> signed the permission for <strong t-out=\"object.student_id.name or ''\"/> to leave child care alone on <t t-out=\"object._weekday_label() or ''\"/>, from <t t-out=\"object._school_time_label() or ''\"/>, <t t-out=\"object._validity_label() or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Every adult with parental authority receives this notice. If you did not expect this change, contact the school at once.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/childcare\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            See who may pick up the child\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p t-if=\"ctx.get('childcare_change') == 'revoked'\" style=\"margin:0 0 12px 0;\">Permission de départ sans adulte révoquée pour <strong t-out=\"object.student_id.name or ''\"/>. Modification faite par <t t-out=\"object.revoked_by_id.name or ''\"/>. Dorénavant, une personne adulte vient chercher l'enfant.</p>\n"
"    <p t-else=\"\" style=\"margin:0 0 12px 0;\">Signature de <t t-out=\"object.signed_by_id.name or ''\"/> : <strong t-out=\"object.student_id.name or ''\"/> peut quitter le service de garde sans adulte (jours : <t t-out=\"object._weekday_label() or ''\"/>), dès <t t-out=\"object._school_time_label() or ''\"/>, <t t-out=\"object._validity_label() or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Chaque adulte qui a l'autorité parentale reçoit cet avis. Si vous ne vous attendiez pas à ce changement, communiquez sans tarder avec l'école.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/school/childcare\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Voir qui peut venir chercher l'enfant\n"
"        </a>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: bf_school_childcare
#: model_terms:ir.ui.view,arch_db:bf_school_childcare.portal_my_school_childcare_link
msgid "<i class=\"fa fa-child me-1\"/>Child care"
msgstr "<i class=\"fa fa-child me-1\"/>Service de garde"

#. module: bf_school_childcare
#: model_terms:ir.ui.view,arch_db:bf_school_childcare.portal_school_childcare
msgid "<option value=\"\">The whole day</option>"
msgstr "<option value=\"\">Toute la journée</option>"

#. module: bf_school_childcare
#: model_terms:ir.ui.view,arch_db:bf_school_childcare.bf_school_childcare_slot_view_form
msgid "<span>-</span>"
msgstr "<span>-</span>"

#. module: bf_school_childcare
#: model:ir.model.fields,help:bf_school_childcare.field_bf_school__childcare_cancel_notice_hours
msgid ""
"A booking cancelled later than this many hours before the period stays due."
msgstr ""
"Une réservation annulée moins de ce nombre d'heures avant la période reste "
"due."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
msgid ""
"A booking is cancelled, not deleted: it is the trace of what was asked."
msgstr ""
"Une réservation s'annule, elle ne se supprime pas : elle est la trace de la "
"demande."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
msgid "A booking is not moved: cancel it and book again."
msgstr ""
"Une réservation ne se déplace pas : annulez-la et réservez de nouveau."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/booking.py:0
msgid "A booking names a child, a period and a date."
msgstr "Une réservation nomme un enfant, une période et une date."

#. module: bf_school_childcare
#: model:ir.model.constraint,message:bf_school_childcare.constraint_bf_school_childcare_sheet_line_one_line
msgid "A child appears once on a sheet."
msgstr "Chaque enfant figure une seule fois sur une feuille."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "A child is added to an open sheet."
msgstr "L'ajout se fait sur une feuille ouverte."

#. module: bf_school_childcare
#: model:ir.model.fields,help:bf_school_childcare.field_bf_school__childcare_walk_alone_min_age
msgid ""
"A child younger than this cannot be allowed to leave child care alone. 0: no"
" minimum."
msgstr ""
"En deçà de cet âge, la permission de quitter le service de garde sans adulte"
" n'est pas possible. 0 : aucun minimum."

#. module: bf_school_childcare
#: model:ir.model.fields,help:bf_school_childcare.field_bf_school__childcare_booking_notice_hours
msgid ""
"A family books an occasional period on the portal at least this many hours "
"before it starts. Later, only the office books it, marked as late notice."
msgstr ""
"Une famille réserve une période occasionnelle au portail au moins ce nombre "
"d'heures avant son début. Plus tard, seul le secrétariat la réserve, marquée"
" comme préavis court."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/sheet.py:0
msgid "A line is not moved: add the child again."
msgstr "Une ligne ne se déplace pas : ajoutez de nouveau l'enfant."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/slot.py:0
msgid ""
"A period already used stays at its school: archive it and create another."
msgstr ""
"Une période déjà utilisée reste à son école : l'archiver et en créer une "
"autre."

#. module: bf_school_childcare
#: model:ir.model.constraint,message:bf_school_childcare.constraint_bf_school_childcare_registration_line_one_line_per_slot
msgid "A period appears once in a registration."
msgstr "Une période figure une seule fois dans une inscription."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/slot.py:0
msgid "A period ends after it starts, within the day."
msgstr "Une période finit après son début, dans la même journée."

#. module: bf_school_childcare
#: model:ir.model.constraint,message:bf_school_childcare.constraint_bf_school_childcare_sheet_one_sheet
msgid "A period has one sheet per date."
msgstr "Une période a une feuille par date."

#. module: bf_school_childcare
#. odoo-python
#: code:addons/bf_school_childcare/models/pickup.py:0
msgid "A permission ends after it starts."
msgstr "Une permission finit après son début."

#. module: bf_school_childcare
#. odoo-python
