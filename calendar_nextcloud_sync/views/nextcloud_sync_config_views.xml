<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_nextcloud_sync_config_tree" model="ir.ui.view">
        <field name="name">nextcloud.calendar.sync.config.list</field>
        <field name="model">nextcloud.calendar.sync.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="backend_type" widget="badge"
                    decoration-info="backend_type == 'nextcloud'"
                    decoration-warning="backend_type == 'google'"/>
                <field name="nextcloud_user"
                    optional="show"
                    column_invisible="0"/>
                <field name="google_calendar_id" optional="show"/>
                <field name="calendar_owner_id"/>
                <field name="sync_direction"/>
                <field name="event_count"/>
                <field name="last_sync"/>
                <field name="last_sync_status" widget="badge"
                    decoration-success="last_sync_status == 'success'"
                    decoration-danger="last_sync_status == 'error'"
                    decoration-warning="last_sync_status == 'partial'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nextcloud_sync_config_form" model="ir.ui.view">
        <field name="name">nextcloud.calendar.sync.config.form</field>
        <field name="model">nextcloud.calendar.sync.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pull" type="object"
                        string="Pull from Remote" class="btn-primary"
                        invisible="sync_direction == 'odoo_to_nc'"/>
                    <button name="action_push_to_nextcloud" type="object"
                        string="Push to Nextcloud" class="btn-primary"
                        invisible="backend_type != 'nextcloud' or not webhook_url or sync_direction == 'nc_to_odoo'"/>
                    <button name="action_force_full_sync" type="object"
                        string="Force Full Resync" class="btn-secondary"
                        invisible="sync_direction == 'odoo_to_nc'"
                        confirm="This will ignore the incremental sync token and re-fetch all events. Continue?"/>
                    <button name="action_test_connection" type="object"
                        string="Test Connection" class="btn-secondary"
                        invisible="backend_type != 'nextcloud'"/>
                    <button name="action_view_events" type="object"
                        string="View Events" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_events" type="object"
                            class="oe_stat_button" icon="fa-calendar">
                            <field name="event_count" widget="statinfo" string="Events"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., My Personal Google"/>
                        </h1>
                    </div>
                    <group>
                        <field name="backend_type" widget="radio"/>
                    </group>
                    <group>
                        <group name="nextcloud" string="Nextcloud Configuration"
                            invisible="backend_type != 'nextcloud'">
                            <field name="nextcloud_base_url"
                                placeholder="https://nextcloud.example.com"
                                required="backend_type == 'nextcloud'"/>
                            <field name="caldav_path"
                                placeholder="/remote.php/dav/calendars/username/personal/"
                                required="backend_type == 'nextcloud'"/>
                            <field name="nextcloud_user"
                                required="backend_type == 'nextcloud'"/>
                            <field name="nextcloud_app_password" password="True"/>
                        </group>
                        <group name="google" string="Google Configuration"
                            invisible="backend_type != 'google'">
                            <field name="google_calendar_id"
                                placeholder="primary"
                                required="backend_type == 'google'"/>
                            <div colspan="2" class="text-muted" style="font-size: 0.85em;">
                                Use <code>primary</code> for the main calendar.
                                Secondary calendars are identified by their
                                <code>calendarId</code> (see
                                Google Calendar settings &gt; "Integrate calendar").
                                The OAuth token of the Calendar Owner
                                authenticates all API calls.
                            </div>
                        </group>
                        <group name="appearance" string="Appearance">
                            <field name="calendar_color" widget="color"/>
                            <field name="odoo_color" widget="color_picker"/>
                        </group>
                        <group name="sync" string="Sync Settings">
                            <field name="sync_direction"/>
                            <field name="calendar_owner_id"
                                required="backend_type == 'google'"
                                help="Odoo user who will see synced events.
                                For Google, this user's OAuth token is used."/>
                            <field name="webhook_url"
                                placeholder="https://n8n.example.com/webhook/odoo-to-nc"
                                invisible="backend_type != 'nextcloud'"/>
                            <field name="webhook_secret" password="True"
                                invisible="backend_type != 'nextcloud'"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group name="status" string="Sync Status" invisible="not last_sync">
                        <group>
                            <field name="last_sync"/>
                            <field name="last_sync_status" widget="badge"
                                decoration-success="last_sync_status == 'success'"
                                decoration-danger="last_sync_status == 'error'"
                                decoration-warning="last_sync_status == 'partial'"/>
                        </group>
                        <group>
                            <field name="last_sync_message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_nextcloud_sync_config_search" model="ir.ui.view">
        <field name="name">nextcloud.calendar.sync.config.search</field>
        <field name="model">nextcloud.calendar.sync.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nextcloud_user"/>
                <field name="google_calendar_id"/>
                <field name="calendar_owner_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="nextcloud" string="Nextcloud"
                    domain="[('backend_type', '=', 'nextcloud')]"/>
                <filter name="google" string="Google"
                    domain="[('backend_type', '=', 'google')]"/>
                <separator/>
                <filter name="bidirectional" string="Bidirectional"
                    domain="[('sync_direction', '=', 'both')]"/>
                <filter name="nc_to_odoo" string="Remote → Odoo"
                    domain="[('sync_direction', '=', 'nc_to_odoo')]"/>
                <filter name="odoo_to_nc" string="Odoo → Remote"
                    domain="[('sync_direction', '=', 'odoo_to_nc')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_backend" string="Backend"
                        context="{'group_by': 'backend_type'}"/>
                    <filter name="group_owner" string="Calendar Owner"
                        context="{'group_by': 'calendar_owner_id'}"/>
                    <filter name="group_direction" string="Sync Direction"
                        context="{'group_by': 'sync_direction'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nextcloud_sync_config" model="ir.actions.act_window">
        <field name="name">Calendar Sync Configurations</field>
        <field name="res_model">nextcloud.calendar.sync.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nextcloud_sync_config_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure calendar synchronizations
            </p>
            <p>
                Add Nextcloud CalDAV calendars (via n8n) or Google calendars
                (via OAuth 2.0 + API v3) to enable bidirectional sync with Odoo.
            </p>
        </field>
    </record>
</odoo>
