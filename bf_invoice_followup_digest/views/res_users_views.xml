<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The standalone digest is gone, so its cadence and last-sent stamp no
         longer describe anything. Hide them rather than let Preferences promise
         an email that is no longer sent. -->
    <record id="res_users_view_form_followup_digest_section" model="ir.ui.view">
        <field name="name">res.users.form.bf.followup.digest.section</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="bf_invoice_followup.res_users_view_form_followup_digest"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='bf_followup_digest_group']" position="attributes">
                <attribute name="string">Recevables en retard (digest quotidien)</attribute>
            </xpath>
            <xpath expr="//group[@name='bf_followup_digest_group']//field[@name='bf_followup_digest_interval']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='bf_followup_digest_group']//field[@name='bf_followup_digest_last_sent']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
