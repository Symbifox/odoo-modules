<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bookmark_import_view_form" model="ir.ui.view">
        <field name="name">bf.bookmark.import.form</field>
        <field name="model">bf.bookmark.import</field>
        <field name="arch" type="xml">
            <form string="Importer des signets">
                <p class="text-muted">
                    Un export de signets au format HTML : celui de Chrome, Edge, Brave ou
                    Firefox, ou la sauvegarde de l'app Bookmarks de Nextcloud. L'import
                    peut se rejouer sans créer de doublons.
                </p>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="folder_id" domain="[('can_edit', '=', True)]"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importer" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bookmark_import" model="ir.actions.act_window">
        <field name="name">Importer des signets</field>
        <field name="res_model">bf.bookmark.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
