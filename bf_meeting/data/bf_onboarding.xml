<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Configurer Meeting Processor</field>
        <field name="description">Renseignez la racine Nextcloud de transcriptions, le compte courriel d'envoi et les paramètres Speaker Self / API.</field>
        <field name="button_text">Ouvrir Paramètres</field>
        <field name="done_text">Paramètres configurés</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>

    <record id="bf_onb_step_agenda" model="onboarding.onboarding.step">
        <field name="title">Créer un ordre du jour</field>
        <field name="description">[action:bf_meeting.meeting_agenda_action] Préparez un OdJ pour valider la chaîne agenda → meeting → tâches MP.</field>
        <field name="button_text">Nouvel OdJ</field>
        <field name="done_text">Premier OdJ créé</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">2</field>
    </record>

    <record id="bf_onb_step_meeting" model="onboarding.onboarding.step">
        <field name="title">Valider un compte rendu</field>
        <field name="description">[action:bf_meeting.meeting_record_action_draft] Passez en revue les comptes rendus en brouillon avant l'envoi.</field>
        <field name="button_text">Voir les brouillons</field>
        <field name="done_text">Workflow validé</field>
        <field name="panel_step_open_action_name">bf_open_action</field>
        <field name="sequence">3</field>
    </record>

    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Meeting Processor</field>
        <field name="route_name">bf_meeting_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_meeting</field>
        <field name="step_ids" eval="[
            Command.link(ref('bf_meeting.bf_onb_step_settings')),
            Command.link(ref('bf_meeting.bf_onb_step_agenda')),
            Command.link(ref('bf_meeting.bf_onb_step_meeting')),
        ]"/>
    </record>

</odoo>
