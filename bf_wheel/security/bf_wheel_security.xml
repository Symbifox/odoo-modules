<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bf_wheel" model="ir.module.category">
        <field name="name">Roue de fortune</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_bf_wheel_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_category_bf_wheel"/>
        <field name="comment">Fait tourner les roues qu'il voit et lit leur registre.</field>
    </record>

    <!-- 🔴 Sans membre, ce groupe est un cul-de-sac : il détient SEUL le droit de
         créer une roue et ses segments, et rien ne l'impliquait — l'administrateur
         compris. Mesuré en production le 2026-11-09 : personne ne pouvait créer de
         roue. Convention de la maison (bf_editorial et 29 autres modules). -->
    <record id="group_bf_wheel_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_bf_wheel"/>
        <field name="implied_ids" eval="[(4, ref('group_bf_wheel_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Crée et modifie les roues, et note les coordonnées d'une personne tirée.</field>
    </record>

    <!-- Une roue est une animation, pas un secret : tout le personnel peut en
         faire tourner une. Les créer, non. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_bf_wheel_user'))]"/>
    </record>

    <record id="rule_bf_wheel_company" model="ir.rule">
        <field name="name">Roue : société</field>
        <field name="model_id" ref="model_bf_wheel"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_bf_wheel_segment_company" model="ir.rule">
        <field name="name">Segment de roue : société</field>
        <field name="model_id" ref="model_bf_wheel_segment"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_bf_wheel_spin_company" model="ir.rule">
        <field name="name">Tirage : société</field>
        <field name="model_id" ref="model_bf_wheel_spin"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
