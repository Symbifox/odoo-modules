"\n"
"                        <!-- Contact info card -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:28px;border-radius:12px;border:1px solid #E5E7EB;\">\n"
