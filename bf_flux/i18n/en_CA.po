#. module: bf_flux
#. odoo-python
#: code:addons/bf_flux/models/flux_source.py:0
msgid ""
"%(n)s relèves de suite sans rien lire (%(msg)s). Ce qui sort de la fenêtre "
"du flux pendant la panne est perdu : vérifiez l'adresse, ou si l'hôte refuse"
" nos requêtes."
msgstr ""
"%(n)s polls in a row without reading anything (%(msg)s). What leaves the "
"feed's window during the outage is lost: check the address, or whether the "
"host refuses our requests."

#. module: bf_flux
#: model:mail.template,body_html:bf_flux.mail_template_resume
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Bonjour <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 16px 0;\">Voici ce que vos listes de flux ont retenu depuis le dernier résumé.</p>\n"
"    <t t-foreach=\"ctx.get('flux_blocs') or []\" t-as=\"bloc\">\n"
"        <h3 style=\"margin: 20px 0 8px 0; font-size: 16px;\">\n"
"            <t t-out=\"bloc['nom']\"/>\n"
"            <span style=\"font-weight: normal; color: #6B7280; font-size: 13px;\">\n"
"                · <t t-out=\"bloc['total']\"/> élément<t t-if=\"bloc['total'] &gt; 1\">s</t>\n"
"            </span>\n"
"        </h3>\n"
"        <ul style=\"padding-left: 18px; margin: 0;\">\n"
"            <li t-foreach=\"bloc['elements']\" t-as=\"el\" style=\"margin-bottom: 8px;\">\n"
"                <a t-att-href=\"el['lien']\" t-out=\"el['titre']\"/>\n"
"                <t t-if=\"el['emetteur']\"><br/><span style=\"color: #6B7280; font-size: 12px;\" t-out=\"el['emetteur']\"/></t>\n"
"            </li>\n"
"        </ul>\n"
"        <p t-if=\"bloc['autres']\" style=\"margin: 6px 0 0 0; font-size: 13px;\">\n"
"            Et <t t-out=\"bloc['autres']\"/> autre<t t-if=\"bloc['autres'] &gt; 1\">s</t> :\n"
"            <a t-att-href=\"bloc['url']\">tout voir dans Odoo</a>.\n"
"        </p>\n"
"    </t>\n"
"    <p style=\"margin: 24px 0 0 0; font-size: 12px; color: #6B7280;\">\n"
"        Vous recevez ce résumé parce que ces listes vous sont adressées, nommément ou par votre service ou l'un de vos projets.\n"
"        <a t-att-href=\"ctx.get('flux_url_abonnements')\">Régler la fréquence ou se désabonner</a>.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 16px 0;\">Here is what your feed lists retained since the last digest.</p>\n"
"    <t t-foreach=\"ctx.get('flux_blocs') or []\" t-as=\"bloc\">\n"
"        <h3 style=\"margin: 20px 0 8px 0; font-size: 16px;\">\n"
"            <t t-out=\"bloc['nom']\"/>\n"
"            <span style=\"font-weight: normal; color: #6B7280; font-size: 13px;\">\n"
"                · <t t-out=\"bloc['total']\"/> item<t t-if=\"bloc['total'] &gt; 1\">s</t>\n"
"            </span>\n"
"        </h3>\n"
"        <ul style=\"padding-left: 18px; margin: 0;\">\n"
"            <li t-foreach=\"bloc['elements']\" t-as=\"el\" style=\"margin-bottom: 8px;\">\n"
"                <a t-att-href=\"el['lien']\" t-out=\"el['titre']\"/>\n"
"                <t t-if=\"el['emetteur']\"><br/><span style=\"color: #6B7280; font-size: 12px;\" t-out=\"el['emetteur']\"/></t>\n"
"            </li>\n"
"        </ul>\n"
"        <p t-if=\"bloc['autres']\" style=\"margin: 6px 0 0 0; font-size: 13px;\">\n"
"            And <t t-out=\"bloc['autres']\"/> more:\n"
"            <a t-att-href=\"bloc['url']\">see them all in Odoo</a>.\n"
"        </p>\n"
"    </t>\n"
"    <p style=\"margin: 24px 0 0 0; font-size: 12px; color: #6B7280;\">\n"
"        You receive this digest because these lists are addressed to you, by name or through your department or one of your projects.\n"
"        <a t-att-href=\"ctx.get('flux_url_abonnements')\">Change the frequency or unsubscribe</a>.\n"
"    </p>\n"
"</div>\n"
"        "

