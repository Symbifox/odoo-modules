<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_bf_mce" model="ir.ui.view">
        <field name="name">res.company.form.bf.multi.company.email</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Multi-company emails" name="bf_multi_company_email">
                    <group>
                        <group string="Signature">
                            <field name="bf_signature_template_id"/>
                            <field name="bf_signature_enforce"/>
                            <field name="bf_signature_auto_apply"/>
                            <field name="bf_signature_user_count"/>
                            <button name="action_bf_apply_signatures"
                                    type="object"
                                    string="Apply to everyone"
                                    class="btn-secondary"
                                    colspan="2"
                                    confirm="Regenerate the signature of every person attached to this company? Signatures edited by hand will be overwritten."/>
                        </group>
                        <group string="Email routing (company)">
                            <field name="bf_catchall_domain"/>
                            <field name="bf_catchall_alias"/>
                            <field name="bf_bounce_alias"/>
                            <field name="bf_default_from"/>
                        </group>
                    </group>
                    <group string="Signature branding elements">
                        <group>
                            <field name="bf_signature_logo_url"
                                   placeholder="https://…/logo.png"/>
                            <field name="bf_signature_logo_width"/>
                            <field name="bf_signature_tollfree"
                                   placeholder="1-877-000-0000"/>
                            <field name="bf_signature_tagline"/>
                        </group>
                        <group>
                            <field name="bf_signature_accent_color"
                                   widget="color"/>
                            <field name="bf_signature_text_color"
                                   widget="color"/>
                            <field name="bf_signature_muted_color"
                                   widget="color"/>
                            <field name="bf_signature_font"/>
                        </group>
                    </group>
                    <separator string="Confidentiality notice (whole company)"/>
                    <group>
                        <field name="bf_signature_disclaimer_size"/>
                    </group>
                    <field name="bf_signature_disclaimer" widget="html"
                           placeholder="This message and the documents attached to it are confidential…"/>
                    <p class="text-muted">
                        ⚠️ The notice travels <b>with the signature</b>: it appears wherever the signature appears, not on a short reply that carries none. Products that add it to all outgoing mail do so at the gateway; that is neither the same place nor the same tool.
                    </p>

                    <separator string="Quick links (signature footer)"/>
                    <field name="bf_signature_link_ids"
                           context="{'default_company_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="icon" placeholder="📅"/>
                            <field name="name" placeholder="Book an appointment"/>
                            <field name="source"/>
                            <field name="target_url" string="Leads to"
                                   placeholder="https://…"
                                   readonly="source != 'manual'"/>
                            <field name="use_tracker" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        These links are added to each person's own. A link aimed at one person's calendar belongs on their record, not here: otherwise the whole team sends its prospects to the same calendar.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
