<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_category_form_bf_color" model="ir.ui.view">
        <field name="name">res.partner.category.form.bf_color</field>
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_form"/>
        <field name="arch" type="xml">
            <field name="color" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="color" position="after">
                <field name="color_hex" widget="bf_color"/>
                <field name="color_resolved" widget="bf_color_resolved" invisible="not id"/>
            </field>
        </field>
    </record>

    <record id="view_partner_form_bf_color" model="ir.ui.view">
        <field name="name">res.partner.form.bf_color</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="attributes">
                <attribute name="options">{'color_field': 'color', 'bf_color': True}</attribute>
            </field>
        </field>
    </record>

    <record id="view_partner_tree_bf_color" model="ir.ui.view">
        <field name="name">res.partner.list.bf_color</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="category_id" position="attributes">
                <attribute name="options">{'color_field': 'color', 'bf_color': True}</attribute>
            </field>
        </field>
    </record>
</odoo>
