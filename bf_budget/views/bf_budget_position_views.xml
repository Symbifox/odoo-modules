<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_position_view_list" model="ir.ui.view">
        <field name="name">bf.budget.position.list</field>
        <field name="model">bf.budget.position</field>
        <field name="arch" type="xml">
            <list string="Postes budgétaires">
                <field name="code"/>
                <field name="name"/>
                <field name="budget_type"/>
                <field name="account_count" string="Comptes"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="bf_budget_position_view_form" model="ir.ui.view">
        <field name="name">bf.budget.position.form</field>
        <field name="model">bf.budget.position</field>
        <field name="arch" type="xml">
            <form string="Poste budgétaire">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Licences logicielles"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="budget_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="account_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comptes" name="accounts">
                            <field name="account_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   domain="[('company_ids', 'in', company_id), ('deprecated', '=', False)]"/>
                        </page>
                        <page string="Raisonnement" name="note">
                            <field name="note" placeholder="Pourquoi ce poste existe, et ce qu'il ne couvre pas."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_budget_position_view_search" model="ir.ui.view">
        <field name="name">bf.budget.position.search</field>
        <field name="model">bf.budget.position</field>
        <field name="arch" type="xml">
            <search string="Postes budgétaires">
                <field name="name"/>
                <field name="code"/>
                <field name="account_ids"/>
                <filter name="expense" string="Charges" domain="[('budget_type', '=', 'expense')]"/>
                <filter name="revenue" string="Produits" domain="[('budget_type', '=', 'revenue')]"/>
                <separator/>
                <filter name="inactive" string="Archivés" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Sens" context="{'group_by': 'budget_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_budget_position_action" model="ir.actions.act_window">
        <field name="name">Postes budgétaires</field>
        <field name="res_model">bf.budget.position</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier poste budgétaire</p>
            <p>
                Un poste regroupe des comptes du grand livre. Visez trois à cinq postes :
                au-delà, le budget devient un tableau que plus personne ne consulte.
                L'assistant de proposition part de votre plan comptable réel.
            </p>
        </field>
    </record>
</odoo>
