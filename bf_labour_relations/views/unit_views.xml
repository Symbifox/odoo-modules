<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_unit_list" model="ir.ui.view">
        <field name="name">bf.labour.unit.list</field>
        <field name="model">bf.labour.unit</field>
        <field name="arch" type="xml">
            <list string="Unités de négociation" decoration-muted="state == 'revoked'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="union_id"/>
                <field name="certificate_number"/>
                <field name="certificate_date"/>
                <field name="covered_count"/>
                <field name="member_count"/>
                <field name="open_grievance_count" string="Griefs ouverts"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_unit_form" model="ir.ui.view">
        <field name="name">bf.labour.unit.form</field>
        <field name="model">bf.labour.unit</field>
        <field name="arch" type="xml">
            <form string="Unité de négociation">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,certified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_memberships" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="covered_count" widget="statinfo" string="Couverts"/>
                        </button>
                        <button name="action_open_grievances" type="object"
                                class="oe_stat_button" icon="fa-gavel">
                            <field name="open_grievance_count" widget="statinfo"
                                   string="Griefs ouverts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Employés de service, établissement X"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="union_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="certificate_number"/>
                            <field name="certificate_date"/>
                            <field name="current_agreement_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Groupe visé par l'accréditation">
                        <field name="scope_description" nolabel="1"
                               placeholder="Le libellé du certificat : qui est couvert, et qui ne l'est pas."/>
                    </group>
                    <notebook>
                        <page string="Conventions" name="agreements">
                            <field name="agreement_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Personnes rattachées" name="memberships">
                            <field name="membership_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="seniority_date"/>
                                    <field name="covered"/>
                                    <field name="is_member"/>
                                    <field name="date_end"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_unit_search" model="ir.ui.view">
        <field name="name">bf.labour.unit.search</field>
        <field name="model">bf.labour.unit</field>
        <field name="arch" type="xml">
            <search string="Unités">
                <field name="name"/>
                <field name="union_id"/>
                <field name="certificate_number"/>
                <filter name="certified" string="Accréditées"
                        domain="[('state', '=', 'certified')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_union" string="Syndicat" context="{'group_by': 'union_id'}"/>
                    <filter name="group_company" string="Société" context="{'group_by': 'company_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_unit" model="ir.actions.act_window">
        <field name="name">Unités de négociation</field>
        <field name="res_model">bf.labour.unit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune unité de négociation</p>
            <p>Une unité est portée par une société. Un groupe dont chaque
               établissement est une société distincte a autant d'unités que
               d'établissements, chacune avec sa convention et sa propre échéance.</p>
        </field>
    </record>

</odoo>
