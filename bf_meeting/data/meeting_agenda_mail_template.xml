<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="meeting_agenda_mail_template" model="mail.template">
            <field name="name">Ordre du jour de réunion</field>
            <field name="model_id" ref="bf_meeting.model_meeting_agenda"/>
            <field name="lang">{{ object.lang or (object.partner_id and object.partner_id.lang) or 'fr_CA' }}</field>
            <field name="subject">Ordre du jour — {{ object.name }} ({{ object.date.strftime('%Y-%m-%d') }})</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_to_ids }}</field>
            <field name="body_html" type="html">

<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F8FAFC;">
    <tbody>
        <tr>
            <td align="center" style="padding:24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;">
                    <tbody>
                        <!-- Header -->
                        <tr>
                            <td t-attf-style="background-color:{{ brand_dark }}; padding:16px 24px; border-radius:12px 12px 0 0;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tbody>
                                        <tr>
                                            <td align="left" style="color:#FFFFFF; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:16px; font-weight:600;">
                                                <img t-att-src="'/web/image/res.company/%d/%s' % (object.company_id.id, 'meeting_logo' if object.company_id.meeting_logo else 'logo')" alt="Logo" style="height:40px; width:auto; display:block; border:0;"/>
                                            </td>
                                            <td align="right" style="color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;">
                                                Ordre du jour
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>

                        <!-- Accent bar -->
                        <tr>
                            <td t-attf-style="height:4px; line-height:4px; background-color:{{ brand_primary }};">&amp;nbsp;</td>
                        </tr>

                        <!-- Content -->
                        <tr>
                            <td style="padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif;">

                                <h2 t-attf-style="font-size:20px; font-weight:700; color:{{ brand_dark }}; margin:0 0 12px 0;">
                                    <t t-out="object.name"/>
                                </h2>

                                <p style="font-size:13px; color:#6B7280; margin:0 0 20px 0;">
                                    <t t-if="object.date">
                                        <t t-set="is_placeholder" t-value="object.date.hour == 0 and object.date.minute == 0 and object.date.second == 0"/>
                                        <strong style="color:#374151;">Date :</strong>
                                        <t t-if="is_placeholder">
                                            <t t-out="object.date.strftime('%Y-%m-%d')"/>
                                        </t>
                                        <t t-else="">
                                            <t t-out="object.report_date_display_html()"/>
                                        </t>
                                    </t>
                                    <t t-if="object.duration_planned">
                                        &#160;·&#160; <strong style="color:#374151;">Durée prévue :</strong> <t t-out="object.duration_planned"/> min
                                    </t>
                                    <t t-if="object.location">
                                        &#160;·&#160; <strong style="color:#374151;">Lieu :</strong> <t t-out="object.location"/>
                                    </t>
                                </p>

                                <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;">
                                    Bonjour,
                                </p>
                                <p style="font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;">
                                    Voici l'ordre du jour pour la rencontre à venir.
                                </p>

                                <t t-if="object.participant_ids">
                                <div style="margin:0 0 20px 0; padding:12px 14px; background:#F5F7FA; border-radius:6px; font-size:13px; color:#374151;">
                                    <strong t-attf-style="color:{{ brand_dark }};">Participants :</strong>
                                    <t t-foreach="object.participant_ids" t-as="p">
                                        <span t-attf-style="display:inline-block; margin:2px 4px; padding:2px 10px; background:#FFFFFF; border:1px solid #D8DEE4; border-radius:12px; font-size:12px; color:{{ brand_dark }};"><t t-out="p.name"/></span>
                                    </t>
                                </div>
                                </t>

                                <t t-if="object.objectives">
                                <h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left:4px solid {{ brand_primary }};">Objectifs</h3>
                                <div style="margin:0 0 20px 0; white-space:pre-wrap; color:#374151; font-size:15px; line-height:24px;"><t t-out="object.objectives"/></div>
                                </t>

                                <t t-if="object.published_topic_ids">
                                <h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left:4px solid {{ brand_primary }};">Sujets</h3>
                                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:8px 0; font-size:13px;">
                                    <thead>
                                        <tr t-attf-style="background:{{ brand_dark }}; color:#FFFFFF;">
                                            <th style="padding:8px 10px; text-align:left; font-weight:600; width:32px;">#</th>
                                            <th style="padding:8px 10px; text-align:left; font-weight:600;">Sujet</th>
                                            <th style="padding:8px 10px; text-align:center; font-weight:600; width:70px;">Durée</th>
                                            <th style="padding:8px 10px; text-align:left; font-weight:600; width:140px;">Intervenant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="object.published_topic_ids" t-as="topic">
                                            <tr style="border-bottom:1px solid #EAEEF2;">
                                                <td style="padding:8px 10px; color:#8A9099;"><t t-out="topic_index + 1"/></td>
                                                <td style="padding:8px 10px; color:#374151;"><strong t-attf-style="color:{{ brand_dark }};"><t t-out="topic.name"/></strong></td>
                                                <td style="padding:8px 10px; text-align:center; color:#6B7280;">
                                                    <t t-if="topic.duration_planned"><t t-out="topic.duration_planned"/> min</t>
                                                </td>
                                                <td style="padding:8px 10px; color:#6B7280;">
                                                    <t t-if="topic.presenter_id"><t t-out="topic.presenter_id.name"/></t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                </t>

                                <t t-if="object.agenda_task_ids">
                                <h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left:4px solid {{ brand_primary }};">Éléments d'action à discuter</h3>
                                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:8px 0; font-size:13px;">
                                    <thead>
                                        <tr t-attf-style="background:{{ brand_dark }}; color:#FFFFFF;">
                                            <th style="padding:8px 10px; text-align:left; font-weight:600; width:32px;">#</th>
                                            <th style="padding:8px 10px; text-align:left; font-weight:600;">Tâche</th>
                                            <th style="padding:8px 10px; text-align:left; font-weight:600; width:140px;">Assignée à</th>
                                            <th style="padding:8px 10px; text-align:center; font-weight:600; width:100px;">Échéance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="object.agenda_task_ids" t-as="task">
                                            <tr style="border-bottom:1px solid #EAEEF2;">
                                                <td style="padding:8px 10px; color:#8A9099;"><t t-out="task_index + 1"/></td>
                                                <td style="padding:8px 10px; color:#374151;"><strong t-attf-style="color:{{ brand_dark }};"><t t-out="task.name"/></strong></td>
                                                <td style="padding:8px 10px; color:#6B7280;">
                                                    <t t-foreach="task.user_ids" t-as="u"><t t-out="u.name"/><t t-if="not u_last">, </t></t>
                                                </td>
                                                <td style="padding:8px 10px; text-align:center; color:#6B7280;">
                                                    <t t-if="task.date_deadline"><t t-out="task.date_deadline"/></t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                </t>

                                <t t-if="object.preparation_html">
                                <h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left:4px solid {{ brand_primary }};">Préparation</h3>
                                <div style="margin:0 0 20px 0; color:#374151;"><t t-out="object.preparation_html"/></div>
                                </t>

                                <t t-if="object.context_html">
                                <h3 t-attf-style="color:{{ brand_dark }}; font-size:16px; font-weight:600; margin:24px 0 10px 0; padding-left:10px; border-left:4px solid {{ brand_primary }};">Contexte</h3>
                                <div style="margin:0 0 20px 0; color:#374151;"><t t-out="object.context_html"/></div>
                                </t>

                                <p style="font-size:14px; line-height:22px; color:#6B7280; margin:28px 0 0 0;">
                                    Merci de consulter l'ordre du jour et de préparer vos interventions.
                                </p>

                                <t t-if="object.allow_contributions and object.access_token and object.contributions_open">
                                    <t t-set="base" t-value="object.get_base_url()"/>
                                    <div style="margin:24px 0 0 0; padding:14px 16px; background:#F5F7FA; border-radius:6px;">
                                        <p style="font-size:14px; color:#374151; margin:0 0 10px 0;">
                                            Vous souhaitez ajouter un sujet ou laisser une note avant la rencontre ?
                                        </p>
                                        <a t-attf-href="{{ base }}/meeting/agenda/{{ object.access_token }}"
                                           t-attf-style="display:inline-block; padding:10px 18px; background:{{ brand_primary }}; color:#FFFFFF; border-radius:6px; text-decoration:none; font-weight:600; font-size:14px;">
                                            Proposer un sujet ou un commentaire
                                        </a>
                                    </div>
                                </t>

                                <p style="font-size:16px; line-height:26px; color:#374151; margin:24px 0 0 0;">
                                    Cordialement,<br/>
                                    <t t-out="user.name"/>
                                </p>
                            </td>
                        </tr>

                        <!-- Separator -->
                        <tr>
                            <td style="height:1px; line-height:1px; background-color:#E5E7EB;">&amp;nbsp;</td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td style="padding:16px 24px 20px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;">
                                <p style="font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:0;">
                                    <strong t-attf-style="color:{{ brand_dark }};">Ordre du jour envoyé depuis le module Rencontres.</strong>
                                    <t t-if="object.company_id.name"><br/><t t-out="object.company_id.name"/></t>
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Bottom split accent -->
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:600px; max-width:600px; margin:12px auto 0;">
                    <tbody>
                        <tr>
                            <td t-attf-style="height:3px; line-height:3px; background-color:{{ brand_primary }}; width:50%;">&amp;nbsp;</td>
                            <td t-attf-style="height:3px; line-height:3px; background-color:{{ brand_dark }}; width:50%;">&amp;nbsp;</td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
            </field>
            <field name="report_template_ids" eval="[(4, ref('bf_meeting.action_report_meeting_agenda'))]"/>
        </record>

    </data>
</odoo>
