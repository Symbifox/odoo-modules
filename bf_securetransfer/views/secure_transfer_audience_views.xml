<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="secure_transfer_audience_view_tree" model="ir.ui.view">
        <field name="name">secure.transfer.audience.list</field>
        <field name="model">secure.transfer.audience</field>
        <field name="arch" type="xml">
            <list create="false" delete="false"
                  decoration-muted="state == 'blocked'"
                  decoration-success="state == 'confirmed'">
                <field name="transfer_id"/>
                <field name="display_identity"/>
                <field name="identity_kind"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'blocked'"/>
                <field name="first_seen"/>
                <field name="confirmed_at" optional="show"/>
                <field name="download_count"/>
                <field name="otp_send_count" optional="hide"/>
                <field name="sms_send_count" optional="hide"/>
                <field name="ip" optional="hide"/>
                <button name="action_block" type="object"
                        string="Block" icon="fa-ban"
                        invisible="state == 'blocked'"
                        groups="bf_securetransfer.group_securetransfer_manager"/>
                <button name="action_unblock" type="object"
                        string="Unblock" icon="fa-undo"
                        invisible="state != 'blocked'"
                        groups="bf_securetransfer.group_securetransfer_manager"/>
            </list>
        </field>
    </record>

    <record id="secure_transfer_audience_view_search" model="ir.ui.view">
        <field name="name">secure.transfer.audience.search</field>
        <field name="model">secure.transfer.audience</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_identity"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="transfer_id"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_pending" string="Never confirmed"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_blocked" string="Blocked"
                        domain="[('state', '=', 'blocked')]"/>
                <separator/>
                <filter name="filter_sms" string="Mobile identity"
                        domain="[('identity_kind', '=', 'sms')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_transfer" string="Transfer"
                            context="{'group_by': 'transfer_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_secure_transfer_audience" model="ir.actions.act_window">
        <field name="name">Visitors (open audiences)</field>
        <field name="res_model">secure.transfer.audience</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_filter_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No visitors yet</p>
            <p>
                Each line is a person who declared their identity on an open audience link, then confirmed it with a one-time code. Blocking a line cuts off their access without touching the link or the other visitors.
            </p>
        </field>
    </record>

</odoo>
