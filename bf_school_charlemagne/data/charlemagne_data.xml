<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_charlemagne_batch" model="ir.sequence">
        <field name="name">Charlemagne transmission</field>
        <field name="code">bf.school.charlemagne.batch</field>
        <field name="prefix">CHA/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_fetch_answers" model="ir.cron">
        <field name="name">School: fetch the answers of the Ministry (Charlemagne)</field>
        <field name="model_id" ref="model_bf_school_charlemagne_batch"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_answers()</field>
        <field name="interval_number">4</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
