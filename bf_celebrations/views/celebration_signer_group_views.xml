<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_celebration_signer_group_list" model="ir.ui.view">
        <field name="name">bf.celebration.signer.group.list</field>
        <field name="model">bf.celebration.signer.group</field>
        <field name="arch" type="xml">
            <list string="Groupes de signataires">
                <field name="name"/>
                <field name="department_ids" widget="many2many_tags" optional="show"/>
                <field name="member_count"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_celebration_signer_group_form" model="ir.ui.view">
        <field name="name">bf.celebration.signer.group.form</field>
        <field name="model">bf.celebration.signer.group</field>
        <field name="arch" type="xml">
            <form string="Groupe de signataires">
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Équipe de Montréal"/></h1>
                    </div>
                    <p class="text-muted">
                        À qui l'on tend une carte. Le groupe se résout au moment
                        de l'envoi : une personne arrivée depuis dans le service
                        reçoit le lien, une personne partie ne le reçoit pas. Il
                        ne dit jamais qui a signé.
                    </p>
                    <group>
                        <group>
                            <field name="department_ids" widget="many2many_tags"
                                   options="{'no_quick_create': true}"/>
                            <field name="employee_ids" widget="many2many_tags"
                                   options="{'no_quick_create': true}"/>
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags"
                                   options="{'no_quick_create': true}"/>
                            <field name="member_count"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Pourquoi ce groupe, pour qui."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_celebration_signer_group" model="ir.actions.act_window">
        <field name="name">Groupes de signataires</field>
        <field name="res_model">bf.celebration.signer.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun groupe pour l'instant</p>
            <p>Un groupe rassemble des personnes, des services ou des contacts
               à qui l'on envoie le lien d'une carte, une seule fois chacun.
               Il se réutilise d'une carte à l'autre.</p>
        </field>
    </record>

</odoo>
