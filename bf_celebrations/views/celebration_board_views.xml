<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_celebration_board_list" model="ir.ui.view">
        <field name="name">bf.celebration.board.list</field>
        <field name="model">bf.celebration.board</field>
        <field name="arch" type="xml">
            <list string="Cartes">
                <field name="name"/>
                <field name="recipient_name"/>
                <field name="delivery_date"/>
                <field name="published_post_count" string="Signatures"/>
                <field name="organizer_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-success="state == 'delivered'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_celebration_board_form" model="ir.ui.view">
        <field name="name">bf.celebration.board.form</field>
        <field name="model">bf.celebration.board</field>
        <field name="arch" type="xml">
            <form string="Carte collective">
                <header>
                    <button name="action_ouvrir" type="object"
                            string="Ouvrir aux signatures" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_apercu" type="object"
                            string="Voir la page" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_diaporama" type="object"
                            string="Diaporama" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_inviter_signataires" type="object"
                            string="Inviter les signataires" class="btn-secondary"
                            invisible="state != 'open'"
                            groups="bf_celebrations.group_organizer"
                            help="Envoie le lien aux groupes et aux autres signataires qui ne l'ont pas encore reçu. La personne fêtée n'est jamais écrite."/>
                    <button name="action_livrer_maintenant" type="object"
                            string="Livrer maintenant"
                            invisible="state != 'open'"
                            confirm="La personne fêtée recevra la carte tout de suite, avec le PDF et la page souvenir en pièces jointes. Continuer ?"/>
                    <button name="action_regenerer_jeton" type="object"
                            string="Couper le lien" invisible="state != 'open'"
                            confirm="L'ancien lien cessera de fonctionner pour tout le monde. Continuer ?"/>
                    <button name="action_annuler" type="object"
                            string="Annuler" invisible="state in ('delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Bonne fête !"/></h1>
                    </div>
                    <div class="alert alert-info o_cel_lien" role="status"
                         invisible="state == 'draft'">
                        <div class="d-flex flex-wrap align-items-start gap-3">
                            <div class="flex-grow-1">
                                <p class="mb-1"><strong>Le lien à partager</strong></p>
                                <field name="contribution_url" widget="CopyClipboardChar"
                                       nolabel="1"/>
                                <p class="mb-1 mt-2">
                                    Aucun compte n'est demandé. Le code QR mène à
                                    la même page : imprimez-le, collez-le dans la
                                    cuisine.
                                </p>
                                <p class="mb-0" invisible="state != 'delivered'">
                                    <strong>La carte livrée :</strong>
                                    <field name="board_url" widget="CopyClipboardChar"
                                           nolabel="1"/>
                                </p>
                                <field name="access_token" invisible="1"/>
                            </div>
                            <!-- ⚠️ La 1.0 annonçait le code QR ici et ne
                                 l'affichait pas : la phrase finissait sur un
                                 champ invisible. -->
                            <field name="qr_image" widget="image" nolabel="1"
                                   class="o_cel_qr"
                                   options="{'size': [140, 140], 'zoom': true}"/>
                        </div>
                    </div>
                    <group>
                        <group string="Pour qui">
                            <field name="recipient_employee_id"/>
                            <field name="recipient_partner_id"/>
                            <field name="recipient_email"/>
                            <field name="occasion_id"/>
                        </group>
                        <group string="Quand et comment">
                            <field name="delivery_date"/>
                            <field name="organizer_id"/>
                            <field name="theme"/>
                            <field name="moderation"/>
                            <field name="allow_images"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-success" role="status"
                         invisible="not thanks_html">
                        <p class="mb-1"><strong>Merci de la personne fêtée</strong>,
                           reçu le <field name="thanks_date" readonly="1" class="oe_inline"/></p>
                        <field name="thanks_html" readonly="1" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Signataires" name="signataires"
                              groups="bf_celebrations.group_organizer">
                            <p class="text-muted">
                                À qui l'on tend la carte. Le lien part une seule
                                fois par adresse, à l'ouverture puis à chaque
                                « Inviter les signataires ». La personne fêtée est
                                retirée par toutes ses adresses, même si elle
                                fait partie du service.
                            </p>
                            <group>
                                <field name="signer_group_ids" widget="many2many_tags"
                                       options="{'no_quick_create': true}"/>
                                <field name="signer_partner_ids" widget="many2many_tags"
                                       options="{'no_quick_create': true}"/>
                                <field name="invited_count" readonly="1"/>
                            </group>
                            <field name="invited_keys" invisible="1"/>
                        </page>
                        <page string="Mot d'introduction" name="intro">
                            <field name="intro_html"
                                   placeholder="Ce que les gens lisent en arrivant sur la page."/>
                            <field name="background_image" widget="image"
                                   class="mt-3" options="{'size': [400, 200]}"/>
                        </page>
                        <page string="Signatures" name="messages">
                            <field name="post_ids" readonly="1">
                                <list>
                                    <field name="author_name"/>
                                    <field name="body" widget="html"/>
                                    <field name="style" optional="show"/>
                                    <field name="has_ink" string="Tracé" optional="show"/>
                                    <field name="image" widget="image"
                                           options="{'size': [60, 60]}"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'pending'"
                                           decoration-success="state == 'published'"
                                           decoration-muted="state == 'rejected'"/>
                                    <button name="action_publier" type="object"
                                            icon="fa-check" title="Publier"
                                            invisible="state == 'published'"/>
                                    <button name="action_retirer" type="object"
                                            icon="fa-ban" title="Retirer"
                                            invisible="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="published_post_count" invisible="1"/>
                    <field name="recipient_name" invisible="1"/>
                    <field name="recipient_user_id" invisible="1"/>
                    <field name="empty_notified" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_celebration_board_kanban" model="ir.ui.view">
        <field name="name">bf.celebration.board.kanban</field>
        <field name="model">bf.celebration.board</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="recipient_name"/>
                            </div>
                            <div class="mt-2">
                                <i class="fa fa-pencil me-1" title="Signatures" role="img" aria-label="Signatures"/>
                                <field name="published_post_count"/>
                                signature(s)
                            </div>
                            <div class="text-muted">
                                <i class="fa fa-clock-o me-1" title="Livraison prévue" role="img" aria-label="Livraison prévue"/>
                                <field name="delivery_date" widget="date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_celebration_board" model="ir.actions.act_window">
        <field name="name">Cartes collectives</field>
        <field name="res_model">bf.celebration.board</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune carte pour l'instant</p>
            <p>Une carte s'ouvre depuis une occasion du calendrier, ou ici
               pour un événement qui n'a pas de date au dossier.</p>
        </field>
    </record>

</odoo>
