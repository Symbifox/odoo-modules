<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_babillard_post_form" model="ir.ui.view">
        <field name="name">bf.babillard.post.form</field>
        <field name="model">bf.babillard.post</field>
        <field name="arch" type="xml">
            <!-- 🔴 Ce que le LECTEUR voit tient en haut : un visage, une
                 signature, le texte. Les réglages de diffusion (audience,
                 échéance, épingle, commentaires, société) sont les commandes de
                 la RÉDACTION, et ils rendaient la page d'une reconnaissance
                 impossible à distinguer d'une fiche d'administration. -->
            <form string="Publication">
                <header>
                    <button name="action_publier" type="object" string="Publier"
                            class="btn-primary" invisible="state == 'publie'"
                            groups="bf_babillard.group_babillard_redacteur"/>
                    <button name="action_retirer" type="object" string="Retirer du fil"
                            invisible="state != 'publie'"
                            groups="bf_babillard.group_babillard_redacteur"/>
                    <button name="action_remettre_en_brouillon" type="object"
                            string="Remettre en brouillon" invisible="state != 'echue'"
                            groups="bf_babillard.group_babillard_redacteur"/>
                    <button name="action_marquer_lu" type="object" string="J'ai lu"
                            class="btn-primary" invisible="not a_lire_pour_moi"/>
                    <button name="action_fermer_sondage" type="object"
                            string="Fermer le sondage"
                            invisible="type_publication != 'sondage' or state != 'publie' or sondage_ferme"
                            groups="bf_babillard.group_babillard_redacteur"/>
                    <button name="action_rouvrir_sondage" type="object"
                            string="Rouvrir le sondage"
                            invisible="type_publication != 'sondage' or not sondage_ferme"
                            groups="bf_babillard.group_babillard_redacteur"/>
                    <!-- 🔴 La barre d'état est un outil de rédaction. Affichée au
                         lecteur, elle transformait la page d'une reconnaissance en
                         fiche de suivi : « brouillon > publié > échue » n'apprend
                         rien à qui vient lire une annonce. -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,publie,echue"
                           groups="bf_babillard.group_babillard_redacteur"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- ⚠️ Un bouton de statistique porte UN champ, en widget
                             statinfo. Un <field> niché dans un <span> fait tomber
                             le formulaire ENTIER en OwlError, côté navigateur
                             seulement : le serveur charge la vue sans rien dire. -->
                        <button name="action_voir_manquants" type="object"
                                class="oe_stat_button" icon="fa-user-times"
                                invisible="not lecture_requise or state != 'publie'"
                                groups="bf_babillard.group_babillard_redacteur">
                            <field name="nb_lectures" widget="statinfo" string="ont lu"/>
                        </button>
                        <!-- Le relais du gestionnaire : son équipe, personne d'autre. -->
                        <button name="action_voir_manquants_equipe" type="object"
                                class="oe_stat_button" icon="fa-users"
                                string="Mon équipe"
                                invisible="not peut_relancer_equipe"/>
                    </div>
                    <widget name="web_ribbon" title="Lue" bg_color="text-bg-success"
                            invisible="not lu_par_moi"/>
                    <!-- 🔴 Le dépouillement du fil de discussion ne peut pas se
                         décider en CSS : rien dans le DOM ne dit à quel groupe
                         appartient qui regarde. Ce marqueur, lui, n'est servi
                         qu'au lecteur, le serveur retirant le nœud avant que le
                         navigateur le voie. La feuille de style le lit avec
                         `:has()`, depuis `.o_form_view`, le seul ancêtre commun
                         à la feuille et au fil de discussion.

                         ⚠️ Odoo 18 refuse `groups_id` sur une vue HÉRITÉE
                         (« Use 'groups' attributes inside the view definition »),
                         et une vue primaire à `groups_id` LÈVE une erreur pour
                         les autres au lieu d'être écartée. Le marqueur est ce
                         qu'il reste, et il a l'avantage de se mesurer dans
                         l'arbre rendu. -->
                    <div class="o_bf_bab_marque_lecteur d-none"
                         groups="!bf_babillard.group_babillard_redacteur"/>
                    <!-- Champs de condition, lisibles par toute l'audience. -->
                    <field name="lu_par_moi" invisible="1"/>
                    <field name="a_lire_pour_moi" invisible="1"/>
                    <field name="peut_relancer_equipe" invisible="1"/>
                    <field name="lecture_requise" invisible="1"/>
                    <field name="commentaires_ouverts" invisible="1"/>
                    <field name="personne_avatar" invisible="1"/>
                    <!-- 🔴 En haut, l'image ne fait que se MONTRER. La zone de dépôt
                         vide d'Odoo mesure 260 px : posée ici, elle occupait le tiers
                         de la page de toute publication sans image, pour la rédaction.
                         On la charge depuis le bloc Diffusion, avec les autres
                         commandes. -->
                    <div class="o_bf_bab_couverture mb-3" invisible="not image_couverture">
                        <field name="image_couverture" widget="image" nolabel="1"
                               readonly="1" options="{'zoom': false}"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Le titre que les gens liront"/></h1>
                        <!-- 🔴 Le type décide de TOUT le reste de l'écran : c'est lui
                             qui fait apparaître le bloc du sondage. Enterré dans
                             « Diffusion », sous le corps du texte, il n'était pas
                             trouvable : la première personne à vouloir poser un sondage
                             n'a pas trouvé comment (2026-09-22). Il est donc ici, sous
                             le titre, et il n'y est qu'une fois : le même champ en
                             lecture seule, dans la signature, est réservé à qui n'est
                             pas de la rédaction. -->
                        <field name="type_publication" class="o_bf_bab_type_saisie"
                               groups="bf_babillard.group_babillard_redacteur"/>
                    </div>
                    <div class="o_bf_bab_entete d-flex align-items-center gap-2 mb-3">
                        <field name="personne_avatar" widget="image" nolabel="1"
                               readonly="1" class="o_bf_bab_visage"
                               options="{'zoom': false}"
                               invisible="not personne_avatar"/>
                        <field name="auteur_avatar" widget="image" nolabel="1"
                               readonly="1" class="o_bf_bab_visage"
                               options="{'zoom': false}"
                               invisible="personne_avatar"/>
                        <!-- 🔴 Le visage et le nom en gras doivent désigner la même
                             personne : la carte d'un badge montrait le visage d'Anouk
                             au-dessus du nom de Félix. Quand une personne est mise en
                             avant, c'est elle en tête, et l'auteur signe en dessous. -->
                        <div class="d-flex flex-column">
                            <span class="fw-bold">
                                <field name="personne_nom" nolabel="1" readonly="1"
                                       invisible="not personne_nom"/>
                                <field name="auteur_nom" nolabel="1" readonly="1"
                                       invisible="personne_nom"/>
                            </span>
                            <span class="text-muted small d-flex align-items-center gap-1">
                                <field name="type_publication" nolabel="1" readonly="1"
                                       groups="!bf_babillard.group_babillard_redacteur"/>
                                <span invisible="state == 'brouillon'">·</span>
                                <!-- La journée, pas la seconde : « 2026-09-15 07:23:37 »
                                     dans la signature d'une annonce n'apprend rien. -->
                                <field name="date_affichee" nolabel="1" readonly="1"
                                       invisible="state == 'brouillon'"/>
                                <span invisible="not personne_nom">· par</span>
                                <field name="auteur_nom" nolabel="1" readonly="1"
                                       invisible="not personne_nom"/>
                            </span>
                        </div>
                        <field name="reactions" widget="bf_babillard_reactions"
                               nolabel="1" class="ms-2"
                               invisible="state != 'publie'"/>
                        <span class="badge text-bg-warning ms-2"
                              invisible="not a_lire_pour_moi">À lire</span>
                        <span class="text-muted small ms-2"
                              invisible="not lecture_requise or not date_echeance">
                            d'ici le <field name="date_echeance" nolabel="1" readonly="1"/>
                        </span>
                    </div>
                    <field name="corps_html" placeholder="Ce qu'il faut savoir, en clair."/>
                    <!-- Le bulletin, à la place où le lecteur le cherche : sous
                         le texte, avant les commentaires. Il n'est pas dans le
                         bloc Diffusion parce qu'il n'appartient pas à la
                         rédaction. -->
                    <field name="sondage" widget="bf_babillard_sondage" nolabel="1"
                           invisible="type_publication != 'sondage' or state == 'brouillon'"/>
                    <div class="alert alert-light border mt-2" role="status"
                         invisible="commentaires_ouverts">
                        Les commentaires sont fermés sur cette publication.
                    </div>
                    <group string="Diffusion" name="reglages"
                           groups="bf_babillard.group_babillard_redacteur">
                        <group>
                            <field name="auteur_user_id"/>
                            <field name="personne_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="image_couverture" widget="image"
                                   options="{'zoom': false, 'size': [0, 90]}"/>
                            <field name="date_publication" invisible="state == 'brouillon'"/>
                            <field name="date_echeance"/>
                            <field name="epingle"/>
                        </group>
                        <group>
                            <field name="audience"/>
                            <field name="department_ids" widget="many2many_tags"
                                   invisible="audience != 'departements'"
                                   required="audience == 'departements'"/>
                            <field name="group_ids" widget="many2many_tags"
                                   invisible="audience != 'groupes'"
                                   required="audience == 'groupes'"/>
                            <field name="lecture_requise"/>
                            <field name="nb_destinataires"
                                   invisible="not lecture_requise or state == 'brouillon'"/>
                            <field name="commentaires_ouverts"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Sondage" name="sondage"
                           invisible="type_publication != 'sondage'"
                           groups="bf_babillard.group_babillard_redacteur">
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="not sondage_avertissement">
                            <field name="sondage_avertissement" nolabel="1" readonly="1"/>
                        </div>
                        <group>
                            <field name="sondage_choix_multiple"/>
                            <field name="sondage_anonyme"/>
                        </group>
                        <group>
                            <field name="sondage_ajout_ouvert"/>
                            <field name="sondage_max_ajouts"
                                   invisible="not sondage_ajout_ouvert"/>
                            <field name="sondage_ferme"/>
                        </group>
                        <field name="option_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name" string="Choix"/>
                                <field name="propose_par_id" optional="show"
                                       readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <group string="Suivi de lecture" invisible="not lecture_requise"
                           groups="bf_babillard.group_babillard_redacteur">
                        <field name="lecture_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="user_id"/>
                                <field name="date"/>
                            </list>
                        </field>
                    </group>
                    <div class="mt-3 text-end">
                        <button name="%(action_babillard_signalement_nouveau)d" type="action"
                                icon="fa-flag-o" title="Signaler ce contenu"
                                class="btn btn-sm btn-link text-muted o_bf_bab_signaler"
                                context="{'default_post_ref': id}"
                                invisible="state != 'publie'"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_babillard_post_list" model="ir.ui.view">
        <field name="name">bf.babillard.post.list</field>
        <field name="model">bf.babillard.post</field>
        <field name="arch" type="xml">
            <list string="Publications" decoration-muted="state == 'echue'"
                  decoration-bf="epingle">
                <field name="epingle" widget="boolean_favorite" nolabel="1"/>
                <field name="name"/>
                <field name="type_publication"/>
                <field name="audience"/>
                <!-- ⚠️ Un en-tête long se fait rogner par la liste sans le dire :
                     « Lecture obligatoire » devenait « Lecture obli... ». -->
                <field name="lecture_requise" string="À lire"/>
                <field name="nb_lectures" string="Lu par"/>
                <field name="nb_destinataires" string="Visés"/>
                <field name="date_publication"/>
                <field name="date_echeance"/>
                <field name="sondage_ferme" string="Fermé" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_babillard_post_kanban" model="ir.ui.view">
        <field name="name">bf.babillard.post.kanban</field>
        <field name="model">bf.babillard.post</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_bf_bab_fil">
                <!-- ⚠️ Tout champ lu par le gabarit (record.X.raw_value) doit être
                     déclaré ici : sinon la carte tombe en OwlError DANS LE
                     NAVIGATEUR, et le serveur ne dit rien. -->
                <field name="lu_par_moi"/>
                <field name="a_lire_pour_moi"/>
                <field name="epingle"/>
                <field name="lecture_requise"/>
                <field name="type_publication"/>
                <field name="personne_avatar"/>
                <field name="auteur_avatar"/>
                <field name="image_couverture"/>
                <field name="nb_commentaires"/>
                <field name="reactions"/>
                <field name="sondage"/>
                <field name="est_nouveau"/>
                <templates>
                    <t t-name="card">
                        <div class="o_bf_bab_couverture mb-2"
                             t-if="record.image_couverture.raw_value">
                            <field name="image_couverture" widget="image"
                                   options="{'zoom': false}"/>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <field name="personne_avatar" widget="image"
                                   class="o_bf_bab_visage o_bf_bab_visage_carte"
                                   options="{'zoom': false}"
                                   t-if="record.personne_avatar.raw_value"/>
                            <field name="auteur_avatar" widget="image"
                                   class="o_bf_bab_visage o_bf_bab_visage_carte"
                                   options="{'zoom': false}"
                                   t-if="!record.personne_avatar.raw_value"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted d-flex align-items-center flex-wrap gap-1 mt-1">
                                    <!-- La couleur trie avant la lecture : quatre
                                         types se lisaient tous en gris. -->
                                    <span t-attf-class="o_bf_bab_pastille o_bf_bab_pastille_#{record.type_publication.raw_value}">
                                        <field name="type_publication"/>
                                    </span>
                                    <span>·</span>
                                    <field name="date_affichee"/>
                                    <span class="badge text-bg-primary ms-1"
                                          t-if="record.est_nouveau.raw_value">Nouveau</span>
                                    <span class="badge text-bg-warning ms-1"
                                          t-if="record.lecture_requise.raw_value and !record.lu_par_moi.raw_value">À lire</span>
                                </div>
                            </div>
                            <i class="fa fa-thumb-tack ms-2" t-if="record.epingle.raw_value"
                               title="Épinglée"/>
                        </div>
                        <!-- 🔴 Le corps entier tenait dans la carte : une politique
                             de trois pages noyait tout le reste du fil. -->
                        <div class="mt-2 o_bf_bab_extrait"><field name="corps_html" widget="html"/></div>
                        <field name="sondage" widget="bf_babillard_sondage" nolabel="1"
                               t-if="record.type_publication.raw_value === 'sondage'"/>
                        <div class="mt-2 d-flex align-items-center flex-wrap gap-2">
                            <!-- Le seul geste que le module demande, sur la carte :
                                 il fallait ouvrir la publication pour le poser. -->
                            <button name="action_marquer_lu" type="object"
                                    class="btn btn-sm btn-primary"
                                    t-if="record.a_lire_pour_moi.raw_value">J'ai lu</button>
                            <span class="badge text-bg-success"
                                  t-if="record.lu_par_moi.raw_value">Lue</span>
                            <field name="reactions" widget="bf_babillard_reactions"
                                   nolabel="1"/>
                            <span class="text-muted small ms-auto"
                                  t-if="record.nb_commentaires.raw_value">
                                <i class="fa fa-comment-o me-1" title="Commentaires"/><field name="nb_commentaires"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_babillard_post_search" model="ir.ui.view">
        <field name="name">bf.babillard.post.search</field>
        <field name="model">bf.babillard.post</field>
        <field name="arch" type="xml">
            <search string="Babillard">
                <field name="name"/>
                <field name="corps_html"/>
                <field name="auteur_user_id"/>
                <filter name="a_lire" string="À lire"
                        domain="[('lecture_requise', '=', True), ('lu_par_moi', '=', False)]"/>
                <filter name="epinglees" string="Épinglées" domain="[('epingle', '=', True)]"/>
                <separator/>
                <filter name="au_fil" string="Au fil" domain="[('state', '=', 'publie')]"/>
                <filter name="brouillons" string="Brouillons" domain="[('state', '=', 'brouillon')]"/>
                <filter name="echues" string="Échues" domain="[('state', '=', 'echue')]"/>
                <separator/>
                <filter name="les_miennes" string="Mes publications"
                        domain="[('auteur_user_id', '=', uid)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="par_type" string="Type" context="{'group_by': 'type_publication'}"/>
                    <filter name="par_etat" string="État" context="{'group_by': 'state'}"/>
                    <filter name="par_auteur" string="Auteur" context="{'group_by': 'auteur_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_babillard_fil" model="ir.actions.act_window">
        <field name="name">Le fil</field>
        <field name="res_model">bf.babillard.post</field>
        <!-- 🔴 Le domaine vit sur l'ACTION, pas dans un `search_default` : la
             puce « Au fil ✕ » invitait à retirer le seul filtre qui définit le
             fil, et le compteur de pagination faisait ressembler un babillard à
             une table. `kanban,form` retire aussi le sélecteur de vue. -->
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('state', '=', 'publie')]</field>
        <!-- ⚠️ POSÉ à vide, pas retiré : un `-u` n'écrit que ce que le fichier
             fournit, donc supprimer la ligne laissait `search_default_au_fil`
             en base et la puce « Au fil ✕ » à l'écran. -->
        <field name="context">{}</field>
        <field name="limit">200</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Rien au babillard pour l'instant.</p>
            <p>Les annonces adressées à votre équipe apparaîtront ici.</p>
        </field>
    </record>

    <!-- 🔴 Un sondage est un TYPE de publication, ce que rien à l'écran ne disait.
         Cette action est la porte d'entrée qui manquait : elle ne liste que les
         sondages, et un « Nouveau » y naît déjà du bon type. -->
    <record id="action_babillard_sondages" model="ir.actions.act_window">
        <field name="name">Sondages</field>
        <field name="res_model">bf.babillard.post</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type_publication', '=', 'sondage')]</field>
        <field name="context">{'default_type_publication': 'sondage'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Poser une question à la maison</p>
            <p>Le titre est la question, et la publication porte ses propres choix.
               On vote d'un clic sur la carte du fil.</p>
        </field>
    </record>

    <record id="action_babillard_publications" model="ir.actions.act_window">
        <field name="name">Publications</field>
        <field name="res_model">bf.babillard.post</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
