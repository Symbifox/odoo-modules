<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_process_form_document" model="ir.ui.view">
        <field name="name">bf.process.form.document</field>
        <field name="model">bf.process</field>
        <field name="inherit_id" ref="bf_process.view_bf_process_form"/>
        <field name="arch" type="xml">
            <button name="action_telecharger_pdf" position="before">
                <button name="action_telecharger_document" type="object"
                        string="Generate the document" class="btn-primary"
                        invisible="diagram_count == 0"
                        help="The complete deliverable: cover, legend, table of contents, one level per page, appendices, validation register and unfolded map. The &quot;Render as PDF&quot; button only renders the bare drawing."/>
            </button>
            <page name="source" position="before">
                <page string="Document" name="document"
                      invisible="diagram_count == 0">
                    <group>
                        <field name="sous_titre"
                               placeholder="Current state (AS-IS), from … to …"/>
                        <field name="pied_document"
                               placeholder="If empty, the first line of the source."/>
                        <field name="date_document"/>
                    </group>
                    <field name="section_ids" nolabel="1"
                           context="{'default_process_id': id}">
                        <list editable="bottom" decoration-muted="kind == 'validation'">
                            <field name="kind" widget="badge"/>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="body" widget="html" optional="hide"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="kind"/>
                                    <field name="sequence"/>
                                    <field name="name"/>
                                </group>
                                <field name="body" widget="html"
                                       placeholder="Each one fills in something the source does not say. A wrong assumption moves arrows, never real work."/>
                            </sheet>
                        </form>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
