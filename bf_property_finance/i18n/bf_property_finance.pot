"Saisissez ses imputations plutôt que d'appliquer l'ordre supplétif de l'art."
" 1572."
msgstr ""

#. module: bf_property_finance
#: model:ir.model.fields,help:bf_property_finance.field_bf_property_payment__imputation_mode
