<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bf_floorplan" model="ir.module.category">
        <field name="name">Plans d'étage</field>
        <field name="description">Le plan du bureau, dessiné depuis les enregistrements.</field>
        <field name="sequence">46</field>
    </record>

    <!-- Tout le monde lit : un plan sert d'abord à trouver quelqu'un ou
         quelque chose. Seule la gestion dessine. -->
    <record id="group_bf_floorplan_manager" model="res.groups">
        <field name="name">Gestion</field>
        <field name="category_id" ref="module_category_bf_floorplan"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Créer les plans, poser et déplacer les formes, exporter.</field>
    </record>

    <record id="rule_bf_floorplan_company" model="ir.rule">
        <field name="name">Plan d'étage : société</field>
        <field name="model_id" ref="model_bf_floorplan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bf_floorplan_zone_company" model="ir.rule">
        <field name="name">Zone de plan : société</field>
        <field name="model_id" ref="model_bf_floorplan_zone"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bf_floorplan_element_company" model="ir.rule">
        <field name="name">Élément de plan : société</field>
        <field name="model_id" ref="model_bf_floorplan_element"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bf_floorplan_lien_company" model="ir.rule">
        <field name="name">Lien de plan : société</field>
        <field name="model_id" ref="model_bf_floorplan_lien"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
