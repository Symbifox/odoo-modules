#. module: hosting_management
#: model:mail.template,body_html:hosting_management.email_template_backup_report
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Backup report</p>\n"
"<h1 t-attf-style=\"margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:24px;line-height:32px;color:{{ brand_dark }};font-weight:500;\">\n"
"                          Daily backup report\n"
"                        </h1>\n"
"                        <p style=\"margin:0 0 16px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:17px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          Run at <t t-out=\"object.run_date.strftime('%Y-%m-%d %H:%M:%S')\"/> on <t t-out=\"object.hostname or 'unknown server'\"/>\n"
"                        </p>\n"
"\n"
"                        <!-- Status summary -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-radius:10px;margin-bottom:20px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td t-attf-style=\"padding:16px;border-radius:10px;border:1px solid {{ '#FECACA' if object.state == 'failed' else '#FDE68A' if object.state == 'partial' else '#BFDBFE' if object.state == 'warning' else '#A7F3D0' }};background-color:{{ '#FEE2E2' if object.state == 'failed' else '#FEF3C7' if object.state == 'partial' else '#DBEAFE' if object.state == 'warning' else '#D1FAE5' }};\">\n"
"                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                  <tbody>\n"
"                                    <tr>\n"
"                                      <td t-attf-style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;font-weight:600;color:{{ '#DC2626' if object.state == 'failed' else '#D97706' if object.state == 'partial' else '#1D4ED8' if object.state == 'warning' else '#059669' }};\">\n"
"                                        <t t-if=\"object.state == 'failed'\">ERRORS DETECTED</t>\n"
"                                        <t t-elif=\"object.state == 'partial'\">PARTIAL SUCCESS: MISSING DATA</t>\n"
"                                        <t t-elif=\"object.state == 'warning'\">ALL BACKUPS SUCCEEDED (with warnings)</t>\n"
"                                        <t t-else=\"\">ALL BACKUPS SUCCEEDED</t>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                      <td style=\"padding-top:8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#374151;\">\n"
"                                        <strong style=\"color:#059669;\"><t t-out=\"object.success_count\"/></strong> succeeded |\n"
"                                        <strong style=\"color:#1D4ED8;\"><t t-out=\"object.warning_count\"/></strong> warnings |\n"
"                                        <strong style=\"color:#DC2626;\"><t t-out=\"object.failed_count\"/></strong> failed |\n"
"                                        <strong style=\"color:#D97706;\"><t t-out=\"object.skipped_count\"/></strong> skipped |\n"
"                                        <strong><t t-out=\"object.total_count\"/></strong> total\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Backup details table -->\n"
"                        <h2 t-attf-style=\"margin:24px 0 12px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;color:{{ brand_dark }};font-weight:500;\">\n"
"                          Backup details\n"
"                        </h2>\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border:1px solid #E5E7EB;border-radius:8px;border-collapse:separate;\">\n"
"                          <thead>\n"
"                            <tr style=\"background-color:#F9FAFB;\">\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Service</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Status</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Archives</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Files</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Duration</th>\n"
"                            </tr>\n"
"                          </thead>\n"
"                          <tbody>\n"
"                            <t t-foreach=\"object.line_ids\" t-as=\"line\">\n"
"                              <tr style=\"border-bottom:1px solid #E5E7EB;\">\n"
"                                <td t-attf-style=\"padding:12px 8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;font-weight:600;color:{{ brand_dark }};vertical-align:top;\">\n"
"                                  <t t-out=\"line.service_name\"/>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;vertical-align:top;\">\n"
"                                  <span t-attf-style=\"display:inline-block;padding:4px 8px;border-radius:4px;font-size:12px;font-weight:600;background-color:{{ '#D1FAE5' if line.status == 'success' else '#FEE2E2' if line.status == 'failed' else '#FEF3C7' }};color:{{ '#059669' if line.status == 'success' else '#DC2626' if line.status == 'failed' else '#D97706' }};\">\n"
"                                    <t t-if=\"line.status == 'success'\">OK</t>\n"
"                                    <t t-elif=\"line.status == 'failed'\">FAILED</t>\n"
"                                    <t t-else=\"\">SKIPPED</t>\n"
"                                  </span>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;vertical-align:top;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:13px;\">\n"
"                                  <t t-if=\"line.report_type == 'restic'\">\n"
"                                    <t t-if=\"line.snapshot_count &gt; 0\">\n"
"                                      <span style=\"font-weight:600;color:#059669;\">\n"
"                                        <t t-out=\"line.snapshot_count\"/>\n"
"                                      </span>\n"
"                                      <span style=\"color:#6B7280;font-size:11px;\"> snapshot<t t-if=\"line.snapshot_count &gt; 1\">s</t></span>\n"
"                                    </t>\n"
"                                    <t t-else=\"\">\n"
"                                      <span style=\"color:#9CA3AF;\">-</span>\n"
"                                    </t>\n"
"                                  </t>\n"
"                                  <t t-elif=\"line.container_count &gt; 0\">\n"
"                                    <span t-attf-style=\"font-weight:600;color:{{ '#059669' if line.verified_file_count &gt;= line.container_count else '#DC2626' }};\">\n"
"                                      <t t-out=\"line.verified_file_count\"/>/<t t-out=\"line.container_count\"/>\n"
"                                    </span>\n"
"                                    <span style=\"color:#6B7280;font-size:11px;\"> verified</span>\n"
"                                  </t>\n"
"                                  <t t-elif=\"line.verified_file_count &gt; 0\">\n"
"                                    <span style=\"font-weight:600;color:#059669;\"><t t-out=\"line.verified_file_count\"/></span>\n"
"                                    <span style=\"color:#6B7280;font-size:11px;\"> verified</span>\n"
"                                  </t>\n"
"                                  <t t-else=\"\">\n"
"                                    <span style=\"color:#9CA3AF;\">-</span>\n"
"                                  </t>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;vertical-align:top;\">\n"
"                                  <t t-if=\"line.report_type == 'restic'\">\n"
"                                    <t t-foreach=\"line.snapshot_ids\" t-as=\"snap\">\n"
"                                      <div style=\"font-size:12px;color:#374151;margin-top:4px;\">\n"
"                                        <span style=\"color:#059669;font-weight:bold;\">✓</span>\n"
"                                        <t t-out=\"snap.container or snap.destination or '?'\"/><br/>\n"
"                                        <span style=\"color:#9CA3AF;font-size:11px;\">\n"
"                                          <t t-out=\"snap.files_new\"/> files added · <t t-out=\"snap.data_added_human\"/>\n"
"                                        </span>\n"
"                                      </div>\n"
"                                    </t>\n"
"                                    <t t-if=\"not line.snapshot_ids\">\n"
"                                      <span style=\"color:#9CA3AF;font-size:12px;\">No snapshots</span>\n"
"                                    </t>\n"
"                                  </t>\n"
"                                  <t t-else=\"\">\n"
"                                    <t t-foreach=\"line.file_ids\" t-as=\"file\">\n"
"                                      <div style=\"font-size:12px;color:#374151;margin-top:4px;\">\n"
"                                        <span t-attf-style=\"color:{{ '#059669' if file.verified else '#DC2626' }};font-weight:bold;\">\n"
"                                          <t t-if=\"file.verified\">✓</t>\n"
"                                          <t t-else=\"\">✗</t>\n"
"                                        </span>\n"
"                                        <t t-out=\"file.name\"/><br/>\n"
"                                        <span style=\"color:#9CA3AF;font-size:11px;\">\n"
"                                          SHA256: <t t-out=\"(file.checksum or '')[:16]\"/>... | Size: <t t-out=\"file.size\"/>\n"
"                                        </span>\n"
"                                      </div>\n"
"                                    </t>\n"
"                                    <t t-if=\"not line.file_ids\">\n"
"                                      <span style=\"color:#9CA3AF;font-size:12px;\">No files</span>\n"
"                                    </t>\n"
"                                  </t>\n"
"                                  <t t-if=\"line.error_message\">\n"
"                                    <div style=\"color:#DC2626;font-size:12px;margin-top:4px;\">\n"
"                                      <t t-out=\"line.error_message\"/>\n"
"                                    </div>\n"
"                                  </t>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#6B7280;vertical-align:top;\">\n"
"                                  <t t-out=\"line.duration\"/>\n"
"                                </td>\n"
"                              </tr>\n"
"                            </t>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <p style=\"margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:13px;line-height:20px;color:#6B7280;\">\n"
"                          If there is a problem, contact\n"
"                          <a t-attf-href=\"mailto:{{ company.email or '' }}\" t-attf-style=\"color:{{ brand_primary }};text-decoration:none;\"><t t-out=\"company.email or ''\"/></a>\n"
"                        </p>\n"
"<p style=\"font-size:12px; line-height:18px; color:#6B7280; margin:24px 0 0 0;\">Report generated automatically by your hosting module.</p>"
msgstr ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"></t>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"></t>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"></t>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Rapport de sauvegarde</p>\n"
"<h1 t-attf-style=\"margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:24px;line-height:32px;color:{{ brand_dark }};font-weight:500;\">\n"
"                          Rapport quotidien des sauvegardes\n"
"                        </h1>\n"
"                        <p style=\"margin:0 0 16px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:17px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          Exécuté le <t t-out=\"object.run_date.strftime('%Y-%m-%d %H:%M:%S')\"></t> sur <t t-out=\"object.hostname or 'serveur inconnu'\"></t>\n"
"                        </p>\n"
"\n"
"                        <!-- Status summary -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-radius:10px;margin-bottom:20px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td t-attf-style=\"padding:16px;border-radius:10px;border:1px solid {{ '#FECACA' if object.state == 'failed' else '#FDE68A' if object.state == 'partial' else '#BFDBFE' if object.state == 'warning' else '#A7F3D0' }};background-color:{{ '#FEE2E2' if object.state == 'failed' else '#FEF3C7' if object.state == 'partial' else '#DBEAFE' if object.state == 'warning' else '#D1FAE5' }};\">\n"
"                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                  <tbody>\n"
"                                    <tr>\n"
"                                      <td t-attf-style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;font-weight:600;color:{{ '#DC2626' if object.state == 'failed' else '#D97706' if object.state == 'partial' else '#1D4ED8' if object.state == 'warning' else '#059669' }};\">\n"
"                                        <t t-if=\"object.state == 'failed'\">ERREURS DÉTECTÉES</t>\n"
"                                        <t t-elif=\"object.state == 'partial'\">SUCCÈS PARTIEL — DONNÉES MANQUANTES</t>\n"
"                                        <t t-elif=\"object.state == 'warning'\">TOUS LES BACKUPS RÉUSSIS (avec avertissements)</t>\n"
"                                        <t t-else=\"\">TOUS LES BACKUPS RÉUSSIS</t>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                      <td style=\"padding-top:8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#374151;\">\n"
"                                        <strong style=\"color:#059669;\"><t t-out=\"object.success_count\"></t></strong> réussis |\n"
"                                        <strong style=\"color:#1D4ED8;\"><t t-out=\"object.warning_count\"></t></strong> avert. |\n"
"                                        <strong style=\"color:#DC2626;\"><t t-out=\"object.failed_count\"></t></strong> échoués |\n"
"                                        <strong style=\"color:#D97706;\"><t t-out=\"object.skipped_count\"></t></strong> ignorés |\n"
"                                        <strong><t t-out=\"object.total_count\"></t></strong> total\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Backup details table -->\n"
"                        <h2 t-attf-style=\"margin:24px 0 12px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;color:{{ brand_dark }};font-weight:500;\">\n"
"                          Détails des sauvegardes\n"
"                        </h2>\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border:1px solid #E5E7EB;border-radius:8px;border-collapse:separate;\">\n"
"                          <thead>\n"
"                            <tr style=\"background-color:#F9FAFB;\">\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Service</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Statut</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Archives</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Fichiers</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Durée</th>\n"
"                            </tr>\n"
"                          </thead>\n"
"                          <tbody>\n"
"                            <t t-foreach=\"object.line_ids\" t-as=\"line\">\n"
"                              <tr style=\"border-bottom:1px solid #E5E7EB;\">\n"
"                                <td t-attf-style=\"padding:12px 8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;font-weight:600;color:{{ brand_dark }};vertical-align:top;\">\n"
"                                  <t t-out=\"line.service_name\"></t>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;vertical-align:top;\">\n"
"                                  <span t-attf-style=\"display:inline-block;padding:4px 8px;border-radius:4px;font-size:12px;font-weight:600;background-color:{{ '#D1FAE5' if line.status == 'success' else '#FEE2E2' if line.status == 'failed' else '#FEF3C7' }};color:{{ '#059669' if line.status == 'success' else '#DC2626' if line.status == 'failed' else '#D97706' }};\">\n"
"                                    <t t-if=\"line.status == 'success'\">OK</t>\n"
"                                    <t t-elif=\"line.status == 'failed'\">ÉCHEC</t>\n"
"                                    <t t-else=\"\">IGNORÉ</t>\n"
"                                  </span>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;vertical-align:top;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:13px;\">\n"
"                                  <t t-if=\"line.report_type == 'restic'\">\n"
"                                    <t t-if=\"line.snapshot_count &gt; 0\">\n"
"                                      <span style=\"font-weight:600;color:#059669;\">\n"
"                                        <t t-out=\"line.snapshot_count\"></t>\n"
"                                      </span>\n"
"                                      <span style=\"color:#6B7280;font-size:11px;\"> snapshot<t t-if=\"line.snapshot_count &gt; 1\">s</t></span>\n"
"                                    </t>\n"
"                                    <t t-else=\"\">\n"
"                                      <span style=\"color:#9CA3AF;\">-</span>\n"
"                                    </t>\n"
"                                  </t>\n"
"                                  <t t-elif=\"line.container_count &gt; 0\">\n"
"                                    <span t-attf-style=\"font-weight:600;color:{{ '#059669' if line.verified_file_count &gt;= line.container_count else '#DC2626' }};\">\n"
"                                      <t t-out=\"line.verified_file_count\"></t>/<t t-out=\"line.container_count\"></t>\n"
"                                    </span>\n"
"                                    <span style=\"color:#6B7280;font-size:11px;\"> vérifiées</span>\n"
"                                  </t>\n"
"                                  <t t-elif=\"line.verified_file_count &gt; 0\">\n"
"                                    <span style=\"font-weight:600;color:#059669;\"><t t-out=\"line.verified_file_count\"></t></span>\n"
"                                    <span style=\"color:#6B7280;font-size:11px;\"> vérifiées</span>\n"
"                                  </t>\n"
"                                  <t t-else=\"\">\n"
"                                    <span style=\"color:#9CA3AF;\">-</span>\n"
"                                  </t>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;vertical-align:top;\">\n"
"                                  <t t-if=\"line.report_type == 'restic'\">\n"
"                                    <t t-foreach=\"line.snapshot_ids\" t-as=\"snap\">\n"
"                                      <div style=\"font-size:12px;color:#374151;margin-top:4px;\">\n"
"                                        <span style=\"color:#059669;font-weight:bold;\">✓</span>\n"
"                                        <t t-out=\"snap.container or snap.destination or '?'\"></t><br>\n"
"                                        <span style=\"color:#9CA3AF;font-size:11px;\">\n"
"                                          <t t-out=\"snap.files_new\"></t> fichiers ajoutés · <t t-out=\"snap.data_added_human\"></t>\n"
"                                        </span>\n"
"                                      </div>\n"
"                                    </t>\n"
"                                    <t t-if=\"not line.snapshot_ids\">\n"
"                                      <span style=\"color:#9CA3AF;font-size:12px;\">Aucun snapshot</span>\n"
"                                    </t>\n"
"                                  </t>\n"
"                                  <t t-else=\"\">\n"
"                                    <t t-foreach=\"line.file_ids\" t-as=\"file\">\n"
"                                      <div style=\"font-size:12px;color:#374151;margin-top:4px;\">\n"
"                                        <span t-attf-style=\"color:{{ '#059669' if file.verified else '#DC2626' }};font-weight:bold;\">\n"
"                                          <t t-if=\"file.verified\">✓</t>\n"
"                                          <t t-else=\"\">✗</t>\n"
"                                        </span>\n"
"                                        <t t-out=\"file.name\"></t><br>\n"
"                                        <span style=\"color:#9CA3AF;font-size:11px;\">\n"
"                                          SHA256: <t t-out=\"(file.checksum or '')[:16]\"></t>... | Taille: <t t-out=\"file.size\"></t>\n"
"                                        </span>\n"
"                                      </div>\n"
"                                    </t>\n"
"                                    <t t-if=\"not line.file_ids\">\n"
"                                      <span style=\"color:#9CA3AF;font-size:12px;\">Aucun fichier</span>\n"
"                                    </t>\n"
"                                  </t>\n"
"                                  <t t-if=\"line.error_message\">\n"
"                                    <div style=\"color:#DC2626;font-size:12px;margin-top:4px;\">\n"
"                                      <t t-out=\"line.error_message\"></t>\n"
"                                    </div>\n"
"                                  </t>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#6B7280;vertical-align:top;\">\n"
"                                  <t t-out=\"line.duration\"></t>\n"
"                                </td>\n"
"                              </tr>\n"
"                            </t>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <p style=\"margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:13px;line-height:20px;color:#6B7280;\">\n"
"                          En cas de problème, contactez\n"
"                          <a t-attf-href=\"mailto:{{ company.email or '' }}\" t-attf-style=\"color:{{ brand_primary }};text-decoration:none;\"><t t-out=\"company.email or ''\"></t></a>\n"
"                        </p>\n"
"<p style=\"font-size:12px; line-height:18px; color:#6B7280; margin:24px 0 0 0;\">Rapport généré automatiquement par votre module d'hébergement.</p>"

#. module: hosting_management
#: model:mail.template,body_html:hosting_management.mail_template_client_intervention_report
msgid ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"/>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Intervention completed</p>\n"
"<p t-attf-style=\"margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;line-height:28px;color:{{ brand_dark }};font-weight:500;\">\n"
"                          Hello <t t-out=\"object.name or 'valued customer'\"/>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 24px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          We have completed an intervention on your services. Here is the summary.\n"
"                        </p>\n"
"\n"
"                        <!-- Success badge -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td style=\"padding:16px 20px;background-color:#ECFDF5;border-radius:12px;border-left-width:4px; border-left-style:solid; border-left-color:#059669;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:600;color:#059669;\">\n"
"                                  ✓ Intervention successful\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Intervention details -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;border-radius:12px;border:1px solid #E5E7EB;\">\n"
"                          <tbody>\n"
"                            <!-- Ce qui a &#233;t&#233; fait -->\n"
"                            <tr>\n"
"                              <td style=\"padding:20px 20px 0 20px;\">\n"
"                                <p style=\"margin:0 0 6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#059669;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Work performed\n"
"                                </p>\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;line-height:24px;color:#374151;font-weight:300;\">\n"
"                                  <t t-out=\"ctx.get('intervention_summary', 'Routine maintenance completed successfully.')\"/>\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                            <!-- Dur&#233;e -->\n"
"                            <tr>\n"
"                              <td style=\"padding:16px 20px 0 20px;\">\n"
"                                <p style=\"margin:0 0 6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#059669;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Duration\n"
"                                </p>\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;line-height:24px;color:#374151;font-weight:300;\">\n"
"                                  <t t-out=\"ctx.get('intervention_duration', 'Not specified')\"/>\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                            <!-- R&#233;sultat -->\n"
"                            <tr>\n"
"                              <td style=\"padding:16px 20px 0 20px;\">\n"
"                                <p style=\"margin:0 0 6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#059669;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                  Result\n"
"                                </p>\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;line-height:24px;color:#374151;font-weight:300;\">\n"
"                                  <t t-out=\"ctx.get('intervention_result', 'All services are operating normally.')\"/>\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                            <!-- Recommandations -->\n"
"                            <t t-if=\"ctx.get('recommendations')\">\n"
"                              <tr>\n"
"                                <td style=\"padding:16px 20px 20px 20px;\">\n"
"                                  <p style=\"margin:0 0 6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#0369A1;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                    Recommendations\n"
"                                  </p>\n"
"                                  <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;line-height:24px;color:#374151;font-weight:300;\">\n"
"                                    <t t-out=\"ctx.get('recommendations')\"/>\n"
"                                  </p>\n"
"                                </td>\n"
"                              </tr>\n"
"                            </t>\n"
"                            <t t-if=\"not ctx.get('recommendations')\">\n"
"                              <tr>\n"
"                                <td style=\"padding:0 0 20px 0;\">&amp;nbsp;</td>\n"
"                              </tr>\n"
"                            </t>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Message additionnel via ctx -->\n"
"                        <t t-if=\"ctx.get('message_body')\">\n"
"                          <t t-out=\"ctx.get('message_body')\"/>\n"
"                        </t>\n"
"\n"
"                        <p style=\"margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          Feel free to contact us if you have any questions.\n"
"                        </p>\n"
"                        <p t-attf-style=\"margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:{{ brand_dark }};font-weight:400;\">\n"
"                          Best regards,<br/>\n"
"                          <strong>The <t t-out=\"company.name or 'support'\"/> team</strong>\n"
"                        </p>\n"
"            "
msgstr ""
"<t t-set=\"company\" t-value=\"(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)\"></t>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and company.report_brand_primary) or '#714B67'\"></t>\n"
"<t t-set=\"brand_dark\" t-value=\"(company and company.report_brand_dark) or '#212529'\"></t>\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Intervention complétée</p>\n"
"<p t-attf-style=\"margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;line-height:28px;color:{{ brand_dark }};font-weight:500;\">\n"
"                          Bonjour <t t-out=\"object.name or 'cher client'\"></t>,\n"
"                        </p>\n"
"                        <p style=\"margin:0 0 24px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          Nous avons complété une intervention sur vos services. Voici le résumé.\n"
"                        </p>\n"
"\n"
"                        <!-- Success badge -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td style=\"padding:16px 20px;background-color:#ECFDF5;border-radius:12px;border-left-width:4px; border-left-style:solid; border-left-color:#059669;\">\n"
"                                <p style=\"margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:600;color:#059669;\">\n"
"                                  ✓ Intervention réussie\n"
"                                </p>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Intervention details -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;border-radius:12px;border:1px solid #E5E7EB;\">\n"
"                          <tbody>\n"
