#. module: bf_household_base
#. odoo-python
#: code:addons/bf_household_base/models/res_users.py:0
msgid ""
"%(user)s is a household user and cannot hold an administration group, "
"nor one that reads every message of the household."
msgstr ""
"%(user)s est une personne du foyer et ne peut détenir ni un groupe "
"d'administration, ni un groupe qui lit tous les messages du foyer."

#. module: bf_household_base
#: model:res.groups,comment:bf_household_base.group_household_user
msgid ""
"A person of the household: an internal account. The household modules add "
"the apps it opens."
msgstr ""
"Une personne du foyer : un compte interne. Les modules du foyer y "
"ajoutent les applis qu'ils ouvrent."

#. module: bf_household_base
#: model:ir.module.category,name:bf_household_base.module_category_household
msgid "Household"
msgstr "Foyer"

#. module: bf_household_base
#: model:res.groups,name:bf_household_base.group_household_user
msgid "Household user"
msgstr "Personne du foyer"

#. module: bf_household_base
#. odoo-python
#: code:addons/bf_household_base/models/res_users.py:0
msgid ""
"This household already has %(max)s accounts, the most its plan allows. "
"Remove an account first, or ask Blue Fox."
msgstr ""
"Ce foyer a déjà %(max)s comptes, le maximum de son forfait. Retirez d'abord "
"un compte, ou demandez à Blue Fox."

#. module: bf_household_base
#: model:ir.model,name:bf_household_base.model_res_users
msgid "User"
msgstr "Utilisateur"
