<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ⚠️ Un livrable porte un titre, un résumé et des FICHIERS. Sans règle
             d'enregistrement, tout utilisateur interne de toute société lisait ceux
             des autres : le modèle portait bien un `company_id`, mais un champ de
             société ne cloisonne rien tant qu'une règle ne s'en sert pas. C'est le
             même oubli que sur n'importe quel modèle sensible, et il ne se voit pas
             tant qu'on n'a qu'une société. -->
        <record id="rule_federation_document_company" model="ir.rule">
            <field name="name">Livrable fédéré : société</field>
            <field name="model_id" ref="model_federation_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
