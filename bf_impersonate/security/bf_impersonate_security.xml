<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bf_impersonate" model="ir.module.category">
        <field name="name">Impersonation</field>
        <field name="description">See Symbifox as another internal user, to help them.</field>
        <field name="sequence">95</field>
    </record>

    <!-- Rien n'est donné d'office : ni à l'uid 2 (un compte souvent partagé),
         ni aux administrateurs. Le droit s'accorde à la main. -->
    <record id="group_impersonate_read" model="res.groups">
        <field name="name">Read only</field>
        <field name="category_id" ref="module_category_bf_impersonate"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Can see Symbifox as another internal user, without changing anything.</field>
    </record>

    <record id="group_impersonate_write" model="res.groups">
        <field name="name">Read and write</field>
        <field name="category_id" ref="module_category_bf_impersonate"/>
        <field name="implied_ids" eval="[Command.link(ref('group_impersonate_read'))]"/>
        <field name="comment">Can also act as that user. Every change is recorded in the journal; nothing is ever sent in their name.</field>
    </record>

    <!-- Le journal : l'incarnateur et la personne voient leurs entrées, les
         administrateurs toutes. Personne n'écrit, sauf le code. -->
    <record id="rule_bf_impersonate_session_own" model="ir.rule">
        <field name="name">Impersonation journal: own entries</field>
        <field name="model_id" ref="model_bf_impersonate_session"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('target_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bf_impersonate_session_admin" model="ir.rule">
        <field name="name">Impersonation journal: administrators see all</field>
        <field name="model_id" ref="model_bf_impersonate_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bf_impersonate_session_line_own" model="ir.rule">
        <field name="name">Impersonation journal lines: own entries</field>
        <field name="model_id" ref="model_bf_impersonate_session_line"/>
        <field name="domain_force">['|', ('session_id.user_id', '=', user.id), ('session_id.target_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bf_impersonate_session_line_admin" model="ir.rule">
        <field name="name">Impersonation journal lines: administrators see all</field>
        <field name="model_id" ref="model_bf_impersonate_session_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
