#. module: bf_budget_forecast
#. odoo-python
#: code:addons/bf_budget_forecast/models/bf_budget_forecast_period.py:0
msgid ""
"\"%(name)s\" belongs to a published version: its figures can no longer be "
"edited."
msgstr ""
"« %(name)s » appartient à une passe publiée : ses chiffres ne se retouchent "
"plus."

#. module: bf_budget_forecast
#. odoo-python
#: code:addons/bf_budget_forecast/models/bf_budget_forecast.py:0
msgid ""
"\"%(name)s\" is published: its figures record what was believed at that "
"time. Roll a new version forward rather than editing this one."
msgstr ""
"« %(name)s » est publiée : ses chiffres sont la trace de ce qu'on croyait à "
"ce moment-là. Roulez une nouvelle passe plutôt que de retoucher celle-ci."

#. module: bf_budget_forecast
#: model_terms:ir.ui.view,arch_db:bf_budget_forecast.bf_budget_forecast_view_form
msgid ". To forecast differently, roll a new version forward."
msgstr ""
".\n"
"                        Pour prévoir autrement, roulez une nouvelle passe."

#. module: bf_budget_forecast
#: model:ir.model.constraint,message:bf_budget_forecast.constraint_bf_budget_forecast_line_position_uniq_per_forecast
msgid "A budget item has only one line per forecast version."
msgstr "Un poste n'a qu'une ligne par passe de prévision."

#. module: bf_budget_forecast
#: model_terms:ir.actions.act_window,help:bf_budget_forecast.bf_budget_forecast_action
msgid ""
"A forecast is redone every month: actuals gain a month, the horizon moves "
"forward by as much, and the previous version stays readable as it was made. "
"Comparing versions is what teaches something, not the figure of a single "
"version."
msgstr ""
"Une prévision se refait chaque mois : le réel gagne un mois, l'horizon\n"
"                avance d'autant, et la passe précédente reste lisible telle qu'on l'avait\n"
"                faite. C'est la comparaison entre les passes qui apprend quelque chose,\n"
"                pas le chiffre d'une passe isolée."

#. module: bf_budget_forecast
#: model:ir.model.fields,help:bf_budget_forecast.field_bf_budget_forecast_period__is_closed
msgid "A month that ends on or before the actuals date."
msgstr "Un mois qui finit à la date d'arrêt du réel ou avant."

#. module: bf_budget_forecast
#. odoo-python
#: code:addons/bf_budget_forecast/models/bf_budget_forecast.py:0
msgid "A published version cannot be deleted: it is a dated record."
msgstr "Une passe publiée ne se supprime pas : c'est une trace datée."

#. module: bf_budget_forecast
#. odoo-python
#: code:addons/bf_budget_forecast/models/bf_budget_forecast.py:0
msgid ""
"A version already rolled forward cannot be reopened: the next one is the "
