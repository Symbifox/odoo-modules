<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_music_tariff_list" model="ir.ui.view">
        <field name="name">bf.music.tariff.list</field>
        <field name="model">bf.music.tariff</field>
        <field name="arch" type="xml">
            <list string="Tariffs" decoration-warning="state == 'proposed'"
                  decoration-muted="not rate_confirmed">
                <field name="society"/>
                <field name="code"/>
                <field name="label" optional="show"/>
                <field name="usage"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="basis"/>
                <field name="rate_proposed"/>
                <field name="rate_certified" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'certified'"
                       decoration-warning="state == 'proposed'"/>
                <field name="rate_confirmed" string="Verified"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_music_tariff_form" model="ir.ui.view">
        <field name="name">bf.music.tariff.form</field>
        <field name="model">bf.music.tariff</field>
        <field name="arch" type="xml">
            <form string="Tariff">
                <header>
                    <button name="action_mark_certified" type="object"
                            string="Mark as certified" class="oe_highlight"
                            invisible="state == 'certified'"
                            confirm="Marking this tariff as certified recalculates the adjustment of every period linked to it. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,certified"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Rate not verified" bg_color="text-bg-warning"
                            invisible="rate_confirmed"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="society"/>
                            <field name="code"/>
                            <field name="label"/>
                            <field name="usage"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Period">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="publication_date"/>
                            <field name="certification_date"
                                   required="state == 'certified'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Proposed rate">
                            <field name="basis"/>
                            <field name="rate_base_proposed"/>
                            <field name="rate_proposed"/>
                            <field name="minimum_proposed"/>
                            <field name="seasonal_half"/>
                        </group>
                        <group string="Certified rate">
                            <field name="rate_base_certified"/>
                            <field name="rate_certified"/>
                            <field name="minimum_certified"/>
                            <field name="rate_in_force" readonly="1"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Source">
                        <field name="rate_confirmed"/>
                        <field name="source_url" widget="url"/>
                        <field name="notes" placeholder="What remains to be verified against the tariff text."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_music_tariff_search" model="ir.ui.view">
        <field name="name">bf.music.tariff.search</field>
        <field name="model">bf.music.tariff</field>
        <field name="arch" type="xml">
            <search string="Tariffs">
                <field name="code"/>
                <field name="label"/>
                <filter name="proposed" string="Proposed tariffs" domain="[('state', '=', 'proposed')]"/>
                <filter name="certified" string="Certified tariffs" domain="[('state', '=', 'certified')]"/>
                <separator/>
                <filter name="unconfirmed" string="Rate not verified"
                        domain="[('rate_confirmed', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_society" string="Collective society" context="{'group_by': 'society'}"/>
                    <filter name="group_usage" string="Use" context="{'group_by': 'usage'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_music_tariff" model="ir.actions.act_window">
        <field name="name">Tariffs</field>
        <field name="res_model">bf.music.tariff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The tariff register</p>
            <p>One line per collective society, tariff and period. Each line carries the proposed rate and the certified rate: the difference between the two makes the retroactive adjustment.</p>
        </field>
    </record>

</odoo>
