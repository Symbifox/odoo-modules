<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adresse lisible de la liste des billets : /odoo/helpdesk-tickets/<id>.
         Les liens des avis (ntfy, condensés, alertes de pic, digest) la
         supposaient, et elle n'existait pas : « L'action helpdesk-tickets
         n'existe pas ». -->
    <record id="helpdesk_mgmt.helpdesk_ticket_action" model="ir.actions.act_window">
        <field name="path">helpdesk-tickets</field>
    </record>


  <!-- Override the OCA helpdesk_mgmt root menu so the module's icon appears
       in the app launcher. The model and actions remain shared with
       helpdesk_mgmt. Le libellé reste « Helpdesk » (« Assistance » en
       français) : « Helpdesk Blue Fox » s'affichait aux usagers anglophones
       de tout locataire. -->
  <menuitem
      id="helpdesk_mgmt.helpdesk_ticket_main_menu"
      name="Helpdesk"
      web_icon="bf_helpdesk,static/description/icon.png"
      sequence="16"
      groups="helpdesk_mgmt.group_helpdesk_user_own"/>

</odoo>
