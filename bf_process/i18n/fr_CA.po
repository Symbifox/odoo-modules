#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/document.py:0
msgid " (continued)"
msgstr " (suite)"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid " (target)"
msgstr " (souhaité)"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/comparaison.py:0
msgid "\"%(avant)s\" to \"%(apres)s\""
msgstr "« %(avant)s » vers « %(apres)s »"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/comparaison.py:0
msgid "\"%(avant)s\" to \"%(apres)s\" in \"%(niveau)s\""
msgstr "« %(avant)s » vers « %(apres)s » dans « %(niveau)s »"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/comparaison.py:0
msgid "\"%(libelle)s\""
msgstr "« %(libelle)s »"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/comparaison.py:0
msgid "\"%(nom)s\": %(avant)s to %(apres)s in \"%(niveau)s\""
msgstr "« %(nom)s » : %(avant)s vers %(apres)s dans « %(niveau)s »"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/edition.py:0
msgid ""
"\"%s v%s\" is a validated version: its drawing can no longer be edited. "
"Create the next version, or reopen this one."
msgstr ""
"« %s v%s » est une version validée : son tracé ne se modifie plus. Créez la "
"version suivante, ou rouvrez celle-ci."

#. module: bf_process
#. odoo-javascript
#: code:addons/bf_process/static/src/visualiseur/visualiseur.js:0
msgid ""
"\"%s\" and everything connected to it will be removed from the drawing. This"
" operation is logged in the process chatter."
msgstr ""
"« %s » et tout ce qui s'y raccorde seront retirés du tracé. Cette opération "
"est inscrite au fil du processus."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ecart.py:0
msgid "\"%s\" does not say which current state it is drawn from."
msgstr "« %s » ne dit pas d'après quel état actuel il est dessiné."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/fusion.py:0
msgid ""
"\"%s\" has changed since the analysis. Run the analysis again: the gaps "
"shown were computed against a state that no longer exists."
msgstr ""
"« %s » a changé depuis l'analyse. Relancez l'analyse : les écarts affichés "
"ont été calculés contre un état qui n'existe plus."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/document.py:0
msgid ""
"\"%s\" has no body. An empty section gets numbered and reads as an omission:"
" write it, or remove it."
msgstr ""
"« %s » n'a pas de corps. Une section vide se numérote et se lit comme une "
"omission : écrivez-la, ou retirez-la."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/document.py:0
msgid "\"%s\" has no level yet: there is no map to put in a document."
msgstr ""
"« %s » n'a encore aucun niveau : il n'y a pas de carte à mettre dans un "
"document."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid ""
"\"%s\" has no level: there is nothing to start from to draw what we would "
"want instead."
msgstr ""
"« %s » n'a aucun niveau : il n'y a rien à reprendre pour dessiner ce qu'on "
"voudrait à la place."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ressource.py:0
msgid ""
"\"%s\" has several targets. A QR code opens only one: choose which, and make"
" two resources if both matter."
msgstr ""
"« %s » a plusieurs cibles. Un code QR n'en ouvre qu'une : choisissez "
"laquelle, et faites-en deux ressources si les deux comptent."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/gel.py:0
msgid ""
"\"%s\" is a validated version: it can no longer be edited.\n"
"\n"
"Create the next version, or reopen this one from its record if the validation was premature."
msgstr ""
"« %s » est une version validée : elle ne se modifie plus.\n"
"\n"
"Créez la version suivante, ou rouvrez celle-ci depuis sa fiche si la validation était prématurée."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/fusion.py:0
msgid ""
"\"%s\" is a validated version: it can no longer be edited. Create the next "
"version, or reopen this one, before merging a file into it."
msgstr ""
"« %s » est une version validée : elle ne se modifie plus. Créez la version "
"suivante, ou rouvrez celle-ci, avant de fusionner un fichier dedans."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid ""
"\"%s\" is a validated version: its content can no longer be edited. Create "
"the next version, or reopen this one."
msgstr ""
"« %s » est une version validée : son contenu ne se modifie plus. Créez la "
"version suivante, ou rouvrez celle-ci."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid ""
"\"%s\" is already a target process. A target is drawn from the current "
"state."
msgstr ""
"« %s » est déjà un processus souhaité. Une cible se dessine d'après l'état "
"actuel."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid ""
"\"%s\" is already a target process: a target is drawn from the current "
"state, not from another target."
msgstr ""
"« %s » est déjà un processus souhaité : une cible se dessine d'après l'état "
"actuel, pas d'après une autre cible."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/edition.py:0
msgid "\"%s\" is not a node type."
msgstr "« %s » n'est pas un type de nœud."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/fusion.py:0
msgid "\"%s\" is not in the file"
msgstr "« %s » n'est pas dans le fichier"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ecart.py:0
msgid "\"%s\" is not linked to any project: a task would have nowhere to go."
msgstr ""
"« %s » n'est rattaché à aucun projet : une tâche n'aurait nulle part où "
"aller."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ressource.py:0
msgid ""
"\"%s\" leads nowhere: give it a file, an address, or a policy from the "
"knowledge base."
msgstr ""
"« %s » ne mène nulle part : donnez-lui un fichier, une adresse, ou une "
"politique de la base de connaissances."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/edition.py:0
msgid ""
"\"%s\" opens level \"%s\". Detach the page before removing the subprocess "
"that leads to it, otherwise it becomes unreachable without anything saying "
"so."
msgstr ""
"« %s » ouvre le niveau « %s ». Détachez la page avant de retirer le sous-"
"processus qui y mène, sinon elle devient inatteignable sans que rien ne le "
"dise."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ressource.py:0
msgid ""
"\"%s\": this file is attached to another record. Attach it to the step or "
"upload it in the resource."
msgstr ""
"« %s » : ce fichier est rattaché à un autre dossier. Joignez-le à l'étape ou"
" téléversez-le dans la ressource."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ressource.py:0
msgid "\"%s\": you do not have access to this document."
msgstr "« %s » : vous n'avez pas accès à ce document."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ressource.py:0
msgid "\"%s\": you do not have access to this file."
msgstr "« %s » : vous n'avez pas accès à ce fichier."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/comparaison.py:0
msgid "%(depart)s to %(cible)s"
msgstr "%(depart)s vers %(cible)s"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/comparaison.py:0
msgid "%(depart)s to %(cible)s: \"%(avant)s\" to \"%(apres)s\""
msgstr "%(depart)s vers %(cible)s : « %(avant)s » vers « %(apres)s »"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/comparaison.py:0
msgid "%(genre)s \"%(nom)s\" in \"%(niveau)s\""
msgstr "%(genre)s « %(nom)s » dans « %(niveau)s »"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/comparaison.py:0
msgid "%(genre)s: %(libelle)s"
msgstr "%(genre)s : %(libelle)s"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/serialisation.py:0
msgid "%(nom)s · %(avant)s to %(apres)s"
msgstr "%(nom)s · %(avant)s vers %(apres)s"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/importation.py:0
msgid "%(quoi)s \"%(nom)s\""
msgstr "%(quoi)s « %(nom)s »"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/importation.py:0
msgid "%d element(s) of the file were not read."
msgstr "%d élément(s) du fichier n'ont pas été lus."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ecart.py:0
msgid ""
"%d gap(s) no longer appear on the maps but carried work: kept and marked as "
"lapsed."
msgstr ""
"%d écart(s) ne figurent plus sur les cartes mais portaient du travail : "
"gardés et marqués caducs."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/ecart.py:0
msgid ""
"%d gap(s) that no longer applied, with nothing written on them, were "
"removed."
msgstr ""
"%d écart(s) devenus sans objet, sur lesquels rien n'était écrit, ont été "
"retirés."

#. module: bf_process
#. odoo-javascript
#: code:addons/bf_process/static/src/visualiseur/visualiseur.js:0
msgid "%s message(s)"
msgstr "%s message(s)"

#. module: bf_process
#. odoo-javascript
#: code:addons/bf_process/static/src/visualiseur/visualiseur.js:0
msgid "%s recorded decision(s)"
msgstr "%s décision(s) consignée(s)"

#. module: bf_process
#. odoo-javascript
#: code:addons/bf_process/static/src/visualiseur/visualiseur.js:0
msgid "%s resource(s)"
msgstr "%s ressource(s)"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/document.py:0
msgid "%s: unfolded map"
msgstr "%s — carte dépliée"

#. module: bf_process
#: model:ir.model.fields,field_description:bf_process.field_bf_process_import_wizard__fichier
#: model:ir.model.fields,field_description:bf_process.field_bf_process_merge_wizard__fichier
msgid ".bpmn file"
msgstr "Fichier .bpmn"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/fusion.py:0
msgid ""
"<b>%(n)s page(s) of the map are not in the file</b>: %(titres)s.<br/>Several"
" editors only re-export the open diagram. Removals are therefore proposed as"
" \"Ignore\": only apply them if the page was really deleted."
msgstr ""
"<b>%(n)s page(s) de la carte ne sont pas dans le fichier</b> : "
"%(titres)s.<br/>Plusieurs éditeurs ne réexportent que le diagramme ouvert. "
"Les retraits sont donc proposés à « Ignorer » : ne les appliquez que si la "
"page a vraiment été supprimée."

#. module: bf_process
#: model_terms:ir.ui.view,arch_db:bf_process.view_bf_process_form
msgid "<span class=\"oe_inline\"> %</span>"
msgstr "<span class=\"oe_inline\"> %</span>"

#. module: bf_process
#: model_terms:ir.ui.view,arch_db:bf_process.view_bf_process_form
msgid "<span class=\"oe_inline\"> · </span>"
msgstr "<span class=\"oe_inline\"> · </span>"

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid ""
"A current-state map is not drawn from anything: it describes what happens."
msgstr ""
"Une carte de l'état actuel ne se dessine d'après rien : elle décrit ce qui "
"se passe."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/edition.py:0
#: code:addons/bf_process/models/flux.py:0
msgid "A flow cannot loop back on itself."
msgstr "Un flux ne peut pas boucler sur lui-même."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/edition.py:0
msgid "A flow needs two nodes of this level."
msgstr "Il faut deux nœuds de ce niveau pour un flux."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/flux.py:0
msgid "A flow only links nodes of the same level."
msgstr "Un flux ne relie que des nœuds du même niveau."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid "A map cannot be drawn from itself."
msgstr "Une carte ne se dessine pas d'après elle-même."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/flux.py:0
msgid "A message flow links a node and a pool of the same level."
msgstr "Un flux de message relie un nœud et un pool du même niveau."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/structure.py:0
msgid "A node cannot open its own page."
msgstr "Un nœud ne peut pas ouvrir sa propre page."

#. module: bf_process
#: model_terms:ir.actions.act_window,help:bf_process.action_bf_process_resource
msgid ""
"A procedure, a safety data sheet or a video attached to a step becomes a QR "
"code on the printed map."
msgstr ""
"Une procédure, une fiche signalétique ou une vidéo posée sur une\n"
"                étape devient un code QR sur la carte imprimée."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid "A process map without a level cannot be validated."
msgstr "Une cartographie sans niveau ne se valide pas."

#. module: bf_process
#: model:ir.model.constraint,message:bf_process.constraint_bf_process_node_resource_libelle_non_vide
msgid "A resource without a label does not get opened, it gets ignored."
msgstr "Une ressource sans libellé ne s'ouvre pas, elle s'ignore."

#. module: bf_process
#: model:ir.model.fields,help:bf_process.field_bf_process_ecart__source
msgid ""
"A seeded gap is refreshed at the next seeding; a gap added by hand is never "
"touched."
msgstr ""
"Un écart semé se rafraîchit au semis suivant ; un écart ajouté à la main "
"n'est jamais touché."

#. module: bf_process
#: model_terms:ir.ui.view,arch_db:bf_process.view_bf_process_form
msgid ""
"A tabloid tiling at 1:1 scale, with a QR code on each step that has a "
"resource. To hang on the wall, not to file away."
msgstr ""
"Pavé en tabloïd à l'échelle 1:1, avec un code"
"                                   QR sur chaque étape qui porte une "
"ressource.                                   À afficher au mur, pas à mettre"
" au dossier."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid ""
"A target process is drawn from a current state. Without one, there is no gap"
" to show, just a second map."
msgstr ""
"Un processus souhaité se dessine d'après un état actuel. Sans lui, il n'y a "
"pas d'écart à montrer, juste une deuxième carte."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid "A target process was drawn from this version: <b>%s</b>."
msgstr ""
"Un processus souhaité a été dessiné d'après cette version : <b>%s</b>."

#. module: bf_process
#: model_terms:ir.ui.view,arch_db:bf_process.view_bf_process_form
msgid "A validated version can no longer be edited. Continue?"
msgstr "Une version validée ne se modifie plus. Continuer ?"

#. module: bf_process
#. odoo-javascript
#: code:addons/bf_process/static/src/visualiseur/visualiseur.xml:0
msgid ""
"A validated version can no longer be edited. Reopen it, or create the next "
"one."
msgstr ""
"Une version validée ne se modifie plus. Rouvrez-la, ou créez la suivante."

#. module: bf_process
#. odoo-python
#: code:addons/bf_process/models/process.py:0
msgid "A validated version cannot be deleted. Mark it obsolete."
msgstr "Une version validée ne se supprime pas. Marquez-la obsolète."

#. module: bf_process
#: model:ir.model.fields.selection,name:bf_process.selection__bf_process_pool__position__top
msgid "Above"
msgstr "Au-dessus"

