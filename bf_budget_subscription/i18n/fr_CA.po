"⚠️ %(sub)s: %(account)s is in %(n)s budget items, to be settled by hand"
msgstr "⚠️ %(sub)s : %(account)s est dans %(n)s postes, à trancher à la main"

#. module: bf_budget_subscription
#. odoo-python
#: code:addons/bf_budget_subscription/wizard/bf_budget_subscription_link_wizard.py:0
msgid "⚠️ %(sub)s: account %(account)s is in no budget item"
msgstr "⚠️ %(sub)s : le compte %(account)s n'est dans aucun poste"

#. module: bf_budget_subscription
#. odoo-python
#: code:addons/bf_budget_subscription/wizard/bf_budget_subscription_link_wizard.py:0
