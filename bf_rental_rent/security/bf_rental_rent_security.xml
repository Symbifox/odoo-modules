<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 🔴 Qui doit quoi à qui est aussi sensible que le bail lui-même.
             Le cloisonnement est posé dès le départ, parce que l'oublier sur
             bf.rental.lease a coûté une sonde pour s'en apercevoir. -->
        <record id="rule_rental_term_company" model="ir.rule">
            <field name="name">Termes de loyer : multi-société</field>
            <field name="model_id" ref="model_bf_rental_term"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_rental_payment_company" model="ir.rule">
            <field name="name">Versements : multi-société</field>
            <field name="model_id" ref="model_bf_rental_payment"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
