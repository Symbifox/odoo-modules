#. module: privacy_breach_notice
#. odoo-python
#: code:addons/privacy_breach_notice/models/privacy_breach_notice.py:0
msgid ""
"<p><b>%(name)s</b>%(title)s a accusé réception de l'avis le %(when)s (heure "
"du serveur, UTC).<br/>Empreinte accusée : <code>%(sha)s</code></p>"
msgstr ""
"<p><b>%(name)s</b>%(title)s acknowledged receipt of the notice on %(when)s "
"(server time, UTC).<br/>Acknowledged fingerprint: <code>%(sha)s</code></p>"

#. module: privacy_breach_notice
#. odoo-python
#: code:addons/privacy_breach_notice/models/privacy_breach_notice.py:0
msgid ""
"<p>Avis envoyé à <b>%(to)s</b>, signé par %(who)s.<br/>Empreinte SHA-256 du "
"PDF : <code>%(sha)s</code></p>"
msgstr ""
"<p>Notice sent to <b>%(to)s</b>, signed by %(who)s.<br/>SHA-256 fingerprint "
"of the PDF: <code>%(sha)s</code></p>"

#. module: privacy_breach_notice
#. odoo-python
#: code:addons/privacy_breach_notice/models/privacy_breach_notice.py:0
msgid "<p>Code d'accusé envoyé à %s.</p>"
msgstr "<p>Acknowledgement code sent to %s.</p>"

#. module: privacy_breach_notice
#. odoo-python
#: code:addons/privacy_breach_notice/models/privacy_breach_notice.py:0
msgid ""
"<p>Votre code pour accuser réception de l'avis %(avis)s : "
"<b>%(code)s</b></p><p>Il est valable trente minutes et ne sert qu'une "
"fois.</p>"
msgstr ""
"<p>Your code to acknowledge receipt of notice %(avis)s: "
"<b>%(code)s</b></p><p>It is valid for thirty minutes and works only "
"once.</p>"

#. module: privacy_breach_notice
#: model:mail.template,body_html:privacy_breach_notice.mail_template_breach_notice
msgid ""
"<t t-set=\"_wlf\" t-value=\"object.company_id._fields\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"('report_brand_dark' in _wlf and object.company_id.report_brand_dark) or '#212529'\"/>\n"
"<div style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:14px; color:#111827; line-height:22px;\">\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Avis de violation de la confidentialité</p>\n"
"<h1 style=\"font-size:22px; font-weight:500; margin:0 0 12px 0;\"><t t-out=\"object.display_name\"/> · <t t-out=\"dict(object._fields['stage'].selection).get(object.stage)\"/></h1>\n"
"<p>Bonjour<t t-if=\"object.officer_partner_id\"> <t t-out=\"object.officer_partner_id.name\"/></t>,</p>\n"
"<p>\n"
"    À titre de mandataire de <b t-out=\"object.responsible_id.name\"/>, <t t-out=\"object.company_id.name\"/>\n"
"    vous transmet l'avis ci-joint, comme le prévoit l'article 18.3 de la Loi sur la protection des\n"
"    renseignements personnels dans le secteur privé. Il vous parvient à l'adresse désignée pour\n"
"    recevoir ces avis.\n"
"</p>\n"
"<p>\n"
"    L'avis porte les faits que nous constatons. L'évaluation du risque de préjudice sérieux, l'avis à la\n"
"    Commission d'accès à l'information et l'inscription à votre registre vous reviennent.\n"
"</p>\n"
"<p style=\"margin:20px 0;\">\n"
"    <a t-att-href=\"object._ack_url()\" t-attf-style=\"display:inline-block; padding:10px 18px; background-color:#{brand_dark}; color:#ffffff; text-decoration:none; border-radius:6px;\">Lire l'avis et accuser réception</a>\n"
"</p>\n"
"<p style=\"font-size:12px; color:#6B7280;\">\n"
"    Empreinte SHA-256 du PDF joint : <code t-out=\"object.content_sha256\"/><br/>\n"
"    Pour toute question : <t t-out=\"object.contact_user_id.name\"/>, <t t-out=\"object.contact_user_id.email\"/>.\n"
"</p>\n"
"</div>\n"
"        "
msgstr ""
"<t t-set=\"_wlf\" t-value=\"object.company_id._fields\"/>\n"
"<t t-set=\"brand_dark\" t-value=\"('report_brand_dark' in _wlf and object.company_id.report_brand_dark) or '#212529'\"/>\n"
"<div style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:14px; color:#111827; line-height:22px;\">\n"
"<p style=\"margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;\">Confidentiality breach notice</p>\n"
"<h1 style=\"font-size:22px; font-weight:500; margin:0 0 12px 0;\"><t t-out=\"object.display_name\"/> · <t t-out=\"dict(object._fields['stage'].selection).get(object.stage)\"/></h1>\n"
"<p>Hello<t t-if=\"object.officer_partner_id\"> <t t-out=\"object.officer_partner_id.name\"/></t>,</p>\n"
"<p>\n"
"    As the service provider of <b t-out=\"object.responsible_id.name\"/>, <t t-out=\"object.company_id.name\"/>\n"
"    sends you the attached notice, as section 18.3 of the Act respecting the protection of\n"
"    personal information in the private sector requires. It reaches you at the address designated\n"
"    to receive such notices.\n"
"</p>\n"
"<p>\n"
"    The notice sets out the facts we observe. Assessing the risk of serious injury, notifying the\n"
"    Commission d'accès à l'information and recording the incident in your register remain yours.\n"
"</p>\n"
"<p style=\"margin:20px 0;\">\n"
"    <a t-att-href=\"object._ack_url()\" t-attf-style=\"display:inline-block; padding:10px 18px; background-color:#{brand_dark}; color:#ffffff; text-decoration:none; border-radius:6px;\">Read the notice and acknowledge receipt</a>\n"
"</p>\n"
"<p style=\"font-size:12px; color:#6B7280;\">\n"
"    SHA-256 fingerprint of the attached PDF: <code t-out=\"object.content_sha256\"/><br/>\n"
"    Questions: <t t-out=\"object.contact_user_id.name\"/>, <t t-out=\"object.contact_user_id.email\"/>.\n"
"</p>\n"
"</div>\n"
"        "

