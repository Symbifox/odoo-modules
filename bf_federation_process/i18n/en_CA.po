#: code:addons/bf_federation_process/models/bf_process.py:0
msgid "<p>Cartographie reçue de %s : <b>%s</b>, version %s, %s niveau(x), %s nœud(s). Elle se lit ici ; la version suivante la remplacera.</p>"
msgstr "<p>Process map received from %s: <b>%s</b>, version %s, %s level(s), %s node(s). It is read-only here; the next version will replace it.</p>"

#. module: bf_federation_process
#. odoo-python
#: code:addons/bf_federation_process/models/bf_process.py:0
