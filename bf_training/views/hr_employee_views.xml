<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_training" model="ir.ui.view">
        <field name="name">hr.employee.form.training</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_training_records" type="object"
                        class="oe_stat_button" icon="fa-graduation-cap"
                        groups="bf_training.group_training_officer">
                    <field name="training_record_count" widget="statinfo" string="Formations"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="Formation" name="bf_training"
                      groups="bf_training.group_training_officer">
                    <group>
                        <field name="training_reference_date"/>
                        <field name="training_overdue_count"/>
                        <field name="training_expiring_count"/>
                    </group>
                    <separator string="Obligations"/>
                    <field name="training_obligation_ids" readonly="1">
                        <list decoration-danger="state == 'overdue'" decoration-warning="state == 'expiring'">
                            <field name="requirement_id"/>
                            <field name="due_date"/>
                            <field name="valid_until"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <separator string="Formations suivies"/>
                    <field name="training_record_ids" readonly="1">
                        <list decoration-danger="expiry_state == 'expired'">
                            <field name="date_done"/>
                            <field name="activity_id"/>
                            <field name="hours"/>
                            <field name="date_expiry"/>
                            <field name="expiry_state"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
