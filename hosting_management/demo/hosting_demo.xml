<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Demo Tags -->
        <record id="tag_critical" model="hosting.service.tag">
            <field name="name">Critical</field>
            <field name="color">1</field>
        </record>
        <record id="tag_backup" model="hosting.service.tag">
            <field name="name">Backup Required</field>
            <field name="color">2</field>
        </record>
        <record id="tag_premium" model="hosting.service.tag">
            <field name="name">Premium</field>
            <field name="color">10</field>
        </record>

        <!-- Software Catalog -->

        <!-- Odoo -->
        <record id="software_odoo" model="hosting.software">
            <field name="name">Odoo</field>
            <field name="code">OD</field>
            <field name="software_type">self_hosted</field>
            <field name="latest_version">18.0</field>
            <field name="latest_version_date">2024-10-01</field>
            <field name="github_url">https://github.com/odoo/odoo</field>
            <field name="docker_image">odoo:18</field>
            <field name="notes">&lt;p&gt;Open source ERP and business management software.&lt;/p&gt;</field>
        </record>

        <!-- Nextcloud -->
        <record id="software_nextcloud" model="hosting.software">
            <field name="name">Nextcloud</field>
            <field name="code">NC</field>
            <field name="software_type">self_hosted</field>
            <field name="latest_version">30.0.2</field>
            <field name="latest_version_date">2024-12-15</field>
            <field name="github_url">https://github.com/nextcloud/server</field>
            <field name="docker_image">nextcloud:30</field>
            <field name="notes">&lt;p&gt;Self-hosted file sync and share platform.&lt;/p&gt;</field>
        </record>

        <!-- CryptPad -->
        <record id="software_cryptpad" model="hosting.software">
            <field name="name">CryptPad</field>
            <field name="code">CP</field>
            <field name="software_type">self_hosted</field>
            <field name="latest_version">2024.12.0</field>
            <field name="latest_version_date">2024-12-01</field>
            <field name="github_url">https://github.com/cryptpad/cryptpad</field>
            <field name="docker_image">cryptpad/cryptpad:latest</field>
            <field name="notes">&lt;p&gt;End-to-end encrypted collaboration suite.&lt;/p&gt;</field>
        </record>

        <!-- Vaultwarden -->
        <record id="software_vaultwarden" model="hosting.software">
