<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="brand_view_tree" model="ir.ui.view">
        <field name="name">secure.transfer.brand.list</field>
        <field name="model">secure.transfer.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="domain"/>
                <field name="slug" optional="show"/>
                <field name="fixed_recipient" string="Drop to" optional="show"/>
                <field name="tier"/>
                <field name="is_default" string="Default"/>
                <field name="powered_by" string="Powered by" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="brand_view_form" model="ir.ui.view">
        <field name="name">secure.transfer.brand.form</field>
        <field name="model">secure.transfer.brand</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_cors" type="object"
                            string="Configure the domain (CORS)"
                            invisible="not domain"
                            help="Adds this domain to the bucket's allowed CORS origins. Run after entering a custom domain."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Brand name"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="domain" placeholder="secret.example.com"/>
                            <field name="is_default"/>
                            <field name="tier"/>
                            <field name="email_from" placeholder="transfers@example.com"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence" groups="base.group_no_one"/>
                        </group>
                        <group string="Visuals">
                            <field name="logo" widget="image" class="oe_avatar"/>
                            <field name="favicon" widget="image" class="oe_avatar"/>
                            <field name="color_primary" widget="color"/>
                            <field name="color_dark" widget="color"/>
                            <field name="powered_by"/>
                        </group>
                    </group>
                    <group>
                        <group string="Limits (0 = configuration default)">
                            <field name="max_transfer_mb" string="Max. size per transfer (MB)"/>
                            <field name="max_files" string="Max. number of files"/>
                            <field name="max_retention_days" string="Max. retention (days)"/>
                        </group>
                        <group string="Options">
                            <field name="allow_password"/>
                            <field name="allow_recipient_otp"/>
                            <field name="notify_on_download"
                                   help="Notify the sender by email on the first download of their files."/>
                            <field name="allow_burn"
                                   help="Offer the sender the &quot;destroy after first download&quot; option."/>
                            <field name="watermark_downloads"/>
                        </group>
                    </group>
                    <group string="Billing (paid tier)" invisible="tier != 'paid'">
                        <field name="partner_id"/>
                        <field name="price_year"/>
                        <field name="billing_active"/>
                        <field name="billing_ref"/>
                    </group>
                    <group string="Personal drop page (/to/&lt;slug&gt;)">
                        <field name="slug"
                               placeholder="auto from the name if left empty"/>
                        <field name="fixed_recipient"
                               placeholder="jane@example.com"
                               help="Filled = drop page: all sends go only to this address. The recipient field is hidden and forced server-side."/>
                        <field name="fixed_recipient_name"
                               placeholder="Jane"
                               invisible="not fixed_recipient"/>
                        <field name="page_url" widget="CopyClipboardChar"
                               invisible="not page_url"
                               help="Native public URL of the drop page (no external shortener)."/>
                        <field name="owner_user_id" readonly="1"
                               invisible="not owner_user_id"
                               help="Auto-provisioned page for this employee (automatic sync and archiving)."/>
                    </group>
                    <group name="group_audience" string="Open audience (data room)">
                        <field name="allow_open_audience"/>
                        <div class="alert alert-warning" role="alert"
                             colspan="2" invisible="not allow_open_audience">
                            An open audience link accepts an address that no one has validated beforehand. The visitor cap below is what keeps it from becoming an email relay to third parties: do not set it to 0.
                        </div>
                        <field name="audience_max_default"
                               invisible="not allow_open_audience"/>
                        <field name="allow_audience_sms"
                               invisible="not allow_open_audience"/>
                        <field name="audience_domains"
                               invisible="not allow_open_audience"
                               placeholder="Empty = recipient list below.&#10;E.g.: @client.com&#10;⚠ A list set here rules out identification by mobile (a number has no domain)."/>
                    </group>
                    <group string="Allowlists (anti-piggyback)">
                        <field name="sender_allowlist"
                               placeholder="Senders: empty = open to everyone.&#10;One entry per line: jean@client.com  or  @client.com  or  client.com"/>
                        <field name="recipient_allowlist"
                               placeholder="Recipients: empty = no restriction.&#10;E.g.: @client.com to send only to the client's domain"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">secure.transfer.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a brand</p>
            <p>Each brand is resolved by the Host name of the public page:
                logo, colors, limits and the "Powered by" mention.
                The default brand serves any host with no explicit brand.</p>
        </field>
    </record>

</odoo>
