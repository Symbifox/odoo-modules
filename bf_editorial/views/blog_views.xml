<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_blog_post_form_editorial" model="ir.ui.view">
        <field name="name">blog.post.form.editorial</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_editorial_entry" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        groups="bf_editorial.group_editorial_user">
                    <field name="editorial_entry_count" widget="statinfo"
                           string="Atelier éditorial"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
