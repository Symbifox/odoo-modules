#. module: bf_route_expense
#: model:ir.model.fields,field_description:bf_route_expense.field_res_company__bf_route_mileage_threshold
#: model:ir.model.fields,field_description:bf_route_expense.field_res_config_settings__bf_route_mileage_threshold
