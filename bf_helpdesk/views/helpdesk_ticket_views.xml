<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_helpdesk_ticket_form_bf" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form.bf</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
    <field name="arch" type="xml">

      <!-- Convert-to-meeting button + smart-button counter -->
      <xpath expr="//div[@name='button_box']" position="inside">
        <!-- Réservé à qui lit les rencontres : sans le groupe, la fiche
             entière tombait en AccessError. -->
        <button name="action_view_meeting_records" type="object"
                class="oe_stat_button" icon="fa-comments-o"
                invisible="meeting_record_count == 0"
                groups="bf_meeting.group_meeting_user">
          <field name="meeting_record_count" widget="statinfo"
                 string="Rencontres"/>
        </button>
      </xpath>
      <xpath expr="//header/button[@name='assign_to_me']" position="attributes">
        <attribute name="data-hotkey">o</attribute>
      </xpath>
      <xpath expr="//header" position="inside">
        <field name="closed" invisible="1"/>
        <button name="action_bf_toggle_waiting_client" type="object"
                string="Attente client"
                class="btn-secondary"
                data-hotkey="w"
                groups="helpdesk_mgmt.group_helpdesk_user_team"
                invisible="waiting_state == 'client' or closed"/>
        <button name="action_bf_toggle_waiting_client" type="object"
                string="Fin de l'attente"
                class="btn-secondary"
                data-hotkey="w"
                groups="helpdesk_mgmt.group_helpdesk_user_team"
                invisible="waiting_state != 'client' or closed"/>
        <button name="action_create_article" type="object"
                string="Créer un article d'aide"
                class="btn-secondary"
                groups="helpdesk_mgmt.group_helpdesk_user_team"
                invisible="not closed"/>
        <button name="action_apply_macro" type="object"
                data-hotkey="e"
                string="Appliquer macro"
                class="btn-secondary"
                groups="helpdesk_mgmt.group_helpdesk_user_team"/>
        <button name="action_create_meeting_record" type="object"
                string="Convertir en rencontre"
                class="btn-secondary"
                groups="bf_meeting.group_meeting_user"/>
        <button name="action_triage_with_claude" type="object"
                data-hotkey="y"
                string="Triage IA"
                class="btn-secondary"
                groups="helpdesk_mgmt.group_helpdesk_user_team"
                invisible="triage_state == 'pending'"
                confirm="Demander au modèle d'IA de suggérer l'étape, l'assignation et un brouillon de réponse ?"/>
        <button name="action_send_client_update" type="object"
                data-hotkey="d"
                string="Envoyer une mise à jour"
                class="btn-secondary"
                groups="helpdesk_mgmt.group_helpdesk_user_team"
                invisible="not partner_id"/>
        <button name="action_subscribe_partner_follower" type="object"
                string="Abonner le client"
                class="btn-secondary"
                groups="helpdesk_mgmt.group_helpdesk_user_team"
                invisible="not partner_id"/>
      </xpath>

      <!-- Triage suggestion panel -->
      <xpath expr="//notebook" position="inside">
        <page string="Triage IA" name="bf_triage_panel"
              invisible="triage_state == 'none'">
          <div class="mb-2" invisible="triage_state != 'done'">
            <button name="action_triage_apply" type="object" string="Appliquer la suggestion"
                    class="btn-primary me-2" groups="helpdesk_mgmt.group_helpdesk_user_team"/>
            <button name="action_triage_use_reply" type="object" string="Utiliser le brouillon de réponse"
                    class="btn-secondary me-2" invisible="not triage_reply"
                    groups="helpdesk_mgmt.group_helpdesk_user_team"/>
            <button name="action_triage_reject" type="object" string="Rejeter"
                    class="btn-link" groups="helpdesk_mgmt.group_helpdesk_user_team"/>
          </div>
          <group>
            <group>
              <field name="triage_state" widget="badge"
                     decoration-info="triage_state in ('pending', 'queued')"
                     decoration-success="triage_state in ('done', 'applied')"
                     decoration-danger="triage_state == 'error'"/>
              <field name="triage_confidence" invisible="not triage_confidence"/>
              <field name="triage_sentiment" invisible="not triage_sentiment"/>
              <field name="triage_language" invisible="not triage_language"/>
            </group>
            <group>
              <field name="triage_category_id" readonly="1" invisible="not triage_category_id"/>
              <field name="triage_priority" readonly="1" invisible="not triage_priority"/>
              <field name="triage_user_id" readonly="1" invisible="not triage_user_id"/>
              <field name="triage_stage_id" readonly="1" invisible="not triage_stage_id"/>
              <field name="triage_last_run" readonly="1"/>
            </group>
          </group>
          <field name="triage_suggestion_html" readonly="1" nolabel="1"/>
          <!-- Journal du triage : lisible à partir de « Billets de l'équipe » ; un agent
               en « Billets personnels » ne pouvait plus ouvrir la fiche. -->
          <field name="triage_log_ids" readonly="1" invisible="not triage_log_ids" groups="helpdesk_mgmt.group_helpdesk_user_team">
            <list>
              <field name="create_date" string="Le"/>
              <field name="user_id"/>
              <field name="outcome"/>
              <field name="fields_applied"/>
              <field name="fields_suggested"/>
            </list>
          </field>
        </page>
      </xpath>

      <!-- Add waiting_state next to priority in the header -->
      <xpath expr="//field[@name='priority']" position="after">
        <field name="guard_words_hit" invisible="not guard_words_hit"
               decoration-danger="1" widget="badge"/>
        <field name="theme_id" invisible="not theme_id" options="{'no_create': True}"/>
        <field name="waiting_state" widget="badge"
               decoration-warning="waiting_state == 'client'"
               decoration-info="waiting_state == 'external'"/>
      </xpath>

      <!-- Hour bank balance row + low-balance ribbon -->
      <xpath expr="//field[@name='partner_email']" position="after">
        <field name="hour_bank_id" readonly="1"
               invisible="not hour_bank_id"/>
        <field name="hour_bank_balance" readonly="1"
               string="Solde banque (h)"
               invisible="not hour_bank_id"
               decoration-danger="hour_bank_low"/>
        <field name="hour_bank_low" invisible="1"/>
        <field name="total_hours" readonly="1" string="Temps saisi (h)"
               invisible="total_hours == 0.0"/>
        <field name="partner_has_portal_access" widget="boolean_toggle"
               readonly="1" string="Accès portail"
               invisible="not partner_id"/>
        <field name="portal_ticket_url" widget="url" readonly="1"
               invisible="not partner_id"/>
      </xpath>

      <xpath expr="//sheet" position="before">
        <div class="alert alert-warning text-center mb-0"
             role="alert"
             invisible="not hour_bank_low">
          <strong>⚠ Solde banque d'heures bas pour ce client.</strong>
          Vérifier avant de poursuivre des heures non couvertes.
        </div>
      </xpath>

      <!-- Knowledge matrix scope validation -->
      <xpath expr="//field[@name='category_id']" position="after">
        <field name="knowledge_item_id"
               options="{'no_create': True, 'no_create_edit': True}"/>
        <field name="knowledge_matrix_id" readonly="1"
               invisible="not knowledge_matrix_id"/>
        <field name="scope_aligned" widget="badge"
               decoration-success="scope_aligned == 'aligned'"
               decoration-info="scope_aligned == 'pending'"
               decoration-danger="scope_aligned == 'out_of_scope'"
               decoration-muted="scope_aligned == 'unset'"
               readonly="1"/>
      </xpath>

      <!-- SLA breach ribbons -->
      <xpath expr="//sheet" position="before">
        <widget name="bf_ticket_presence"/>
        <div class="alert alert-danger text-center mb-0"
             role="alert"
             invisible="not sla_response_breach">
          <strong>⚠ SLA première réponse dépassé.</strong>
          Aucune réponse de l'équipe avant l'échéance.
        </div>
        <div class="alert alert-danger text-center mb-0"
             role="alert"
             invisible="not sla_resolve_breach">
          <strong>⚠ SLA résolution dépassé.</strong>
          Le ticket aurait dû être fermé.
        </div>
        <div class="alert alert-warning text-center mb-0"
             role="alert"
             invisible="sla_state != 'at_risk'">
          <strong>SLA à risque.</strong>
          Il reste moins du quart du temps alloué.
        </div>
      </xpath>
      <xpath expr="//field[@name='closed_date']" position="after">
        <field name="sla_response_deadline" readonly="1"
               invisible="not sla_response_deadline"/>
        <field name="sla_resolve_deadline" readonly="1"
               invisible="not sla_resolve_deadline"/>
        <field name="first_response_date"
               invisible="not first_response_date"/>
        <field name="sla_state" widget="badge"
               invisible="sla_state == 'none'"
               decoration-success="sla_state in ('ok', 'met')"
               decoration-warning="sla_state == 'at_risk'"
               decoration-danger="sla_state == 'breached'"
               decoration-info="sla_state == 'paused'"/>
        <field name="sla_paused_hours" widget="float_time"
               invisible="not sla_paused_hours"/>
        <field name="sla_response_breach" invisible="1"/>
        <field name="sla_resolve_breach" invisible="1"/>
        <field name="ack_sent_date" invisible="not ack_sent_date"/>
        <field name="reminder_excluded" invisible="waiting_state != 'client'"/>
        <field name="client_muted_partner_ids" widget="many2many_tags"
               invisible="not client_muted_partner_ids"/>
        <field name="reminder_next_date" invisible="not reminder_next_date"/>
        <field name="reminder_count" invisible="not reminder_count"/>
        <field name="reminder_auto_closed" invisible="not reminder_auto_closed"/>
        <field name="csat_rating" widget="badge" invisible="not csat_rating"
               decoration-danger="csat_rating in ('1', '2')"
               decoration-success="csat_rating in ('4', '5')"/>
        <field name="portal_status"/>
      </xpath>

      <!-- CSAT response link -->
      <xpath expr="//field[@name='closed_date']" position="after">
        <field name="csat_user_input_id" readonly="1"
               invisible="not csat_user_input_id"/>
        <field name="csat_state" readonly="1"
               widget="badge"
               decoration-success="csat_state == 'done'"
               decoration-info="csat_state == 'in_progress'"
               decoration-muted="csat_state == 'new'"
               invisible="not csat_user_input_id"/>
      </xpath>

      <!-- Persona panel — quick composer hints when answering the ticket -->
      <xpath expr="//notebook" position="inside">
        <page string="Articles d'aide" name="bf_articles">
          <field name="article_ids" options="{'no_create': True}">
            <list>
              <field name="name"/>
              <field name="summary"/>
              <field name="is_published" string="Publié"/>
              <field name="website_url" widget="url"/>
            </list>
          </field>
        </page>
        <page string="Persona" name="bf_persona_panel"
              groups="bf_persona.group_persona_user"
              invisible="not partner_id">
          <group>
            <group string="Communication">
              <field name="persona_id" readonly="1"
                     invisible="not persona_id"/>
              <field name="persona_addressing_style" readonly="1"
                     invisible="not persona_id"/>
              <field name="persona_preferred_salutation" readonly="1"
                     invisible="not persona_id"/>
              <field name="persona_closing_formula" readonly="1"
                     invisible="not persona_id"/>
            </group>
            <group string="Posture &amp; paiement">
              <field name="persona_tone_summary" readonly="1"
                     widget="badge"
                     decoration-success="persona_tone_summary == 'warm'"
                     decoration-info="persona_tone_summary == 'neutral'"
                     decoration-warning="persona_tone_summary == 'tense'"
                     invisible="not persona_id"/>
              <field name="persona_our_tone_summary" readonly="1"
                     widget="badge"
                     decoration-success="persona_our_tone_summary == 'warm'"
                     decoration-info="persona_our_tone_summary == 'neutral'"
                     decoration-warning="persona_our_tone_summary == 'tense'"
                     invisible="not persona_id"/>
              <field name="persona_payer_quality" readonly="1"
                     widget="badge"
                     decoration-success="persona_payer_quality == 'excellent'"
                     decoration-info="persona_payer_quality == 'good'"
                     decoration-warning="persona_payer_quality in ('average', 'slow')"
                     decoration-danger="persona_payer_quality == 'poor'"
                     invisible="not persona_id"/>
            </group>
          </group>
          <div class="text-center mt-3">
            <button name="action_open_persona" type="object"
                    string="Ouvrir la fiche persona"
                    class="btn btn-primary"
                    invisible="not persona_id"/>
            <div class="alert alert-info" role="alert"
                 invisible="persona_id">
              Aucun persona pour ce contact.
              <button name="action_open_persona" type="object"
                      string="Créer maintenant" class="btn btn-link p-0"/>
            </div>
          </div>
        </page>
      </xpath>

      <!-- Timesheets — direct time entry on the ticket -->
      <xpath expr="//notebook" position="inside">
        <!-- Réservé à qui lit les feuilles de temps (account.analytic.line) :
             un agent sans ce groupe ne pouvait plus ouvrir la fiche. -->
        <page string="Feuilles de temps" name="bf_timesheets"
              groups="hr_timesheet.group_hr_timesheet_user">
          <group>
            <field name="project_id"
                   options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="task_id"
                   invisible="not project_id"
                   domain="[('project_id', '=', project_id)]"
                   options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="total_hours" readonly="1"/>
          </group>
          <field name="timesheet_ids" context="{'default_ticket_id': id, 'default_project_id': project_id}">
            <list editable="bottom">
              <field name="date"/>
              <field name="employee_id"/>
              <field name="name"/>
              <field name="project_id" optional="hide"/>
              <field name="unit_amount" widget="timesheet_uom" sum="Total"/>
            </list>
          </field>
          <div class="text-muted mt-2" invisible="project_id">
            <i class="fa fa-info-circle"/>
            Associez un projet à ce ticket (ou à son équipe / sa banque d'heures)
            pour saisir du temps qui déduit de la banque d'heures.
          </div>
        </page>
      </xpath>

    </field>
  </record>

  <record id="view_helpdesk_ticket_tree_bf" model="ir.ui.view">
    <field name="name">helpdesk.ticket.tree.bf</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='priority']" position="after">
        <field name="waiting_state" optional="show"
               decoration-warning="waiting_state == 'client'"
               decoration-info="waiting_state == 'external'"/>
        <field name="sla_state" optional="show" widget="badge"
               decoration-success="sla_state in ('ok', 'met')"
               decoration-warning="sla_state == 'at_risk'"
               decoration-danger="sla_state == 'breached'"
               decoration-info="sla_state == 'paused'"/>
        <field name="sla_resolve_deadline" optional="hide"/>
      </xpath>
    </field>
  </record>

  <record id="view_helpdesk_ticket_search_bf" model="ir.ui.view">
    <field name="name">helpdesk.ticket.search.bf</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <separator/>
        <filter string="Attente — Client.e" name="filter_waiting_client"
                domain="[('waiting_state', '=', 'client')]"/>
        <filter string="Attente — Externe" name="filter_waiting_external"
                domain="[('waiting_state', '=', 'external')]"/>
        <separator/>
        <filter string="SLA à risque" name="filter_sla_at_risk"
                domain="[('sla_state', '=', 'at_risk')]"/>
        <filter string="SLA dépassé" name="filter_sla_breached"
                domain="[('sla_state', '=', 'breached'), ('stage_id.closed', '=', False)]"/>
        <filter string="SLA en pause" name="filter_sla_paused"
                domain="[('sla_state', '=', 'paused')]"/>
        <group expand="0" string="Group By">
          <filter string="État d'attente" name="group_waiting_state"
                  context="{'group_by': 'waiting_state'}"/>
          <filter string="État SLA" name="group_sla_state"
                  context="{'group_by': 'sla_state'}"/>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
