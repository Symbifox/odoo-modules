<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hosting_management.SecretKeyField">
        <div class="o_field_bf_secret d-inline-flex align-items-center gap-2">
            <t t-if="props.readonly">
                <span class="font-monospace text-break"
                      t-esc="secret.revealed ? secretRaw : secretMasked"/>
            </t>
            <t t-else="">
                <input type="text" class="o_input" autocomplete="off"
                       t-att-value="secretRaw"
                       t-on-change="onSecretInput"/>
            </t>
            <button t-if="secretRaw and props.readonly" type="button"
                    class="btn btn-sm btn-link p-0 text-muted"
                    t-on-click="toggleSecret"
                    t-att-title="secret.revealed ? 'Masquer' : 'Afficher'">
                <i t-att-class="secret.revealed ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
            </button>
            <button t-if="secretRaw" type="button"
                    class="btn btn-sm btn-link p-0 text-muted"
                    t-on-click="copySecret" title="Copier">
                <i class="fa fa-clipboard"/>
            </button>
        </div>
    </t>

</templates>
