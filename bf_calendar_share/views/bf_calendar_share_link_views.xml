<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_calendar_share_link_view_list" model="ir.ui.view">
        <field name="name">bf.calendar.share.link.list</field>
        <field name="model">bf.calendar.share.link</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="owner_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="level"/>
                <field name="date_expiry"/>
                <field name="last_access"/>
                <field name="access_count" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="bf_calendar_share_link_view_form" model="ir.ui.view">
        <field name="name">bf.calendar.share.link.form</field>
        <field name="model">bf.calendar.share.link</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_extend" type="object" string="Extend 90 days"
                            invisible="not id or not active"/>
                    <button name="action_new_address" type="object" string="New address"
                            invisible="not id or not active"
                            confirm="The current address will stop working. Send the new one to the person."/>
                    <button name="action_revoke" type="object" string="Revoke" class="btn-danger"
                            invisible="not id or not active"
                            confirm="The link will stop working for good."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Revoked" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Accounting firm"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="level" widget="radio"/>
                            <field name="date_expiry"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="portee" string="What it covers">
                            <field name="full_history"/>
                            <field name="past_days" invisible="full_history"/>
                            <field name="future_days" invisible="full_history"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="note">
                        Private meetings always show as Busy. Attendees, video call links and
                        tags are never shared through a link, at any level. Each opening of the
                        link is logged below, with its address, for traceability (kept one year by default).
                    </div>
                    <group string="Addresses to send" invisible="not id or not active">
                        <field name="url_ics" widget="CopyClipboardChar"
                               help="Outlook, Google Calendar, Apple Calendar and Thunderbird can subscribe to this address. Read only; they refresh it on their own schedule (several hours for Outlook)."/>
                        <field name="url_webcal" widget="CopyClipboardChar"
                               help="The same subscription, opened directly by Apple Calendar and some phones."/>
                        <field name="url_freebusy" widget="CopyClipboardChar"
                               help="Busy times only (VFREEBUSY), for calendar clients that look up availability, such as Outlook's Internet Free/Busy."/>
                        <field name="url_page" widget="CopyClipboardChar"
                               help="A web page with the next four weeks, for people without a calendar application."/>
                    </group>
                    <notebook invisible="not id">
                        <page string="Accesses" name="acces">
                            <field name="access_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="kind"/>
                                    <field name="ip"/>
                                    <field name="user_agent"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_calendar_share_link_action" model="ir.actions.act_window">
        <field name="name">Links to my calendar</field>
        <field name="res_model">bf.calendar.share.link</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('owner_id', '=', uid)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Share your calendar with someone outside the company</p>
            <p>A link gives a read-only view of your calendar at the level you choose:
               availability only, titles and locations, or all details. It works with
               Outlook, Google, Apple and Thunderbird (open standards only), and as a web
               page. Private meetings always show as Busy. Links expire after 90 days by
               default and can be revoked at any time.</p>
        </field>
    </record>

    <menuitem id="bf_calendar_share_menu_links" action="bf_calendar_share_link_action"
              parent="bf_calendar_share_menu_root" sequence="30"/>

    <!-- Inventaire de ce qui sort vers l'extérieur (Loi 25), pour les administrateurs :
         tous les liens, en lecture, sans leurs adresses. -->
    <record id="bf_calendar_share_link_action_all" model="ir.actions.act_window">
        <field name="name">All calendar links</field>
        <field name="res_model">bf.calendar.share.link</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False, 'create': False}</field>
    </record>
    <menuitem id="bf_calendar_share_menu_links_all" action="bf_calendar_share_link_action_all"
              parent="bf_calendar_share_menu_root" sequence="40" groups="base.group_system"/>
</odoo>
