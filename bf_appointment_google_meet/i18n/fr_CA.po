#. module: bf_appointment_google_meet
#. odoo-python
#: code:addons/bf_appointment_google_meet/models/resource_booking.py:0
msgid ""
"Google Meet could not be checked for this appointment (%(reason)s). Its Meet "
"link is kept."
msgstr ""
"Le Google Meet de ce rendez-vous n'a pas pu être vérifié (%(reason)s). Son "
"lien Meet est gardé."

#. module: bf_appointment_google_meet
#. odoo-python
#: code:addons/bf_appointment_google_meet/models/resource_booking.py:0
msgid ""
"Google Meet could not be created for this appointment (%(reason)s). A "
"Nextcloud Talk room is used instead."
msgstr ""
"Le Google Meet de ce rendez-vous n'a pas pu être créé (%(reason)s). Une "
"salle Nextcloud Talk le remplace."

#. module: bf_appointment_google_meet
#. odoo-python
#: code:addons/bf_appointment_google_meet/models/resource_booking.py:0
msgid "Google could not be reached (%(err)s)"
msgstr "Google est injoignable (%(err)s)"

#. module: bf_appointment_google_meet
#. odoo-python
#: code:addons/bf_appointment_google_meet/models/resource_booking.py:0
msgid "Google did not return a Meet link in time"
msgstr "Google n'a pas rendu de lien Meet à temps"

#. module: bf_appointment_google_meet
#. odoo-python
#: code:addons/bf_appointment_google_meet/models/resource_booking.py:0
msgid ""
"Google refused the host's connection: the host must reconnect their Google "
"account in Preferences"
msgstr ""
"Google a refusé la connexion de l'hôte : l'hôte doit rebrancher son compte "
"Google dans ses Préférences"

#. module: bf_appointment_google_meet
#. odoo-python
#: code:addons/bf_appointment_google_meet/models/resource_booking.py:0
msgid "Google refused the request (HTTP %(code)s)"
msgstr "Google a refusé la demande (HTTP %(code)s)"

