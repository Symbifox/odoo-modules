<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_bf_budget" model="ir.actions.report">
        <field name="name">Budget contre réel</field>
        <field name="model">bf.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_budget.report_bf_budget</field>
        <field name="report_file">bf_budget.report_bf_budget</field>
        <field name="binding_model_id" ref="model_bf_budget"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bf_budget">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="rows" t-value="doc._report_rows()"/>
                <t t-set="totals" t-value="doc._report_totals(rows)"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-field="doc.name"/></h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Exercice :</strong>
                                <span t-field="doc.date_start"/> au <span t-field="doc.date_end"/>
                            </div>
                            <div class="col-6">
                                <strong>Sens :</strong>
                                <span t-field="doc.budget_type"/>
                                <span> — </span>
                                <strong>État :</strong>
                                <span t-field="doc.state"/>
                            </div>
                        </div>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Poste</th>
                                    <th class="text-end">Prévu du mois</th>
                                    <th class="text-end">Prévu</th>
                                    <th class="text-end">Théorique</th>
                                    <th class="text-end">Réalisé</th>
                                    <th class="text-end">Engagé</th>
                                    <th class="text-end">Écart au théorique</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <td>
                                        <span t-out="row['label']"/>
                                        <span t-if="row['accepted']" class="text-muted"> (dépassement assumé)</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['month_planned']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['planned']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['theoretical']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['actual']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['committed']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['drift']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total</th>
                                    <th class="text-end">
                                        <span t-out="totals['month_planned']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['planned']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['theoretical']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['actual']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['committed']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['drift']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <p class="text-muted mt-3" style="font-size: 9pt;">
                            Le réalisé n'est pas recopié : il est relu dans la comptabilité au
                            moment de l'impression. Le théorique s'appuie sur la répartition
                            mensuelle saisie, jamais sur un simple prorata du temps écoulé.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
