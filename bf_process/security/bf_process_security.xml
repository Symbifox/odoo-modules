<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bf_process" model="ir.module.category">
        <field name="name">Cartographie de processus</field>
        <field name="description">Cartographies BPMN vivantes.</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_bf_process_user" model="res.groups">
        <field name="name">Lecture</field>
        <field name="category_id" ref="module_category_bf_process"/>
        <field name="comment">Consulter les cartographies et discuter des étapes.</field>
    </record>

    <record id="group_bf_process_manager" model="res.groups">
        <field name="name">Gestion</field>
        <field name="category_id" ref="module_category_bf_process"/>
        <field name="implied_ids" eval="[(4, ref('group_bf_process_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Créer, charger et exporter les cartographies.</field>
    </record>
</odoo>
