<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_line_form_subscription" model="ir.ui.view">
        <field name="name">bf.budget.line.form.subscription</field>
        <field name="model">bf.budget.line</field>
        <field name="inherit_id" ref="bf_budget.bf_budget_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Recurring commitments" invisible="not subscription_count">
                    <group>
                        <field name="subscription_count"/>
                        <field name="subscription_due_to_date"/>
                        <field name="subscription_upcoming"/>
                        <field name="subscription_period_total"/>
                    </group>
                    <group>
                        <!-- Les tags portent des enregistrements du registre :
                             réservés à qui peut le lire, au champ comme ici
                             (le `groups` de la vue ne cache que l'écran). -->
                        <field name="subscription_ids" widget="many2many_tags" readonly="1"
                               groups="bf_subscription.group_subscription_user"/>
                        <field name="has_subscription_without_calendar" invisible="1"/>
                        <field name="subscription_no_calendar_ids" widget="many2many_tags"
                               readonly="1" invisible="not has_subscription_without_calendar"
                               groups="bf_subscription.group_subscription_user"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="not has_subscription_without_calendar">
                    A subscription linked to this budget item spends without a schedule. The calendar-based theoretical amount does not cover it, so it underestimates this budget item and can make a real overrun look like a budget on track.
                </div>
                <!-- Une ligne restreinte à des comptes analytiques ne porte rien
                     du registre : le bloc ci-dessus est invisible, et sans cette
                     bannière le lecteur ne saurait pas que le poste en porte un. -->
                <field name="has_unattributed_subscriptions" invisible="1"/>
                <div class="alert alert-info" role="alert"
                     invisible="not has_unattributed_subscriptions">
                    This line is narrowed to analytic accounts, so it carries nothing from the subscription register: its budget item has <field name="position_subscription_count" readonly="1" nolabel="1" class="oe_inline"/> subscription(s), and nothing says which share of a renewal belongs to the analytic account this line watches. Their commitments and their renewal calendar are carried by the plain line of the same budget item, which is where this budget reads them.
                </div>
            </xpath>
        </field>
    </record>

    <record id="bf_budget_line_list_subscription" model="ir.ui.view">
        <field name="name">bf.budget.line.list.subscription</field>
        <field name="model">bf.budget.line</field>
        <field name="inherit_id" ref="bf_budget.bf_budget_line_view_list"/>
        <field name="arch" type="xml">
            <field name="amount_committed" position="after">
                <field name="subscription_upcoming" optional="show" sum="Upcoming renewals"/>
            </field>
        </field>
    </record>
</odoo>
