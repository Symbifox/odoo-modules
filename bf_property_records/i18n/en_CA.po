#. module: bf_property_records
#. odoo-python
#: code:addons/bf_property_records/models/bf_property_disclosure.py:0
msgid ""
"<p>Bonjour,</p><p>Comme l'exige l'art. 1068.2 al. 2 C.c.Q., %(syndicat)s "
"vous transmet la liste de ce qu'il a fourni le %(date)s au promettant "
"acheteur de la fraction %(unit)s :</p><ul>%(list)s</ul><p>Une copie de "
"chaque document vous est remise sur demande au syndicat.</p>"
msgstr ""
"<p>Hello,</p><p>As required by art. 1068.2 para. 2 CCQ, %(syndicat)s sends "
"you the list of what it provided on %(date)s to the promisor of fraction "
"%(unit)s:</p><ul>%(list)s</ul><p>A copy of each document is available from "
"the syndicate on request.</p>"

#. module: bf_property_records
#. odoo-python
#: code:addons/bf_property_records/models/bf_property_disclosure.py:0
msgid ""
"<p>Transmis au propriétaire le %(date)s : %(owners)s. Art. 1068.2 al. 2 "
"C.c.Q.%(unreached)s</p><ul>%(list)s</ul>"
msgstr ""
"<p>Sent to the owner on %(date)s: %(owners)s. Art. 1068.2 para. 2 "
"CCQ.%(unreached)s</p><ul>%(list)s</ul>"

