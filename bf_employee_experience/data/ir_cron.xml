<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_sync_entitlements" model="ir.cron">
            <field name="name">Expérience employé : rejouer les règles d'admissibilité</field>
            <field name="model_id" ref="model_bf_ex_entitlement"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_entitlements()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_build_indicators" model="ir.cron">
            <field name="name">Expérience employé : relever les indicateurs du mois</field>
            <field name="model_id" ref="model_bf_ex_indicator"/>
            <field name="state">code</field>
            <field name="code">model._cron_build_indicators()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
