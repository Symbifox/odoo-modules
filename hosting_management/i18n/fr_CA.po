"                          <tbody>\n"
"                            <tr>\n"
"                              <td style=\"padding:20px;\">\n"
"                                <p t-attf-style=\"margin:0 0 12px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;font-weight:600;color:{{ brand_dark }};\">\n"
