#. module: bf_multi_company_email
#: model:mail.template,body_html:bf_multi_company_email.bf_signature_plain
msgid ""
"<div>\n"
"                <t t-set=\"sig\" t-value=\"object.bf_signature_data()\"/>\n"
"                <div t-attf-style=\"font-family: {{ sig['font'] }}; color: {{ sig['text_color'] }}; font-size: 13px; line-height: 1.5;\">\n"
"                    <p t-attf-style=\"margin: 0; font-size: 16px; font-weight: 600; color: {{ sig['text_color'] }};\">\n"
"                        <t t-out=\"sig['name']\"/> <span t-if=\"sig['pronouns']\" t-attf-style=\"font-weight: 400; font-size: 9pt; color: {{ sig['muted'] }};\">(<t t-out=\"sig['pronouns']\"/>)</span>\n"
"                    </p>\n"
"                    <p t-if=\"sig['title']\" t-attf-style=\"margin: 0; color: {{ sig['muted'] }};\">\n"
"                        <t t-out=\"sig['title']\"/>\n"
"                    </p>\n"
"                    <p t-attf-style=\"margin: 10px 0 0 0; font-weight: 600; color: {{ sig['text_color'] }};\"><t t-out=\"sig['company_name']\"/></p>\n"
"                    <p t-if=\"sig['phone']\" style=\"margin: 0;\">\n"
"                        <a t-att-href=\"sig['phone_href']\" t-attf-style=\"color: {{ sig['text_color'] }}; text-decoration: none;\"><t t-out=\"sig['phone']\"/></a>\n"
"                    </p>\n"
"                    <p t-if=\"sig['mobile']\" style=\"margin: 0;\">Mobile&nbsp;: <a t-att-href=\"sig['mobile_href']\" t-attf-style=\"color: {{ sig['text_color'] }}; text-decoration: none;\"><t t-out=\"sig['mobile']\"/></a></p>\n"
"                    <p t-if=\"sig['email']\" style=\"margin: 0;\">\n"
"                        <a t-attf-href=\"mailto:{{ sig['email'] }}\" t-attf-style=\"color: {{ sig['accent'] }}; text-decoration: none;\"><t t-out=\"sig['email']\"/></a>\n"
"                    </p>\n"
"                    <p t-if=\"sig['website']\" style=\"margin: 0;\">\n"
"                        <a t-att-href=\"sig['website_href']\" t-attf-style=\"color: {{ sig['accent'] }}; text-decoration: none;\"><t t-out=\"sig['website']\"/></a>\n"
"                    </p>\n"
"                    <p t-if=\"sig['tagline']\" t-attf-style=\"margin: 6px 0 0 0; font-size: 11px; color: {{ sig['muted'] }};\"><t t-out=\"sig['tagline']\"/></p>\n"
"                    <div t-if=\"sig['disclaimer']\" t-attf-style=\"margin-top:10px;font-size:{{ sig['disclaimer_size'] }};line-height:1.35;color:#8A929A;\">\n"
"                        <t t-out=\"sig['disclaimer']\"/>\n"
"                    </div>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""

#. module: bf_multi_company_email
#: model:mail.template,body_html:bf_multi_company_email.bf_signature_compact
msgid ""
"<div>\n"
"                <t t-set=\"sig\" t-value=\"object.bf_signature_data()\"/>\n"
"                <table cellpadding=\"0\" cellspacing=\"0\" t-attf-style=\"border-collapse:collapse;font-family:{{ sig['font'] }};font-size:12px;line-height:1.5;color:{{ sig['text_color'] }};\">\n"
"                    <tbody><tr>\n"
"                        <td t-attf-style=\"padding:0;color:{{ sig['text_color'] }};\">\n"
"                            <span t-attf-style=\"font-weight:700;color:{{ sig['text_color'] }};\"><t t-out=\"sig['name']\"/></span>\n"
"                            <span t-if=\"sig['pronouns']\" t-attf-style=\"font-weight:400;font-size:9pt;color:{{ sig['muted'] }};\">&nbsp;(<t t-out=\"sig['pronouns']\"/>)</span>\n"
"                            <t t-if=\"sig['title']\">\n"
"                                <span t-attf-style=\"color:{{ sig['accent'] }};\">&nbsp;·&nbsp;</span>\n"
"                                <span t-attf-style=\"color:{{ sig['muted'] }};\"><t t-out=\"sig['title']\"/></span>\n"
"                            </t>\n"
"                            <t t-if=\"sig['company_name']\">\n"
"                                <span t-attf-style=\"color:{{ sig['accent'] }};\">&nbsp;·&nbsp;</span>\n"
"                                <span t-attf-style=\"font-weight:600;color:{{ sig['text_color'] }};\"><t t-out=\"sig['company_name']\"/></span>\n"
"                            </t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr t-if=\"sig['email'] or sig['phone'] or sig['tollfree']\">\n"
"                        <td t-attf-style=\"padding:2px 0 0 0;color:{{ sig['muted'] }};\">\n"
"                            <a t-if=\"sig['email']\" t-attf-href=\"mailto:{{ sig['email'] }}\" t-attf-style=\"color:{{ sig['accent'] }};text-decoration:none;\"><t t-out=\"sig['email']\"/></a>\n"
"                            <t t-if=\"sig['email'] and sig['phone']\"><span style=\"color:#ccc;\">&nbsp;|&nbsp;</span></t>\n"
"                            <a t-if=\"sig['phone']\" t-att-href=\"sig['phone_href']\" t-attf-style=\"color:{{ sig['muted'] }};text-decoration:none;\"><t t-out=\"sig['phone']\"/></a>\n"
"                            <t t-if=\"sig['tollfree'] and (sig['email'] or sig['phone'])\"><span style=\"color:#ccc;\">&nbsp;|&nbsp;</span></t>\n"
"                            <a t-if=\"sig['tollfree']\" t-att-href=\"sig['tollfree_href']\" t-attf-style=\"color:{{ sig['muted'] }};text-decoration:none;\"><t t-out=\"sig['tollfree']\"/></a>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr t-if=\"sig['disclaimer']\">\n"
"                        <td colspan=\"3\" t-attf-style=\"padding:8px 0 0 0;font-size:{{ sig['disclaimer_size'] }};line-height:1.35;color:#8A929A;\">\n"
"                            <t t-out=\"sig['disclaimer']\"/>\n"
"                        </td>\n"
"                    </tr></tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

