    <!-- Personnes à charge et partages de l'ado. -->
    <record id="health_dependent_rule_parent_ado" model="ir.rule">
        <field name="name">Personnes à charge : le parent qui tient les fiches, et l'ado qui les reçoit</field>
        <field name="model_id" ref="model_health_dependent"/>
        <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('ado_id', '=', user.id), ('coparent_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_health_user'))]"/>
    </record>

    <!-- Blue Fox gère les comptes : pour ouvrir celui de l'ado, elle voit
         le prénom et la naissance des enfants qui ont 14 ans, jamais leurs fiches
         (aucun droit sur les modèles santé hors du groupe santé). -->
    <record id="health_dependent_rule_admin" model="ir.rule">
        <field name="name">Personnes à charge : Blue Fox voit celles qui ont 14 ans</field>
        <field name="model_id" ref="model_health_dependent"/>
        <field name="domain_force">[('passage_atteint', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="health_share_rule_lecture" model="ir.rule">
        <field name="name">Partages santé : l'ado et son parent les voient</field>
        <field name="model_id" ref="model_health_share"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('parent_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_health_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

