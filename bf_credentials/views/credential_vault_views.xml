<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="credential_vault_view_list" model="ir.ui.view">
        <field name="name">project.credential.vault.list</field>
        <field name="model">project.credential.vault</field>
        <field name="arch" type="xml">
            <list string="Porteurs de deuxième facteur">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="shared"/>
                <field name="base_url" widget="url" optional="hide"/>
                <field name="credential_count" string="Identifiants"/>
            </list>
        </field>
    </record>

    <record id="credential_vault_view_form" model="ir.ui.view">
        <field name="name">project.credential.vault.form</field>
        <field name="model">project.credential.vault</field>
        <field name="arch" type="xml">
            <form string="Porteur de deuxième facteur">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_credentials" type="object"
                                class="oe_stat_button" icon="fa-key">
                            <field name="credential_count" widget="statinfo" string="Identifiants"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. : Coffre d'équipe"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="shared"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="base_url" widget="url"
                                   placeholder="https://coffre.exemple.com"/>
                            <field name="item_url_pattern"
                                   placeholder="https://coffre.exemple.com/#/vault?itemId={ref}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Ce modèle dit <strong>où</strong> vit un deuxième facteur, jamais
                        ce qu'il contient. Le gabarit de lien mène à l'élément chez son
                        porteur ; aucune graine n'entre ici.
                    </div>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Ce qu'il faut savoir pour y accéder..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="credential_vault_view_search" model="ir.ui.view">
        <field name="name">project.credential.vault.search</field>
        <field name="model">project.credential.vault</field>
        <field name="arch" type="xml">
            <search string="Porteurs de deuxième facteur">
                <field name="name"/>
                <field name="kind"/>
                <filter string="Accessible à plusieurs" name="filter_shared"
                        domain="[('shared', '=', True)]"/>
                <filter string="Un seul détenteur" name="filter_not_shared"
                        domain="[('shared', '=', False)]"/>
                <separator/>
                <filter string="Archivés" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Nature" name="group_kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="credential_vault_action" model="ir.actions.act_window">
        <field name="name">Porteurs de deuxième facteur</field>
        <field name="res_model">project.credential.vault</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="credential_vault_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Déclarer un porteur
            </p>
            <p>
                Un porteur est un endroit où vit un deuxième facteur : un coffre
                d'équipe, une application d'authentification, le téléphone de
                quelqu'un, un jeton matériel. Le registre dit où chercher ;
                il ne garde aucun secret.
            </p>
        </field>
    </record>

</odoo>
