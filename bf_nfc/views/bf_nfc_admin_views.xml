<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Types de fiche ─────────────────────────────────────────────── -->
    <record id="view_bf_nfc_target_type_list" model="ir.ui.view">
        <field name="name">bf.nfc.target.type.list</field>
        <field name="model">bf.nfc.target.type</field>
        <field name="arch" type="xml">
            <list string="Record types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model"/>
                <field name="name"/>
                <field name="gestion_seulement"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_bf_nfc_target_type" model="ir.actions.act_window">
        <field name="name">Record types</field>
        <field name="res_model">bf.nfc.target.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No record type</p>
            <p>The record types a tag can target, in addition to those a gesture requires on its own (the equipment of a loan, the checkpoint of a round). The same list is used by the website and the app.</p>
        </field>
    </record>

    <!-- ─── Clés des pastilles signées ─────────────────────────────────── -->
    <record id="view_bf_nfc_sdm_key_list" model="ir.ui.view">
        <field name="name">bf.nfc.sdm.key.list</field>
        <field name="model">bf.nfc.sdm.key</field>
        <field name="arch" type="xml">
            <!-- Aucune colonne de clé : une clé posée ne se relit jamais. -->
            <list string="Signed tag keys" create="false" edit="false">
                <field name="company_id"/>
                <field name="set_date"/>
                <field name="set_by_id"/>
                <field name="state" widget="badge" decoration-success="state == 'ok'"
                       decoration-danger="state == 'illisibles'"/>
            </list>
        </field>
    </record>

    <record id="action_bf_nfc_sdm_key" model="ir.actions.act_window">
        <field name="name">Signed tag keys</field>
        <field name="res_model">bf.nfc.sdm.key</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No keys set</p>
            <p>A signed tag (NTAG 424 DNA) proves every tap with two 16-byte AES keys, engraved in the chip. Set them from Settings: they are encrypted immediately and are never shown again.</p>
        </field>
    </record>

    <!-- ─── Réglages ───────────────────────────────────────────────────── -->
    <record id="view_bf_nfc_config_form" model="ir.ui.view">
        <field name="name">bf.nfc.config.form</field>
        <field name="model">bf.nfc.config</field>
        <field name="arch" type="xml">
            <form string="Tag settings">
                <sheet>
                    <group string="Taps">
                        <field name="fenetre_doublon"/>
                        <field name="differe_max_heures"/>
                    </group>
                    <group string="Target records">
                        <div colspan="2" class="text-muted">
                            The record types offered when engraving, on the website and in the app.
                        </div>
                        <field name="type_count" string="Types in the list"/>
                        <button name="action_types_de_fiche" type="object" string="Manage record types"
                                class="btn-link" colspan="2"/>
                    </group>
                    <group string="Signed tags (NTAG 424 DNA)">
                        <field name="origine_cle"/>
                        <div colspan="2" class="alert alert-warning" role="status"
                             invisible="not avertissement_cle">
                            <field name="avertissement_cle" nolabel="1"/>
                        </div>
                        <field name="cles_ids" nolabel="1" colspan="2" readonly="1">
                            <list>
                                <field name="company_id"/>
                                <field name="set_date"/>
                                <field name="set_by_id"/>
                                <field name="state" widget="badge" decoration-success="state == 'ok'"
                                       decoration-danger="state == 'illisibles'"/>
                            </list>
                        </field>
                        <button name="action_poser_cles" type="object" string="Set or replace keys"
                                class="btn-secondary" colspan="2"/>
                    </group>
                    <group string="App" groups="base.group_system">
                        <field name="schemas_appariement"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_enregistrer" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bf_nfc_config" model="ir.actions.act_window">
        <field name="name">Tag settings</field>
        <field name="res_model">bf.nfc.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_bf_nfc_sdm_key_wizard_form" model="ir.ui.view">
        <field name="name">bf.nfc.sdm.key.wizard.form</field>
        <field name="model">bf.nfc.sdm.key.wizard</field>
        <field name="arch" type="xml">
            <form string="Set the keys">
                <div class="alert alert-warning" role="status" invisible="not remplace">
                    This company already has its keys. Replacing them makes every signed tag engraved with the old ones stop working until they are reprogrammed.
                </div>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="company_id" invisible="1"/>
                    <field name="meta_key" password="True" placeholder="32 hexadecimal characters"/>
                    <field name="file_key" password="True" placeholder="32 hexadecimal characters"/>
                    <field name="remplace" invisible="1"/>
                </group>
                <p class="text-muted small">
                    Both keys are encrypted as soon as they are saved and will never be shown again, here or anywhere else.
                </p>
                <footer>
                    <button name="action_poser" type="object" string="Set the keys" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ─── Création en lot ────────────────────────────────────────────── -->
    <record id="view_bf_nfc_tag_lot_form" model="ir.ui.view">
        <field name="name">bf.nfc.tag.lot.form</field>
        <field name="model">bf.nfc.tag.lot</field>
        <field name="arch" type="xml">
            <form string="Create tags">
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <p>
                    One tag per record: <field name="fiche_count" class="oe_inline" readonly="1"/> record(s).
                    <span invisible="not deja_count">
                        <field name="deja_count" class="oe_inline" readonly="1"/> already have one for this gesture and will be skipped.
                    </span>
                </p>
                <group>
                    <field name="gesture_id" options="{'no_create': True}"/>
                    <field name="prefixe" placeholder="Evening patrol"/>
                    <field name="confirm_required"/>
                    <field name="params" groups="base.group_no_one"/>
                </group>
                <p class="text-muted small">
                    QR labels are then printed from the list of created tags; engraving is done from “My tags” in the app.
                </p>
                <footer>
                    <button name="action_creer" type="object" string="Create" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_creer_pastilles" model="ir.actions.server">
        <field name="name">Create tags</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('bf_nfc.group_nfc_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_creer_pastilles()</field>
    </record>

    <!-- ─── Lien retour sur le contact ─────────────────────────────────── -->
    <record id="view_partner_form_pastilles" model="ir.ui.view">
        <field name="name">res.partner.form.pastilles</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_voir_pastilles" type="object" class="oe_stat_button"
                        icon="fa-wifi" groups="bf_nfc.group_nfc_manager" invisible="not nfc_tag_count">
                    <field name="nfc_tag_count" widget="statinfo" string="Tags"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ─── Menus ──────────────────────────────────────────────────────── -->
    <menuitem id="menu_nfc_settings" name="Settings" parent="menu_nfc_config"
              action="action_bf_nfc_config" sequence="5"/>
    <menuitem id="menu_nfc_target_types" name="Record types" parent="menu_nfc_config"
              action="action_bf_nfc_target_type" sequence="15"/>
    <menuitem id="menu_nfc_sdm_keys" name="Signed tag keys" parent="menu_nfc_config"
              action="action_bf_nfc_sdm_key" sequence="25"/>
</odoo>
