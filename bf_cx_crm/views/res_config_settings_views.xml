<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.cx.crm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_cx.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='bf_cx_loop_block']" position="inside">
                <setting string="Lost-deal survey (CRM)"
                         help="When an opportunity is marked lost, send this program's survey to the contact (once per opportunity, over-solicitation guard applied).">
                    <field name="bf_cx_loss_program_id"/>
                </setting>
                <setting string="NPS enrollment on won deals (CRM)"
                         help="When a deal is won, add the customer to the next draft wave of this program. Nothing is sent right away: the wave goes out manually.">
                    <field name="bf_cx_won_program_id"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
