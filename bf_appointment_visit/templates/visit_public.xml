<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- La décision du vendeur, sans compte à créer. Un vendeur ne se connectera
         pas à un logiciel pour dire oui à une visite : le lien du courriel est
         la seule interface qu'il verra jamais. -->
    <template id="visit_seller_page" name="Showing: the seller's decision">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-call="bf_appointment.appointment_brand_style"/>
            <t t-set="additional_title">Showing request</t>

            <div class="bf-visit">
                <div class="bf-section-header mb-4">
                    <h2>Showing request</h2>
                    <p class="mb-0"><t t-out="visit.listing_id.name"/></p>
                </div>

                <div t-if="message" t-attf-class="alert alert-{{ message_kind or 'info' }}">
                    <t t-out="message"/>
                </div>

                <div class="bf-visit-card">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">When</dt>
                        <dd class="col-sm-7">
                            <t t-out="quand"/>
                        </dd>
                        <dt class="col-sm-5">People expected</dt>
                        <dd class="col-sm-7"><t t-out="visit.visitor_count or 1"/></dd>
                        <dt class="col-sm-5">Representation</dt>
                        <dd class="col-sm-7">
                            <t t-if="visit.representation == 'broker'">
                                Accompanied by their broker
                                <t t-if="visit.buyer_broker_name">
                                    (<t t-out="visit.buyer_broker_name"/>)
                                </t>
                            </t>
                            <t t-elif="visit.representation == 'none'">
                                The person has no broker
                            </t>
                            <t t-else="">Question unanswered</t>
                        </dd>
                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7"><t t-out="etat_libelle"/></dd>
                    </dl>
                </div>

                <form t-if="visit.state == 'requested'" method="post"
                      t-attf-action="/visite/vendeur/{{ token }}" class="mt-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="mb-3">
                        <label class="form-label" for="seller_note">
                            A word for the visitor (optional)
                        </label>
                        <textarea class="form-control" id="seller_note" name="seller_note"
                                  rows="2" placeholder="Ring the side door instead."/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="proposed_start">
                            Or propose another time
                        </label>
                        <input type="datetime-local" class="form-control"
                               id="proposed_start" name="proposed_start"/>
                        <div class="form-text">
                            Leave empty to accept or decline the time requested.
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" name="decision" value="approve"
                                class="btn bf-btn-accent">Accept this showing</button>
                        <button type="submit" name="decision" value="decline"
                                class="btn bf-visit-btn-second">Refuse</button>
                    </div>
                </form>

                <p class="mt-4 bf-visit-fineprint">
                    This link is personal to you. It gives access to this request only.
                </p>
            </div>
        </t>
    </template>

    <!-- La feuille d'inscription sur place, derrière un code QR. Elle sert
         pendant une visite libre, à qui se présente sans avoir réservé. -->
    <template id="visit_walkin_page" name="Showing: sign-in sheet">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-call="bf_appointment.appointment_brand_style"/>
            <t t-set="additional_title">Showing sign-in</t>

            <div class="bf-visit">
                <div class="bf-section-header mb-4">
                    <h2>Welcome</h2>
                    <p class="mb-0"><t t-out="listing.name"/></p>
                </div>

                <div t-if="message" t-attf-class="alert alert-{{ message_kind or 'info' }}">
                    <t t-out="message"/>
                </div>

                <form t-if="not termine" method="post"
                      t-attf-action="/visite/accueil/{{ token }}">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="visitor_name">Your name</label>
                            <input type="text" class="form-control" id="visitor_name"
                                   name="visitor_name" required="required"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="visitor_count">
                                Number of people
                            </label>
                            <input type="number" class="form-control" id="visitor_count"
                                   name="visitor_count" value="1" min="1" max="20"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="visitor_email">Email</label>
                            <input type="email" class="form-control" id="visitor_email"
                                   name="visitor_email"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="visitor_phone">Phone</label>
                            <input type="tel" class="form-control" id="visitor_phone"
                                   name="visitor_phone"/>
                        </div>
                    </div>

                    <div t-if="listing.require_representation" class="bf-visit-card mb-3">
                        <p class="mb-2">
                            <strong>Are you represented by a real estate broker?</strong>
                        </p>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="representation"
                                   id="rep_none" value="none" required="required"/>
                            <label class="form-check-label" for="rep_none">No</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="representation"
                                   id="rep_broker" value="broker"/>
                            <label class="form-check-label" for="rep_broker">Yes</label>
                        </div>
                        <input type="text" class="form-control" name="buyer_broker_name"
                               placeholder="Your broker's name and agency"/>
                        <p class="bf-visit-fineprint mt-2 mb-0">
                            The broker present represents the seller's interests.
                        </p>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="consent"
                               name="consent" required="required"/>
                        <label class="form-check-label" for="consent">
                            I agree that my name be entered in the visit register for
                            this property.
                        </label>
                    </div>

                    <button type="submit" class="btn bf-btn-accent">I have arrived</button>
                </form>
            </div>
        </t>
    </template>

    <!-- Ce que le visiteur en a pensé. Deux questions, pas douze. -->
    <template id="visit_feedback_page" name="Showing: feedback">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-call="bf_appointment.appointment_brand_style"/>
            <t t-set="additional_title">Your showing</t>

            <div class="bf-visit">
                <div class="bf-section-header mb-4">
                    <h2>Your showing</h2>
                    <p class="mb-0"><t t-out="visit.listing_id.name"/></p>
                </div>

                <div t-if="message" t-attf-class="alert alert-{{ message_kind or 'info' }}">
                    <t t-out="message"/>
                </div>

                <form t-if="not termine" method="post"
                      t-attf-action="/visite/retour/{{ token }}">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="mb-3">
                        <label class="form-label" for="feedback_interest">
                            Your interest in this property
                        </label>
                        <select class="form-select" id="feedback_interest"
                                name="feedback_interest" required="required">
                            <option value="">Choose</option>
                            <option value="1">No interest</option>
                            <option value="2">Low</option>
                            <option value="3">Worth considering</option>
                            <option value="4">Strong</option>
                            <option value="5">An offer is coming</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="feedback_price">The asking price</label>
                        <select class="form-select" id="feedback_price" name="feedback_price">
                            <option value="">No opinion</option>
                            <option value="high">Above market</option>
                            <option value="fair">At market</option>
                            <option value="low">Below market</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="feedback_comment">
                            Anything else to say? (optional)
                        </label>
                        <textarea class="form-control" id="feedback_comment"
                                  name="feedback_comment" rows="3"/>
                    </div>

                    <button type="submit" class="btn bf-btn-accent">Send</button>
                    <p class="bf-visit-fineprint mt-3 mb-0">
                        Your comment is passed on to the seller only if the broker
                        judges it useful to do so.
                    </p>
                </form>
            </div>
        </t>
    </template>

</odoo>
