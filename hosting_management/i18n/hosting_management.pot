"\n"
"                        <!-- Services activ&#233;s -->\n"
"                        <t t-if=\"ctx.get('activated_services')\">\n"
"                          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:28px;\">\n"
"                            <tbody>\n"
"                              <tr>\n"
"                                <td style=\"padding:20px;background-color:#F0F9FF;border-radius:12px;\">\n"
"                                  <p style=\"margin:0 0 10px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#0369A1;text-transform:uppercase;letter-spacing:0.5px;\">\n"
"                                    Your activated services\n"
