<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rule_form" model="ir.ui.view">
        <field name="name">bf.ex.eligibility.rule.form</field>
        <field name="model">bf.ex.eligibility.rule</field>
        <field name="arch" type="xml">
            <form string="Règle d'admissibilité">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Permanents après six mois"/></h1>
                        <field name="criteria_summary" readonly="1"/>
                    </div>
                    <group>
                        <group string="Qui">
                            <field name="benefit_id" readonly="1" force_save="1"/>
                            <field name="department_ids" widget="many2many_tags"/>
                            <field name="job_ids" widget="many2many_tags"/>
                            <field name="manager_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Sous quelles conditions">
                            <field name="employee_type"/>
                            <field name="seniority_months_min"/>
                            <field name="resource_calendar_ids" widget="many2many_tags"/>
                            <field name="work_location_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="employee_count" readonly="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rule_list" model="ir.ui.view">
        <field name="name">bf.ex.eligibility.rule.list</field>
        <field name="model">bf.ex.eligibility.rule</field>
        <field name="arch" type="xml">
            <list string="Règles">
                <field name="benefit_id"/>
                <field name="name"/>
                <field name="criteria_summary"/>
                <field name="employee_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_rule" model="ir.actions.act_window">
        <field name="name">Règles d'admissibilité</field>
        <field name="res_model">bf.ex.eligibility.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
