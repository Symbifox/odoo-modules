#. module: bf_multi_company_email
#: model:mail.template,body_html:bf_multi_company_email.bf_signature_banner
msgid ""
"<div>\n"
"                <t t-set=\"sig\" t-value=\"object.bf_signature_data()\"/>\n"
"                <table cellpadding=\"0\" cellspacing=\"0\" t-attf-style=\"border-collapse:collapse;font-family:{{ sig['font'] }};font-size:13px;line-height:1.5;color:{{ sig['text_color'] }};\">\n"
"                    <tbody><tr>\n"
"                        <td width=\"3\" t-attf-style=\"width:3px;padding:0;background-color:{{ sig['accent'] }};\">&nbsp;</td>\n"
"                        <td t-attf-style=\"padding:0 0 0 12px;color:{{ sig['text_color'] }};\">\n"
"                            <div t-attf-style=\"font-size:15px;font-weight:700;color:{{ sig['text_color'] }};\">\n"
"                                <t t-out=\"sig['name']\"/>\n"
"                                <span t-if=\"sig['pronouns']\" t-attf-style=\"font-weight:400;font-size:9pt;color:{{ sig['muted'] }};\">&nbsp;(<t t-out=\"sig['pronouns']\"/>)</span>\n"
"                            </div>\n"
"                            <div t-if=\"sig['title'] or sig['company_name']\" t-attf-style=\"font-size:12px;color:{{ sig['muted'] }};\">\n"
"                                <t t-out=\"sig['title']\"/>\n"
"                                <t t-if=\"sig['title'] and sig['company_name']\">,&nbsp;</t>\n"
"                                <span t-if=\"sig['company_name']\" t-attf-style=\"color:{{ sig['text_color'] }};font-weight:600;\"><t t-out=\"sig['company_name']\"/></span>\n"
"                            </div>\n"
"                            <div t-if=\"sig['email'] or sig['phone'] or sig['tollfree'] or sig['website']\" style=\"margin-top:6px;font-size:12px;\">\n"
"                                <a t-if=\"sig['email']\" t-attf-href=\"mailto:{{ sig['email'] }}\" t-attf-style=\"color:{{ sig['accent'] }};text-decoration:none;\"><t t-out=\"sig['email']\"/></a>\n"
"                                <t t-if=\"sig['email'] and sig['phone']\"><span style=\"color:#ccc;\">&nbsp;·&nbsp;</span></t>\n"
"                                <a t-if=\"sig['phone']\" t-att-href=\"sig['phone_href']\" t-attf-style=\"color:{{ sig['text_color'] }};text-decoration:none;\"><t t-out=\"sig['phone']\"/></a>\n"
"                                <t t-if=\"sig['tollfree'] and (sig['email'] or sig['phone'])\"><span style=\"color:#ccc;\">&nbsp;·&nbsp;</span></t>\n"
"                                <a t-if=\"sig['tollfree']\" t-att-href=\"sig['tollfree_href']\" t-attf-style=\"color:{{ sig['text_color'] }};text-decoration:none;\"><t t-out=\"sig['tollfree']\"/></a>\n"
"                                <t t-if=\"sig['website'] and (sig['email'] or sig['phone'] or sig['tollfree'])\"><span style=\"color:#ccc;\">&nbsp;·&nbsp;</span></t>\n"
"                                <a t-if=\"sig['website']\" t-att-href=\"sig['website_href']\" t-attf-style=\"color:{{ sig['accent'] }};text-decoration:none;\"><t t-out=\"sig['website']\"/></a>\n"
"                            </div>\n"
"                            <!-- Boutons : un lien = une cellule &#224; fond, libell&#233; blanc de 9 pt gras.\n"
"                                 Pourquoi : commentaire du record, au-dessus de ce gabarit. -->\n"
"                            <table t-if=\"sig['links']\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" t-attf-style=\"border-collapse:collapse;font-family:{{ sig['font'] }};\">\n"
"                                <tbody><tr>\n"
"                                    <t t-foreach=\"sig['links']\" t-as=\"link\">\n"
"                                    <td style=\"padding:6px 8px 0 0;\">\n"
"                                        <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\n"
"                                            <tbody><tr>\n"
"                                                <td t-att-bgcolor=\"sig['text_color']\" align=\"center\" t-attf-style=\"background-color:{{ sig['text_color'] }};padding:8px 12px;mso-line-height-rule:exactly;line-height:1;\">\n"
"                                                    <a t-att-href=\"link['url']\" t-attf-style=\"font-family:{{ sig['font'] }};font-size:9pt;font-weight:700;line-height:1;color:#FFFFFF;text-decoration:none;\"><font style=\"color:#FFFFFF;\"><t t-out=\"link['label']\"/></font></a>\n"
"                                                </td>\n"
"                                            </tr></tbody>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                    </t>\n"
"                                </tr></tbody>\n"
"                            </table>\n"
"                            <div t-if=\"sig['tagline']\" t-attf-style=\"margin-top:6px;font-size:11px;color:{{ sig['muted'] }};\"><t t-out=\"sig['tagline']\"/></div>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr t-if=\"sig['disclaimer']\">\n"
"                        <td colspan=\"3\" t-attf-style=\"padding:8px 0 0 0;font-size:{{ sig['disclaimer_size'] }};line-height:1.35;color:#8A929A;\">\n"
"                            <t t-out=\"sig['disclaimer']\"/>\n"
"                        </td>\n"
"                    </tr></tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

