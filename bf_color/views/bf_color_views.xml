<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Swatches -->
    <record id="bf_color_swatch_view_list" model="ir.ui.view">
        <field name="name">bf.color.swatch.list</field>
        <field name="model">bf.color.swatch</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id" optional="show"/>
                <field name="shared"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="bf_color_swatch_view_form" model="ir.ui.view">
        <field name="name">bf.color.swatch.form</field>
        <field name="model">bf.color.swatch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="color_hex" widget="color"/>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="bf_color_swatch_action" model="ir.actions.act_window">
        <field name="name">Color swatches</field>
        <field name="res_model">bf.color.swatch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

    <!-- Automatic rules -->
    <record id="bf_color_rule_view_list" model="ir.ui.view">
        <field name="name">bf.color.rule.list</field>
        <field name="model">bf.color.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="only_listed" optional="hide"/>
                <field name="fallback_swatch_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="bf_color_rule_view_form" model="ir.ui.view">
        <field name="name">bf.color.rule.form</field>
        <field name="model">bf.color.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign_missing" type="object" string="Assign missing colors"
                            groups="base.group_system"
                            invisible="not value_colorable or only_listed or not id"
                            help="Give every value in use that has no color of its own the least used color of the fallback swatch (or of the default palette)."/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        A record takes, in this order: the color its user chose, the company's color,
                        the first line below that matches, the criterion's own color (a doctor's color
                        set on the doctor), then a color from the fallback swatch.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="field_id" options="{'no_create': True, 'no_open': True}" readonly="not model_id"/>
                            <field name="field_type" invisible="1"/>
                            <field name="value_colorable" invisible="1"/>
                        </group>
                        <group>
                            <field name="only_listed"/>
                            <field name="fallback_swatch_id" invisible="only_listed"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="not field_id">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="field_type" column_invisible="1"/>
                            <field name="value_model" column_invisible="1"/>
                            <field name="value_res_id" widget="many2one_reference"
                                   invisible="field_type not in ('many2one', 'many2many')"/>
                            <field name="value_char" invisible="field_type in ('many2one', 'many2many')"/>
                            <field name="color_hex" widget="bf_color"/>
                        </list>
                    </field>
                    <p class="text-muted" invisible="field_type != 'many2many'">
                        With several values on one record, the highest line wins: drag the lines to set the order.
                    </p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="bf_color_rule_action" model="ir.actions.act_window">
        <field name="name">Automatic color rules</field>
        <field name="res_model">bf.color.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="bf_color_menu_root" name="Colors" parent="base.menu_administration" sequence="60"/>
    <menuitem id="bf_color_menu_swatch" name="Swatches" parent="bf_color_menu_root"
              action="bf_color_swatch_action" sequence="10"/>
    <menuitem id="bf_color_menu_rule" name="Automatic rules" parent="bf_color_menu_root"
              action="bf_color_rule_action" sequence="20" groups="base.group_system"/>
</odoo>
