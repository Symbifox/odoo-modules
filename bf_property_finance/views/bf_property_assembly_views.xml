<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Art. 1094 C.c.Q. : la gouvernance porte la case, le volet financier
         porte le fait. Le module propose, il ne prive personne : la privation
         se constate à l'assemblée, et un encaissement reçu la veille et pas
         encore saisi suffit à la faire tomber. -->
    <record id="view_assembly_form_finance" model="ir.ui.view">
        <field name="name">bf.property.assembly.form.finance</field>
        <field name="model">bf.property.assembly</field>
        <field name="inherit_id" ref="bf_property_governance.view_assembly_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attendance_ids']/list/field[@name='voting_deprived']"
                   position="before">
                <field name="deprivation_suggested" readonly="1" optional="show"/>
                <field name="charges_overdue_amount" readonly="1" optional="hide"/>
                <field name="charges_overdue_since" readonly="1" optional="hide"/>
                <field name="charges_total_due" readonly="1" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_apply_deprivation" type="object"
                        string="Appliquer l'art. 1094 d'après les impayés"
                        invisible="deprivation_candidate_count == 0"/>
                <field name="deprivation_candidate_count" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='attendance']" position="inside">
                <div class="alert alert-warning mt-2" role="alert"
                     invisible="deprivation_candidate_count == 0">
                    Art. 1094 C.c.Q. : le registre des impayés montre
                    <field name="deprivation_candidate_count" readonly="1" nolabel="1"
                           class="oe_inline"/>
                    ligne(s) de présence dont le copropriétaire n'a pas acquitté sa
                    quote-part des charges communes depuis plus de trois mois. Le module
                    ne coche rien : la privation se constate à l'assemblée, et le droit
                    revient dès que la totalité des charges dues est acquittée.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
