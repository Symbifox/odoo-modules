<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- ntfy webhook URL — set per-deployment via system parameter.
         Leaving the default empty: the hook is a no-op until configured.
         Example: http://your-webhook-relay:8090/hook/helpdesk-critical -->
    <record id="ir_config_ntfy_webhook_url" model="ir.config_parameter">
      <field name="key">bf_helpdesk.ntfy_webhook_url</field>
      <field name="value"></field>
    </record>

    <record id="ir_config_ntfy_webhook_timeout" model="ir.config_parameter">
      <field name="key">bf_helpdesk.ntfy_webhook_timeout</field>
      <field name="value">5</field>
    </record>

    <!-- Public form attachment limits (MB) -->
    <record id="ir_config_pubform_max_attachment_mb" model="ir.config_parameter">
      <field name="key">bf_helpdesk.public_form_max_attachment_mb</field>
      <field name="value">10</field>
    </record>
    <record id="ir_config_pubform_max_total_attachment_mb" model="ir.config_parameter">
      <field name="key">bf_helpdesk.public_form_max_total_attachment_mb</field>
      <field name="value">25</field>
    </record>

    <!-- Les gabarits de courriel sont dans data/mail_templates.xml : la
         migration 18.0.4.8.0 recharge ce fichier-là seul, sans toucher aux
         paramètres ci-dessus. -->

    <!-- SLA : recalcul horaire de l'état et activité sur dépassement -->
    <record id="ir_cron_sla_breach" model="ir.cron">
      <field name="name">BF Helpdesk: SLA breach activity</field>
      <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
      <field name="state">code</field>
      <field name="code">model._cron_sla_breach_activity()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active">True</field>
    </record>

    <!-- Relances des billets en attente du client : toutes les heures -->
    <record id="ir_cron_waiting_reminders" model="ir.cron">
      <field name="name">BF Helpdesk: relances des billets en attente du client</field>
      <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
      <field name="state">code</field>
      <field name="code">model._cron_waiting_reminders()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active">True</field>
    </record>

    <!-- Satisfaction v2 : envois dus et expirations, toutes les heures -->
    <record id="ir_cron_csat" model="ir.cron">
      <field name="name">BF Helpdesk: sondages de satisfaction</field>
      <field name="model_id" ref="bf_helpdesk.model_helpdesk_ticket_csat"/>
      <field name="state">code</field>
      <field name="code">model._cron_csat()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active">True</field>
    </record>

    <!-- Résumés quotidiens aux clients qui les ont choisis : la tâche passe
         toutes les heures et n'envoie qu'après 8 h, heure du client. -->
    <record id="ir_cron_client_digest" model="ir.cron">
      <field name="name">BF Helpdesk: résumés quotidiens aux clients</field>
      <field name="model_id" ref="bf_helpdesk.model_helpdesk_client_digest_item"/>
      <field name="state">code</field>
      <field name="code">model._cron_send_client_digests()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active">True</field>
    </record>

    <!-- Condensés des agents (horaires et quotidiens) -->
    <record id="ir_cron_agent_digest" model="ir.cron">
      <field name="name">BF Helpdesk: condensés de notifications des agents</field>
      <field name="model_id" ref="bf_helpdesk.model_helpdesk_agent_notify_item"/>
      <field name="state">code</field>
      <field name="code">model._cron_send_agent_digests()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active">True</field>
    </record>

    <!-- Triage automatique : file traitée toutes les 10 minutes, et tout de
         suite à la création d'un billet (_trigger). -->
    <record id="ir_cron_triage_queue" model="ir.cron">
      <field name="name">BF Helpdesk: triage IA des billets en file</field>
      <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
      <field name="state">code</field>
      <field name="code">model._cron_triage_queue()</field>
      <field name="interval_number">10</field>
      <field name="interval_type">minutes</field>
      <field name="active">True</field>
    </record>

    <!-- Regroupement par thème des billets fermés, chaque semaine -->
    <record id="ir_cron_weekly_themes" model="ir.cron">
      <field name="name">BF Helpdesk: regroupement hebdomadaire par thème</field>
      <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
      <field name="state">code</field>
      <field name="code">model._cron_weekly_themes()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">weeks</field>
      <field name="active">True</field>
    </record>

  </data>
</odoo>
