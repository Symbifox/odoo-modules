<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cinq minutes, et la route demande en plus un passage immédiat
             (`_trigger`) : un résident n'attend pas son avis de colis, et un
             avis non traité n'est pas un avis perdu. -->
        <record id="cron_parcel_expedibox_notices" model="ir.cron">
            <field name="name">Colis : traiter les avis des casiers Expedibox</field>
            <field name="model_id" ref="model_bf_property_parcel_expedibox_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_notices()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
        <record id="cron_parcel_expedibox_purge" model="ir.cron">
            <field name="name">Colis : purger le journal des avis Expedibox</field>
            <field name="model_id" ref="model_bf_property_parcel_expedibox_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.utcnow() - timedelta(hours=5, minutes=30) + relativedelta(days=1)).strftime('%Y-%m-%d 05:30:00')"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
