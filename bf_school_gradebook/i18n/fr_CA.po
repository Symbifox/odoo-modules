#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/subject.py:0
msgid "%(component)s cannot be a %(kind)s of %(subject)s."
msgstr "Dans %(subject)s, %(component)s ne peut pas être de type « %(kind)s »."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/assessment.py:0
msgid "%(score)s is already entered for %(student)s: the evaluation cannot be marked out of less than that (%(max)s)."
msgstr "%(score)s est déjà saisi pour %(student)s : l'évaluation ne peut pas être notée sur moins que cela (%(max)s)."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/assessment.py:0
msgid "%(score)s is not between 0 and %(max)s, the maximum of %(name)s."
msgstr "%(score)s ne se situe pas entre 0 et %(max)s, la note maximale de %(name)s."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/assessment.py:0
msgid "%(student)s is not in the group of this course."
msgstr "%(student)s ne fait pas partie du groupe de ce cours."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/assessment.py:0
msgid "%s has a single discipline result: an evaluation judges no component."
msgstr "%s n'a qu'un résultat disciplinaire : une évaluation n'y porte sur aucune compétence ni aucun volet."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/subject.py:0
msgid "%s has a single discipline result: it takes no components."
msgstr "%s n'a qu'un résultat disciplinaire : cette matière ne compte ni compétence ni volet."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/exam.py:0
msgid "%s has no ministerial exam."
msgstr "%s n'a pas d'épreuve ministérielle."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/term.py:0
msgid "%s is closed: ask the school office to reopen it before changing grades."
msgstr "%s est fermée : demandez au secrétariat de la rouvrir avant de modifier des notes."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/course.py:0
msgid "%s is not a component of the subject of this course."
msgstr "%s n'est ni une compétence ni un volet de la matière de ce cours."

#. module: bf_school_gradebook
#. odoo-python
#: code:addons/bf_school_gradebook/models/exam.py:0
msgid "%s is not in the group of this course."
msgstr "%s ne fait pas partie du groupe de ce cours."

#. module: bf_school_gradebook
#: model_terms:ir.ui.view,arch_db:bf_school_gradebook.bf_school_course_view_form
msgid ""
"<strong>Enter the units of this course:</strong>\n"
"                        the subjects ship with the units of the first cycle (s. 23) and the table of the second\n"
"                        cycle (s. 23.1) is not shipped. A report card prints these units."
msgstr ""
"<strong>Saisissez les unités de ce cours :</strong>\n"
"                        les matières sont livrées avec les unités du premier cycle (art. 23) et le tableau du second\n"
"                        cycle (art. 23.1) n'est pas livré. Un bulletin imprime ces unités."

#. module: bf_school_gradebook
#: model_terms:ir.ui.view,arch_db:bf_school_gradebook.bf_school_course_view_form
msgid ""
"<strong>The component weights must total 100 %:</strong>\n"
"                        no discipline result is computed until they do. Total now:"
msgstr ""
"<strong>Les pondérations des compétences ou volets doivent totaliser 100 % :</strong>\n"
"                        aucun résultat disciplinaire n'est calculé tant qu'elles ne le font pas. Total actuel :"

#. module: bf_school_gradebook
#: model:ir.model.fields,help:bf_school_gradebook.field_bf_school_term__state
msgid "A closed term no longer takes grades from the teachers; the office can reopen it."
msgstr "Une étape fermée ne reçoit plus de notes du personnel enseignant ; le secrétariat peut la rouvrir."

