<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
          Aucun groupe neuf. `hr_recruitment` en pose déjà trois, dans l'ordre
          Interviewer < Officer < Administrator, et ils décrivent exactement les
          rôles dont le cahier a besoin.
        -->

        <!-- ============ Séances ============ -->

        <record id="rule_interview_interviewer" model="ir.rule">
            <field name="name">Séance : la personne ne voit que les panels où elle siège</field>
            <field name="model_id" ref="model_bf_interview"/>
            <field name="domain_force">[('interviewer_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_interviewer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_interview_officer" model="ir.rule">
            <field name="name">Séance : le recruteur voit tout</field>
            <field name="model_id" ref="model_bf_interview"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        </record>

        <!-- ============ Notations : le dépôt à l'aveugle ============ -->

        <!--
          La règle qui porte la promesse du module. Une personne du panel voit :
            * sa propre notation, toujours ;
            * celles des autres seulement si la séance n'est pas à l'aveugle,
              ou si elle a elle-même déposé la sienne.
          `submitted_user_ids` est un champ calculé STOCKÉ sur la séance, donc
          la condition s'exprime en SQL et tient dans un domaine.
        -->
        <record id="rule_rating_interviewer" model="ir.rule">
            <field name="name">Notation : masquée tant que la mienne n'est pas déposée</field>
            <field name="model_id" ref="model_bf_interview_rating"/>
            <field name="domain_force">['&amp;',
                ('interview_id.interviewer_ids', 'in', [user.id]),
                '|', '|',
                    ('user_id', '=', user.id),
                    ('interview_id.blind', '=', False),
                    ('interview_id.submitted_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_interviewer'))]"/>
        </record>

        <record id="rule_rating_officer" model="ir.rule">
            <field name="name">Notation : le recruteur voit tout</field>
            <field name="model_id" ref="model_bf_interview_rating"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        </record>

        <!-- ============ Multi-société ============ -->

        <record id="rule_interview_company" model="ir.rule">
            <field name="name">Séance : société</field>
            <field name="model_id" ref="model_bf_interview"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_guide_company" model="ir.rule">
            <field name="name">Grille : société</field>
            <field name="model_id" ref="model_bf_interview_guide"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
