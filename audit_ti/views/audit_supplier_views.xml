<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_supplier_list" model="ir.ui.view">
        <field name="name">audit.supplier.list</field>
        <field name="model">audit.supplier</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="supplier_type"/>
                <field name="nc_status" widget="badge"
                    decoration-success="nc_status == 'completed'"
                    decoration-warning="nc_status == 'wip'"
                    decoration-danger="nc_status == 'to_create'"
                    decoration-info="nc_status in ('saas', 'na')"
                    decoration-muted="nc_status == 'new'"/>
                <field name="nc_status_detail"/>
            </list>
        </field>
    </record>

    <record id="view_audit_supplier_form" model="ir.ui.view">
        <field name="name">audit.supplier.form</field>
        <field name="model">audit.supplier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="supplier_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="nc_status"/>
                            <field name="nc_status_detail"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clients">
                            <field name="client_supplier_ids">
                                <list>
                                    <field name="client_id"/>
                                    <field name="roles"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alias">
                            <field name="alias_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_audit_supplier_search" model="ir.ui.view">
        <field name="name">audit.supplier.search</field>
        <field name="model">audit.supplier</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supplier_type"/>
                <filter name="completed" string="Complété" domain="[('nc_status', '=', 'completed')]"/>
                <filter name="wip" string="En cours" domain="[('nc_status', '=', 'wip')]"/>
                <filter name="to_create" string="À créer" domain="[('nc_status', '=', 'to_create')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'supplier_type'}"/>
                    <filter name="group_status" string="Statut NC" context="{'group_by': 'nc_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_audit_supplier" model="ir.actions.act_window">
        <field name="name">Fournisseurs TI</field>
        <field name="res_model">audit.supplier</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
