#. module: bf_school_privacy
#: model_terms:ir.ui.view,arch_db:bf_school_privacy.portal_my_school_consents_link
msgid "<i class=\"fa fa-shield me-1\"/>Consents"
msgstr "<i class=\"fa fa-shield me-1\"/>Consentements"

#. module: bf_school_privacy
#: model_terms:privacy.purpose,plain_language_summary:bf_school_privacy.purpose_school_edtech
msgid ""
"An account for your child on educational platforms chosen by the school "
"(reading, mathematics, languages). Some are hosted outside Québec: the "
"school assessed them before choosing them."
msgstr ""
"Un compte pour votre enfant sur des plateformes éducatives choisies par "
"l'école (lecture, mathématiques, langues). Certaines sont hébergées hors du "
"Québec : l'école les a évaluées avant de les choisir."

#. module: bf_school_privacy
#. odoo-python
#: code:addons/bf_school_privacy/models/school.py:0
#: model_terms:ir.ui.view,arch_db:bf_school_privacy.bf_school_view_form_privacy
msgid "Ask this year's consents"
msgstr "Demander les consentements de l'année"

#. module: bf_school_privacy
#: model:privacy.purpose,name:bf_school_privacy.purpose_school_edtech
msgid "Educational platforms outside the school"
msgstr "Plateformes éducatives hors de l'école"

#. module: bf_school_privacy
#: model:privacy.purpose,name:bf_school_privacy.purpose_school_directory
msgid "Family contact list of the group"
msgstr "Liste de contacts des familles du groupe"

#. module: bf_school_privacy
#. odoo-python
#: code:addons/bf_school_privacy/models/school.py:0
msgid "Nobody is enrolled this year."
msgstr "Personne n'est inscrit cette année."

#. module: bf_school_privacy
#. odoo-python
#: code:addons/bf_school_privacy/models/school.py:0
msgid "Only the school administration asks for consents."
msgstr "Seule l'administration de l'école demande les consentements."

#. module: bf_school_privacy
#: model:privacy.purpose,name:bf_school_privacy.purpose_school_photo_internal
msgid "Photos and videos inside the school"
msgstr "Photos et vidéos à l'intérieur de l'école"

#. module: bf_school_privacy
#: model_terms:privacy.purpose,plain_language_summary:bf_school_privacy.purpose_school_photo_public
msgid ""
"Photos and videos of your child published where anyone can see them: the "
"school's website, its social media accounts, local newspapers."
msgstr ""
"Photos et vidéos de votre enfant publiées là où tout le monde peut les voir "
": site Web de l'école, ses comptes de médias sociaux, journaux locaux."

#. module: bf_school_privacy
#: model_terms:privacy.purpose,plain_language_summary:bf_school_privacy.purpose_school_photo_internal
msgid ""
"Photos and videos of your child taken during school activities, shown only "
"inside the school: classroom boards, the family portal, the yearbook given "
"to families."
msgstr ""
"Photos et vidéos de votre enfant prises lors des activités scolaires, "
"montrées seulement à l'intérieur de l'école : tableaux de la classe, portail"
" des familles, album remis aux familles."

#. module: bf_school_privacy
#: model:privacy.purpose,name:bf_school_privacy.purpose_school_photo_public
msgid "Photos and videos published outside the school"
msgstr "Photos et vidéos publiées hors de l'école"

#. module: bf_school_privacy
#: model:ir.model,name:bf_school_privacy.model_bf_school
msgid "School"
msgstr "École"

#. module: bf_school_privacy
#: model:privacy.notice,name:bf_school_privacy.notice_school_edtech
msgid "School: educational platforms outside the school"
msgstr "École : plateformes éducatives hors de l'école"

#. module: bf_school_privacy
#: model:privacy.notice,name:bf_school_privacy.notice_school_directory
msgid "School: family contact list of the group"
msgstr "École : liste de contacts des familles du groupe"

#. module: bf_school_privacy
#: model:privacy.notice,name:bf_school_privacy.notice_school_photo_internal
msgid "School: photos and videos inside the school"
msgstr "École : photos et vidéos à l'intérieur de l'école"

#. module: bf_school_privacy
#: model:privacy.notice,name:bf_school_privacy.notice_school_photo_public
msgid "School: photos and videos published outside the school"
msgstr "École : photos et vidéos publiées hors de l'école"

#. module: bf_school_privacy
#: model:privacy.consent.group,name:bf_school_privacy.consent_group_school_year
msgid "School: this year's consents"
msgstr "École : consentements de l'année"

#. module: bf_school_privacy
#: model_terms:privacy.purpose,plain_language_summary:bf_school_privacy.purpose_school_directory
msgid ""
"Your name and email shared with the other families of your child's group, "
"for carpooling and birthday invitations."
msgstr ""
"Votre nom et votre courriel communiqués aux autres familles du groupe de "
"votre enfant, pour le covoiturage et les invitations d'anniversaire."
