<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="subscription_tag_list" model="ir.ui.view">
        <field name="name">subscription.tag.list</field>
        <field name="model">subscription.tag</field>
        <field name="arch" type="xml">
            <list string="Étiquettes d'abonnement" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_subscription_tag" model="ir.actions.act_window">
        <field name="name">Étiquettes</field>
        <field name="res_model">subscription.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
