<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.gamification.hr.holidays</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_gamification.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='gamification_leave_max_per_year']/.." position="after">
                <div class="row">
                    <label for="gamification_leave_type_id" class="col-lg-7 o_light_label"/>
                    <field name="gamification_leave_type_id" class="col-lg-5"
                           options="{'no_create': True}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
