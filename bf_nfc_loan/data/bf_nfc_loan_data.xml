<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gesture_loan" model="bf.nfc.gesture">
        <field name="name">Take or return equipment</field>
        <field name="code">loan</field>
        <field name="kind">loan</field>
        <field name="sequence">30</field>
        <field name="writes" eval="True"/>
        <field name="needs_target" eval="True"/>
        <field name="accepte_differe" eval="True"/>
        <field name="target_model_id" ref="bf_nfc_loan.model_bf_nfc_equipment"/>
        <field name="description">Free, you take it; yours, you return it. If someone else has it, the screen names them and offers to take it back. In a menu, the parameter {"sens": "prendre"} or {"sens": "rendre"} sets the direction.</field>
    </record>

    <record id="cron_loan_reminders" model="ir.cron">
        <field name="name">Tags: reminders for equipment to return</field>
        <field name="model_id" ref="bf_nfc_loan.model_bf_nfc_equipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_rappels()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
