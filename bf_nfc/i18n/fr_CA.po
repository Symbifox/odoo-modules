msgstr "Poser un gabarit est réservé à la gestion des pastilles."

#. module: bf_nfc
#: model:bf.nfc.gesture,description:bf_nfc.gesture_cron
msgid ""
"Asks a scheduled action to run right away, without waiting for its next run."
" Reserved for managers."
msgstr ""
"Demande à une tâche planifiée de tourner tout de suite, sans attendre son "
"prochain passage. Réservé à la gestion."

#. module: bf_nfc
#: model:ir.model.fields,field_description:bf_nfc.field_bf_nfc_template_apply__demande_adresse
msgid "Asks for an address"
msgstr "Demande une adresse"

