<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Configurer l'import .eml</field>
        <field name="description">Réglez le seuil de taille, l'autocréation de partenaires et la stratégie de fil de discussion.</field>
        <field name="button_text">Ouvrir Paramètres</field>
        <field name="done_text">Paramètres prêts</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>
    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Import .eml</field>
        <field name="route_name">bf_mail_import_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_mail_import</field>
        <field name="step_ids" eval="[Command.link(ref('bf_mail_import.bf_onb_step_settings'))]"/>
    </record>
</odoo>
