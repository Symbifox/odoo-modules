<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_securetransfer" model="ir.module.category">
            <field name="name">Transfert sécurisé</field>
            <field name="sequence">36</field>
        </record>

        <record id="group_securetransfer_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="comment">Peut consulter les transferts et leur journal d'accès.</field>
            <field name="category_id" ref="module_category_securetransfer"/>
        </record>

        <record id="group_securetransfer_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="comment">Accès complet : marques, configuration, expiration, purge et révélation des liens.</field>
            <field name="category_id" ref="module_category_securetransfer"/>
            <field name="implied_ids" eval="[(4, ref('group_securetransfer_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- All transfers are created by anonymous visitors (sudo behind
             tokens); there is no per-creator ownership to enforce. Both
             groups therefore see everything — the multi-company rule below
             is the only record-level restriction. -->
        <record id="rule_secure_transfer_user" model="ir.rule">
            <field name="name">Transferts : utilisateur</field>
            <field name="model_id" ref="model_secure_transfer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_securetransfer_user'))]"/>
        </record>

        <record id="rule_secure_transfer_manager" model="ir.rule">
            <field name="name">Transferts : accès complet</field>
            <field name="model_id" ref="model_secure_transfer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_securetransfer_manager'))]"/>
        </record>

        <!-- Standard multi-company isolation (global rule, no groups). -->
        <record id="rule_secure_transfer_company" model="ir.rule">
            <field name="name">Transferts : multi-société</field>
            <field name="model_id" ref="model_secure_transfer"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>


        <!-- === Children and brand: same isolation as the transfer (2026-07-31) ===

             The rule above only covered secure.transfer itself. The file rows,
             the access log and the brand had NO rule at all, so a user of
             company B could read company A's filenames, S3 keys, download
             audit trail (with IPs) and brand configuration — while the parent
             transfer was correctly hidden. Measured on a two-company instance
             on 2026-07-31.

             Files and log rows carry no company_id of their own: they inherit
             it from the transfer, which avoids a new column, a migration, and
             any chance of the two values drifting apart.

             These rules do NOT affect the public pages: every controller path
             resolves its transfer through sudo() behind a token, so recipients
             are unaffected. -->

        <record id="rule_secure_transfer_file_company" model="ir.rule">
            <field name="name">Fichiers transférés : multi-société</field>
            <field name="model_id" ref="model_secure_transfer_file"/>
            <field name="domain_force">['|', ('transfer_id.company_id', '=', False), ('transfer_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_secure_transfer_access_log_company" model="ir.rule">
            <field name="name">Journal d'accès : multi-société</field>
            <field name="model_id" ref="model_secure_transfer_access_log"/>
            <field name="domain_force">['|', ('transfer_id.company_id', '=', False), ('transfer_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_secure_transfer_brand_company" model="ir.rule">
            <field name="name">Marques : multi-société</field>
            <field name="model_id" ref="model_secure_transfer_brand"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Un préréglage sans société sert tout le monde : c'est le cas
             des trois livrés avec le module. -->
        <record id="rule_secure_transfer_template_company" model="ir.rule">
            <field name="name">Préréglages : multi-société</field>
            <field name="model_id" ref="model_secure_transfer_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- L'audience porte des renseignements personnels de tiers (adresse,
             mobile, IP) : même isolement que le journal, et pour la même
             raison. Elle hérite la société du transfert plutôt que de porter
             sa propre colonne, qui pourrait dériver. -->
        <record id="rule_secure_transfer_audience_company" model="ir.rule">
            <field name="name">Audience : multi-société</field>
            <field name="model_id" ref="model_secure_transfer_audience"/>
            <field name="domain_force">['|', ('transfer_id.company_id', '=', False), ('transfer_id.company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
