#. module: bf_federation_gantt
#: model_terms:ir.ui.view,arch_db:bf_federation_gantt.view_bf_gantt_plan_form_federation
msgid "Renvoyer au pair"
msgstr "Send to the peer again"

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
msgid "Renvoyer un échéancier à un pair demande le rôle de gestionnaire de projet."
msgstr "Sending a schedule to a peer again requires the project manager role."

#. module: bf_federation_gantt
#: model:ir.model.fields,help:bf_federation_gantt.field_bf_gantt_plan__federation_is_mirror
msgid "Un échéancier reçu se lit : la prochaine version de l'émetteur le remplacera."
msgstr "A received schedule is read-only: the sender's next version will replace it."

#. module: bf_federation_gantt
#. odoo-python
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
#: code:addons/bf_federation_gantt/models/bf_gantt_plan.py:0
