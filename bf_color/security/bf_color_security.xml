<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Overrides: a user reads their own and their companies'; writes only their own.
         Company overrides go through bf_color_set_company(), which checks the admin group. -->
    <record id="rule_bf_color_override_read" model="ir.rule">
        <field name="name">Color override: own or company (read)</field>
        <field name="model_id" ref="model_bf_color_override"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_bf_color_override_write" model="ir.rule">
        <field name="name">Color override: own only (write)</field>
        <field name="model_id" ref="model_bf_color_override"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_bf_color_override_admin" model="ir.rule">
        <field name="name">Color override: admin</field>
        <field name="model_id" ref="model_bf_color_override"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- Swatches: own and shared are visible; shared ones are edited by admins. -->
    <record id="rule_bf_color_swatch_read" model="ir.rule">
        <field name="name">Color swatch: own or shared (read)</field>
        <field name="model_id" ref="model_bf_color_swatch"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), '&amp;', ('user_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_bf_color_swatch_write" model="ir.rule">
        <field name="name">Color swatch: own only (write)</field>
        <field name="model_id" ref="model_bf_color_swatch"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_bf_color_swatch_admin" model="ir.rule">
        <field name="name">Color swatch: admin</field>
        <field name="model_id" ref="model_bf_color_swatch"/>
        <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <!-- Une ligne suit son nuancier, en lecture ET en écriture : sans drapeaux,
         la règle de lecture valait aussi pour l'écriture, et tout usager
         pouvait retoucher les couleurs d'un nuancier partagé du locataire. -->
    <record id="rule_bf_color_swatch_line" model="ir.rule">
        <field name="name">Color swatch entry: follows its swatch (read)</field>
        <field name="model_id" ref="model_bf_color_swatch_line"/>
        <field name="domain_force">['|', ('swatch_id.user_id', '=', user.id), '&amp;', ('swatch_id.user_id', '=', False), ('swatch_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_bf_color_swatch_line_write" model="ir.rule">
        <field name="name">Color swatch entry: own swatch only (write)</field>
        <field name="model_id" ref="model_bf_color_swatch_line"/>
        <field name="domain_force">[('swatch_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_bf_color_swatch_line_admin" model="ir.rule">
        <field name="name">Color swatch entry: admin</field>
        <field name="model_id" ref="model_bf_color_swatch_line"/>
        <field name="domain_force">['|', ('swatch_id.user_id', '=', False), ('swatch_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_bf_color_rule_line_company" model="ir.rule">
        <field name="name">Color rule line: multi-company</field>
        <field name="model_id" ref="model_bf_color_rule_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('rule_id.company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_bf_color_rule_company" model="ir.rule">
        <field name="name">Color rule: multi-company</field>
        <field name="model_id" ref="model_bf_color_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
