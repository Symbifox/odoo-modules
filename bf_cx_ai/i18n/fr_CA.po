msgstr "%s analyse(s) réussie(s)."

#. module: bf_cx_ai
#: model:ir.model.fields,help:bf_cx_ai.field_res_config_settings__bf_cx_ai_auto_analyze
msgid ""
"A daily job analyzes (sentiment, themes, summary) up to 20 recent unanalyzed"
" comments, through the AI bridge: the comments' text is sent to the AI "
"model. Off by default."
msgstr ""
"Un traitement quotidien analyse (sentiment, thèmes, résumé) jusqu'à 20 "
"commentaires récents non analysés, par le pont IA : le texte des "
"commentaires est transmis au modèle d'IA. Désactivé par défaut."

#. module: bf_cx_ai
#. odoo-python
#: code:addons/bf_cx_ai/models/bf_cx_feedback.py:0
msgid "AI analysis"
msgstr "Analyse IA"

#. module: bf_cx_ai
#. odoo-python
#: code:addons/bf_cx_ai/models/bf_cx_feedback.py:0
msgid "AI analysis done (%s)."
msgstr "Analyse IA terminée (%s)."

#. module: bf_cx_ai
#. odoo-python
#: code:addons/bf_cx_ai/models/bf_cx_feedback.py:0
msgid "AI analysis not done: the AI bridge did not answer (%s)."
msgstr "Analyse IA non effectuée : le pont IA n'a pas répondu (%s)."

#. module: bf_cx_ai
#. odoo-python
#: code:addons/bf_cx_ai/models/bf_cx_feedback.py:0
msgid ""
"AI analysis not done: the AI bridge is unavailable (socket not found). Try "
"again later or check the claude-chatbot-bridge service."
msgstr ""
"Analyse IA non effectuée : le pont IA est indisponible (socket introuvable)."
" Réessayer plus tard ou vérifier le service claude-chatbot-bridge."

#. module: bf_cx_ai
#. odoo-python
#: code:addons/bf_cx_ai/models/bf_cx_feedback.py:0
msgid "AI analysis: unreadable answer from the AI bridge, no field updated."
msgstr "Analyse IA : réponse illisible du pont IA, aucun champ mis à jour."

#. module: bf_cx_ai
#: model_terms:ir.ui.view,arch_db:bf_cx_ai.view_cx_feedback_form_ai
msgid "Analyze (AI)"
msgstr "Analyser (IA)"

#. module: bf_cx_ai
#: model_terms:ir.ui.view,arch_db:bf_cx_ai.view_cx_feedback_form_ai
msgid ""
"Analyze the comment (sentiment, themes, summary) through the AI bridge: the "
"comment's text is sent to the AI model."
msgstr ""
"Analyser le commentaire (sentiment, thèmes, résumé) par le pont IA : le "
"texte du commentaire est transmis au modèle d'IA."

#. module: bf_cx_ai
#: model:ir.model.fields,field_description:bf_cx_ai.field_bf_cx_feedback__ai_analyzed
