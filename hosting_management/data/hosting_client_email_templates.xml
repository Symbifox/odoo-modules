<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- 1. MOD&#200;LE POLYVALENT (G&#233;n&#233;rique)              -->
        <!-- Usage : Envoyer tout type de message client avec branding BF -->
        <!-- ctx : message_body (HTML libre)                              -->
        <!-- ============================================================ -->
        <record id="mail_template_client_generic" model="mail.template">
            <field name="name">Client: General-purpose template</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <!-- Rendu dans la langue du client : sans elle, celle de l'expéditeur. -->
            <field name="lang">{{ object.lang }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">{{ ctx.get('email_subject', 'Important information') }} - {{ object.company_id.name }}</field>
            <field name="body_html" type="html">


<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p t-attf-style="margin:0 0 20px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;line-height:28px;color:{{ brand_dark }};font-weight:500;">
                          Hello <t t-out="object.name or 'valued customer'"/>,
                        </p>

                        <!-- Contenu libre via ctx -->
                        <t t-out="ctx.get('message_body', '')"/>

                        <p style="margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;">
                          Feel free to contact us with any questions.
                        </p>
                        <p t-attf-style="margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:{{ brand_dark }};font-weight:400;">
                          Best regards,<br/>
                          <strong>The <t t-out="company.name or 'support'"/> team</strong>
                        </p>
            </field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>


        <!-- ============================================================ -->
        <!-- 2. RAPPORT MENSUEL CLIENT                                    -->
        <!-- ctx : services_count, uptime_rate, backups_ok,               -->
        <!--       updates_count, next_maintenance                        -->
        <!-- ============================================================ -->
        <record id="mail_template_client_monthly_report" model="mail.template">
            <field name="name">Client: Monthly report</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <!-- Rendu dans la langue du client : sans elle, celle de l'expéditeur. -->
            <field name="lang">{{ object.lang }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Monthly report for your services - {{ ctx.get('report_month', 'this month') }} - {{ object.company_id.name }}</field>
            <field name="body_html" type="html">


<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">Monthly report</p>
<p t-attf-style="margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;line-height:28px;color:{{ brand_dark }};font-weight:500;">
                          Hello <t t-out="object.name or 'valued customer'"/>,
                        </p>
                        <p style="margin:0 0 24px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;">
                          Here is the summary of your services for <strong><t t-out="ctx.get('report_month', 'last month')"/></strong>.
                        </p>

                        <!-- KPI Grid - 2x2 -->
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:24px;">
                          <tbody>
                            <tr>
                              <!-- Services actifs -->
                              <td width="48%" style="padding:16px;background-color:#F0F9FF;border-radius:12px;vertical-align:top;">
                                <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#0369A1;text-transform:uppercase;letter-spacing:0.5px;">
                                  Active services
                                </p>
                                <p t-attf-style="margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;">
                                  <t t-out="ctx.get('services_count', '-')"/>
                                </p>
                              </td>
                              <td width="4%">&amp;nbsp;</td>
                              <!-- Disponibilit&#233; -->
                              <td width="48%" style="padding:16px;background-color:#ECFDF5;border-radius:12px;vertical-align:top;">
                                <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#047857;text-transform:uppercase;letter-spacing:0.5px;">
                                  Uptime
                                </p>
                                <p t-attf-style="margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;">
                                  <t t-out="ctx.get('uptime_rate', '-')"/>
                                </p>
                              </td>
                            </tr>
                            <tr><td colspan="3" style="height:12px;">&amp;nbsp;</td></tr>
                            <tr>
                              <!-- Sauvegardes -->
                              <td width="48%" style="padding:16px;background-color:#F0FDF4;border-radius:12px;vertical-align:top;">
                                <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#15803D;text-transform:uppercase;letter-spacing:0.5px;">
                                  Successful backups
                                </p>
                                <p t-attf-style="margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;">
                                  <t t-out="ctx.get('backups_ok', '-')"/>
                                </p>
                              </td>
                              <td width="4%">&amp;nbsp;</td>
                              <!-- Mises &#224; jour -->
                              <td width="48%" style="padding:16px;background-color:#EFF6FF;border-radius:12px;vertical-align:top;">
                                <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#1D4ED8;text-transform:uppercase;letter-spacing:0.5px;">
                                  Updates applied
                                </p>
                                <p t-attf-style="margin:4px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:32px;font-weight:700;color:{{ brand_dark }};line-height:40px;">
                                  <t t-out="ctx.get('updates_count', '-')"/>
                                </p>
                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <!-- Prochaine maintenance -->
                        <t t-if="ctx.get('next_maintenance')">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:24px;">
                            <tbody>
                              <tr>
                                <td style="padding:16px 20px;background-color:#FFFBEB;border-radius:12px;border-left-width:4px; border-left-style:solid; border-left-color:#F59E0B;">
                                  <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#92400E;text-transform:uppercase;letter-spacing:0.5px;">
                                    Next scheduled maintenance
                                  </p>
                                  <p t-attf-style="margin:6px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};">
                                    <t t-out="ctx.get('next_maintenance')"/>
                                  </p>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                        </t>

                        <!-- Message additionnel via ctx -->
                        <t t-if="ctx.get('message_body')">
                          <t t-out="ctx.get('message_body')"/>
                        </t>

                        <p style="margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;">
                          If you have any questions about this report, feel free to contact us.
                        </p>
                        <p t-attf-style="margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:{{ brand_dark }};font-weight:400;">
                          Best regards,<br/>
                          <strong>The <t t-out="company.name or 'support'"/> team</strong>
                        </p>
            </field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>


        <!-- ============================================================ -->
        <!-- 3. NOTIFICATION DE MAINTENANCE PLANIFI&#201;E               -->
        <!-- ctx : maintenance_date, maintenance_duration,                -->
        <!--       affected_services, expected_impact, message_body       -->
        <!-- Accent bar : brand_primary (harmonisé avec les autres        -->
        <!-- templates client : générique, mensuel)                       -->
        <!-- ============================================================ -->
        <record id="mail_template_client_maintenance_notice" model="mail.template">
            <field name="name">Client: Maintenance notice</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <!-- Rendu dans la langue du client : sans elle, celle de l'expéditeur. -->
            <field name="lang">{{ object.lang }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Scheduled maintenance notice - {{ ctx.get('maintenance_date', '') }} - {{ object.company_id.name }}</field>
            <field name="body_html" type="html">


<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">Maintenance notice</p>
<p t-attf-style="margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;line-height:28px;color:{{ brand_dark }};font-weight:500;">
                          Hello <t t-out="object.name or 'valued customer'"/>,
                        </p>
                        <p style="margin:0 0 24px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;">
                          We would like to let you know that scheduled maintenance is planned for your services.
                        </p>

                        <!-- Maintenance details card -->
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:24px;border-radius:12px;border:1px solid #E5E7EB;background-color:#F9FAFB;">
                          <tbody>
                            <!-- Date & heure -->
                            <tr>
                              <td style="padding:20px 20px 0 20px;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                  <tbody>
                                    <tr>
                                      <td width="140" style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.5px;vertical-align:top;padding-top:2px;">
                                        Date and time
                                      </td>
                                      <td t-attf-style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};">
                                        <t t-out="ctx.get('maintenance_date', 'To be determined')"/>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                            <!-- Dur&#233;e estim&#233;e -->
                            <tr>
                              <td style="padding:12px 20px 0 20px;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                  <tbody>
                                    <tr>
                                      <td width="140" style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.5px;vertical-align:top;padding-top:2px;">
                                        Estimated duration
                                      </td>
                                      <td t-attf-style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};">
                                        <t t-out="ctx.get('maintenance_duration', 'To be determined')"/>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                            <!-- Services affect&#233;s -->
                            <tr>
                              <td style="padding:12px 20px 0 20px;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                  <tbody>
                                    <tr>
                                      <td width="140" style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.5px;vertical-align:top;padding-top:2px;">
                                        Affected services
                                      </td>
                                      <td t-attf-style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};">
                                        <t t-out="ctx.get('affected_services', 'All services')"/>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                            <!-- Impact attendu -->
                            <tr>
                              <td style="padding:12px 20px 20px 20px;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                  <tbody>
                                    <tr>
                                      <td width="140" style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.5px;vertical-align:top;padding-top:2px;">
                                        Expected impact
                                      </td>
                                      <td t-attf-style="font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:500;color:{{ brand_dark }};">
                                        <t t-out="ctx.get('expected_impact', 'Possible temporary interruption')"/>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <!-- Message additionnel via ctx -->
                        <t t-if="ctx.get('message_body')">
                          <t t-out="ctx.get('message_body')"/>
                        </t>

                        <!-- Lien de la page d'état : posé seulement quand la page du client est publiée. -->
                        <p t-if="ctx.get('status_url')" style="margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;">
                          Follow the status of your services, before and during the maintenance, on <a t-att-href="ctx.get('status_url')" t-attf-style="color:{{ brand_primary }};font-weight:500;">your status page</a>.
                        </p>

                        <p style="margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;">
                          We will do everything we can to minimize the impact on your operations. If you have any questions, feel free to reach out.
                        </p>
                        <p t-attf-style="margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:{{ brand_dark }};font-weight:400;">
                          Best regards,<br/>
                          <strong>The <t t-out="company.name or 'support'"/> team</strong>
                        </p>
            </field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>


        <!-- ============================================================ -->
        <!-- 4. RAPPORT D'INTERVENTION COMPL&#201;T&#201;E               -->
        <!-- ctx : intervention_summary, intervention_duration,           -->
        <!--       intervention_result, recommendations, message_body     -->
        <!-- Accent bar : verte #059669 (succ&#232;s)                     -->
        <!-- ============================================================ -->
        <record id="mail_template_client_intervention_report" model="mail.template">
            <field name="name">Client: Intervention report</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <!-- Rendu dans la langue du client : sans elle, celle de l'expéditeur. -->
            <field name="lang">{{ object.lang }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Completed intervention report - {{ object.company_id.name }}</field>
            <field name="body_html" type="html">


<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">Intervention completed</p>
<p t-attf-style="margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;line-height:28px;color:{{ brand_dark }};font-weight:500;">
                          Hello <t t-out="object.name or 'valued customer'"/>,
                        </p>
                        <p style="margin:0 0 24px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;">
                          We have completed an intervention on your services. Here is the summary.
                        </p>

                        <!-- Success badge -->
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:24px;">
                          <tbody>
                            <tr>
                              <td style="padding:16px 20px;background-color:#ECFDF5;border-radius:12px;border-left-width:4px; border-left-style:solid; border-left-color:#059669;">
                                <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:600;color:#059669;">
                                  &#10003; Intervention successful
                                </p>
                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <!-- Intervention details -->
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:24px;border-radius:12px;border:1px solid #E5E7EB;">
                          <tbody>
                            <!-- Ce qui a &#233;t&#233; fait -->
                            <tr>
                              <td style="padding:20px 20px 0 20px;">
                                <p style="margin:0 0 6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#059669;text-transform:uppercase;letter-spacing:0.5px;">
                                  Work performed
                                </p>
                                <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;line-height:24px;color:#374151;font-weight:300;">
                                  <t t-out="ctx.get('intervention_summary', 'Routine maintenance completed successfully.')"/>
                                </p>
                              </td>
                            </tr>
                            <!-- Dur&#233;e -->
                            <tr>
                              <td style="padding:16px 20px 0 20px;">
                                <p style="margin:0 0 6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#059669;text-transform:uppercase;letter-spacing:0.5px;">
                                  Duration
                                </p>
                                <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;line-height:24px;color:#374151;font-weight:300;">
                                  <t t-out="ctx.get('intervention_duration', 'Not specified')"/>
                                </p>
                              </td>
                            </tr>
                            <!-- R&#233;sultat -->
                            <tr>
                              <td style="padding:16px 20px 0 20px;">
                                <p style="margin:0 0 6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#059669;text-transform:uppercase;letter-spacing:0.5px;">
                                  Result
                                </p>
                                <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;line-height:24px;color:#374151;font-weight:300;">
                                  <t t-out="ctx.get('intervention_result', 'All services are operating normally.')"/>
                                </p>
                              </td>
                            </tr>
                            <!-- Recommandations -->
                            <t t-if="ctx.get('recommendations')">
                              <tr>
                                <td style="padding:16px 20px 20px 20px;">
                                  <p style="margin:0 0 6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#0369A1;text-transform:uppercase;letter-spacing:0.5px;">
                                    Recommendations
                                  </p>
                                  <p style="margin:0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;line-height:24px;color:#374151;font-weight:300;">
                                    <t t-out="ctx.get('recommendations')"/>
                                  </p>
                                </td>
                              </tr>
                            </t>
                            <t t-if="not ctx.get('recommendations')">
                              <tr>
                                <td style="padding:0 0 20px 0;">&amp;nbsp;</td>
                              </tr>
                            </t>
                          </tbody>
                        </table>

                        <!-- Message additionnel via ctx -->
                        <t t-if="ctx.get('message_body')">
                          <t t-out="ctx.get('message_body')"/>
                        </t>

                        <p style="margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#374151;font-weight:300;">
                          Feel free to contact us if you have any questions.
                        </p>
                        <p t-attf-style="margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:{{ brand_dark }};font-weight:400;">
                          Best regards,<br/>
                          <strong>The <t t-out="company.name or 'support'"/> team</strong>
                        </p>
            </field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>


        <!-- ============================================================ -->
        <!-- 5. BIENVENUE / ONBOARDING                                    -->
        <!-- ctx : activated_services, support_email, support_phone,      -->
        <!--       portal_url, message_body                               -->
        <!-- Design : Plus a&#233;r&#233;, gradient-like accent           -->
        <!-- ============================================================ -->
        <record id="mail_template_client_welcome" model="mail.template">
            <field name="name">Client: Welcome</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <!-- Rendu dans la langue du client : sans elle, celle de l'expéditeur. -->
            <field name="lang">{{ object.lang }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Welcome! Your services are ready</field>
            <field name="body_html" type="html">


<t t-set="company" t-value="(object.company_id if hasattr(object, 'company_id') and object.company_id else user.company_id)"/>
<t t-set="brand_primary" t-value="(company and company.report_brand_primary) or '#714B67'"/>
<t t-set="brand_dark" t-value="(company and company.report_brand_dark) or '#212529'"/>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6B7280;">Welcome!</p>
<p t-attf-style="margin:0 0 12px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:20px;line-height:30px;color:{{ brand_dark }};font-weight:500;">
                          Hello <t t-out="object.name or 'valued customer'"/>,
                        </p>
                        <p style="margin:0 0 28px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:28px;color:#374151;font-weight:300;">
                          We are delighted to welcome you as a customer. Your services are now active and ready to use. Here is everything you need to get started.
                        </p>

                        <!-- Services activ&#233;s -->
                        <t t-if="ctx.get('activated_services')">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:28px;">
                            <tbody>
                              <tr>
                                <td style="padding:20px;background-color:#F0F9FF;border-radius:12px;">
                                  <p style="margin:0 0 10px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#0369A1;text-transform:uppercase;letter-spacing:0.5px;">
                                    Your activated services
                                  </p>
                                  <t t-out="ctx.get('activated_services')"/>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                        </t>

                        <!-- Contact info card -->
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:28px;border-radius:12px;border:1px solid #E5E7EB;">
                          <tbody>
                            <tr>
                              <td style="padding:20px;">
                                <p t-attf-style="margin:0 0 12px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;font-weight:600;color:{{ brand_dark }};">
                                  How to reach us
                                </p>
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                  <tbody>
                                    <tr>
                                      <td style="padding:6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;color:#374151;font-weight:300;">
                                        Email:
                                        <a t-attf-href="mailto:{{ ctx.get('support_email') or company.email or '' }}" t-attf-style="color:{{ brand_primary }};text-decoration:none;font-weight:400;">
                                          <t t-out="ctx.get('support_email') or company.email or ''"/>
                                        </a>
                                      </td>
                                    </tr>
                                    <tr>
                                      <td style="padding:6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;color:#374151;font-weight:300;">
                                        Phone:
                                        <a t-attf-href="tel:{{ ctx.get('support_phone') or company.phone or '' }}" t-attf-style="color:{{ brand_primary }};text-decoration:none;font-weight:400;">
                                          <t t-out="ctx.get('support_phone') or company.phone or ''"/>
                                        </a>
                                      </td>
                                    </tr>
                                    <t t-if="ctx.get('portal_url')">
                                      <tr>
                                        <td style="padding:6px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:15px;color:#374151;font-weight:300;">
                                          Customer portal:
                                          <a t-attf-href="{{ ctx.get('portal_url') }}" t-attf-style="color:{{ brand_primary }};text-decoration:none;font-weight:400;">
                                            Go to the portal
                                          </a>
                                        </td>
                                      </tr>
                                    </t>
                                  </tbody>
                                </table>
                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <!-- CTA Button -->
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:28px;">
                          <tbody>
                            <tr>
                              <td align="center">
                                <a t-attf-href="{{ ctx.get('cta_url') or company.website or object.get_base_url() }}" t-attf-style="display:inline-block;padding:14px 36px;background-color:{{ brand_primary }};color:#ffffff;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:600;text-decoration:none;border-radius:10px;">
                                  Discover our services
                                </a>
                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <!-- Message additionnel via ctx -->
                        <t t-if="ctx.get('message_body')">
                          <t t-out="ctx.get('message_body')"/>
                        </t>

                        <p style="margin:24px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:28px;color:#374151;font-weight:300;">
                          We look forward to working with you. Feel free to contact us with any questions!
                        </p>
                        <p t-attf-style="margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:{{ brand_dark }};font-weight:400;">
                          Warm regards,<br/>
                          <strong>The <t t-out="company.name or 'support'"/> team</strong>
                        </p>
            </field>
            <field name="email_layout_xmlid">bf_onboarding_base.bf_mail_layout</field>
        </record>

    </data>
</odoo>
