<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_route" model="ir.module.category">
        <field name="name">Work routes</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_route_user" model="res.groups">
        <field name="name">Worker on the road</field>
        <field name="category_id" ref="module_category_route"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees and drives their own route days, from the phone or the office.</field>
    </record>

    <record id="group_route_manager" model="res.groups">
        <field name="name">Route manager</field>
        <field name="category_id" ref="module_category_route"/>
        <field name="implied_ids" eval="[(4, ref('group_route_user')), (4, ref('fleet.fleet_group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Builds the routes, plans the days, sees every day and the positions.</field>
    </record>

    <!-- ⚠️ fleet lets its plain users see only the vehicles they drive. A route manager
         picks any vehicle for a route: read all of them, write as fleet allows. -->
    <record id="rule_vehicle_route_manager" model="ir.rule">
        <field name="name">Vehicles: read all, for route managers</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Companies. -->
    <record id="rule_route_company" model="ir.rule">
        <field name="name">Routes: companies</field>
        <field name="model_id" ref="model_bf_route"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_route_stop_company" model="ir.rule">
        <field name="name">Route stops: companies</field>
        <field name="model_id" ref="model_bf_route_stop"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_day_company" model="ir.rule">
        <field name="name">Route days: companies</field>
        <field name="model_id" ref="model_bf_route_day"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_day_stop_company" model="ir.rule">
        <field name="name">Route day stops: companies</field>
        <field name="model_id" ref="model_bf_route_day_stop"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ⚠️ A worker sees their own days and the routes they drive; a manager sees everything. -->
    <record id="rule_route_worker" model="ir.rule">
        <field name="name">Routes: the ones I drive</field>
        <field name="model_id" ref="model_bf_route"/>
        <!-- ⚠️ Not "a day I once drove": a replacement for one day would keep reading the
             route's access instructions (door codes) for ever. The phone reads its own days. -->
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>
    <record id="rule_route_manager" model="ir.rule">
        <field name="name">Routes: all, for managers</field>
        <field name="model_id" ref="model_bf_route"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
    </record>
    <record id="rule_route_stop_worker" model="ir.rule">
        <field name="name">Route stops: the routes I drive</field>
        <field name="model_id" ref="model_bf_route_stop"/>
        <field name="domain_force">[('route_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>
    <record id="rule_route_stop_manager" model="ir.rule">
        <field name="name">Route stops: all, for managers</field>
        <field name="model_id" ref="model_bf_route_stop"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
    </record>
    <record id="rule_day_worker" model="ir.rule">
        <field name="name">Route days: mine</field>
        <field name="model_id" ref="model_bf_route_day"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>
    <record id="rule_day_manager" model="ir.rule">
        <field name="name">Route days: all, for managers</field>
        <field name="model_id" ref="model_bf_route_day"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
    </record>
    <record id="rule_day_stop_worker" model="ir.rule">
        <field name="name">Route day stops: mine</field>
        <field name="model_id" ref="model_bf_route_day_stop"/>
        <field name="domain_force">[('day_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>
    <record id="rule_day_stop_manager" model="ir.rule">
        <field name="name">Route day stops: all, for managers</field>
        <field name="model_id" ref="model_bf_route_day_stop"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
    </record>
    <record id="rule_notice_ack_worker" model="ir.rule">
        <field name="name">Position notice: mine</field>
        <field name="model_id" ref="model_bf_route_notice_ack"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>
    <record id="rule_notice_ack_manager" model="ir.rule">
        <field name="name">Position notice: all, for managers</field>
        <field name="model_id" ref="model_bf_route_notice_ack"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
    </record>
</odoo>
