<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="bf_softphone.Launcher">
        <div t-if="ui.visible" class="o_bf_softphone">
            <SoftphonePanel t-if="ui.open" close="() => this.togglePanel()"/>
            <button class="o_bf_sp_bubble" t-att-class="bubbleClass"
                    t-on-click="togglePanel"
                    t-att-title="state.ringing ? 'Appel entrant' : 'Téléphone'"
                    t-att-aria-label="state.ringing ? 'Appel entrant' : 'Téléphone'">
                <i class="fa" t-att-class="ui.open ? 'fa-chevron-down' : 'fa-phone'"/>
                <span t-if="state.ringing" class="o_bf_sp_bubble_dot"/>
                <span t-elif="state.status !== 'registered'"
                      class="o_bf_sp_bubble_dot o_bf_sp_bubble_dot--off"/>
            </button>
        </div>
    </t>

    <t t-name="bf_softphone.Panel">
        <div class="o_bf_softphone_panel shadow rounded" t-on-click.stop="">
            <!-- Bandeau d'appel -->
            <div class="o_bf_sp_header d-flex align-items-center justify-content-between p-2">
                <span t-if="state.status === 'registered'" class="text-success"><i class="fa fa-circle me-1"/>En ligne</span>
                <span t-elif="state.status === 'connecting'" class="text-warning"><i class="fa fa-circle me-1"/>Connexion…</span>
                <span t-elif="state.status === 'failed'" class="text-danger"><i class="fa fa-circle me-1"/>Échec</span>
                <span t-else="" class="text-muted">Hors ligne</span>
            </div>

            <!-- Appel entrant -->
            <div t-if="state.ringing" class="o_bf_sp_incall text-center p-3">
                <div class="fw-bold" t-esc="state.peerName || state.peerNumber"/>
                <div class="text-muted small" t-if="state.peerName" t-esc="state.peerNumber"/>
                <div class="mt-2">Appel entrant…</div>
                <div class="mt-3 d-flex gap-2 justify-content-center">
                    <button class="btn btn-success" t-on-click="answer"><i class="fa fa-phone"/> Répondre</button>
                    <button class="btn btn-danger" t-on-click="hangup"><i class="fa fa-times"/> Refuser</button>
                </div>
            </div>

            <!-- Appel en cours -->
            <div t-elif="state.inCall" class="o_bf_sp_incall text-center p-3">
                <div class="fw-bold o_bf_sp_peer" t-on-click="openPartner"
                     t-att-role="state.partnerId ? 'button' : ''"
                     t-esc="state.peerName || state.peerNumber"/>
                <div class="text-muted small" t-if="state.peerName" t-esc="state.peerNumber"/>
                <div class="mt-3 d-flex gap-2 justify-content-center">
                    <button class="btn btn-secondary" t-on-click="mute"
                            t-att-title="state.muted ? 'Réactiver le micro' : 'Couper le micro'">
                        <i t-att-class="state.muted ? 'fa fa-microphone-slash' : 'fa fa-microphone'"/>
                    </button>
                    <button class="btn btn-secondary" t-on-click="togglePad"
                            title="Clavier (menus téléphoniques)">
                        <i class="fa fa-th"/>
                    </button>
                    <button class="btn btn-danger" t-on-click="hangup"><i class="fa fa-phone"/> Raccrocher</button>
                </div>
                <!-- Clavier PENDANT l'appel : répondre à un menu vocal. Chaque
                     touche part en DTMF, elle n'écrit pas un nouveau numéro. -->
                <div t-if="local.padOpen" class="o_bf_sp_dtmf mt-3">
                    <div class="o_bf_sp_pad">
                        <t t-foreach="['1','2','3','4','5','6','7','8','9','*','0','#']" t-as="k" t-key="k">
                            <button class="btn btn-light o_bf_sp_key" t-on-click="() => this.press(k)" t-esc="k"/>
                        </t>
                    </div>
                    <div t-if="local.dtmf" class="text-muted small mt-2 text-center"
                         t-esc="'Envoyé : ' + local.dtmf"/>
                </div>
            </div>

            <!-- Composition -->
            <div t-else="" class="o_bf_sp_dial p-2">
                <input class="form-control o_bf_sp_input mb-2" t-model="local.dial"
                       t-on-input="onSearch" placeholder="Numéro ou nom…"/>
                <!-- Résultats de recherche -->
                <div t-if="local.results.length" class="o_bf_sp_results list-group mb-2">
                    <button t-foreach="local.results" t-as="c" t-key="c.id"
                            class="list-group-item list-group-item-action d-flex justify-content-between"
                            t-on-click="() => this.pickContact(c)">
                        <span t-esc="c.name"/><span class="text-muted small" t-esc="c.number"/>
                    </button>
                </div>
                <!-- Clavier -->
                <div class="o_bf_sp_pad">
                    <t t-foreach="['1','2','3','4','5','6','7','8','9','*','0','#']" t-as="k" t-key="k">
                        <button class="btn btn-light o_bf_sp_key" t-on-click="() => this.press(k)" t-esc="k"/>
                    </t>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-success flex-grow-1" t-on-click="call"><i class="fa fa-phone"/> Appeler</button>
                    <button class="btn btn-light" t-on-click="del"><i class="fa fa-long-arrow-left"/></button>
                </div>

                <!-- Historique -->
                <div t-if="local.history.length" class="o_bf_sp_history mt-3">
                    <div class="text-muted small mb-1">Récents</div>
                    <button t-foreach="local.history" t-as="h" t-key="h.id"
                            class="o_bf_sp_hrow d-flex justify-content-between align-items-center w-100 btn btn-sm btn-light mb-1"
                            t-on-click="() => this.callNumber(h.name)">
                        <span>
                            <i t-att-class="{
                                'fa fa-arrow-down text-success': h.type === 'incoming',
                                'fa fa-arrow-up text-primary': h.type === 'outgoing',
                                'fa fa-phone text-danger': h.type === 'missed',
                            }" class="me-1"/>
                            <t t-esc="h.name"/>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
