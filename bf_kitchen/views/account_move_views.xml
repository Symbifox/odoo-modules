<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_kitchen" model="ir.ui.view">
        <field name="name">account.move.form.kitchen</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="bf_kitchen_can_receive" invisible="1"/>
                <button name="action_bf_kitchen_receive" type="object" string="Received"
                        groups="bf_kitchen.group_kitchen_manager" invisible="not bf_kitchen_can_receive"
                        help="Brings the ingredients of this bill into stock today, once per line."/>
            </xpath>
        </field>
    </record>

    <record id="bf_kitchen_bill_line_view_list" model="ir.ui.view">
        <field name="name">account.move.line.list.bf_kitchen</field>
        <field name="model">account.move.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="invoice_date" string="Bill date"/>
                <field name="move_id" string="Bill"/>
                <field name="partner_id" string="Vendor"/>
                <field name="name" string="Line"/>
                <field name="quantity"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="price_unit"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="balance" string="Amount" sum="Total"/>
                <field name="bf_kitchen_product_id" string="Ingredient"/>
                <field name="bf_cost_issue" optional="show"/>
                <button name="action_bf_kitchen_attach" type="object" string="Attach" icon="fa-link"/>
                <button name="action_bf_kitchen_ignore" type="object" string="Not an ingredient" icon="fa-ban"
                        invisible="product_id"/>
                <field name="product_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="bf_kitchen_lines_to_attach_action" model="ir.actions.act_window">
        <field name="name">Lines to attach</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="bf_kitchen_bill_line_view_list"/>
        <field name="domain">[('move_id.move_type', '=', 'in_invoice'), ('parent_state', '=', 'posted'),
            ('display_type', '=', 'product'), ('product_id', '=', False), ('bf_ingredient_id', '=', False),
            ('bf_kitchen_ignore', '=', False), ('partner_id.commercial_partner_id.bf_food_supplier', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every food bill line is attached</p>
            <p>Lines with no product on the validated bills of your food suppliers come here. Attach each one to an ingredient once: its price becomes the ingredient cost, and the next bill from that supplier carries the product.</p>
        </field>
    </record>

    <record id="bf_kitchen_costs_to_check_action" model="ir.actions.act_window">
        <field name="name">Costs to check</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="bf_kitchen_bill_line_view_list"/>
        <field name="domain">[('bf_cost_issue', '!=', False), ('parent_state', '=', 'posted')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bill line is waiting</p>
            <p>A bill line whose unit cannot be brought back to the ingredient's stock unit lands here instead of blocking the validation. Give its format with Attach.</p>
        </field>
    </record>
</odoo>
