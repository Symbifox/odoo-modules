<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Trois échéances qui naissent du calendrier et non d'une écriture :
             la révision et la mise à jour du carnet, le renouvellement
             quinquennal de l'étude, et les 15 jours de l'attestation. Sans ces
             passages quotidiens, un délai dépassé se lirait « à jour » jusqu'à
             ce que quelqu'un rouvre la fiche. Même patron que les crons du
             socle, de la gouvernance et du volet financier. -->
        <record id="cron_log_refresh_schedule" model="ir.cron">
            <field name="name">Copropriété : échéances du carnet d'entretien</field>
            <field name="model_id" ref="model_bf_property_maintenance_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_schedule()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_study_refresh_schedule" model="ir.cron">
            <field name="name">Copropriété : échéance de l'étude du fonds</field>
            <field name="model_id" ref="model_bf_property_contingency_study"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_schedule()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_attestation_refresh_state" model="ir.cron">
            <field name="name">Copropriété : délai de 15 jours des attestations</field>
            <field name="model_id" ref="model_bf_property_attestation"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_syndicat_refresh_loi16" model="ir.cron">
            <field name="name">Copropriété : calendrier des échéances légales</field>
            <field name="model_id" ref="bf_property_core.model_bf_property_syndicat"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_loi16()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
