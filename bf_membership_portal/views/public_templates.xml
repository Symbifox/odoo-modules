<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="membership_signup" name="Membres : formulaire d'adhésion">
        <t t-call="portal.frontend_layout">
            <div class="container py-4" id="bf_membership_signup" style="max-width: 720px;">
                <h1>Devenir membre</h1>
                <p class="lead"><t t-out="company.name"/></p>
                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                <form action="/membres/adhesion" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <!-- Le champ piège : caché aux personnes, rempli par les robots. -->
                    <div class="d-none" aria-hidden="true">
                        <label for="website_url">Ne remplissez pas ce champ</label>
                        <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="type_id">Catégorie</label>
                        <select class="form-select" id="type_id" name="type_id" required="required">
                            <option t-foreach="types" t-as="mtype" t-att-value="mtype.id"
                                    t-att-selected="str(mtype.id) == values.get('type_id') or None">
                                <t t-out="mtype.name"/>
                                <t t-if="mtype.fee"> : <t t-out="mtype.currency_id.format(mtype.fee)"/></t>
                            </option>
                        </select>
                    </div>
                    <div t-if="any(mtype.member_kind == 'both' for mtype in types)" class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="is_company" name="is_company" value="1"
                               t-att-checked="values.get('is_company') or None"/>
                        <label class="form-check-label" for="is_company">J'adhère au nom d'une organisation</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="name">Nom (de la personne ou de l'organisation)</label>
                        <input type="text" class="form-control" id="name" name="name" required="required"
                               maxlength="200" t-att-value="values.get('name')"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="email">Courriel</label>
                        <input type="email" class="form-control" id="email" name="email" required="required"
                               maxlength="200" t-att-value="values.get('email')"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="phone">Téléphone</label>
                        <input type="tel" class="form-control" id="phone" name="phone" maxlength="200"
                               t-att-value="values.get('phone')"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="street">Adresse</label>
                        <input type="text" class="form-control" id="street" name="street" maxlength="200"
                               t-att-value="values.get('street')"/>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label" for="city">Ville</label>
                            <input type="text" class="form-control" id="city" name="city" maxlength="200"
                                   t-att-value="values.get('city')"/>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" for="zip">Code postal</label>
                            <input type="text" class="form-control" id="zip" name="zip" maxlength="200"
                                   t-att-value="values.get('zip')"/>
                        </div>
                    </div>

                    <!-- Loi 25, art. 9.1 : décochées d'office. -->
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="directory_consent" name="directory_consent"
                               value="1" t-att-checked="values.get('directory_consent') or None"/>
                        <label class="form-check-label" for="directory_consent">
                            J'accepte de paraître au répertoire des membres (nom et ville seulement).
                        </label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="notice_email_consent"
                               name="notice_email_consent" value="1"
                               t-att-checked="values.get('notice_email_consent') or None"/>
                        <label class="form-check-label" for="notice_email_consent">
                            J'accepte de recevoir par courriel les avis de convocation et les documents d'assemblée.
                        </label>
                    </div>
                    <p class="small text-muted">
                        Ces renseignements servent à tenir le registre des membres
                        (<t t-out="company.name"/>) et à communiquer avec vous au sujet de votre adhésion.
                        Vous pouvez changer vos choix en tout temps.
                    </p>
                    <button type="submit" class="btn btn-primary">Envoyer ma demande</button>
                </form>
            </div>
        </t>
    </template>

    <template id="membership_signup_done" name="Membres : demande reçue">
        <t t-call="portal.frontend_layout">
            <div class="container py-4" style="max-width: 720px;">
                <div id="bf_membership_signup_message">
                    <h1>Merci</h1>
                    <p>
                        Votre demande d'adhésion (<t t-out="company.name"/>) est reçue. L'organisme la
                        traitera et communiquera avec vous au besoin.
                    </p>
                </div>
                <div t-if="office_payment" id="bf_membership_signup_office" class="alert alert-info mt-3" role="status">
                    Le paiement en ligne n'est pas offert pour cette demande. Communiquez avec l'organisme
                    pour le paiement de la cotisation.
                </div>
                <div t-elif="can_pay" id="bf_membership_signup_payment" class="mt-3">
                    <p>Votre cotisation peut se payer en ligne dès maintenant.</p>
                    <form action="/membres/adhesion/payer" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-primary">Payer en ligne</button>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <template id="membership_directory" name="Membres : répertoire">
        <t t-call="portal.frontend_layout">
            <div class="container py-4" id="bf_membership_directory" style="max-width: 720px;">
                <h1>Répertoire des membres</h1>
                <p class="text-muted">
                    Les membres qui ont choisi d'y paraître (<t t-out="company.name"/>).
                </p>
                <table t-if="entries" class="table table-sm">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Ville</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="entries" t-as="entry">
                            <td t-out="entry['name']"/>
                            <td t-out="entry['city']"/>
                        </tr>
                    </tbody>
                </table>
                <p t-else="">Aucun membre ne paraît au répertoire pour l'instant.</p>
            </div>
        </t>
    </template>
</odoo>
