<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ⚠️ `active` est FAUX exprès. Un cron qui envoie des photos de
             reçus à un fournisseur tiers ne s'allume pas tout seul : c'est
             une décision de vie privée, elle se prend dans l'interface. -->
        <record id="ir_cron_expense_ocr_batch" model="ir.cron">
            <field name="name">Lecture des reçus : rattrapage</field>
            <field name="model_id" ref="hr_expense.model_hr_expense"/>
            <field name="state">code</field>
            <field name="code">model._cron_ocr_batch()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
