<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.celebrations</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Celebrations" string="Celebrations"
                     name="bf_celebrations"
                     groups="bf_celebrations.group_manager">
                    <block title="The reminder" name="celebrations_rappel">
                        <setting string="Tell people in advance"
                                 help="The number of days before the occasion when whoever organises gets their reminder.">
                            <field name="celebration_reminder_days"/>
                        </setting>
                        <setting string="Calendar horizon"
                                 help="How far ahead occasions are laid down.">
                            <field name="celebration_horizon_days"/>
                        </setting>
                        <setting string="Chase up a card that is too thin"
                                 help="An empty card is never delivered: it is held and whoever organises is told.">
                            <field name="celebration_thin_threshold"/>
                            <field name="celebration_thin_days"/>
                        </setting>
                    </block>
                    <block title="Retention" name="celebrations_conservation">
                        <setting string="Erase the delivered cards"
                                 help="0: keep everything. Otherwise, a card delivered more than N months ago is erased with its messages, its images and its attachments. The person celebrated received theirs as a PDF and as a keepsake page at delivery.">
                            <field name="celebration_retention_months"/>
                        </setting>
                        <setting string="Ceiling of invitations per send"
                                 help="Past that, sending to the signatories is refused rather than flooding the email queue.">
                            <field name="celebration_invite_cap"/>
                        </setting>
                    </block>
                    <block title="Sharing" name="celebrations_diffusion">
                        <setting string="Default organiser">
                            <field name="celebration_default_organizer_id"/>
                        </setting>
                        <setting string="Channel to announce the cards in"
                                 help="A link asleep in an email collects no signatures.">
                            <field name="celebration_discuss_channel_id"/>
                        </setting>
                        <setting string="Lay the celebrations down in the calendar"
                                 help="Off by default: a calendar entry goes out to phones and to CalDAV, beyond the reach of a removal made later. Only the people who accepted a card appear there.">
                            <field name="celebration_calendar_mirror"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
