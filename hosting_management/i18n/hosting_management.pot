#: model:mail.template,body_html:hosting_management.mail_template_hosting_digest
msgid ""
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#2E3132;\">\n"
"    <tbody>\n"
"        <tr>\n"
"            <td align=\"center\" style=\"padding:24px;\">\n"
"                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" align=\"center\" role=\"presentation\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td>\n"
"                                <br/>\n"
"                                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; border:1px solid #e5e7eb; border-collapse:collapse;\">\n"
"                                    <tbody>\n"
"                                        <!-- En-t&#234;te -->\n"
"                                        <tr>\n"
"                                            <td style=\"background-color:#22303B; padding:16px 24px; border-radius:12px 12px 0 0;\">\n"
"                                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                                    <tbody>\n"
"                                                        <tr>\n"
"                                                            <td align=\"left\" style=\"color:#FFFFFF; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:16px; font-weight:600;\">\n"
"                                                                <a href=\"https://bluefoxconsultant.com\" style=\"text-decoration:none;\">\n"
"                                                                    <img src=\"https://bluefoxconsultant.com/web/image/website/1/logo/Blue%20Fox?unique=803cc14\" alt=\"Blue Fox\" style=\"height:48px; width:auto; display:block; border:0;\"/>\n"
"                                                                </a>\n"
"                                                            </td>\n"
"                                                            <td align=\"right\" style=\"color:#E6EDF3; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:22px; font-weight:800; letter-spacing:0.2px;\">\n"
"                                                                Résumé des services\n"
"                                                            </td>\n"
"                                                        </tr>\n"
"                                                    </tbody>\n"
"                                                </table>\n"
"                                            </td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- Barre d'accentuation -->\n"
"                                        <tr>\n"
"                                            <td style=\"height:4px; line-height:4px; background-color:#29ABE2;\">&amp;nbsp;</td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- Contenu -->\n"
"                                        <tr>\n"
"                                            <td style=\"padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif;\">\n"
"                                                <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 16px 0;\">\n"
"                                                    Bonjour,\n"
"                                                </p>\n"
"                                                <p style=\"font-size:16px; line-height:26px; color:#374151; margin:0 0 20px 0;\">\n"
"                                                    Voici le résumé de vos services d'hébergement. Ce récapitulatif inclut les informations sur les services expirant, les mises à jour disponibles, les alertes de stockage et les problèmes de santé.\n"
"                                                </p>\n"
"                                                <p style=\"font-size:13px; line-height:20px; color:#6B7280; margin:16px 0 0 0;\">\n"
"                                                    Pour toute assistance, contactez-nous à\n"
"                                                    <a href=\"mailto:service@example.com\" style=\"color:#29abe2; text-decoration:none;\">service@example.com</a>\n"
"                                                    ou appelez le\n"
"                                                    <a href=\"tel:+15555555555\" style=\"color:#29abe2; text-decoration:none;\">555-555-5555</a>.\n"
"                                                </p>\n"
"                                            </td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- S&#233;parateur -->\n"
"                                        <tr>\n"
"                                            <td style=\"height:1px; line-height:1px; background-color:#E5E7EB;\">&amp;nbsp;</td>\n"
"                                        </tr>\n"
"\n"
"                                        <!-- Pied de page -->\n"
"                                        <tr>\n"
"                                            <td style=\"padding:16px 24px 24px 24px; background-color:#FFFFFF; border-radius:0 0 12px 12px;\">\n"
"                                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                                    <tbody>\n"
"                                                        <tr>\n"
"                                                            <td style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280;\">\n"
"                                                                <strong style=\"color:#22303B;\">Gestion d'hébergement par Blue Fox</strong><br/>\n"
"                                                                Solutions éthiques et souveraines pour vos données.\n"
"                                                            </td>\n"
"                                                            <td align=\"right\" style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#9CA3AF;\">\n"
"                                                                <a href=\"https://bluefoxconsultant.com/r/politique-de-confidentialite\" style=\"color:#9CA3AF; text-decoration:underline;\">Politique de confidentialité</a>\n"
"                                                                <span style=\"color:#9CA3AF;\"> | </span>\n"
"                                                                <a href=\"https://bluefoxconsultant.com/r/termes-et-conditions\" style=\"color:#9CA3AF; text-decoration:underline;\">Conditions</a>\n"
"                                                            </td>\n"
"                                                        </tr>\n"
"                                                    </tbody>\n"
"                                                </table>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </tbody>\n"
"                                </table>\n"
"\n"
"                                <!-- Barre d'accentuation inf&#233;rieure -->\n"
"                                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:12px auto 0;\">\n"
"                                    <tbody>\n"
"                                        <tr>\n"
"                                            <td style=\"height:3px; line-height:3px; background-color:#29abe2; width:50%;\">&amp;nbsp;</td>\n"
"                                            <td style=\"height:3px; line-height:3px; background-color:#22303b; width:50%;\">&amp;nbsp;</td>\n"
"                                        </tr>\n"
"                                    </tbody>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </td>\n"
"        </tr>\n"
"    </tbody>\n"
"</table>\n"
"        "
msgstr ""

#. module: hosting_management
#: model:mail.template,body_html:hosting_management.email_template_backup_report
msgid ""
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#2E3132;\">\n"
"  <tbody>\n"
"    <tr>\n"
"      <td align=\"center\" style=\"padding:24px;\">\n"
"        <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" align=\"center\" role=\"presentation\">\n"
"          <tbody>\n"
"            <tr>\n"
"              <td>\n"
"                <br/><br/>\n"
"                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"700\" style=\"margin:0 auto;background-color:#ffffff;border-radius:12px;border:1px solid #e5e7eb;max-width:700px;\">\n"
"                  <tbody>\n"
"                    <!-- Header -->\n"
"                    <tr>\n"
"                      <td style=\"background-color:#22303B;padding:16px 24px;border-radius:12px 12px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td align=\"left\" style=\"color:#FFFFFF;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;font-weight:600;\">\n"
"                                <a href=\"https://bluefoxconsultant.com\" style=\"text-decoration:none;\">\n"
"                                  <img src=\"https://bluefoxconsultant.com/web/image/website/1/logo/Blue%20Fox?unique=803cc14\" alt=\"Blue Fox\" style=\"height:48px;width:auto;display:block;\" height=\"48\"/>\n"
"                                </a>\n"
"                              </td>\n"
"                              <td align=\"right\" style=\"color:#E6EDF3;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:22px;font-weight:800;\">\n"
"                                Rapport de sauvegarde\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"                      </td>\n"
"                    </tr>\n"
"\n"
"                    <!-- Accent bar -->\n"
"                    <tr>\n"
"                      <td style=\"height:4px;line-height:4px;background-color:#29ABE2;\">&amp;nbsp;</td>\n"
"                    </tr>\n"
"\n"
"                    <!-- Content -->\n"
"                    <tr>\n"
"                      <td style=\"padding:24px;\">\n"
"                        <h1 style=\"margin:0 0 8px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:24px;line-height:32px;color:#22303B;font-weight:500;\">\n"
"                          Rapport quotidien des sauvegardes\n"
"                        </h1>\n"
"                        <p style=\"margin:0 0 16px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:17px;line-height:26px;color:#374151;font-weight:300;\">\n"
"                          Exécuté le <t t-out=\"object.run_date.strftime('%Y-%m-%d %H:%M:%S')\"/> sur <t t-out=\"object.hostname or 'serveur inconnu'\"/>\n"
"                        </p>\n"
"\n"
"                        <!-- Status summary -->\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-radius:10px;margin-bottom:20px;\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td t-attf-style=\"padding:16px;border-radius:10px;border:1px solid {{ '#FECACA' if object.state == 'failed' else '#FDE68A' if object.state == 'partial' else '#A7F3D0' }};background-color:{{ '#FEE2E2' if object.state == 'failed' else '#FEF3C7' if object.state == 'partial' else '#D1FAE5' }};\">\n"
"                                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                                  <tbody>\n"
"                                    <tr>\n"
"                                      <td t-attf-style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:18px;font-weight:600;color:{{ '#DC2626' if object.state == 'failed' else '#D97706' if object.state == 'partial' else '#059669' }};\">\n"
"                                        <t t-if=\"object.state == 'failed'\">ERREURS DÉTECTÉES</t>\n"
"                                        <t t-elif=\"object.state == 'partial'\">COMPLÉTÉ AVEC AVERTISSEMENTS</t>\n"
"                                        <t t-else=\"\">TOUS LES BACKUPS RÉUSSIS</t>\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                      <td style=\"padding-top:8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;color:#374151;\">\n"
"                                        <strong style=\"color:#059669;\"><t t-out=\"object.success_count\"/></strong> réussis |\n"
"                                        <strong style=\"color:#DC2626;\"><t t-out=\"object.failed_count\"/></strong> échoués |\n"
"                                        <strong style=\"color:#D97706;\"><t t-out=\"object.skipped_count\"/></strong> ignorés |\n"
"                                        <strong><t t-out=\"object.total_count\"/></strong> total\n"
"                                      </td>\n"
"                                    </tr>\n"
"                                  </tbody>\n"
"                                </table>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <!-- Backup details table -->\n"
"                        <h2 style=\"margin:24px 0 12px 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:16px;color:#22303B;font-weight:500;\">\n"
"                          Détails des sauvegardes\n"
"                        </h2>\n"
"                        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border:1px solid #E5E7EB;border-radius:8px;border-collapse:separate;\">\n"
"                          <thead>\n"
"                            <tr style=\"background-color:#F9FAFB;\">\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Service</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Statut</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Fichiers</th>\n"
"                              <th style=\"padding:12px 8px;text-align:left;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;border-bottom:1px solid #E5E7EB;\">Durée</th>\n"
"                            </tr>\n"
"                          </thead>\n"
"                          <tbody>\n"
"                            <t t-foreach=\"object.line_ids\" t-as=\"line\">\n"
"                              <tr style=\"border-bottom:1px solid #E5E7EB;\">\n"
"                                <td style=\"padding:12px 8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:14px;font-weight:600;color:#22303B;vertical-align:top;\">\n"
"                                  <t t-out=\"line.service_name\"/>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;vertical-align:top;\">\n"
"                                  <span t-attf-style=\"display:inline-block;padding:4px 8px;border-radius:4px;font-size:12px;font-weight:600;background-color:{{ '#D1FAE5' if line.status == 'success' else '#FEE2E2' if line.status == 'failed' else '#FEF3C7' }};color:{{ '#059669' if line.status == 'success' else '#DC2626' if line.status == 'failed' else '#D97706' }};\">\n"
"                                    <t t-if=\"line.status == 'success'\">OK</t>\n"
"                                    <t t-elif=\"line.status == 'failed'\">ÉCHEC</t>\n"
"                                    <t t-else=\"\">IGNORÉ</t>\n"
"                                  </span>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;vertical-align:top;\">\n"
"                                  <t t-foreach=\"line.file_ids\" t-as=\"file\">\n"
"                                    <div style=\"font-size:12px;color:#374151;margin-top:4px;\">\n"
"                                      <span t-attf-style=\"color:{{ '#059669' if file.verified else '#DC2626' }};font-weight:bold;\">\n"
"                                        <t t-if=\"file.verified\">✓</t>\n"
"                                        <t t-else=\"\">✗</t>\n"
"                                      </span>\n"
"                                      <t t-out=\"file.name\"/><br/>\n"
"                                      <span style=\"color:#9CA3AF;font-size:11px;\">\n"
"                                        SHA256: <t t-out=\"(file.checksum or '')[:16]\"/>... | Taille: <t t-out=\"file.size\"/>\n"
"                                      </span>\n"
"                                    </div>\n"
"                                  </t>\n"
"                                  <t t-if=\"not line.file_ids\">\n"
"                                    <span style=\"color:#9CA3AF;font-size:12px;\">Aucun fichier</span>\n"
"                                  </t>\n"
"                                  <t t-if=\"line.error_message\">\n"
"                                    <div style=\"color:#DC2626;font-size:12px;margin-top:4px;\">\n"
"                                      <t t-out=\"line.error_message\"/>\n"
"                                    </div>\n"
"                                  </t>\n"
"                                </td>\n"
"                                <td style=\"padding:12px 8px;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#6B7280;vertical-align:top;\">\n"
"                                  <t t-out=\"line.duration\"/>\n"
"                                </td>\n"
"                              </tr>\n"
"                            </t>\n"
"                          </tbody>\n"
"                        </table>\n"
"\n"
"                        <p style=\"margin:16px 0 0 0;font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:13px;line-height:20px;color:#6B7280;\">\n"
"                          En cas de problème, contactez\n"
"                          <a href=\"mailto:service@example.com\" style=\"color:#29abe2;text-decoration:none;\">service@example.com</a>\n"
"                        </p>\n"
"                      </td>\n"
"                    </tr>\n"
"\n"
"                    <!-- Divider -->\n"
"                    <tr>\n"
"                      <td style=\"height:1px;line-height:1px;background-color:#E5E7EB;\">&amp;nbsp;</td>\n"
"                    </tr>\n"
"\n"
"                    <!-- Footer -->\n"
"                    <tr>\n"
"                      <td style=\"padding:16px 24px 24px 24px;background-color:#FFFFFF;border-radius:0 0 12px 12px;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"                          <tbody>\n"
"                            <tr>\n"
"                              <td style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#6B7280;\">\n"
"                                <strong style=\"color:#22303B;\">Votre hébergeur</strong><br/>\n"
"                                Solutions éthiques et souveraines pour vos données.\n"
"                              </td>\n"
"                              <td align=\"right\" style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif;font-size:12px;color:#9CA3AF;\">\n"
"                                <a href=\"https://bluefoxconsultant.com/r/politique-de-confidentialite\" style=\"color:#9ca3af;text-decoration:underline;\">Politique de confidentialité</a>\n"
"                                <span style=\"color:#9CA3AF;\"> | </span>\n"
"                                <a href=\"https://bluefoxconsultant.com/r/termes-et-conditions\" style=\"color:#9ca3af;text-decoration:underline;\">Termes et conditions</a>\n"
"                              </td>\n"
"                            </tr>\n"
"                          </tbody>\n"
"                        </table>\n"
"                      </td>\n"
"                    </tr>\n"
"                  </tbody>\n"
"                </table>\n"
"\n"
"                <!-- Bottom accent -->\n"
"                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"700\" style=\"margin:12px auto 0;\">\n"
"                  <tbody>\n"
"                    <tr>\n"
"                      <td style=\"height:3px;line-height:3px;background-color:#29abe2;width:50%;\">&amp;nbsp;</td>\n"
"                      <td style=\"height:3px;line-height:3px;background-color:#22303b;width:50%;\">&amp;nbsp;</td>\n"
"                    </tr>\n"
"                  </tbody>\n"
"                </table>\n"
"\n"
"              </td>\n"
"            </tr>\n"
"          </tbody>\n"
"        </table>\n"
"      </td>\n"
"    </tr>\n"
"  </tbody>\n"
"</table>\n"
"            "
msgstr ""

#. module: hosting_management
#: model:mail.template,body_html:hosting_management.mail_template_client_welcome
msgid ""
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#F8FAFC;\">\n"
"  <tbody>\n"
"    <tr>\n"
"      <td align=\"center\" style=\"padding:32px 16px;\">\n"
"        <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" align=\"center\" role=\"presentation\">\n"
"          <tbody>\n"
"            <tr>\n"
"              <td>\n"
"                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px;max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,0.08);\">\n"
"                  <tbody>\n"
