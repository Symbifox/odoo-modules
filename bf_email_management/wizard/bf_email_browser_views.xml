<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bf_email_browser_view_form" model="ir.ui.view">
        <field name="name">bf.email.browser.form</field>
        <field name="model">bf.email.browser</field>
        <field name="arch" type="xml">
            <form string="Navigateur IMAP" create="false" delete="false">
                <header>
                    <button name="action_load_page"
                            string="Charger / rafraîchir"
                            type="object"
                            class="btn-primary"
                            icon="fa-folder-open-o"/>
                    <button name="action_refresh_folder_list"
                            string="Lister les dossiers"
                            type="object"
                            icon="fa-list-ul"/>
                    <button name="action_prev_page"
                            string="◀ Précédent"
                            type="object"
                            invisible="page_offset == 0"/>
                    <button name="action_next_page"
                            string="Suivant ▶"
                            type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Navigateur IMAP — <field name="folder" readonly="1" class="oe_inline"/></h1>
                        <div class="text-muted">
                            Lecture seule. Tapez un dossier dans <em>Dossier</em>, cliquez <strong>Charger</strong>.
                            Pour ingérer un message dans Odoo, utilisez le bouton <em>Ingérer</em> sur la ligne.
                        </div>
                    </div>
                    <group>
                        <group string="Dossier à explorer">
                            <field name="account_id"/>
                            <field name="folder" placeholder="INBOX, Archives/2026, Trash, Junk…"/>
                            <field name="folder_message_count" readonly="1" string="Total dans ce dossier"/>
                            <field name="page_offset" string="Position"/>
                            <field name="page_size" string="Messages par page"/>
                        </group>
                        <group string="Dossiers IMAP disponibles">
                            <field name="available_folders" nolabel="1" readonly="1"
                                   widget="text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="date" widget="datetime"/>
                                    <field name="email_from"/>
                                    <field name="subject"/>
                                    <field name="already_in_bf_email" widget="boolean_toggle"/>
                                    <button name="action_preview"
                                            type="object"
                                            string="Aperçu"
                                            icon="fa-eye"/>
                                    <button name="action_ingest"
                                            type="object"
                                            string="Ingérer"
                                            icon="fa-sign-in"
                                            invisible="already_in_bf_email"/>
                                    <button name="action_ingest_and_reroute"
                                            type="object"
                                            string="Ingérer + router"
                                            icon="fa-share"
                                            invisible="already_in_bf_email"/>
                                    <field name="uid" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Aperçu" name="preview" invisible="not preview_uid">
                            <group>
                                <group>
                                    <field name="preview_subject" readonly="1"/>
                                    <field name="preview_from" readonly="1"/>
                                    <field name="preview_to" readonly="1"/>
                                </group>
                                <group>
                                    <field name="preview_date" readonly="1"/>
                                    <field name="preview_uid" readonly="1"/>
                                    <field name="preview_already_ingested" readonly="1"/>
                                    <field name="preview_bf_email_id" readonly="1"
                                           invisible="not preview_already_ingested"/>
                                </group>
                            </group>
                            <separator string="Corps"/>
                            <field name="preview_body_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Primary action: the two-pane OWL mail-client view (new xml_id; the
         legacy ``action_bf_email_browser`` retains its act_window model to
         keep upgrade transitions painless — Odoo refuses to switch models
         on an existing xml_id). -->
    <record id="action_bf_email_browser_owl" model="ir.actions.client">
        <field name="name">Navigateur IMAP</field>
        <field name="tag">bf_email_browser</field>
    </record>

    <!-- Legacy TransientModel form (kept reachable via Settings → Technical
         → Actions for IMAP debugging). Menu now points at the OWL action. -->
    <record id="action_bf_email_browser" model="ir.actions.act_window">
        <field name="name">Navigateur IMAP (diagnostic)</field>
        <field name="res_model">bf.email.browser</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
