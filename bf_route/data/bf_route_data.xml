<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_route_watch" model="ir.cron">
        <field name="name">Routes: create the days ahead, alert, erase old positions</field>
        <field name="model_id" ref="bf_route.model_bf_route"/>
        <field name="state">code</field>
        <field name="code">model._cron_watch()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
