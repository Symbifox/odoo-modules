<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bf.cx.hosting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bf_cx.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='bf_cx_loop_block']" position="inside">
                <setting string="Feedback après maintenance (hébergement)"
                         help="Quand une maintenance planifiée touchant un service client est marquée faite, demander un feedback à 3 émojis au client du service (une fois par planification, garde-fou anti-sursollicitation appliqué, partenaires internes exclus).">
                    <field name="bf_cx_hosting_feedback"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
