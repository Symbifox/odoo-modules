#. module: bf_planogram_floorplan
#: model:ir.model.fields,help:bf_planogram_floorplan.field_bf_planogram_fixture__floorplan_element_id
msgid ""
"The shape of the store plan this fixture stands on. A shape can carry "
"several fixtures (a wall run split in sections); a fixture stands in one "
"place."
msgstr "La forme du plan du magasin sur laquelle ce meuble est posé. Une forme peut porter plusieurs meubles (un mur de rayonnage découpé en sections) ; un meuble est posé à un seul endroit."

#. module: bf_planogram_floorplan
#. odoo-python
#: code:addons/bf_planogram_floorplan/models/element.py:0
msgid "a shelf holds more than it has"
msgstr "une tablette porte plus qu'elle n'en a"

#. module: bf_planogram_floorplan
#. odoo-python
#: code:addons/bf_planogram_floorplan/models/element.py:0
msgid "nothing on the shelves yet"
msgstr "rien en tablette pour l'instant"

#. module: bf_planogram_floorplan
#. odoo-python
#: code:addons/bf_planogram_floorplan/models/fixture.py:0
msgid ""
"« %(fixture)s » belongs to %(store)s and the plan « %(plan)s » to %(other)s:"
" a fixture stands on the plan of its own store."
msgstr "« %(fixture)s » appartient à %(store)s et le plan « %(plan)s » à %(other)s : un meuble est posé sur le plan de son propre commerce."

#. module: bf_planogram_floorplan
#. odoo-python
#: code:addons/bf_planogram_floorplan/models/fixture.py:0
