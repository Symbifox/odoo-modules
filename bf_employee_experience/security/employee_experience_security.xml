<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
          Aucun groupe neuf. `hr` en pose déjà deux qui décrivent exactement les
          rôles dont ce module a besoin :
            * hr.group_hr_user    : l'administration des avantages. Cette
                                    personne voit déjà les dossiers d'employés.
            * hr.group_hr_manager : le contrôle complet, y compris la suppression.
          Tout le personnel (base.group_user) voit le catalogue et ce qui le
          concerne, jamais le registre nominatif des autres.

          La conception écarte le gestionnaire direct de la lecture du
          registre d'usage : ces règles ne lui accordent donc rien.
        -->

        <!-- ============ Catalogue : visible de tout le personnel ============ -->

        <record id="rule_benefit_company" model="ir.rule">
            <field name="name">Avantage : société</field>
            <field name="model_id" ref="model_bf_ex_benefit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ============ Droits ============ -->

        <record id="rule_entitlement_own" model="ir.rule">
            <field name="name">Droit : je ne vois que le mien</field>
            <field name="model_id" ref="model_bf_ex_entitlement"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_entitlement_hr" model="ir.rule">
            <field name="name">Droit : l'administration des avantages voit tout</field>
            <field name="model_id" ref="model_bf_ex_entitlement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_entitlement_company" model="ir.rule">
            <field name="name">Droit : société</field>
            <field name="model_id" ref="model_bf_ex_entitlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ============ Usage : la moitié sensible du module ============ -->

        <!--
          ⚠️ Savoir qui a pris quoi en dit long : aide aux employés, assurance,
          congé de maladie. Le registre nominatif se lit par la personne
          concernée et par l'administration des avantages. Personne d'autre.
        -->
        <record id="rule_usage_own" model="ir.rule">
            <field name="name">Usage : je ne vois que le mien</field>
            <field name="model_id" ref="model_bf_ex_usage"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_usage_hr" model="ir.rule">
            <field name="name">Usage : l'administration des avantages voit tout</field>
            <field name="model_id" ref="model_bf_ex_usage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_usage_company" model="ir.rule">
            <field name="name">Usage : société</field>
            <field name="model_id" ref="model_bf_ex_usage"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ============ Demandes ============ -->

        <record id="rule_claim_own" model="ir.rule">
            <field name="name">Demande : la mienne</field>
            <field name="model_id" ref="model_bf_ex_claim"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_claim_hr" model="ir.rule">
            <field name="name">Demande : l'administration des avantages voit tout</field>
            <field name="model_id" ref="model_bf_ex_claim"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_claim_company" model="ir.rule">
            <field name="name">Demande : société</field>
            <field name="model_id" ref="model_bf_ex_claim"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ============ Indicateurs ============ -->

        <record id="rule_indicator_company" model="ir.rule">
            <field name="name">Indicateur : société</field>
            <field name="model_id" ref="model_bf_ex_indicator"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
