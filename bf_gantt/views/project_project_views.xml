<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_form_bf_gantt" model="ir.ui.view">
        <field name="name">project.project.form.bf.gantt</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_bf_gantt" type="object"
                        class="oe_stat_button" icon="fa-bar-chart">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Timeline</span>
                    </div>
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page string="Timeline" name="bf_gantt">
                    <group>
                        <group string="Display">
                            <field name="bf_gantt_grouping"/>
                        </group>
                        <group string="Portal" groups="bf_gantt.group_bf_gantt_manager">
                            <field name="bf_gantt_published"/>
                            <field name="access_url" widget="url" readonly="1"
                                   string="Address" invisible="not bf_gantt_published"/>
                        </group>
                    </group>
                    <div groups="bf_gantt.group_bf_gantt_manager">
                        <button name="action_bf_gantt_publier" type="object"
                                string="Publish on the portal" class="btn-primary"
                                invisible="bf_gantt_published"/>
                        <button name="action_bf_gantt_depublier" type="object"
                                string="Remove from the portal" class="btn-secondary"
                                invisible="not bf_gantt_published"/>
                        <button name="action_bf_gantt_copier_lien" type="object"
                                string="Show the full address" class="btn-link"
                                invisible="not bf_gantt_published"/>
                        <button name="action_bf_gantt_regenerer_token" type="object"
                                string="Regenerate the token" class="btn-link"
                                confirm="Addresses already handed out will stop working. Continue?"/>
                    </div>
                    <div class="text-muted mt-3">
                        Publishing opens a read-only page, with no account and no seat. It shows the task names, their dates and their assignees: review it before giving it to a wide audience.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
