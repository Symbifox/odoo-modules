#. module: bf_appointment_visit
#: model:mail.template,body_html:bf_appointment_visit.mail_visit_tenant_notice
msgid ""
"<t t-set=\"contenu\">\n"
"                    <p>Bonjour <t t-out=\"object.listing_id.tenant_id.name or ''\"/>,</p>\n"
"                    <p>\n"
"                        Le logement que vous occupez sera visité le\n"
"                        <strong t-out=\"format_datetime(object.start, tz=object.listing_id.tz_name, dt_format='EEEE d MMMM y, HH:mm')\"/>,\n"
"                        pour une durée d'environ <t t-out=\"int((object.duration or 0.5) * 60)\"/> minutes.\n"
"                    </p>\n"
"                    <p>\n"
"                        Cet avis vous est donné au moins 24 heures à l'avance, et la visite a lieu entre\n"
"                        9 h et 21 h, comme l'exige l'article 1931 du Code civil du Québec.\n"
"                    </p>\n"
"                    <p t-if=\"object.listing_id.tenant_wants_presence\">\n"
"                        Vous avez demandé la présence du locateur pendant les visites : elle est prévue.\n"
"                    </p>\n"
"                    <p style=\"color:#6b7280; font-size:13px;\">\n"
"                        Si ce moment ne convient pas, répondez à ce courriel.\n"
"                    </p>\n"
"                </t>\n"
"                <t t-call=\"bf_appointment_visit.visit_email_layout\"/>\n"
"            "
msgstr ""

#. module: bf_appointment_visit
#: model:mail.template,body_html:bf_appointment_visit.mail_visit_declined
msgid ""
"<t t-set=\"contenu\">\n"
"                    <p>Bonjour <t t-out=\"object.visitor_name or ''\"/>,</p>\n"
"                    <p>\n"
"                        L'heure demandée pour visiter le <strong t-out=\"object.listing_id.name\"/> ne peut pas être retenue.\n"
"                    </p>\n"
"                    <p t-if=\"object.proposed_start\">\n"
"                        Une autre heure vous est proposée :\n"
"                        <strong t-out=\"format_datetime(object.proposed_start, tz=object.listing_id.tz_name, dt_format='EEEE d MMMM y, HH:mm')\"/>.\n"
"                        Répondez à ce courriel si elle vous convient.\n"
"                    </p>\n"
"                    <p t-if=\"object.seller_note\" t-out=\"object.seller_note\"/>\n"
"                    <p t-if=\"not object.proposed_start\">\n"
"                        Les autres créneaux offerts restent disponibles sur la page de réservation.\n"
"                    </p>\n"
"                </t>\n"
"                <t t-call=\"bf_appointment_visit.visit_email_layout\"/>\n"
"            "
msgstr ""

#. module: bf_appointment_visit
#: model:mail.template,body_html:bf_appointment_visit.mail_visit_feedback_request
msgid ""
"<t t-set=\"contenu\">\n"
"                    <p>Bonjour <t t-out=\"object.visitor_name or ''\"/>,</p>\n"
"                    <p>\n"
"                        Merci d'être passé visiter le <strong t-out=\"object.listing_id.name\"/>.\n"
"                        Deux questions, trente secondes, et le vendeur saura où il en est.\n"
"                    </p>\n"
"                </t>\n"
"                <t t-set=\"bouton_url\" t-value=\"object.url_feedback\"/>\n"
"                <t t-set=\"bouton_texte\">Donner mon impression</t>\n"
"                <t t-call=\"bf_appointment_visit.visit_email_layout\"/>\n"
"            "
msgstr ""

#. module: bf_appointment_visit
#: model:mail.template,body_html:bf_appointment_visit.mail_visit_pending
msgid ""
"<t t-set=\"contenu\">\n"
"                    <p>Bonjour <t t-out=\"object.visitor_name or ''\"/>,</p>\n"
"                    <p>\n"
"                        Votre demande de visite du <strong t-out=\"object.listing_id.name\"/>\n"
"                        le <strong t-out=\"format_datetime(object.start, tz=object.listing_id.tz_name, dt_format='EEEE d MMMM y, HH:mm')\"/>\n"
"                        est transmise pour approbation.\n"
"                    </p>\n"
"                    <p>Le créneau vous est réservé le temps de la réponse. Vous recevrez un courriel dès qu'elle est donnée.</p>\n"
"                    <p t-if=\"object.listing_id.occupancy == 'tenant'\">\n"
"                        Le logement est occupé : la visite est annoncée au locataire au moins 24 heures d'avance.\n"
"                    </p>\n"
"                </t>\n"
"                <t t-call=\"bf_appointment_visit.visit_email_layout\"/>\n"
"            "
msgstr ""

#. module: bf_appointment_visit
#: model:mail.template,body_html:bf_appointment_visit.mail_visit_approved
msgid ""
"<t t-set=\"contenu\">\n"
"                    <p>Bonjour <t t-out=\"object.visitor_name or ''\"/>,</p>\n"
"                    <p>\n"
"                        Votre visite du <strong t-out=\"object.listing_id.name\"/> est confirmée pour le\n"
"                        <strong t-out=\"format_datetime(object.start, tz=object.listing_id.tz_name, dt_format='EEEE d MMMM y, HH:mm')\"/>.\n"
"                    </p>\n"
"                    <div t-if=\"object.listing_id.showing_instructions\">\n"
"                        <p style=\"margin-bottom:4px;\"><strong>Avant de venir</strong></p>\n"
"                        <div t-out=\"object.listing_id.showing_instructions\"/>\n"
"                    </div>\n"
"                    <div t-if=\"object.access_released and object.listing_id.access_instructions\" style=\"margin-top:14px; padding:12px 14px; background:#F4F8FB; border-left:4px solid #29ABE1;\">\n"
"                        <p style=\"margin:0 0 4px 0;\"><strong>Accès</strong></p>\n"
"                        <div t-out=\"object.listing_id.access_instructions\"/>\n"
"                    </div>\n"
"                    <p t-if=\"object.listing_id.require_identity\" style=\"margin-top:14px; color:#6b7280; font-size:13px;\">\n"
"                        Une pièce d'identité vous sera demandée à l'arrivée. Rien n'en est photocopié ni conservé.\n"
"                    </p>\n"
"                </t>\n"
"                <t t-call=\"bf_appointment_visit.visit_email_layout\"/>\n"
"            "
msgstr ""

#. module: bf_appointment_visit
#: model:mail.template,body_html:bf_appointment_visit.mail_visit_seller_request
msgid ""
"<t t-set=\"contenu\">\n"
"                    <p>Bonjour,</p>\n"
"                    <p>\n"
"                        Une visite du <strong t-out=\"object.listing_id.name\"/> est demandée pour le\n"
"                        <strong t-out=\"format_datetime(object.start, tz=object.listing_id.tz_name, dt_format='EEEE d MMMM y, HH:mm')\"/>.\n"
"                    </p>\n"
"                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:12px 0; font-size:14px;\">\n"
"                        <tbody>\n"
"                            <tr>\n"
"                                <td style=\"padding:3px 14px 3px 0; color:#6b7280;\">Personnes attendues</td>\n"
"                                <td style=\"padding:3px 0;\"><t t-out=\"object.visitor_count or 1\"/></td>\n"
"                            </tr>\n"
"                            <tr t-if=\"object.representation == 'broker'\">\n"
"                                <td style=\"padding:3px 14px 3px 0; color:#6b7280;\">Accompagné de son courtier</td>\n"
"                                <td style=\"padding:3px 0;\"><t t-out=\"object.buyer_broker_name or 'oui'\"/></td>\n"
"                            </tr>\n"
"                            <tr t-if=\"object.representation == 'none'\">\n"
"                                <td style=\"padding:3px 14px 3px 0; color:#6b7280;\">Représentation</td>\n"
"                                <td style=\"padding:3px 0;\">la personne n'a pas de courtier</td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                    <p>Vous pouvez accepter, refuser, ou proposer une autre heure.</p>\n"
"                </t>\n"
"                <t t-set=\"bouton_url\" t-value=\"object.url_decision\"/>\n"
"                <t t-set=\"bouton_texte\">Répondre à la demande</t>\n"
"                <t t-call=\"bf_appointment_visit.visit_email_layout\"/>\n"
"            "
msgstr ""

