<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_bf_attachment_version" model="ir.ui.view">
        <field name="name">res.config.settings.bf.attachment.version</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Attachment versions" name="bf_attachment_version">
                    <block title="Retention" name="bf_av_conservation">
                        <setting id="bf_av_setting_actif"
                                 help="When an attachment is rewritten, the old content is kept. When off, a replacement is final again and leaves no trace.">
                            <field name="bf_av_actif"/>
                        </setting>
                        <setting id="bf_av_setting_extensions" string="Versioned extensions"
                                 help="Comma-separated, without the dot.">
                            <field name="bf_av_extensions"/>
                        </setting>
                        <setting id="bf_av_setting_modeles" string="Excluded models"
                                 help="Their attachments are never versioned.">
                            <field name="bf_av_modeles_exclus"/>
                        </setting>
                        <setting id="bf_av_setting_taille" string="Maximum versioned size"
                                 help="Above this, the replacement stays final. 0 for no limit.">
                            <field name="bf_av_taille_max_mo"/> MB
                        </setting>
                    </block>
                    <block title="Purge" name="bf_av_purge">
                        <setting id="bf_av_setting_max" string="Versions kept per attachment"
                                 help="The oldest ones are deleted beyond this. 0 to purge nothing.">
                            <field name="bf_av_max_versions"/>
                        </setting>
                        <setting id="bf_av_setting_jours" string="Maximum age"
                                 help="0 to not purge by age.">
                            <field name="bf_av_max_jours"/> days
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
