<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="weekday_0" model="bf.retail.weekday"><field name="name">Monday</field><field name="code">0</field></record>
        <record id="weekday_1" model="bf.retail.weekday"><field name="name">Tuesday</field><field name="code">1</field></record>
        <record id="weekday_2" model="bf.retail.weekday"><field name="name">Wednesday</field><field name="code">2</field></record>
        <record id="weekday_3" model="bf.retail.weekday"><field name="name">Thursday</field><field name="code">3</field></record>
        <record id="weekday_4" model="bf.retail.weekday"><field name="name">Friday</field><field name="code">4</field></record>
        <record id="weekday_5" model="bf.retail.weekday"><field name="name">Saturday</field><field name="code">5</field></record>
        <record id="weekday_6" model="bf.retail.weekday"><field name="name">Sunday</field><field name="code">6</field></record>
    </data>

    <record id="seq_bf_retail_order_guide" model="ir.sequence">
        <field name="name">Retail order guide</field>
        <field name="code">bf.retail.order.guide</field>
        <field name="prefix">CMD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bf_retail_price_file" model="ir.sequence">
        <field name="name">Wholesaler price file</field>
        <field name="code">bf.retail.price.file</field>
        <field name="prefix">PRIXF/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
