<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="bf_time_of_day_user_pref_rule_own" model="ir.rule">
            <field name="name">Plages horaires : préférences propres uniquement</field>
            <field name="model_id" ref="model_bf_time_of_day_user_pref"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="bf_time_of_day_user_pref_rule_admin" model="ir.rule">
            <field name="name">Plages horaires : admin tout voir</field>
            <field name="model_id" ref="model_bf_time_of_day_user_pref"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

    </data>
</odoo>
