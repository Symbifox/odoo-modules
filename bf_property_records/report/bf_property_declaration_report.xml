<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_declaration" model="report.paperformat">
        <field name="name">Déclaration d'examen sur place (Lettre)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_site_declaration" model="ir.actions.report">
        <field name="name">Déclaration d'examen sur place</field>
        <field name="model">bf.property.maintenance.log</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_property_records.report_site_declaration</field>
        <field name="report_file">bf_property_records.report_site_declaration</field>
        <field name="print_report_name">'Declaration_examen_%s' % object._report_declaration_date()</field>
        <field name="binding_model_id" ref="model_bf_property_maintenance_log"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_declaration"/>
    </record>

</odoo>
