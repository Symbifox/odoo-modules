#. module: bf_securetransfer
#: model_terms:ir.ui.view,arch_db:bf_securetransfer.report_access_certificate_document
msgid ""
"<strong>How to verify this certificate without trusting us.</strong>\n"
"                    Every entry carries a\n"
"                    <span style=\"font-family:monospace;\">SHA-256(previous hash + canonical payload)</span>\n"
"                    hash, where the payload is the sorted JSON of the entry's fields\n"
"                    (transfer id and name, action, UTC timestamp, IP, user agent,\n"
"                    actor, note) and where the first entry starts from an empty\n"
"                    hash. Altering, removing or inserting a single entry breaks\n"
"                    every hash that follows."
msgstr ""

#. module: bf_securetransfer
#: model:mail.template,body_html:bf_securetransfer.mail_template_download_notice
msgid ""
"<t t-set=\"visuals\" t-value=\"object.brand_id._visuals()\"/>\n"
"                <t t-set=\"base\" t-value=\"object.brand_id._share_base_url()\"/>\n"
"                <t t-set=\"primary\" t-value=\"visuals['primary']\"/>\n"
"                <t t-set=\"dark\" t-value=\"visuals['dark']\"/>\n"
"                <t t-set=\"logo_src\" t-value=\"visuals['logo_url'] and (visuals['logo_url'].startswith('http') and visuals['logo_url'] or base + visuals['logo_url']) or False\"/>\n"
"                <div style=\"font-family:Lexend,system-ui,Arial,sans-serif; color:#2E3132; font-size:14px; line-height:1.55; max-width:600px; margin:0 auto;\">\n"
"                    <div t-attf-style=\"background:#{dark}; padding:18px 24px; border-radius:10px 10px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tbody><tr>\n"
"                            <td align=\"left\" style=\"vertical-align:middle;\">\n"
"                                <img t-if=\"logo_src\" t-att-src=\"logo_src\" t-att-alt=\"visuals['name']\" style=\"height:36px; display:block; border:0;\"/>\n"
"                                <span t-else=\"\" style=\"color:#ffffff; font-size:18px; font-weight:700;\" t-out=\"visuals['name']\"/>\n"
"                            </td>\n"
"                            <td align=\"right\" style=\"vertical-align:middle; color:#ffffff; font-family:Lexend,system-ui,Arial,sans-serif; font-size:20px; font-weight:700;\">Download notice</td>\n"
"                        </tr></tbody></table>\n"
"                    </div>\n"
"                    <div t-attf-style=\"height:4px; background:#{primary};\"/>\n"
"                    <div style=\"background:#ffffff; border:1px solid #e3e7eb; border-top:0; padding:24px; border-radius:0 0 10px 10px;\">\n"
"                        <p>Hello <t t-out=\"object.sender_name or ''\"/>,</p>\n"
"                        <p>Your shared files (<strong t-out=\"object.name\"/>) have just been downloaded.</p>\n"
"                        <p style=\"color:#777; font-size:12px;\">This transfer remains available until it expires on\n"
"                            <strong t-out=\"format_date(object.expiry_date, lang_code=object.locale)\"/>.</p>\n"
"                    </div>\n"
"                    <div style=\"text-align:center; color:#9aa4ad; font-size:12px; padding:14px;\">\n"
"                        <div t-if=\"visuals['tagline']\" style=\"margin-bottom:6px;\" t-out=\"visuals['tagline']\"/>\n"
"                        <t t-if=\"visuals['powered_by']\">Powered by <t t-out=\"visuals['powered_by_name']\"/></t>\n"
"                        <div t-if=\"visuals['footer_html']\" style=\"margin-top:8px; color:#9aa4ad;\" t-out=\"visuals['footer_html']\"/>\n"
"                    </div>\n"
"                </div>"
msgstr ""

#. module: bf_securetransfer
#: model:mail.template,body_html:bf_securetransfer.mail_template_secure_message
msgid ""
"<t t-set=\"visuals\" t-value=\"object.brand_id._visuals()\"/>\n"
"                <t t-set=\"base\" t-value=\"object.brand_id._share_base_url()\"/>\n"
"                <t t-set=\"primary\" t-value=\"visuals['primary']\"/>\n"
"                <t t-set=\"dark\" t-value=\"visuals['dark']\"/>\n"
"                <t t-set=\"logo_src\" t-value=\"visuals['logo_url'] and (visuals['logo_url'].startswith('http') and visuals['logo_url'] or base + visuals['logo_url']) or False\"/>\n"
"                <t t-set=\"share\" t-value=\"object._share_url()\"/>\n"
"                <div style=\"font-family:Lexend,system-ui,Arial,sans-serif; color:#2E3132; font-size:14px; line-height:1.55; max-width:600px; margin:0 auto;\">\n"
"                    <div t-attf-style=\"background:#{dark}; padding:18px 24px; border-radius:10px 10px 0 0;\">\n"
"                        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\"><tbody><tr>\n"
"                            <td align=\"left\" style=\"vertical-align:middle;\">\n"
"                                <img t-if=\"logo_src\" t-att-src=\"logo_src\" t-att-alt=\"visuals['name']\" style=\"height:36px; display:block; border:0;\"/>\n"
"                                <span t-else=\"\" style=\"color:#ffffff; font-size:18px; font-weight:700;\" t-out=\"visuals['name']\"/>\n"
"                            </td>\n"
"                            <td align=\"right\" style=\"vertical-align:middle; color:#ffffff; font-family:Lexend,system-ui,Arial,sans-serif; font-size:20px; font-weight:700;\">Secure message</td>\n"
"                        </tr></tbody></table>\n"
"                    </div>\n"
"                    <div t-attf-style=\"height:4px; background:#{primary};\"/>\n"
"                    <div style=\"background:#ffffff; border:1px solid #e3e7eb; border-top:0; padding:24px; border-radius:0 0 10px 10px;\">\n"
"                        <p>Hello,</p>\n"
"                        <div t-if=\"object.subject\" style=\"font-size:18px; font-weight:700; color:#2E3132; margin:0 0 14px;\" t-out=\"object.subject\"/>\n"
"                        <div style=\"background:#f4f6f8; border:1px solid #e3e7eb; border-radius:8px; padding:12px 16px; margin:0 0 16px;\">\n"
"                            From:\n"
"                            <strong t-out=\"object.sender_name or object.sender_email\"/>\n"
"                            <t t-if=\"object.sender_name\"> &lt;<t t-out=\"object.sender_email\"/>&gt;</t>\n"
"                        </div>\n"
"                        <t t-set=\"gated\" t-value=\"object._recipient_otp_required()\"/>\n"
"                        <p>A <strong>secure message</strong> has been sent to you. Its content is <strong>not included in this email</strong> : it is shown only on a secure page, available for a limited time, reachable through the link below.</p>\n"
"                        <p t-if=\"gated\" style=\"background:#f4f6f8; border:1px solid #e3e7eb; border-radius:8px; padding:10px 14px;\">To read it, click below, confirm your email address, then enter the <strong>one-time verification code</strong> that will be sent to you (by email or SMS).</p>\n"
"                        <p t-else=\"\" style=\"background:#f4f6f8; border:1px solid #e3e7eb; border-radius:8px; padding:10px 14px;\">To read it, click the button below: the message will appear directly on the secure page.</p>\n"
"                        <p t-if=\"object.has_password\" style=\"background:#fff8e6; border:1px solid #f2e3b3; border-radius:8px; padding:10px 14px;\">Access is also <strong>password-protected</strong>. The sender will share it with you separately (it never appears in this email).</p>\n"
"                        <p style=\"margin:24px 0;\">\n"
"                            <a t-att-href=\"share\" t-attf-style=\"background:#{primary}; color:#ffffff; text-decoration:none; padding:12px 26px; border-radius:8px; font-weight:600; display:inline-block;\">\n"
"                                Read the secure message</a>\n"
"                        </p>\n"
"                        <p>This link will expire on <strong t-out=\"format_date(object.expiry_date, lang_code=object.locale)\"/>.</p>\n"
"                        <p style=\"color:#777; font-size:12px;\">If the button does not work, copy this link into your browser:<br/>\n"
"                            <a t-att-href=\"share\" t-out=\"share\"/></p>\n"
"                        <p style=\"color:#777; font-size:12px;\">Weren't expecting this message? Don't access it and delete this email.</p>\n"
"                    </div>\n"
"                    <div style=\"text-align:center; color:#9aa4ad; font-size:12px; padding:14px;\">\n"
"                        <div t-if=\"visuals['tagline']\" style=\"margin-bottom:6px;\" t-out=\"visuals['tagline']\"/>\n"
"                        <t t-if=\"visuals['powered_by']\">Powered by <t t-out=\"visuals['powered_by_name']\"/></t>\n"
"                        <div t-if=\"visuals['footer_html']\" style=\"margin-top:8px; color:#9aa4ad;\" t-out=\"visuals['footer_html']\"/>\n"
"                    </div>\n"
"                </div>"
msgstr ""

