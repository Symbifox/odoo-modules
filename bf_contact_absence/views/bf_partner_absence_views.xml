<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_partner_absence_list" model="ir.ui.view">
        <field name="name">bf.partner.absence.list</field>
        <field name="model">bf.partner.absence</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'planned'" decoration-warning="state == 'running'" decoration-muted="state == 'over'">
                <field name="partner_id"/>
                <field name="nature"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="date_return"/>
                <field name="backup_partner_id" optional="show"/>
                <field name="backup_info" optional="hide"/>
                <field name="source" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_bf_partner_absence_form" model="ir.ui.view">
        <field name="name">bf.partner.absence.form</field>
        <field name="model">bf.partner.absence</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_end_now" type="object" string="Back early"
                            class="btn-secondary" invisible="state != 'running'"
                            help="The contact came back earlier than planned: the warning goes out today."/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,running,over"/>
                </header>
                <sheet>
                    <group>
                        <group string="Who, and when">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="partner_is_company" invisible="1"/>
                            <field name="nature"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="date_return"
                                   help="Enter either one: the module corrects the other."/>
                            <field name="applies_to_children" invisible="not partner_is_company"/>
                        </group>
                        <group string="Meanwhile">
                            <field name="backup_partner_id" options="{'no_create': True}"/>
                            <field name="backup_info" placeholder="frontdesk@example.test, 450 555-1212"/>
                            <field name="reminder"/>
                            <field name="user_id" invisible="not reminder"/>
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"
                               placeholder="One line, for us. Never the text of an out-of-office reply."/>
                    </group>
                    <field name="reminder_activity_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bf_partner_absence_calendar" model="ir.ui.view">
        <field name="name">bf.partner.absence.calendar</field>
        <field name="model">bf.partner.absence</field>
        <field name="arch" type="xml">
            <!-- `date_stop` et non `date_return` : le dernier jour d'absence est
                 inclus, et une barre qui s'arrête la veille du retour est ce
                 qu'on veut voir. -->
            <calendar date_start="date_from" date_stop="date_to"
                      color="nature" mode="month" quick_create="0"
                      string="Absences">
                <field name="partner_id" filters="1"/>
                <field name="nature"/>
                <field name="backup_partner_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_bf_partner_absence_search" model="ir.ui.view">
        <field name="name">bf.partner.absence.search</field>
        <field name="model">bf.partner.absence</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="backup_partner_id"/>
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="cette_semaine" string="This week"
                        domain="[('date_from', '&lt;=', (context_today() + relativedelta(weeks=1, weekday=6)).strftime('%Y-%m-%d')),
                                 ('date_to', '&gt;=', (context_today() + relativedelta(weekday=0, days=-7)).strftime('%Y-%m-%d'))]"
                        help="Any absence touching the current week, even one that started earlier."/>
                <filter name="planned" string="Upcoming" domain="[('state', '=', 'planned')]"/>
                <filter name="over" string="Over" domain="[('state', '=', 'over')]"/>
                <separator/>
                <filter name="from_autoreply" string="From an auto-reply"
                        domain="[('source', '=', 'autoreply')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_nature" string="Nature" context="{'group_by': 'nature'}"/>
                    <filter name="group_month" string="Start" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_partner_absence" model="ir.actions.act_window">
        <field name="name">Contact absences</field>
        <field name="res_model">bf.partner.absence</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_running': 1, 'search_default_planned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record an absence</p>
            <p>A period, a stand-in, and the banner shows up on its own in the chatter of the record, the task or the opportunity.</p>
        </field>
    </record>

</odoo>
