<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_budget" model="report.paperformat">
        <field name="name">État financier de l'exercice (Lettre)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_budget" model="ir.actions.report">
        <field name="name">État financier de l'exercice</field>
        <field name="model">bf.property.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_property_finance.report_budget</field>
        <field name="report_file">bf_property_finance.report_budget</field>
        <field name="print_report_name">'Etat_financier_%s' % (object.name or '').replace(' ', '_')</field>
        <field name="binding_model_id" ref="model_bf_property_budget"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_budget"/>
    </record>

</odoo>
