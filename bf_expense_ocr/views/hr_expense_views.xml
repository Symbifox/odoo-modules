<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_expense_view_form_ocr" model="ir.ui.view">
        <field name="name">hr.expense.view.form.lecture</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ocr_scan" type="object"
                        string="Lire le reçu" icon="fa-magic"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'reported') or nb_attachment &lt; 1"/>
            </xpath>

            <!-- Le motif du doute se lit là où on saisit, pas dans un onglet
                 qu'il faudrait penser à ouvrir. -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="ocr_state != 'doubt'">
                    <field name="ocr_error_message" readonly="1" nolabel="1"/>
                    Les montants n'ont pas été préremplis : le reçu ne balance pas.
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="ocr_state != 'error'">
                    <field name="ocr_error_message" readonly="1" nolabel="1"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='tip_amount_currency']" position="after">
                <field name="ocr_state" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- ⚠️ La liste servie est `hr_expense_view_expenses_analysis_tree`, pas
         `view_expenses_tree` (vue primaire qui n'ajoute qu'un `js_class`). -->
    <record id="view_expenses_tree_ocr" model="ir.ui.view">
        <field name="name">hr.expense.list.lecture</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ocr_state" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
