<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_supplierinfo_list_retail" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.retail</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <field name="price" position="after">
                <field name="bf_retail_price_per_unit" optional="show"
                       groups="bf_retail.group_retail_manager"/>
                <field name="bf_retail_best" optional="show"
                       groups="bf_retail.group_retail_manager"/>
            </field>
        </field>
    </record>

    <record id="action_bf_retail_supplierinfo" model="ir.actions.act_window">
        <field name="name">Compare the suppliers</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_tmpl_id.bf_retail_managed', '=', True)]</field>
        <field name="context">{'search_default_groupby_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No vendor price on a retail item</p>
            <p>A price quoted by the dozen says nothing next to a shelf that sells by the
               unit. In Odoo the purchase unit belongs to the item, not to the vendor: a
               supplier selling in another pack size shows it in its minimum quantity.</p>
        </field>
    </record>
</odoo>
