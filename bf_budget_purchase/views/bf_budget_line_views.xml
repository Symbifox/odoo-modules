<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_line_form_purchase" model="ir.ui.view">
        <field name="name">bf.budget.line.form.purchase</field>
        <field name="model">bf.budget.line</field>
        <field name="inherit_id" ref="bf_budget.bf_budget_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Purchase orders"
                       invisible="not purchase_period_total">
                    <group>
                        <field name="purchase_committed_count"/>
                        <field name="purchase_committed"/>
                    </group>
                    <group>
                        <field name="purchase_period_total"/>
                        <button name="action_view_purchase_orders" type="object"
                                string="View purchase orders" class="btn-link"
                                groups="purchase.group_purchase_user"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="bf_budget_line_list_purchase" model="ir.ui.view">
        <field name="name">bf.budget.line.list.purchase</field>
        <field name="model">bf.budget.line</field>
        <field name="inherit_id" ref="bf_budget.bf_budget_line_view_list"/>
        <field name="arch" type="xml">
            <field name="amount_committed" position="after">
                <field name="purchase_committed" optional="hide" sum="Open purchase orders"/>
            </field>
        </field>
    </record>
</odoo>
