<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Configurer la vigie courriel</field>
        <field name="description">Définissez les seuils d'inactivité et les destinataires d'alertes pour les boîtes surveillées.</field>
        <field name="button_text">Ouvrir Paramètres</field>
        <field name="done_text">Vigie active</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>
    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">BF Mail Vigie</field>
        <field name="route_name">bf_mail_vigie_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_mail_vigie</field>
        <field name="step_ids" eval="[Command.link(ref('bf_mail_vigie.bf_onb_step_settings'))]"/>
    </record>
</odoo>
