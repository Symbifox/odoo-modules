<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Le promoteur ne sert qu'au calcul des voix (art. 1092), il apparaît
         donc sur la fiche du syndicat seulement quand ce module est là. -->
    <record id="view_property_syndicat_form_governance" model="ir.ui.view">
        <field name="name">bf.property.syndicat.form.governance</field>
        <field name="model">bf.property.syndicat</field>
        <field name="inherit_id" ref="bf_property_core.view_property_syndicat_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='declaration_date']" position="after">
                <field name="promoter_partner_id"/>
                <field name="promoter_unit_id"
                       invisible="not promoter_partner_id"/>
            </xpath>
        </field>
    </record>

</odoo>
