<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pulse_metric_list" model="ir.ui.view">
        <field name="name">bf.ex.pulse.metric.list</field>
        <field name="model">bf.ex.pulse.metric</field>
        <field name="arch" type="xml">
            <list string="Axes de mesure">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="question_count"/>
            </list>
        </field>
    </record>

    <record id="view_pulse_metric_form" model="ir.ui.view">
        <field name="name">bf.ex.pulse.metric.form</field>
        <field name="model">bf.ex.pulse.metric</field>
        <field name="arch" type="xml">
            <form string="Axe de mesure">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="Ce que l'axe mesure">
                        <field name="description" nolabel="1"/>
                    </group>
                    <field name="question_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="title"/>
                            <field name="question_kind"/>
                            <field name="is_enps"/>
                            <field name="hint"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pulse_question_list" model="ir.ui.view">
        <field name="name">bf.ex.pulse.question.list</field>
        <field name="model">bf.ex.pulse.question</field>
        <field name="arch" type="xml">
            <list string="Banque de questions">
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="metric_id"/>
                <field name="question_kind"/>
                <field name="is_enps"/>
            </list>
        </field>
    </record>

    <record id="view_pulse_question_form" model="ir.ui.view">
        <field name="name">bf.ex.pulse.question.form</field>
        <field name="model">bf.ex.pulse.question</field>
        <field name="arch" type="xml">
            <form string="Question">
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="metric_id"/>
                            <field name="question_kind"/>
                            <field name="is_enps"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <field name="hint"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pulse_metric" model="ir.actions.act_window">
        <field name="name">Axes de mesure</field>
        <field name="res_model">bf.ex.pulse.metric</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_pulse_question" model="ir.actions.act_window">
        <field name="name">Banque de questions</field>
        <field name="res_model">bf.ex.pulse.question</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
