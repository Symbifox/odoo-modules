<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hosting_license_import_wizard_view_form" model="ir.ui.view">
        <field name="name">hosting.license.import.wizard.form</field>
        <field name="model">hosting.license.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import a license pool">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        The file must have 5 columns in this order:
                        <strong>Purchase date | Product key | Activated on | Client | Notes</strong>.
                        A header row is expected. Each row becomes a seat.
                    </div>
                    <group>
                        <group string="File">
                            <field name="attachment" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group string="Pool metadata">
                            <field name="name" placeholder="E.g. Windows 11 Pro, batch 2025-09"/>
                            <field name="software_id"/>
                            <field name="product_name" placeholder="If not in the catalog"/>
                            <field name="vendor"/>
                            <field name="license_type"/>
                            <field name="owner_partner_id"
                                   options="{'no_create': True}"/>
                            <field name="purchase_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hosting_license_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import a license pool</field>
        <field name="res_model">hosting.license.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
