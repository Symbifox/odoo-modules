<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="secure_send_wizard_view_form" model="ir.ui.view">
        <field name="name">secure.transfer.send.wizard.form</field>
        <field name="model">secure.transfer.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Secure transfer">
                <div class="alert alert-info" role="alert">
                    The content is <strong>held back</strong>: the recipient gets a
                    link, and neither the message nor the files appear until
                    they enter a <strong>one-time verification code</strong>
                    (email or SMS). Every access is journaled (Law 25).
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not brand_warning">
                    <field name="brand_warning" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <group>
                        <field name="brand_allows_audience" invisible="1"/>
                        <field name="brand_allows_audience_sms" invisible="1"/>
                        <field name="audience_mode" widget="radio"
                               invisible="not brand_allows_audience"/>
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               invisible="audience_mode == 'open'"/>
                        <field name="extra_emails" placeholder="other@example.com, ..."
                               invisible="audience_mode == 'open'"/>
                        <field name="otp_channel" widget="radio"
                               invisible="audience_mode == 'open'"/>
                        <field name="sms_configured" invisible="1"/>
                        <field name="sms_hint"
                               invisible="otp_channel != 'sms' or audience_mode == 'open'"
                               readonly="1" nolabel="1"
                               decoration-warning="not sms_configured"/>
                    </group>
                    <group>
                        <field name="template_id"
                               options="{'no_create': True}"
                               placeholder="Start from a configuration already set up"/>
                        <field name="template_note" readonly="1" nolabel="1"
                               colspan="2" invisible="not template_id"/>
                        <field name="brand_id"/>
                        <field name="retention_days"/>
                        <field name="password" password="True"/>
                    </group>
                </group>
                <group string="Open audience" invisible="audience_mode != 'open'">
                    <div class="alert alert-warning" role="alert" colspan="2">
                        The link will be sent <strong>to no one</strong>: you receive it in your receipt and you share it yourself. Each person who opens it enters their email (or mobile), receives a code, and only reaches the content after confirming it. Their identity is recorded in the log and stamped on the downloaded PDFs.
                    </div>
                    <field name="audience_max"
                           placeholder="0 = brand value"/>
                    <field name="audience_max_downloads"/>
                    <field name="notify_on_join"/>
                    <field name="audience_allow_sms"
                           invisible="not brand_allows_audience_sms"/>
                    <field name="audience_domains" colspan="2"
                           placeholder="Empty = the brand's list.&#10;E.g.: @client.com&#10;⚠ A list set here rules out identification by mobile."/>
                </group>
                <group>
                    <field name="subject" placeholder="E.g. Portal access: credentials"/>
                </group>
                <field name="message" placeholder="Your secure message…"
                       nolabel="1"/>
                <group string="Files">
                    <field name="attachment_ids" widget="many2many_binary"
                           nolabel="1" colspan="2"/>
                    <div colspan="2" class="text-muted">
                        <field name="upload_hint" nolabel="1" readonly="1"/>
                    </div>
                </group>
                <group string="Sender" col="2">
                    <!-- readonly for anyone but a securetransfer manager: a
                         plain user sends as themselves. The form only mirrors
                         the rule — action_send re-forces the values, since a
                         transient record is writable over RPC. -->
                    <field name="sender_locked" invisible="1"/>
                    <field name="sender_name" readonly="sender_locked"/>
                    <field name="sender_email" readonly="sender_locked"/>
                </group>
                <footer>
                    <button string="Send" name="action_send" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_secure_send_wizard" model="ir.actions.act_window">
        <field name="name">New secure send</field>
        <field name="res_model">secure.transfer.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="secure_send_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <!-- Dedicated entry point for the open-audience ("dataroom") link.

         It cannot just carry `default_audience_mode: 'open'` in its context:
         `_onchange_brand_audience` fires at form load, finds no brand yet, and
         a brand that offers nothing pulls the mode back to « destinataires
         nommés ». The context flag is read by `default_get`, which picks a
         brand that actually offers the mode — that is what makes the default
         survive the onchange. -->
    <record id="action_secure_send_open_audience" model="ir.actions.act_window">
        <field name="name">New open audience link</field>
        <field name="res_model">secure.transfer.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="secure_send_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{'st_open_audience': True}</field>
    </record>

    <!-- Also reachable from a contact's Action menu (« partout où on transmet
         des courriels »): pre-fills the picked contact as recipient. -->
    <record id="action_secure_send_from_partner" model="ir.actions.act_window">
        <field name="name">Send a secure transfer</field>
        <field name="res_model">secure.transfer.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="secure_send_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('group_securetransfer_user'))]"/>
    </record>

</odoo>
