<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_expense_allowance_rate_view_list" model="ir.ui.view">
        <field name="name">bf.expense.allowance.rate.list</field>
        <field name="model">bf.expense.allowance.rate</field>
        <field name="arch" type="xml">
            <list string="Allowance rates" editable="bottom">
                <header>
                    <button name="action_load_njc_rates" type="object" display="always"
                            string="Load the federal rates (October 1, 2026)"
                            help="National Joint Council, Travel Directive, Appendix C, Canada. A starting point: the rates are the company's policy."/>
                </header>
                <field name="kind"/>
                <field name="date_from"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount"/>
                <field name="product_id" options="{'no_create': True}"/>
                <field name="source" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="bf_expense_allowance_rate_view_search" model="ir.ui.view">
        <field name="name">bf.expense.allowance.rate.search</field>
        <field name="model">bf.expense.allowance.rate</field>
        <field name="arch" type="xml">
            <search string="Allowance rates">
                <field name="kind"/>
                <field name="source"/>
                <group expand="0" string="Group By">
                    <filter name="group_kind" string="Allowance" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_expense_allowance_rate_action" model="ir.actions.act_window">
        <field name="name">Allowance rates</field>
        <field name="res_model">bf.expense.allowance.rate</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enter the company's allowance rates</p>
            <p>
                An amount per meal, for incidentals and for a night in private lodging, from a
                start date. The federal rates can be loaded as a starting point.
            </p>
        </field>
    </record>
</odoo>
