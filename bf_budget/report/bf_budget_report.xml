<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_bf_budget" model="ir.actions.report">
        <field name="name">Budget vs. actual</field>
        <field name="model">bf.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bf_budget.report_bf_budget</field>
        <field name="report_file">bf_budget.report_bf_budget</field>
        <field name="binding_model_id" ref="model_bf_budget"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bf_budget">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="rows" t-value="doc._report_rows()"/>
                <t t-set="totals" t-value="doc._report_totals(rows)"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-field="doc.name"/></h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Fiscal year:</strong>
                                <span t-field="doc.date_start"/> to <span t-field="doc.date_end"/>
                            </div>
                            <div class="col-6">
                                <strong>Budget type:</strong>
                                <span t-field="doc.budget_type"/>
                                <span> · </span> <strong>State:</strong>
                                <span t-field="doc.state"/>
                            </div>
                        </div>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Budget item</th>
                                    <th class="text-end">Planned this month</th>
                                    <th class="text-end">Planned</th>
                                    <th class="text-end">Theoretical</th>
                                    <th class="text-end">Actual</th>
                                    <th class="text-end">Committed</th>
                                    <th class="text-end">Variance from theoretical</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <td>
                                        <span t-out="row['label']"/>
                                        <span t-if="row['accepted']" class="text-muted"> (accepted overrun)</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['month_planned']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['planned']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['theoretical']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['actual']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['committed']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="row['drift']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total</th>
                                    <th class="text-end">
                                        <span t-out="totals['month_planned']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['planned']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['theoretical']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['actual']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['committed']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                    <th class="text-end">
                                        <span t-out="totals['drift']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <p class="text-muted mt-3" style="font-size: 9pt;">
                            Actuals are not copied: they are read from accounting at print time. The theoretical amount relies on the monthly breakdown entered, never on a simple pro rata of elapsed time.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
