msgstr "Service provider's measures: %s"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "Mesures suggérées aux personnes : %s"
msgstr "Measures suggested to the persons: %s"

#. module: bf_federation_privacy
#: model:ir.model.fields,field_description:bf_federation_privacy.field_privacy_breach_notice__federation_origin
msgid "Origine"
msgstr "Origin"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "PDF illisible dans l'avis reçu."
msgstr "Unreadable PDF in the notice received."

#. module: bf_federation_privacy
#: model:ir.model.fields,field_description:bf_federation_privacy.field_privacy_breach_notice__federation_pdf_sent
msgid "PDF parti par la fédération"
msgstr "PDF sent through federation"

#. module: bf_federation_privacy
#: model:ir.model.fields,field_description:bf_federation_privacy.field_privacy_breach_notice__federation_allowed_peer_ids
msgid "Pairs permis"
msgstr "Allowed peers"

#. module: bf_federation_privacy
#: model:ir.model.fields,field_description:bf_federation_privacy.field_privacy_breach_notice__federation_shared_peer_id
msgid "Partagé avec"
msgstr "Shared with"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/federation_link.py:0
msgid "Recherche non prise en charge."
msgstr "Unsupported search."

#. module: bf_federation_privacy
#: model:ir.model.fields.selection,name:bf_federation_privacy.selection__privacy_breach_notice__state__received
msgid "Reçu"
msgstr "Received"

#. module: bf_federation_privacy
#: model:ir.model.fields,field_description:bf_federation_privacy.field_privacy_breach_notice__received_at
msgid "Reçu le"
msgstr "Received on"

#. module: bf_federation_privacy
#: model_terms:ir.ui.view,arch_db:bf_federation_privacy.view_breach_notice_search_federation
msgid "Reçus d'un mandataire"
msgstr "Received from a service provider"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "Sensibilité : %s"
msgstr "Sensitivity: %s"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "Seul un avis reçu d'un mandataire s'accuse ici."
msgstr "Only a notice received from a service provider is acknowledged here."

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "Sortie des données : %s"
msgstr "Data leaving: %s"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "Tiers : %s"
msgstr "Third parties: %s"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid ""
"Un avis reçu ne se met pas à jour ici : c'est le mandataire qui envoie la "
"suite."
msgstr ""
"A received notice is not updated here: the service provider sends the next "
"version."

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/base_partner_merge.py:0
msgid ""
"Une de ces fiches représente un pair de fédération : seule une personne "
"administratrice peut la fusionner, en vérifiant à qui iront les objets "
"partagés."
msgstr ""
"One of these records represents a federation peer: only an administrator can"
" merge it, checking who will receive the shared objects."

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid ""
"Version %(v)s de l'avis %(ref)s. L'évaluation du risque de préjudice "
"sérieux, les avis à la Commission et aux personnes vous reviennent."
msgstr ""
"Version %(v)s of notice %(ref)s. Assessing the risk of serious injury and "
"notifying the Commission and the persons concerned remain yours."

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
msgid "cet avis"
msgstr "this notice"

#. module: bf_federation_privacy
#. odoo-python
#: code:addons/bf_federation_privacy/models/privacy_breach_notice.py:0
