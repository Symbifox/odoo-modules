#. module: bf_property_records
#. odoo-python
#: code:addons/bf_property_records/models/bf_property_maintenance_log.py:0
msgid ""
" Aucun bien n'a d'année de réalisation estimée passée sans date de "
"réalisation ni raison."
msgstr ""
" No item has a past estimated year of carrying out without a date of "
"carrying out or a reason."

#. module: bf_property_records
#. odoo-python
#: code:addons/bf_property_records/models/bf_property_maintenance_log.py:0
msgid ""
" ⚠️ %(count)d bien(s) dont l'année de réalisation estimée est passée sans "
"date de réalisation ni raison : %(items)s. L'art. 4 veut que le carnet "
"mentionne les travaux requis ou prévus qui n'ont pas été effectués ET "
"indique pourquoi."
msgstr ""
" ⚠️ %(count)d item(s) whose estimated year of carrying out has passed "
"without a date of carrying out or a reason: %(items)s. Section 4 wants the "
"log to mention the required or planned works that were not carried out AND "
"to state why."

