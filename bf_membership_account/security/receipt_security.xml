<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
          🔴 La portée par société passe par une règle : un droit de lecture
          ouvre le modèle entier, et un reçu porte le nom et l'adresse d'un
          membre.
        -->
        <record id="rule_membership_receipt_company" model="ir.rule">
            <field name="name">Reçu fiscal de cotisation : société</field>
            <field name="model_id" ref="model_bf_membership_receipt"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
