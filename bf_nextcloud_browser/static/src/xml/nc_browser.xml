<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bf_nextcloud_browser.NcBrowser">
        <div class="o_nc_browser" t-att-class="{ o_nc_drag_over: state.dragOver }"
             t-on-dragover="onDragOver" t-on-dragleave="onDragLeave" t-on-drop="onDrop">
            <t t-if="!state.ready">
                <div class="text-muted p-3">
                    <i class="fa fa-spinner fa-spin me-1"/> Chargement…
                </div>
            </t>
            <t t-elif="showConnectCard">
                <div class="o_nc_connect card mx-auto my-4">
                    <div class="card-body">
                        <h5 class="card-title mb-2">
                            <i class="fa fa-cloud me-2"/>Connectez votre Nextcloud
                        </h5>
                        <div t-if="state.conn.rejected" class="alert alert-warning py-2">
                            Votre connexion a ete revoquee dans Nextcloud. Reconnectez votre compte pour continuer.
                        </div>
                        <p class="mb-2">
                            Le navigateur agit en votre nom : vous voyez les fichiers que Nextcloud
                            vous donne le droit de voir, et les liens de partage portent votre nom.
                        </p>
                        <p class="text-muted small mb-3">
                            Une fenetre Nextcloud va s'ouvrir. Approuvez l'acces demande par Odoo,
                            puis fermez cette fenetre. Vous pourrez retirer l'acces a tout moment,
                            ici ou dans Nextcloud (Parametres, Securite, Appareils et sessions).
                            <t t-if="state.conn.server"><br/>Serveur : <t t-esc="state.conn.server"/></t>
                        </p>
                        <t t-if="!state.conn.pending">
                            <button class="btn btn-primary" t-on-click="connect">
                                <i class="fa fa-sign-in me-1"/> Connecter mon Nextcloud
                            </button>
                        </t>
                        <t t-else="">
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <span class="text-muted">
                                    <i class="fa fa-spinner fa-spin me-1"/> En attente de votre approbation dans la fenetre Nextcloud…
                                </span>
                                <button t-if="state.conn.loginUrl" class="btn btn-sm btn-link" t-on-click="reopenConnectWindow">
                                    Rouvrir la fenetre
                                </button>
                                <button class="btn btn-sm btn-secondary" t-on-click="cancelConnect">Annuler</button>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="o_nc_toolbar d-flex align-items-center flex-wrap gap-2 mb-2">
                    <button class="btn btn-sm btn-secondary" t-on-click="() => this.load(state.relPath)" title="Rafraichir">
                        <i class="fa fa-refresh"/>
                    </button>
                    <button class="btn btn-sm btn-primary" t-on-click="triggerUpload" t-att-disabled="!canMutate">
                        <i class="fa fa-upload me-1"/> Televerser
                    </button>
                    <button class="btn btn-sm btn-secondary" t-on-click="newFolder" t-att-disabled="!canMutate">
                        <i class="fa fa-folder-o me-1"/> Nouveau dossier
                    </button>
                    <input type="file" class="d-none" t-ref="fileInput" multiple="multiple" t-on-change="onFileChosen"/>
                    <ol class="breadcrumb mb-0 ms-2 align-items-center">
                        <t t-foreach="state.breadcrumb" t-as="c" t-key="c.rel">
                            <li class="breadcrumb-item" t-att-class="{ active: c_last }">
                                <span t-if="c_last">
                                    <i t-if="c_index === 0" class="fa fa-home me-1"/>
                                    <t t-esc="c.name"/>
                                </span>
                                <a t-else="" href="#" t-on-click.prevent="() => this.load(c.rel)">
                                    <i t-if="c_index === 0" class="fa fa-home me-1"/>
                                    <t t-esc="c.name"/>
                                </a>
                            </li>
                        </t>
                    </ol>
                    <t t-if="state.loading">
                        <i class="fa fa-spinner fa-spin text-muted"/>
                    </t>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <t t-if="state.selected.length">
                            <span class="badge bg-secondary" t-esc="state.selected.length + ' sélectionné(s)'"/>
                            <button class="btn btn-sm btn-outline-danger" t-on-click="bulkDelete" t-att-disabled="!canSelect" title="Supprimer la sélection">
                                <i class="fa fa-trash me-1"/> Supprimer
                            </button>
                            <button class="btn btn-sm btn-link p-0" t-on-click="clearSelection" title="Effacer la sélection">
                                <i class="fa fa-times"/>
                            </button>
                        </t>
                        <button t-if="hiddenCount" class="btn btn-sm btn-link p-0 me-1"
                                t-on-click="toggleHidden"
                                t-att-title="state.showHidden ? 'Masquer les fichiers caches' : hiddenCount + ' fichier(s) cache(s)'">
                            <i class="fa" t-att-class="state.showHidden ? 'fa-eye-slash' : 'fa-eye'"/>
                        </button>
                        <div class="input-group input-group-sm o_nc_filter">
                            <span class="input-group-text">
                                <i t-if="state.search.loading" class="fa fa-spinner fa-spin"/>
                                <i t-else="" class="fa fa-search"/>
                            </span>
                            <input type="text" class="form-control" placeholder="Filtrer ou chercher…"
                                   title="Moins de 3 caractères : filtre le dossier. À partir de 3 : cherche dans tous les dossiers."
                                   t-model="state.filter" t-on-input="onFilterInput"/>
                            <button t-if="state.filter" class="btn btn-outline-secondary" type="button"
                                    t-on-click="clearSearch" title="Effacer la recherche">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <span t-if="state.conn.connected" class="o_nc_identity text-muted small text-nowrap"
                              t-att-title="'Compte Nextcloud : ' + state.conn.login">
                            <i class="fa fa-user-circle-o me-1"/><t t-esc="state.conn.displayName"/>
                            <button class="btn btn-sm btn-link p-0 ms-1" t-on-click="disconnect" title="Deconnecter Nextcloud">
                                <i class="fa fa-sign-out"/>
                            </button>
                        </span>
                    </div>
                </div>

                <t t-if="state.error">
                    <div class="alert alert-info mb-0" t-esc="state.error"/>
                </t>
                <t t-else="">
                    <div t-if="searching" class="o_nc_search_banner d-flex align-items-center flex-wrap gap-2 small mb-2">
                        <i class="fa fa-search text-muted"/>
                        <span t-if="state.search.loading and !state.search.done">Recherche dans tous les dossiers…</span>
                        <span t-elif="state.search.done">
                            <t t-esc="state.search.entries.length"/> résultat(s) pour « <strong t-esc="state.search.term"/> », dans tous les dossiers
                            <t t-if="state.search.truncated"> (les 100 plus récents; précisez la recherche)</t>
                        </span>
                        <button class="btn btn-sm btn-link p-0 ms-auto" t-on-click="clearSearch">Revenir au dossier</button>
                    </div>
                    <div class="o_nc_main d-flex">
                        <div class="o_nc_tree">
                            <ul class="o_nc_tree_root">
                                <t t-foreach="state.tree" t-as="n" t-key="n.rel">
                                    <NcTreeNode node="n" browser="this"/>
                                </t>
                            </ul>
                        </div>
                        <div class="o_nc_content flex-grow-1">
                            <table class="table table-sm table-hover o_nc_list mb-0">
                                <thead>
                                    <tr>
                                        <th class="o_nc_check">
                                            <input type="checkbox" t-att-checked="allVisibleSelected"
                                                   t-on-change="toggleSelectAll" t-att-disabled="!canSelect"/>
                                        </th>
                                        <th class="o_nc_sort" t-on-click="() => this.setSort('name')">
                                            Nom <i t-att-class="sortIcon('name')"/>
                                        </th>
                                        <th class="o_nc_sort" t-on-click="() => this.setSort('type')">
                                            Type <i t-att-class="sortIcon('type')"/>
                                        </th>
                                        <th class="o_nc_sort text-end" t-on-click="() => this.setSort('mtime')">
                                            Modifie <i t-att-class="sortIcon('mtime')"/>
                                        </th>
                                        <th class="o_nc_sort text-end" t-on-click="() => this.setSort('size')">
                                            Taille <i t-att-class="sortIcon('size')"/>
                                        </th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="sortedEntries" t-as="e" t-key="e.rel">
                                        <tr draggable="true"
                                            t-att-class="{ o_nc_folder_row: e.is_dir, o_nc_drop_target: isDropTarget(e.rel), o_nc_hidden_row: e.is_hidden }"
                                            t-on-dragstart="(ev) => this.onRowDragStart(e, ev)"
                                            t-on-dragend="onRowDragEnd"
                                            t-on-dragover="(ev) => this.onListDragOver(e, ev)"
                                            t-on-dragleave="onFolderDragLeave"
                                            t-on-drop="(ev) => this.onListDrop(e, ev)">
                                            <td class="o_nc_check">
                                                <input type="checkbox" t-att-checked="isSelected(e.rel)"
                                                       t-on-change="() => this.toggleSelect(e.rel)"
                                                       t-att-disabled="!canSelect"/>
                                            </td>
                                            <td class="o_nc_name" t-on-click="() => this.onEntryClick(e)"
                                                t-att-title="e.is_dir ? 'Ouvrir le dossier' : (isOfficeFile(e) ? 'Modifier dans Collabora' : 'Apercu')">
                                                <i t-att-class="this._iconClass(e)" t-att-style="e.is_dir ? ('color:' + state.folderColor) : ''"/>
                                                <span class="ms-2" t-esc="e.name"/>
                                                <t t-set="shares" t-value="shareState(e)"/>
                                                <button t-if="shares and shares.public" class="btn btn-sm btn-link p-0 ms-2 o_nc_share_badge"
                                                        t-on-click.stop="() => this.shareDialog(e)"
                                                        t-att-title="shares.public + ' lien(s) public(s) : voir les partages'">
                                                    <i class="fa fa-globe"/> <t t-esc="shares.public"/>
                                                </button>
                                                <button t-if="shares and shares.other" class="btn btn-sm btn-link p-0 ms-2 o_nc_share_badge"
                                                        t-on-click.stop="() => this.shareDialog(e)"
                                                        t-att-title="shares.other + ' autre(s) partage(s) : voir les partages'">
                                                    <i class="fa fa-users"/> <t t-esc="shares.other"/>
                                                </button>
                                                <div t-if="searching" class="o_nc_parent text-muted small text-truncate">
                                                    <i class="fa fa-folder-o me-1"/><t t-esc="parentLabel(e)"/>
                                                </div>
                                            </td>
                                            <td class="text-muted small text-nowrap" t-esc="this._typeLabel(e)"/>
                                            <td class="text-end text-muted small text-nowrap" t-esc="e.mtime"/>
                                            <td class="text-end text-muted small text-nowrap" t-esc="e.size_display"/>
                                            <td class="text-end text-nowrap o_nc_actions">
                                                <button t-if="pickMode" class="btn btn-sm btn-primary py-0 me-2 o_nc_pick"
                                                        t-on-click="() => this.pickEntry(e)" title="Insérer un lien vers cet élément dans le message">
                                                    <i class="fa fa-plus me-1"/>Insérer
                                                </button>
                                                <button t-if="e.link_url" class="btn btn-sm btn-link p-0 me-2 o_nc_copy_link"
                                                        t-on-click="() => this.copyInternalLink(e)"
                                                        title="Copier le lien interne (s'ouvre pour qui a déjà accès dans Nextcloud)">
                                                    <i class="fa fa-clipboard"/>
                                                </button>
                                                <button t-if="e.is_dir" class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.shareDialog(e)" title="Partages">
                                                    <i class="fa fa-share-alt"/>
                                                </button>
                                                <t t-if="!e.is_dir">
                                                    <button t-if="isOfficeFile(e)" class="btn btn-sm btn-link p-0 me-2 o_nc_edit"
                                                            t-on-click="() => this.openOffice(e.internal_url)"
                                                            title="Modifier dans Collabora (nouvel onglet)">
                                                        <i class="fa fa-pencil-square-o"/>
                                                    </button>
                                                    <button t-if="e.internal_url" class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.openInNextcloud(e)" title="Voir dans Nextcloud (nouvel onglet)">
                                                        <i class="fa fa-external-link"/>
                                                    </button>
                                                    <button class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.download(e)" title="Telecharger">
                                                        <i class="fa fa-download"/>
                                                    </button>
                                                    <button class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.shareDialog(e)" title="Lien de partage">
                                                        <i class="fa fa-share-alt"/>
                                                    </button>
                                                    <button t-if="showLink" class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.link(e)" title="Lier a la matrice / Knowledge">
                                                        <i class="fa fa-link"/>
                                                    </button>
                                                </t>
                                                <button class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.rename(e)" title="Renommer">
                                                    <i class="fa fa-pencil"/>
                                                </button>
                                                <button class="btn btn-sm btn-link text-danger p-0" t-on-click="() => this.remove(e)" title="Supprimer">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="searching">
                                        <tr t-if="state.search.done and !state.search.entries.length">
                                            <td colspan="6" class="text-muted text-center p-3">Aucun fichier ni dossier ne porte ce nom.</td>
                                        </tr>
                                    </t>
                                    <t t-elif="!state.entries.length">
                                        <tr>
                                            <td colspan="6" class="text-muted text-center p-3">Dossier vide</td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>

    <t t-name="bf_nextcloud_browser.NcTreeNode">
        <li class="o_nc_tree_node">
            <div class="o_nc_tree_row"
                 t-att-class="{ o_active: props.node.rel === props.browser.state.relPath, o_nc_drop_target: props.browser.isDropTarget(props.node.rel) }"
                 t-on-dragover="(ev) => props.browser.onFolderDragOver(ev, props.node.rel)"
                 t-on-dragleave="() => props.browser.onFolderDragLeave()"
                 t-on-drop="(ev) => props.browser.onFolderDrop(props.node.rel, ev)">
                <t t-if="props.browser.nodeHasCaret(props.node)">
                    <i class="o_nc_caret fa" t-att-class="props.node.expanded ? 'fa-caret-down' : 'fa-caret-right'"
                       t-on-click="() => props.browser.toggleNode(props.node)"/>
                </t>
                <i t-else="" class="o_nc_caret"/>
                <i t-if="props.node.loading" class="fa fa-spinner fa-spin text-muted me-1"/>
                <i t-else="" class="fa fa-folder me-1"
                   t-att-style="'color:' + props.browser.state.folderColor"/>
                <span class="o_nc_tree_label" t-on-click="() => props.browser.openTreeFolder(props.node)" t-esc="props.node.name"/>
            </div>
            <t t-if="props.node.expanded">
                <ul t-if="props.node.children.length" class="o_nc_tree_children">
                    <t t-foreach="props.node.children" t-as="child" t-key="child.rel">
                        <NcTreeNode node="child" browser="props.browser"/>
                    </t>
                </ul>
            </t>
        </li>
    </t>

    <t t-name="bf_nextcloud_browser.NcLinkDialog">
        <Dialog title="'Lier le fichier'" size="'md'">
            <div>
                <p>Lier <strong t-esc="props.filename"/> a :</p>
                <div class="mb-2 d-flex gap-3">
                    <label class="o_nc_radio">
                        <input type="radio" value="item" t-model="state.target"/> Element de matrice
                    </label>
                    <label class="o_nc_radio" t-if="props.hasArticles">
                        <input type="radio" value="article" t-model="state.target"/> Article Knowledge
                    </label>
                </div>
                <t t-if="state.target === 'item'">
                    <select class="form-select" t-model="state.itemId">
                        <t t-foreach="props.items" t-as="it" t-key="it.id">
                            <option t-att-value="it.id" t-esc="it.name"/>
                        </t>
                    </select>
                    <div t-if="!props.items.length" class="text-muted small mt-1">
                        Aucun element de matrice pour ce projet.
                    </div>
                </t>
                <t t-if="state.target === 'article'">
                    <select class="form-select" t-model="state.articleId">
                        <t t-foreach="props.articles" t-as="a" t-key="a.id">
                            <option t-att-value="a.id" t-esc="a.name"/>
                        </t>
                    </select>
                </t>
                <label class="form-label mt-3 mb-1">Type de lien</label>
                <select class="form-select" t-model="state.linkChoice">
                    <option value="internal">Lien interne (pour qui a déjà accès dans Nextcloud)</option>
                    <t t-foreach="presets" t-as="p" t-key="p.id">
                        <option t-att-value="'preset:' + p.id" t-esc="'Partage : ' + p.name"/>
                    </t>
                    <option t-if="!presets.length" value="share">Lien public par défaut</option>
                </select>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!canConfirm" t-on-click="confirm">Lier</button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">Annuler</button>
            </t>
        </Dialog>
    </t>

    <t t-name="bf_nextcloud_browser.NcPromptDialog">
        <Dialog title="props.title" size="'sm'">
            <div>
                <label class="form-label" t-esc="props.label"/>
                <input type="text" class="form-control" t-model="state.value"
                       t-on-keydown="onKeydown" autofocus="autofocus"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!canConfirm" t-on-click="confirm"
                        t-esc="props.confirmLabel || 'OK'"/>
                <button class="btn btn-secondary" t-on-click="() => props.close()">Annuler</button>
            </t>
        </Dialog>
    </t>

    <t t-name="bf_nextcloud_browser.NcShareDialog">
        <Dialog title="'Partager : ' + props.filename" size="'md'">
            <t t-if="props.fetchShares">
                <h6 class="mb-2">Partages existants</h6>
                <div t-if="state.loading" class="text-muted small mb-3"><i class="fa fa-spinner fa-spin me-1"/>Lecture des partages…</div>
                <div t-elif="state.error" class="alert alert-warning py-2 small" t-esc="state.error"/>
                <div t-elif="!state.shares.length" class="text-muted small mb-3">Aucun partage.</div>
                <ul t-else="" class="list-unstyled o_nc_share_list mb-3">
                    <t t-foreach="state.shares" t-as="sh" t-key="sh.id">
                        <li class="d-flex align-items-start gap-2 py-1 border-bottom">
                            <i class="fa mt-1" t-att-class="sh.is_public ? 'fa-globe' : 'fa-users'"/>
                            <div class="flex-grow-1 small">
                                <div>
                                    <strong t-esc="sh.kind"/>
                                    <t t-if="sh.share_with"> : <t t-esc="sh.share_with"/></t>
                                    <span class="text-muted" t-esc="sh.writable ? ' (lecture / écriture)' : ' (lecture seule)'"/>
                                </div>
                                <div class="text-muted">
                                    <t t-if="sh.expiration">Expire le <t t-esc="sh.expiration"/></t>
                                    <t t-elif="!sh.expiry_checked">Expiration non vérifiée</t>
                                    <t t-elif="sh.is_public"><span class="badge text-bg-warning">Sans expiration</span></t>
                                    <t t-if="sh.has_password"> · mot de passe</t>
                                    <t t-if="sh.owner"> · par <t t-esc="sh.owner"/></t>
                                </div>
                            </div>
                            <button t-if="sh.url" class="btn btn-sm btn-link p-0" t-on-click="() => this.copy(sh)" title="Copier le lien">
                                <i class="fa fa-clipboard"/>
                            </button>
                            <button t-if="sh.can_revoke and props.revokeShare" class="btn btn-sm btn-link text-danger p-0 ms-2"
                                    t-on-click="() => this.revoke(sh)" title="Retirer ce partage">
                                <i class="fa fa-ban"/>
                            </button>
                        </li>
                    </t>
                </ul>
                <h6 class="mb-2">Nouveau partage</h6>
            </t>
            <p class="text-muted small mb-2">Choisissez un type de partage :</p>
            <div class="d-grid gap-2">
                <t t-foreach="props.presets" t-as="p" t-key="p.id">
                    <button class="btn btn-outline-primary text-start" t-on-click="() => { props.onChoose(p); props.close(); }">
                        <i class="fa fa-share-alt me-1"/>
                        <t t-esc="p.name"/>
                        <span class="text-muted small ms-1" t-esc="presetLabel(p)"/>
                    </button>
                </t>
                <button t-if="!props.presets.length" class="btn btn-outline-primary"
                        t-on-click="() => { props.onChoose(null); props.close(); }">
                    Lien par defaut
                </button>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => props.close()">Annuler</button>
            </t>
        </Dialog>
    </t>

    <t t-name="bf_nextcloud_browser.NcInsertDialog">
        <Dialog title="'Insérer : ' + props.filename" size="'md'">
            <p class="mb-2">Quel lien mettre dans le message ?</p>
            <div class="d-grid gap-2">
                <button class="btn btn-outline-secondary text-start o_nc_insert_internal" t-on-click="() => this.choose('internal')">
                    <i class="fa fa-lock me-1"/> <strong>Lien interne</strong>
                    <div class="small text-muted">Il s'ouvre seulement pour qui a déjà accès à <t t-esc="props.isDir ? 'ce dossier' : 'ce fichier'"/> dans Nextcloud. Aucun partage n'est créé.</div>
                </button>
                <t t-foreach="props.presets" t-as="p" t-key="p.id">
                    <button class="btn btn-outline-secondary text-start o_nc_insert_share" t-on-click="() => this.choose('share', p)">
                        <i class="fa fa-globe me-1"/> <strong>Partage : <t t-esc="p.name"/></strong>
                        <span class="small text-muted ms-1" t-esc="presetLabel(p)"/>
                        <div class="small text-muted">Crée un lien public : il s'ouvre pour quiconque le reçoit.</div>
                    </button>
                </t>
                <button t-if="!props.presets.length" class="btn btn-outline-secondary text-start" t-on-click="() => this.choose('share')">
                    <i class="fa fa-globe me-1"/> <strong>Lien public par défaut</strong>
                </button>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => props.close()">Annuler</button>
            </t>
        </Dialog>
    </t>

    <t t-name="bf_nextcloud_browser.NcPreviewDialog">
        <Dialog title="props.name" size="'xl'">
            <iframe t-att-src="props.url" class="o_nc_iframe_modal"/>
            <t t-set-slot="footer">
                <a t-if="props.internalUrl" class="btn btn-secondary" t-att-href="props.internalUrl" target="_blank" rel="noopener noreferrer">
                    <i class="fa fa-external-link me-1"/> Ouvrir dans Nextcloud
                </a>
                <button class="btn btn-primary" t-on-click="() => props.close()">Fermer</button>
            </t>
        </Dialog>
    </t>

    <!--
        Le nuage de Nextcloud plutot qu'un dossier generique : la barre systeme
        compte une dizaine de pictogrammes, et celui-la doit dire d'un coup
        d'oeil de quel service il ouvre les fichiers. Le trace est la marque
        officielle (core/img/logo/logo.svg), peinte en `currentColor` pour
        suivre la barre comme le faisait le pictogramme precedent : blanche au
        repos, bleu accent quand le panneau est ouvert (voir la feuille, qui
        doit repondre au `!important` de `bluefox_branding` pour y arriver).

        Le `d-flex align-items-center` sur l'enveloppe : les items de la barre
        systeme sont etires sur toute la hauteur (46 px), donc sans lui le
        bouton se colle en haut. C'est l'idiome des autres barres BF
        (bf_bloc_notes, bf_email_systray), celle-ci l'avait perdu.
    -->
    <t t-name="bf_nextcloud_browser.NcPanelSystray">
        <t t-if="state.show">
            <div class="o_nc_systray d-flex align-items-center"
                 t-att-class="{ o_nc_systray_open: state.open }">
                <button class="btn d-flex align-items-center" t-on-click="toggle"
                        t-att-aria-expanded="state.open ? 'true' : 'false'"
                        aria-label="Fichiers Nextcloud" title="Fichiers Nextcloud">
                    <svg class="o_nc_systray_logo" viewBox="0 0 256 128" aria-hidden="true"
                         xmlns="http://www.w3.org/2000/svg">
                        <path fill="currentColor" d="m128 7c-25.871 0-47.817 17.485-54.713 41.209-5.9795-12.461-18.642-21.209-33.287-21.209-20.304 0-37 16.696-37 37s16.696 37 37 37c14.645 0 27.308-8.7481 33.287-21.209 6.8957 23.724 28.842 41.209 54.713 41.209s47.817-17.485 54.713-41.209c5.9795 12.461 18.642 21.209 33.287 21.209 20.304 0 37-16.696 37-37s-16.696-37-37-37c-14.645 0-27.308 8.7481-33.287 21.209-6.8957-23.724-28.842-41.209-54.713-41.209zm0 22c19.46 0 35 15.54 35 35s-15.54 35-35 35-35-15.54-35-35 15.54-35 35-35zm-88 20c8.4146 0 15 6.5854 15 15s-6.5854 15-15 15-15-6.5854-15-15 6.5854-15 15-15zm176 0c8.4146 0 15 6.5854 15 15s-6.5854 15-15 15-15-6.5854-15-15 6.5854-15 15-15z"/>
                    </svg>
                </button>
            </div>
        </t>
    </t>

    <!--
        Le panneau embarque : un voile qui ferme au clic a cote, et le cadre
        ancre en haut a droite. Les deux sont freres, donc un clic dans le
        panneau n'atteint jamais le voile — pas de `stopPropagation` a poser.
    -->
    <t t-name="bf_nextcloud_browser.NcBrowserPanel">
        <div class="o_nc_panel_root">
            <div class="o_nc_panel_scrim" t-on-click="() => props.close()"/>
            <section class="o_nc_panel" t-att-style="panelStyle"
                     role="dialog" aria-label="Fichiers Nextcloud">
                <header class="o_nc_panel_header d-flex align-items-center gap-2">
                    <i class="fa fa-folder-open-o"/>
                    <span class="o_nc_panel_title">Fichiers Nextcloud</span>
                    <span class="o_nc_panel_size text-muted small" t-esc="sizeLabel"/>
                    <div class="ms-auto d-flex align-items-center">
                        <button t-if="!isDefaultSize" class="btn btn-sm btn-link"
                                t-on-click="resetSize" title="Revenir à la taille par défaut">
                            <i class="fa fa-compress"/>
                        </button>
                        <button class="btn btn-sm btn-link" t-on-click="openFullPage"
                                title="Ouvrir en pleine page">
                            <i class="fa fa-expand"/>
                        </button>
                        <button class="btn btn-sm btn-link o_nc_panel_close"
                                t-on-click="() => props.close()" title="Fermer (Échap)">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                </header>
                <div class="o_nc_panel_body">
                    <NcBrowserApp/>
                </div>
                <div class="o_nc_panel_grip" title="Redimensionner"
                     t-on-pointerdown="startResize"
                     t-on-pointermove="onResizeMove"
                     t-on-pointerup="stopResize"
                     t-on-pointercancel="stopResize"/>
            </section>
        </div>
    </t>

</templates>
