<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_process_node_form" model="ir.ui.view">
        <field name="name">bf.process.node.form</field>
        <field name="model">bf.process.node</field>
        <field name="arch" type="xml">
            <form string="Node">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ouvrir_matrice" type="object"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="knowledge_item_count == 0">
                            <field name="knowledge_item_count" widget="statinfo"
                                   string="Why"/>
                        </button>
                        <button name="action_ouvrir_page_atelier" type="object"
                                class="oe_stat_button" icon="fa-qrcode"
                                invisible="resource_count == 0">
                            <field name="resource_count" widget="statinfo"
                                   string="Workshop page"/>
                        </button>
                        <button name="action_ouvrir_rencontres" type="object"
                                class="oe_stat_button" icon="fa-comments-o"
                                invisible="meeting_count == 0">
                            <field name="meeting_count" widget="statinfo"
                                   string="Where it was said"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Verb + object"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="tone" invisible="kind != 'note'"/>
                            <field name="diagram_id"/>
                            <field name="lane_id"
                                   domain="[('diagram_id', '=', diagram_id)]"/>
                            <field name="child_diagram_id" invisible="kind != 'sub'"
                                   string="Expanded at level"
                                   domain="[('process_id', '=', process_id)]"/>
                            <field name="process_id" invisible="1"/>
                        </group>
                        <group string="Validation"
                               invisible="kind not in ['task','send','receive','user','sub']">
                            <field name="validation" widget="badge"
                                   decoration-success="validation == 'validee'"
                                   decoration-warning="validation == 'partielle'"
                                   decoration-danger="validation == 'conteste'"/>
                            <field name="valide_proprietaire"/>
                            <field name="valide_executant"/>
                            <field name="conteste"/>
                            <field name="note_validation"
                                   placeholder="What was said at review"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="bpmn_id" groups="base.group_no_one"/>
                            <field name="col"/>
                            <field name="row"/>
                            <field name="width" groups="base.group_no_one"/>
                            <field name="height" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resources" name="ressources"
                              invisible="kind == 'note'">
                            <p class="text-muted">
                                What you need at hand to perform the step. It is what the QR code on the printed map opens.
                            </p>
                            <field name="resource_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="name"/>
                                    <field name="attachment_id"
                                           widget="many2one"
                                           options="{'no_create': True}"/>
                                    <field name="document_id"
                                           options="{'no_create': True}"/>
                                    <field name="url" widget="url"/>
                                    <field name="note" optional="hide"/>
                                    <field name="critique" optional="hide"/>
                                    <button name="action_ouvrir" type="object"
                                            icon="fa-external-link"
                                            title="Open the resource"/>
                                </list>
                            </field>
                        </page>
                        <page string="Why this step" name="tracabilite">
                            <p class="text-muted">
                                The decision that produced the step. The item's record holds the decision maker, the rationale and the alternatives set aside; the meeting report is derived from there, it is not entered by hand.
                            </p>
                            <field name="knowledge_item_ids" widget="many2many"
                                   options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="item_type" optional="show"/>
                                    <field name="decision_date" optional="show"/>
                                    <field name="decision_maker_id" optional="show"/>
                                    <field name="state" optional="show"/>
                                </list>
                            </field>
                            <!-- Les comptes rendus s'ouvrent par le bouton
                                 « Où ça s'est dit » : les lister ici demanderait
                                 un champ typé sur meeting.record, donc une
                                 dépendance obligatoire à bf_meeting. -->
                            <field name="tracee" invisible="1"/>
                            <field name="meeting_count" invisible="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bf_process_node_list" model="ir.ui.view">
        <field name="name">bf.process.node.list</field>
        <field name="model">bf.process.node</field>
        <field name="arch" type="xml">
            <list string="Nodes">
                <field name="process_id"/>
                <field name="diagram_id"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="lane_id"/>
                <field name="validation" widget="badge"
                       decoration-success="validation == 'validee'"
                       decoration-warning="validation == 'partielle'"
                       decoration-danger="validation == 'conteste'"/>
            </list>
        </field>
    </record>

    <record id="view_bf_process_node_search" model="ir.ui.view">
        <field name="name">bf.process.node.search</field>
        <field name="model">bf.process.node</field>
        <field name="arch" type="xml">
            <search string="Nodes">
                <field name="name"/>
                <field name="process_id"/>
                <field name="diagram_id"/>
                <filter name="activites" string="Activities"
                        domain="[('kind', 'in', ['task', 'send', 'receive', 'user', 'sub'])]"/>
                <filter name="a_valider" string="To validate"
                        domain="[('validation', '=', 'a_valider'),
                                 ('kind', 'in', ['task','send','receive','user','sub'])]"/>
                <filter name="contestees" string="Disputed steps"
                        domain="[('validation', '=', 'conteste')]"/>
                <separator/>
                <filter name="fragilites" string="Weak points found"
                        domain="[('tone', '=', 'risk')]"/>
                <filter name="pistes" string="Improvement ideas"
                        domain="[('tone', '=', 'ai')]"/>
                <group expand="0" string="Group by">
                    <filter name="par_niveau" string="Level"
                            context="{'group_by': 'diagram_id'}"/>
                    <filter name="par_couloir" string="Lane"
                            context="{'group_by': 'lane_id'}"/>
                    <filter name="par_type" string="Type"
                            context="{'group_by': 'kind'}"/>
                    <filter name="par_validation" string="Validation"
                            context="{'group_by': 'validation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_process_node" model="ir.actions.act_window">
        <field name="name">Nodes</field>
        <field name="res_model">bf.process.node</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
