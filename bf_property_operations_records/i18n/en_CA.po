#. module: bf_property_operations_records
#. odoo-python
#: code:addons/bf_property_operations_records/models/maintenance_request.py:0
msgid "%(date)s, %(work)s : %(reason)s (constaté à l'exploitation)"
msgstr "%(date)s, %(work)s: %(reason)s (found in operations)"

#. module: bf_property_operations_records
#. odoo-python
#: code:addons/bf_property_operations_records/models/maintenance_request.py:0
msgid ""
"<p>Entretien prévu non effectué, constaté à l'exploitation (r. 8.01, art. "
"4). Le carnet porte déjà une raison écrite : celle-ci ne l'écrase "
"pas.</p><ul><li>Bien : %(item)s</li><li>Occurrence : "
"%(reason)s</li><li>Travail : %(work)s</li></ul>"
msgstr ""
"<p>Planned maintenance not done, found in operations (r. 8.01, s. 4). The "
"log already carries a written reason: this one does not overwrite "
"it.</p><ul><li>Item: %(item)s</li><li>Occurrence: %(reason)s</li><li>Work: "
"%(work)s</li></ul>"

#. module: bf_property_operations_records
#. odoo-python
#: code:addons/bf_property_operations_records/models/maintenance_request.py:0
msgid ""
"<p>Entretien prévu non effectué, porté au carnet depuis l'exploitation (r. "
"8.01, art. 4).</p><ul><li>Bien : %(item)s</li><li>Raison : "
"%(reason)s</li><li>Travail : %(work)s</li></ul>"
msgstr ""
"<p>Planned maintenance not done, recorded in the log from operations (r. "
"8.01, s. 4).</p><ul><li>Item: %(item)s</li><li>Reason: "
"%(reason)s</li><li>Work: %(work)s</li></ul>"

#. module: bf_property_operations_records
#. odoo-python
#: code:addons/bf_property_operations_records/models/maintenance_request.py:0
msgid ""
"<p>Entretien requis daté au carnet depuis l'exploitation (r. 8.01, art. 2 "
"al. 2, par. 2°).</p><ul><li>Bien : %(item)s</li><li>Dernier entretien : "
"%(date)s%(previous)s</li><li>Travail : %(work)s</li></ul>"
msgstr ""
"<p>Required maintenance dated in the log from operations (r. 8.01, s. 2 "
"para. 2, subpara. 2).</p><ul><li>Item: %(item)s</li><li>Last maintenance: "
"%(date)s%(previous)s</li><li>Work: %(work)s</li></ul>"

#. module: bf_property_operations_records
#. odoo-python
#: code:addons/bf_property_operations_records/models/maintenance_request.py:0
msgid ""
"<p>Réparation courante datée au carnet depuis l'exploitation (r. 8.01, art. "
"2 al. 2, par. 3°).</p><ul><li>Bien : %(item)s</li><li>Dernière réparation "
"courante : %(date)s%(previous)s</li><li>Travail : %(work)s</li></ul>"
msgstr ""
"<p>Ordinary repair dated in the log from operations (r. 8.01, s. 2 para. 2, "
"subpara. 3).</p><ul><li>Item: %(item)s</li><li>Last ordinary repair: "
"%(date)s%(previous)s</li><li>Work: %(work)s</li></ul>"

