        </record>

        <!-- PrivateBin -->
        <record id="software_privatebin" model="hosting.software">
            <field name="name">PrivateBin</field>
            <field name="code">PB</field>
            <field name="software_type">self_hosted</field>
            <field name="latest_version">1.7.4</field>
            <field name="latest_version_date">2024-09-01</field>
            <field name="github_url">https://github.com/PrivateBin/PrivateBin</field>
            <field name="docker_image">privatebin/nginx-fpm-alpine:latest</field>
            <field name="notes">&lt;p&gt;Zero-knowledge encrypted pastebin.&lt;/p&gt;</field>
        </record>

        <!-- Grist -->
        <record id="software_grist" model="hosting.software">
            <field name="name">Grist</field>
            <field name="code">GR</field>
            <field name="software_type">self_hosted</field>
            <field name="latest_version">1.3.1</field>
            <field name="latest_version_date">2024-12-01</field>
