<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- 🔴 L'audience est gardée ICI, pas à l'écran : une personne hors audience
         ne lit pas la publication, même en interrogeant le modèle par RPC.

         🔴 Le domaine traverse les données (`department_ids.member_ids.user_id`)
         au lieu d'y coller la liste des départements de la personne : Odoo met en
         cache le domaine calculé par utilisateur, et une fiche d'employé changée
         de département n'invalide pas ce cache. Avec la liste, la personne
         mutée ne voyait pas les annonces de son nouveau département. -->
    <record id="rule_post_audience" model="ir.rule">
        <field name="name">Babillard : ce qui m'est adressé</field>
        <field name="model_id" ref="model_bf_babillard_post"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[
            '&amp;',
                ('state', '=', 'publie'),
                '|', '|',
                    ('audience', '=', 'tous'),
                    '&amp;', ('audience', '=', 'departements'),
                             ('department_ids.member_ids.user_id', '=', user.id),
                    '&amp;', ('audience', '=', 'groupes'),
                             ('group_ids', 'in', user.groups_id.ids)
        ]</field>
    </record>

    <record id="rule_post_redacteur" model="ir.rule">
        <field name="name">Babillard : la rédaction voit tout</field>
        <field name="model_id" ref="model_bf_babillard_post"/>
        <field name="groups" eval="[(6, 0, [ref('group_babillard_redacteur'), ref('group_babillard_moderation')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- 🔴 Multi-société. Une règle sans groupe s'applique à tout le monde, EN PLUS
         des règles de groupe : sans elle, une personne d'une autre société lisait
         les annonces « tout le personnel », et sa modération les signalements. -->
    <record id="rule_post_societe" model="ir.rule">
        <field name="name">Babillard : les publications de mes sociétés</field>
        <field name="model_id" ref="model_bf_babillard_post"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_lecture_la_mienne" model="ir.rule">
        <field name="name">Babillard : mon accusé de lecture</field>
        <field name="model_id" ref="model_bf_babillard_lecture"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_lecture_redacteur" model="ir.rule">
        <field name="name">Babillard : la rédaction voit les accusés</field>
        <field name="model_id" ref="model_bf_babillard_lecture"/>
        <field name="groups" eval="[(6, 0, [ref('group_babillard_redacteur')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_lecture_societe" model="ir.rule">
        <field name="name">Babillard : les accusés de mes sociétés</field>
        <field name="model_id" ref="model_bf_babillard_lecture"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- 🔴 Un j'aime est PERSONNEL : on ne lit et on ne retire que le sien.
         L'écran n'affiche qu'un cardinal, calculé en sudo — personne ne peut
         dresser la liste de qui a aimé quoi en interrogeant le modèle. -->
    <record id="rule_jaime_le_mien" model="ir.rule">
        <field name="name">Babillard : mon j'aime</field>
        <field name="model_id" ref="model_bf_babillard_jaime"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_jaime_societe" model="ir.rule">
        <field name="name">Babillard : les j'aime de mes sociétés</field>
        <field name="model_id" ref="model_bf_babillard_jaime"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Un signalement est confidentiel : la modération, et elle seule. La personne
         qui signale n'y a plus accès une fois qu'il est parti (voir l'assistant). -->
    <record id="rule_signalement_moderation" model="ir.rule">
        <field name="name">Babillard : la modération voit les signalements, sauf ceux qui la visent</field>
        <field name="model_id" ref="model_bf_babillard_signalement"/>
        <field name="groups" eval="[(6, 0, [ref('group_babillard_moderation')])]"/>
        <field name="domain_force">[('cible_partner_id', '!=', user.partner_id.id)]</field>
    </record>

    <record id="rule_signalement_administration" model="ir.rule">
        <field name="name">Babillard : l'administration voit les signalements remontés</field>
        <field name="model_id" ref="model_bf_babillard_signalement"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="domain_force">[('escalade', '=', True), ('cible_partner_id', '!=', user.partner_id.id)]</field>
    </record>

    <!-- 🔴 Un enregistrement transitoire n'est PAS réservé à son créateur en
         Odoo 18 : sans cette règle, tout le personnel lisait les motifs des
         dialogues en attente de purge. -->
    <record id="rule_assistant_le_mien" model="ir.rule">
        <field name="name">Babillard : mon dialogue de signalement</field>
        <field name="model_id" ref="model_bf_babillard_signalement_assistant"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_signalement_societe" model="ir.rule">
        <field name="name">Babillard : les signalements de mes sociétés</field>
        <field name="model_id" ref="model_bf_babillard_signalement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
