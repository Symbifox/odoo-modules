msgstr "Kilomètres au taux plein"

#. module: bf_route_expense
#. odoo-python
#: code:addons/bf_route_expense/models/bf_route_day.py:0
msgid "Kilometres not claimed: %s"
msgstr "Kilomètres non réclamés : %s"

#. module: bf_route_expense
#. odoo-python
#: code:addons/bf_route_expense/models/bf_route_day.py:0
msgid "Mileage beyond the yearly threshold: %(route)s, %(date)s"
msgstr "Kilométrage au-delà du seuil annuel : %(route)s, %(date)s"

#. module: bf_route_expense
#. odoo-python
#: code:addons/bf_route_expense/models/bf_route_day.py:0
