<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Credential Form View -->
    <record id="credential_view_form" model="ir.ui.view">
        <field name="name">project.credential.form</field>
        <field name="model">project.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <header>
                    <button name="action_verify" type="object" string="Verify"
                            class="oe_highlight" invisible="state == 'revoked'"/>
                    <button name="action_rotate_password" type="object" string="Rotate password"
                            invisible="state == 'revoked'"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="state == 'revoked'" confirm="Revoke this credential?"/>
                    <button name="action_reactivate" type="object" string="Reactivate"
                            invisible="state != 'revoked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expiring,expired,revoked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Restricted" bg_color="text-bg-warning"
                            invisible="not restricted"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="not is_expired"/>
                    <widget name="web_ribbon" title="2nd factor without fallback" bg_color="text-bg-warning"
                            invisible="mfa_state != 'at_risk' or is_expired"/>
                    <widget name="web_ribbon" title="Expiring soon" bg_color="text-bg-warning"
                            invisible="not is_expiring_soon or is_expired"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Production database"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="environment"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="expiration_date"/>
                            <field name="restricted"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Credentials" name="credentials">
                            <group>
                                <group>
                                    <field name="show_url" invisible="1"/>
                                    <field name="show_domain" invisible="1"/>
                                    <field name="show_api_key" invisible="1"/>
                                    <field name="show_key_file" invisible="1"/>
                                    <field name="url" widget="url" invisible="not show_url"
                                           placeholder="https://example.com/login"/>
                                    <field name="domain" invisible="not show_domain"
                                           placeholder="DOMAIN or tenant.onmicrosoft.com"/>
                                    <field name="username" placeholder="user@example.com"/>
                                    <field name="password" widget="copyable_password"/>
                                    <field name="api_key" widget="copyable_password" invisible="not show_api_key"/>
                                </group>
                                <group>
                                    <field name="last_verified" readonly="1"/>
                                    <field name="last_rotated" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Files" name="files" invisible="not show_key_file">
                            <group>
                                <group>
                                    <field name="key_file" filename="key_filename"/>
                                    <field name="key_filename" invisible="1"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Supported formats:</strong> .pem, .key, .p12, .ppk, .cer, .crt
                            </div>
                        </page>
                        <page string="Second factor" name="mfa">
                            <div class="alert alert-info" role="alert">
                                This register says <strong>where</strong> the second factor lives and <strong>who</strong> can produce a code. It never keeps the seed: stored here, it would sit in the same database as the password it protects, which would leave only one factor.
                            </div>
                            <group>
                                <group>
                                    <field name="mfa_type"/>
                                    <field name="mfa_vault_id"
                                           invisible="mfa_type in ('unknown', 'none')"
                                           options="{'no_quick_create': True}"/>
                                    <field name="mfa_reference"
                                           invisible="mfa_type in ('unknown', 'none')"
                                           placeholder="e.g. &quot;Production server&quot; item in the vault"/>
                                    <field name="mfa_item_url" widget="url"
                                           readonly="1" invisible="not mfa_item_url"/>
                                </group>
                                <group>
                                    <field name="mfa_holder_ids" widget="many2many_tags"
                                           invisible="mfa_type in ('unknown', 'none')"
                                           options="{'no_create': True}"/>
                                    <field name="mfa_holder_note"
                                           invisible="mfa_type in ('unknown', 'none')"
                                           placeholder="e.g. token in the reception desk drawer"/>
                                    <field name="mfa_recovery"
                                           invisible="mfa_type in ('unknown', 'none')"/>
                                    <field name="mfa_last_reviewed"/>
                                    <field name="mfa_state" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="mfa_state != 'at_risk'">
                                This second factor has no named person to produce it, or no written recovery. The day its holder disappears, access is blocked.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional instructions or information..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Credential List View -->
    <record id="credential_view_list" model="ir.ui.view">
        <field name="name">project.credential.list</field>
        <field name="model">project.credential</field>
        <field name="arch" type="xml">
            <!-- L'orange dit « ça demande de l'attention », sans préciser
                 laquelle : l'expiration proche OU un deuxième facteur sans
                 relève. La colonne « État du 2e facteur » dit laquelle des
                 deux, et une seule décoration par couleur est possible. -->
            <list string="Credentials" decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring' or mfa_state == 'at_risk'"
                  decoration-muted="state == 'revoked'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="type_id"/>
                <field name="environment" optional="show"/>
                <field name="username"/>
                <field name="url" widget="url" optional="hide"/>
                <field name="expiration_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state == 'revoked'"/>
                <field name="restricted" optional="hide"/>
                <field name="mfa_type" optional="hide"/>
                <field name="mfa_state" widget="badge" optional="show"
                       decoration-success="mfa_state == 'covered'"
                       decoration-warning="mfa_state == 'at_risk'"
                       decoration-info="mfa_state == 'unknown'"
                       decoration-muted="mfa_state == 'absent'"/>
            </list>
        </field>
    </record>

    <!-- Credential Kanban View -->
    <record id="credential_view_kanban" model="ir.ui.view">
        <field name="name">project.credential.kanban</field>
        <field name="model">project.credential</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="type_id">
                <field name="name"/>
                <field name="project_id"/>
                <field name="type_id"/>
                <field name="username"/>
                <field name="state"/>
                <field name="restricted"/>
                <field name="is_expiring_soon"/>
                <field name="is_expired"/>
                <field name="environment"/>
                <field name="mfa_state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <span t-if="record.restricted.raw_value" class="badge text-bg-warning">
                                <i class="fa fa-lock"/> Restricted
                            </span>
                        </div>
                        <div class="text-muted">
                            <field name="project_id"/>
                        </div>
                        <div t-if="record.username.value" title="Username">
                            <i class="fa fa-user" title="Username"/> <field name="username"/>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span class="badge" t-attf-class="#{record.state.raw_value == 'active' ? 'text-bg-success' : record.state.raw_value == 'expiring' ? 'text-bg-warning' : record.state.raw_value == 'expired' ? 'text-bg-danger' : 'text-bg-secondary'}">
                                <field name="state"/>
                            </span>
                            <span class="badge text-bg-info">
                                <field name="environment"/>
                            </span>
                            <span t-if="record.mfa_state.raw_value == 'at_risk'"
                                  class="badge text-bg-warning" title="Second factor without fallback">
                                <i class="fa fa-shield" title="Second factor without fallback"/> No fallback
                            </span>
                            <span t-if="record.mfa_state.raw_value == 'unknown'"
                                  class="badge text-bg-light" title="Second factor to document">
                                <i class="fa fa-question" title="Second factor to document"/> 2nd factor?
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Credential Search View -->
    <record id="credential_view_search" model="ir.ui.view">
        <field name="name">project.credential.search</field>
        <field name="model">project.credential</field>
        <field name="arch" type="xml">
            <search string="Credentials">
                <field name="name"/>
                <field name="project_id"/>
                <field name="type_id"/>
                <field name="username"/>
                <field name="url"/>
                <field name="reference"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Expiring soon" name="filter_expiring" domain="[('state', '=', 'expiring')]"/>
                <filter string="Expired" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Revoked" name="filter_revoked" domain="[('state', '=', 'revoked')]"/>
                <separator/>
                <filter string="Production" name="filter_production" domain="[('environment', '=', 'production')]"/>
                <filter string="Staging" name="filter_staging" domain="[('environment', '=', 'staging')]"/>
                <filter string="Development" name="filter_development" domain="[('environment', '=', 'development')]"/>
                <separator/>
                <filter string="Restricted" name="filter_restricted" domain="[('restricted', '=', True)]"/>
                <separator/>
                <filter string="2nd factor to document" name="filter_mfa_unknown"
                        domain="[('mfa_state', '=', 'unknown')]"/>
                <filter string="2nd factor without fallback" name="filter_mfa_at_risk"
                        domain="[('mfa_state', '=', 'at_risk')]"/>
                <filter string="Without second factor" name="filter_mfa_absent"
                        domain="[('mfa_state', '=', 'absent')]"/>
                <filter string="2nd factor covered" name="filter_mfa_covered"
                        domain="[('mfa_state', '=', 'covered')]"/>
                <!-- La vraie liste de départ avant un congé ou un départ : un
                     facteur chez un porteur que personne d'autre ne peut
                     ouvrir. Deux des cinq porteurs semés sont dans ce cas,
                     l'appareil d'une personne et le jeton matériel. -->
                <filter string="Single-person holder" name="filter_mfa_sole_holder"
                        domain="[('mfa_vault_id.shared', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group by">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Environment" name="group_environment" context="{'group_by': 'environment'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Second factor" name="group_mfa_type" context="{'group_by': 'mfa_type'}"/>
                    <filter string="2nd factor status" name="group_mfa_state" context="{'group_by': 'mfa_state'}"/>
                    <filter string="Factor holder" name="group_mfa_vault" context="{'group_by': 'mfa_vault_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Credential Action -->
    <record id="credential_action" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">project.credential</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="credential_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a credential
            </p>
            <p>
                Store and manage project resource credentials securely. Passwords and API keys are encrypted at rest.
            </p>
        </field>
    </record>

    <!-- Credential Rotate Wizard Form View -->
    <record id="credential_rotate_wizard_view_form" model="ir.ui.view">
        <field name="name">project.credential.rotate.wizard.form</field>
        <field name="model">project.credential.rotate.wizard</field>
        <field name="arch" type="xml">
            <form string="Password rotation">
                <group>
                    <group>
                        <field name="credential_id" invisible="1"/>
                        <field name="credential_name"/>
                        <field name="project_id"/>
                    </group>
                    <group>
                        <field name="current_password" password="True" readonly="1"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="new_password" password="True"/>
                        <field name="confirm_password" password="True"/>
                    </group>
                    <group>
                        <field name="rotation_reason"/>
                    </group>
                </group>
                <group>
                    <field name="notes" placeholder="Optional notes on this rotation..."/>
                </group>
                <footer>
                    <button name="action_rotate" type="object" string="Rotate password" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
