<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_nfc_template_form_tournee" model="ir.ui.view">
        <field name="name">bf.nfc.template.form.tournee</field>
        <field name="model">bf.nfc.template</field>
        <field name="inherit_id" ref="bf_nfc.view_bf_nfc_template_form"/>
        <field name="arch" type="xml">
            <group name="cree" position="inside">
                <field name="round_schedule" invisible="recette != 'tournee'"/>
                <field name="round_start_hour" widget="float_time" invisible="recette != 'tournee' or round_schedule == 'none'"/>
                <field name="round_duration" invisible="recette != 'tournee'"/>
                <field name="round_strict_order" invisible="recette != 'tournee'"/>
            </group>
        </field>
    </record>
</odoo>
