#. module: bf_employee_experience_pulse
#: model:mail.template,body_html:bf_employee_experience_pulse.mail_template_pulse_invite
msgid ""
"<t t-set=\"societe\" t-value=\"object.campaign_id.company_id or user.company_id\"/>\n"
"<t t-set=\"marque\" t-value=\"object.env['bf.ex.pulse.marque'].couleurs(societe)\"/>\n"
"<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#F8FAFC;\">\n"
"  <tbody><tr><td align=\"center\" style=\"padding:24px;\">\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"width:600px; max-width:600px; margin:0 auto; background-color:#FFFFFF; border-radius:12px; border:1px solid #E5E7EB; border-collapse:collapse;\">\n"
"      <tbody>\n"
"        <tr>\n"
"          <td t-attf-style=\"background-color:{{ marque['sombre'] }}; padding:16px 24px; border-radius:12px 12px 0 0;\">\n"
"            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tbody><tr>\n"
"              <td align=\"left\">\n"
"                <img t-att-src=\"marque['logo']\" alt=\"\" style=\"height:40px; width:auto; display:block; border:0;\"/>\n"
"              </td>\n"
"              <td align=\"right\" t-attf-style=\"color:{{ marque['texte_sur_sombre'] }}; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:20px; font-weight:800; letter-spacing:0.2px;\">\n"
"                Your pulse\n"
"              </td>\n"
"            </tr></tbody></table>\n"
"          </td>\n"
"        </tr>\n"
"        <tr><td t-attf-style=\"height:4px; line-height:4px; background-color:{{ marque['accent'] }};\">&amp;#160;</td></tr>\n"
"        <tr>\n"
"          <td style=\"padding:24px; font-family:'Lexend','Segoe UI',Arial,sans-serif; color:#2E3132;\">\n"
"            <p style=\"font-size:15px; margin:0 0 12px 0;\">Hello,</p>\n"
"            <p style=\"font-size:15px; margin:0 0 12px 0;\">\n"
"              Here is your link for the\n"
"              <b t-out=\"object.campaign_id.name or ''\"/> wave. It takes two minutes.\n"
"            </p>\n"
"            <div style=\"text-align:center; margin:28px 0;\">\n"
"              <a t-attf-href=\"{{ object.campaign_id.get_base_url() }}/pulse/{{ object.token }}\" t-attf-style=\"background-color:{{ marque['bouton'] }}; color:#FFFFFF; text-decoration:none; padding:12px 28px; border-radius:6px; font-size:15px; font-weight:600; display:inline-block;\">\n"
"                Answer\n"
"              </a>\n"
"            </div>\n"
"            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" t-attf-style=\"border-left:3px solid {{ marque['accent'] }}; background-color:#F8FAFC; border-radius:0 6px 6px 0;\">\n"
"              <tbody><tr><td style=\"padding:12px 16px; font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:13px; color:#4B5563;\">\n"
"                Your answers do not carry your name. The link knows that you have\n"
"                answered, so nobody chases you for nothing, and it keeps neither\n"
"                the time nor the content of your answer. A result only appears\n"
"                above <t t-out=\"object.campaign_id.score_threshold or 3\"/>\n"
"                respondents.\n"
"              </td></tr></tbody>\n"
"            </table>\n"
"            <p style=\"font-size:13px; color:#6B7280; margin:16px 0 0 0;\">\n"
"              This link is personal: it works once only, and that is what\n"
"              stops the same person weighing twice in the result. Do not\n"
"              forward it.\n"
"            </p>\n"
"          </td>\n"
"        </tr>\n"
"        <tr>\n"
"          <td style=\"padding:16px 24px 20px 24px; border-top:1px solid #E5E7EB;\">\n"
"            <p style=\"font-family:'Lexend','Segoe UI',Arial,sans-serif; font-size:12px; color:#6B7280; margin:0;\">\n"
"              <t t-if=\"societe.name\"><b t-out=\"societe.name\"/><br/></t>\n"
"              Automatic message, sent when a pulse wave opens.\n"
"            </p>\n"
"          </td>\n"
"        </tr>\n"
"      </tbody>\n"
"    </table>\n"
"  </td></tr></tbody>\n"
"</table>"
msgstr ""

