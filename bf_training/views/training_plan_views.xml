<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_plan_list" model="ir.ui.view">
        <field name="name">bf.training.plan.list</field>
        <field name="model">bf.training.plan</field>
        <field name="arch" type="xml">
            <list string="Plans de formation" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="consultation_date"/>
                <field name="consultation_proven" widget="boolean_toggle" readonly="1"/>
                <field name="record_count" string="Réalisations"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_training_plan_form" model="ir.ui.view">
        <field name="name">bf.training.plan.form</field>
        <field name="model">bf.training.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de formation">
                <header>
                    <button name="action_mark_consulted" type="object" string="Marquer consulté"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approuver"
                            class="btn-primary" invisible="state != 'consulted'"/>
                    <button name="action_close" type="object" string="Clore"
                            invisible="state != 'approved'"/>
                    <button name="action_reset" type="object" string="Remettre en brouillon"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,consulted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Plan de formation 2027"/></h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Consultation">
                            <field name="consultation_date"/>
                            <field name="consultation_proven"/>
                            <field name="committee_member_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="consultation_proven">
                        Le plan se conserve avec la preuve qu'il a été consulté.
                        Sans la date et la pièce, la consultation n'est pas prouvée,
                        et c'est elle qui rend la formation donnée par l'entreprise
                        admissible.
                    </div>
                    <notebook>
                        <page string="Ce qui a été consulté" name="consultation">
                            <field name="consultation_note"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Activités prévues" name="activites">
                            <field name="activity_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="mode"/>
                                    <field name="duration_hours" sum="Heures"/>
                                </list>
                            </field>
                        </page>
                        <page string="Réalisations" name="realisations">
                            <field name="record_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="activity_id"/>
                                    <field name="date_done"/>
                                    <field name="hours" sum="Heures"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_training_plan" model="ir.actions.act_window">
        <field name="name">Plans de formation</field>
        <field name="res_model">bf.training.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Écrire le plan</p>
            <p>Le plan porte deux choses qui ne vivent nulle part ailleurs : la
               durée d'apprentissage établie à l'avance, et la preuve de la
               consultation tenue sur ce plan.</p>
        </field>
    </record>
</odoo>
