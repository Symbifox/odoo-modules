<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_school" model="ir.module.category">
        <field name="name">School</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_school_user" model="res.groups">
        <field name="name">Staff</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Teachers and staff: they read schools, groups, students and
            families, and change nothing.</field>
    </record>

    <record id="group_school_manager" model="res.groups">
        <field name="name">Administration</field>
        <field name="category_id" ref="module_category_school"/>
        <!-- 🔴 The office creates students and families: without Contact Creation, a fresh
             base refused every enrolment (found in QA, 2026-09-27). -->
        <field name="implied_ids" eval="[(4, ref('group_school_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Office and management: they create schools, years, groups,
            enrolments and guardian links.</field>
    </record>

    <!-- Multi-company: a rule without a group applies to everyone, on top of the rest. -->
    <record id="rule_school_company" model="ir.rule">
        <field name="name">School: my companies</field>
        <field name="model_id" ref="model_bf_school"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_year_company" model="ir.rule">
        <field name="name">School year: my companies</field>
        <field name="model_id" ref="model_bf_school_year"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_group_company" model="ir.rule">
        <field name="name">School group: my companies</field>
        <field name="model_id" ref="model_bf_school_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_enrollment_company" model="ir.rule">
        <field name="name">Enrolment: my companies</field>
        <field name="model_id" ref="model_bf_school_enrollment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- 🔴 A student card may have no company (a shared contact): the link follows it. -->
    <record id="rule_school_guardian_link_company" model="ir.rule">
        <field name="name">Guardian link: my companies</field>
        <field name="model_id" ref="model_bf_school_guardian_link"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
