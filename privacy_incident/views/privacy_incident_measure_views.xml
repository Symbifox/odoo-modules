<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_privacy_incident_measure_list" model="ir.ui.view">
        <field name="name">privacy.incident.measure.list</field>
        <field name="model">privacy.incident.measure</field>
        <field name="arch" type="xml">
            <list string="Mesures">
                <field name="sequence" widget="handle"/>
                <field name="incident_id"/>
                <field name="name"/>
                <field name="measure_type"/>
                <field name="responsible_id"/>
                <field name="date_planned"/>
                <field name="date_done"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_privacy_incident_measure_form" model="ir.ui.view">
        <field name="name">privacy.incident.measure.form</field>
        <field name="model">privacy.incident.measure</field>
        <field name="arch" type="xml">
            <form string="Mesure">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ce qui a été fait"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="incident_id"/>
                            <field name="measure_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="date_planned"/>
                            <field name="date_done"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" nolabel="1" placeholder="Précisions"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_privacy_incident_measure" model="ir.actions.act_window">
        <field name="name">Mesures</field>
        <field name="res_model">privacy.incident.measure</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
