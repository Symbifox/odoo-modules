<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secure_transfer_template_list" model="ir.ui.view">
        <field name="name">secure.transfer.template.list</field>
        <field name="model">secure.transfer.template</field>
        <field name="arch" type="xml">
            <list string="Data room presets">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="audience_mode"/>
                <field name="retention_days"/>
                <field name="audience_max"/>
                <field name="audience_max_downloads"/>
                <field name="brand_id" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_secure_transfer_template_form" model="ir.ui.view">
        <field name="name">secure.transfer.template.form</field>
        <field name="model">secure.transfer.template</field>
        <field name="arch" type="xml">
            <form string="Data room preset">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Data room: standard"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <group>
                        <group string="Scope">
                            <field name="brand_id"
                                   options="{'no_create': True}"
                                   placeholder="Keep the brand chosen when sending"/>
                            <field name="audience_mode"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group string="What the link grants">
                            <field name="retention_days"/>
                            <field name="audience_max"
                                   invisible="audience_mode != 'open'"/>
                            <field name="audience_max_downloads"
                                   invisible="audience_mode != 'open'"/>
                            <field name="notify_on_join"
                                   invisible="audience_mode != 'open'"/>
                        </group>
                    </group>
                    <group string="Who can enter" invisible="audience_mode != 'open'">
                        <field name="audience_domains" nolabel="1" colspan="2"
                               placeholder="@client.com&#10;buyer@example.com"/>
                        <field name="audience_allow_sms"/>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1" colspan="2"
                               placeholder="The kind of file it is meant for, not the values: they are just above."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_secure_transfer_template" model="ir.actions.act_window">
        <field name="name">Data room presets</field>
        <field name="res_model">secure.transfer.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a preset</p>
            <p>A preset replays the configuration of a data room: duration, visitor cap, per-person download budget, allowed domains. The sender picks it in the wizard, and everything fills in.</p>
            <p>Leave the brand empty so that it applies to the one already chosen.</p>
        </field>
    </record>

</odoo>
