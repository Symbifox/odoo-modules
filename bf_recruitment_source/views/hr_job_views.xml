<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_job_form_source" model="ir.ui.view">
        <field name="name">hr.job.form.source</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_survey"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_untracked_applicants" icon="fa-question-circle"
                        groups="hr_recruitment.group_hr_recruitment_user"
                        invisible="untracked_applicant_count == 0">
                    <field name="untracked_applicant_count" widget="statinfo"
                           string="Sans source"/>
                </button>
            </div>

            <sheet position="inside">
                <group string="Sources d'affichage"
                       groups="hr_recruitment.group_hr_recruitment_user">
                    <field name="source_count" invisible="1"/>
                    <!-- Commande l'affichage de la liste et de l'encadré. -->

                    <group>
                        <field name="source_click_count"/>
                        <field name="sourced_applicant_count"/>
                    </group>
                    <group>
                        <field name="untracked_applicant_count"
                               decoration-warning="untracked_applicant_count > 0"/>
                        <field name="source_coverage_rate"/>
                    </group>

                    <field name="source_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="source_id" string="Site"
                                   placeholder="p. ex. SEEK"/>
                            <field name="medium_id" optional="hidden"/>
                            <field name="tracked_url" string="Lien à publier"
                                   widget="CopyClipboardChar" readonly="1"/>
                            <field name="click_count" readonly="1"/>
                            <field name="applicant_count" readonly="1"/>
                            <field name="hired_count" readonly="1" optional="show"/>
                            <field name="refused_count" readonly="1" optional="hidden"/>
                            <field name="conversion_rate" readonly="1"/>
                            <field name="hire_rate" readonly="1" optional="hidden"/>
                            <field name="stat_is_partial" column_invisible="1"/>
                            <field name="stat_warning" string="À savoir"
                                   readonly="1" optional="show"
                                   decoration-warning="stat_is_partial"/>
                        </list>
                    </field>

                    <div class="alert alert-warning" role="alert" colspan="2"
                         invisible="not source_warning">
                        <field name="source_warning" nolabel="1" readonly="1"/>
                    </div>
                </group>
            </sheet>
        </field>
    </record>

</odoo>
