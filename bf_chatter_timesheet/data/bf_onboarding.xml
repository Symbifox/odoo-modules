<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="bf_onb_step_settings" model="onboarding.onboarding.step">
        <field name="title">Configurer le timesheet chatter</field>
        <field name="description">Activez la saisie rapide de feuilles de temps depuis le chatter et ajustez les arrondis par défaut.</field>
        <field name="button_text">Ouvrir Paramètres</field>
        <field name="done_text">Saisie rapide active</field>
        <field name="panel_step_open_action_name">bf_open_res_config_settings</field>
        <field name="sequence">1</field>
    </record>
    <record id="bf_onboarding_panel" model="onboarding.onboarding">
        <field name="name">Chatter Timesheet</field>
        <field name="route_name">bf_chatter_timesheet_onboarding</field>
        <field name="panel_close_action_name">action_close_panel_bf_chatter_timesheet</field>
        <field name="step_ids" eval="[Command.link(ref('bf_chatter_timesheet.bf_onb_step_settings'))]"/>
    </record>
</odoo>
