#. module: bf_shift
#. odoo-python
#: code:addons/bf_shift/models/assignment.py:0
msgid ""
"%(when)s: %(hours)s h of rest since the previous shift, the agreement asks "
"for %(limit)s h."
msgstr ""
"%(when)s : %(hours)s h de repos depuis le quart précédent, la convention en "
"demande %(limit)s."

#. module: bf_shift
#. odoo-python
#: code:addons/bf_shift/models/assignment.py:0
msgid ""
"%(when)s: %(hours)s h that day, beyond the usual day plus 2 hours (%(limit)s"
" h). The employee may refuse (LNT art. 59.0.1)."
msgstr ""
"%(when)s : %(hours)s h ce jour-là, au-delà de la journée habituelle plus 2 "
"heures (%(limit)s h). La personne peut refuser (LNT, art. 59.0.1)."

#. module: bf_shift
#. odoo-python
#: code:addons/bf_shift/models/assignment.py:0
msgid ""
"%(when)s: %(hours)s h within 24 hours, more than %(limit)s. The employee may"
" refuse (LNT art. 59.0.1)."
msgstr ""
"%(when)s : %(hours)s h en 24 heures, plus de %(limit)s. La personne peut "
"refuser (LNT, art. 59.0.1)."

#. module: bf_shift
#. odoo-python
#: code:addons/bf_shift/models/assignment.py:0
msgid ""
"%(when)s: no %(minutes)s-minute meal break after %(after)s hours (LNT art. "
"79)."
msgstr ""
"%(when)s : pas de pause repas de %(minutes)s minutes après %(after)s heures "
"(LNT, art. 79)."

#. module: bf_shift
#. odoo-python
#: code:addons/bf_shift/models/assignment.py:0
msgid ""
"%(when)s: told %(days)s day(s) ahead, fewer than %(limit)s. The employee may"
" refuse it (LNT art. 59.0.1)."
msgstr ""
"%(when)s : avisé %(days)s jour(s) d'avance, moins de %(limit)s. La personne "
"peut refuser ce quart (LNT, art. 59.0.1)."

