<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Le lecteur : une carte par nouvelle, ce qui est lu s'en va. -->
    <record id="flux_element_kanban_lecteur" model="ir.ui.view">
        <field name="name">bf.flux.element.kanban.lecteur</field>
        <field name="model">bf.flux.element</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_bf_flux_lecteur" can_open="0">
                <field name="lien"/>
                <field name="image_url"/>
                <field name="lu"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <div t-attf-class="d-flex flex-column h-100 {{ record.lu.raw_value ? 'opacity-50' : '' }}">
                            <img t-if="record.image_url.raw_value" t-att-src="record.image_url.raw_value"
                                 alt="" loading="lazy" referrerpolicy="no-referrer"
                                 style="width:100%;height:150px;object-fit:cover;border-radius:4px 4px 0 0;"/>
                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <field name="sources_noms"/>
                                    <span><field name="date_publication" widget="datetime" options="{'show_seconds': false}"/></span>
                                </div>
                                <!-- Un vrai lien : la route marque lu puis mène à l'article,
                                     sans passer par une fenêtre qu'un navigateur bloquerait. -->
                                <a t-att-href="'/flux/lire/' + record.id.raw_value" target="_blank"
                                   class="fw-bold fs-5 text-reset mb-2" style="line-height:1.3;">
                                    <field name="titre"/>
                                </a>
                                <div class="text-muted small mb-2" t-if="record.emetteur.raw_value">
                                    <field name="emetteur"/>
                                </div>
                                <div class="mb-3" style="display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;">
                                    <field name="resume"/>
                                </div>
                                <div class="mt-auto d-flex gap-2 align-items-center">
                                    <button type="object" name="action_lire" class="btn btn-primary btn-sm">Lire</button>
                                    <button t-if="!record.lu.raw_value" type="object" name="action_marquer_lu"
                                            class="btn btn-secondary btn-sm">Marquer lu</button>
                                    <button t-if="record.lu.raw_value" type="object" name="action_marquer_non_lu"
                                            class="btn btn-link btn-sm">Remettre à lire</button>
                                    <button type="object" name="action_poser_projet" class="btn btn-link btn-sm ms-auto"
                                            title="Poser au fil d'un projet"><i class="fa fa-thumb-tack" title="Poser au fil d'un projet"/></button>
                                </div>
                                <div class="small text-muted mt-2"><field name="listes_noms"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="flux_element_search_lecteur" model="ir.ui.view">
        <field name="name">bf.flux.element.search.lecteur</field>
        <field name="model">bf.flux.element</field>
        <field name="inherit_id" ref="flux_element_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='retenus']" position="before">
                <filter name="pour_moi" string="Dans mes listes" domain="[('pour_moi', '=', True)]"/>
                <!-- ⚠️ Séparés : deux filtres d'un même groupe se combinent par OU,
                     et « mes listes OU non lus » garde tout ce qui est lu. -->
                <separator/>
                <filter name="non_lus" string="Non lus" domain="[('lu', '=', False)]"/>
                <filter name="lus" string="Lus" domain="[('lu', '=', True)]"/>
                <separator/>
                <filter name="aujourd_hui" string="Aujourd'hui"
                        domain="[('date_publication', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <separator/>
            </xpath>
            <xpath expr="//field[@name='source_ids']" position="after">
                <field name="retenue_ids" string="Liste" filter_domain="[('retenue_ids.liste_id', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_flux_a_lire" model="ir.actions.act_window">
        <field name="name">À lire</field>
        <field name="res_model">bf.flux.element</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="path">a-lire</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('flux_element_kanban_lecteur')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('flux_element_list')})]"/>
        <field name="search_view_id" ref="flux_element_search"/>
        <field name="context">{'search_default_pour_moi': 1, 'search_default_non_lus': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tout est lu</p>
            <p>Les nouvelles de vos listes arrivent ici. Une nouvelle ouverte ou marquée lue s'en va.</p>
        </field>
    </record>

    <record id="action_flux_marquer_lu" model="ir.actions.server">
        <field name="name">Marquer comme lu</field>
        <field name="model_id" ref="model_bf_flux_element"/>
        <field name="binding_model_id" ref="model_bf_flux_element"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_marquer_lu()</field>
    </record>
</odoo>
