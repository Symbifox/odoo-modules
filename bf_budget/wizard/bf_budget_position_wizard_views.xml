<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_position_wizard_view_form" model="ir.ui.view">
        <field name="name">bf.budget.position.wizard.form</field>
        <field name="model">bf.budget.position.wizard</field>
        <field name="arch" type="xml">
            <form string="Suggest budget items">
                <p class="text-muted">
                    The budget items below are inferred from your chart of accounts, by account type. Nothing is hard-coded: a fixed catalogue would be wrong from the first company that does not have the same chart.
                </p>
                <group>
                    <field name="budget_type"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <field name="preview" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_create" string="Create budget items" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bf_budget_position_wizard_action" model="ir.actions.act_window">
        <field name="name">Suggest budget items</field>
        <field name="res_model">bf.budget.position.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
