<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_floorplan_view_form" model="ir.ui.view">
        <field name="name">bf.floorplan.form</field>
        <field name="model">bf.floorplan</field>
        <field name="arch" type="xml">
            <form string="Plan d'étage">
                <header>
                    <button name="action_figer" type="object" string="Figer"
                            invisible="verrouille" groups="bf_floorplan.group_bf_floorplan_manager"
                            help="Un plan figé se consulte et s'imprime, mais ne se modifie plus."/>
                    <button name="action_rouvrir" type="object" string="Rouvrir"
                            invisible="not verrouille" groups="bf_floorplan.group_bf_floorplan_manager"/>
                    <button name="action_imprimer" type="object" string="Imprimer"
                            class="btn-secondary" icon="fa-print"/>
                    <button name="action_telecharger_mxgraph" type="object"
                            string="Exporter (.drawio)" class="btn-secondary"
                            icon="fa-download"
                            help="Pour finir le dessin dans diagrams.net : murs, portes, fenêtres."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_zones" type="object"
                                class="oe_stat_button" icon="fa-th-large">
                            <field name="zone_count" widget="statinfo" string="Zones"/>
                        </button>
                        <button name="action_voir_elements" type="object"
                                class="oe_stat_button" icon="fa-desktop">
                            <field name="element_count" widget="statinfo" string="Éléments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Figé" bg_color="text-bg-secondary"
                            invisible="not verrouille"/>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. : Siège social — 2e étage"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="batiment"/>
                            <field name="etage"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="places"/>
                            <field name="occupes"/>
                            <field name="active" invisible="1"/>
                            <field name="verrouille" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plan" name="plan">
                            <widget name="bf_floorplan_visualiseur"/>
                        </page>
                        <page string="Zones" name="zones">
                            <field name="zone_ids" nolabel="1"
                                   context="{'default_plan_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code" optional="show"/>
                                    <field name="genre"/>
                                    <field name="x"/>
                                    <field name="y"/>
                                    <field name="w"/>
                                    <field name="h"/>
                                    <field name="capacite"/>
                                    <field name="occupes"/>
                                    <field name="element_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Éléments" name="elements">
                            <field name="element_ids" nolabel="1"
                                   context="{'default_plan_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="genre"/>
                                    <field name="zone_id"/>
                                    <field name="employee_id"/>
                                    <field name="x"/>
                                    <field name="y"/>
                                    <field name="w"/>
                                    <field name="h"/>
                                    <field name="rotation"/>
                                    <field name="lien_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Liens" name="liens">
                            <field name="lien_ids" nolabel="1"
                                   context="{'default_plan_id': id}">
                                <list editable="bottom">
                                    <field name="src_id" domain="[('plan_id', '=', parent.id)]"/>
                                    <field name="dst_id" domain="[('plan_id', '=', parent.id)]"/>
                                    <field name="genre"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fond et dimensions" name="fond">
                            <group>
                                <group string="Dimensions réelles">
                                    <field name="largeur"/>
                                    <field name="profondeur"/>
                                    <field name="pas"/>
                                </group>
                                <group string="Fond de plan">
                                    <field name="fond" widget="image" nolabel="1"
                                           options="{'size': [400, 300]}"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                Le fond est étiré aux dimensions du plan. Donnez au plan la largeur
                                et la profondeur réelles de ce que l'image montre, et la grille
                                sera à l'échelle.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_floorplan_view_list" model="ir.ui.view">
        <field name="name">bf.floorplan.list</field>
        <field name="model">bf.floorplan</field>
        <field name="arch" type="xml">
            <list string="Plans d'étage">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="batiment"/>
                <field name="etage"/>
                <field name="partner_id"/>
                <field name="zone_count"/>
                <field name="element_count"/>
                <field name="places"/>
                <field name="occupes"/>
                <field name="verrouille" widget="boolean_toggle" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="bf_floorplan_view_kanban" model="ir.ui.view">
        <field name="name">bf.floorplan.kanban</field>
        <field name="model">bf.floorplan</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="verrouille"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column p-2">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="text-muted">
                                <field name="batiment"/>
                                <t t-if="record.etage.raw_value"> · étage <field name="etage"/></t>
                            </div>
                            <div class="mt-1">
                                <field name="zone_count"/> zones ·
                                <field name="element_count"/> éléments ·
                                <field name="occupes"/>/<field name="places"/> places
                                <span t-if="record.verrouille.raw_value"
                                      class="badge text-bg-secondary ms-1">figé</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="bf_floorplan_view_search" model="ir.ui.view">
        <field name="name">bf.floorplan.search</field>
        <field name="model">bf.floorplan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="batiment"/>
                <field name="partner_id"/>
                <filter name="figes" string="Figés" domain="[('verrouille', '=', True)]"/>
                <filter name="archives" string="Archivés" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="par_batiment" string="Bâtiment" context="{'group_by': 'batiment'}"/>
                    <filter name="par_site" string="Site" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_floorplan" model="ir.actions.act_window">
        <field name="name">Plans d'étage</field>
        <field name="res_model">bf.floorplan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="bf_floorplan_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Dessinez le premier plan</p>
            <p>Un plan par étage, aux dimensions réelles. Posez-y les salles, les postes
               et les appareils : chacun devient une fiche, avec son fil et ses photos.</p>
        </field>
    </record>
</odoo>
