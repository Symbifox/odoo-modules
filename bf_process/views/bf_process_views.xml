<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_process_list" model="ir.ui.view">
        <field name="name">bf.process.list</field>
        <field name="model">bf.process</field>
        <field name="arch" type="xml">
            <list string="Cartographies"
                  decoration-info="nature == 'cible'">
                <field name="name"/>
                <field name="version"/>
                <field name="nature" widget="badge"
                       decoration-info="nature == 'cible'"/>
                <field name="partner_id"/>
                <field name="project_id" optional="show"/>
                <field name="diagram_count" string="Niveaux"/>
                <field name="node_count" string="Nœuds"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valide'"
                       decoration-muted="state == 'obsolete'"/>
            </list>
        </field>
    </record>

    <record id="view_bf_process_form" model="ir.ui.view">
        <field name="name">bf.process.form</field>
        <field name="model">bf.process</field>
        <field name="arch" type="xml">
            <form string="Cartographie">
                <header>
                    <button name="action_telecharger_pdf" type="object"
                            string="Tracer en PDF" class="btn-primary"
                            invisible="diagram_count == 0"/>
                    <button name="action_telecharger_pdf_atelier" type="object"
                            string="Tirage d'atelier (11x17 + codes QR)"
                            invisible="diagram_count == 0"
                            help="Pavé en tabloïd à l'échelle 1:1, avec un code
                                  QR sur chaque étape qui porte une ressource.
                                  À afficher au mur, pas à mettre au dossier."/>
                    <button name="action_telecharger_mxgraph" type="object"
                            string="Exporter pour diagrams.net"
                            invisible="diagram_count == 0"/>
                    <button name="action_telecharger_bpmn" type="object"
                            string="Exporter en BPMN 2.0"
                            invisible="diagram_count == 0"/>
                    <button name="action_valider" type="object" string="Valider et geler"
                            class="btn-primary" invisible="state != 'brouillon'"
                            confirm="Une version validée ne se modifie plus. Continuer ?"/>
                    <button name="action_rouvrir" type="object" string="Rouvrir"
                            invisible="state != 'valide'"/>
                    <button name="action_nouvelle_version" type="object"
                            string="Nouvelle version"
                            invisible="diagram_count == 0"/>
                    <button name="action_dessiner_cible" type="object"
                            string="Dessiner le processus souhaité"
                            invisible="diagram_count == 0 or nature != 'actuel'"
                            help="Ouvre une branche : la même carte, à
                                  retoucher pour dire ce qu'on voudrait à la
                                  place. L'état actuel n'est pas touché."/>
                    <button name="action_semer_ecarts" type="object"
                            string="Semer les écarts" class="btn-primary"
                            invisible="nature != 'cible'"
                            help="Rejoue la comparaison avec l'état actuel.
                                  Ce qui a été écrit sur un écart (intention,
                                  gain, responsable, état) n'est jamais
                                  écrasé."/>
                    <button name="action_telecharger_pdf_delta" type="object"
                            string="Vue delta (PDF)"
                            invisible="nature != 'cible' or ecart_count == 0"/>
                    <button name="action_comparer" type="object"
                            string="Comparer" invisible="not version_precedente_id"/>
                    <button name="action_fusionner" type="object"
                            string="Fusionner un fichier"
                            invisible="diagram_count == 0 or state == 'valide'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,valide"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ouvrir_niveaux" type="object"
                                class="oe_stat_button" icon="fa-sitemap">
                            <field name="diagram_count" widget="statinfo"
                                   string="Niveaux"/>
                        </button>
                        <button name="action_ouvrir_cibles" type="object"
                                class="oe_stat_button" icon="fa-bullseye"
                                invisible="cible_count == 0">
                            <field name="cible_count" widget="statinfo"
                                   string="Souhaités"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du processus"/></h1>
                        <h3>
                            <field name="version" class="oe_inline"/>
                            <span class="oe_inline"> · </span>
                            <field name="code" class="oe_inline"
                                   placeholder="code"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="nature" widget="radio"
                                   options="{'horizontal': true}"
                                   readonly="diagram_count > 0"/>
                            <!-- modifiable tant que la carte est vide :
                                 une cible créée à la main doit pouvoir dire
                                 d'où elle part, sinon la contrainte la
                                 refuse sans offrir de champ pour répondre -->
                            <field name="origine_id"
                                   invisible="nature != 'cible'"
                                   required="nature == 'cible'"
                                   readonly="diagram_count > 0"
                                   domain="[('nature', '=', 'actuel'),
                                            ('id', '!=', id)]"/>
                            <field name="pool_name"
                                   placeholder="L'organisation qui exécute"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="node_count"/>
                            <field name="version_precedente_id" readonly="1"
                                   invisible="not version_precedente_id"/>
                            <field name="version_suivante_ids" widget="many2many_tags"
                                   readonly="1"
                                   invisible="not version_suivante_ids"/>
                            <label for="taux_validation"/>
                            <div>
                                <!-- pas de widget `percentage` : il multiplie
                                     par 100 une valeur déjà exprimée en pour
                                     cent, et 47,6 % s'affichait 4 760 %. -->
                                <field name="taux_validation" digits="[3,0]"
                                       class="oe_inline" readonly="1"/><span
                                       class="oe_inline"> %</span>
                                <span class="text-muted">
                                    — <field name="validee_count" class="oe_inline"
                                             readonly="1"/> sur
                                    <field name="activite_count" class="oe_inline"
                                           readonly="1"/> activités
                                </span>
                                <span class="text-danger"
                                      invisible="conteste_count == 0">
                                    · <field name="conteste_count" class="oe_inline"
                                             readonly="1"/> contestée(s)
                                </span>
                            </div>
                            <label for="taux_tracabilite"/>
                            <div>
                                <field name="taux_tracabilite" digits="[3,0]"
                                       class="oe_inline" readonly="1"/><span
                                       class="oe_inline"> %</span>
                                <span class="text-muted">
                                    — <field name="activite_tracee_count"
                                             class="oe_inline" readonly="1"/> sur
                                    <field name="activite_count" class="oe_inline"
                                           readonly="1"/> activités adossées à une
                                    décision consignée
                                </span>
                            </div>
                            <label for="taux_transformation"
                                   invisible="nature != 'cible'"/>
                            <div invisible="nature != 'cible'">
                                <field name="taux_transformation" digits="[3,0]"
                                       class="oe_inline" readonly="1"/><span
                                       class="oe_inline"> %</span>
                                <span class="text-muted">
                                    · <field name="ecart_fait_count"
                                             class="oe_inline" readonly="1"/> fait(s)
                                    sur <field name="ecart_retenu_count"
                                               class="oe_inline" readonly="1"/>
                                    retenu(s), <field name="ecart_a_decider_count"
                                                      class="oe_inline" readonly="1"/>
                                    encore à décider
                                </span>
                            </div>
                            <field name="active" invisible="1"/>
                            <field name="ecart_count" invisible="1"/>
                            <field name="cible_count" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tracé" name="trace"
                              invisible="diagram_count == 0">
                            <widget name="bf_process_visualiseur"/>
                        </page>
                        <page string="Niveaux" name="niveaux">
                            <field name="diagram_ids" nolabel="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="level"/>
                                    <field name="title"/>
                                    <field name="code"/>
                                    <field name="parent_node_ids" widget="many2many_tags"/>
                                    <field name="node_count" string="Nœuds"/>
                                </list>
                            </field>
                        </page>
                        <page string="Écarts" name="ecarts"
                              invisible="nature != 'cible'">
                            <field name="ecart_ids" nolabel="1"
                                   context="{'default_cible_id': id}"/>
                        </page>
                        <page string="Source" name="source">
                            <field name="source" nolabel="1"
                                   placeholder="D'où vient la carte, et ce qui n'a pas été fait : aucune observation terrain, aucune donnée de système…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bf_process_search" model="ir.ui.view">
        <field name="name">bf.process.search</field>
        <field name="model">bf.process</field>
        <field name="arch" type="xml">
            <search string="Cartographies">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <filter name="validees" string="Validées"
                        domain="[('state', '=', 'valide')]"/>
                <filter name="brouillons" string="Brouillons"
                        domain="[('state', '=', 'brouillon')]"/>
                <separator/>
                <filter name="etat_actuel" string="État actuel"
                        domain="[('nature', '=', 'actuel')]"/>
                <filter name="souhaites" string="Processus souhaités"
                        domain="[('nature', '=', 'cible')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="par_client" string="Client"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="par_etat" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="par_nature" string="Nature"
                            context="{'group_by': 'nature'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_process" model="ir.actions.act_window">
        <field name="name">Cartographies</field>
        <field name="res_model">bf.process</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune cartographie</p>
            <p>Le modèle est la vérité : le PDF et le XML n'en sont que des rendus.</p>
        </field>
    </record>
</odoo>
