<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_labour" model="ir.ui.view">
        <field name="name">hr.employee.form.labour</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Relations de travail" name="labour_relations"
                      groups="hr.group_hr_user"
                      invisible="labour_membership_count == 0">
                    <group>
                        <group>
                            <field name="labour_unit_id" readonly="1"/>
                            <field name="labour_seniority_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="labour_covered" readonly="1"/>
                            <field name="labour_is_member" readonly="1"/>
                            <field name="labour_membership_count" invisible="1"/>
                        </group>
                    </group>
                    <field name="labour_membership_ids" readonly="1">
                        <list>
                            <field name="unit_id"/>
                            <field name="seniority_date"/>
                            <field name="covered"/>
                            <field name="is_member"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
