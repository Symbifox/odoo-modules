<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_nc_user_credential_list" model="ir.ui.view">
        <field name="name">bf.nc.user.credential.list</field>
        <field name="model">bf.nc.user.credential</field>
        <field name="arch" type="xml">
            <list string="Nextcloud connections" create="0" edit="0" delete="1">
                <field name="user_id"/>
                <field name="nc_display_name"/>
                <field name="nc_login"/>
                <field name="config_id"/>
                <field name="nc_server"/>
                <field name="state"/>
                <field name="connected_on"/>
            </list>
        </field>
    </record>

    <record id="action_bf_nc_user_credential" model="ir.actions.act_window">
        <field name="name">Nextcloud connections</field>
        <field name="res_model">bf.nc.user.credential</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody has connected their Nextcloud yet.</p>
            <p>Each person connects their own account from the file browser.
               Deleting a line also revokes their access on the Nextcloud side.</p>
        </field>
    </record>

    <menuitem id="menu_bf_nc_user_credential"
              name="Connections"
              parent="menu_nc_browser_root"
              action="action_bf_nc_user_credential"
              groups="base.group_system"
              sequence="80"/>

</odoo>
