<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="extend_expiry_wizard_view_form" model="ir.ui.view">
        <field name="name">secure.transfer.extend.wizard.form</field>
        <field name="model">secure.transfer.extend.wizard</field>
        <field name="arch" type="xml">
            <form string="Extend the expiry">
                <field name="transfer_state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="transfer_state != 'expired'">
                    This transfer has <strong>expired</strong>. Extending it will
                    reopen it: the link already sent starts working again,
                    and no email goes back out. The extension is
                    written to the access trail.
                </div>
                <div class="alert alert-secondary" role="alert" invisible="transfer_state == 'expired'">
                    The duration counts from the send, and is picked from those
                    the service offers: that same grid sets the storage
                    lifecycle net. The extension is
                    written to the access trail.
                </div>
                <group>
                    <field name="transfer_id" readonly="1"/>
                    <field name="current_expiry" readonly="1"/>
                    <field name="days"/>
                    <field name="new_expiry" readonly="1"/>
                </group>
                <footer>
                    <button string="Extend" name="action_apply" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
