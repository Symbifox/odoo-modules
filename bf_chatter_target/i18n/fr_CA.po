msgid "Access denied on %(model)s #%(id)s: %(err)s"
msgstr "Accès refusé sur %(model)s #%(id)s : %(err)s"

#. module: bf_chatter_target
#. odoo-javascript
#: code:addons/bf_chatter_target/static/src/js/chatter_target_picker.js:0
#: model:ir.model,name:bf_chatter_target.model_bf_chatter_target
msgid "Chatter target"
msgstr "Cible de chatter"

#. module: bf_chatter_target
#. odoo-python
#: code:addons/bf_chatter_target/models/bf_chatter_target.py:0
msgid "Exact reference"
msgstr "Référence exacte"

#. module: bf_chatter_target
#. odoo-javascript
#: code:addons/bf_chatter_target/static/src/js/chatter_target_picker.js:0
msgid "Name, number, task:22299, or Odoo URL…"
msgstr "Nom, numéro, task:22299, ou URL Odoo…"

#. module: bf_chatter_target
#. odoo-javascript
#: code:addons/bf_chatter_target/static/src/js/chatter_target_picker.js:0
msgid "No record found"
msgstr "Aucune fiche trouvée"

#. module: bf_chatter_target
#. odoo-javascript
#: code:addons/bf_chatter_target/static/src/xml/chatter_target_picker.xml:0
msgid "Open the record"
msgstr "Ouvrir la fiche"

#. module: bf_chatter_target
#. odoo-javascript
#: code:addons/bf_chatter_target/static/src/xml/chatter_target_picker.xml:0
msgid "Pick another record"
msgstr "Choisir une autre fiche"

#. module: bf_chatter_target
#. odoo-python
#: code:addons/bf_chatter_target/models/bf_chatter_target_mixin.py:0
msgid "Please select a target record."
msgstr "Veuillez sélectionner une fiche cible."

#. module: bf_chatter_target
#: model:ir.model.fields,help:bf_chatter_target.field_bf_chatter_target_mixin__target_reference
msgid ""
"Search by name, by number, by shortcut (task:22299, invoice:42, bf.email:17)"
" or paste an Odoo URL. Any record with a chatter is a valid target."
msgstr ""
"Cherchez par nom, par numéro, par raccourci (task:22299, facture:42, "
"bf.email:17) ou collez une URL Odoo. Toute fiche dotée d'un chatter est une "
"cible valide."

#. module: bf_chatter_target
#. odoo-javascript
#: code:addons/bf_chatter_target/static/src/js/chatter_target_picker.js:0
msgid "Search is unavailable right now."
msgstr "Recherche impossible pour le moment."

#. module: bf_chatter_target
#. odoo-javascript
#: code:addons/bf_chatter_target/static/src/js/chatter_target_picker.js:0
msgid "Searching…"
msgstr "Recherche…"

#. module: bf_chatter_target
#: model:ir.model.fields,field_description:bf_chatter_target.field_bf_chatter_target_mixin__target_reference
msgid "Target record"
msgstr "Fiche cible"

#. module: bf_chatter_target
#. odoo-python
#: code:addons/bf_chatter_target/models/bf_chatter_target_mixin.py:0
msgid "The model %s has no chatter."
msgstr "Le modèle %s ne porte pas de chatter."

#. module: bf_chatter_target
#. odoo-python
#: code:addons/bf_chatter_target/models/bf_chatter_target_mixin.py:0
msgid "The target record has been deleted."
msgstr "La fiche cible a été supprimée."

#. module: bf_chatter_target
#. odoo-javascript
#: code:addons/bf_chatter_target/static/src/js/chatter_target_picker.js:0
msgid "Type at least two characters, a number, or paste an Odoo URL."
msgstr "Tape au moins deux caractères, un numéro, ou colle une URL Odoo."

#. module: bf_chatter_target
#: model:ir.model,name:bf_chatter_target.model_bf_chatter_target_mixin
msgid "Unified target record selection"
msgstr "Sélection unifiée d'une fiche cible"
