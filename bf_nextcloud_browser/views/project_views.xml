<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_form_nc_browser" model="ir.ui.view">
        <field name="name">project.project.form.nc.browser</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Fichiers Nextcloud" name="nc_browser"
                      groups="bf_nextcloud_browser.group_nc_browser_user">
                    <widget name="nc_browser_panel"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
