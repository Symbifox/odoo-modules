<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Destruction Register Form View (readonly) -->
    <record id="privacy_destruction_register_view_form" model="ir.ui.view">
        <field name="name">privacy.destruction.register.form</field>
        <field name="model">privacy.destruction.register</field>
        <field name="arch" type="xml">
            <form string="Entrée du registre de destruction" create="0" edit="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Registre immuable</strong> — Cette entrée est protégée conformément
                        à l'article 3.2 de la LPRPSP. Elle ne peut être ni modifiée ni supprimée.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="register_number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Exécution">
                            <field name="destruction_date"/>
                            <field name="destroyed_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="destruction_method"/>
                        </group>
                        <group string="Enregistrement détruit">
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                        </group>
                    </group>
                    <group>
                        <group string="Métadonnées">
                            <field name="pi_categories"/>
                            <field name="subject_count"/>
                            <field name="certificate_number"/>
                            <field name="retention_calendar_id"/>
                        </group>
                        <group string="Références">
                            <field name="destruction_request_id"/>
                            <field name="campaign_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description des données détruites">
                        <field name="document_description" nolabel="1"/>
                    </group>
                    <group string="Base légale">
                        <field name="legal_basis" nolabel="1"/>
                    </group>
                    <group string="Intégrité">
                        <field name="verification_hash" widget="CopyClipboardChar"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Destruction Register List View -->
    <record id="privacy_destruction_register_view_list" model="ir.ui.view">
        <field name="name">privacy.destruction.register.list</field>
        <field name="model">privacy.destruction.register</field>
        <field name="arch" type="xml">
            <list string="Registre de destruction" create="0" edit="0" delete="0">
                <field name="register_number"/>
                <field name="destruction_date"/>
                <field name="res_name" string="Document"/>
                <field name="pi_categories"/>
                <field name="destruction_method" widget="badge"
                       decoration-danger="destruction_method == 'secure_wipe'"
                       decoration-warning="destruction_method == 'delete'"
                       decoration-info="destruction_method == 'anonymize'"
                       decoration-success="destruction_method == 'archive'"/>
                <field name="destroyed_by_id"/>
                <field name="approved_by_id"/>
                <field name="certificate_number" optional="show"/>
                <field name="subject_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Destruction Register Search View -->
    <record id="privacy_destruction_register_view_search" model="ir.ui.view">
        <field name="name">privacy.destruction.register.search</field>
        <field name="model">privacy.destruction.register</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="register_number"/>
                <field name="res_name"/>
                <field name="certificate_number"/>
                <field name="document_description"/>
                <separator/>
                <filter string="Anonymisation" name="anonymize"
                        domain="[('destruction_method', '=', 'anonymize')]"/>
                <filter string="Suppression" name="delete"
                        domain="[('destruction_method', '=', 'delete')]"/>
                <filter string="Effacement sécurisé" name="secure_wipe"
                        domain="[('destruction_method', '=', 'secure_wipe')]"/>
                <separator/>
                <filter string="Ce mois" name="this_month"
                        domain="[('destruction_date', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Ce trimestre" name="this_quarter"
                        domain="[('destruction_date', '>=', (context_today().replace(day=1, month=((context_today().month - 1) // 3) * 3 + 1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter string="Méthode" name="group_by_method"
                            context="{'group_by': 'destruction_method'}"/>
                    <filter string="Mois" name="group_by_month"
                            context="{'group_by': 'destruction_date:month'}"/>
                    <filter string="Détruit par" name="group_by_user"
                            context="{'group_by': 'destroyed_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Destruction Register Action -->
    <record id="action_privacy_destruction_register" model="ir.actions.act_window">
        <field name="name">Registre de destruction</field>
        <field name="res_model">privacy.destruction.register</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune entrée au registre
            </p>
            <p>
                Le registre de destruction est alimenté automatiquement lors de l'exécution
                des demandes de destruction et des campagnes.
                Conformément à l'article 3.2 de la LPRPSP, ces entrées sont immuables.
            </p>
        </field>
    </record>
</odoo>
