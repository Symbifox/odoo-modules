<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Onglet « Portail client » de la fiche projet. Le jeton n'y figure pas :
         son champ est réservé aux administrateurs de projets, et une vue qui
         l'afficherait sans le même groupe bloquerait l'ouverture de la fiche
         aux autres. On passe par « Copier l'adresse ». -->
    <record id="bf_stepbystep_project_form_portal" model="ir.ui.view">
        <field name="name">project.project.form.bf_stepbystep_portal</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Client portal" name="bf_stepbystep_portal">
                    <group>
                        <group>
                            <field name="progression_portal_published" readonly="1"/>
                        </group>
                        <group groups="project.group_project_manager">
                            <button name="action_progression_portal_publish" type="object"
                                    string="Publish" class="btn-primary" icon="fa-globe"
                                    invisible="progression_portal_published"/>
                            <button name="action_progression_portal_copy_link" type="object"
                                    string="Copy the address" icon="fa-link"
                                    invisible="not progression_portal_published"/>
                            <button name="action_progression_portal_regenerate_token" type="object"
                                    string="New address" icon="fa-refresh"
                                    invisible="not progression_portal_published"
                                    confirm="The current address will stop working. Continue?"/>
                            <button name="action_progression_portal_unpublish" type="object"
                                    string="Unpublish" icon="fa-eye-slash"
                                    invisible="not progression_portal_published"/>
                        </group>
                    </group>
                    <field name="progression_deposit_ids" readonly="1" groups="project.group_project_user">
                        <list create="0" delete="0">
                            <field name="deposited_at"/>
                            <field name="document_name"/>
                            <field name="filename"/>
                            <field name="task_id"/>
                            <field name="file_size" optional="hide"/>
                            <field name="checksum" optional="hide"/>
                            <field name="ip_address" optional="hide"/>
                            <field name="attachment_id" optional="show"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        The client sees the name of the project, the stages marked
                        "Visible on client portal", the progress of each one and the
                        client instruction of the current stage, and deposits the documents
                        expected at the current and completed stages. Each document becomes
                        an attachment of the stage's task. No task name, assignee or
                        timesheet is shown.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
