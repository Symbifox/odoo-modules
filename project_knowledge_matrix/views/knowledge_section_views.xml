<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Section: Form View -->
    <record id="knowledge_section_view_form" model="ir.ui.view">
        <field name="name">project.knowledge.section.form</field>
        <field name="model">project.knowledge.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Display">
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="What does this section cover..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Section: List View -->
    <record id="knowledge_section_view_list" model="ir.ui.view">
        <field name="name">project.knowledge.section.list</field>
        <field name="model">project.knowledge.section</field>
        <field name="arch" type="xml">
            <list string="Sections" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- Section: Search View -->
    <record id="knowledge_section_view_search" model="ir.ui.view">
        <field name="name">project.knowledge.section.search</field>
        <field name="model">project.knowledge.section</field>
        <field name="arch" type="xml">
            <search string="Search Sections">
                <field name="code"/>
                <field name="name"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Section: Action -->
    <record id="knowledge_section_action" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">project.knowledge.section</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define knowledge matrix sections
            </p>
            <p>
                Sections categorize knowledge items (e.g., Objectives, Security, Governance).
            </p>
        </field>
    </record>

</odoo>
