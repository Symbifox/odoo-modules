#. module: bf_school_message
#. odoo-python
#: code:addons/bf_school_message/models/babillard_post.py:0
msgid "%(n)s adult(s) who receive notices have no email address and were not told."
msgstr "%(n)s adulte(s) qui reçoi(ven)t les avis n'ont pas d'adresse courriel : aucun avis ne leur a été envoyé."

#. module: bf_school_message
#: model:mail.template,body_html:bf_school_message.mail_template_school_news
msgid ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 4px 0;font-size:13px;color:#6B7280;\">\n"
"        <t t-out=\"object.school_id.name or ''\"/> · <t t-out=\"ctx.get('school_children') or ''\"/>\n"
"    </p>\n"
"    <h2 style=\"margin:0 0 16px 0;\" t-out=\"object.name or ''\"/>\n"
"    <div t-if=\"not is_html_empty(object.corps_html)\" style=\"margin:0 0 16px 0;\" t-out=\"object.corps_html\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}{{ ctx.get('school_url') }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            <t t-if=\"object.lecture_requise\">Read and confirm</t>\n"
"            <t t-else=\"\">Open in the family portal</t>\n"
"        </a>\n"
"    </p>\n"
"    <p t-if=\"object.lecture_requise\" style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        The school asks you to confirm that you have read this announcement. The\n"
"        confirmation is given in the family portal, after you sign in: opening this\n"
"        email or its link does not count.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 4px 0;font-size:13px;color:#6B7280;\">\n"
"        <t t-out=\"object.school_id.name or ''\"/> · <t t-out=\"ctx.get('school_children') or ''\"/>\n"
"    </p>\n"
"    <h2 style=\"margin:0 0 16px 0;\" t-out=\"object.name or ''\"/>\n"
"    <div t-if=\"not is_html_empty(object.corps_html)\" style=\"margin:0 0 16px 0;\" t-out=\"object.corps_html\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}{{ ctx.get('school_url') }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            <t t-if=\"object.lecture_requise\">Lire et confirmer</t>\n"
"            <t t-else=\"\">Ouvrir dans le portail des familles</t>\n"
"        </a>\n"
"    </p>\n"
"    <p t-if=\"object.lecture_requise\" style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        L'école vous demande de confirmer que vous avez lu cette annonce. La\n"
"        confirmation se donne dans le portail des familles, après la connexion : ouvrir\n"
"        ce courriel ou son lien ne compte pas.\n"
"    </p>\n"
"</div>\n"
"            "

