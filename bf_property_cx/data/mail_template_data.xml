<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Habillage : celui de la société, comme les factures, les résumés
             quotidiens et les banques d'heures (cette règle
             remplace celle d'avant, « aucune marque »). Le corps ne porte
             que le contenu ; la carte, le bandeau et le pied viennent de la mise
             en page `bluefox_branding.bf_mail_layout` quand elle est installée
             (voir `rating_send_request`), sinon de la mise en page légère
             d'Odoo. La couleur du bouton est celle de la société, avec le repli
             neutre d'Odoo : aucun champ d'un module absent n'est appelé. -->
        <record id="mail_template_request_rating" model="mail.template">
            <field name="name">Copropriété : avis après une demande réglée</field>
            <field name="model_id" ref="bf_property_portal.model_bf_property_request"/>
            <field name="subject">Votre demande a été réglée : comment ça s'est passé ?</field>
            <field name="partner_to">{{ object._rating_get_partner().id }}</field>
            <field name="lang">{{ object._rating_get_partner().lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<t t-set="partner" t-value="object._rating_get_partner()"/>
<t t-set="access_token" t-value="object._rating_get_access_token()"/>
<t t-set="company" t-value="object.organisation_id.company_id or user.company_id"/>
<t t-set="brand_primary" t-value="(company and 'report_brand_primary' in company._fields and company.report_brand_primary) or '#714B67'"/>
<div style="margin:0;padding:0;">
    <p style="margin:0 0 16px 0;font-size:15px;">Bonjour <t t-out="partner.name or ''"/>,</p>
    <p style="margin:0 0 16px 0;font-size:15px;">
        Votre demande « <t t-out="object.name or ''"/> » à <t t-out="object.organisation_id.display_name or ''"/>
        a été réglée.
    </p>
    <p t-if="object.resolution" t-attf-style="margin:0 0 16px 0;font-size:15px;padding:12px 16px;background-color:#F8FAFC;border-left:3px solid {{ brand_primary }};">
        <t t-out="object.resolution"/>
    </p>
    <p style="margin:0 0 8px 0;font-size:15px;">
        En un clic, comment ça s'est passé ?
    </p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:16px auto 16px auto;text-align:center;">
        <tbody><tr>
            <td style="padding:0 16px;">
                <a t-attf-href="/rate/{{ access_token }}/5">
                    <img alt="Satisfait" src="/rating/static/src/img/rating_5.png" title="Satisfait"/>
                </a>
            </td>
            <td style="padding:0 16px;">
                <a t-attf-href="/rate/{{ access_token }}/3">
                    <img alt="Correct" src="/rating/static/src/img/rating_3.png" title="Correct"/>
                </a>
            </td>
            <td style="padding:0 16px;">
                <a t-attf-href="/rate/{{ access_token }}/1">
                    <img alt="Insatisfait" src="/rating/static/src/img/rating_1.png" title="Insatisfait"/>
                </a>
            </td>
        </tr></tbody>
    </table>
    <p style="margin:0 0 16px 0;font-size:13px;color:#6B7280;">
        Un commentaire libre peut être ajouté après le clic.
    </p>
    <p style="margin:0;font-size:12px;color:#9CA3AF;">
        Vous préférez ne plus recevoir de demandes d'avis ?
        <a t-att-href="partner.bf_cx_unsubscribe_url" style="color:#9CA3AF;">Me désabonner</a>.
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
