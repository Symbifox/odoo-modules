<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cx_feedback_list" model="ir.ui.view">
        <field name="name">bf.cx.feedback.list</field>
        <field name="model">bf.cx.feedback</field>
        <field name="arch" type="xml">
            <list decoration-danger="nps_bucket == 'detractor'" decoration-success="nps_bucket == 'promoter'">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="kind"/>
                <field name="source" optional="show"/>
                <field name="score"/>
                <field name="score_max" optional="hide"/>
                <field name="nps_bucket"/>
                <field name="comment" optional="show"/>
                <field name="program_id" optional="show"/>
                <field name="project_id" optional="hide"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_cx_feedback_kanban" model="ir.ui.view">
        <field name="name">bf.cx.feedback.kanban</field>
        <field name="model">bf.cx.feedback</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" highlight_color="color">
                <field name="nps_bucket"/>
                <field name="kind"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong><field name="partner_id"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="kind"/>
                                <t t-if="record.score.raw_value or ['nps', 'csat'].includes(record.kind.raw_value)">
                                    · <field name="score"/>/<field name="score_max"/>
                                </t>
                            </div>
                            <div t-if="record.comment.raw_value" class="text-muted o_text_overflow">
                                <field name="comment"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <field name="date"/>
                                <span t-if="record.nps_bucket.raw_value == 'detractor'" class="badge text-bg-danger">Détracteur</span>
                                <span t-if="record.nps_bucket.raw_value == 'passive'" class="badge text-bg-warning">Passif</span>
                                <span t-if="record.nps_bucket.raw_value == 'promoter'" class="badge text-bg-success">Promoteur</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cx_feedback_form" model="ir.ui.view">
        <field name="name">bf.cx.feedback.form</field>
        <field name="model">bf.cx.feedback</field>
        <field name="arch" type="xml">
            <form string="Feedback">
                <header>
                    <button name="action_start_followup" type="object"
                            string="Démarrer le suivi" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_mark_done" type="object"
                            string="Marquer traité" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_new" type="object"
                            string="Remettre à nouveau"
                            invisible="state == 'new'"/>
                    <button name="action_create_testimonial" type="object"
                            string="Créer un témoignage"
                            invisible="not is_testimonial_candidate and not comment"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="True"/></h1>
                    </div>
                    <group>
                        <group name="who">
                            <field name="partner_id"/>
                            <field name="subject_user_id"
                                   widget="many2one_avatar_user"
                                   invisible="kind != 'internal'"/>
                            <field name="date"/>
                            <field name="kind"/>
                            <field name="source"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group name="score">
                            <field name="score"/>
                            <field name="score_max"/>
                            <field name="nps_bucket"/>
                            <field name="is_testimonial_candidate"/>
                            <field name="testimonial_id" invisible="not testimonial_id"/>
                        </group>
                    </group>
                    <group name="comment_group" string="Commentaire">
                        <field name="comment" nolabel="1" colspan="2"
                               placeholder="Verbatim du répondant…"/>
                        <field name="theme_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}" colspan="2"/>
                    </group>
                    <group>
                        <group name="origin" string="Origine">
                            <field name="program_id"/>
                            <field name="wave_id"/>
                            <field name="survey_user_input_id" invisible="not survey_user_input_id"/>
                            <field name="rating_ref_id" invisible="not rating_ref_id"/>
                        </group>
                        <group name="context" string="Contexte">
                            <field name="project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cx_feedback_graph" model="ir.ui.view">
        <field name="name">bf.cx.feedback.graph</field>
        <field name="model">bf.cx.feedback</field>
        <field name="arch" type="xml">
            <graph string="Feedbacks" type="bar" stacked="True">
                <field name="date" interval="month"/>
                <field name="nps_bucket"/>
            </graph>
        </field>
    </record>

    <record id="view_cx_feedback_pivot" model="ir.ui.view">
        <field name="name">bf.cx.feedback.pivot</field>
        <field name="model">bf.cx.feedback</field>
        <field name="arch" type="xml">
            <pivot string="Feedbacks">
                <field name="date" interval="month" type="row"/>
                <field name="nps_bucket" type="col"/>
                <field name="score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_cx_feedback_search" model="ir.ui.view">
        <field name="name">bf.cx.feedback.search</field>
        <field name="model">bf.cx.feedback</field>
        <field name="arch" type="xml">
            <search string="Feedbacks">
                <field name="partner_id"/>
                <field name="subject_user_id"/>
                <field name="comment"/>
                <field name="program_id"/>
                <field name="project_id"/>
                <filter string="NPS" name="filter_nps" domain="[('kind', '=', 'nps')]"/>
                <filter string="CSAT" name="filter_csat" domain="[('kind', '=', 'csat')]"/>
                <filter string="Commentaires" name="filter_verbatim" domain="[('kind', '=', 'verbatim')]"/>
                <filter string="Interne (360)" name="filter_internal" domain="[('kind', '=', 'internal')]"/>
                <separator/>
                <filter string="Détracteurs" name="filter_detractors" domain="[('nps_bucket', '=', 'detractor')]"/>
                <filter string="Promoteurs" name="filter_promoters" domain="[('nps_bucket', '=', 'promoter')]"/>
                <separator/>
                <filter string="À traiter" name="filter_new" domain="[('state', '=', 'new')]"/>
                <filter string="À rappeler (boucle fermée)" name="filter_followup"
                        domain="[('needs_followup', '=', True), ('state', '!=', 'done')]"/>
                <filter string="Candidats témoignage" name="filter_testimonial" domain="[('is_testimonial_candidate', '=', True)]"/>
                <separator/>
                <filter string="Mes suivis" name="filter_my" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type" name="group_kind" context="{'group_by': 'kind'}"/>
                    <filter string="Catégorie NPS" name="group_bucket" context="{'group_by': 'nps_bucket'}"/>
                    <filter string="Programme" name="group_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Contact" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Personne évaluée (360)" name="group_subject" context="{'group_by': 'subject_user_id'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Thème" name="group_theme" context="{'group_by': 'theme_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cx_feedback" model="ir.actions.act_window">
        <field name="name">Feedbacks</field>
        <field name="res_model">bf.cx.feedback</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="view_cx_feedback_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun feedback pour l'instant
            </p>
            <p>
                Les réponses aux sondages des programmes et les évaluations
                par courriel atterrissent ici automatiquement. On peut aussi
                consigner un feedback entendu en rencontre ou au téléphone.
            </p>
        </field>
    </record>

    <record id="action_cx_report" model="ir.actions.act_window">
        <field name="name">Analyse des feedbacks</field>
        <field name="res_model">bf.cx.feedback</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="view_cx_feedback_search"/>
    </record>

</odoo>
