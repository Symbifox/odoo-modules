<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_digest_config_form_subscription" model="ir.ui.view">
        <field name="name">daily.digest.config.form.subscription</field>
        <field name="model">daily.digest.config</field>
        <field name="inherit_id" ref="daily_todo_digest.view_daily_digest_config_form"/>
        <field name="arch" type="xml">
            <field name="include_quote" position="after">
                <field name="include_subscription_renewals"/>
                <field name="subscription_renewal_days"
                       invisible="not include_subscription_renewals"/>
            </field>
        </field>
    </record>
</odoo>
