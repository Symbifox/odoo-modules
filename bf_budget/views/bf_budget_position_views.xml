<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_budget_position_view_list" model="ir.ui.view">
        <field name="name">bf.budget.position.list</field>
        <field name="model">bf.budget.position</field>
        <field name="arch" type="xml">
            <list string="Budget items">
                <field name="code"/>
                <field name="name"/>
                <field name="budget_type"/>
                <field name="account_count" string="Accounts"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="bf_budget_position_view_form" model="ir.ui.view">
        <field name="name">bf.budget.position.form</field>
        <field name="model">bf.budget.position</field>
        <field name="arch" type="xml">
            <form string="Budget item">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Software licenses"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="budget_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="account_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounts" name="accounts">
                            <field name="account_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   domain="[('company_ids', 'in', company_id), ('deprecated', '=', False)]"/>
                        </page>
                        <page string="Rationale" name="note">
                            <field name="note" placeholder="Why this budget item exists, and what it does not cover."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_budget_position_view_search" model="ir.ui.view">
        <field name="name">bf.budget.position.search</field>
        <field name="model">bf.budget.position</field>
        <field name="arch" type="xml">
            <search string="Budget items">
                <field name="name"/>
                <field name="code"/>
                <field name="account_ids"/>
                <filter name="expense" string="Expenses" domain="[('budget_type', '=', 'expense')]"/>
                <filter name="revenue" string="Revenue" domain="[('budget_type', '=', 'revenue')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_type" string="Budget type" context="{'group_by': 'budget_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_budget_position_action" model="ir.actions.act_window">
        <field name="name">Budget items</field>
        <field name="res_model">bf.budget.position</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first budget item</p>
            <p>
                A budget item groups general ledger accounts. Aim for three to five budget items: beyond that, the budget becomes a table nobody looks at anymore. The suggestion wizard starts from your actual chart of accounts.
            </p>
        </field>
    </record>
</odoo>
