<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ir_cron_outreach_match_emails" model="ir.cron">
        <field name="name">Démarchage : rapprocher les réponses courriel</field>
        <field name="model_id" ref="bf_outreach.model_bf_outreach_target"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._cron_match_inbound_emails()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now().replace(second=0, microsecond=0) + timedelta(minutes=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</odoo>
