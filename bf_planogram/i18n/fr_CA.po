#. module: bf_planogram
#. odoo-python
#: code:addons/bf_planogram/models/fixture.py:0
msgid ""
"%(what)s belongs to « %(name)s », a frozen version: freeze a new version "
"instead of changing this one."
msgstr "%(what)s appartient à « %(name)s », une version gelée : gelez-en une neuve plutôt que de changer celle-là."

#. module: bf_planogram
#. odoo-python
#: code:addons/bf_planogram/models/rendering.py:0
