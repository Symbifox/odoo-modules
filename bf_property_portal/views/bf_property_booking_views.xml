<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_property_booking_list" model="ir.ui.view">
            <field name="name">bf.property.booking.list</field>
            <field name="model">bf.property.booking</field>
            <field name="arch" type="xml">
                <list decoration-muted="state in ('refused', 'cancelled')"
                      decoration-info="state == 'requested'">
                    <field name="name"/>
                    <field name="common_area_id"/>
                    <field name="building_id" optional="show"/>
                    <field name="partner_id"/>
                    <field name="unit_id" optional="hide"/>
                    <field name="date_start"/>
                    <field name="date_stop"/>
                    <field name="duration_minutes" string="Minutes" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'requested'"
                           decoration-success="state == 'confirmed'"/>
                </list>
            </field>
        </record>

        <record id="view_property_booking_form" model="ir.ui.view">
            <field name="name">bf.property.booking.form</field>
            <field name="model">bf.property.booking</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" type="object" string="Confirmer"
                                class="btn-primary" invisible="state != 'requested'"/>
                        <button name="action_refuse" type="object" string="Refuser"
                                invisible="state != 'requested'"/>
                        <button name="action_cancel" type="object" string="Annuler"
                                invisible="state in ('refused', 'cancelled')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="requested,confirmed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="common_area_id"/>
                                <field name="building_id"/>
                                <field name="partner_id"/>
                                <field name="unit_id"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_stop"/>
                                <field name="duration_minutes"/>
                            </group>
                        </group>
                        <group>
                            <field name="note"/>
                            <field name="decision_reason"
                                   placeholder="Obligatoire pour refuser."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_property_booking_search" model="ir.ui.view">
            <field name="name">bf.property.booking.search</field>
            <field name="model">bf.property.booking</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="common_area_id"/>
                    <field name="partner_id"/>
                    <filter name="pending" string="En attente"
                            domain="[('state', '=', 'requested')]"/>
                    <filter name="active_ones" string="Actives"
                            domain="[('state', 'in', ['requested', 'confirmed'])]"/>
                    <filter name="upcoming" string="À venir"
                            domain="[('date_start', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    <group expand="1" string="Regrouper par">
                        <filter name="group_area" string="Espace"
                                context="{'group_by': 'common_area_id'}"/>
                        <filter name="group_building" string="Immeuble"
                                context="{'group_by': 'building_id'}"/>
                        <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_property_booking" model="ir.actions.act_window">
            <field name="name">Réservations</field>
            <field name="res_model">bf.property.booking</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active_ones': 1, 'search_default_group_area': 1}</field>
        </record>

        <!-- Réglages de réservation sur la partie commune. -->
        <record id="view_property_common_area_form_booking" model="ir.ui.view">
            <field name="name">bf.property.common.area.form.booking</field>
            <field name="model">bf.property.common.area</field>
            <field name="inherit_id" ref="bf_property_core.view_property_common_area_form"/>
            <field name="arch" type="xml">
                <field name="bookable" position="after">
                    <field name="booking_requires_approval" invisible="not bookable"/>
                    <field name="booking_max_minutes" invisible="not bookable"/>
                    <field name="booking_horizon_days" invisible="not bookable"/>
                </field>
                <xpath expr="//field[@name='description']" position="after">
                    <label for="booking_rules" invisible="not bookable"/>
                    <field name="booking_rules" invisible="not bookable"
                           placeholder="Ce que le règlement de l'immeuble prévoit pour cet espace, tel que l'occupant doit le lire. Le modifier relève de la majorité de l'article 1096 du Code civil."/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
