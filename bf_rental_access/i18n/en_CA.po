#. module: bf_rental_access
#: model:ir.model.fields,field_description:bf_rental_access.field_bf_property_access_resident__lease_id
msgid "Bail"
msgstr "Lease"

#. module: bf_rental_access
#: model:ir.model,name:bf_rental_access.model_bf_rental_lease
msgid "Bail de logement"
msgstr "Lease of a dwelling"

#. module: bf_rental_access
#: model:ir.model.fields,help:bf_rental_access.field_bf_property_access_resident__origin
msgid ""
"D'où vient le droit. Les origines tirées du dossier (propriété, fraction, "
"bail) sont suivies chaque jour ; un occupant déclaré ne l'est pas : son "
"départ se déclare à la main."
msgstr ""
"Where the access right comes from. Origins drawn from the file (ownership, "
"fraction, lease) are checked every day; a declared occupant is not: their "
"departure is declared by hand."

#. module: bf_rental_access
#: model:ir.model,name:bf_rental_access.model_bf_rental_abandonment
msgid "Départ du locataire sans préavis"
msgstr "Lessee abandoning the dwelling"

#. module: bf_rental_access
#. odoo-python
#: code:addons/bf_rental_access/models/bf_property_access_resident.py:0
msgid "Départ sans préavis constaté le %s."
msgstr "Abandonment of the dwelling noted on %s."

#. module: bf_rental_access
#. odoo-python
#: code:addons/bf_rental_access/models/bf_property_access_resident.py:0
msgid "La personne n'est plus signataire du bail %s."
msgstr "The person is no longer a signatory of lease %s."

#. module: bf_rental_access
#. odoo-python
#: code:addons/bf_rental_access/models/bf_property_access_resident.py:0
msgid "Le bail %s est archivé."
msgstr "Lease %s is archived."

#. module: bf_rental_access
#: model:ir.model.fields,help:bf_rental_access.field_bf_property_access_resident__lease_id
msgid "Le bail qui fonde le droit, le plus récent quand il y en a plusieurs."
msgstr ""
"The lease the access right rests on; the most recent one when there are "
"several."

#. module: bf_rental_access
#. odoo-python
#: code:addons/bf_rental_access/models/bf_property_access_resident.py:0
msgid "Le loyer n'est dû que jusqu'au %s."
msgstr "Rent is due only until %s."

#. module: bf_rental_access
#: model:ir.model.fields,field_description:bf_rental_access.field_bf_property_access_resident__origin
msgid "Origine"
msgstr "Origin"

#. module: bf_rental_access
#: model:ir.model,name:bf_rental_access.model_bf_property_access_resident
msgid "Résident (accès)"
msgstr "Resident (access)"

#. module: bf_rental_access
#. odoo-python
#: code:addons/bf_rental_access/models/bf_property_access_resident.py:0
msgid "Résiliation par le locataire effective le %s."
msgstr "Resiliation by the lessee effective on %s."

#. module: bf_rental_access
#: model:ir.model.fields.selection,name:bf_rental_access.selection__bf_property_access_resident__origin__lease
msgid "Signataire du bail"
msgstr "Lease signatory"

#. module: bf_rental_access
#. odoo-python
#: code:addons/bf_rental_access/models/bf_property_access_resident.py:0
msgid "Un bail plus récent (%(ref)s) a commencé sur ce logement le %(date)s."
msgstr "A more recent lease (%(ref)s) began on this dwelling on %(date)s."
