#. module: bf_property_cx
#: model:mail.template,body_html:bf_property_cx.mail_template_request_rating
msgid ""
"<t t-set=\"partner\" t-value=\"object._rating_get_partner()\"/>\n"
"<t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"/>\n"
"<t t-set=\"company\" t-value=\"object.organisation_id.company_id or user.company_id\"/>\n"
"<t t-set=\"brand_primary\" t-value=\"(company and 'report_brand_primary' in company._fields and company.report_brand_primary) or '#714B67'\"/>\n"
"<div style=\"margin:0;padding:0;\">\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\">Bonjour <t t-out=\"partner.name or ''\"/>,</p>\n"
"    <p style=\"margin:0 0 16px 0;font-size:15px;\">\n"
"        Votre demande «&nbsp;<t t-out=\"object.name or ''\"/>&nbsp;» à <t t-out=\"object.organisation_id.display_name or ''\"/>\n"
"        a été réglée.\n"
"    </p>\n"
"    <p t-if=\"object.resolution\" t-attf-style=\"margin:0 0 16px 0;font-size:15px;padding:12px 16px;background-color:#F8FAFC;border-left:3px solid {{ brand_primary }};\">\n"
"        <t t-out=\"object.resolution\"/>\n"
"    </p>\n"
"    <p style=\"margin:0 0 8px 0;font-size:15px;\">\n"
"        En un clic, comment ça s'est passé&nbsp;?\n"
"    </p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:16px auto 16px auto;text-align:center;\">\n"
"        <tbody><tr>\n"
"            <td style=\"padding:0 16px;\">\n"
"                <a t-attf-href=\"/rate/{{ access_token }}/5\">\n"
"                    <img alt=\"Satisfait\" src=\"/rating/static/src/img/rating_5.png\" title=\"Satisfait\"/>\n"
"                </a>\n"
"            </td>\n"
"            <td style=\"padding:0 16px;\">\n"
"                <a t-attf-href=\"/rate/{{ access_token }}/3\">\n"
"                    <img alt=\"Correct\" src=\"/rating/static/src/img/rating_3.png\" title=\"Correct\"/>\n"
"                </a>\n"
"            </td>\n"
"            <td style=\"padding:0 16px;\">\n"
"                <a t-attf-href=\"/rate/{{ access_token }}/1\">\n"
"                    <img alt=\"Insatisfait\" src=\"/rating/static/src/img/rating_1.png\" title=\"Insatisfait\"/>\n"
"                </a>\n"
"            </td>\n"
"        </tr></tbody>\n"
"    </table>\n"
"    <p style=\"margin:0 0 16px 0;font-size:13px;color:#6B7280;\">\n"
"        Un commentaire libre peut être ajouté après le clic.\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:12px;color:#9CA3AF;\">\n"
"        Vous préférez ne plus recevoir de demandes d'avis&nbsp;?\n"
"        <a t-att-href=\"partner.bf_cx_unsubscribe_url\" style=\"color:#9CA3AF;\">Me désabonner</a>.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

