<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bf_email_management.Browser">
        <div class="o_bf_email_browser d-flex flex-grow-1"
             t-att-class="state.dragging ? 'o_bf_email_dragging' : ''"
             style="height: 100%;">

            <!-- LEFT: Folder tree sidebar -->
            <div class="o_bf_email_folders border-end bg-light" style="width: 260px; min-width: 260px; overflow-y: auto;">
                <div class="px-3 py-2 fw-bold border-bottom d-flex justify-content-between align-items-center">
                    <span>Dossiers IMAP</span>
                    <button class="btn btn-sm btn-link p-0" t-on-click="() => this.loadFolders()" title="Rafraîchir la liste">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
                <div t-if="state.loadingFolders" class="p-3 text-center text-muted">
                    <i class="fa fa-spinner fa-spin"/> Chargement…
                </div>
                <ul t-else="" class="list-unstyled mb-0">
                    <li t-foreach="folderTree" t-as="f" t-key="f.name"
                        t-att-class="(f.name === state.currentFolder ? 'bg-primary text-white ' : '') + 'o_bf_email_folder_item d-flex align-items-center'"
                        t-att-style="'cursor: pointer; user-select: none; padding-left: ' + (8 + f.depth * 14) + 'px; padding-right: 12px; padding-top: 4px; padding-bottom: 4px;'"
                        t-on-click="() => this.onFolderClick(f.name)"
                        t-on-dragover="(ev) => this.onFolderDragOver(ev, f.name)"
                        t-on-drop="(ev) => this.onFolderDrop(ev, f.name)">
                        <span t-if="f.has_children and f.children.length"
                              class="me-1"
                              style="width: 14px; display: inline-block;"
                              t-on-click.stop="() => this.toggleFolder(f.name)">
                            <i t-att-class="state.expandedFolders[f.name] ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                        </span>
                        <span t-else="" style="width: 14px; display: inline-block;"/>
                        <i class="fa fa-folder-o me-2"/>
                        <span class="text-truncate flex-grow-1">
                            <t t-esc="f.name.includes('/') ? f.name.slice(f.name.lastIndexOf('/') + 1) : f.name"/>
                        </span>
                        <span t-if="f.unread_count" class="badge ms-2"
                              t-att-class="f.name === state.currentFolder ? 'bg-light text-dark' : 'bg-secondary'">
                            <t t-esc="f.unread_count"/>
                        </span>
                        <span t-elif="f.total_count !== null and f.total_count !== undefined"
                              class="small ms-2"
                              t-att-class="f.name === state.currentFolder ? 'text-light' : 'text-muted'">
                            <t t-esc="f.total_count"/>
                        </span>
                    </li>
                </ul>
            </div>

            <!-- RIGHT: message list + preview, stacked or side-by-side
                 depending on the shared layout preference. -->
            <div class="d-flex flex-grow-1"
                 t-att-class="pane.wrapClass"
                 style="min-width: 0; min-height: 0;">

                <!-- Message list -->
                <div class="d-flex flex-column"
                     t-att-class="pane.layout === 'right' ? 'border-end' : 'border-bottom'"
                     t-att-style="pane.listStyle">
                    <div class="px-3 py-2 d-flex justify-content-between align-items-center bg-white border-bottom gap-2 position-relative">
                        <div class="flex-shrink-0">
                            <strong><t t-esc="state.currentFolder"/></strong>
                            <span class="text-muted ms-2 small">
                                <t t-if="!state.loadingMessages">
                                    <t t-esc="state.messages.length"/> / <t t-esc="state.total"/>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-spinner fa-spin"/>
                                </t>
                            </span>
                        </div>
                        <div class="flex-grow-1" style="max-width: 360px;">
                            <input t-ref="searchInput"
                                   type="search"
                                   class="form-control form-control-sm"
                                   placeholder="Rechercher (sujet, expéditeur)… touche /"
                                   t-att-value="state.searchQuery"
                                   t-on-input="(ev) => this.onSearchInput(ev)"/>
                        </div>
                        <div class="position-relative flex-shrink-0">
                            <button class="btn btn-sm btn-light"
                                    t-att-class="{ 'active text-primary': state.columnsOpen }"
                                    t-on-click="toggleColumnsMenu"
                                    title="Choisir les colonnes de la liste">
                                <i class="fa fa-table"/>
                            </button>
                            <div t-if="state.columnsOpen"
                                 class="card shadow position-absolute end-0 mt-1"
                                 style="top: 100%; width: 240px; z-index: 11;">
                                <div class="card-header d-flex justify-content-between align-items-center py-2">
                                    <strong>Colonnes</strong>
                                    <button class="btn-close" t-on-click="() => this.toggleColumnsMenu()"/>
                                </div>
                                <div class="card-body py-2">
                                    <div class="form-check" t-foreach="columnDefs" t-as="col" t-key="col.key">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               t-att-id="'bf_browser_col_' + col.key"
                                               t-att-checked="cols[col.key]"
                                               t-on-change="() => this.toggleColumn(col.key)"/>
                                        <label class="form-check-label small"
                                               t-att-for="'bf_browser_col_' + col.key"
                                               t-esc="col.label"/>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               id="bf_browser_col_subject" checked="checked" disabled="disabled"/>
                                        <label class="form-check-label small text-muted"
                                               for="bf_browser_col_subject">Sujet (toujours affiché)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="btn-group btn-group-sm flex-shrink-0" role="group"
                             aria-label="Disposition de l'aperçu">
                            <button class="btn btn-light"
                                    t-att-class="{ 'active text-primary': pane.layout === 'bottom' }"
                                    title="Aperçu sous la liste"
                                    t-on-click="() => this.setPaneLayout('bottom')">
                                <i class="fa fa-columns fa-rotate-270"/>
                            </button>
                            <button class="btn btn-light"
                                    t-att-class="{ 'active text-primary': pane.layout === 'right' }"
                                    title="Aperçu à droite de la liste"
                                    t-on-click="() => this.setPaneLayout('right')">
                                <i class="fa fa-columns"/>
                            </button>
                        </div>
                        <button class="btn btn-sm btn-light"
                                t-on-click="toggleSettings"
                                title="Préférences">
                            <i class="fa fa-cog"/>
                        </button>
                        <!-- Settings dropdown -->
                        <div t-if="state.settingsOpen"
                             class="card shadow position-absolute end-0 mt-1"
                             style="top: 100%; width: 320px; z-index: 10;">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <strong>Préférences</strong>
                                <button class="btn-close" t-on-click="closeSettings"/>
                            </div>
                            <div class="card-body py-2">
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Format de date</label>
                                    <select class="form-select form-select-sm"
                                            t-att-value="state.settings.dateFormat"
                                            t-on-change="(ev) => this.onSettingChange('dateFormat', ev)">
                                        <option value="relative">Relatif (aujourd'hui 14:35)</option>
                                        <option value="absolute">Absolu (2026-05-10 14:35)</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Affichage de l'expéditeur</label>
                                    <select class="form-select form-select-sm"
                                            t-att-value="state.settings.senderDisplay"
                                            t-on-change="(ev) => this.onSettingChange('senderDisplay', ev)">
                                        <option value="name">Nom seulement</option>
                                        <option value="email">Adresse seulement</option>
                                        <option value="both">Nom &lt;adresse&gt;</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Messages par page</label>
                                    <select class="form-select form-select-sm"
                                            t-att-value="state.settings.pageSize"
                                            t-on-change="(ev) => this.onSettingChange('pageSize', ev)">
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                        <option value="200">200</option>
                                        <option value="500">500</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Densité d'affichage</label>
                                    <select class="form-select form-select-sm"
                                            t-att-value="state.settings.density"
                                            t-on-change="(ev) => this.onSettingChange('density', ev)">
                                        <option value="comfortable">Confortable</option>
                                        <option value="compact">Compacte (une ligne par courriel)</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Position de l'aperçu</label>
                                    <select class="form-select form-select-sm"
                                            t-att-value="state.settings.paneLayout"
                                            t-on-change="(ev) => this.onSettingChange('paneLayout', ev)">
                                        <option value="bottom">Sous la liste</option>
                                        <option value="right">À droite de la liste</option>
                                    </select>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="bf_email_bold_unread"
                                           t-att-checked="state.settings.boldUnread"
                                           t-on-change="(ev) => this.onSettingChange('boldUnread', ev)"/>
                                    <label class="form-check-label small" for="bf_email_bold_unread">
                                        Mettre les non-lus en gras
                                    </label>
                                </div>
                            </div>
                            <div class="card-footer small text-muted py-1">
                                Préférences sauvegardées localement dans ce navigateur.
                            </div>
                        </div>
                    </div>
                    <!-- Bulk action bar (visible when checkboxes are checked) -->
                    <div t-if="selectedCount > 0"
                         class="px-3 py-2 bg-info-subtle border-bottom d-flex align-items-center gap-2 flex-wrap">
                        <strong><t t-esc="selectedCount"/> sélectionné(s)</strong>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-primary dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    t-att-disabled="state.acting">
                                <i class="fa fa-share me-1"/> Router…
                            </button>
                            <ul class="dropdown-menu">
                                <li><button class="dropdown-item" type="button" t-on-click="() => this.quickReroute('project.task')"><i class="fa fa-tasks me-2"/>Vers une tâche</button></li>
                                <li><button class="dropdown-item" type="button" t-on-click="() => this.quickReroute('helpdesk.ticket')"><i class="fa fa-life-ring me-2"/>Vers un ticket</button></li>
                                <li><button class="dropdown-item" type="button" t-on-click="() => this.quickReroute('res.partner')"><i class="fa fa-user me-2"/>Vers un contact</button></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li><button class="dropdown-item" type="button" t-on-click="() => this.quickReroute(null)"><i class="fa fa-folder-open-o me-2"/>Autre cible…</button></li>
                            </ul>
                        </div>
                        <button class="btn btn-sm btn-success"
                                t-att-disabled="state.acting"
                                t-on-click="bulkMarkHandled"
                                title="Marquer la sélection comme traitée et archiver">
                            <i class="fa fa-check me-1"/> Traité
                        </button>
                        <button class="btn btn-sm btn-link ms-auto"
                                t-on-click="clearSelection">
                            Effacer la sélection
                        </button>
                    </div>
                    <div class="flex-grow-1" style="overflow-y: auto;">
                        <table t-att-class="'table table-hover mb-0 ' + (state.settings.density === 'compact' ? 'table-sm o_bf_email_compact ' : '')">
                            <thead class="bg-light" style="position: sticky; top: 0; z-index: 1;">
                                <tr>
                                    <th class="ps-3" t-att-style="'width: ' + colWidths.check + 'px;'"></th>
                                    <th t-if="cols.date" t-att-style="'width: ' + colWidths.date + 'px;'">Date</th>
                                    <th t-if="cols.sender" t-att-style="'width: ' + colWidths.correspondent + 'px;'">Expéditeur</th>
                                    <th>Sujet</th>
                                    <th t-if="cols.state" t-att-style="'width: ' + colWidths.state + 'px;'" title="Statut">État</th>
                                    <th class="pe-3" t-att-style="'width: ' + colWidths.act + 'px;'"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="visibleMessages" t-as="m" t-key="m.uid"
                                    t-att-class="(m.uid === state.selectedUid ? 'table-primary ' : '') + (state.settings.boldUnread and !m.seen ? 'fw-bold ' : '') + 'o_bf_email_msg_row'"
                                    style="cursor: pointer;"
                                    draggable="true"
                                    t-on-click="() => this.selectMessage(m.uid)"
                                    t-on-dragstart="(ev) => this.onRowDragStart(ev, m.uid)"
                                    t-on-dragend="() => this.onRowDragEnd()">
                                    <td class="ps-3" t-on-click.stop="">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               t-att-checked="state.selectedUids[m.uid]"
                                               t-on-click="(ev) => this.toggleSelection(m.uid, ev)"/>
                                    </td>
                                    <td t-if="cols.date" class="small"><t t-esc="formatRelativeDate(m.date)"/></td>
                                    <td t-if="cols.sender" class="text-truncate"
                                        t-att-style="'max-width: ' + colWidths.correspondent + 'px;'"
                                        t-att-title="m.from">
                                        <t t-esc="senderCell(m)"/>
                                    </td>
                                    <td class="text-truncate" t-att-title="m.subject">
                                        <t t-esc="m.subject"/>
                                    </td>
                                    <td t-if="cols.state" class="text-nowrap">
                                        <i t-if="m.already_in_bf_email" class="fa fa-check-circle text-success" title="Déjà routé dans bf.email"/>
                                        <i t-if="m.is_snoozed" class="fa fa-moon-o text-info ms-1" title="Reporté (snooze actif)"/>
                                        <i t-if="m.is_replied" class="fa fa-reply text-muted ms-1" title="Répondu"/>
                                    </td>
                                    <td class="pe-3 text-end">
                                        <button class="btn btn-sm btn-light"
                                                t-att-disabled="state.acting"
                                                t-on-click.stop="() => this.markHandledForRow(m.uid)"
                                                title="Marquer Traité (raccourci E)">
                                            <i class="fa fa-check"/>
                                        </button>
                                    </td>
                                </tr>
                                <tr t-if="!state.loadingMessages and visibleMessages.length === 0">
                                    <td t-att-colspan="visibleColumnCount" class="text-center text-muted p-4">
                                        <t t-if="state.searchQuery">Aucun résultat pour « <t t-esc="state.searchQuery"/> » dans la page chargée.</t>
                                        <t t-else="">Aucun message dans ce dossier.</t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <!-- Infinite-scroll sentinel + loading spinner -->
                        <div t-ref="listBottom" style="height: 1px;"/>
                        <div t-if="state.loadingMoreMessages" class="text-center text-muted py-2">
                            <i class="fa fa-spinner fa-spin"/> Chargement…
                        </div>
                        <div t-elif="!canLoadMore and state.messages.length and !state.searchQuery"
                             class="text-center text-muted small py-2">
                            — fin de la liste —
                        </div>
                    </div>
                </div>

                <div class="o_bf_email_splitter"
                     t-att-style="pane.splitterStyle"
                     title="Glisser pour redimensionner"
                     t-on-mousedown="onSplitterMouseDown"/>

                <!-- Preview -->
                <div class="d-flex flex-column" t-att-style="pane.paneStyle">
                    <t t-if="state.loadingPreview">
                        <div class="p-4 text-center text-muted">
                            <i class="fa fa-spinner fa-spin fa-2x"/>
                        </div>
                    </t>
                    <t t-elif="state.preview">
                        <div class="px-3 py-2 border-bottom bg-light">
                            <div class="fw-bold d-flex align-items-start gap-2">
                                <span class="flex-grow-1"><t t-esc="state.preview.subject"/></span>
                                <button class="btn btn-sm btn-light py-0 px-1 flex-shrink-0"
                                        t-on-click="toggleRibbon"
                                        t-att-title="ribbonToggleTitle">
                                    <i t-att-class="ribbonCollapsed ? 'fa fa-angle-double-down' : 'fa fa-angle-double-up'"/>
                                </button>
                            </div>
                            <div class="small text-muted">
                                <span class="me-2"><strong>De :</strong> <t t-esc="state.preview.from"/></span>
                                <span class="me-2"><strong>À :</strong> <t t-esc="state.preview.to"/></span>
                                <span><strong>Date :</strong> <t t-esc="formatRelativeDate(state.preview.date)"/></span>
                            </div>
                            <div t-att-class="ribbonClass">
                                <button class="btn btn-sm btn-primary"
                                        t-att-disabled="state.acting"
                                        t-on-click="reply"
                                        title="Raccourci R">
                                    <i class="fa fa-reply me-1"/><span class="o_bf_ribbon_label"> Répondre</span>
                                </button>
                                <button class="btn btn-sm btn-light"
                                        t-att-disabled="state.acting"
                                        t-on-click="replyAll"
                                        title="Raccourci Shift+R">
                                    <i class="fa fa-reply-all me-1"/><span class="o_bf_ribbon_label"> Répondre à tous</span>
                                </button>
                                <button class="btn btn-sm btn-light"
                                        t-att-disabled="state.acting"
                                        t-on-click="forward"
                                        title="Raccourci F">
                                    <i class="fa fa-share me-1"/><span class="o_bf_ribbon_label"> Transférer</span>
                                </button>
                                <button class="btn btn-sm btn-success"
                                        t-att-disabled="state.acting"
                                        t-on-click="markHandled"
                                        title="Marquer Traité + archiver (raccourci E)">
                                    <i class="fa fa-check me-1"/><span class="o_bf_ribbon_label"> Traité</span>
                                </button>
                                <button class="btn btn-sm btn-light"
                                        t-att-disabled="state.acting"
                                        t-on-click="snooze"
                                        title="Reporter (raccourci H)">
                                    <i class="fa fa-moon-o me-1"/><span class="o_bf_ribbon_label"> Reporter</span>
                                </button>
                                <button class="btn btn-sm btn-light"
                                        t-att-disabled="state.acting"
                                        t-on-click="createActivity"
                                        title="Créer une activité depuis ce courriel (raccourci T)">
                                    <i class="fa fa-bell me-1"/><span class="o_bf_ribbon_label"> Activité</span>
                                </button>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-secondary"
                                            t-att-disabled="state.acting"
                                            t-on-click="() => this.quickReroute(null)"
                                            title="Router vers une tâche, ticket, contact, etc. (raccourci Y)">
                                        <i class="fa fa-share me-1"/><span class="o_bf_ribbon_label"> Router…</span>
                                    </button>
                                    <button class="btn btn-secondary dropdown-toggle dropdown-toggle-split"
                                            data-bs-toggle="dropdown"
                                            t-att-disabled="state.acting">
                                        <span class="visually-hidden">Cibles rapides</span>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><button class="dropdown-item" type="button" t-on-click="() => this.quickReroute('project.task')"><i class="fa fa-tasks me-2"/>Vers une tâche</button></li>
                                        <li><button class="dropdown-item" type="button" t-on-click="() => this.quickReroute('helpdesk.ticket')"><i class="fa fa-life-ring me-2"/>Vers un ticket</button></li>
                                        <li><button class="dropdown-item" type="button" t-on-click="() => this.quickReroute('res.partner')"><i class="fa fa-user me-2"/>Vers un contact</button></li>
                                        <li><hr class="dropdown-divider"/></li>
                                        <li><button class="dropdown-item" type="button" t-on-click="() => this.quickReroute(null)"><i class="fa fa-folder-open-o me-2"/>Autre cible…</button></li>
                                    </ul>
                                </div>
                                <button class="btn btn-sm btn-outline-danger ms-auto"
                                        t-att-disabled="state.acting"
                                        t-on-click="moveToTrash"
                                        title="Supprimer / Trash (raccourci Suppr)">
                                    <i class="fa fa-trash me-1"/><span class="o_bf_ribbon_label"> Supprimer</span>
                                </button>
                                <span t-if="state.preview.already_in_bf_email" class="badge bg-success align-self-center ms-2">
                                    <i class="fa fa-check me-1"/><span class="o_bf_ribbon_label"> Déjà dans bf.email</span>
                                </span>
                            </div>
                        </div>
                        <iframe class="flex-grow-1 border-0 w-100"
                                style="background: white;"
                                sandbox="allow-same-origin"
                                t-att-srcdoc="previewSrcdoc"/>
                    </t>
                    <t t-else="">
                        <div class="p-4 text-center text-muted">
                            <i class="fa fa-envelope-o fa-2x mb-2 d-block"/>
                            Sélectionne un message dans la liste pour voir le corps.
                            <div class="small mt-2">
                                Raccourcis : <kbd>J</kbd>/<kbd>K</kbd> naviguer · <kbd>R</kbd> répondre · <kbd>E</kbd> Traité · <kbd>Y</kbd> router · <kbd>H</kbd> reporter · <kbd>T</kbd> activité · <kbd>Suppr</kbd> Trash · <kbd>S</kbd> ou <kbd>/</kbd> rechercher
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
