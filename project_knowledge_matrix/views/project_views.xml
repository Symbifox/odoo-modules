<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Project Form: Add Smart Button -->
    <record id="project_view_form_inherit_knowledge" model="ir.ui.view">
        <field name="name">project.project.form.inherit.knowledge</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_knowledge_matrix"
                        icon="fa-th-list"
                        invisible="knowledge_matrix_count == 0">
                    <div class="o_stat_info">
                        <field name="knowledge_progress" widget="percentpie"/>
                        <span class="o_stat_text">Knowledge</span>
                    </div>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_create_knowledge_matrix"
                        icon="fa-plus"
                        invisible="knowledge_matrix_count != 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Add Knowledge Matrix</span>
                    </div>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_credentials"
                        icon="fa-key">
                    <field name="credential_count" widget="statinfo" string="Credentials"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_documents"
                        icon="fa-file-text-o"
                        groups="project_knowledge_matrix.group_document_user">
                    <field name="document_count" widget="statinfo" string="Documents"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_knowledge_dashboard"
                        icon="fa-dashboard"
                        groups="project_knowledge_matrix.group_knowledge_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tableau de bord</span>
                    </div>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_raci_stakeholder"
                        icon="fa-users"
                        invisible="knowledge_matrix_count == 0"
                        groups="project_knowledge_matrix.group_knowledge_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">RACI</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Extend Project Form: Add Matrice notebook tab (F4) -->
    <record id="project_view_form_inherit_knowledge_matrix_tab" model="ir.ui.view">
        <field name="name">project.project.form.inherit.knowledge.matrix.tab</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='description']" position="after">
                <page string="Matrice" name="knowledge_matrix_tab"
                      groups="project_knowledge_matrix.group_knowledge_user">
                    <!-- When matrix exists: show items -->
                    <div invisible="knowledge_matrix_count == 0">
                        <field name="knowledge_item_ids"
                               context="{'default_project_id': id}"
                               widget="one2many"
                               mode="list">
                            <list editable="bottom" default_group_by="section_id"
                                  decoration-danger="is_overdue"
                                  decoration-warning="state == 'pending' and deadline"
                                  decoration-success="state == 'done'"
                                  decoration-muted="state == 'na'"
                                  decoration-info="state == 'in_progress'">
                                <field name="priority" widget="priority"/>
                                <field name="decision_id" readonly="1"/>
                                <field name="section_id"/>
                                <field name="name"/>
                                <field name="state" widget="badge"
                                       decoration-success="state in ('done', 'accepted')"
                                       decoration-info="state == 'in_progress'"
                                       decoration-warning="state in ('pending', 'proposed')"
                                       decoration-danger="state in ('blocked', 'rejected')"/>
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                <field name="deadline"/>
                                <field name="phase" optional="hide"/>
                                <field name="deliverable" optional="hide"/>
                                <field name="notes" optional="hide"/>
                                <field name="is_overdue" column_invisible="True"/>
                                <field name="matrix_id" column_invisible="True"/>
                            </list>
                        </field>
                    </div>
                    <!-- When no matrix: show placeholder -->
                    <div invisible="knowledge_matrix_count != 0"
                         class="text-center py-5 text-muted">
                        <i class="fa fa-th-list fa-3x mb-3 d-block"/>
                        <p class="mb-3">Aucune matrice de connaissances pour ce projet.</p>
                        <button name="action_create_knowledge_matrix"
                                type="object"
                                class="btn btn-primary"
                                string="Créer une matrice"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Project Kanban: Show progress indicator -->
    <record id="project_view_kanban_inherit_knowledge" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.knowledge</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="knowledge_matrix_count"/>
                <field name="knowledge_progress"/>
            </xpath>
        </field>
    </record>

</odoo>
