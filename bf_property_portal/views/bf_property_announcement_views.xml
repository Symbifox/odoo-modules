<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_property_announcement_list" model="ir.ui.view">
            <field name="name">bf.property.announcement.list</field>
            <field name="model">bf.property.announcement</field>
            <field name="arch" type="xml">
                <list decoration-muted="not is_visible_now">
                    <field name="pinned" widget="boolean_toggle"/>
                    <field name="name"/>
                    <field name="syndicat_id"/>
                    <field name="building_id" optional="show"/>
                    <field name="audience"/>
                    <field name="date_start"/>
                    <field name="date_end" optional="show"/>
                    <field name="published" widget="boolean_toggle"/>
                    <field name="is_visible_now" string="Affichée"/>
                </list>
            </field>
        </record>

        <record id="view_property_announcement_form" model="ir.ui.view">
            <field name="name">bf.property.announcement.form</field>
            <field name="model">bf.property.announcement</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_publish" type="object" string="Publier"
                                class="btn-primary" invisible="published"/>
                        <button name="action_unpublish" type="object" string="Retirer du portail"
                                invisible="not published"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Ascenseur arrêté jusqu'à mercredi"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="syndicat_id"/>
                                <field name="building_id"/>
                                <field name="audience"/>
                                <field name="pinned"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="published" readonly="1"/>
                                <field name="is_visible_now"/>
                            </group>
                        </group>
                        <field name="body" placeholder="Le texte tel que l'occupant le lira."/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_property_announcement_search" model="ir.ui.view">
            <field name="name">bf.property.announcement.search</field>
            <field name="model">bf.property.announcement</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="syndicat_id"/>
                    <filter name="visible" string="Affichées en ce moment"
                            domain="[('is_visible_now', '=', True)]"/>
                    <filter name="unpublished" string="Non publiées"
                            domain="[('published', '=', False)]"/>
                    <separator/>
                    <filter name="owners" string="Copropriétaires"
                            domain="[('audience', 'in', ['all', 'owners'])]"/>
                    <filter name="occupants" string="Occupants"
                            domain="[('audience', 'in', ['all', 'occupants'])]"/>
                    <group expand="0" string="Regrouper par">
                        <filter name="group_syndicat" string="Syndicat" context="{'group_by': 'syndicat_id'}"/>
                        <filter name="group_audience" string="Auditoire" context="{'group_by': 'audience'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_property_announcement" model="ir.actions.act_window">
            <field name="name">Annonces</field>
            <field name="res_model">bf.property.announcement</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
