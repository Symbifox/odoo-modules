<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add subscription_id field on vendor bill form -->
    <record id="view_move_form_subscription" model="ir.ui.view">
        <field name="name">account.move.form.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_payment_term_id" position="after">
                <field name="subscription_id"
                       options="{'no_create': True}"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"/>
            </field>
        </field>
    </record>

    <!-- Add Refacturer button on vendor bill form -->
    <record id="view_move_form_rebill_button" model="ir.ui.view">
        <field name="name">account.move.form.rebill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_open_rebill_wizard" type="object"
                        string="Refacturer au client" class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'in_refund') or not subscription_id"/>
            </header>
        </field>
    </record>

    <!-- Add subscription column on bill list -->
    <record id="view_invoice_tree_subscription" model="ir.ui.view">
        <field name="name">account.move.tree.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_partner_display_name'][1]" position="after">
                <field name="subscription_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
