<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_tip" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pourboire</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[field[@name='expense_outstanding_account_id']]" position="after">
                <setting company_dependent="1" string="Compte des pourboires"
                         help="Laissé vide, le pourboire va au même compte que la dépense qui le porte.">
                    <field name="expense_tip_account_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
