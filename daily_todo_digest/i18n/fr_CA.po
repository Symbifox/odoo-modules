msgstr "Averses violentes"

#. module: daily_todo_digest
#: model:daily.digest.quote,author:daily_todo_digest.quote_86
#: model:daily.digest.quote,author:daily_todo_digest.quote_87
msgid "Virginia Woolf"
msgstr "Virginia Woolf"

#. module: daily_todo_digest
#: model:daily.digest.quote,quote:daily_todo_digest.quote_105
msgid "Walls were built by those who were afraid of those who are different."
msgstr ""
"Les murs ont été construits par ceux qui avaient peur de ceux qui sont "
"différents."

#. module: daily_todo_digest
#: model:daily.digest.quote,quote:daily_todo_digest.quote_35
msgid "We are all in the gutter, but some of us are looking at the stars."
msgstr ""
"Nous sommes tous dans le caniveau, mais certains d'entre nous regardent les "
"étoiles."

#. module: daily_todo_digest
#: model:daily.digest.quote,quote:daily_todo_digest.quote_65
msgid ""
"We do not inherit the earth from our ancestors, we borrow it from our "
"children."
msgstr ""
"Nous n'héritons pas de la terre de nos ancêtres, nous l'empruntons à nos "
"enfants."

#. module: daily_todo_digest
#: model:daily.digest.quote,quote:daily_todo_digest.quote_60
msgid "We do not see things as they are, we see them as we are."
msgstr ""
"Nous ne voyons pas les choses comme elles sont, nous les voyons comme nous "
"sommes."

#. module: daily_todo_digest
#: model:ir.model.fields,field_description:daily_todo_digest.field_daily_digest_config__include_weather
#: model_terms:ir.ui.view,arch_db:daily_todo_digest.view_daily_digest_config_form
