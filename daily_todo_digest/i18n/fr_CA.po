#: model:ir.model.fields,field_description:daily_todo_digest.field_daily_digest_config__include_today_tasks
msgid "Today's tasks"
msgstr "Tâches du jour"

#. module: daily_todo_digest
#: model:daily.digest.quote,quote:daily_todo_digest.quote_06
msgid "True emancipation begins in woman's soul."
msgstr "La vraie émancipation commence dans l'âme de la femme."

#. module: daily_todo_digest
#. odoo-python
#: code:addons/daily_todo_digest/models/daily_digest.py:0
msgid "Unknown"
msgstr "Inconnu"

#. module: daily_todo_digest
#: model:daily.digest.quote,quote:daily_todo_digest.quote_43
msgid ""
"Until the lions have their own historians, the history of the hunt will "
"always glorify the hunter."
msgstr ""
"Jusqu'à ce que les lions aient leurs propres historiens, l'histoire de la "
"chasse glorifiera toujours le chasseur."

#. module: daily_todo_digest
#: model:ir.model.fields,field_description:daily_todo_digest.field_daily_digest_config__include_upcoming_tasks
