<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="reveal_link_wizard_view_form" model="ir.ui.view">
        <field name="name">secure.transfer.reveal.wizard.form</field>
        <field name="model">secure.transfer.reveal.wizard</field>
        <field name="arch" type="xml">
            <form string="Share link">
                <field name="revealed" invisible="1"/>

                <!-- Step 1 — warning + confirmation (nothing logged yet) -->
                <div invisible="revealed">
                    <div class="alert alert-warning" role="alert">
                        You are about to reveal the <strong>share link</strong>
                        for this transfer. This reveal will be <strong>recorded in the access
                        log</strong> (Law 25 record). Only share the link with
                        legitimate recipients: anyone who holds it can download
                        the files (subject to the password, if any).
                    </div>
                    <group>
                        <field name="transfer_id" readonly="1"/>
                    </group>
                </div>

                <!-- Step 2 — revealed (after confirmation) -->
                <div invisible="not revealed">
                    <div class="alert alert-info" role="alert">
                        Link revealed and logged. Copy it, then share it with the recipient.
                    </div>
                    <group>
                        <field name="transfer_id" readonly="1"/>
                        <field name="url" widget="CopyClipboardChar"/>
                    </group>
                </div>

                <footer>
                    <button string="Reveal link" name="action_confirm_reveal" type="object"
                            class="btn-primary" invisible="revealed"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" invisible="revealed"/>
                    <button string="Close" class="btn-primary" special="cancel" invisible="not revealed"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reveal_link_wizard" model="ir.actions.act_window">
        <field name="name">Reveal the share link</field>
        <field name="res_model">secure.transfer.reveal.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="reveal_link_wizard_view_form"/>
        <field name="target">new</field>
    </record>

</odoo>
