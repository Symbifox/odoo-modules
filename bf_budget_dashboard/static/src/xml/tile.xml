<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bf_budget_dashboard.Tile" t-inherit="bf_dashboard.Dashboard" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='state.data.overdue_activities']" position="after">
            <!-- Budget -->
            <t t-if="state.data.budget">
                <div class="col-lg col-md-6 mb-3">
                    <div t-attf-class="card h-100 {{state.data.budget.shown_alert_lines > 0 ? 'border-danger' : ''}}">
                        <div class="card-body text-center">
                            <h2 t-attf-class="mb-0 {{state.data.budget.shown_alert_lines > 0 ? 'text-danger' : 'text-muted'}}"
                                t-esc="state.data.budget.consumed_display or '--'"/>
                            <small class="text-muted">
                                <i class="fa fa-pie-chart me-1"/>
                                <t t-if="state.data.budget.kind == 'revenue'">Revenue booked</t>
                                <t t-else="">Budget consumed</t>
                            </small>
                            <br/>
                            <small class="text-muted" t-esc="state.data.budget.name"/>
                            <t t-if="state.data.budget.alert_lines > 0">
                                <br/>
                                <small class="text-danger fw-bold">
                                    <t t-esc="state.data.budget.alert_lines"/> flagged line(s)
                                </small>
                            </t>
                            <t t-if="state.data.budget.drift">
                                <br/>
                                <small class="text-muted">
                                    <t t-esc="state.data.budget.drift_display"/> vs theoretical
                                </small>
                            </t>
                            <t t-if="state.data.budget.budget_count &gt; 1">
                                <br/>
                                <small class="text-muted">
                                    <t t-esc="state.data.budget.budget_count"/> open budgets
                                    <t t-if="state.data.budget.partial_count">, this one counted</t>
                                </small>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
            <!-- Le collecteur a levé : la tuile le dit, au lieu de se lire comme
                 « aucun budget ouvert ». Convention de bf_home (data.failed). -->
            <t t-elif="state.data.failed and state.data.failed.budget">
                <div class="col-lg col-md-6 mb-3">
                    <div class="card h-100 border-warning">
                        <div class="card-body text-center">
                            <h2 class="mb-0 text-muted">--</h2>
                            <small class="text-muted">
                                <i class="fa fa-pie-chart me-1"/>Budget
                            </small>
                            <br/>
                            <small class="text-warning">Data not available</small>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>

</templates>
