<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_property_building_list" model="ir.ui.view">
        <field name="name">bf.property.building.list</field>
        <field name="model">bf.property.building</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="syndicat_id"/>
                <field name="street" optional="show"/>
                <field name="city" optional="show"/>
                <field name="year_built" optional="hide"/>
                <field name="unit_count" string="Fractions"/>
                <field name="quote_part_total"/>
            </list>
        </field>
    </record>

    <record id="view_property_building_form" model="ir.ui.view">
        <field name="name">bf.property.building.form</field>
        <field name="model">bf.property.building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object"
                                class="oe_stat_button" icon="fa-th">
                            <field name="unit_count" widget="statinfo" string="Fractions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Immeuble A"/></h1>
                    </div>
                    <group>
                        <group string="Rattachement">
                            <field name="syndicat_id"/>
                            <field name="cadastre"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Bâtiment">
                            <field name="year_built"/>
                            <field name="storeys"/>
                            <field name="quote_part_total"/>
                        </group>
                        <group string="Adresse" colspan="2">
                            <field name="street" placeholder="Rue"/>
                            <field name="street2" placeholder="Complément"/>
                            <field name="city"/>
                            <field name="state_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="zip"/>
                            <field name="country_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fractions" name="units">
                            <field name="unit_ids"
                                   context="{'default_building_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="unit_type"/>
                                    <field name="floor" optional="show"/>
                                    <field name="area" optional="hide"/>
                                    <field name="quote_part"/>
                                    <field name="quote_part_pct" optional="hide"/>
                                    <field name="owner_display" readonly="1"/>
                                    <field name="is_rented" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Parties communes" name="common_areas">
                            <field name="common_area_ids"
                                   context="{'default_building_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="area_type"/>
                                    <field name="bookable"/>
                                    <field name="area" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_property_building" model="ir.actions.act_window">
        <field name="name">Immeubles</field>
        <field name="res_model">bf.property.building</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
