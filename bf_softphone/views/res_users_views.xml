<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_users_form_softphone" model="ir.ui.view">
        <field name="name">res.users.form.softphone</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Phone" name="bf_softphone"
                      groups="bf_softphone.group_softphone_user">
                    <group>
                        <field name="sip_enabled"/>
                        <field name="sip_extension"
                               placeholder="1001"/>
                        <!-- sip_password : rendu uniquement pour un gestionnaire
                             (le champ est groups=manager ; Odoo l'omet sinon). -->
                        <field name="sip_password" password="True"
                               groups="bf_softphone.group_softphone_manager"/>
                        <field name="sip_missed_call_activity"/>
                        <field name="sip_callback_number"
                               placeholder="514 555-0142"/>
                    </group>
                    <div class="text-muted">
                        The SIP extension and password come from the PBX (see the extension's record). The password is only visible to a phone manager.
                    </div>
                    <div class="text-muted mt8">
                        The callback number is used for calls requested from the mobile app: the PBX rings it, then dials the other party with the business line's caller ID. If empty, the mobile number on the contact record is used.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
