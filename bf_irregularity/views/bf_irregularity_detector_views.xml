<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bf_irregularity_detector_list" model="ir.ui.view">
        <field name="name">bf.irregularity.detector.list</field>
        <field name="model">bf.irregularity.detector</field>
        <field name="arch" type="xml">
            <list decoration-danger="last_error" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="family"/>
                <field name="severity"/>
                <field name="threshold"/>
                <field name="threshold_label"/>
                <field name="open_count"/>
                <field name="last_run"/>
                <field name="last_error" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bf_irregularity_detector_form" model="ir.ui.view">
        <field name="name">bf.irregularity.detector.form</field>
        <field name="model">bf.irregularity.detector</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run" type="object" string="Run now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_irregularities" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="open_count" widget="statinfo" string="Open"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="family"/>
                            <field name="severity"/>
                            <label for="threshold"/>
                            <div class="o_row">
                                <field name="threshold"/>
                                <field name="threshold_label" nolabel="1"/>
                            </div>
                        </group>
                        <group>
                            <field name="default_owner_id"/>
                            <field name="notify_activity"/>
                            <field name="code" groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                            <field name="last_run"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this detector looks for, and why it matters."/>
                    <div invisible="not last_error" class="alert alert-danger" role="alert">
                        <field name="last_error"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_irregularity_detector" model="ir.actions.act_window">
        <field name="name">Detectors</field>
        <field name="res_model">bf.irregularity.detector</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
