<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Catégorie de module pour la liste déroulante des droits.

             Créée par project_knowledge_matrix jusqu'à sa 18.0.11.5.0, puis
             réattribuée à ce module par sa migration 18.0.12.0.0. L'ID externe
             ne change pas de NOM, seulement de module : les utilisateurs qui
             portaient déjà le groupe le gardent. -->
        <record id="module_category_corporate" model="ir.module.category">
            <field name="name">Corporate governance</field>
            <field name="sequence">33</field>
        </record>

        <!-- Un seul groupe : la gouvernance corporative n'a pas d'échelle
             utilisateur/gestionnaire. Elle se lit à deux niveaux — les
             utilisateurs de documents lisent, le gestionnaire corporatif
             écrit — et le second implique le premier par le gestionnaire de
             documents. -->
        <record id="group_corporate_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="comment">Full access to corporate governance features (resolutions, directors, officers, compliance).</field>
            <field name="category_id" ref="module_category_corporate"/>
            <field name="implied_ids" eval="[(4, ref('project_knowledge_matrix.group_document_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Un événement appartient à UNE société. Sans règle, le
             calendrier, le tableau de bord et le rapport bimensuel montraient
             à chaque société les échéances de toutes les autres. -->
        <record id="corporate_compliance_event_rule_company" model="ir.rule">
            <field name="name">Compliance events: allowed companies</field>
            <field name="model_id" ref="model_corporate_compliance_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Le générateur est un transitoire, donc une vraie table : sans règle,
             un gestionnaire lirait le formulaire d'un autre. Règles GLOBALES (pas
             de groupe), comme celles du cœur sur mail.compose.message. -->
        <record id="corporate_compliance_generate_rule_owner" model="ir.rule">
            <field name="name">Compliance generator: own forms only</field>
            <field name="model_id" ref="model_corporate_compliance_generate"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <record id="corporate_compliance_generate_line_rule_owner" model="ir.rule">
            <field name="name">Compliance generator lines: own forms only</field>
            <field name="model_id" ref="model_corporate_compliance_generate_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

    </data>
</odoo>
