<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="letter_quicktext_picker_form" model="ir.ui.view">
        <field name="name">letter.quicktext.picker.form</field>
        <field name="model">letter.quicktext.picker</field>
        <field name="arch" type="xml">
            <form string="Insérer un bloc de texte">
                <group>
                    <field name="letter_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="quicktext_id"/>
                    <field name="position"/>
                </group>
                <group string="Aperçu du bloc" invisible="not preview_html">
                    <field name="preview_html" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_insert" type="object"
                            string="Insérer" class="btn-primary"
                            icon="fa-puzzle-piece"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
