<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_editorial_entry_form" model="ir.ui.view">
        <field name="name">bf.editorial.entry.form</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <form string="Entrée éditoriale">
                <header>
                    <button name="action_run_qa" type="object" string="Passer la QA"
                            class="btn-secondary"
                            help="Contrôles déterministes. Aucune intelligence artificielle n'intervient."/>
                    <button name="action_sync_from_post" type="object"
                            string="Relire les créneaux de langue" class="btn-secondary"
                            invisible="not post_id"/>
                    <button name="action_apply_checklist_templates" type="object"
                            string="Reposer les gabarits" class="btn-secondary"
                            help="Utile après un changement de pilier ou de nature."/>
                    <button name="action_fix_mechanical" type="object"
                            string="Corriger les défauts mécaniques"
                            class="btn-secondary" invisible="not post_id"
                            confirm="Cette action écrit dans le billet. Elle ne corrige que les titres vides et les en-têtes de tableau sans portée, dans toutes les langues, puis repasse la QA. Continuer?"
                            help="Titres vides et portées de tableau, dans toutes les langues. Rien qui demande un jugement."/>
                    <button name="action_open_waiver" type="object"
                            string="Signer une dérogation" class="btn-secondary"
                            invisible="preflight_ok or published_date or qa_waived"
                            groups="bf_editorial.group_editorial_manager"
                            help="Accepter par écrit les motifs de jugement qui retiennent la publication."/>
                    <button name="action_revoke_waiver" type="object"
                            string="Lever la dérogation" class="btn-secondary"
                            invisible="not qa_waived"
                            groups="bf_editorial.group_editorial_manager"/>
                    <button name="action_publish" type="object" string="Publier"
                            class="btn-primary" invisible="published_date or not preflight_ok"
                            groups="bf_editorial.group_editorial_manager"/>
                    <button name="action_publish" type="object" string="Publier"
                            class="btn-secondary" invisible="published_date or preflight_ok"
                            groups="bf_editorial.group_editorial_manager"
                            help="La garde de pré-vol refusera et expliquera pourquoi."/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Publiée" bg_color="text-bg-success"
                            invisible="not published_date"/>
                    <widget name="web_ribbon" title="Bloquée" bg_color="text-bg-danger"
                            invisible="not is_blocked"/>
                    <div class="oe_title">
                        <label for="name" string="Titre de travail"/>
                        <h1><field name="name" placeholder="Le titre peut changer, celui-ci reste"/></h1>
                    </div>
                    <group>
                        <group string="Cadrage">
                            <field name="calendar_id"/>
                            <field name="kind"/>
                            <field name="pillar_id"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="post_id" invisible="kind != 'blog'"/>
                        </group>
                        <group string="Conduite">
                            <field name="user_id"/>
                            <field name="reviewer_id"/>
                            <field name="planned_date"/>
                            <field name="scheduled_publish_date"
                                   help="La garde de pré-vol s'applique aussi à cette date."/>
                            <field name="published_date" invisible="not published_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert" invisible="preflight_ok">
                        <strong>La publication est retenue.</strong>
                        <field name="preflight_summary" nolabel="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="not preflight_ok or published_date">
                        <field name="preflight_summary" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not qa_waived or qa_waiver_stale">
                        <strong>Cette entrée est sous dérogation.</strong>
                        La QA voit toujours ce qu'elle voit; c'est le refus de
                        publier qui a cédé, sur les motifs signés et sur
                        ceux-là seulement.
                        <group class="mt-2">
                            <field name="qa_waived_by" readonly="1"/>
                            <field name="qa_waived_on" readonly="1"/>
                            <field name="qa_waiver_reason" readonly="1"/>
                            <field name="qa_waiver_problems" readonly="1"/>
                        </group>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not qa_waiver_stale">
                        <strong>La dérogation ne couvre plus rien.</strong>
                        Le texte a bougé depuis sa signature. À signer de
                        nouveau sur les constats actuels, ou à lever.
                    </div>
                    <field name="preflight_ok" invisible="1"/>
                    <field name="is_blocked" invisible="1"/>
                    <field name="qa_waived" invisible="1"/>
                    <field name="qa_waiver_stale" invisible="1"/>

                    <notebook>

                        <page string="Langues" name="langues">
                            <field name="language_summary" nolabel="1" readonly="1"/>
                            <field name="version_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="lang_id"/>
                                    <field name="is_source"/>
                                    <field name="state"/>
                                    <field name="word_count" readonly="1"/>
                                    <field name="translator_id"/>
                                    <field name="translated_date"/>
                                    <field name="qa_state" readonly="1"/>
                                    <field name="slug" readonly="1" optional="hide"/>
                                </list>
                            </field>
                            <group>
                                <field name="langs_complete" readonly="1"/>
                                <field name="langs_ready" readonly="1"/>
                                <field name="word_count" readonly="1"/>
                                <field name="word_floor" readonly="1"/>
                            </group>
                        </page>

                        <page string="Restes humains" name="controle">
                            <field name="checklist_ids" nolabel="1">
                                <list editable="bottom" decoration-muted="done">
                                    <field name="sequence" widget="handle"/>
                                    <field name="done" widget="boolean_toggle"/>
                                    <field name="name"/>
                                    <field name="is_blocking"/>
                                    <field name="note"/>
                                    <field name="done_by" readonly="1" optional="show"/>
                                    <field name="done_date" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="QA" name="qa">
                            <group>
                                <field name="qa_state" readonly="1"/>
                                <field name="qa_last_run" readonly="1"/>
                                <field name="qa_run_by" readonly="1"/>
                                <field name="qa_waived" readonly="1"/>
                                <field name="qa_waiver_stale" readonly="1"
                                       invisible="not qa_waived"/>
                            </group>
                            <field name="qa_findings" nolabel="1" readonly="1"
                                   placeholder="Aucun constat. Passez la QA pour remplir cette zone."/>
                        </page>

                        <page string="Véracité" name="veracite">
                            <group>
                                <group>
                                    <field name="fact_check_date"/>
                                    <field name="fact_checked_by"/>
                                </group>
                                <group string="Fraîcheur du sujet">
                                    <field name="subject_module_id"/>
                                    <field name="source_version"
                                           invisible="not subject_module_id"/>
                                    <field name="current_version" readonly="1"
                                           invisible="not subject_module_id"/>
                                    <field name="version_drift" readonly="1"
                                           invisible="not subject_module_id"/>
                                </group>
                            </group>
                            <separator string="Affirmations"/>
                            <field name="claim_ids" nolabel="1">
                                <list editable="bottom" decoration-warning="verdict == 'todo'"
                                      decoration-danger="verdict == 'false'">
                                    <field name="name"/>
                                    <field name="source_id"/>
                                    <field name="verdict"/>
                                    <field name="is_machine_proposed" readonly="1"/>
                                    <field name="correction" optional="hide"/>
                                    <field name="verdict_by" optional="hide"/>
                                    <button name="action_confirm" type="object"
                                            icon="fa-check" title="Confirmer le verdict proposé"
                                            invisible="not is_machine_proposed"/>
                                </list>
                            </field>
                            <separator string="Sources"/>
                            <field name="source_ids" nolabel="1">
                                <list editable="bottom" decoration-danger="is_dead">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="url" widget="url"/>
                                    <field name="lang_id"/>
                                    <field name="http_status"/>
                                    <field name="checked_date"/>
                                    <field name="is_dead" readonly="1"/>
                                    <field name="archive_url" optional="hide" widget="url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Angle" name="angle">
                            <group>
                                <field name="hook" placeholder="La phrase qui accroche"/>
                                <field name="thesis" placeholder="Ce que l'article défend, en une phrase"/>
                                <field name="reader_problem"/>
                                <field name="promise"/>
                                <field name="cta"/>
                            </group>
                            <group string="Référencement">
                                <field name="target_keyword"/>
                                <field name="search_intent"/>
                                <field name="pattern"/>
                                <field name="competitor" invisible="pattern not in ('alternative', 'comparison')"/>
                                <field name="campaign_id"/>
                            </group>
                        </page>

                        <page string="Dépendances" name="dependances">
                            <group>
                                <field name="blocked_reason"
                                       placeholder="Motif de blocage saisi à la main"/>
                                <field name="blocking_summary" readonly="1"
                                       invisible="not is_blocked"/>
                            </group>
                            <separator string="Doit sortir après"/>
                            <field name="depends_on_ids" nolabel="1" widget="many2many_tags"/>
                            <separator string="Retient"/>
                            <field name="blocks_ids" nolabel="1" widget="many2many_tags" readonly="1"/>
                            <group string="Mesure brute">
                                <field name="raw_visits" readonly="1"/>
                                <field name="task_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_editorial_entry_kanban" model="ir.ui.view">
        <field name="name">bf.editorial.entry.kanban</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="false">
                <field name="stage_id"/>
                <field name="color"/>
                <field name="preflight_ok"/>
                <field name="is_blocked"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="pillar_id"/>
                            </div>
                            <div class="mt-1">
                                <span class="badge text-bg-danger" t-if="record.is_blocked.raw_value">Bloquée</span>
                                <span class="badge text-bg-success" t-if="record.preflight_ok.raw_value">Pré-vol vert</span>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="planned_date" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_editorial_entry_list" model="ir.ui.view">
        <field name="name">bf.editorial.entry.list</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_blocked" decoration-success="preflight_ok and not published_date"
                  decoration-muted="published_date">
                <header>
                    <button name="action_run_qa" type="object"
                            string="Passer la QA" class="btn-secondary"
                            help="Contrôles déterministes sur la sélection. Aucune intelligence artificielle n'intervient."/>
                </header>
                <field name="name"/>
                <field name="calendar_id" optional="show"/>
                <field name="pillar_id" optional="show"/>
                <field name="stage_id"/>
                <field name="planned_date"/>
                <field name="published_date" optional="hide"/>
                <field name="word_count" optional="show" sum="Mots"/>
                <field name="langs_complete" optional="show"/>
                <field name="qa_state" optional="show"/>
                <field name="preflight_ok"/>
                <field name="is_blocked" optional="hide"/>
                <field name="version_drift" optional="hide"/>
                <field name="raw_visits" optional="hide" sum="Visites (brut)"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_editorial_entry_calendar" model="ir.ui.view">
        <field name="name">bf.editorial.entry.calendar</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <calendar date_start="timeline_date" color="pillar_id" mode="month"
                      quick_create="false">
                <field name="name"/>
                <field name="pillar_id"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_editorial_entry_search" model="ir.ui.view">
        <field name="name">bf.editorial.entry.search</field>
        <field name="model">bf.editorial.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="target_keyword"/>
                <field name="pillar_id"/>
                <field name="tag_ids"/>
                <field name="calendar_id"/>
                <filter name="mine" string="Les miennes"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="open" string="En cours"
                        domain="[('published_date', '=', False)]"/>
                <separator/>
                <filter name="ready" string="Pré-vol vert"
                        domain="[('preflight_ok', '=', True), ('published_date', '=', False)]"/>
                <filter name="blocked" string="Bloquées"
                        domain="[('is_blocked', '=', True)]"/>
                <filter name="drift" string="Dérive de version"
                        domain="[('version_drift', '=', True)]"/>
                <filter name="langs_missing" string="Langue manquante"
                        domain="[('langs_complete', '=', False)]"/>
                <filter name="langs_not_ready" string="Langue pas encore relue"
                        domain="[('langs_ready', '=', False)]"/>
                <filter name="waived" string="Sous dérogation"
                        domain="[('qa_waived', '=', True)]"/>
                <separator/>
                <filter name="planned" string="Date prévue" date="planned_date"/>
                <filter name="published" string="Publiées" date="published_date"/>
                <group expand="0" string="Regrouper par">
                    <filter name="g_stage" string="Étape" context="{'group_by': 'stage_id'}"/>
                    <filter name="g_pillar" string="Pilier" context="{'group_by': 'pillar_id'}"/>
                    <filter name="g_calendar" string="Calendrier" context="{'group_by': 'calendar_id'}"/>
                    <filter name="g_user" string="Responsable" context="{'group_by': 'user_id'}"/>
                    <filter name="g_kind" string="Nature" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_editorial_entry" model="ir.actions.act_window">
        <field name="name">Entrées éditoriales</field>
        <field name="res_model">bf.editorial.entry</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer une première entrée</p>
            <p>Une entrée porte un article, ou une publication qui ne passe pas
               par le blogue. C'est elle qui tient l'angle, les sources, les
               langues et ce qu'il reste à faire.</p>
        </field>
    </record>

</odoo>
