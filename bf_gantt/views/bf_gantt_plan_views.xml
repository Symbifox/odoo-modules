<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_gantt_plan_form" model="ir.ui.view">
        <field name="name">bf.gantt.plan.form</field>
        <field name="model">bf.gantt.plan</field>
        <field name="arch" type="xml">
            <form string="Timeline">
                <header>
                    <button name="action_bf_gantt" type="object" string="Open the timeline"
                            class="btn-primary" icon="fa-bar-chart"/>
                    <button name="action_bf_gantt_importer" type="object"
                            string="Import a file" icon="fa-upload"
                            groups="bf_gantt.group_bf_gantt_manager"/>
                    <button name="action_bf_gantt_publier" type="object"
                            string="Publish on the portal" icon="fa-globe"
                            invisible="portal_published"
                            groups="bf_gantt.group_bf_gantt_manager"/>
                    <button name="action_bf_gantt_depublier" type="object"
                            string="Remove from the portal" icon="fa-eye-slash"
                            invisible="not portal_published"
                            groups="bf_gantt.group_bf_gantt_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_bf_gantt" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="item_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success"
                            invisible="not portal_published"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Rollout at…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="project_id"
                                   help="Courtesy link. No task is created or touched."/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="portal_published" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lignes">
                            <field name="item_ids">
                                <list editable="bottom" decoration-muted="state == 'cancel'"
                                      decoration-success="state == 'done'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="lane" optional="show"/>
                                    <field name="name"/>
                                    <field name="assignee" optional="show"/>
                                    <field name="date_start"/>
                                    <field name="date_end"
                                           column_invisible="0"
                                           readonly="is_milestone"/>
                                    <field name="is_milestone" optional="show"/>
                                    <field name="progress" string="%" widget="integer" optional="show"/>
                                    <field name="allocated_hours" optional="hide"/>
                                    <field name="depend_on_ids" widget="many2many_tags"
                                           optional="hide"
                                           domain="[('plan_id', '=', parent.id), ('id', '!=', id)]"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Assumptions, caveats, what is still to be decided…"/>
                        </page>
                        <page string="Sharing" name="partage"
                              groups="bf_gantt.group_bf_gantt_manager">
                            <group>
                                <field name="access_url" widget="url" readonly="1"
                                       string="Portal address"/>
                                <field name="access_token" readonly="1" string="Token"/>
                            </group>
                            <button name="action_bf_gantt_regenerer_token" type="object"
                                    string="Regenerate the token" class="btn-secondary"
                                    confirm="Addresses already handed out will stop working. Continue?"/>
                            <div class="text-muted mt-2">
                                Until "Publish on the portal" has been clicked, the address answers "access denied" even with the right token.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bf_gantt_plan_list" model="ir.ui.view">
        <field name="name">bf.gantt.plan.list</field>
        <field name="model">bf.gantt.plan</field>
        <field name="arch" type="xml">
            <list string="Timelines">
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="project_id" optional="hide"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="item_count" string="Lines"/>
                <field name="portal_published" string="Portal" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'active'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bf_gantt_plan_search" model="ir.ui.view">
        <field name="name">bf.gantt.plan.search</field>
        <field name="model">bf.gantt.plan</field>
        <field name="arch" type="xml">
            <search string="Timelines">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <filter name="mine" string="Mine"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="publies" string="On the portal"
                        domain="[('portal_published', '=', True)]"/>
                <separator/>
                <filter name="actifs" string="In progress"
                        domain="[('state', '=', 'active')]"/>
                <filter name="archives" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter name="par_client" string="Client"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="par_responsable" string="Assignee"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="par_etat" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bf_gantt_plan" model="ir.actions.act_window">
        <field name="name">Standalone timelines</field>
        <field name="res_model">bf.gantt.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bf_gantt_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Draw a timeline without creating tasks</p>
            <p>
                A standalone timeline is for showing a schedule: in a quote, in a rollout plan, in front of a committee. It creates no task, touches no project and counts no hours.
            </p>
            <p>
                You can also start from an existing file: a <b>Microsoft Project .xml</b> or an Excel workbook exported from here.
            </p>
        </field>
    </record>

    <record id="action_bf_gantt" model="ir.actions.client">
        <field name="name">Timeline</field>
        <field name="tag">bf_gantt</field>
    </record>

</odoo>
