<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Le bloc de gouvernance, accroché au point d'extension du tableau de
         bord du socle plutôt qu'inséré dans son gabarit principal : un xpath
         posé sur une ligne voisine se serait décroché à la première retouche
         du tableau de bord.

         Le t-call du socle partage son contexte de rendu, donc `state` et les
         cinq gestionnaires de clic ajoutés par corporate_dashboard.js
         répondent ici comme dans le gabarit principal. -->
    <t t-name="bf_corporate_governance.CorporateDashboardRow"
       t-inherit="project_knowledge_matrix.DashboardExtraRows"
       t-inherit-mode="extension">
        <xpath expr="." position="inside">
                    <div class="row mb-4" t-if="state.data.corporate_metrics and !state.projectId">
                        <div class="col-12">
                            <h5 class="text-uppercase text-muted mb-3">
                                <i class="fa fa-institution me-2"/>Gouvernance corporative
                            </h5>
                        </div>
                        <div class="col-lg-4 col-md-6 mb-3">
                            <div class="card h-100">
                                <div class="card-header" style="background-color: #1a1a2e;">
                                    <h6 class="mb-0 text-white"><i class="fa fa-users me-2"/>Registres</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2 cursor-pointer" t-on-click="openDirectors">
                                        <span><i class="fa fa-user-tie me-2"/>Administrateurs actifs</span>
                                        <strong t-esc="state.data.corporate_metrics.active_directors"/>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 cursor-pointer" t-on-click="openOfficers">
                                        <span><i class="fa fa-briefcase me-2"/>Dirigeants actifs</span>
                                        <strong t-esc="state.data.corporate_metrics.active_officers"/>
                                    </div>
                                    <div class="d-flex justify-content-between cursor-pointer" t-on-click="openResolutions">
                                        <span><i class="fa fa-gavel me-2"/>Résolutions adoptées</span>
                                        <strong t-esc="state.data.corporate_metrics.adopted_resolutions"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 mb-3">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fa fa-calendar-check-o me-2"/>Conformité corporative</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2 cursor-pointer" t-on-click="openOverdueCompliance">
                                        <span>En retard</span>
                                        <span t-attf-class="badge {{state.data.corporate_metrics.overdue_compliance > 0 ? 'text-bg-danger' : 'text-bg-success'}}" t-esc="state.data.corporate_metrics.overdue_compliance"/>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 cursor-pointer" t-on-click="openComplianceCalendar">
                                        <span>Échéance proche</span>
                                        <span t-attf-class="badge {{state.data.corporate_metrics.due_soon_compliance > 0 ? 'text-bg-warning' : 'text-bg-secondary'}}" t-esc="state.data.corporate_metrics.due_soon_compliance"/>
                                    </div>
                                    <div class="d-flex justify-content-between cursor-pointer" t-on-click="openComplianceCalendar">
                                        <span>À venir</span>
                                        <span class="badge text-bg-info" t-esc="state.data.corporate_metrics.upcoming_compliance"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 mb-3" t-if="state.data.corporate_metrics and !state.projectId and state.data.corporate_metrics.overdue_compliance > 0">
                            <div class="card h-100 border-danger cursor-pointer" t-on-click="openOverdueCompliance">
                                <div class="card-body d-flex align-items-center">
                                    <i class="fa fa-exclamation-triangle fa-3x text-danger me-3"/>
                                    <div>
                                        <h3 class="text-danger mb-0" t-esc="state.data.corporate_metrics.overdue_compliance"/>
                                        <span class="text-muted">obligation(s) corporative(s) en retard</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
        </xpath>
    </t>

</templates>
