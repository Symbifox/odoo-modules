#: model_terms:ir.ui.view,arch_db:bf_kitchen.bf_kitchen_product_view_search
msgid "Archived"
msgstr "Archivés"

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/kitchen_scope.py:0
msgid ""
"As a kitchen manager, you can only change kitchen products and recipes "
"(%(records)s is not one)."
msgstr ""
"Comme responsable de la cuisine, vous ne pouvez modifier que les produits et"
" les recettes de la cuisine (%(records)s n'en est pas)."

#. module: bf_kitchen
#. odoo-python
#: code:addons/bf_kitchen/models/kitchen_scope.py:0
msgid ""
"As a kitchen manager, you cannot change %(fields)s: these settle the "
"accounting and the stock valuation of the product. Ask a product, inventory "
"or accounting manager."
msgstr ""
"Comme responsable de la cuisine, vous ne pouvez pas modifier %(fields)s : "
"ces champs règlent la comptabilité et la valorisation du stock du produit. "
"Demandez à un ou une responsable des produits, de l'inventaire ou de la "
"comptabilité."

#. module: bf_kitchen
#: model_terms:ir.ui.view,arch_db:bf_kitchen.bf_kitchen_attach_line_view_form
#: model_terms:ir.ui.view,arch_db:bf_kitchen.bf_kitchen_bill_line_view_list
msgid "Attach"
msgstr "Rattacher"

#. module: bf_kitchen
#: model:ir.model,name:bf_kitchen.model_bf_kitchen_attach_line
msgid "Attach a bill line to a kitchen ingredient"
msgstr "Rattacher une ligne de facture à un ingrédient"

