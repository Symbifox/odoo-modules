<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_form" model="ir.ui.view">
        <field name="name">bf.household.leave.form</field>
        <field name="model">bf.household.leave</field>
        <field name="arch" type="xml">
            <form string="Leave the household">
                <field name="can_export" invisible="1"/>
                <p>Leaving closes your account in this household now.</p>
                <p invisible="not can_export">Export your records first: the file you keep brings them into another household.</p>
                <div class="alert alert-warning" role="alert" invisible="not children_alone">
                    You are the only parent of: <field name="children_alone" class="fw-bold"/>.
                    Name a second parent first, or their records stay closed after you leave.
                </div>
                <group>
                    <field name="confirm"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export my records" class="btn-primary"
                            invisible="not can_export"/>
                    <button name="action_leave" type="object" string="Leave the household" class="btn-danger"
                            invisible="not confirm"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
