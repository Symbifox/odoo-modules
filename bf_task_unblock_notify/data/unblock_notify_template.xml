<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rendu une fois PAR LANGUE de destinataire : chaque phrase est un terme
         entier du catalogue, sans fragment qui ne se traduise pas seul. -->
    <template id="task_unblocked_notification">
        <div>
            <p>Hello,</p>
            <p>
                <span>The task</span>
                <a t-att-href="access_link" style="font-weight: bold;">
                    <t t-out="task.display_name"/>
                </a>
                <t t-if="task.project_id">
                    <span>in the project</span>
                    <strong><t t-out="task.project_id.display_name"/></strong>
                    <t t-if="task.project_id.partner_id">
                        <span>for the client</span>
                        <strong><t t-out="task.project_id.partner_id.name"/></strong>
                    </t>
                </t>
                <span>is now <strong>unblocked</strong> and ready to resume.</span>
            </p>
            <t t-if="blocker_info">
                <p>
                    <strong><t t-out="closing_user"/></strong>
                    <span>completed the following blocking tasks on</span>
                    <strong><t t-out="closing_time"/></strong>:
                </p>
                <ul>
                    <t t-foreach="blocker_info" t-as="blocker">
                        <li>
                            <t t-out="blocker['name']"/>
                            (<t t-out="blocker['state_label']"/>)
                            <t t-if="blocker['project_name']">
                                <span>· project</span> <t t-out="blocker['project_name']"/>
                                <t t-if="blocker['client_name']">
                                    <span>· client</span> <t t-out="blocker['client_name']"/>
                                </t>
                            </t>
                        </li>
                    </t>
                </ul>
            </t>
            <p>Over to you!</p>
        </div>
    </template>

</odoo>
