<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_bf_sign" model="ir.ui.view">
        <field name="name">sale.order.form.bf.sign</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sign_requests" type="object"
                        class="oe_stat_button" icon="fa-pencil-square-o"
                        groups="bf_sign.group_sign_user"
                        invisible="sign_request_count == 0">
                    <field name="sign_request_count" widget="statinfo" string="Signatures"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_send_for_signature" type="object"
                        string="Envoyer pour signature"
                        groups="bf_sign.group_sign_user"/>
            </xpath>
        </field>
    </record>

</odoo>
