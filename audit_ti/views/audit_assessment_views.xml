<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_assessment_list" model="ir.ui.view">
        <field name="name">audit.assessment.list</field>
        <field name="model">audit.assessment</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'adequate'" decoration-danger="status == 'inadequate'" decoration-warning="status in ('partial', 'declared')" decoration-muted="status == 'na'">
                <field name="client_id"/>
                <field name="supplier_id"/>
                <field name="element_num" string="No."/>
                <field name="element_id"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'adequate'"
                    decoration-danger="status == 'inadequate'"
                    decoration-warning="status in ('partial', 'to_validate', 'declared')"
                    decoration-info="status == 'pending'"/>
                <field name="response_received_date" optional="hide"/>
                <field name="assessed_by"/>
                <field name="assessed_date"/>
                <field name="recommendation" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_audit_assessment_form" model="ir.ui.view">
        <field name="name">audit.assessment.form</field>
        <field name="model">audit.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_watchpoint" string="Create a watchpoint"
                        type="object" class="btn-secondary"
                        invisible="status not in ('inadequate', 'partial')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="supplier_id"/>
                            <field name="element_id"/>
                            <field name="element_num" string="No." readonly="1"/>
                        </group>
                        <group>
                            <field name="status" widget="radio"/>
                            <field name="assessed_by"/>
                            <field name="assessed_date"/>
                            <field name="response_received_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Supplier response">
                            <field name="response" placeholder="Paste the supplier's response from the alignment table..."/>
                        </page>
                        <page string="Assessor notes">
                            <field name="notes" placeholder="Notes, rationale for the assessment..."/>
                        </page>
                        <page string="Recommendation to the client">
                            <field name="recommendation" placeholder="Specific recommendation to the client for this supplier/element..."/>
                        </page>
                        <page string="Best practices">
                            <field name="element_best_practices" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_audit_assessment_search" model="ir.ui.view">
        <field name="name">audit.assessment.search</field>
        <field name="model">audit.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="client_id"/>
                <field name="supplier_id"/>
                <field name="element_id"/>
                <separator/>
                <filter name="adequate" string="Adequate" domain="[('status', '=', 'adequate')]"/>
                <filter name="partial" string="Partial" domain="[('status', '=', 'partial')]"/>
                <filter name="declared" string="Declared" domain="[('status', '=', 'declared')]"/>
                <filter name="to_validate" string="To validate" domain="[('status', '=', 'to_validate')]"/>
                <filter name="inadequate" string="Inadequate" domain="[('status', '=', 'inadequate')]"/>
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <separator/>
                <group expand="0" string="Group by">
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_element" string="Element" context="{'group_by': 'element_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_audit_assessment" model="ir.actions.act_window">
        <field name="name">Assessments</field>
        <field name="res_model">audit.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
