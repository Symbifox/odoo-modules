<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contact form: enrichment actions + completeness smart button -->
    <record id="view_partner_form_enrichment" model="ir.ui.view">
        <field name="name">res.partner.form.enrichment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header groups="bf_contact_enrichment.group_bf_contact_enrich">
                    <button name="action_scan_business_card" type="object"
                            string="Scan a card" class="btn-secondary"/>
                    <button name="action_bf_enrich_signature_direct" type="object"
                            string="Enrich now (signatures)" class="btn-primary"/>
                    <button name="action_enrich_from_emails" type="object"
                            string="Enrich (review)" class="btn-secondary"/>
                    <button name="action_enrich_from_web" type="object"
                            string="Enrich (website)" class="btn-secondary"/>
                    <button name="action_enrich_from_linkedin" type="object"
                            string="Enrich (LinkedIn)" class="btn-secondary"/>
                    <!-- recherche en ligne par Gen, sociétés seulement -->
                    <button name="action_bf_gen_review" type="object"
                            string="See Gen's proposal" class="btn-primary"
                            invisible="x_bf_gen_state != 'proposed'"/>
                    <button name="action_bf_gen_complete" type="object"
                            string="Complete with Gen" class="btn-secondary"
                            invisible="not is_company or x_bf_gen_state in ('queued', 'proposed')"/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="x_bf_gen_state" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/*[1]" position="before">
                <div class="alert alert-info mb-2" role="status"
                     groups="bf_contact_enrichment.group_bf_contact_enrich"
                     invisible="x_bf_gen_state != 'queued'">
                    Gen is searching for this company online. The result arrives in about
                    a minute; reload the record to see it.
                </div>
                <div class="alert alert-warning mb-2" role="status"
                     groups="bf_contact_enrichment.group_bf_contact_enrich"
                     invisible="x_bf_gen_state not in ('nothing', 'error')">
                    Gen could not complete this company:
                    <field name="x_bf_gen_message" class="d-inline" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='website']" position="after">
                <field name="x_linkedin_url" widget="url" placeholder="https://www.linkedin.com/in/…"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-id-card-o" type="object"
                        name="action_enrich_from_emails"
                        groups="bf_contact_enrichment.group_bf_contact_enrich">
                    <field name="x_enrichment_completeness" widget="statinfo"
                           string="Completeness"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Mon profil : ce que Gen fait d'une société créée -->
    <record id="view_users_form_simple_modif_gen" model="ir.ui.view">
        <field name="name">res.users.preferences.bf.gen.company</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tz']" position="after">
                <field name="bf_gen_company_mode" readonly="0"
                       groups="bf_contact_enrichment.group_bf_contact_enrich"/>
            </xpath>
        </field>
    </record>

    <!-- Search: "Contacts incomplets" filter -->
    <record id="view_res_partner_filter_enrichment" model="ir.ui.view">
        <field name="name">res.partner.search.enrichment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="bf_incomplete" string="Incomplete contacts"
                        domain="[('x_enrichment_completeness', '&lt;', 60)]"/>
            </xpath>
        </field>
    </record>

</odoo>
