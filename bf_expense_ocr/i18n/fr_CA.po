#. odoo-python
#: code:addons/bf_expense_ocr/models/hr_expense.py:0
msgid ""
"The gap between the total and the detail (%(residu).2f) is too large to be a"
" tip."
msgstr ""
"L'écart entre le total et le détail (%(residu).2f) est trop grand pour être "
"un pourboire."

#. module: bf_expense_ocr
#. odoo-python
#: code:addons/bf_expense_ocr/models/hr_expense.py:0
msgid ""
"The receipt does not add up: subtotal + taxes + tip = %(somme).2f, total "
"read = %(total).2f."
msgstr ""
"Le reçu ne balance pas : sous-total + taxes + pourboire = %(somme).2f, total"
" lu = %(total).2f."

#. module: bf_expense_ocr
#. odoo-python
#: code:addons/bf_expense_ocr/models/hr_expense.py:0
msgid ""
"The receipt does not add up: subtotal and taxes (%(part).2f) exceed the "
"total (%(total).2f)."
msgstr ""
"Le reçu ne balance pas : sous-total et taxes (%(part).2f) dépassent le total"
" (%(total).2f)."

#. module: bf_expense_ocr
#. odoo-python
