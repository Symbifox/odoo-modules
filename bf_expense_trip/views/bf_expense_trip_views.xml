<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_expense_trip_view_form" model="ir.ui.view">
        <field name="name">bf.expense.trip.form</field>
        <field name="model">bf.expense.trip</field>
        <field name="arch" type="xml">
            <form string="Trip">
                <header>
                    <button name="action_collect_expenses" type="object" string="Collect receipts"
                            class="btn-primary" invisible="state != 'draft'"
                            help="Attach the traveller's expenses dated within the trip that are not in a report yet."/>
                    <button name="action_add_mileage" type="object" string="Add mileage"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_allowances" type="object" string="Generate allowances"
                            invisible="state != 'draft'"
                            help="Turn the ticked boxes of the days into expenses, at the company's rates."/>
                    <button name="action_create_report" type="object" string="Create report"
                            invisible="state != 'draft' or not expense_count"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="expense_count" widget="statinfo" string="Expenses"/>
                        </button>
                        <button name="action_view_sheets" type="object" class="oe_stat_button" icon="fa-folder-open-o"
                                invisible="not sheet_count">
                            <field name="sheet_count" widget="statinfo" string="Reports"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Trade show in Toronto"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_employee"
                                   options="{'relation': 'hr.employee.public', 'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <label for="date_start" string="Dates"/>
                            <div class="o_row">
                                <field name="date_start" readonly="state != 'draft'"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="to" title="to"/>
                                <field name="date_end" readonly="state != 'draft'"/>
                            </div>
                            <field name="destination"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="analytic_distribution" widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <field name="purpose" placeholder="Purpose of the trip"/>
                    <notebook>
                        <page string="Allowances" name="days">
                            <p class="text-muted">
                                Untick a meal that was provided (a conference lunch, a meal on the
                                plane). Tick private lodging for a night with friends or family,
                                without a hotel receipt.
                            </p>
                            <field name="day_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="date" readonly="1"/>
                                    <field name="breakfast"/>
                                    <field name="lunch"/>
                                    <field name="dinner"/>
                                    <field name="incidentals"/>
                                    <field name="private_lodging"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Expenses" name="expenses">
                            <field name="expense_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="bf_trip_allowance" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="total_amount_currency" sum="Total"/>
                                    <field name="sheet_id" optional="show"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bf_expense_trip_view_list" model="ir.ui.view">
        <field name="name">bf.expense.trip.list</field>
        <field name="model">bf.expense.trip</field>
        <field name="arch" type="xml">
            <list string="Trips">
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="destination" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'reported'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="bf_expense_trip_view_search" model="ir.ui.view">
        <field name="name">bf.expense.trip.search</field>
        <field name="model">bf.expense.trip</field>
        <field name="arch" type="xml">
            <search string="Trips">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="destination"/>
                <field name="partner_id"/>
                <filter name="mine" string="My trips" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="assisted" string="Trips I prepare"
                        domain="[('bf_assisted_by_me', '=', True)]"/>
                <separator/>
                <filter name="draft" string="In preparation" domain="[('state', '=', 'draft')]"/>
                <filter name="reported" string="Reported" domain="[('state', '=', 'reported')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Traveller" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_expense_trip_action" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">bf.expense.trip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Prepare a business trip</p>
            <p>
                A trip gathers its receipts, its meal allowances, its mileage and its hotel
                folio into one expense report. An assistant can prepare it for the traveller.
            </p>
        </field>
    </record>
</odoo>
