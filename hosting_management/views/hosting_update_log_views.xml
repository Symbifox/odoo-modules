<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Update Log Tree View -->
    <record id="hosting_update_log_view_tree" model="ir.ui.view">
        <field name="name">hosting.update.log.tree</field>
        <field name="model">hosting.update.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="not success">
                <field name="update_date"/>
                <field name="service_id"/>
                <field name="partner_id"/>
                <field name="software_id"/>
                <field name="from_version_id"/>
                <field name="to_version_id"/>
                <field name="user_id"/>
                <field name="success"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Update Log Form View -->
    <record id="hosting_update_log_view_form" model="ir.ui.view">
        <field name="name">hosting.update.log.form</field>
        <field name="model">hosting.update.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="service_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="software_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="update_date"/>
                            <field name="user_id"/>
                            <field name="success"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="from_version_id"/>
                        </group>
                        <group>
                            <field name="to_version_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Update Log Search View -->
    <record id="hosting_update_log_view_search" model="ir.ui.view">
        <field name="name">hosting.update.log.search</field>
        <field name="model">hosting.update.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="service_id"/>
                <field name="partner_id"/>
                <field name="software_id"/>
                <filter name="filter_success" string="Réussi" domain="[('success', '=', True)]"/>
                <filter name="filter_failed" string="Échoué" domain="[('success', '=', False)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_service" string="Service" context="{'group_by': 'service_id'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_software" string="Logiciel" context="{'group_by': 'software_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'update_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Update Log Action -->
    <record id="hosting_update_log_action" model="ir.actions.act_window">
        <field name="name">Historique des mises à jour</field>
        <field name="res_model">hosting.update.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hosting_update_log_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun historique de mise à jour
            </p>
            <p>
                Les journaux de mise à jour sont créés automatiquement lorsque les services sont mis à jour.
            </p>
        </field>
    </record>

</odoo>
