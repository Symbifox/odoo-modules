#. module: bf_route_expense
#. odoo-python
#: code:addons/bf_route_expense/models/bf_route_day.py:0
msgid "%s has no employee in this company: no expense to claim for."
msgstr ""
"%s n'a pas de fiche dans Employés pour cette société : aucune dépense à "
"réclamer."

#. module: bf_route_expense
