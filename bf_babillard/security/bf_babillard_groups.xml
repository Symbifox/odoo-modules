<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_babillard" model="ir.module.category">
        <field name="name">Noticeboard</field>
        <field name="description">The organisation's announcements and their posting.</field>
        <field name="sequence">42</field>
    </record>

    <record id="group_babillard_redacteur" model="res.groups">
        <field name="name">Editors</field>
        <field name="category_id" ref="module_category_babillard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Writes, publishes and takes down posts, and sees who confirmed they read them.</field>
    </record>

    <record id="group_babillard_moderation" model="res.groups">
        <field name="name">Moderation</field>
        <field name="category_id" ref="module_category_babillard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Receives the reports and can take content down. This is the group of the person designated by the harassment prevention policy.</field>
    </record>
</odoo>
