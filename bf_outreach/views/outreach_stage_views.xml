<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bf_outreach_stage_list" model="ir.ui.view">
        <field name="name">bf.outreach.stage.list</field>
        <field name="model">bf.outreach.stage</field>
        <field name="arch" type="xml">
            <list string="Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stage_type"/>
                <field name="fold"/>
                <field name="campaign_ids" widget="many2many_tags"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bf_outreach_stage_form" model="ir.ui.view">
        <field name="name">bf.outreach.stage.form</field>
        <field name="model">bf.outreach.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Stage name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="stage_type"/>
                            <field name="sequence"/>
                            <field name="fold"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="campaign_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this stage stands for…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_outreach_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">bf.outreach.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the follow-up stages</p>
            <p>
                Stages of type "Won" or "Dropped" close the file and stop the follow-up cadence.
            </p>
        </field>
    </record>

</odoo>
