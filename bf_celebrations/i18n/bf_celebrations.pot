#. module: bf_celebrations
#: model:mail.template,body_html:bf_celebrations.mail_template_invitation_signataire
msgid ""
"<div style=\"font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6\">\n"
"    <p>Hello <t t-out=\"ctx.get('cel_invite_nom') or ''\"/>,</p>\n"
"    <p>A group card is open for\n"
"       <strong t-out=\"object.recipient_name or ''\"/>:\n"
"       <t t-out=\"object.name or ''\"/>.</p>\n"
"    <p>A message, a photo, something drawn by hand: what you would have written\n"
"       in the paper card. No account is needed.</p>\n"
"    <p style=\"margin:24px 0\">\n"
"        <a t-att-href=\"object.contribution_url\" style=\"background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block\">\n"
"            Sign the card</a>\n"
"    </p>\n"
"    <p t-if=\"object.delivery_date\">The card goes out on\n"
"       <strong t-out=\"format_datetime(object.delivery_date, tz=user.tz or 'UTC', dt_format='long')\"/>.</p>\n"
"    <p style=\"color:#6b7280;font-size:12px\">The person celebrated sees nothing\n"
"       before delivery: keep the surprise for them, and do not forward\n"
"       this message to them.</p>\n"
"</div>"
msgstr ""

#. module: bf_celebrations
#: model:mail.template,body_html:bf_celebrations.mail_template_invitation
msgid ""
"<div style=\"font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6\">\n"
"    <p>Hello <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"    <p>We would like to be able to mark celebrations at the office, and for that\n"
"       we have to ask you what you think. You decide, and you can change\n"
"       your mind whenever you want.</p>\n"
"    <p>Four possible answers:</p>\n"
"    <ul style=\"padding-left:18px\">\n"
"        <li><strong>Yes, with a card</strong> signed by your colleagues</li>\n"
"        <li><strong>Yes, but no card</strong>: the date appears, nobody\n"
"            organises anything</li>\n"
"        <li><strong>No thanks</strong>: we take you out of everything, and we\n"
"            will not ask you again</li>\n"
"        <li>Do nothing, and nothing happens</li>\n"
"    </ul>\n"
"    <p>We ask you for the <strong>day and the month</strong> only. Your\n"
"       date of birth in the HR record is not read, not copied, not\n"
"       shown.</p>\n"
"    <p style=\"margin:24px 0\">\n"
"        <a t-att-href=\"'%s/odoo/action-bf_celebrations.action_mon_profil' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url') or '')\" style=\"background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block\">\n"
"            Answer</a>\n"
"    </p>\n"
"    <p style=\"color:#6b7280;font-size:12px\">Nobody but you sees\n"
"       your answer, not even human resources.</p>\n"
"</div>"
msgstr ""

#. module: bf_celebrations
#: model:mail.template,body_html:bf_celebrations.mail_template_livraison
msgid ""
"<div style=\"font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6\">\n"
"    <p>Hello <t t-out=\"object.recipient_name or ''\"/>,</p>\n"
"    <p>Your colleagues have written to you.\n"
"       <strong t-out=\"object.published_post_count\"/> message(s) are\n"
"       waiting for you. Open the envelope.</p>\n"
"    <p style=\"margin:24px 0\">\n"
"        <a t-att-href=\"object.recipient_url\" style=\"background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block\">\n"
"            Open the card</a>\n"
"    </p>\n"
"    <p style=\"color:#6b7280;font-size:12px\">Attached, the card to\n"
"       keep: as a PDF, and as a complete page where animated images still\n"
"       move. The link will not last forever; those two files\n"
"       are yours. From the card you can thank those\n"
"       who signed: that link is yours, do not forward it.</p>\n"
"</div>"
msgstr ""

#. module: bf_celebrations
#: model:mail.template,body_html:bf_celebrations.mail_template_merci
msgid ""
"<div style=\"font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6\">\n"
"    <p>Hello,</p>\n"
"    <p><strong t-out=\"object.recipient_name or ''\"/> has received their card,\n"
"       <t t-out=\"object.name or ''\"/>, and has written a message for those\n"
"       who signed it:</p>\n"
"    <blockquote style=\"margin:16px 0;padding:12px 16px;border-left:4px solid #177AA3;background:#F4F6F8\" t-out=\"object.thanks_html\" data-o-mail-quote-node=\"1\" data-o-mail-quote=\"1\"/>\n"
"    <p style=\"margin:24px 0\">\n"
"        <a t-att-href=\"object.board_url\" style=\"background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block\">\n"
"            See the card again</a>\n"
"    </p>\n"
"</div>"
msgstr ""

#. module: bf_celebrations
#: model:mail.template,body_html:bf_celebrations.mail_template_tableau_mince
msgid ""
"<div style=\"font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6\">\n"
"    <p>Hello,</p>\n"
"    <p><strong t-out=\"object.recipient_name or ''\"/>'s card goes out soon\n"
"       and it carries\n"
"       <strong t-out=\"object.published_post_count\"/> message(s).</p>\n"
"    <p>The link to share again:</p>\n"
"    <p><a t-att-href=\"object.contribution_url\" t-out=\"object.contribution_url\"/></p>\n"
"    <p style=\"color:#6b7280;font-size:12px\">An empty card is not delivered:\n"
"       it is held and you are told.</p>\n"
"</div>"
msgstr ""

#. module: bf_celebrations
#: model:mail.template,body_html:bf_celebrations.mail_template_rappel_organisateur
msgid ""
"<div style=\"font-family:Lexend,Segoe UI,Arial,sans-serif;font-size:14px;color:#2E3132;line-height:1.6\">\n"
"    <p>Hello,</p>\n"
"    <p><t t-out=\"object.name or ''\"/>, le\n"
"       <strong t-out=\"object.date and object.date.strftime('%d/%m/%Y') or ''\"/>.</p>\n"
"    <p>Nothing is open yet. A wishes board is created in one click, and the\n"
"       link is then shared however you like: email, a team channel,\n"
"       or a printed QR code.</p>\n"
"    <p style=\"margin:24px 0\">\n"
"        <a t-att-href=\"'%s/odoo/bf.celebration.occasion/%s' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url') or '', object.id)\" style=\"background:#177AA3;color:#ffffff;padding:11px 20px;border-radius:6px;text-decoration:none;display:inline-block\">\n"
"            Open the card</a>\n"
"    </p>\n"
"    <p style=\"color:#6b7280;font-size:12px\">This person has agreed to have\n"
"       their celebration marked. They will see nothing before delivery.</p>\n"
"</div>"
msgstr ""

