<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bf_school_meal_close_view_form" model="ir.ui.view">
        <field name="name">bf.school.meal.close.form</field>
        <field name="model">bf.school.meal.close</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_close" type="object" string="Close the day" class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="bf_school_meal_close_action" model="ir.actions.act_window">
        <field name="name">Close the day</field>
        <field name="res_model">bf.school.meal.close</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="bf_school_view_form_meal" model="ir.ui.view">
        <field name="name">bf.school.form.meal</field>
        <field name="model">bf.school</field>
        <field name="inherit_id" ref="bf_school_core.bf_school_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Meals" name="meals">
                    <group>
                        <field name="meal_payment_modes"/>
                        <field name="meal_order_days"/>
                        <field name="meal_cancel_hour" widget="float_time"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_student_meal" model="ir.ui.view">
        <field name="name">res.partner.form.student.meal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="bf_school_core.view_partner_form_student"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='student_permanent_code']" position="after">
                <field name="meal_allergen_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="bf_school_meal_item_view_list" model="ir.ui.view">
        <field name="name">bf.school.meal.item.list</field>
        <field name="model">bf.school.meal.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="school_id"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="allergen_ids" widget="many2many_tags"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="bf_school_meal_day_view_form" model="ir.ui.view">
        <field name="name">bf.school.meal.day.form</field>
        <field name="model">bf.school.meal.day</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(bf_school_meal_close_action)d" type="action" string="Close the day"
                            invisible="closed" groups="bf_school_core.group_school_manager"
                            confirm="Every order of the day is cancelled and credited. Continue?"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="status" invisible="not closed">
                        Closed: <field name="closed_reason" class="d-inline"/>
                    </div>
                    <group>
                        <field name="school_id"/>
                        <field name="date"/>
                        <field name="item_ids" widget="many2many_tags"/>
                    </group>
                    <field name="order_ids" readonly="1">
                        <list decoration-muted="state != 'ordered'">
                            <field name="student_id"/>
                            <field name="group_names"/>
                            <field name="item_id"/>
                            <field name="student_allergen_ids" widget="many2many_tags"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_meal_day_view_list" model="ir.ui.view">
        <field name="name">bf.school.meal.day.list</field>
        <field name="model">bf.school.meal.day</field>
        <field name="arch" type="xml">
            <list decoration-muted="closed">
                <field name="date"/>
                <field name="school_id"/>
                <field name="item_ids" widget="many2many_tags"/>
                <field name="order_count" string="Orders"/>
                <field name="closed"/>
            </list>
        </field>
    </record>

    <record id="bf_school_meal_day_view_calendar" model="ir.ui.view">
        <field name="name">bf.school.meal.day.calendar</field>
        <field name="model">bf.school.meal.day</field>
        <field name="arch" type="xml">
            <calendar date_start="date" mode="month" quick_create="0" color="school_id">
                <field name="item_ids" widget="many2many_tags"/>
                <field name="order_count"/>
            </calendar>
        </field>
    </record>

    <!-- The kitchen and lunch supervisors' list: who eats what, with the allergies. -->
    <record id="bf_school_meal_order_view_list" model="ir.ui.view">
        <field name="name">bf.school.meal.order.list</field>
        <field name="model">bf.school.meal.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state != 'ordered'" decoration-danger="student_allergen_ids">
                <field name="date"/>
                <field name="group_names"/>
                <field name="student_id"/>
                <field name="item_id"/>
                <field name="student_allergen_ids" widget="many2many_tags"/>
                <field name="price" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="mode" optional="hide"/>
                <field name="invoice_id" optional="hide"/>
                <field name="state"/>
                <button name="action_cancel" type="object" string="Cancel" icon="fa-times"
                        invisible="state != 'ordered' or invoice_id" groups="bf_school_core.group_school_manager"/>
            </list>
        </field>
    </record>

    <record id="bf_school_meal_order_view_search" model="ir.ui.view">
        <field name="name">bf.school.meal.order.search</field>
        <field name="model">bf.school.meal.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="item_id"/>
                <filter name="ordered" string="Ordered" domain="[('state', '=', 'ordered')]"/>
                <!-- 🔴 Without these separators, "Ordered" and "Tomorrow" were OR'd: the
                     kitchen list added up every order of every date (demo, 2026-10-02). -->
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="tomorrow" string="Tomorrow"
                        domain="[('date', '=', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="allergies" string="With allergies" domain="[('student_allergen_ids', '!=', False)]"/>
                <group>
                    <filter name="by_date" string="Day" context="{'group_by': 'date:day'}"/>
                    <filter name="by_item" string="Meal" context="{'group_by': 'item_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bf_school_meal_account_view_list" model="ir.ui.view">
        <field name="name">bf.school.meal.account.list</field>
        <field name="model">bf.school.meal.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="mode"/>
                <field name="balance"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="bf_school_meal_account_view_form" model="ir.ui.view">
        <field name="name">bf.school.meal.account.form</field>
        <field name="model">bf.school.meal.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="mode"/>
                        <field name="balance"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Movements" name="entries">
                            <field name="entry_ids" context="{'default_kind': 'adjustment'}">
                                <list editable="top" create="1" delete="0">
                                    <field name="create_date" string="Date" readonly="1"/>
                                    <field name="kind" readonly="1" force_save="1"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="order_id" readonly="1"/>
                                    <field name="note" required="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Top-ups" name="topups">
                            <field name="topup_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="invoice_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Orders" name="orders">
                            <field name="order_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bf_school_meal_day_action" model="ir.actions.act_window">
        <field name="name">Menus</field>
        <field name="res_model">bf.school.meal.day</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
    <record id="bf_school_meal_order_action" model="ir.actions.act_window">
        <field name="name">Kitchen list</field>
        <field name="res_model">bf.school.meal.order</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_ordered': 1, 'search_default_tomorrow': 1, 'search_default_by_item': 1}</field>
    </record>
    <record id="bf_school_meal_item_action" model="ir.actions.act_window">
        <field name="name">Meals</field>
        <field name="res_model">bf.school.meal.item</field>
        <field name="view_mode">list</field>
    </record>
    <record id="bf_school_meal_account_action" model="ir.actions.act_window">
        <field name="name">Meal accounts</field>
        <field name="res_model">bf.school.meal.account</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="bf_school_allergen_action" model="ir.actions.act_window">
        <field name="name">Food allergens</field>
        <field name="res_model">bf.school.allergen</field>
        <field name="view_mode">list</field>
    </record>
    <record id="bf_school_allergen_view_list" model="ir.ui.view">
        <field name="name">bf.school.allergen.list</field>
        <field name="model">bf.school.allergen</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_school_meal_root" name="Meals" parent="bf_school_core.menu_school_root" sequence="22"/>
    <menuitem id="menu_school_meal_orders" name="Kitchen list" parent="menu_school_meal_root"
              action="bf_school_meal_order_action" sequence="5"/>
    <menuitem id="menu_school_meal_days" name="Menus" parent="menu_school_meal_root"
              action="bf_school_meal_day_action" sequence="10"/>
    <menuitem id="menu_school_meal_items" name="Meals" parent="menu_school_meal_root"
              action="bf_school_meal_item_action" sequence="20"/>
    <menuitem id="menu_school_meal_accounts" name="Meal accounts" parent="menu_school_meal_root"
              action="bf_school_meal_account_action" sequence="30" groups="bf_school_core.group_school_manager"/>
    <menuitem id="menu_school_allergens" name="Food allergens" parent="bf_school_core.menu_school_config"
              action="bf_school_allergen_action" sequence="40"/>
</odoo>
