<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Synchronisation VOIP.ms : DID + CDR + transactions + solde.
             No-op tant que hosting.voipms_enabled n'est pas activé (sûr sur
             tous les tenants, le code court-circuite si désactivé). -->
        <record id="ir_cron_hosting_voipms_sync" model="ir.cron">
            <field name="name">Hébergement : Synchronisation VOIP.ms</field>
            <field name="model_id" ref="model_hosting_voip_did"/>
            <field name="state">code</field>
            <field name="code">model._cron_voipms_sync()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <!-- Alerte ntfy quotidienne si le solde prépayé passe sous le seuil. -->
        <record id="ir_cron_hosting_voipms_balance_alert" model="ir.cron">
            <field name="name">Hébergement : Alerte solde VOIP.ms</field>
            <field name="model_id" ref="model_hosting_voip_did"/>
            <field name="state">code</field>
            <field name="code">model._cron_voipms_balance_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
