#. module: bf_babillard
#: model:mail.template,body_html:bf_babillard.mail_template_annonce_a_lire
msgid ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">\n"
"        Une annonce vous demande de confirmer sa lecture :\n"
"        <strong t-out=\"object.name or ''\"/>\n"
"    </p>\n"
"    <div t-if=\"not is_html_empty(object.corps_html)\" style=\"margin:0 0 16px 0;\" t-out=\"object.corps_html\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=bf.babillard.post&amp;res_id={{ object.id }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Lire et confirmer\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        La confirmation se fait dans l'application, après la connexion : ouvrir ce\n"
"        courriel ou suivre son lien ne compte pas comme une lecture.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">\n"
"        Une annonce vous demande de confirmer sa lecture :\n"
"        <strong t-out=\"object.name or ''\"/>\n"
"    </p>\n"
"    <div t-if=\"not is_html_empty(object.corps_html)\" style=\"margin:0 0 16px 0;\" t-out=\"object.corps_html\"/>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=bf.babillard.post&amp;res_id={{ object.id }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Lire et confirmer\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        La confirmation se fait dans l'application, après la connexion : ouvrir ce\n"
"        courriel ou suivre son lien ne compte pas comme une lecture.\n"
"    </p>\n"
"</div>\n"
"            "

#. module: bf_babillard
#: model:mail.template,body_html:bf_babillard.mail_template_signalement_recu
msgid ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.post_id.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Un signalement attend votre attention au babillard.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=bf.babillard.signalement&amp;res_id={{ object.id }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Ouvrir le signalement\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        Pour préserver la confidentialité, ce courriel ne dit ni ce qui est signalé,\n"
"        ni qui le signale.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <t t-set=\"societe\" t-value=\"object.post_id.company_id\"/>\n"
"    <t t-set=\"accent\" t-value=\"('report_brand_primary' in societe._fields and societe.report_brand_primary) or societe.email_secondary_color or '#875A7B'\"/>\n"
"    <p style=\"margin:0 0 12px 0;\">Bonjour,</p>\n"
"    <p style=\"margin:0 0 12px 0;\">Un signalement attend votre attention au babillard.</p>\n"
"    <p style=\"margin:24px 0;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/mail/view?model=bf.babillard.signalement&amp;res_id={{ object.id }}\" t-attf-style=\"background-color:{{ accent }};color:#FFFFFF;text-decoration:none;padding:12px 24px;border-radius:6px;font-weight:600;display:inline-block;\">\n"
"            Ouvrir le signalement\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:13px;color:#6B7280;\">\n"
"        Pour préserver la confidentialité, ce courriel ne dit ni ce qui est signalé,\n"
"        ni qui le signale.\n"
"    </p>\n"
"</div>\n"
"            "

